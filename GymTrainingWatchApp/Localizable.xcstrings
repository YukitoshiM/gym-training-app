    "watch_widget.9a3e26289146": {
      "comment": "GymTrainingWatchApp/WatchContentView.swift:103\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط وقت الرفع والخفض لكل مجموعة. سوف يرشدك Apple Watch بـ 1-3 أحاسيس لمسية في الثانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estableix el temps de pujada i baixada per a cada conjunt. Apple Watch us guiarà amb 1-3 sensacions tàctils per segon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte čas zvedání a snížení pro každou sadu. Apple Watch vás upozorní 1 až 3krát na sekundu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil op- og nedtid for hver sæt. Apple Watch giver 1-3 gange berøring pr. sekund."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf- und Abbewegungszeiten werden pro Set festgelegt. Das Apple Watch informiert Sie mit 1 bis 3 Berührungen pro Sekunde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε το χρόνο άνοδου και κατω στο σύνολο. Το Apple Watch σας παρέχει οδηγίες με 1-3 αισθήσεις ανά δευτερόλεπτο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the duration for each exercise. Your Apple Watch will provide haptic feedback of 1 to 3 touches per second."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the duration for each exercise. Your Apple Watch will provide haptic feedback of 1 to 3 touches per second."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the duration for each exercise. Your Apple Watch will provide haptic feedback of 1 to 3 touches per second."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up the duration for each exercise. Your Apple Watch will provide haptic feedback of 1 to 3 touches per second."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer el tiempo de subida y bajada por separado. El Apple Watch proporciona indicaciones con 1 a 3 toques por segundo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer el tiempo de subida y bajada por separado. El Apple Watch proporciona indicaciones con 1 a 3 toques por segundo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta nosto- ja laskeutumisaika erikseen. Apple Watch antaa ohjeita 1–3 kosketuksella sekunnissa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir les durées de montée et de descente par session. L'Apple Watch vous guide avec 1 à 3 contacts par seconde."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir les durées de montée et de descente par session. L'Apple Watch vous guide avec 1 à 3 contacts par seconde."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપર અને નીચેના સમયને દરેક સેટ માટે સેટ કરો. એપલ વોચ 1 સેકન્ડમાં 1 થી 3 વાર સ્પર્શ દ્વારા માર્ગદર્શન આપશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרת זמן התחלה וסיום לכל קבוצה. Apple Watch מציע 1 עד 3 גירויים חושיים בכל שנייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपर और नीचे की अवधि को सेट के अनुसार निर्धारित करें। Apple Watch 1 सेकंड में 1-3 बार स्पर्श संवेदना के माध्यम से मार्गदर्शन करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite vrijeme za gore i dolje po setu. Apple Watch vas upoznjava 1 do 3 puta na sekundu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fel- és leállási időt beállíthatja egyenként. Az Apple Watch 1 másodpercenként 1–3 érintésre figyelmezteti Önt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur waktu angkat dan turun secara terpisah. Apple Watch akan memberikan panduan dengan 1 hingga 3 sentuhan per detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i tempi di \"in alto\" e \"in basso\" per ogni set. Apple Watch fornisce indicazioni con 1-3 tocchi al secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上げ・下げ時間をセットごとに設定。Apple Watchが1秒あたり1〜3回の触覚で案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올리고 내리는 시간을 세트로 설정합니다. Apple Watch은 1초당 1~3회의 촉각으로 안내합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उचलण्याची आणि खाली करण्याची वेळ सेट करा. ॲपल वॉच दर 1 सेकंदाला 1 ते 3 वेळा स्पर्श करून मार्गदर्शन करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan masa angkat dan turun untuk setiap set. Apple Watch akan memberikan panduan dengan 1 hingga 3 sentuhan setiap saat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de tijden voor omhoog en omlaag in per set. De Apple Watch geeft 1 tot 3 keer aanrakingen per seconde weer."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett opp løftetid og nedtiden separat. Apple Watch gir veiledning med 1-3 berøringer per sekund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawianie czasu w górę i w dół dla każdej serii. Apple Watch informuje o 1-3 dotknięciach na sekundę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o tempo de subida e descida para cada conjunto. O Apple Watch fornece feedback tátil de 1 a 3 vezes por segundo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o tempo de subida e descida para cada conjunto. O Apple Watch fornece feedback tátil de 1 a 3 vezes por segundo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează timpul de în sus și în jos pentru fiecare set. Apple Watch-ul oferă feedback tactil de 1 până la 3 ori pe secundă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка времени подъема и опускания для каждой серии. Apple Watch сообщает об этом 1-3 раза в секунду."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte čas zvýšenia a zníženia pre každú sériu. Apple Watch vás upozorní 1 až 3 krát na dotyk za sekundu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite čas podaja in povleka za vsako nastavitev. Apple Watch vas bo vodil s 1 do 3 dotiki na sekundo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in upp- och nedreppningstider per inställning. Apple Watch ger vägledning med 1–3 känslor per sekund."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேலே மற்றும் கீழே நேரத்தை, ஒவ்வொரு தொகுப்பிற்கும் அமைக்கலாம். ஆப்பிள் வாட்ச் 1 வினாடியில் 1 முதல் 3 முறை தொட்டு உங்களுக்கு வழிகாட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పైకి మరియు క్రిందికి సమయాన్ని సెట్ వారీగా సెట్ చేయండి. Apple Watch 1 సెకనుకు 1 నుండి 3 సార్లు స్పర్శ ద్వారా మీకు తెలియజేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งเวลาขึ้นและลงเป็นชุด Apple Watch จะแจ้งเตือนด้วยการสัมผัส 1-3 ครั้งต่อวินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarı ve aşağı sürelerini ayrı ayrı ayarlayın. Apple Watch, her bir hareketi 1 ila 3 kez dokunma ile size bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть час підйому та спуску окремо. Apple Watch повідомляє 1-3 рази на секунду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập thời gian tăng và giảm cho mỗi bộ. Apple Watch sẽ hướng dẫn bạn với 1-3 lần cảm giác chạm mỗi giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复和暂停时间，可按训练设置。Apple Watch每秒提供1-3次触觉提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可為每個設定調整恢復和暫停時間。Apple Watch會以每秒1〜3次的觸覺方式提供提示。"
          }
        }
      }
    },
