          "stringUnit": {
            "state": "translated",
            "value": "Reitti tallennetaan Apple Healthiin, eikä sitä lähetetä AI:lle tai mainoksille."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre itinéraire est enregistré dans Apple Health et n'est pas partagé avec les applications ou la publicité."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre itinéraire est enregistré dans Apple Health et n'est pas partagé avec les applications ou la publicité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રૂટ Apple Health માં સંગ્રહિત થાય છે અને AI અથવા જાહેરાતો માટે મોકલવામાં આવતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסלול נשמר ב-Apple Health ואינו משודר ל-AI או למטרות פרסום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्ग Apple Health में सहेजा जाएगा और AI या विज्ञापन के लिए नहीं भेजा जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša ruta se sprema u Apple Health i ne šalje se AI-u ili oglasima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az útvonal az Apple Health-ben tárolva, és nem kerül át a mesterséges intelligenciához vagy hirdetésekhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
