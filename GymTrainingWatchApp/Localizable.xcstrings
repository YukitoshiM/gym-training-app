    "watch_widget.e71bb44afc57": {
      "comment": "GymTrainingWatchApp/WatchContentView.swift:93\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ باختيار حدث وضبطه. إذا قمت بخطأ ما، يمكنك التراجع عن ذلك عن طريق النقر على \"إلغاء\"."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenceu per triar un esdeveniment i configurar-lo. Si cometeu un error, podeu desfer-lo fent clic a \"Cancel·la\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte cvik a set a začněte. Pokud jste se spletli, můžete vrátit zpět k neprovedeným pohybům pomocí tlačítka \"Zrušit\"."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg øvelse og sæt for at starte. Hvis du laver en fejl, kan du vende tilbage til uafgjort med \"Annuller\"."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Übung und Satz aus, um zu beginnen. Wenn Sie sich vertippt haben, können Sie mit \"Abbrechen\" zum vorherigen Zustand zurückkehren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε άσκηση και σετ για να ξεκινήσετε. Εάν κάνετε λάθος, μπορείτε να επιστρέψετε στην προηγούμενη κατάσταση με το \"Ακύρωση\"."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an exercise and set to start. If you make a mistake, you can return to the uncompleted state by pressing \"Cancel\"."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an exercise and set to start. If you make a mistake, you can return to the uncompleted state by pressing \"Cancel\"."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an exercise and set to start. If you make a mistake, you can return to the uncompleted state by pressing \"Cancel\"."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an exercise and set to start. If you make a mistake, you can return to the uncompleted state by pressing \"Cancel\"."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el ejercicio y el conjunto para comenzar. Si te equivocaste, puedes volver a empezar con \"Cancelar\"."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el ejercicio y el conjunto para comenzar. Si te equivocaste, puedes volver a empezar con \"Cancelar\"."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse harjoite ja sarja aloittamiseksi. Jos teet virheen, voit palauttaa edelliseen tilanteeseen painamalla \"Peruuta\"."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un exercice et un ensemble pour commencer. Si vous avez fait une erreur, vous pouvez revenir en arrière en appuyant sur \"Annuler\"."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un exercice et un ensemble pour commencer. Si vous avez fait une erreur, vous pouvez revenir en arrière en appuyant sur \"Annuler\"."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કસરત અને સેટ પસંદ કરો અને શરૂ કરો. જો તમે ભૂલ કરો, તો \"કાન્સલ\" પર ક્લિક કરીને તેને રદ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו את התרגיל והסט והתחילו. אם טעיתם, ניתן לחזור ללא ביצוע על ידי לחיצה על \"ביטול\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशिष्ट व्यायाम और सेट का चयन करके शुरू करें। यदि गलती हुई, तो \"रद्द\" पर वापस आ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite vježbu i seriju za početak. Ako ste pogrešili, možete se vratiti na prethodni stav \"Otkaži\"."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki a feladatot és az edzést, majd kezdje el. Ha hibázott, \"Muty\" gombbal visszatérhet az eredeti állapotba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih latihan dan set untuk memulai. Jika salah, gunakan \"Batalkan\" untuk kembali ke yang belum dilakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona l'esercizio e il set per iniziare. Se hai sbagliato, puoi tornare indietro premendo \"Annulla\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種目とセットを選んで開始。間違えた時は「キャンセル」で未実行に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동과 세트를 선택하여 시작합니다. 잘못된 경우 \"취소\"를 눌러 실행 취소할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यायाम आणि सेट निवडून सुरू करा. चुकून निवडल्यास, \"रद्द करा\" वर क्लिक करून मागील स्थितीत परत या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih latihan dan set untuk bermula. Jika anda melakukan kesalahan, anda boleh kembali ke yang belum dijalankan dengan \"Batalkan\"."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een oefening en set om te starten. Als je een fout hebt gemaakt, kun je terugkeren naar de onafgemaakte status met \"Annuleren\"."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg øvelse og sett for å starte. Hvis du gjør feil, kan du gå tilbake til det som ikke er utført med \"Avbryt\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zestaw ćwiczeń i rozpocznij. Jeśli popełnisz błąd, możesz cofnąć się do niewykonanych ćwiczeń, naciskając \"Anuluj\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o exercício e o conjunto para iniciar. Se errar, use \"Cancelar\" para retornar ao que não foi executado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o exercício e o conjunto para iniciar. Se errar, use \"Cancelar\" para retornar ao que não foi executado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați exercițiul și setul pentru a începe. Dacă v-ați făcut o greșeală, puteți reveni la starea inițială apăsând \"Anulare\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите упражнение и набор для начала. Если допустили ошибку, можно вернуться к незавершенному выполнению, нажав \"Отмена\"."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte úlohu a set a začnite. Ak ste sa zmätli, môžete zrušiť a vrátiť sa k neprebehnutému."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite vajo in serijo, da začnete. Če ste naredili napako, lahko vrnete na neizvedeno s pritiskom \"Prekliči\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj övning och set för att starta. Om du gör fel, kan du återgå till det oavslutade genom att trycka på \"Avbryt\"."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயிற்சியைத் தொடங்க, பயிற்சி மற்றும் செட்டைத் தேர்ந்தெடுக்கவும். தவறாக இருந்தால் \"ரத்து\" மூலம் செயலற்ற நிலைக்குத் திரும்பலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యాయామం మరియు సెట్‌ను ఎంచుకుని ప్రారంభించండి. తప్పు అయితే \"రద్దు\" ద్వారా తిరిగి వెనక్కి తీసుకురావచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรายการและเซ็ตเพื่อเริ่มต้น หากผิดพลาด ให้กด \"ยกเลิก\" เพื่อกลับไปก่อนหน้านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteği ve set'i seçip başlayın. Yanlış bir seçim yaparsanız, \"İptal\" ile geri dönebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть вправу та сет для початку. Якщо помилилися, можна повернутися до невиконаного за допомогою \"Скасувати\"."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn bài tập và bộ tập để bắt đầu. Nếu sai, bạn có thể quay lại bằng nút \"Hủy\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择项目和套组开始。如果操作错误，可以按“取消”返回未执行状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇運動和組，然後開始。如果操作錯誤，可以按「取消」返回未執行狀態。"
          }
        }
      }
    },
