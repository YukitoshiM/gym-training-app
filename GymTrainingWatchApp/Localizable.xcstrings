        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हेल्थ डेटा सेव्ह करण्यात अयशस्वी. वॉच रेकॉर्ड सेव्ह केले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpanan Health gagal – Rekod Watch telah disimpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-opslag mislukt, Watch-gegevens zijn opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagring av Health mislyktes, Watch-registrering er lagret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Błąd zapisu danych w Health, dane z Watch zostały zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao salvar o Health. O registro do Watch já foi salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao salvar o Health. O registro do Watch já foi salvo."
          }
