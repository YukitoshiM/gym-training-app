    "watch_widget.875a5d223149": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+HealthKit.swift:48\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استعادة القياسات الصحية. يمكن أن يستمر الإدخال اليدوي"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures de salut no es poden restaurar. L'entrada manual pot continuar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není možné obnovit měření v Health. Můžete pokračovat s ručním zadáváním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Målingerne kan ikke gendannes. Du kan fortsætte med manuel indtastning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Health-Messung kann nicht wiederhergestellt werden. Die manuelle Eingabe ist weiterhin möglich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορείτε να επαναφέρετε τις μετρήσεις στο Health. Μπορείτε να συνεχίσετε την χειροκίνητη καταγραφή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Health measurement cannot be recovered. You can continue manual entry."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Health measurement cannot be recovered. You can continue manual entry."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Health measurement cannot be recovered. You can continue manual entry."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Health measurement cannot be recovered. You can continue manual entry."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede recuperar la medición de Health. Puede continuar registrando manualmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede recuperar la medición de Health. Puede continuar registrando manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-mittaukset eivät voi palauttaa. Voit jatkaa manuaalista syöttämistä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer les mesures de Health. Vous pouvez continuer à saisir manuellement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer les mesures de Health. Vous pouvez continuer à saisir manuellement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હેલ્થનું માપન પુનઃસ્થાપિત કરી શકાતું નથી. તમે મેન્યુઅલી રેકોર્ડ કરવાનું ચાલુ રાખી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשחזר את המדידה של Health. ניתן להמשיך מקליד ידנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health का माप पुनर्प्राप्त नहीं किया जा सकता। आप मैन्युअल रूप से रिकॉर्ड करना जारी रख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne možete obnoviti mjerenja. Možete nastaviti unos ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Health mérést nem lehet helyreállítani. A manuális rögzítés folytatható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pengukuran Health tidak dapat dipulihkan. Anda tetap dapat mencatat secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile ripristinare le misurazioni di Health. È comunque possibile continuare a registrare manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Health計測は復元できません。手入力は継続できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health 측정값을 복원할 수 없습니다. 수동 입력은 계속 가능합니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हेल्थमधील मापन पुन्हा सुरू करता येत नाही. तुम्ही मॅन्युअल पद्धतीने रेकॉर्डिंग चालू ठेवू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memulihkan pengukuran Health. Anda boleh terus rekod secara manual."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-metingen kunnen niet worden hersteld. U kunt blijven invoeren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var ikke mulig å gjenopprette Health-målingene. Du kan fortsette med manuell registrering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odzyskać danych pomiarowych. Można nadal wprowadzać dane ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível restaurar as medições do Health. Você pode continuar registrando manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível restaurar as medições do Health. Você pode continuar registrando manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se poate recupera datele măsurate. Puteți continua să înregistrați manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно восстановить данные измерений в Health. Вы можете продолжать ввод вручную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa obnoviť údaje o tréningu. Môžete pokračovať s manuálnym zadávaním údajov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne moremo obnoviti meritev. Lahko nadaljujete z vnačanjem ročno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte återställa Health-mätningarna. Du kan fortsätta att logga manuellt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுகாதார அளவீடுகளை மீட்டெடுக்க முடியாது. கைமுறையாகப் பதிவு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Health కొలతలు పునరుద్ధరించలేము. మాన్యువల్‌గా కొనసాగించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถกู้คืนข้อมูลการวัดผลใน Health ได้ สามารถบันทึกด้วยตนเองต่อไปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health ölçümü geri yüklenemiyor. Elle kaydetmeye devam edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається відновити вимірювання в Health. Ви можете продовжувати введення вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khôi phục dữ liệu đo Health. Bạn có thể tiếp tục ghi lại thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复健康应用测量。您可以继续手动输入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复 Health 测量。您可以继续手动输入"
          }
        }
      }
    },
