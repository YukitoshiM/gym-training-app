    "watch_widget.2315bef407c9": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+HealthKit.swift:86\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إجراء التسجيل يدويًا لأنه لا يمكن تحضير عناصر المستشعر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La gravació s'està realitzant manualment perquè els elements del sensor no es poden preparar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemohu připravit položky senzoru, proto zaznamenávám ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke forberede sensor, derfor optages manuelt"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Da der Sensor nicht verwendet werden kann, wird manuell aufgezeichnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορώ να προετοιμάσω το στοιχείο του αισθητήρα, επομένως καταγράφω χειροκίνητα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to prepare sensor data, so recording manually."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to prepare sensor data, so recording manually."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to prepare sensor data, so recording manually."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to prepare sensor data, so recording manually."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede preparar el elemento del sensor, por lo que se está registrando manualmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede preparar el elemento del sensor, por lo que se está registrando manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensorin tiedot eivät ole valmiita, joten tiedot on merkitty manuaalisesti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer les données des capteurs, donc saisie manuelle."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer les données des capteurs, donc saisie manuelle."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંવેદકના ડેટાને તૈયાર કરી શકાય તેમ હોવાથી, મેન્યુઅલી રેકોર્ડ કરવામાં આવી રહ્યો છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר להכין את פרטי המדדים, הקלט ידנית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेंसर डेटा तैयार नहीं होने के कारण, मैन्युअल रूप से रिकॉर्ड कर रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemogu se pripremiti za mjerenje senzora, stoga se zapisuje ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült előre beállítani az érzékelőket, ezért kézzel kell rögzíteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena tidak dapat menyiapkan item sensor, sedang dicatat secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile preparare i dati del sensore, quindi inserisci manualmente i valori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサー項目を準備できないため手入力で記録中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "센서 항목을 준비할 수 없으므로 수동으로 기록 중입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेन्सर डेटा तयार होऊ शकत नसल्यामुळे, मॅन्युअली रेकॉर्ड करत आहोत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyediakan maklumat sensor, jadi rekod menggunakan input manual."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de sensorwaarden niet uitlezen, dus handmatig invoeren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke forberede sensordata, derfor registreres manuelt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przygotować danych z czujnika, więc wprowadzam dane ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível preparar o item do sensor, portanto, está sendo registrado manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível preparar o item do sensor, portanto, está sendo registrado manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu pot pregăti elementul senzorului, deci înregistrez manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно подготовить параметры датчика, поэтому данные вводятся вручную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemôžem pripraviť položky senzora, preto údaje zadávam manuálne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker se ne da pripraviti meritev, vnesate podatke ročno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte förbereda sensor, därför registreras manuellt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சென்சார் தரவை தயார் செய்ய முடியவில்லை, எனவே கைமுறையாக பதிவு செய்கிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెన్సార్ అంశాలను సిద్ధం చేయడం సాధ్యం కానందున, మాన్యువల్‌గా రికార్డ్ చేస్తున్నాము"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถเตรียมรายการเซ็นเซอร์ได้ จึงบันทึกด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensör verisi hazırlanamıyor, manuel olarak kaydediliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається підготувати параметри детектора, запис здійснюється вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuẩn bị các thông số cảm biến, đang nhập thủ công"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法准备传感器，请手动记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備感測器項目，請手動記錄"
          }
        }
      }
    },
