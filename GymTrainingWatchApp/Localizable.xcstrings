          "stringUnit": {
            "state": "translated",
            "value": "Izračunam na podlagi gibanja na zapestju in vrstni red neizpolnenih vaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattas baserat på armrörelser och ordningen av oavslutade set."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மணிக்கட்டின் அசைவுகள் மற்றும் முடிக்கப்படாத செட்களின் வரிசையிலிருந்து மதிப்பிடப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతి కదలిక మరియు పూర్తి కాని సెట్ల క్రమం ఆధారంగా అంచనా వేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประมาณจากความเคลื่อนไหวของข้อมือและลำดับของการออกกำลังกายที่ไม่เสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bileğinin hareketleri ve tamamlanmamış setlerin sırasına göre tahmin ediyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінюється на основі рухів зап'ястя та порядку незавершених наборів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính dựa trên chuyển động của cổ tay và thứ tự các tập chưa hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据手腕动作和未完成组的顺序进行估计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根据手腕动作和未完成组的顺序进行估计"
          }
        }
      }
    },
