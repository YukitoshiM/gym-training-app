          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbereder integration med iPhone. Kan sende igen senere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bereite die iPhone-Verbindung vor. Später kann ich es erneut senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ετοιμάζουμε τη σύνδεση με το iPhone. Μπορείτε να το στείλετε ξανά αργότερα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing for iPhone integration. You can resend it later."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing for iPhone integration. You can resend it later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing for iPhone integration. You can resend it later."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing for iPhone integration. You can resend it later."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy preparando la conexión con el iPhone. Puede reenviarlo más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy preparando la conexión con el iPhone. Puede reenviarlo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistellaan iPhone-yhteyttä. Voit lähettää myöhemmin uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Je prépare la synchronisation avec l'iPhone. Vous pourrez le renvoyer ultérieurement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Je prépare la synchronisation avec l'iPhone. Vous pourrez le renvoyer ultérieurement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આયફોન સાથે જોડાણની તૈયારી કરવામાં આવી રહી છે. પછીથી ફરીથી મોકલી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתכונן לחיבור עם iPhone. אוכל לשלוח שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone के साथ कनेक्ट करने की तैयारी चल रही है। बाद में फिर से भेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripremam povezivanje s iPhoneom. Možemo to ponovno poslati kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iPhone-szal való összekapcsolást beállítom. Később újra elküldhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menyiapkan koneksi dengan iPhone. Dapat dikirim kembali nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto preparando la sincronizzazione con iPhone. Potrò inviarlo di nuovo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone連携を準備中です。あとで再送できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 연동 준비 중입니다. 나중에 다시 보내실 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयफोन सिंक करण्याची तयारी करत आहे. नंतर पुन्हा पाठवता येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menyiapkan sambungan dengan iPhone. Anda boleh mengirim semula kemudian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben bezig met het verbinden met de iPhone. Ik kan dit later opnieuw verzenden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbereder integrasjon med iPhone. Kan sende igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowuję synchronizację z iPhone'em. Możesz to wysłać później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando a sincronização com o iPhone. Pode reenviar mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando a sincronização com o iPhone. Pode reenviar mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suntem în proces de configurare a sincronizării cu iPhone. Vă rugăm să le retrimiteți ulterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка к синхронизации с iPhone. Буду отправлять позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príprava prepojenia s iPhone. Môžete to poslať neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V pripravah za povezavo z iPhoneom. Lahko ga pošljem nazaj pozneje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbereder iPhone-integration. Kan skickas igen senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஐபோன் இணைப்புக்கு தயாராக உள்ளது. பிறகு மீண்டும் அனுப்பலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneతో అనుసంధానం చేయడానికి సిద్ధమవుతున్నాను. తరువాత మళ్ళీ పంపవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเตรียมการเชื่อมต่อกับ iPhone กรุณาส่งอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ile bağlantı ayarlanıyor. Daha sonra tekrar gönderebilirim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовка до синхронізації з iPhone. Можна буде відправити пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chuẩn bị kết nối với iPhone. Bạn có thể gửi lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备 iPhone 联动。稍后可以再次发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备 iPhone 与 Apple Watch 的连接。稍后可以再次发送"
          }
        }
      }
    },
