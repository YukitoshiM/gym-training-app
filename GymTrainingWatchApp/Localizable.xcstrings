    "watch_widget.e29bbf1b3ab8": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+HealthKit.swift:287\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل حفظ الصحة/تم حفظ سجل المشاهدة"
          }
        },
        "ca": {
          "stringUnit": {
