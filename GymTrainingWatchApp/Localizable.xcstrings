        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This watch cannot be used with iPhone. Records are saved on the watch."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This watch cannot be used with iPhone. Records are saved on the watch."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This watch cannot be used with iPhone. Records are saved on the watch."
          }
        },
        "es-ES": {
          "stringUnit": {
