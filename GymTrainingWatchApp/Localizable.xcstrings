    "watch_widget.2035fb2564b8": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+Connectivity.swift:386\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\nhu: NLLB fallback used because TranslateGemma mixed writing systems; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على الحفظ على iPhone. ويمكنك إعادة إرساله لاحقًا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot desar a l'iPhone. Podeu tornar-lo a enviar més tard"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezbylo mi uložit na iPhone. Můžete to poslat znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke gemme på iPhone. Kan sende igen senere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht möglich, auf dem iPhone zu speichern. Später kann ich es erneut senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση στο iPhone. Μπορείτε να το στείλετε ξανά αργότερα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save on the iPhone. You can resend it later."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save on the iPhone. You can resend it later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save on the iPhone. You can resend it later."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save on the iPhone. You can resend it later."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar en el iPhone. Puede reenviarlo más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar en el iPhone. Puede reenviarlo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voitu tallentaa iPhoneen. Voit lähettää myöhemmin uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder sur l'iPhone. Vous pourrez le renvoyer ultérieurement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sauvegarder sur l'iPhone. Vous pourrez le renvoyer ultérieurement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આયફોન પર સાચવવામાં આવ્યું નથી. પછીથી ફરીથી મોકલી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחתי לשמור ב-iPhone. אוכל לשלוח שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर सेव नहीं कर सका। बाद में फिर से भेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisam uspio/la spremiti za spremanje na iPhoneu. Možemo to ponovno poslati kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem mentettem meg az iPhone oldalon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan di iPhone. Dapat dikirim kembali nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare su iPhone. Potrò inviarlo di nuovo più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone側で保存できませんでした。あとで再送できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 저장할 수 없었습니다. 나중에 다시 보내실 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयफोनवर सेव्ह करता आले नाही. नंतर पुन्हा पाठवता येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan di iPhone. Anda boleh mengirim semula kemudian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet worden opgeslagen op de iPhone. Ik kan dit later opnieuw verzenden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lagre på iPhone. Kan sende igjen senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać na iPhone. Możesz to wysłać później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar no iPhone. Pode reenviar mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar no iPhone. Pode reenviar mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut salva pe iPhone. Vă rog să le retrimiteți ulterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить на iPhone. Буду отправлять позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa uložiť na iPhone. Môžete to poslať neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni bilo mogoče shraniti na iPhone. Lahko ga pošljem nazaj pozneje."
