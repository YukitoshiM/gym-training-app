        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur de sauvegarde de Health / Données enregistrées sur Watch"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હેલ્થ સેવિંગ નિષ્ફળ, વોચ રેકોર્ડ સાચવેલ છે."
