    "watch_widget.423b784208d1": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+Sensors.swift:260\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اقترح نفس الوزن بناءً على مستوى الإنجاز، RPE، وسرعة التشغيل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggereix el mateix pes en funció del nivell d'assoliment, RPE i la velocitat de funcionament"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhněte stejnou váhu na základě dosažených výsledků, RPE a rychlosti pohybu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreslå samme vægt baseret på fremskridt, RPE og hastighed"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge basierend auf Leistung, RPE und Geschwindigkeit"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτείνουμε το ίδιο βάρος με βάση την επίτευξη, το RPE και την ταχύτητα κίνησης"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest the same weight based on achievement, RPE, and movement speed"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest the same weight based on achievement, RPE, and movement speed"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest the same weight based on achievement, RPE, and movement speed"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest the same weight based on achievement, RPE, and movement speed"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere el mismo peso basándose en el logro, la escala de esfuerzo percibido y la velocidad del movimiento"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere el mismo peso basándose en el logro, la escala de esfuerzo percibido y la velocidad del movimiento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdottaa samaa painoa, RPE:n ja toiminnan nopeuden perusteella"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer le même poids en fonction du niveau de difficulté, de l'échelle RPE et de la vitesse"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer le même poids en fonction du niveau de difficulté, de l'échelle RPE et de la vitesse"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રગતિ, RPE અને પ્રવૃત્તિની ઝડપ પર આધારિત સમાન વજન સૂચવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצע משקל על סמך רמת מאמץ, RPE וקצב פעולה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समान वजन के लिए, उपलब्धि, RPE और गति से सुझाव दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predlagamo isti teret na temelju postignuća, RPE i brzine pokreta"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javasoljuk ugyanazt az súlyt, az aktivitási szint, RPE és sebesség alapján"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyarankan berat yang sama berdasarkan tingkat kemajuan, RPE, dan kecepatan gerakan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisci lo stesso peso in base a livello di difficoltà, RPE e velocità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "達成度、RPE、動作速度から同じ重量を提案"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성공도, RPE, 동작 속도를 기반으로 동일한 무게를 제안"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्ती, RPE, आणि हालचालीच्या वेगावरून समान वजन सुचवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan berat yang sama berdasarkan tahap pencapaian, RPE, dan kelajuan aktiviti"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggesteer hetzelfde gewicht op basis van prestaties, RPE en snelheid"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreslår samme vekt basert på fremgang, RPE og hastighet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponowanie tej samej wagi na podstawie osiągnięć, RPE i prędkości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere o mesmo peso com base em nível de esforço, RPE e velocidade"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugere o mesmo peso com base em nível de esforço, RPE e velocidade"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerează aceeași greutate pe baza nivelului de performanță, RPE și vitezei"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить одинаковый вес на основе достижения, RPE и скорости выполнения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhujeme rovnakú váhu na základe dosiahnutého výkonu, RPE a rýchlosti pohybu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predlagamo isto težo glede na dosežke, RPE in hitrost gibanja"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreslå samma vikt baserat på prestation, RPE och rörelsehastighet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெற்றியின் அளவை, RPE மற்றும் இயக்க வேகத்திலிருந்து ஒரே எடையை பரிந்துரைக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమర్ధత, RPE, కదలిక వేగం ఆధారంగా ఒకే బరువును సూచించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำน้ำหนักเดิมจากระดับความสำเร็จ, RPE และความเร็วในการออกกำลังกาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarı, RPE ve hareket hızıdan aynı ağırlığı öner"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропонуємо ту ж вагу на основі досягнень, RPE та швидкості"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất cùng một trọng lượng dựa trên mức độ đạt, RPE và tốc độ hoạt động"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据完成度、RPE和动作速度，建议相同的重量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據達成度、RPE和動作速度，建議相同的重量"
          }
        }
      }
    },
