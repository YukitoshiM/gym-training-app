    "watch_widget.7b80546b6322": {
      "comment": "GymTrainingWatchApp/WatchContentView.swift:113\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الانتهاء منه أخيرًا، سيتم إرساله إلى جهاز iPhone الخاص بك. يمكن إعادة إرسال السجلات غير المرسلة لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan finalment s'hagi acabat, s'enviarà al vostre iPhone. Els registres no enviats es poden tornar a enviar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po ukončení se data odešlou na iPhone. Nedokončené záznamy můžete později znovu odeslat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendes til iPhone, når du afslutter. Usendte registreringer kan sendes igen senere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie beenden, werden die Daten an Ihr iPhone gesendet. Unversendete Aufzeichnungen können später erneut gesendet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ολοκληρωθεί, θα αποσταλεί στο iPhone. Μπορείτε να στείλετε ξανά τις μη αποθηκευμένες καταγραφές αργότερα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending to iPhone when finished. You can resend any unsubmitted records later."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending to iPhone when finished. You can resend any unsubmitted records later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending to iPhone when finished. You can resend any unsubmitted records later."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending to iPhone when finished. You can resend any unsubmitted records later."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al finalizar, se envía a iPhone. Puede reenviar los registros no enviados más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Al finalizar, se envía a iPhone. Puede reenviar los registros no enviados más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeinen sarja lähetetään iPhoneen. Lähettämättömät tiedot voidaan lähettää myöhemmin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d'arrêt, les données sont envoyées vers votre iPhone. Vous pouvez renvoyer les enregistrements non envoyés ultérieurement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d'arrêt, les données sont envoyées vers votre iPhone. Vous pouvez renvoyer les enregistrements non envoyés ultérieurement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લે સમાપ્ત થવા પર iPhone પર મોકલવામાં આવશે. અસમાવિષ્ઠ રેકોર્ડ્સ પછીથી ફરીથી મોકલી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשאתה מסיים, זה ישלח ל-iPhone. תוכל לשלוח שוב את הרשומות שלא נשלחו מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप अंतिम बार समाप्त करते हैं, तो यह iPhone पर भेजा जाएगा। अप्रसारित रिकॉर्डिंग बाद में फिर से भेजी जा सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada završite, podaci će biti poslani na iPhone. Neizbrisane podatke možete ponovno poslati kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó befejezett edzés iPhone-ra küldődik. Az még nem elküldött adatokat később is el tudod küldeni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah selesai, akan dikirim ke iPhone. Rekaman yang belum terkirim dapat dikirim kembali nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando termini, i dati verranno inviati all'iPhone. Puoi ri-inviare le registrazioni non inviate in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に終了するとiPhoneへ送信。未送信の記録はあとから再送できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 종료하면 iPhone으로 전송됩니다. 아직 전송되지 않은 기록은 나중에 다시 전송할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शेवटी समाप्त केल्यावर iPhone वर पाठवले जाईल. न पाठवलेले रेकॉर्ड नंतर पुन्हा पाठवता येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda berhenti, ia akan dihantar ke iPhone. Anda boleh menghantar semula rekod yang belum dihantar kemudian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Na het beëindigen wordt dit naar uw iPhone verzonden. U kunt onverzonden gegevens later opnieuw verzenden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender til iPhone når økten er fullført. Du kan sende usendte registreringer senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zakończeniu, dane zostaną wysłane na iPhone'a. Niewysłane dane można przesłać później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao finalizar, envia para o iPhone. Os registros não enviados podem ser reenviados posteriormente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao finalizar, envia para o iPhone. Os registros não enviados podem ser reenviados posteriormente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă încheiați, datele sunt trimise către iPhone. Puteți retrimite înregistrările nefinalizate ulterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После завершения отправляется на iPhone. Неотправленные записи можно отправить позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po poslednom ukončení sa údaje ošlú do iPhone. Neodoslané záznamy môžete neskôr znovu poslať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko se izvede, se podatki posredujete na iPhone. Neizvedene zapise lahko pozneje ponovno pošlete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickas till iPhone när du avslutar. Oavslutade inställningar kan skickas igen senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடைசியாக முடித்தவுடன், உங்கள் iPhone-க்கு அனுப்பப்படும். அனுப்பப்படாத பதிவுகளை பின்னர் மீண்டும் அனுப்பலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చివరికి ముగిసినప్పుడు iPhone కు పంపబడుతుంది. ఇంకా పంపించని రికార్డులను తరువాత తిరిగి పంపవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อสิ้นสุดการออกกำลังกาย จะส่งไปยัง iPhone โดยอัตโนมัติ สามารถส่งบันทึกที่ไม่ส่งได้ในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kez bitirdiğinizde iPhone'a gönderilir. Gönderilmemiş kayıtları daha sonra yeniden gönderebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після завершення, дані надсилаються на iPhone. Не відправлені записи можна буде повторно відправити пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi kết thúc, dữ liệu sẽ được gửi đến iPhone. Bạn có thể gửi lại các bản ghi chưa gửi sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后完成后发送到iPhone。未发送的记录可以在稍后重新发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最后完成后发送到iPhone。未发送的记录可以在稍后重新发送"
          }
        }
      }
    },
