          "stringUnit": {
            "state": "translated",
            "value": "היומן שברצועת הפעילות ימחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch पर चल रही रिकॉर्डिंग हटा दी जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci s Watch-a koji su trenutno u izvođenju će biti uklonjeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Watch-on található edzésadatokat töröltük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang sedang berjalan di Watch akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di allenamento attualmente registrati su Watch verranno eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch上の実行中記録は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch에 있는 실행 중 기록은 삭제됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉचवरचे सध्याचे रेकॉर्ड डिलीट होतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod yang berjalan pada Watch akan dihapus."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige training op de Watch wordt verwijderd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreringen fra Watch vil bli slettet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane z Watch, które są aktualnie wykonywane, zostaną usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros em andamento no Watch serão excluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros em andamento no Watch serão excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrările active de pe Watch vor fi șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи тренировок на Watch будут удалены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznamy z Watchu, ktoré boli spustené, budú odstránené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki iz Watcha bodo izbrisani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiva träningar på Watch kommer att raderas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாட்ச்-ல் உள்ள செயல்பாட்டு பதிவுகள் நீக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchలో ఉన్న ప్రస్తుత రికార్డులు తొలగించబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการใช้งานที่อยู่ใน Watch จะถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat üzerindeki mevcut kayıtlar silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи з Watch будуть видалені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hoạt động hiện tại trên Watch sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表上的正在进行的记录将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch 上的正在进行的记录将被删除。"
          }
