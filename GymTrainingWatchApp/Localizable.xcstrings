          "stringUnit": {
            "state": "translated",
            "value": "שמירה של Health נכשלה, רישום Watch שמר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health को सेव करने में विफल - Watch का रिकॉर्ड सेव हो गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
