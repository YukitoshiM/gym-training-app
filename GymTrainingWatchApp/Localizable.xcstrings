    "watch_widget.6c39297531fa": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+HealthKit.swift:80\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نظرًا لعدم توفر الصحة، يتم تسجيلها يدويًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que Salut no està disponible, s'està gravant manualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používám Health, ale není k dispozici. Zapisuji ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ikke bruge Health, derfor indtastes manuelt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Da Health nicht verfügbar ist, werden die Daten manuell eingegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορείτε να χρησιμοποιήσετε το Health, επομένως καταγράφετε χειροκίνητα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to use Health, so recording manually."
          }
        },
