    "watch_widget.8dbc8435b124": {
      "comment": "GymTrainingWatchApp/WatchContentView.swift:108\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد الانتهاء، سيبدأ مؤقت الاستراحة. يمكنك تحديد العناصر التالية بترتيب مختلف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cop finalitzat, començarà el temporitzador de pausa. Podeu seleccionar els elements següents en un ordre diferent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dokončení začne časovač odpočinku. Můžete si vybrat další cvičení v jiné pořadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauser timeren, når du er færdig. Du kan vælge den næste øvelse i en anden rækkefølge."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abschluss wird die Pausen-Timer gestartet. Sie können die nächste Übung auswählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ολοκληρωθεί, ξεκινάει ο χρονομετρητής. Μπορείτε να επιλέξετε την επόμενη άσκηση με διαφορετική σειρά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest timer starts when complete. You can choose the next exercise in order."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest timer starts when complete. You can choose the next exercise in order."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest timer starts when complete. You can choose the next exercise in order."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest timer starts when complete. You can choose the next exercise in order."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporizador de descanso comenzará al completar el ejercicio. Puede seleccionar el siguiente ejercicio en orden diferente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporizador de descanso comenzará al completar el ejercicio. Puede seleccionar el siguiente ejercicio en orden diferente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet valmis, tauko-aika alkaa. Voit valita seuraavan harjoituksen järjestyksessä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur de pause démarre lorsque vous terminez. Vous pouvez choisir l'exercice suivant dans l'ordre."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur de pause démarre lorsque vous terminez. Vous pouvez choisir l'exercice suivant dans l'ordre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્ણ કરવાથી આરામ ટાઈમર શરૂ થશે. તમે આગામી રાઉન્ડને ક્રમ બદલીને પસંદ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלת טיימר מנוחה לאחר סיום. ניתן לבחור את התרגיל הבא בסדר אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब पूर्ण हो जाए तो ब्रेक टाइमर शुरू हो जाएगा। आप अगले व्यायाम को क्रम बदल कर चुन सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada se dovrši, aktivira se timer za odmor. Možete odabrati sljedeći zadatak u drugačijem redoslijedu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor befejezed, a pihenő időzítő elkezd. A következő feladatot megváltoztathatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timer istirahat dimulai setelah selesai. Anda dapat memilih jenis latihan berikutnya secara berurutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il timer di riposo inizia quando completi. Puoi scegliere l'esercizio successivo in ordine sparso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了すると休憩タイマーが開始。次の種目は順番を変えて選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되면 휴식 타이머가 시작됩니다. 다음 운동은 순서를 변경하여 선택할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण झाल्यावर ब्रेक टाइमर सुरू होईल. पुढील व्यायाम निवडण्यासाठी क्रम बदलू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika selesai, pengatur masa henti akan bermula. Anda boleh memilih aktiviti seterusnya dengan cara yang berbeza."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De rusttimer begint wanneer je een ronde voltooit. Je kunt de volgende oefening selecteren in een andere volgorde."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har fullført, starter pausetimeren. Du kan velge neste øvelse i en annen rekkefølge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zakończeniu uruchomi się timer odpoczynku. Możesz wybrać kolejny ćwiczenie w innej kolejności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cronômetro de descanso será iniciado após a conclusão. Você pode escolher a próxima atividade na ordem desejada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O cronômetro de descanso será iniciado após a conclusão. Você pode escolher a próxima atividade na ordem desejada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După finalizarea sesiunii, începe cronometrul de pauză. Poți alege următoarea activitate în ordine diferită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При завершении цикла запускается таймер отдыха. Вы можете выбрать следующий вид активности в другом порядке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dokončení sa spustí časovač odpočinku. Môžete si vybrať nasledujúci typ cvičenia v inej sekvencii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko se konča, začne časnik za počitek. Lahko izberete naslednjo vadbo po vrsti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausräknaren startar när du är klar. Du kan välja nästa övning i en annan ordning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிந்ததும், ஓய்வு நேரத்தை தொடங்கலாம். அடுத்த பயிற்சிக்கு வரிசையை மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తి చేసిన తర్వాత విరామ సమయం ప్రారంభమవుతుంది. తదుపరి వ్యాయామం కోసం క్రమాన్ని మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเสร็จสิ้น จะเริ่มจับเวลาพัก สามารถเลือกกิจกรรมถัดไปได้ตามลำดับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandığında dinlenme zamanlayıcısı başlar. Bir sonraki egzersizi sırayı değiştirerek seçebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після завершення, таймер відпочинку почнеться. Ви можете вибрати наступний вид діяльності в іншому порядку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi hoàn thành, bộ đếm nghỉ sẽ bắt đầu. Bạn có thể chọn bài tập tiếp theo theo thứ tự khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后启动休息计时器。可以选择下一个项目，并按顺序选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后，休息计时器开始。可以选择下一个项目，顺序不同"
          }
        }
      }
    },
