    "watch_widget.56dc053a7297": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+HealthKit.swift:113\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجنب الحفظ المزدوج في الصحة نظرًا لوجود سجلات لياقة من نفس الفترة الزمنية"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha evitat desar el doble a Salut perquè hi ha registres de fitness del mateix període de temps"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvůli existujícím záznamům Fitness v tomto časovém intervalu jsme se rozhodli pro jednoznačné uložení do Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da der allerede er en Fitness-registrering for samme tid, blev det undgået at gemme dobbelt i Health."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine doppelte Speicherung in \"Gesundheit\" zu vermeiden, wurde die Auswahl aus dem Menü für die gleiche Zeit gewählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λόγω ύπαρξης εγγράφων Fitness για την ίδια ώρα, αποφασίσαμε να μην δημιουργήσουμε διπλή αποθήκευση στην κατηγορία \"Υγεία\"."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoided double saving to Health due to existing Fitness record at the same time."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoided double saving to Health due to existing Fitness record at the same time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoided double saving to Health due to existing Fitness record at the same time."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoided double saving to Health due to existing Fitness record at the same time."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Evité la duplicación de datos en \"Salud\" debido a que ya existe un registro de Fitness para esta misma hora."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Evité la duplicación de datos en \"Salud\" debido a que ya existe un registro de Fitness para esta misma hora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska on olemassa Fitness-tietoja samalla aikavälillä, vältettiin Healthiin tehtävä kaksoistallennus."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Évité une sauvegarde double vers \"Santé\" en raison de l'existence d'un enregistrement Fitness pour cette même période."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Évité une sauvegarde double vers \"Santé\" en raison de l'existence d'un enregistrement Fitness pour cette même période."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ જ સમયે અન્ય ફિટનેસ રેકોર્ડ હોવાથી, હેલ્થમાં ડુપ્લિકેટ સાચવવાનું ટાળવામાં આવ્યું છે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נמנע שמירה כפולה ב-Health בשל רישום פעילות Fitness בזמן זה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्योंकि इसी समय पर फिटनेस रिकॉर्ड मौजूद है, इसलिए हेल्थ पर डबल बैकअप लेने से बचा गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbjegavamo duplu pohranu u Health zbog postojećih Fitness zapisa u isto vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonos időpontban már létező Fitness rekordot, így a Health-hez történő duplázást elkerültem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena ada catatan kebugaran pada waktu yang sama, kami menghindari penyimpanan ganda ke Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitato il salvataggio doppio su Health a causa della presenza di un allenamento simile in questo orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時間帯のFitness記録があるためHealthへの二重保存を避けました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일 시간대의 Fitness 기록이 있으므로 Health에 중복 저장하는 것을 방지했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समान वेळेत Fitness रेकॉर्ड असल्यामुळे Health मध्ये दुहेरी साठवण टाळली आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghalang penyimpanan berganda ke dalam Health kerana terdapat rekod Fitness pada masa yang sama"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Om dubbele opslag naar de Health-app te voorkomen, heb ik gekozen voor een andere tijd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngår å lagre data dobbelt til \"Health\" på grunn av eksisterende treningsregistreringer for samme tidspunkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniknięto podwójnego zapisu w aplikacji Health, ponieważ istnieje już rekord Fitness dla tego samego czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitei a duplicação para a saúde devido à existência de registros de Fitness no mesmo horário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitei a duplicação para a saúde devido à existência de registros de Fitness no mesmo horário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am evitat salvarea dublă către Health, deoarece există deja o înregistrare Fitness pentru aceeași oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы избежать дублирования данных в разделе \"Здоровье\", мы использовали записи о тренировках в определенное время."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvôli existujúcim záznamom Fitness v rovnakom čase som sa rozhodol, že Health nebude obsahovať dvojitý zálohovaný záznam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker obstaja že zapis Fitness za isto časovno obdobje, sem izbral dvojno shranitev v Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att undvika dubbelregistrering till \"Health\" på grund av tidigare träning under samma tidsperiod."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நேரத்தில் உடற்பயிற்சி பதிவு இருப்பதால், ஹெல்தில் இரட்டை சேமிப்பைத் தவிர்க்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకే సమయ పరిధిలో Fitness రికార్డు ఉన్నందున, Healthకు డబుల్ సేవ్ చేయడం నివారించబడింది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจากมีบันทึก Fitness ในช่วงเวลาเดียวกัน จึงหลีกเลี่ยงการบันทึกลง Health แบบซ้ำซ้อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı saatte Fitness kaydı mevcut olduğu için Health'e çift yedekleme yapılmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Через наявність записів Fitness у цей час, було запобігано подвійному збереженню в розділ Health."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tránh sao chép trùng lặp vào Health, chúng tôi đã sử dụng dữ liệu từ cùng thời điểm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于存在同一时间段的健身记录，因此避免了对健康数据的双重保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因为有同一时间段的健身记录，所以避免了健康数据的双重保存"
          }
        }
      }
    },
