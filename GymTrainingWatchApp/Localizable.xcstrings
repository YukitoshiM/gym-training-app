          "stringUnit": {
            "state": "translated",
            "value": "Unable to use Health, so recording manually."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede utilizar Health, por lo que se está registrando manualmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede utilizar Health, por lo que se está registrando manualmente."
          }
        },
