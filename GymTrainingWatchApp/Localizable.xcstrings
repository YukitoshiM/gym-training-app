    "watch_widget.343b2fe4308b": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+Sensors.swift:252\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتراح أخف بنسبة 5% بناءً على عدم تحقيق الهدف، أو RPE، أو انخفاض سرعة التشغيل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposta un 5% més lleugera en funció de l'objectiu no assolit, RPE o disminució de la velocitat de funcionament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jste nedosáhli cíle, nebo pokud je vaše RPE (subjektivní hodnocení úsilí) a rychlost pohybu snížena o 5%, navrhujeme lehčí variantu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag om at reducere intensiteten med 5% fra enten mål, RPE eller reduceret hastighed"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschlag: Reduzieren Sie die Intensität um 5 % aufgrund von unerreichten Zielen, RPE oder reduzierter Bewegungsgeschwindigkeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτείνετε μείωση κατά 5% από έναν από τους στόχους: μη επίτευξη, RPE, μειωμένη ταχύτητα"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a reduction of 5% from either unmet goal, RPE, or reduced movement speed"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a reduction of 5% from either unmet goal, RPE, or reduced movement speed"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a reduction of 5% from either unmet goal, RPE, or reduced movement speed"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a reduction of 5% from either unmet goal, RPE, or reduced movement speed"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Propuesta de reducción del 5% en objetivo, RPE o velocidad de movimiento"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Propuesta de reducción del 5% en objetivo, RPE o velocidad de movimiento"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavoitetta ei saavutettu, ehdota 5% kevyemmin RPE:n tai liikkeen nopeuden perusteella"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer une réduction de 5% basée sur l'un des éléments suivants : objectif non atteint, RPE (échelle perçue d'effort), diminution de la vitesse"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer une réduction de 5% basée sur l'un des éléments suivants : objectif non atteint, RPE (échelle perçue d'effort), diminution de la vitesse"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે ધ્યેય સુધી પહોંચો નથી, તો RPE અને ધીમી ગતિના સૂચનોમાંથી 5% ઘટાડો કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעו הפחתה של 5% ממטרת, רמת מאמץ, או ירידה במהירות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि लक्ष्य प्राप्त नहीं हुआ, तो RPE और गति में 5% की कमी का सुझाव दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predložite 5% manju vrijednost iz bilo koje od: relativnog dometa, konzistentnosti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha nem ért el a célot, javasolunk 5%-kal könnyebbet, az RPE (subjektív erőfeszítési szint) vagy a mozgássebesség alapján."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usulkan penurunan 5% dari salah satu: Target belum tercapai, RPE, kecepatan gerakan menurun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento del 5% per raggiungere l'obiettivo, in base a: obiettivo non raggiunto, RPE (percezione dello sforzo), o diminuzione della velocità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標未達、RPE、動作速度低下のいずれかから5%軽く提案"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 달성 실패, RPE, 동작 속도 저하 중 하나를 선택하여 5% 가볍게 제안"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उद्दिष्ट पूर्ण नाही, RPE (रेटेड perceपट), किंवा हालचालीची गती कमी झाल्यास 5% ने कमी करण्याचा पर्याय"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan penurunan 5% daripada sasaran, RPE, atau pengurangan kelajuan aktiviti"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestie van 5% minder, gebaseerd op onbereikbaar doel, RPE (Subjectief Vermoeidheidsschaal) en verminderde snelheid."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag om å redusere intensiteten med 5% fra enten mål ikke oppnådd, RPE (Rate of Perceived Exertion) eller redusert hastighet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli cel nie został osiągnięty, zaproponuj zmniejszenie o 5% w oparciu o RPE (subiektywną ocenę bólu) lub spowolnienie tempa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestão de redução de 5% em objetivo, RPE ou velocidade da atividade"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestão de redução de 5% em objetivo, RPE ou velocidade da atividade"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugestie de a reduce cu 5% din cauza neîndeplinirii obiectivului, RPE sau scăderii vitezei de execuție"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить уменьшить на 5% (достижение цели, RPE, снижение скорости)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak ste nedosiahli cieľ, navrhujeme znížiť intenzitu o 5 % (RPE, znížená rýchlosť pohybu)"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če cilj ni dosežen, predlagamo zmanjšanje za 5% glede na RPE (subjektivna ocena bolečine) ali upočasnitev gibanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreslå en lättare variant (5%) baserat på antingen mål, RPE eller minskad hastighet"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இலக்கை அடையவில்லை, RPE, அல்லது இயக்க வேகம் குறைந்துள்ளது என்பதிலிருந்து 5% குறைவாக பரிந்துரைக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లక్ష్యాన్ని చేరుకోలేకపోతే, RPE, కదలిక వేగం తగ్గడం వంటి వాటి నుండి 5% తక్కువ సూచించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำให้ลดลง 5% จากเป้าหมาย, RPE, หรือความเร็วในการออกกำลังกายที่ลดลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef ulaşmadı, RPE veya hareket hızı düşüşünden %5 daha hafif bir öneri"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запропонувати 5% легше, якщо досягнуто ціль, або RPE, або зниження швидкості"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất giảm 5% từ mục tiêu chưa đạt, RPE hoặc tốc độ tập luyện chậm lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果未达到目标，RPE或动作速度下降，则建议轻微调整5%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果未达成目标，RPE或动作速度下降，则轻微建议5%"
          }
        }
      }
    },
