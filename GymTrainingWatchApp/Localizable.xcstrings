          "stringUnit": {
            "state": "translated",
            "value": "Uloženie údajov v aplikácii Health nebolo úspešné, záznamy z Watchu boli uložené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health – Neuspešno shranjevanje, Watch – podatki že shranjeni"
