    "watch_widget.05e4231f9dca": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+Connectivity.swift:421\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على الإرسال إلى iPhone. سأحتفظ بسجل وأعيد إرساله."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot enviar a l'iPhone. Guardaré un registre i el tornaré a enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není možné odeslat. Zachovejte záznam a odešlete jej znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sende. Gem data og send igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung ist fehlgeschlagen. Bitte senden Sie die Aufzeichnung erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπόρεσα να στείλω τα δεδομένα καταγραφής. Παρακαλώ, στείλτε ξανά, διατηρώντας τις υπάρχουσες καταγραφές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to send to iPhone. Please save the record and resend."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to send to iPhone. Please save the record and resend."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to send to iPhone. Please save the record and resend."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to send to iPhone. Please save the record and resend."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar. Guarde y vuelva a intentar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar. Guarde y vuelva a intentar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedot eivät voi lähetettä. Voit säilyttää ne ja lähettää uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'envoyer les données. Veuillez les enregistrer et les renvoyer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'envoyer les données. Veuillez les enregistrer et les renvoyer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઈફોન પર મોકલવામાં આવતું નથી. રેકોર્ડ સાચવો અને ફરીથી મોકલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשלוח. אנא שרטט ותשלח מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone पर भेजना संभव नहीं है। कृपया रिकॉर्ड को सहेजें और फिर से भेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mogu poslati podatke. Možete ih ponovno poslati sačuvanima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentést nem tudtam elküldeni. Kérjük, mentsen meg az adatokat, majd küldje újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengirim. Simpan catatan dan kirim kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile inviare i dati. Salva la registrazione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneへ送信できませんでした。記録を残して再送します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone으로 전송할 수 없습니다. 기록을 남기고 다시 전송해주세요"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयफोनवर पाठवण्यात अयशस्वी. रेकॉर्ड ठेवा आणि पुन्हा पाठवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghantar. Simpan rekod dan hantar semula."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon niet naar de iPhone sturen. Ik zal het opnieuw verzenden met de gegevens."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sende. Behold registreringen og send den på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można wysłać danych. Zachowaj je i wyślij ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar. Salve o registro e envie novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar. Salve o registro e envie novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut trimite datele. Păstrați înregistrarea și trimiteți-o din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно отправить данные. Сохраните их и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa odoslať údaje. Uložte si ich a skúste znovu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatki ne morejo biti poslani. Pošljite jih še enkrat, da boste ohranili"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickade inte. Spara och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஐபோனுக்கு அனுப்ப முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneకు పంపడం సాధ్యం కాలేదు. రికార్డును ఉంచి, మళ్లీ పంపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถส่งไปยัง iPhone ได้ โปรดบันทึกและส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'a göndermeyi başaramadım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відправити. Збережіть записи та відправте їх повторно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gửi. Vui lòng lưu và gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送给 iPhone。请保留记录并再次发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送给 iPhone。请保留记录并再次发送"
          }
        }
      }
    },
