    "watch_widget.b871438c85a2": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+Sensors.swift:257\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقترح أن يكون أثقل بنسبة 2.5% بناءً على الطاقة المتبقية وسرعة التشغيل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es recomana un 2,5% més pesat en funció de la potència restant i la velocitat de funcionament"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě vaší kondice a rychlosti doporučujeme zvýšit váhu o 2,5 %."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag om 2,5 % mere baseret på resterende energi og hastighed"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Basis von Ausdauer und Geschwindigkeit: Vorschlag um 2,5 % höher"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
