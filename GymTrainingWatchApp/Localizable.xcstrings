        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan Watch belum tersimpan, tetapi sudah tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati di Health non salvati, ma i dati di Watch sono stati salvati."
          }
        },
