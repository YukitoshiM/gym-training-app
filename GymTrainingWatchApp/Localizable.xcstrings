      "comment": "GymTrainingWatchApp/WatchWorkoutStore+HealthKit.swift:285\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ الصحة/تم حفظ سجلات المشاهدة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La salut no s'ha desat/Els registres de rellotge s'han desat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládání v Health nebylo úspěšné. Nahrávání na Watch je uloženo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Health gemt - Watch-data er gemt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-Daten wurden nicht gespeichert – Watch-Aufzeichnung wurde gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η καταγραφή στο Watch έχει αποθηκεστεί, αλλά το Health δεν έχει αποθηκευτεί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Health not saved; Watch recording saved."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Health not saved; Watch recording saved."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Health not saved; Watch recording saved."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Health not saved; Watch recording saved."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro del Watch guardado / No se ha guardado en Health"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro del Watch guardado / No se ha guardado en Health"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-tiedot eivät ole tallentuneet, Watch-tiedot tallennettu"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Données enregistrées sur Watch / Santé non sauvegardée"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Données enregistrées sur Watch / Santé non sauvegardée"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હેલ્થ અસંપૂર્ણ, વોચ રેકોર્ડ સાચવેલ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רישום Watch שמר, שמירת Health לא בוצעה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health सेव नहीं हुआ - Watch का रिकॉर्ड सेव हो गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci s Watch-a su spremni, ali podaci u Health-u nisu."
