        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हेल्थ डेटा सेव्ह नाही. वॉच रेकॉर्ड सेव्ह केले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod Watch telah disimpan – Simpanan Health belum disimpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-gegevens zijn nog niet opgeslagen, Watch-gegevens zijn wel opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-registrering er ikke lagret, Watch-registrering er lagret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane nie zostały zapisane, dane z Watch zostały zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro do Watch já salvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro do Watch já salvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea Health nu a fost salvată, dar înregistrarea Watch a fost salvată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не сохранены, запись с Watch уже сохранена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznamy z Watchu boli uložené, údaje v aplikácii Health nie sú uložené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Health – Podatki še niso shranjeni, Watch – podatki že shranjeni"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Health-data sparades inte, Watch-data sparades."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுகாதாரத்தைப் பதிவு செய்யவில்லை, ஆனால் வாட்ச் பதிவைச் சேமித்துவிட்டோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Health నిల్వ చేయబడలేదు - Watch రికార్డు నిల్వ చేయబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลใน Health ยังไม่สำเร็จ แต่บันทึกข้อมูล Watch สำเร็จแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health kaydı alınamadı - Watch kaydı kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи з Watch вже збережено, але дані в Health не збережені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
