        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுகாதாரத்தைப் பயன்படுத்த முடியவில்லை, எனவே கைமுறையாகப் பதிவு செய்கிறேன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Healthని ఉపయోగించలేకపోతున్నందున, మాన్యువల్‌గా రికార్డ్ చేస్తున్నాను."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถใช้ Health ได้ จึงบันทึกด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Health'i kullanılamadığı için elle kaydediliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається використовувати Health, тому дані вводяться вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sử dụng Health, đang ghi lại thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法使用健康应用，因此进行手动记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法使用 Health，因此使用手动输入记录"
          }
        }
      }
    },
