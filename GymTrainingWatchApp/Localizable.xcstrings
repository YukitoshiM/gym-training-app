        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వాచ్‌లో iPhoneతో అనుసంధానం ఉపయోగించలేము. రికార్డులు వాచ్‌లో నిల్వ చేయబడ్డాయి"
