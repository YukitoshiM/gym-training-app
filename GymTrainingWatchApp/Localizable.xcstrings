    "watch_widget.62d8e367decc": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+Connectivity.swift:192\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نحن نستعد حاليًا لتكامل iPhone. ويمكنك إعادة إرساله لاحقًا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualment estem preparant la integració de l'iPhone. Podeu tornar-lo a enviar més tard"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
