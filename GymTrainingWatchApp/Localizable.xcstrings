    "watch_widget.50b4d8445e1e": {
      "comment": "GymTrainingWatchApp/WatchContentView.swift:98\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تغيير الوزن وعدد المرات وRPE والباقي على البكرات قبل وبعد البدء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El pes, el nombre de vegades, RPE i el descans es poden canviar als rodets abans i després de l'inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váha, počet opakování, RPE a přestávky lze upravit pomocí posuvníku před i po zahájení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vægt, antal gentagelser, RPE og pauser kan ændres før og efter træningen ved hjælp af rep-funktionen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht, Anzahl, RPE und Pausen können vor und nach dem Training mit der Kurbel geändert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βάρος, ο αριθμός επαναλήψεων και η ένταση (RPE) μπορούν να τροποποιηθούν πριν και μετά την έναρξη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change weight, reps, RPE, and rest before and after starting using the reel."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change weight, reps, RPE, and rest before and after starting using the reel."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change weight, reps, RPE, and rest before and after starting using the reel."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change weight, reps, RPE, and rest before and after starting using the reel."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El peso, las repeticiones, la escala de esfuerzo percibido y los descansos se pueden cambiar antes y después de cada repetición."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El peso, las repeticiones, la escala de esfuerzo percibido y los descansos se pueden cambiar antes y después de cada repetición."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paino, toistot, RPE ja tauko voidaan muuttaa ennen ja jälkeen harjoittelun pyörällä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poids, le nombre de répétitions, l'échelle RPE et les pauses peuvent être modifiés avant ou après chaque série."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poids, le nombre de répétitions, l'échelle RPE et les pauses peuvent être modifiés avant ou après chaque série."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન, સંખ્યા, RPE અને વિરામ રીલમાં શરૂઆત પહેલાં અને પછી બદલી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשנות את המשקל, מספר החזרות, רמת מאמץ והפסקות באמצעות גלגל הסיבוב לפני ואחרי האימון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, संख्या, RPE और ब्रेक को शुरू करने से पहले या बाद में रीलों पर बदला जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete promijeniti teret, broj, RPE i pauzu prije i poslije početka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A súly, a mennyiség, az RPE és a pihenés változtatható menetként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat, jumlah, RPE, dan istirahat dapat diubah menggunakan reel sebelum dan sesudah memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificare peso, ripetizioni, RPE e pause prima o dopo l'allenamento utilizzando la rotellina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重量・回数・RPE・休憩は開始前後にリールで変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무게, 횟수, RPE, 휴식은 시작 전후에 리드로 변경할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, संख्या, RPE, आणि विश्रांती रीलवर सुरू करण्यापूर्वी आणि नंतर बदलता येते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat, jumlah, RPE, dan masa rehat boleh diubah sebelum dan selepas bermula menggunakan roda."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht, aantal, RPE en pauzes kunnen worden aangepast voor en na de start."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan endre vekt, antall repetisjoner, RPE og pauser før og etter øvelsen ved hjelp av spolen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zmienić wagę, liczbę powtórzeń, RPE i czas odpoczynku przed lub po rozpoczęciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O peso, número de repetições, RPE e descanso podem ser alterados no repitir antes e depois do início."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O peso, número de repetições, RPE e descanso podem ser alterados no repitir antes e depois do início."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți modifica greutatea, numărul de repetări, RPE și pauzele înainte sau după antrenament folosind un slider."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вес, количество повторений, RPE и время отдыха можно изменить до начала тренировки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váha, počet opakovaní, RPE a pauza môžete meniť na pultu pred alebo po začiatku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Težo, število ponovitev in RPE lahko spremenite z pomočnim ročajem pred ali po začetku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ändra vikt, antal repetitioner, RPE och pauser före eller efter träningen med hjälp av repen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடை, எண்ணிக்கை, RPE மற்றும் ஓய்வு ஆகியவை தொடங்குவதற்கு முன்பு அல்லது பின் ரிங்கில் மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు, సంఖ్య, RPE, విరామం మొదలైనవి ప్రారంభానికి ముందు మరియు తరువాత రీల్ ద్వారా మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถปรับเปลี่ยนน้ำหนัก, จำนวนครั้ง, RPE และพัก โดยใช้รีล ก่อนและหลังการเริ่มต้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık, tekrar sayısı, RPE ve dinlenme, başlangıç ve sonrasında tekrarla ile değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вага, кількість повторень, RPE та перерви можна змінювати перед початком або після."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể thay đổi trọng lượng, số lần, RPE và thời gian nghỉ trước hoặc sau khi bắt đầu bằng thanh trượt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重量、次数、RPE和休息可以在开始前后的卷尺上进行更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重量、次數、RPE和休息可以在開始前後使用捲軸進行修改。"
          }
        }
      }
    },
