          "stringUnit": {
            "state": "translated",
            "value": "Health未保存・Watch記録は保存済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Health 미저장 - Watch 기록은 저장됨"
