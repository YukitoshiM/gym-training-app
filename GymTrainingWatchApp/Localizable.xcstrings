    "watch_widget.24aa552350de": {
      "comment": "GymTrainingWatchApp/WatchWorkoutStore+Sensors.swift:285\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "معدل ضربات القلب يتعافى. بمجرد أن تشعر بالراحة، انتقل إلى المجموعة التالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La freqüència cardíaca s'està recuperant. Quan us sentiu còmode, passeu al següent conjunt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Srdeční tep se vrací. Pokud máte pocit, že jste připraveni, pokračujte do dalšího setu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit hjertefrekvens er ved at komme tilbage. Når du har fået en god følelse, kan du gå videre til næste sæt"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Herzfrequenz ist auf dem Weg zur Erholung. Wenn Sie sich wohl fühlen, können Sie mit dem nächsten Satz beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συχνότητα καρδιακών παλμών είναι σταθερή. Όταν νιώσετε άνετα, προχωρήστε στην επόμενη επανάληψη"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate is returning to normal. If you feel comfortable, proceed to the next set"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate is returning to normal. If you feel comfortable, proceed to the next set"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate is returning to normal. If you feel comfortable, proceed to the next set"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Heart rate is returning to normal. If you feel comfortable, proceed to the next set"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Su frecuencia cardíaca está mejorando. Si se siente cómodo, puede pasar al siguiente conjunto"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Su frecuencia cardíaca está mejorando. Si se siente cómodo, puede pasar al siguiente conjunto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syke on laskussa. Kun tunnet olosi hyvin, voit siirtyä seuraavaan sarjaan"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rythme cardiaque est en train de se stabiliser. Ajustez votre ressenti et passez au prochain ensemble."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre rythme cardiaque est en train de se stabiliser. Ajustez votre ressenti et passez au prochain ensemble."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હૃદયના ધબકારા સામાન્ય થઈ રહ્યા છે. જ્યારે તમને સારું લાગે, ત્યારે તમે આગામી સેટમાં જઈ શકો છો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצב הלב נמצא במגמת שיפור. לאחר שהתאמנת, ניתן להתחיל את הסט הבא"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हृदय गति सामान्य दिशा में है। जब आप सहज महसूस करें, तो अगले सेट पर जाएं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Srčani ritam se vraća u normalu. Kada osjetite da ste spremni, nastavite"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az EKG normál értéket mutat. Ha jól érzed, folytasd a következő sorozattal"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Detak jantung menunjukkan tren pemulihan. Jika Anda merasa nyaman, lanjutkan ke set berikutnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il battito cardiaco è in fase di recupero. Quando ti senti pronto, puoi passare alla serie successiva"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心拍は回復傾向です。感覚が整えば次のセットへ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심박수는 회복 추세입니다. 감각이 안정되면 다음 세트로 진행"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हृदयाचा दर सुधारत आहे. जेव्हा तुम्हाला योग्य वाटेल, तेव्हा पुढील सेटमध्ये जा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Denyutan jantung anda sedang meningkat. Jika anda merasakan selesa, teruskan ke set seterusnya"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hartslag is aan het herstellen. Als je je goed voelt, ga dan verder met de volgende set"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Puls er på vei tilbake. Når du føler deg klar, kan du gå videre til neste sett"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tętno wraca do normy. Jeśli czujesz się dobrze, przejdź do następnego zestawu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração está voltando ao normal. Se você se sentir confortável, pode prosseguir para o próximo conjunto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu coração está voltando ao normal. Se você se sentir confortável, pode prosseguir para o próximo conjunto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Frecvența cardiacă este în scădere. Dacă simți că ești pregătit, poți începe următoarea sesiune"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пульс возвращается к норме. Когда вы почувствуете себя хорошо, переходите к следующему циклу"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Srdcová frekvencia sa vracajúca. Ak cítite, že je to správne, pokračujte do nasledujúcej série"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Srčni utrip se vrača. Ko se počutite dobro, lahko začnete z naslednjo serijo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Puls är på väg tillbaka. När du känner dig redo kan du gå vidare till nästa serie"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதயத் துடிப்பு, மீண்டு வருகிறது. உங்கள் உணர்வுக்கு ஏற்ப அடுத்த சுற்றுக்கு செல்லலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గుండె కొట్టుకునే వేగం సాధారణ స్థితికి వస్తోంది. మీరు సౌకర్యంగా ఉంటే, తదుపరి సెట్‌కు వెళ్లవచ్చు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัตราการเต้นหัวใจอยู่ในภาวะพักฟื้น สามารถเริ่มเซ็ตถัดไปได้เมื่อรู้สึกพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalp atışları iyileşme eğiliminde. Duyularınız düzenlendiğinde bir sonraki sete geçebilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пульс відновлюється. Якщо ви відчуваєте комфорт, переходьте до наступного набору"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhịp tim đang có xu hướng hồi phục. Khi cảm thấy thoải mái, bạn có thể chuyển sang tập tiếp theo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心率恢复趋势。当感觉良好时，可以进入下一组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "心率恢复趋势。当感觉良好时，进入下一组"
          }
        }
      }
    },
