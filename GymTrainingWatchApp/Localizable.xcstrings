          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed understøtter ikke iPhone-integration. Optagelserne gemmes på enheden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Gerät kann keine Verbindung mit dem iPhone hergestellt werden. Die Aufzeichnung wird auf dem Gerät gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορεί να χρησιμοποιηθεί η σύνδεση με το iPhone σε αυτό το ρολόι. Οι εγγραφές αποθηκεύονται στο ρολόι."
