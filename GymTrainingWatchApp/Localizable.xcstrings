    "watch_widget.outdoor_route_privacy": {
      "comment": "GymTrainingWatchApp/Views/WatchOutdoorWorkoutViews.swift:55\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم حفظ المسار في Apple Health ولا يتم إرساله إلى الذكاء الاصطناعي أو الإعلانات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta s'emmagatzema a Apple Health i no es comparteix amb IA ni publicitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasa je uložena v Apple Health a nebude odeslána AI ani reklamám."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruten gemmes i Apple Health og sendes ikke til AI eller annoncer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Route wird in Apple Health gespeichert und nicht an KI oder Werbung gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαδρομή αποθηκεύεται στο Apple Health και δεν αποστέλλεται σε AI ή διαφημιστικές υπηρεσίες."
          }
        },
        "en-AU": {
