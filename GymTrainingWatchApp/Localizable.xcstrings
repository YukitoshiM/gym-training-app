            "value": "No s'ha pogut desar la salut/El registre de visualització s'ha desat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládání v Health selhalo. Nahrávání na Watch je uloženo."
