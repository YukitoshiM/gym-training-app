        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva os treinos de força e as medições corporais registrados no Apple Watch na Apple Health."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva os treinos de força e as medições corporais registrados no Apple Watch na Apple Health."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvez antrenamentele și măsurătorile corporale înregistrate cu Apple Watch în Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняем данные о силовых тренировках и измерениях физической формы, записанные на Apple Watch, в приложении Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenané silové tréningy a meranie tela na Apple Watch uložíte do Apple Health."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane vtiče za trening in merjenje teles ter Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara styrketränings- och kroppsmätningar som tagits med Apple Watch i Apple Health."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-ல் பதிவு செய்யப்பட்ட உடற்பயிற்சி மற்றும் உடல் அளவீடுகளை Apple Health-ல் சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchలో రికార్డ్ చేసిన కండరాల వ్యాయామం మరియు శరీర కొలతలను Apple Healthలో సేవ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการฝึกความแข็งแรงและวัดร่างกายที่ Apple Watch และบันทึกลงใน Apple Health"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch'ta kaydedilen kas gücü antrenmanlarını ve vücut ölçümlerini Apple Health'e kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберегти тренування зі зміцнення м'язів та вимірювання фізичного стану, зафіксовані на Apple Watch, у Apple Health."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu các bài tập sức mạnh và đo thể chất đã ghi trên Apple Watch vào Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将通过Apple Watch记录的力量训练和身体测量数据保存到Apple Health。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將在 Apple Watch 上記錄的肌力訓練和身體測量儲存到 Apple Health。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "GymTrainingApp/Info.plist:NSLocalNetworkUsageDescription\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الشبكة المحلية للاتصال بخادم AI محلي محدد من قبل المستخدم، مثل Mac mini."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza la xarxa local per connectar-se a un servidor d'IA local especificat per l'usuari, com ara un Mac mini."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro připojení k lokálnímu serveru AI, který si uživatel vybere (např. Mac mini), použijete lokální síť."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug et lokalt netværk til at oprette forbindelse til en lokal AI-server, som brugeren har angivet (f.eks. Mac mini)."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Verbindung zu einem lokalen KI-Server, den der Benutzer angibt (z. B. Mac mini), wird ein lokales Netzwerk verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το τοπικό δίκτυο για να συνδεθείτε σε έναν τοπικό διακομιστή AI που καθορίζετε, όπως το Mac mini."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a local network to connect to a locally hosted AI server specified by the user (e.g., Mac mini)."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a local network to connect to a locally hosted AI server specified by the user (e.g., Mac mini)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a local network to connect to a locally hosted AI server specified by the user (e.g., Mac mini)."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a local network to connect to a locally hosted AI server specified by the user (e.g., Mac mini)."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizo una red local para conectarme al servidor de IA local especificado por el usuario, como un Mac mini."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizo una red local para conectarme al servidor de IA local especificado por el usuario, como un Mac mini."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä paikallista verkkoa yhteyden muodostamiseen käyttäjän valitsemaan paikalliseen AI-palvelimeen (esim. Mac mini)."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un réseau local pour vous connecter à un serveur d'IA local spécifié par l'utilisateur, tel qu'un Mac mini."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un réseau local pour vous connecter à un serveur d'IA local spécifié par l'utilisateur, tel qu'un Mac mini."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે Mac mini જેવા, વપરાશકર્તા દ્વારા નિર્દિષ્ટ સ્થાનિક AI સર્વર સાથે કનેક્ટ કરવા માટે સ્થાનિક નેટવર્કનો ઉપયોગ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש ברשת מקומית כדי להתחבר לשרת AI מקומי, כפי שהמשתמש מציין (למשל, Mac mini)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac mini आदि, उपयोगकर्ता द्वारा निर्दिष्ट लोकल AI सर्वर से कनेक्ट करने के लिए लोकल नेटवर्क का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite lokalnu mrežu kako biste se povezali s lokalnim AI serverom koji je korisnik odabrao (npr. Mac mini)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhasználó által kiválasztott helyi AI szerverhez való csatláshoz használjuk a helyi hálózatot (pl. Mac mini)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan jaringan lokal untuk terhubung ke server AI lokal yang ditentukan oleh pengguna, seperti Mac mini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzo la rete locale per connettermi a un server AI locale specificato dall'utente (ad esempio, Mac mini)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac miniなど、ユーザーが指定したローカルAIサーバーへ接続するためにローカルネットワークを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac mini 등, 사용자가 지정한 로컬 AI 서버에 연결하기 위해 로컬 네트워크를 사용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॅक मिनी (Mac mini) किंवा वापरकर्त्याने निवडलेल्या लोकल एआय सर्व्हरशी कनेक्ट होण्यासाठी लोकल नेटवर्कचा वापर करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan rangkaian tempatan untuk menyambung ke pelayan AI tempatan yang ditentukan oleh pengguna, seperti Mac mini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gebruikt een lokaal netwerk om verbinding te maken met een door u gekozen lokale AI-server, zoals een Mac mini."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker lokal nettverk for å koble til en lokal AI-server som brukeren har spesifisert, f.eks. Mac mini."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używam lokalnej sieci, aby połączyć się z lokalnym serwerem AI, który użytkownik określił (np. Mac mini)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza a rede local para se conectar a um servidor de IA local especificado pelo usuário, como o Mac mini."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza a rede local para se conectar a um servidor de IA local especificado pelo usuário, como o Mac mini."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizează rețeaua locală pentru a te conecta la un server AI local, specificat de utilizator (de exemplu, Mac mini)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используем локальную сеть для подключения к локальному серверу ИИ, указанному пользователем (например, Mac mini)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používate lokálnu sieť, aby ste sa pripoili k miestnemu AI serveru, ktorý si užívateľ určí (napr. Mac mini)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za povezavo z lokalnim AI stremlom, ki ga uporabnik izbere (npr. Mac mini), se uporablja lokalna mreža."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ett lokalt nätverk för att ansluta till en lokal AI-server som användaren har angivit, t.ex. en Mac mini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac mini போன்ற, பயனரால் குறிப்பிடப்பட்ட உள்ளூர் AI சர்வரில் இணைவதற்கு உள்ளூர் நெட்வொட்டை பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac mini వంటి, వినియోగదారు పేర్కొన్న స్థానిక AI సర్వర్‌కు కనెక్ట్ చేయడానికి స్థానిక నెట్‌వర్క్‌ను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เครือข่ายภายในเพื่อเชื่อมต่อกับเซิร์ฟเวอร์ AI ที่ผู้ใช้ระบุ เช่น Mac mini"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac mini gibi, kullanıcı tarafından belirtilen yerel AI sunucularına bağlanmak için yerel ağ kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати локальну мережу для підключення до локального сервера штучного інтелекту, який вказав користувач (наприклад, Mac mini)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng mạng cục bộ để kết nối với máy chủ AI cục bộ mà người dùng chỉ định (ví dụ: Mac mini)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本地网络连接到用户指定的本地AI服务器，例如Mac mini。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用本地網路連接到用戶指定的本地 AI 伺服器，例如 Mac mini。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "GymTrainingApp/Info.plist:NSLocationAlwaysAndWhenInUseUsageDescription\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نحن نستخدم معلومات الموقع لتسجيل وصولك ومغادرتك صالة الألعاب الرياضية التي قمت بالتسجيل فيها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
