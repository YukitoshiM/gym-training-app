        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les entraînements et les mesures corporelles effectués avec votre Apple Watch dans Apple Health."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les entraînements et les mesures corporelles effectués avec votre Apple Watch dans Apple Health."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે Apple Watch પર કરેલા વર્કઆઉટ અને શારીરિક માપનને Apple Health માં સાચવી શકો છો."
