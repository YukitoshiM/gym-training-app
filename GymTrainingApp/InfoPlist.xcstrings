            "value": "Use location services to record arrival and departure from registered gyms."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use location services to record arrival and departure from registered gyms."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use location services to record arrival and departure from registered gyms."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza la información de ubicación para registrar tu llegada y salida del gimnasio registrado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza la información de ubicación para registrar tu llegada y salida del gimnasio registrado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä sijaintitietoja, kun tallennat saapumisen ja lähtemisen rekisteröidylle kuntosalille."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la localisation pour enregistrer votre arrivée et votre départ à la salle de sport que vous avez enregistrée."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la localisation pour enregistrer votre arrivée et votre départ à la salle de sport que vous avez enregistrée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે નોંધાયેલ જિમ પરના આગમન અને વિદાયને રેકોર્ડ કરવા માટે સ્થાનનો ઉપયોગ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש במידע מיקום כדי לתעד הגעה ויציאה מחדר הכושר שהורשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजीकृत जिम पर आने और बाहर जाने की जानकारी रिकॉर्ड करने के लिए लोकेशन का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite lokaciju za bilježenje dolaska i odlaska u registriranu dvoranu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használhatod a helyzet követést, hogy rögzítsd az érkezést és kilépést a regisztrált edzőterembe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan informasi lokasi saat mencatat kedatangan dan keberangkatan dari pusat kebugaran yang terdaftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza la posizione per registrare l'arrivo e la partenza dalla palestra registrata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録したジムへの到着と退出を記録する場合に位置情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록한 헬스장 도착 및 퇴장을 기록할 때 위치 정보를 사용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंद केलेल्या जिममध्ये येणे आणि बाहेर जाण्याची नोंद ठेवताना लोकेशनचा वापर करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan maklumat lokasi apabila mencatat ketibaan dan keluar dari gim yang telah didaftar."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik locatie-informatie om aankomst- en vertrektijden bij de geregistreerde sportschool op te nemen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker posisjonsinformasjon for å registrere ankomst og avreise til det registrerte treningsstedet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj lokalizacji do rejestrowania przyjazdu i wyjazdu z zarejestrowanej siłowni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza a localização para registrar a chegada e saída do ginásio registrado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza a localização para registrar a chegada e saída do ginásio registrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizează informațiile despre locație atunci când înregistrezi sosirea și plecarea de la sala de sport."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте данные о местоположении для записи прибытия и отъезда из зарегистрированного фитнес-зала."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite polohu pri zaznamenávaní príchodu a odchodu z zaregistrovaného fitness centra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za zabeležitev prihoda in odhoda iz registrirane telnice uporabite lokacijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd platsinformation för att registrera ankomst och avgång till det registrerade gymmet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்யப்பட்ட உடற்பயிற்சி மையத்திற்கு வந்ததும், வெளியேறியதும் இருப்பிடத் தகவலைப் பயன்படுத்திப் பதிவு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డ్ చేసిన జిమ్‌కు రావడం మరియు నిష్క్రమించడం కోసం స్థాన సమాచారాన్ని ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ตำแหน่งที่ตั้งเมื่อต้องการบันทึกการมาถึงและออกจากยิมที่ลงทะเบียน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz spor salonuna giriş ve çıkışlarınızı kaydetmek için konum bilgisini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати дані про місцезнаходження для запису прибуття та виходу з зареєстрованого спортзалу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng vị trí để ghi lại thời gian đến và rời khỏi phòng gym đã đăng ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在记录到达和离开指定健身房时，使用位置信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在記錄到已註冊的健身房的抵達和離開時，使用位置資訊。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "GymTrainingApp/Info.plist:NSLocationWhenInUseUsageDescription\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نحن نستخدم معلومات موقعك لتسجيل موقعك الحالي كصالة ألعاب رياضية وتسجيل زياراتك إلى صالة الألعاب الرياضية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitzem la informació de la vostra ubicació per registrar la vostra ubicació actual com a gimnàs i registrar les vostres visites al gimnàs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaregistrujte aktuální lokalitu jako posilovnu a používejte polohu pro zaznamenávání návštěv posiloven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer dit lokale fitnesscenter som et sted og brug placering for at registrere besøg."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe einen Fitnessraum als Standort registriert und verwende die Ortung, um Besuche dort aufzuzeichnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράψτε το σημείο ως γυμναστήριο και χρησιμοποιήστε την τοποθεσία για να καταγράψετε τις επισκέψεις σας στο γυμναστήριο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Register your local gym and use location services to record visits."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Register your local gym and use location services to record visits."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Register your local gym and use location services to record visits."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Register your local gym and use location services to record visits."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu gimnasio actual como ubicación y utiliza la información de ubicación para registrar tus visitas al gimnasio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu gimnasio actual como ubicación y utiliza la información de ubicación para registrar tus visitas al gimnasio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekisteröi nykyinen sijainti kuntosaliksi ja käytä sijaintitietoja harjoitteluista kertomiseen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre salle de sport actuelle et utilisez la localisation pour enregistrer vos visites."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre salle de sport actuelle et utilisez la localisation pour enregistrer vos visites."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે વર્કઆઉટ માટે \"જિમ\" તરીકે સ્થાનને રજીસ્ટર કરી શકો છો અને જિમની મુલાકાતોને રેકોર્ડ કરવા માટે સ્થાનનો ઉપયોગ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתעד את המיקום כחדר כושר ומשתמש במידע מיקום כדי לתעד ביקורים בחדר הכושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान स्थान को जिम के रूप में पंजीकृत करें और जिम जाने की जानकारी रिकॉर्ड करने के लिए लोकेशन का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrirajte svoju fizičku lokaciju kao dvoranu i koristite je za bilježenje posjeta dvorani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Regisztrálhatod a jelenlegi helyszínt edzőteremként, és használhatod a helyzet követést az edzőterembe való látogatás rögzítéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendaftarkan lokasi Anda sebagai pusat kebugaran dan menggunakan informasi lokasi untuk mencatat kunjungan ke pusat kebugaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la tua palestra preferita e utilizza la posizione per registrare le visite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地をジムとして登録し、ジム訪問を記録するために位置情報を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 헬스로 등록하고, 헬스 방문 기록을 위해 위치 정보를 사용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्याचे ठिकाण जिम म्हणून नोंदवा आणि जिमला भेट देण्याची नोंद ठेवण्यासाठी लोकेशनचा वापर करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarkan lokasi semasa sebagai gim dan gunakan maklumat lokasi untuk mencatat lawatan ke gim."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer uw lokale sportschool als locatie en gebruik locatie-informatie om bezoeken op te nemen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer et treningssted (f.eks. et treningsstudio) ved hjelp av posisjonsinformasjon, og registrerer besøk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zarejestrować lokalizację jako siłownię i używać jej do rejestrowania wizyt w siłowni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seu local como um ginásio e utilize a localização para registrar as visitas ao ginásio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seu local como um ginásio e utilize a localização para registrar as visitas ao ginásio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează locația curentă ca sală de sport și utilizează informațiile despre locație pentru a înregistra vizitele la sală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрируйте текущее местоположение как фитнес-зал и используйте его для записи посещений зала."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaregistrujte aktučné miesto ako fitness centrum a použite polohu na zaznamenávanie návštev."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrirate lokacijo posamezne telnice in uporabite lokacijo za zabavo ob obisku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrera en lokal plats som ett gym och använd platsinformation för att registrera besök i gymmet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போதைய இடத்தை உடற்பயிற்சி மையமாக பதிவு செய்து, உடற்பயிற்சி மையத்திற்குச் செல்வதைக் கண்காணிக்க இருப்பிட தகவலைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుత స్థానాన్ని జిమ్‌గా నమోదు చేయడానికి మరియు జిమ్ సందర్శనలను రికార్డ్ చేయడానికి స్థాన సమాచారాన్ని ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสถานที่เป็นยิม และใช้ตำแหน่งที่ตั้งเพื่อบันทึกการเข้า-ออกจากยิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut konumu spor salonu olarak kaydedin ve spor salonuna gidişlerinizi kaydetmek için konum bilgisini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареєструвати місцезнаходження як спортзал і використовувати його для запису відвідування спортзалу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký địa điểm hiện tại làm phòng gym và sử dụng vị trí để ghi lại việc đến và rời khỏi phòng gym."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将当前位置注册为健身房，并使用位置信息记录健身房访问情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將目前位置作為健身房註冊，並使用位置資訊來記錄健身房拜訪。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "comment": "GymTrainingApp/Info.plist:NSMotionUsageDescription\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
