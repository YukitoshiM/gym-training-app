        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo gli allenamenti di forza e le misurazioni fisiche registrati sull'Apple Watch in Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchで記録した筋力トレーニングと身体測定をApple Healthに保存します。"
