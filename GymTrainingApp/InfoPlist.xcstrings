        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardo los entrenamientos de fuerza y las mediciones corporales registrados en el Apple Watch en la aplicación Salud de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna Apple Watchilla tehdyt voimaharjoittelut ja kehon mittaukset Apple Healthiin."
