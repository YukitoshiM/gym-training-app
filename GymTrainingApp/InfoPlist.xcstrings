        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremićete snage i mjerenja tijela koje ste zabilježili na Apple Watch u aplikaciji Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Watchon rögzített erőnléti edzéseket és fizikai méréseket mentjük az Apple Healthbe."
