    "domain_catalog.04fd00e0335e": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:382\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح ركبتيك للخارج وأرجعهما ببطء، مع التركيز على الألوية الوسطى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obriu els genolls cap a fora i torneu-los lentament, centrant-vos en el gluti mitjà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete kolena do strany a pomalu vraťte se, soustřeďte se na střední svaly v oblasti kyčlí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn knæene udad og træk gluteus maximus langsomt tilbage."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie das Knie leicht und kehren Sie langsam mit dem Fokus auf die Gesäßmuskulatur zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιγμα των γονάτων προς τα έξω και επιστρέφει αργά με επίγνωση στους μύς της μέσης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your knees outwards and slowly return them, focusing on your inner thigh muscles."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your knees outwards and slowly return them, focusing on your inner thigh muscles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your knees outwards and slowly return them, focusing on your inner thigh muscles."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your knees outwards and slowly return them, focusing on your inner thigh muscles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir las piernas hacia afuera y regresar lentamente, prestando atención a los músculos glúteos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir las piernas hacia afuera y regresar lentamente, prestando atención a los músculos glúteos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa polvet ja vedä pakaroita hienovaraisesti taaksepäin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les genoux et revenir lentement en utilisant les muscles fessiers, en gardant une bonne posture."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les genoux et revenir lentement en utilisant les muscles fessiers, en gardant une bonne posture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું ઘૂંટણ બહારની તરફ ખોલો, અને મિડ-હાઇપ્સ સ્નાયુ પર ધ્યાન કેન્દ્રિત કરીને ધીમેથી પાછું લાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת הברכיים והחזרה איטית תוך שימוש בשריר המיתרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने घुटनों को बाहर की ओर खोलें और अपनी मध्य-पैर की मांसपेशियों पर ध्यान केंद्रित करते हुए धीरे-धीरे वापस लाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorete koljena prema van i polako vratite unutarnje mišiće u glavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyitja ki a térdeit, és óvatosan hajtja vissza a hasizomokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka lutut ke samping dan perlahan menarik otot gluteus secara sadar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprire le ginocchia e ritrarle lentamente, concentrandosi sui muscoli glutei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝を外へ開き、中臀筋を意識してゆっくり戻す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎을 벌리고, 중둔근을 의식하며 천천히 되돌린다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गुडघे बाहेरच्या बाजूला मोडा आणि Gluteus Maximus स्नायूंवर लक्ष केंद्रित करून हळूवारपणे परत आणा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka lutut ke arah luar, dan perlahan menarik otot tengah pinggul."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Open je knieën en breng je heupflexoren bewust terug, terwijl je langzaam beweegt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne knærne litt og strekk ut gluteus medius forsiktig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz kolana na boki i powoli wróć do pozycji wyjściowej, koncentrując się na mięśniach pośladkowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra os joelhos para os lados e retorne lentamente, concentrando-se nos glúteos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra os joelhos para os lados e retorne lentamente, concentrando-se nos glúteos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide genunchii spre exterior și retrage-i lent, concentrându-te pe fesieri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать колени и медленно возвращать их обратно, уделяя внимание мышцам в области таза."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otočte kolená a pomaly ich vráťte, pričom si všímajte svaly medzi zadnými a vnútornými stranou stehien."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprijete kolena proti zunanjim stranem in se počasi vrnete, pri čemer poudarite mišice med lopaticami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna benen och dra tillbaka gluteus maximus långsamt och kontrollerat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முட்டிகளை வெளிப்புறமாக திறந்து, இடுப்புத் தசைகளை உணர்ந்து மெதுவாக திரும்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోకాళ్లను వెలుపలికి చాపి, మధ్యలో ఉన్న పిరుదు కండరాలను దృష్టిలో ఉంచుకుని నెమ్మదిగా తిరిగి తీసుకురావండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเข่าออก และค่อยๆ ดึงกล้ามเนื้อสะโพกกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaklarınızı açarak, gluteus medius kasını fark ederek yavaşça geri çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити коліна назовні та повільно повернути, зосереджуючись на середній частині сідниць."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở rộng chân ra ngoài, tập trung vào cơ mông và đưa từ từ về vị trí ban đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开膝盖，注意臀中肌，然后缓慢收回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
