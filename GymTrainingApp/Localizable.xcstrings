    "workout_summary.revision_approval_notice": {
      "comment": "GymTrainingApp/Features/Workout/WorkoutSummaryView.swift:87\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: GPT-5.6 Lunaで日本語残留を補修。健康・課金・プライバシー表現は公開後も人手確認対象。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: GPT-5.6 Lunaで日本語残留を補修。健康・課金・プライバシー表現は公開後も人手確認対象。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتم تعديل الخطة الحالية حتى يتم مراجعة التغييرات"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El pla es modificarà només després d'aprovar els canvis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny nebudou aplikovány, dokud nezískáte potvrzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nuværende plan bliver ikke ændret, før du har gennemgået ændringerne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderungen werden erst nach der Bestätigung angewendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή θα εφαρμοστεί μόνο αφού επιβεβαιώσετε τις αλλαγές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The current plan will not be overwritten until the changes are confirmed."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The current plan will not be overwritten until the changes are confirmed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The current plan will not be overwritten until the changes are confirmed."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The current plan will not be overwritten until the changes are confirmed."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan actual no se modificará hasta que revises los cambios."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La modificación actual no se aplicará hasta que confirmes los cambios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyistä suunnitelmaa ei muuteta ennen kuin olet tarkistanut muutokset."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan actuel ne sera pas modifié tant que vous n’aurez pas vérifié les changements."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification actuelle ne sera pas appliquée tant que vous n'avez pas confirmé les modifications."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફેરફારોની ચકાસણી થાય ત્યાં સુધી, વર્તમાન યોજના બદલવામાં આવશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכנית הנוכחית לא תתעדכן עד שתאשר את השינויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप बदलावों की समीक्षा नहीं करते, वर्तमान योजना में कोई बदलाव नहीं किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačni plan neće biti izmijenjen dok ne pregledate promjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A változtatások elfogadásához, a jelenlegi tervet nem fogjuk megváltoztatni. "
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencana saat ini tidak akan diubah sampai Anda meninjau perubahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica del piano non sarà applicata fino a quando i contenuti non saranno confermati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更内容を確認するまで、現在の計画は書き換えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 내용을 확인할 때까지 현재 계획은 수정하지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बदल स्वीकारण्यापूर्वी, कृपया ते तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rancangan semasa tidak akan ditulis semula sehingga kandungan yang diubah telah disemak."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijzigingen worden niet toegepast totdat u ze heeft gecontroleerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nåværende planen blir ikke endret før du har gjennomgått endringene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany nie zostaną wprowadzone, dopóki nie zostanie potwierdzona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano atual não será alterado até que você revise as mudanças."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações não serão aplicadas até que as alterações sejam confirmadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul actual nu va fi modificat până când nu verifici schimbările."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
