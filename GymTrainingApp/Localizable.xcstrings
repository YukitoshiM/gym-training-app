        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izboljšujte videz, pas in mišično ravnovesje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbättra utseende, midja och muskelbalans"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடல் தோற்றம், இடுப்பளவு மற்றும் தசைச் சமநிலையை மேம்படுத்தவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీర ఆకృతి, నడుము మరియు కండరాల సమతుల్యాన్ని మెరుగుపరచండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
