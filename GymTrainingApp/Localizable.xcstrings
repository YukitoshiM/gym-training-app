    "domain_catalog.4fa5744407c2": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:148\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\nde-DE: NLLB fallback used because TranslateGemma mixed writing systems; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مع الحفاظ على ضغط البطن، ادفع البار للأعلى بشكل مستقيم أمام وجهك وفوق رأسك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint la pressió abdominal, empeny la barra cap amunt davant de la cara i per sobre del cap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte tlak na břicho a pomalu zvedejte tyč od obličeje směrem nahoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold trykket i maven, og løft stangen lige op fra dit ansigt mod toppen af hovedet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie drängen den Bauchdruck und drängen die Bar direkt vor dem Gesicht über den Kopf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε την πίεση στην κοιλιά και σηκώστε τον μύ, από το μέτωπο προς τα πάνω."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain pressure on your abdomen and lift the bar straight up from directly in front of your face towards your head."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain pressure on your abdomen and lift the bar straight up from directly in front of your face towards your head."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain pressure on your abdomen and lift the bar straight up from directly in front of your face towards your head."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain pressure on your abdomen and lift the bar straight up from directly in front of your face towards your head."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la presión abdominal y levantar la barra directamente desde frente a la cara hasta por encima de la cabeza."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la presión abdominal y levantar la barra directamente desde frente a la cara hasta por encima de la cabeza."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä vatsalihakset aktiivisina ja nosta vartaloa suoraan etu- ja yläpäähän."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir une pression abdominale et pousser le bar avant vers le haut, en gardant le dos droit."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir une pression abdominale et pousser le bar avant vers le haut, en gardant le dos droit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પેટ પરનું દબાણ જાળવી રાખો, અને બારને તમારા ચહેરાથી ઉપર તરફ સીધી રીતે ઉપર ધસાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירה על לחץ בבטן, הרמת הבר מעוד העור אל קו החזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पेट की मांसपेशियों को मजबूत रखें और बार को अपने चेहरे से ऊपर की ओर सीधा उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite pritisak na trup i podižite obje ruke izravno prema glavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a nyomást, és emelje fel az arc előtt a torok irányába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga tekanan di perut, lalu mendorong bar secara langsung dari depan wajah ke atas kepala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere la pressione sull'addome e sollevare l'asta dritto, dal viso verso l'alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腹圧を保ち、バーを顔の前から頭上へまっすぐ押し上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복부 압력을 유지하며, 손을 얼굴에서 머리 위로 곧게 뻗는다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोट स्थिर ठेवा आणि बारला आपल्या चेहऱ्यापासून डोक्याच्या दिशेने सरळ वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempertahankan tekanan di perut, dan mengangkat bar secara terus ke atas dari hadapan wajah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Duw het staafje recht omhoog van voor je gezicht naar boven, terwijl je de druk op je buik behoudt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold trykket, og press stangen rett opp fra ansiktet mot hodet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj prawidłowe ciśnienie w brzuchu i delikatnie podnoś palce do góry, od strony twarzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a pressão abdominal e empurre o peso em direção ao rosto, subindo reto do chão até acima da cabeça."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a pressão abdominal e empurre o peso em direção ao rosto, subindo reto do chão até acima da cabeça."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține tensiunea abdominală și ridică bara de la față, spre partea superioară a corpului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держать давление в животе и плавно поднимать штангу от лица к голове."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte tlak v brušnej oblasti a zdvihnite tyč pred sebou, priamo smerom nahor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite pritisk v trebuhu in dvignite robar naprej od obraza do glave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck upp stången rakt framför ansiktet, mot huvudet, samtidigt som du behåller en stabil mage."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வயிற்று அழுத்தத்தை பராமரித்து, பார்வையை முகத்திலிருந்து தலையின் மேல் நோக்கி நேராக உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కడుపు ఒత్తిడిని కాపాడుతూ, బార్‌ను ముఖం నుండి తల పైకి నేరుగా పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาแรงดัน และค่อยๆ ดันคานขึ้นจากด้านหน้าไปด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karın basıncını koruyarak, ağırlığı yüzünüzden başınıza doğru düz bir şekilde kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримати тиск у животі та плавно піднімати штангу від обличчя до голови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nguyên áp lực, đẩy thanh từ trước mặt lên thẳng về phía trên đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持腹部压力，将哑铃从脸前向上直接抬起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
