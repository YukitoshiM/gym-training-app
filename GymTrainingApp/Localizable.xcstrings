        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian sedang dalam proses verifikasi. Akan otomatis tercermin setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto è in attesa di approvazione. Sarà automaticamente visualizzato al completamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。完了後に自動で反映します。"
