    "domain_catalog.e4fa57b19772": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:416\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دون تقويس أسفل ظهرك، قم بتدوير الجزء العلوي من جسمك بحيث تقترب الضفيرة الشمسية من حوضك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense arquejar la part baixa de l'esquena, rodeja la part superior del cos perquè el plexe solar s'acosti a la pelvis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nespínejte záda, ale ohněte trup směrem k břichu a vytvořte kulový pohyb těla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj ikke ryggen, men rund kroppen op, så mellembækkenen nærmer sig hoftebøjlen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wirbelsäule nicht überdehnen, sondern den Oberkörper sanft zur Seite biegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην λυγίζετε την πλάτη σας, αλλά κάντε μια ελαφριά κλίση προς τα πάνω για να φέρτε τον κοιλιακό μυ."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Without arching your back, gently round your upper body towards your abdomen, bringing your spine closer to your pelvis."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Without arching your back, gently round your upper body towards your abdomen, bringing your spine closer to your pelvis."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Without arching your back, gently round your upper body towards your abdomen, bringing your spine closer to your pelvis."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Without arching your back, gently round your upper body towards your abdomen, bringing your spine closer to your pelvis."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Redondear el tronco acercando el abdomen a la pelvis, sin arquear la espalda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Redondear el tronco acercando el abdomen a la pelvis, sin arquear la espalda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä selkä suorana ja pyöritä ylävartaloa siten, että vatsa on lähellä lanttaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plier le haut du corps en gardant le dos droit et en rapprochant la poitrine de la sangle abdominale."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Plier le haut du corps en gardant le dos droit et en rapprochant la poitrine de la sangle abdominale."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પેટને સીધા રાખીને, છાતીને હિપ્સ તરફ વાળો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמור על גב ישר, ומתח את הבטן לכיוון האגן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पीठ को सीधा रखें और पेट को श्रोणि की ओर ले जाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izravnajte leđa i okrenite trup prema zdjelici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gerinccal ne hajlítsa lefelé, hanem tartsa az egyenes testtartást, miközben a hasát a medence felé húzza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutar tubuh ke atas sambil menjaga punggung tetap lurus, dan mendekatkan perut ke arah panggul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrotondare il busto avvicinando l'addome alla pelvi, senza afflettere la schiena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰を反らさず、みぞおちを骨盤へ近づけるように上体を丸める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리를 굽히지 않고, 배를 골반 쪽으로 당겨 올린다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोट ताणून घेऊ नका, छातीला हाडांच्या दिशेने वळवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membungkus tubuh ke atas tanpa menekuk punggung, dan mengarahkan perut ke arah tulang pinggul."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rol je bovenlichaam omhoog, zodat je ribcage naar de heupen wijst, en houd je rug recht."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy ikke ryggen, men vri overkroppen slik at magen presses mot korsryggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj wyginania pleców i staraj się, aby tułów był lekko zaokrąglony, przytulając brzuch do kości ogonowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a coluna reta e arqueie o tronco em direção ao umbigo, aproximando-o da pelve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a coluna reta e arqueie o tronco em direção ao umbigo, aproximando-o da pelve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți spatele drept și curbați-vă ușor de sus, astfel încât să vă apropie abdomenul de pelvis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не напрягать поясницу, а наоборот, округлять верхнюю часть тела так, чтобы область живота приближалась к тазу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte si správne držanie tela a ohýbate sa do strán, pričom držíte trup pevne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne prekomplicirajte z hrbtom, ampak se rahlo upnite in usmerite trupa proti kraličnim kostem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulla kroppen framåt, utan att böja ryggen, och behåll en stabil kärna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதுகை வளைக்காமல், வயிற்றை இடுப்பு நோக்கி நகர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నుపూసను వంచకుండా, పొత్తికడుపును ప్యాడ్ వైపుకు తీసుకువచ్చేలా శరీరాన్ని వంపు ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้งตัวโดยไม่ทำให้เอวแอ่น และหมุนลำตัวขึ้นเพื่อให้สะโพกเข้าใกล้กระดูกสันหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli bükmeyin, karın kaslarınızı sıkılı tutarak üst vücudunuzu hafifçe eğin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не згинати спину, а обертати верхню частину тіла так, щоб живіт був ближче до тазу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thẳng lưng và cuộn người lên sao cho xương chậu hướng về phía bụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持腰部挺直，将腹部向骨盆方向倾斜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持腰部不動，並將上半身向前方傾斜，使腹部靠近骨盆。"
          }
        }
      }
    },
