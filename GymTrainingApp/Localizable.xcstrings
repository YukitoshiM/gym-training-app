    },
    "domain_catalog.6c43886de639": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:272\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتدريب ساعديك عن طريق إبقاء ساعديك ثابتين وثني معصميك فقط واستقامةهما."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena els avantbraços mantenint els avantbraços estacionaris i doblegant i estirant només els canells."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte předloktí a ohýbejte/rozepřete zápěstí, abyste posílili předloktí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør underarmen og bevæg kun håndleddet for at træne underarmen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixieren Sie den Unterarm und beugen und strecken Sie nur den Handgelenk, um den Unterarm zu trainieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθεροποιήστε το πρόσω και χρησιμοποιήστε μόνο τον καρπό για να το τεντώσετε και να το συρρίξετε, προκειμένου να γυμνάσετε το πρόσω."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your forearm and bend and straighten only your wrist to train your forearm."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your forearm and bend and straighten only your wrist to train your forearm."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your forearm and bend and straighten only your wrist to train your forearm."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your forearm and bend and straighten only your wrist to train your forearm."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el antebrazo y flexiona y extiende solo la muñeca para fortalecer el antebrazo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el antebrazo y flexiona y extiende solo la muñeca para fortalecer el antebrazo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä ranne ja liikuta vain rannetta, jotta voit treenata sitä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez votre avant-bras et pliez/dépliez uniquement le poignet pour renforcer l'avant-bras."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez votre avant-bras et pliez/dépliez uniquement le poignet pour renforcer l'avant-bras."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્વ કાંડાને સ્થિર કરો અને ફક્ત હાથની ઘૂંટીને વાળો અને સીધો કરો જેથી પૂર્વ કાંડા મજબૂત બને."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להחזיק את המרפק ולעבוד על חיזוקו על ידי כיפוף ויישור של כף היד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पूर्व बांह को स्थिर करें और केवल अपनी कलाई को मोड़कर पूर्व बांह को मजबूत करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiksirajte predrvi i savijte/isprobavajte prst, kako biste trenirali predrvi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elülső kart rögzítve, a könyést fordítsuk és nyújtsuk, hogy az elülső kart eddünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih pergelangan tangan depan dengan memegangnya dan meluruskan serta menekuk pergelangan tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissare la parte anteriore del braccio e piegare e allungare solo il polso per allenare la parte anteriore del braccio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前腕を固定し、手首だけを曲げ伸ばしして前腕を鍛える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전완을 고정하고 손목만 움직여 전완을 단련합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्व बाहूला स्थिर ठेवून, फक्त मनगटाला वाकवा आणि सरळ करा, ज्यामुळे पूर्व बाहु मजबूत होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenali lengan depan dan lenturkan pergelangan tangan untuk melatih lengan depan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixeer je bovenarm en buig en strek alleen je pols om je bovenarm te trainen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fest underarmen og beveg håndleddet for å trene underarmen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj przedramię i zginaj/prostuj tylko nadgarstek, aby wzmocnić przedramię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe o antebraço e mova apenas a mão, exercitando o antebraço."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe o antebraço e mova apenas a mão, exercitando o antebraço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixați antebrațul și mișcați doar încheietura mâinii pentru a-l antrena."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафиксируйте предплечье и двигайте только запястье, чтобы тренировать предплечье."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte predloktie a ohývajte len zápästie, aby ste posilovali predloktie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavežite predmežino in fleksirajte samo zapesto, da trenirate predmežino."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst underarmen och böj/sträck bara handleden för att träna underarmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன் கையை நிலையாக வைத்து, மணிக்கட்டை மட்டும் வளைத்து நீட்டி முன் கையை வலுப்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందు చేతులను స్థిరీకరించండి మరియు చేతిని మాత్రమే వంచడం ద్వారా ముందు చేతులను బలోపేతం చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยึดแขนด้านหน้า แล้วงอและเหยียดแขนด้านหน้าเพื่อฝึกกล้ามเนื้อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön kolu sabitleyerek sadece bileği büküp düzeltin ve ön kolunuzu güçlendirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафіксуйте передпліччя та рухайте лише зап'ястями, щоб тренувати передпліччя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ cố định cẳng tay trước và uốn, duỗi cổ tay để luyện ngón tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定前臂，然后弯曲和伸展手腕以锻炼前臂。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定前臂，然后弯曲和伸展手腕来锻炼前臂。"
          }
        }
      }
    },
