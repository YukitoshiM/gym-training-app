    "health_meals_body_ai.cf65f2670394": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:240\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي النتيجة المرجعية المحسوبة داخل الجهاز بناءً على الوقت، والنوم العميق، وحركة العين السريعة، ومنتصف الاستيقاظ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta és una puntuació de referència calculada dins del dispositiu en funció del temps, el son profund, la REM i la vigília mitjana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto jsou odhadované skóre vypočítané aplikací na základě času, hlubokého spánku, REM fáze a probuzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er et estimeret score baseret på tid, dyb søvn, REM-søvn og vågenhed, beregnet i appen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind Schätzwerte, die von Ihrem Gerät berechnet wurden, basierend auf Uhrzeit, tiefer Schlaf, REM-Schlaf und Teilaufwachern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τιμές που υπολογίζονται από την εφαρμογή είναι μια εκτίμηση με βάση την ώρα, τον βαθύ ύπνο, το REM και τις διακοπές του ύπνου."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score calculated by the app, based on time, deep sleep, REM, and partial awakenings."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score calculated by the app, based on time, deep sleep, REM, and partial awakenings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score calculated by the app, based on time, deep sleep, REM, and partial awakenings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score calculated by the app, based on time, deep sleep, REM, and partial awakenings."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una puntuación de referencia calculada por el dispositivo a partir de la hora, la duración del sueño profundo, el sueño REM y las interrupciones."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una puntuación de referencia calculada por el dispositivo a partir de la hora, la duración del sueño profundo, el sueño REM y las interrupciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on laitekohtaisesti laskettu arvo, joka perustuu aikaan, syvään uneen, REM-unoon ja keskenuntaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le score de référence calculé par l'application est basé sur l'heure, le sommeil profond, le rêve et les réveils partiels."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le score de référence calculé par l'application est basé sur l'heure, le sommeil profond, le rêve et les réveils partiels."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમય, ઊંડી ઊંઘ, REM, અને મધ્યરાત્રે જાગવાનો સમય - આ મૂલ્યો તમારા ઉપકરણ પર ગણવામાં આવ્યા છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערך הוא תוצאה שמחושבת על ידי האפליקציה, בהתבסס על שעות שינה, עומק השינה, שינה מהירה (REM) וזמן ההתעוררות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समय, गहरी नींद, REM और मध्यरात्रि जागरण से गणना किए गए स्कोर हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je izračunati rezultat na uređaju, temeljen na vremenu, dubokom snu, REM fazi i probudima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az idő, mély alvás, REM-fázis és felébredés alapján számított értéket használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skor referensi yang dihitung oleh aplikasi, berdasarkan waktu, tidur nyenyak, REM, dan bangun di tengah malam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un punteggio di riferimento calcolato dall'app, basato sull'ora, sulle ore di sonno profondo, sul REM e sui risvegli parziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間、深い睡眠、REM、中途覚醒から端末内で算出した参考スコアです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간, 깊은 수면, REM, 부분적 각성 상태에서 계산된 참고 점수입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेळ, खोल झोप, REM, आणि मध्यरात्री जागल्यामुळे, तुमच्या डिव्हाइसवर मोजलेल्या अंदाजित स्कोअरमध्ये हे समाविष्ट आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skor anggaran yang dihitung dalam peranti ialah berdasarkan waktu, tidur mendalam, REM, dan bangun separuh."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn schattingen die berekend worden op uw apparaat, gebaseerd op tijd, diepe slaap, REM-slaap en onregelmatige waaktoestanden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en referansepoeng beregnet av appen basert på tid, dyp søvn, REM-søvn og våkenhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To są przybliżone wyniki obliczone przez aplikację na podstawie czasu snu, głębokiego snu, REM i okresów pobudzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma pontuação de referência calculada pelo aplicativo, considerando tempo, sono profundo, REM e acordes parciais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma pontuação de referência calculada pelo aplicativo, considerando tempo, sono profundo, REM e acordes parciais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este un scor estimativ calculat de aplicație, bazat pe ora, durata somnului profund, REM și trezirea parțială."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это оценка, рассчитанная приложением на основе времени сна, глубокого сна, REM-фазы и пробуждения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je odhadovaný skóre vypočítaný aplikáciou na základe času, hlbokého spánku, REM spánku a prebudenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To so ocene, izračunate v napravi, na podlagi časa, globokega spanca, REM faze in obdobij medenjave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är ett referensvärde som beräknats i appen baserat på tid, djup sömn, REM-sömn och vaknande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரம், ஆழமான தூக்கம், REM, இடைப்பட்ட விழிப்பு ஆகியவற்றிலிருந்து கணக்கிடப்பட்ட மதிப்பீடுகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమయం, లోతైన నిద్ర, REM, మధ్యలో మేల్కొనే సమయాల నుండి, పరికరంలో లెక్కించిన సూచన స్కోర్ ఇది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คะแนนอ้างอิงที่คำนวณจากแอป: เวลา, การนอนหลับลึก, REM, และการตื่นขึ้นอย่างกะทันหัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, cihazda hesaplanan bir referans puanıdır ve uyku süresini (derin uyku, REM uykusu, orta uyanıklık) saat cinsinden gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це оцінка, розрахована на вашому пристрої, на основі часу, глибини сну, фази REM та часу пробудження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm tham khảo được tính toán từ hệ thống là thời gian, giấc ngủ sâu, REM và tỉnh giấc giữa chừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是从设备中计算出的参考分数，包括时间、深度睡眠、REM睡眠和中期清醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这是从设备内计算出的参考分数，包括时间、深度睡眠、REM睡眠和中途醒来。"
          }
        }
      }
    },
    "health_meals_body_ai.d0c704c61c9b": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:911\nPlaceholders: {{value1}}\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حاليًا، الخادم مزدحم، وليس حد الاستخدام. {{value1}}يرجى المحاولة مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualment, el servidor està congestionat, no el límit d'ús. {{value1}}Si us plau, torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V současné době se jedná o nedostatek serveru, nikoli o limit využití. {{value1}} Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er i øjeblikket ikke tilgængeligt, da serveren er overbelastet. Prøv igen med {{value1}}."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit liegt es an der Serverauslastung, nicht an der Anzahl Ihrer Nutzungsmöglichkeiten. {{value1}} Bitte erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι απλώς διαθέσιμος ο αριθμός των χρηστών, όχι η δυνατότητα χρήσης. Παρακαλούμε προσπαθήστε ξανά μετά από {{value1}}."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently, it's not due to a server issue, but rather because of high usage. {{value1}} Please try again."
          }
        },
        "en-CA": {
          "stringUnit": {
