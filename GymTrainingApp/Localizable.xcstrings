    "domain_catalog.e1f8d5497739": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:187\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الحبل إلى مستوى الوجه، مع التركيز على الجزء الخلفي من كتفيك وحول لوحي كتفك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estireu la corda fins al nivell de cara, centrant-vos a la part posterior de les espatlles i al voltant dels omòplats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přivážete lano k úrovni obličeje a soustřeďte se na zad a ramena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk rebet op til samme højde som dit ansigt og fokuser på skulderbladene og bagsiden af skuldrene."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Seil bis zur Augenhöhe ziehen und auf die Schulter- und Schulterblattmuskulatur achten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε το λάστιχο στο ύψος του προσώπου, εστιάζοντας στους ώμους και τους αγκώνες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the rope up to face height, focusing on the back and shoulder blades."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the rope up to face height, focusing on the back and shoulder blades."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the rope up to face height, focusing on the back and shoulder blades."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the rope up to face height, focusing on the back and shoulder blades."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira la cuerda hasta la altura de la cara, enfocándote en los hombros y las escápulas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira la cuerda hasta la altura de la cara, enfocándote en los hombros y las escápulas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä köysi niin, että se on kasvojen korkeudella ja keskity olkapäihin ja lapaluohosiin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer la corde vers le niveau du visage, en se concentrant sur les muscles des épaules et de l'omoplate."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer la corde vers le niveau du visage, en se concentrant sur les muscles des épaules et de l'omoplate."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોયડાની ઊંચાઈ સુધી દોરને, ખભાના પાછળના ભાગ અને ખભાના હાડકાની આસપાસ ધ્યાન કેન્દ્રિત કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משכו את החבל לגובה הפנים, תוך שימת לב לחלק האחורי של הכתף ולעצמות השכמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रस्सी को चेहरे की ऊंचाई तक खींचें और कंधे के पीछे और स्कैपुलर क्षेत्र पर ध्यान दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Viješ užetak do visine lica i fokusiraj se na stražnju dijelove ramena i okolicu lopatica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kört a szemmagasságig húzd, és figyelj a hát és a vállizmaira."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik tali ke ketinggian wajah, perhatikan bagian belakang bahu dan tulang selangka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirare la corda fino all'altezza del viso, concentrandosi sulla parte posteriore delle spalle e sulle scapole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロープを顔の高さへ引き、肩後部と肩甲骨周りを意識する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로프를 얼굴 높이까지 당겨 어깨 뒤쪽과 어깨뼈 주변을 의식한다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लांब बांधून चेहऱ्याच्या उंचीपर्यंत ओढा, खांद्याच्या मागचा भाग आणि स्कॅपुला (Shoulder blade) क्षेत्रावर लक्ष केंद्रित करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik tali ke ketinggian wajah, perhatikan bahagian belakang bah dan tulang belikat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek de touw naar de hoogte van je gezicht en focus op je schouders en schouderbladen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk tauen opp til samme høyde som ansiktet, og fokuser på skulderbladene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciągnij link w kierunku wysokości twarzy, zwracając uwagę na tylną część ramion i kości ramienne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a corda até a altura do rosto, prestando atenção nas laterais do ombro e na região das escápulas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a corda até a altura do rosto, prestando atenção nas laterais do ombro e na região das escápulas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți coarda la nivelul feței și concentrați-vă pe partea din spate a umerilor și pe zona scapulelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите веревку на уровне лица и сосредоточьтесь на задней части плеч и области лопаток."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Natiahni lano k výške tváre a zameraj sa na zadnú časť ramien a oblasti okolo lopatky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod drew, poskrbite za aktivacijo ramen in ramenskega obroča."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra repet mot ansiktet och fokusera på axlarna och skulderbladen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கயிற்றை முகத்தின் உயரத்திற்கு இழுத்து, தோள்பட்டை மற்றும் தோள்பட்டை எலும்பு பகுதியை கவனத்தில் கொள்ளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాల్‌ను ముఖానికి ఎత్తుకు లాగండి, భుజం వెనుక మరియు భుజం ఎముకల చుట్టూ దృష్టి పెట్టండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงเชือกให้สูงระดับใบหน้า และให้สบกับด้านหลังและสะโพก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kordonu yüz yüksekliğine çekin ve omuz arkası ve omurgayı sıkı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтягуйте мотузку до рівня обличчя, зосереджуючись на задній частині плечей та області лопаток."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo dây lên ngang với mặt, tập trung vào phần sau vai và xương bả vai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将绳子拉至与面部的齐高，并注意肩膀后部和肩胛骨周围的肌肉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將繩子拉至與臉的高度，並注意肩膀和肩胛骨周圍的肌肉。"
          }
        }
      }
    },
