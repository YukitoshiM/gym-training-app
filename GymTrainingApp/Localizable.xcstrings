        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyemak sekeliling pinggang dengan membandingkan bahagian depan dan belakang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb je taille gemeten vanuit verschillende hoeken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har målt rundt midjen ved å kombinere for- og baksiden."
