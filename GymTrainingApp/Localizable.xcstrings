          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szett célja, hogy a gyakorlat elkezdésekor másolva, az előzményekben is megjelenjen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Target Set disalin saat memulai latihan dan disimpan dalam riwayat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'obiettivo della serie viene copiato all'inizio dell'allenamento e salvato nella cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セット目標はワークアウト開始時にコピーされ、履歴に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트 목표는 운동 시작 시 복사되며, 기록에 남습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटचे लक्ष्य वर्कआउट सुरू करताना कॉपी केले जाईल आणि इतिहासात नोंदवले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matlamat Set disalin pada mulanya dan disimpan dalam sejarah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De doelstelling van de set wordt gekopieerd aan het begin van de workout en bewaard in de geschiedenis."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Målet for settet kopieres ved start av økten og lagres i historikken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel serii jest kopiowany na początku treningu i zapisywany w historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O objetivo do conjunto é copiado no início do treino e guardado no histórico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O objetivo do conjunto é copiado no início do treino e guardado no histórico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obiectivele pentru fiecare set sunt copiate la începutul antrenamentului și sunt salvate în istoric."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель серии копируется при начале тренировки и сохраняется в истории."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciele sady sa kopírujú na začiatok tréningu a uložia sa do histórie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cilj nastavitve se kopira ob začetku treninga in se shranjuje v zgodovino."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Målet för set kopieras vid start av träningen och sparas i historiken."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செட் இலக்கு, உடற்பயிற்சி தொடங்கும் போது நகலெடுக்கப்பட்டு, வரலாற்றில் சேமிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యాయామ ప్రారంభించినప్పుడు సెట్ లక్ష్యం కాపీ అవుతుంది మరియు హిస్టరీలో నిల్వ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายเซ็ตจะถูกคัดลอกเมื่อเริ่มออกกำลังกาย และบันทึกไว้ในประวัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Set hedefleri, antrenman başlangıcında kopyalanır ve geçmişe kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціль для сету копіюється на початку тренування та зберігається в історії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục tiêu của bộ bài được sao chép khi bắt đầu tập và lưu vào lịch sử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组目标在开始锻炼时复制，并保存到历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "組目標會在運動開始時複製，並記錄在歷史中。"
          }
        }
      }
    },
