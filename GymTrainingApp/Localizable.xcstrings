        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A energia consumida não foi registrada. Apenas os registros de refeições estão salvos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Consumul de energie din secțiunea \"Health\" nu a fost înregistrat. În schimb, înregistrările alimentare sunt stocate."
