        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o ginásio que frequenta ou os equipamentos disponíveis em casa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Selectați sala de sport sau echipamentul din casă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите тренировку в вашем фитнес-клубе или дома."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si, ktoré cvičenie alebo aktivity vykonávate v posilňovni alebo doma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite, katero telovadnico ali doma izberete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj gym eller utrustning du har hemma"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்களுடைய உடற்பயிற்சி செய்யும் ஜிம் அல்லது வீட்டில் உள்ள உபகரணங்களைத் தேர்ந்தெடுக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వ్యాయామం చేస్తున్న జిమ్ లేదా ఇంట్లో ఉన్న వాటిని ఎంచుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกจากยิมที่คุณไป หรืออุปกรณ์ที่บ้าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullandığınız spor salonunu veya evde bulunanları seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть тренажер у спортзалі або те, що є вдома."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn phòng tập hoặc dụng cụ có sẵn tại nhà"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择您所在的健身房或家中设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选择您正在使用的健身房或家中已有的设备"
          }
        }
      }
    },
