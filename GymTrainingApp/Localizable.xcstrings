    "domain_catalog.d98fc69956aa": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:229\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ مرفقك في وضع ثابت واثنِ ساعدك دون استخدام أي ارتداد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu el colze en una posició fixa i doblegueu l'avantbraç sense fer servir cap retrocés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte si pozici loktů a ohněte předloktí bez využití odrazové síly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør albuerne og bøj forarmen uden at bruge kraft, så den peger fremad."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixiere deine Ellbogen und beuge deine Unterarme ohne Gegenschwung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθεροποιήστε τις αγκώνες σας και λυγίστε τον εξωτερικό βραχίονα χωρίς να χρησιμοποιείτε αντίδραση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your elbows and bend your forearm without using momentum."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your elbows and bend your forearm without using momentum."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your elbows and bend your forearm without using momentum."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your elbows and bend your forearm without using momentum."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la posición de los codos y flexionar el antebrazo sin utilizar la fuerza del impulso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la posición de los codos y flexionar el antebrazo sin utilizar la fuerza del impulso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kyynärpäät paikallaan ja taivuta rannetta ilman iskuja."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez vos coudes et pliez votre avant-bras sans utiliser d'impulsion."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez vos coudes et pliez votre avant-bras sans utiliser d'impulsion."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથની સ્થિતિને નિશ્ચિત કરો અને કોઈ પ્રતિક્રિયા વગર, હાથની અંદરનો ભાગ વાળો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשמור על מיקום הכתף, ולהתכופף את הזרוע ללא שימוש בהנפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी की स्थिति को स्थिर रखें और बिना किसी प्रतिक्रिया के अपने पहले हाथ को मोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiksirajte ruke i savijte preddjel ruku bez korištenja potiska."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixálja a karokat, és hajtja meg az ulnakot, anélkül, hogy használná a nyomatást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memastikan posisi siku, lalu menekuk lengan bawah tanpa menggunakan tenaga dorong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la posizione dei gomiti e piega l'avambraccio senza utilizzare lo smorzamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘の位置を固定し、反動を使わずに前腕を曲げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔꿈치의 위치를 고정하고, 반동을 사용하지 않고 팔꿈치를 구부립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हाताची स्थिती स्थिर ठेवा आणि स्फोट न वापरता, मनगटाला वाकवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan kedudukan siku, tanpa menggunakan tenaga pantulan, tekuk lengan bawah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je ellebogen op hun plaats en buig je onderarm zonder gebruik te maken van een krachtbeweging om de dumbbell omhoog te brengen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold albuene på plass og bøy forarmen uten å bruke motstand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj pozycję łokcia i zgiń przedramię bez używania siły odruchowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos na posição ideal e dobre o antebraço sem usar o impulso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos na posição ideal e dobre o antebraço sem usar o impulso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixează antebrațul și îndoaie brațul fără a folosi impulsul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепите положение локтей и согните предплечье без использования рывков."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte pozíciu lakťov a ohnute pre krúžok bez použitia odpory."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na položaj rok in brez uporabe odbijanja upakirate ramo nazaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst armbågen och böj underarmen utan att använda kraft, för att lyfta hanteln."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை மடக்கி, முன்னோக்கிய கையை வளைத்து, டம்பலை உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతుల స్థానాన్ని స్థిరంగా ఉంచి, రియాక్షన్‌ను ఉపయోగించకుండా ముందు చేతిని వంచడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาระดับข้อศอก และงอแขนโดยไม่ใช้แรงกระแทก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirseklerinizi sabitleyerek, ön kolunuzu bükün ve itme gücünden kaçının."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафіксуйте положення рук і згинайте передпліччя без використання відривних рухів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khuỷu tay cố định, không sử dụng phản lực, gập trước cánh tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定肘部位置，不用反作用力弯曲前臂"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定肘部位置，不使用反作用力，彎曲前臂"
          }
        }
      }
    },
