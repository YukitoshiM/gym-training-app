    "health_meals_body_ai.b4469d69cea6": {
      "comment": "GymTrainingApp/Features/BodyMetrics/BodyMetricListView.swift:26\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك التحقق من الفرق بين الهدف ومعدل الإنجاز لكل مؤشر أداء رئيسي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu comprovar la diferència amb l'objectiu i la taxa d'assoliment de cada KPI."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete sledovat rozdíl a procento dosažení cíle pro každý KPI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se forskellen og fremskridt i forhold til dit mål for hver KPI."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die Differenz und den Fortschritt zu Ihrem Ziel für jeden KPI überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να δείτε τις διαφορές και το ποσοστό επίτευξης του στόχου σας ανά KPI."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can check the difference and completion rate for each KPI."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can check the difference and completion rate for each KPI."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can check the difference and completion rate for each KPI."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can check the difference and completion rate for each KPI."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes verificar las diferencias y el porcentaje de cumplimiento para cada KPI."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes verificar las diferencias y el porcentaje de cumplimiento para cada KPI."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit tarkistaa tavoitteen ja saavutetun prosenttiosuuden KPI:n mukaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez consulter votre objectif et votre taux d'atteinte par KPI."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez consulter votre objectif et votre taux d'atteinte par KPI."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે KPI પ્રમાણે ધ્યેય અને પૂર્ણતા દરની ચકાસી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לראות את ההבדל והאחוז שהושג עבור כל מדד KPI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप KPI के अनुसार लक्ष्य और वर्तमान उपलब्धि दर की जांच कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete provjeriti razliku i postignuće cilja za svaki KPI."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A célokhoz képest elért eredmények és a teljesítési arányt KPI-k szerint megtekintheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat melihat perbedaan dan tingkat pencapaian untuk setiap KPI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi visualizzare le differenze e il tasso di raggiungimento degli obiettivi per ogni KPI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標との差分と達成率をKPIごとに確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표와 달성률을 KPI별로 확인할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे लक्ष्य आणि त्याची प्रगती KPI नुसार पाहू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh melihat perbezaan dan kadar pencapaian untuk setiap KPI."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt de verschillen en het percentage van uw voortgang per KPI bekijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se forskjellen og fremgangen mot målet for hver KPI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz sprawdzić różnicę i wskaźnik realizacji celu dla każdego KPI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode verificar a diferença e a taxa de conclusão em relação aos seus objetivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode verificar a diferença e a taxa de conclusão em relação aos seus objetivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți verifica diferența și procentul de realizare al obiectivelor pentru fiecare indicator KPI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете отслеживать прогресс и процент достижения цели для каждого KPI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete sledovať rozdiel a percentuálnu úspešnosť pre každý KPI."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko preverite razliko in stopnjo doseganja ciljev po KPI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kontrollera skillnaden och framgångsgraden för dina mål per KPI."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் குறிக்கோளுடன் ஒப்பிடும்போது, KPI அடிப்படையில் முன்னேற்றத்தைக் காணலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లక్ష్యంతో పోలిస్తే, KPIల ప్రకారం సాధించిన స్థాయిని చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถตรวจสอบ KPI แต่ละรายการ เช่น ความแตกต่างและอัตราความสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefe göre farklılıkları ve başarı oranlarını KPI'lar halinde görüntüleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна перевірити відмінність та рівень досягнення цілі для кожного KPI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem sự khác biệt và tỷ lệ hoàn thành mục tiêu theo các chỉ số KPI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以按KPI查看目标与当前目标的差异和达成率。"
          }
        },
