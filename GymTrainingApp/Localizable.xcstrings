    "domain_catalog.64bc6a080ea2": {
      "comment": "GymTrainingApp/Domain/FoodCompositionModels.swift:486\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "طهي الأطباق وتبخيرها وغليها بدلاً من قليها"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuinar, cuinar al vapor i bullir plats en lloc de fregir-los"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upřednostňujte vaření, pečení, vaření nebo dušení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Præsér helst stegt, dampet eller kogt mad frem for frit."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugen Sie gebratenes, gedünstetes oder gekochtes Essen gegenüber frittiertem Essen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτιμήστε μαγειρέματα όπως το ψήσιμο, το βράσιμο ή το βρασμένο φαγητό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer cooking methods such as baking, steaming, or boiling over frying."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer cooking methods such as baking, steaming, or boiling over frying."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer cooking methods such as baking, steaming, or boiling over frying."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer cooking methods such as baking, steaming, or boiling over frying."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiere cocinar al freír: hornear, hervir o cocinar al vapor."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiere cocinar al freír: hornear, hervir o cocinar al vapor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmista ruokia paistamalla, höyryttämällä tai keittämällä, älä vain paistamalla"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégiez les plats cuits à la vapeur, grillés ou bouillis plutôt que les fritures."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégiez les plats cuits à la vapeur, grillés ou bouillis plutôt que les fritures."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફ્રાઈ કરવા કરતાં, શેકવા, વરાળથી રાંધવા અથવા ઉકાળવાની વાનગીઓ વધુ સારી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בישול, ולא צריכה (אפייה, בישול, בישול)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तले हुए भोजन के बजाय, भूनें, भाप दें या उबालें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferirajte pečenje, kuhanje, pariranje i kuhanje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobb, ha sütjük, párolgassuk vagy főzzük az ételeket, mintsem süssük őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih memasak (memanggang, merebus, mengukus) daripada menggoreng"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferire cotture, cottura al vapore o bollitura rispetto alla frittura"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "揚げ物より、焼く・蒸す・茹でる料理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "튀김보다 굽거나 찌거나 삶는 요리"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "भाज्यांपेक्षा, तळलेले, वाफवलेले किंवा उकडलेले पदार्थ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masakan seperti menggoreng lebih baik daripada memasak, mengukus, atau merebus"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies voor bakken, braden, stomen of koken in plaats van frituren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg steking, damping eller koking fremfor fritering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz pieczenie, gotowanie, parzenie lub gotowanie zamiast smażenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefira preparações assadas, cozidas ou fervidas em vez de frituras"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefira preparações assadas, cozidas ou fervidas em vez de frituras"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În loc de prăjit, preferă metodele de gătit prin fierbere, abur sau gătire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочтительны блюда, приготовленные путем жарки, запекания, варки или тушения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Predpreferujte pečené, dusené alebo uvarené jedlá."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvsem peči, kuhanje, varjenje in kuhanje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föredra tillagningstekniker som stekning, ångning och kokning istället för fritering."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொரிப்பதற்கு பதிலாக, சமைக்க, வேகவைக்க அல்லது கொதிக்க வைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేయించడం కంటే, కాల్చడం, ఆవిరి చేయడం లేదా ఉడకబెట్టడం వంటి వంటకాలు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาหารประเภทผัดมากกว่าอาหารประเภททอด, อบ, นึ่ง หรือต้ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fırında pişirme, buharla pişirme veya kaynatma gibi yöntemler tercih edin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Віддавайте перевагу приготуванням, а не смаженню: запікання, варка, тушкування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay vì chiên, hãy thử các món nướng, hầm, luộc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比油炸更推荐：烤、蒸、煮等烹饪方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比起油炸，更推薦烤、蒸、煮等料理"
          }
        }
      }
    },
