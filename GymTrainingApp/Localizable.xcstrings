    "health_meals_body_ai.859914a154e7": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:718\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى الانتظار لمدة دقيقة وحاول مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Espereu un minut i torneu-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po chvíli počkejte a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent et par minutter og prøv igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie einige Minuten und versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακαλούμε περιμένετε για λίγο και δοκιμάστε ξανά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait for about 1 minute and try again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait for about 1 minute and try again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait for about 1 minute and try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait for about 1 minute and try again."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, espere unos minutos y vuelva a intentarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, espere unos minutos y vuelva a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odota noin minuutti ja kokeile uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez patienter quelques minutes puis réessayer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez patienter quelques minutes puis réessayer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૃપા કરીને થોડીવાર રાહ જુઓ અને ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא המתן כדקה ואז נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ देर (लगभग 1 मिनट) प्रतीक्षा करें और फिर पुनः प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Molimo, pokušajte ponovno nakon nekoliko minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, várjon néhány percet, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan mencoba lagi setelah menunggu beberapa saat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi circa 1 minuto e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1分ほど待ってから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 1분 정도 기다린 후 다시 시도해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया काही वेळ थांबा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
