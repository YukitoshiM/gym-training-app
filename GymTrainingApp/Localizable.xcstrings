    "health_meals_body_ai.0bf9b10cad35": {
      "comment": "GymTrainingApp/Data/DailyRecommendationPreferences.swift:51\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من الإكمال/تخطي الاتجاهات على الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprovació de les tendències de finalització/omissió al dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkoumáme, jaké jsou vaše tendence k dokončení a přeskočení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi undersøger tendensen for fuldførte/overskridte opgaver på enheden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir untersuchen die Tendenz zur Fertigstellung und zum Überspringen innerhalb des Geräts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγχουμε τις τάσεις ολοκλήρωσης και παράλειψης εντός της συσκευής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We are currently checking the completion/skip tendencies on the device."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We are currently checking the completion/skip tendencies on the device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We are currently checking the completion/skip tendencies on the device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We are currently checking the completion/skip tendencies on the device."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos revisando tus tendencias de \"completar/saltar\" dentro de la aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos revisando tus tendencias de \"completar/saltar\" dentro de la aplicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutkitaan, miten valitut toiminnot ja ohitus toiminnot ovat."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous analysons actuellement les tendances de complétion et de saut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous analysons actuellement les tendances de complétion et de saut."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્ણ અને છોડવાની વૃત્તિને ઉપકરણમાં ચકાસી રહ્યા છીએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקה של דפוסי סיום ואי-השלמה מתבצעת בתוך המכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण और छोड़ें की प्रवृत्ति को डिवाइस पर जांच की जा रही है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjeravamo trendove dovršavanja i preskakanja unutar aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Éppen most ellenőrizzük a befejezés és a kihagyás tendenciákat az alkalmazáson belül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami sedang memverifikasi tren penyelesaian dan melewati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo verificando le tendenze di completamento e di \"salta\" all'interno dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了・スキップの傾向を端末内で確認中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 및 건너뛰기 경향을 앱 내에서 확인 중입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण आणि वगळण्याची पद्धत तपासली जात आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami sedang memeriksa trend penyelesaian dan pengabaian dalam peranti."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We onderzoeken de neiging om items af te ronden of over te slaan op je apparaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi undersøker nå trender for fullføring og hopping over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzamy, czy istnieje tendencja do ukończania lub pomijania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos analisando as tendências de conclusão e pulos no dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos analisando as tendências de conclusão e pulos no dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificăm în prezent tendințele de finalizare și salt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы анализируем тенденцию завершения и пропуска внутри приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentálne analyzujeme tendencie dokončenia a preskakovania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutno preverjamo trend končanih in skočjenih dejavnosti na napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi undersöker trender för avslut och hopp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவு மற்றும் தவிர்க்கும் போக்குகளை சாதனத்தில் சரிபார்க்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తి మరియు దాటవేసే ధోరణిని పరికరంలో సమీక్షిస్తున్నాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบแนวโน้มของการทำและข้ามในอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanma ve atlama eğilimlerini cihaz içinde kontrol ediyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми перевіряємо тенденцію завершення та пропуску на пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đang kiểm tra xu hướng hoàn thành và bỏ qua trong thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在确认完成/跳过的倾向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認完成/跳過的趨勢。"
          }
        }
      }
    },
