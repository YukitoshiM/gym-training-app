    "domain_catalog.8797f4d5f573": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:104\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ ظهرك مسطحًا، وارفع الدمبلز عن طريق سحب مرفقيك نحو الوركين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint l'esquena plana, aixeca les manuelles estirant els colzes cap als malucs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte rovná záda a zvedejte činku tak, abyste ji drželi u pasu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ryggen ret og løft håndvægten med armene ud, så de når mod hofterne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Rücken gerade halten und mit dem Hantel den Oberkörper anheben, wobei die Arme zum Körper gezogen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε την πλάτη σας ίσια και σηκώστε το αλτήρα κρατώντας τους αγκώνες κοντά στο σώμα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back flat and lift the dumbbell by pulling your elbows towards your waist."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back flat and lift the dumbbell by pulling your elbows towards your waist."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back flat and lift the dumbbell by pulling your elbows towards your waist."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back flat and lift the dumbbell by pulling your elbows towards your waist."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la espalda recta y levanta el mancuernas, acercando los codos al abdomen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la espalda recta y levanta el mancuernas, acercando los codos al abdomen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä selkä tasaisena ja nosta käsipainoa pitämällä kyynärpäät lähellä vatsaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le dos droit et soulevez le haltère en tirant les coudes vers le bas."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le dos droit et soulevez le haltère en tirant les coudes vers le bas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મા espaldaને સપાટ રાખો, અને ખભાને પેટ તરફ ખેંચીને ડમ્બેલ ઉઠાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשמור על הגב במצב ישר, להרים משקולת כך שהמרפקים יהיו קרובים לגוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पीठ को सपाट रखें, और अपनी बाहों को अपने पेट की ओर खींचते हुए डम्बल उठाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite leđa ravnim, podižite uteg tako da vam ruke idu prema struku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a hátát egyenesen, és emelje a käszt a deréka irányába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaga agar punggung tetap lurus, lalu angkat dumbbell dengan menarik siku ke arah pinggang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere la schiena dritta e sollevare i manubri tenendoli vicino al corpo, tirando l'avambraccio verso il basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背中を平らに保ち、肘を腰へ引くようにダンベルを持ち上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리를 똑바로 유지하고, 팔꿈치를 허리에 붙듯이 덤벨을 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठीचा कणा सरळ ठेवा, हातांच्या साहाय्याने डंबेल वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan punggung tetap rata, angkat dumbbell dengan menarik siku ke arah pinggang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de rug recht en til met dumbbells, waarbij je de ellebogen richting je heupen houdt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ryggen rett og løft vekten med armene, slik at albuene peker mot hoften."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj proste plecy i podnoś sztangę, trzymając ją blisko pasa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as costas retas e levante a barra com os braços estendidos, como se estivesse puxando para baixo em direção à cintura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as costas retas e levante a barra com os braços estendidos, como se estivesse puxando para baixo em direção à cintura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți spatele drept și ridicați ganterele, trăgând coatele spre abdomen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите спину ровной, поднимая гантель так, чтобы локти были направлены к пояснице."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte zad rovný a zdvíhajte činku tak, aby ste si držali ramena blízko tela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite utež tako, da je hrbet ravno,in dvajete z ramo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll ryggen rak och lyft hanteln genom att dra armarna mot höfterna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முதுகை நேராக வைத்து, உங்கள் கைகளை இடுப்புக்கு அருகில் கொண்டு வந்து டம்பல்-ஐ உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నును చదునుగా ఉంచి, మోచేతులను కాలు వైపుకు లాగి డంబెల్‌ను పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาให้หลังอยู่ในแนวตรง, ยกดัมเบลโดยให้ข้อศอกแนบกับเอว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkanı düz tutarak, dirseklerini kalçalarına doğru çekerek ağırlığı kaldır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте спину рівною, піднімайте гантель так, щоб лікті були біля талії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lưng thẳng, nâng tạ bằng cách đưa khuỷu tay về phía eo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持背部平直，并将肘部向腰部方向拉，抬起哑铃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持背部挺直，並用肘部向腰部拉的動作抬起啞鈴"
          }
        }
      }
    },
    "domain_catalog.87e1af9fe092": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:225\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "صبور ودقيق. يؤيد قرار الانتهاء بمبلغ صغير"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacient i precís. Admet la decisió d'acabar amb una petita quantitat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Buďte trpěliví a přesní. Podporujeme i rozhodnutí ukončit cvičení s menším počtem opakování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær tålmodig og præcis. Appen støtter også beslutninger om at afslutte med mindre mængder."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Geduldig und präzise. Unterstützen Sie auch Entscheidungen, bei denen eine geringe Menge verwendet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιμονή και ακρίβεια. Υποστηρίζουμε την απόφαση για μικρότερες ποσότητες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Patience and accuracy are key. We support decisions to finish with a smaller amount."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Patience and accuracy are key. We support decisions to finish with a smaller amount."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Patience and accuracy are key. We support decisions to finish with a smaller amount."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Patience and accuracy are key. We support decisions to finish with a smaller amount."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé paciente y preciso. Apoya la decisión de terminar con una cantidad pequeña."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé paciente y preciso. Apoya la decisión de terminar con una cantidad pequeña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ole kärsivällinen ja tarkka. Tukee myös päätöksiä, joissa käytetään vähän"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Être patient et précis. Soutenir les décisions basées sur de petites quantités."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Être patient et précis. Soutenir les décisions basées sur de petites quantités."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ધીરજથી અને ચોકસાઈથી કામ કરો. ઓછી માત્રામાં પણ યોગ્ય નિર્ણય લેવામાં મદદ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סבלנות ודיוק. תמיכה בהחלטות להפסקת פעילות גם עם כמות קטנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धैर्यपूर्वक और सटीक रूप से। कम मात्रा में भी समाप्त करने का निर्णय लेने में मदद करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budi strpljiv i točan. Podržavamo odluke koje uključuju malu količinu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Türelem és precizitás. Segít a kis mennyiségben történő döntésekben is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersabar dan akurat. Mendukung pengambilan keputusan untuk menyelesaikan latihan dengan jumlah yang lebih sedikit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii paziente e preciso. Supporta anche le decisioni prese con piccole quantità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辛抱強く正確。少ない量で終える判断も支える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인내심을 가지고 정확하게 수행합니다. 적은 양으로 마무리하는 판단도 지원합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "धैर्य ठेवा आणि अचूकपणे करा. कमी प्रमाणात व्यायाम करून घेतल्यानंतर निर्णय घेण्यास मदत करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersabar dan tepat. Menyokong keputusan untuk menyelesaikan dengan jumlah yang kurang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees geduldig en nauwkeurig. Ondersteunt beslissingen om met kleine hoeveelheden te stoppen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær tålmodig og nøyaktig. Appen støtter også beslutninger om å avslutte med mindre mengder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierpliwie i precyzyjnie. Wspieramy również decyzje dotyczące małych ilości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja paciente e preciso. Apoie decisões de reduzir a quantidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja paciente e preciso. Apoie decisões de reduzir a quantidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fii perseverent și precis. Aplica suport pentru deciziile de a termina cu o cantitate mică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терпеливо и точно. Поддерживаем принятие решения об окончании тренировки с небольшим количеством повторений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trpezlivo a presne. Podporujeme aj rozhodovanie, ktoré zahŕňa menšie množstvo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite potrpežni in natančni. Podpiramo tudi odločitve o končanju z manjšo količino."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var tålmodig och noggrann. Stöd även beslut om att avsluta med mindre mängd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொறுமையாகவும், துல்லியமாகவும் செயல்படுங்கள். சிறிய அளவில் முடித்துக்கொள்ளும் முடிவுகளுக்கு ஆதரவு அளிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఓపికగా మరియు ఖచ్చితంగా ఉండండి. తక్కువ మొత్తంలో ముగించడానికి కూడా సహాయపడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อดทนและแม่นยำ ช่วยในการตัดสินใจเมื่อใช้ปริมาณน้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabırla ve doğru bir şekilde hareket et. Az miktarda çalışarak karar vermeni destekliyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будьте терплячими та точними. Допомагаємо вам приймати рішення щодо невеликої кількості."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiên nhẫn và chính xác. Hỗ trợ quyết định kết thúc với lượng nhỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耐心且准确。即使是少量，也能支持判断"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "耐心且準確。即使用少量來完成判斷，也會得到支持"
          }
        }
      }
    },
