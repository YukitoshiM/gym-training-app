    "domain_catalog.d462815994b8": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:180\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإمالة الجزء العلوي من جسمك وافتح مرفقيك على الجانبين دون الضغط على لوحي كتفك بشكل قريب جدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclineu la part superior del cos i obriu els colzes cap als costats sense estrènyer massa els omòplats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakloňte tělo a držte ramena blízko, ale ne příliš blízko, a odvíjejte lokty do strany."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj kroppen og åbn albuerne uden at presse skulderbladene for meget sammen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Oberkörper nach hinten lehnen und die Schulterblätter nicht zu stark zusammenziehen, während man die Arme leicht zur Seite bewegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταρρίξτε το σώμα σας και ανοίξτε τους αγκώνες, χωρίς να πιέζετε υπερβολικά τους ώμους."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward, keeping your elbows slightly apart without overextending your shoulder blades."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward, keeping your elbows slightly apart without overextending your shoulder blades."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward, keeping your elbows slightly apart without overextending your shoulder blades."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean forward, keeping your elbows slightly apart without overextending your shoulder blades."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate y abre los codos sin acercar demasiado las escápulas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate y abre los codos sin acercar demasiado las escápulas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyykisty, älä vedä lapaluohiasi liian lähelle toisiaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pencher pour incliner le corps, en gardant les épaules légèrement rapprochées sans trop ouvrir les coudes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pencher pour incliner le corps, en gardant les épaules légèrement rapprochées sans trop ouvrir les coudes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા શરીરને નીચે કરો, ખભાને વધારે નજીક ન લાવો અને કાંડાને બાજુ પર ખોલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התכופפו מעלה, תוך שמירה על עצמות השכמות לא מרוחקות מדי ופתיחת המרפק לצד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ऊपरी शरीर को झुकाएं, कंधे को बहुत करीब न लाएं और अपनी कोहनी को थोड़ा खोल दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispošto se, ne previše približavajući lopatice i otvarajući ruke u stranu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzd fel a testet, és ne nyomd túl a vállizmait, hanem nyisd ki a könyked."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Condongkan tubuh ke atas, jangan terlalu menekuk siku, biarkan sedikit terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinare il busto, mantenendo le spalle ben separate e aprendo leggermente i gomiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上体を倒し、肩甲骨を寄せすぎずに肘を横へ開く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상체를 숙이고, 어깨뼈를 너무 좁히지 않고 팔꿈치를 옆으로 벌린다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीराचा वरचा भाग खाली करा, खांद्याच्या हाडांना जास्त जवळ न आणता कोपर बाजूला उघडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bungkukkan badan, jangan terlalu rapatkan tulang belikat, buka lengan ke sisi."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Leun omhoog en open je ellebogen, zonder je schouderbladen te veel naar elkaar toe te trekken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy kroppen, og åpne armene uten å presse skulderbladene for mye sammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opuść tułów, nie zginając zbyt mocno łokci, a jedynie delikatnie zbliżając kości ramienne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline o corpo e abra os cotovelos sem exagerar na movimentação das escápulas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline o corpo e abra os cotovelos sem exagerar na movimentação das escápulas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îndoiți-vă corpul și lăsați umerii mai relaxați, fără să vă încrucișați brațele prea mult."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклонитесь вперёд, не сжимая лопатки слишком сильно и разворачивая руки в стороны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakloň telo a drž sa v pozícii, kým nepreťažíš ramena."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasuknite se nazaj, ne preveč stisnite ramo in odprite ramo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Luta överkroppen och öppna armarna utan att pressa skulderbladen för mycket."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மேல் உடலை சாய்த்து, தோள்பட்டை எலும்புகளை அதிகமாக நெருக்கமாக வைக்காமல், மணிக்கட்டுகளை பக்கவாட்டில் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ శరీరాన్ని ముందుకు వంచండి, భుజం ఎముకలను అతిగా దగ్గర చేయకుండా మోచేతులను పక్కకు తెరవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้มตัวขึ้น และเปิดแขนออก โดยไม่บีบสะโพก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst vücudunuzu öne eğin, omuzlarınızı çok fazla sıkıştırmadan kollarınızı yana açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклоніться вперед, не зводячи плечі та розводячи руки в сторони."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gập người lên, giữ cho vai không quá gần nhau và mở khuỷu tay sang hai bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将身体向前倾，避免过度挤压肩胛骨，保持肘部自然放松。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將上半身傾斜，避免過度擠壓肩胛骨，並保持手臂向側面打開。"
          }
        }
      }
    },
