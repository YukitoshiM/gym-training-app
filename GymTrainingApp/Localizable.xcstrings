        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerten Sie den Körperveränderungen unter Berücksichtigung von Gewicht, Bauchumfang, Fotos und Muskelkraft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αξιολογήστε την αλλαγή σωματότυπου λαμβάνοντας υπόψη το βάρος, την περιφέρεια του κορμού και τις φωτογραφίες σας, καθώς και τη μυϊκή σας δύναμη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluate your body shape by combining your weight, waist circumference, photos, and muscle strength."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluate your body shape by combining your weight, waist circumference, photos, and muscle strength."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluate your body shape by combining your weight, waist circumference, photos, and muscle strength."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Evaluate your body shape by combining your weight, waist circumference, photos, and muscle strength."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Evalúa los cambios en la figura considerando tu peso, circunferencia abdominal y fotografías, así como tu fuerza muscular."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Evalúa los cambios en la figura considerando tu peso, circunferencia abdominal y fotografías, así como tu fuerza muscular."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioi kehonmuodon muutoksia ottaen huomioon paitsi painon myös vatsanympäryn ja valokuvat sekä lihasvoiman"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Évaluer votre évolution de silhouette en tenant compte de votre poids, de votre tour de taille et de vos photos, ainsi que de votre force musculaire."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Évaluer votre évolution de silhouette en tenant compte de votre poids, de votre tour de taille et de vos photos, ainsi que de votre force musculaire."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન, પેટની પરિમિતિ, ફોટા અને સ્નાયુ શક્તિને ધ્યાનમાં લઈને શરીરના ફેરફારોનું મૂલ્યાંકન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכת שינוי צורת הגוף תוך שילוב משקל, היקף מותניים ותמונות וכוח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वजन, पेट के घेरे, और तस्वीरों के साथ-साथ अपनी शारीरिक बदलाव का मूल्यांकन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocijenite promjene izgleda tijela uz težinu, mjere struja i snagu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értékelj a testformát a testsúly, a mellszövet körfogata és az izom erőssége alapján."
