    "domain_catalog.49042d56f471": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:210\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ مرفقيك في موضعهما وأدر معصميك أثناء رفع الدمبل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu els colzes en posició i gireu els canells mentre aixequeu les manuelles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte pozici loktů a zvedejte činku pomocí pohybu zápěstí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold albuerne på plads og løft håndleddet samtidig med at du løfter vægten."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Position deiner Ellbogen und hebe das Gewicht mit dem Handgelenk an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε τη θέση των αγκονών και σηκώστε το ράβδο χρησιμοποιώντας τον καρπό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows in position and raise the dumbbell while reversing your wrists."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows in position and raise the dumbbell while reversing your wrists."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows in position and raise the dumbbell while reversing your wrists."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows in position and raise the dumbbell while reversing your wrists."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la posición de los codos y levantar la barra con las manos, doblando ligeramente las muñecas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la posición de los codos y levantar la barra con las manos, doblando ligeramente las muñecas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kyynärpäät paikallaan ja nosta käsipainoa käden avulla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la position de vos coudes tout en soulevant le haltère en pliant le poignet."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la position de vos coudes tout en soulevant le haltère en pliant le poignet."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથની સ્થિતિ જાળવી રાખો અને હાથની ઘૂંટીને ઉપરની તરફ ખેંચીને ડમ્બેલ ઉઠાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשמור על מיקום הכתף, ולהרים את הדסקית תוך שמירת פרק היד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी की स्थिति बनाए रखें और डम्बल उठाते समय अपनी कलाई को सीधा रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite ruke u pravilnom položaju i podižite uteg uz pomoć zglobova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a karok helyzetét, miközben emeli a käsizt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempertahankan posisi siku, lalu mengangkat dumbbell sambil menekuk pergelangan tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la posizione dei gomiti e solleva il manubrio piegando il polso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘の位置を保ち、手首を返しながらダンベルを上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔꿈치의 위치를 유지하면서 손목을 뒤로 젖히며 덤벨을 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हाताची स्थिती स्थिर ठेवा आणि हाताच्या साहाय्याने डंबेल वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan kedudukan siku, sambil mengangkat dumbbell dengan menekuk pergelangan tangan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je ellebogen op hun plaats en til de dumbbell door je hand te bewegen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold albuene på plass og løft stangen ved hjelp av håndleddet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymaj pozycję łokcia i podnoś ciężar za pomocą dłoni, jednocześnie utrzymując prawidłową postawę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos na posição adequada e levante o peso com as mãos, flexionando os punhos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos na posição adequada e levante o peso com as mãos, flexionando os punhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține poziția antebrațelor și ridică ganterele, flexând încheietura mâinii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите локти в определенном положении и поднимайте гантель, сгибая запястье."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržajte pozíciu lakťov a zdvihnite činku pomocou zápästia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na položaj rok, medtem ko dvigujete ute s pomočjo roke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll armbågen på plats och lyft hanteln genom att böja handleden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை மடக்கி, மணிக்கட்டை உயர்த்தி, டம்பலை உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతుల స్థానాన్ని కాపాడుతూ, చేతిని పైకి ఎత్తి డంబెల్‌ను పైకి తీసుకురావడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาระดับข้อศอก และยกดัมเบลโดยการงอข้อมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirseklerinizi sabit tutarken, el bileğinizi kullanarak ağırlığı yukarı kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте руки в потрібному положенні та піднімайте гантелі, згинаючи зап'ястя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khuỷu tay cố định, đồng thời nâng tạ bằng cách xoay cổ tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持肘部位置，同时向上提起哑铃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持肘部位置，同時將手腕向後彎曲，抬起啞鈴"
          }
        }
      }
    },
    "domain_catalog.493865938e62": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:330\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
