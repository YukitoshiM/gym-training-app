    "domain_catalog.75b203866563": {
      "comment": "GymTrainingApp/Domain/FoodCompositionModels.swift:517\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\nhu: NLLB fallback used to remove untranslated Japanese; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر دون صعوبة أثناء مراقبة جوعك وحالتك البدنية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Continueu sense dificultat mentre controleu la vostra gana i la vostra condició física."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénujte bezpečně a v souladu se svým hladem a celkovým stavem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt uden at presse dig selv, mens du tager højde for sult og helbredstilstand"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie auf Hunger und körperliches Wohlbefinden, um ohne Anstrengung fortzuhalten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε την άσκηση με ασφάλεια, λαμβάνοντας υπόψη την πείνα και την υγεία σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without straining yourself while monitoring hunger and your condition"
