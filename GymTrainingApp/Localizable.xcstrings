    "domain_catalog.706df71283ca": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:315\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تمديد الساق حول مفصل الركبة وتقليص عضلات الفخذ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esteneu la cama al voltant de l'articulació del genoll i contrau el quàdriceps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protažení kolen, použijte kolena jako osu a protáhněte kvadriceps."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stræk benene ud fra knæleddet, og træk quadriceps sammen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Strecken Sie die Beine mit dem Knie als Drehpunkt und spannen Sie den Oberschenkelmuskel an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τεντώστε τα πόδια χρησιμοποιώντας τις αρθρώσεις των γονάτων ως άξονα και συστέλλετε τους τετρακέφαλους."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your legs using your knee joints as a pivot point, then contract your quadriceps."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your legs using your knee joints as a pivot point, then contract your quadriceps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your legs using your knee joints as a pivot point, then contract your quadriceps."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your legs using your knee joints as a pivot point, then contract your quadriceps."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Extender las piernas utilizando las rodillas como eje, contrayendo los cuádriceps."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Extender las piernas utilizando las rodillas como eje, contrayendo los cuádriceps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä polvitukipisteenä ja ota askel eteenpäin, jolloin reisi-lihakset supistuvat."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendre les jambes en utilisant les genoux comme axe, en contractant les quadriceps."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendre les jambes en utilisant les genoux comme axe, en contractant les quadriceps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ઘૂંટણને આધાર તરીકે ઉપયોગ કરીને પગને લંબાવો, અને તમારા ક્વાડ્રિસેપ્સ સ્નાયુઓને સંકોચાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרחבת הרגליים תוך שימוש בברך כנקודת ייחוס וקשירת שריר הטריספס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने घुटनों को सहारा के रूप में उपयोग करके अपने पैरों को फैलाएं, और अपनी जांघों की मांसपेशियों को संकुचित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Istežite noge uz korištenje koljena kao osnove, a zatim napnite kvadriceps."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a térdet mint alapként, hogy kinyújtsa a lábait, és húzza össze az alsó lábszárát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meluruskan kaki dengan menggunakan sendi lutut sebagai poros, lalu mengencangkan otot quadriceps."
