    "domain_catalog.6e22f6c1c05e": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:332\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع شيئًا فشيئًا، وتأكد من أنك ضمن نطاق معقول."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aneu a poc a poc, assegurant-vos que esteu dins d'un rang raonable."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postupujte pomalu a postupně, přičemž vždy zkontrolujte, zda to pro vás není příliš náročné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå langsomt og sikkert frem, mens du bekræfter, at det er muligt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie langsam und überprüfen Sie regelmäßig, ob es für Sie geeignet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προχωρήστε σταδιακά, ελέγχοντας τα όρια σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's progress gradually, while ensuring it is within a comfortable range."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's progress gradually, while ensuring it is within a comfortable range."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's progress gradually, while ensuring it is within a comfortable range."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's progress gradually, while ensuring it is within a comfortable range."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza gradualmente, comprobando tus límites."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza gradualmente, comprobando tus límites."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee pieniä edistysaskeleita varmistaen, että pysyt turvallisella tasolla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancez progressivement, en vérifiant régulièrement les limites."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancez progressivement, en vérifiant régulièrement les limites."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરળતાથી કરી શકાય તે પ્રમાણે, ધીમે ધીમે આગળ વધો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בצעו את זה בהדרגה, תוך הקפדה על גבולות בטוחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना किसी परेशानी के, धीरे-धीरे आगे बढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite ovaj alat za postupan i siguran gubitak težine."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lépjen előre fokozatosan, figyelve a saját képességeit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mari maju sedikit demi sedikit sambil memantau dalam batas yang aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Procedi gradualmente, controllando i tuoi progressi e rimanendo entro limiti ragionevoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理のない範囲を確認しながら、少しずつ進めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무리 없이 진행하며, 조금씩 나아가도록."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सोप्या पद्धतीने, हळू हळू प्रगती करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lakukan secara perlahan dan berhati-hati, sambil memastikan anda berada dalam had yang sesuai."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe dit stap voor stap, waarbij je rekening houdt met wat wel mogelijk is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør fremskritt gradvis, og sørg for at du holder deg innenfor et trygt område."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postępuj stopniowo, sprawdzając zakres możliwości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avançe gradualmente, verificando seus limites."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avançe gradualmente, verificando seus limites."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Progresează treptat, verificând periodic dacă este posibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делайте это постепенно, проверяя свои возможности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Postupujte pomaly a postupne, pričom sa uistite, že to robíte bezpečne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na to, da se premikate postopoma in varno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör det steg för steg, och kontrollera dina framsteg regelbundet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எளிமையான முறையில், கொஞ்சம் கொஞ்சமாக முன்னேறுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సులభమైన పరిధిలో, క్రమంగా ముందుకు సాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการทีละขั้นตอน โดยตรวจสอบให้แน่ใจว่าอยู่ในขอบเขตที่เหมาะสม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolay bir şekilde ilerleyin. Kısıtlamaları göz önünde bulundurarak, yavaş ve kademeli olarak ilerleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть поступово, перевіряючи можливості."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tiến bộ từng bước, đồng thời đảm bảo rằng việc này nằm trong khả năng của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在可承受范围内，逐步进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不超出自身能力範圍的情況下，逐步進行。"
          }
        }
      }
    },
