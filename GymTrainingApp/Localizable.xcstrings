        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to the passage of time since the last measurement, changes are estimated with a margin."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Debido a que ha pasado tiempo desde la última medición, no se puede afirmar con certeza el cambio y se incluye un margen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Debido a que ha pasado tiempo desde la última medición, no se puede afirmar con certeza el cambio y se proporciona un margen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska viimeisestä mittauksesta on kulunut aika, muutosta ei voida varmasti todistaa. Arvioitu arvo."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En raison d'un intervalle de temps entre la dernière mesure, le changement est estimé et non confirmé. "
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En raison d'un intervalle de temps entre la dernière mesure, le changement est estimé et non confirmé. "
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લું વાસ્તવિક માપથી સમયગાળો પસાર થયો હોવાથી, તેમાં ફેરફારને ચોક્કસ રીતે જણાવતા નથી. તે અંદાજિત છે."
