            "value": "भविष्य के सुझावों में उपयोग करने के लिए, केवल उपयुक्त सामग्री का चयन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite samo sadržaj koji možete koristiti za buduće preporuke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, csak azokat a pontokat válassza ki, amelyeket a jövőbeli javaslatokban használhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih hanya konten yang sesuai untuk digunakan dalam rekomendasi selanjutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionate solo i contenuti utili per le future proposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の提案に使ってよい内容だけ選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향후 제안에 사용할 수 있는 내용만 선택해 주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढील सूचनांसाठी, फक्त योग्य माहिती निवडा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila pilih hanya kandungan yang sesuai untuk digunakan dalam cadangan selanjutnya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer alleen de relevante informatie voor toekomstige suggesties."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg kun de relevante punktene for fremtidige anbefalinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę wybrać tylko te informacje, które mogą być użyte w przyszłych propozycjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione apenas os conteúdos que podem ser usados nas próximas sugestões."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione apenas os conteúdos que podem ser usados nas próximas sugestões."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă rugăm să selectați doar conținutul relevant pentru propuneri viitoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, выберите только те пункты, которые можно использовать для дальнейших рекомендаций."
          }
        },
        "sk": {
          "stringUnit": {
