    "health_meals_body_ai.8c75473ee509": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:249\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الحجم هو وزن المجموعات المكتملة × التكرارات. لا تعقد الكثير من المقارنات البسيطة بين الأسابيع التي تحتوي على تراكيب أحداث مختلفة جدًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El volum és el pes de les sèries completades x repeticions. No feu massa comparacions senzilles entre setmanes amb composicions d'esdeveniments molt diferents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objem je součet váhy kompletní série × počet opakování. Při výrazně odlišných tréninkových programech se vyhněte přílišnému porovnávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen er vægten af det fuldførte sæt × antal gentagelser. Undgå at sammenligne ugentlige træningsprogrammer for meget, hvis der er store forskelle i øvelserne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Volumen ist das Gewicht des kompletten Satzes multipliziert mit der Anzahl der Wiederholungen. Vergleichen Sie bei unterschiedlichen Übungsprogrammen nicht zu stark."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο όγκος είναι το βάρος του πλήρους σετ × αριθμός επαναλήψεων. Όταν οι ασκήσεις διαφέρουν σημαντικά, μην κάνετε απλές συγκρίσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is calculated as: Weight of completed set x number of repetitions. When the exercise composition differs significantly from week to week, avoid making simple comparisons."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is calculated as: Weight of completed set x number of repetitions. When the exercise composition differs significantly from week to week, avoid making simple comparisons."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is calculated as: Weight of completed set x number of repetitions. When the exercise composition differs significantly from week to week, avoid making simple comparisons."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is calculated as: Weight of completed set x number of repetitions. When the exercise composition differs significantly from week to week, avoid making simple comparisons."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se calcula como peso × número de repeticiones para cada serie. Evite comparaciones directas en semanas con diferentes combinaciones de ejercicios."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se calcula como peso × número de repeticiones para cada serie. Evite comparaciones directas en semanas con diferentes combinaciones de ejercicios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Volyymi on täydellisen sarjan paino × toistojen määrä. Jos harjoitusohjelma vaihtelee paljon, älä tee yksinkertaisia vertailuja."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume est le poids du jeu complet × nombre de répétitions. Évitez de faire des comparaisons trop simplistes lorsque la composition des exercices diffère considérablement d'une semaine à l'autre."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume est le poids du jeu complet × nombre de répétitions. Évitez de faire des comparaisons trop simplistes lorsque la composition des exercices diffère considérablement d'une semaine à l'autre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વોલ્યુમ એ પૂર્ણ સેટનું વજન × સંખ્યા. જો કસરતોમાં મોટો તફાવત હોય, તો સરળતાથી સરખામણી ન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נפח הוא משקל × מספר חזרות עבור סט השלם. כאשר יש שינויים גדולים בהרכב האימונים, אין להשוות בצורה פשוטה מדי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मात्रा = पूर्ण सेट का वजन × संख्या। यदि व्यायाम में काफी बदलाव है, तो सरल तुलना न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Količina je težina seta × broj. Nemojte uspoređivati različite tjedne s puno različitim kombinacijama vježbi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választék az adott edzés teljesítéséhez szükséges súly × szám. Ha az edzések nagyon eltérnek, ne hasonlítsa őket egyszerűen össze."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume adalah berat total untuk set yang lengkap × jumlah repetisi. Hindari perbandingan sederhana jika jenis latihan sangat berbeda setiap minggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume è il peso del set completo × numero di ripetizioni. Evitare di fare confronti troppo semplici quando la composizione degli esercizi cambia notevolmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリュームは完了セットの重量 × 回数。種目構成が大きく違う週は単純比較しすぎないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량은 완료 세트의 무게 × 횟수입니다. 운동 종류 구성이 크게 다른 주에는 단순 비교는 피해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्हॉल्यूम म्हणजे पूर्ण सेटचे वजन × संख्या. ज्या आठवड्यांमध्ये व्यायामाच्या प्रकारात मोठा फरक आहे, त्यामध्ये तुलना करणे टाळा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuantiti ialah berat set lengkap × bilangan. Jika susunan latihan berbeza secara ketara setiap minggu, jangan membuat perbandingan yang terlalu mudah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is het gewicht van een voltooide set vermenigvuldigd met het aantal herhalingen. Vergelijk verschillende weken niet te veel, vooral als de oefeningen sterk verschillen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumet er vekten på fullsettet × antall repetisjoner. Unngå å sammenligne ulikt utstyr over flere uker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Objętość to waga zestawu × liczba powtórzeń. Przy dużych różnicach w składzie ćwiczeń, unikaj uproszczonych porównań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume é calculado como peso × número para um conjunto completo. Ao comparar semanas com configurações diferentes, evite comparações simplistas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume é calculado como peso × número para um conjunto completo. Ao comparar semanas com configurações diferentes, evite comparações simplistas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumul este egal cu greutatea setului complet × numărul de repetări. Când structura exercițiilor diferă semnificativ, evitați comparațiile simple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объем рассчитывается как вес завершенного упражнения × количество повторений. При значительном изменении состава тренировок не стоит делать простые сравнения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Objem je váha kompletného setu × počet opakovaní. Ak sa zloženie tréningu výrazne líši, vyhýbajte sa jednoduchému porovnávaniu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Količina je število kilogramov v kompletu × število ponovitev. Pri različnih treningih bodite pri primerjavi opre, da ne boste naredili preveč napak."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volym är vikten för ett komplett set multiplicerat med antalet repetitioner. Var försiktig med att jämföra veckor med mycket olika övningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவு என்பது முழுமையான தொகுப்பின் எடை × எண்ணிக்கை. வெவ்வேறு வாரங்களில் உடற்பயிற்சி முறைகள் மாறுபடும்போது, அவற்றை ஒப்பிடுவதில் கவனம் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరిమాణం అనేది పూర్తి చేసిన సెట్ల బరువు × సంఖ్య. వ్యాయామాలలో పెద్దగా తేడాలు ఉన్న వారాల్లో, వాటిని పోల్చడం సులభం కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณคือ น้ำหนักของชุดที่สมบูรณ์ × จำนวนครั้ง โปรดอย่าเปรียบเทียบมากเกินไปในสัปดาห์ที่มีรูปแบบการออกกำลังกายที่แตกต่างกันอย่างมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacim, tamamlanmış setlerin ağırlığı × tekrar sayısıdır. Farklı egzersiz türlerine sahip haftalarda basit karşılaştırmalar yapmaktan kaçının."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об'єм – це сума ваги завершеного комплексу × кількість повторень. У тижнях з різною структурою вправ, не робіть надмірних спроб порівняння."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lượng là tổng trọng lượng của các bộ tập luyện × số lần thực hiện. Khi cấu trúc bài tập khác nhau nhiều, hãy tránh so sánh trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重量是完成一组的重量 × 次数。当每周的训练项目差异较大时，不要简单地进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體積為已完成的組數 × 次數。如果週次中項目構成差異較大，請避免簡單比較。"
          }
        }
      }
    },
    "health_meals_body_ai.8cffd32caabd": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:651\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى البدء بـ https:// لـ URL. للتطوير المحلي، يمكنك أيضًا استخدام HTTP مع أسماء localhost وLAN IP وTailscale."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenceu amb https:// per a URL. Per al desenvolupament local, també podeu utilitzar HTTP amb noms localhost, LAN IP i Tailscale."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "URL začněte s https://. Pro lokální vývoj můžete použít HTTP i pro localhost, IP adresy LAN a Tailscale."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "URL skal starte med https://. Under lokal udvikling kan du også bruge HTTP på localhost, LAN IP og Tailscale-navne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beginnen Sie die URL mit https://. Für lokale Entwicklungen können auch HTTP-Verbindungen zu localhost, LAN IP und Tailscale verwendet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διεύθυνση URL πρέπει να ξεκινά με \"https://\". Για τοπική ανάπτυξη, μπορείτε επίσης να χρησιμοποιήσετε HTTP για localhost, IP LAN και ονόματα Tailscale."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please start the URL with \"https://\". For local development, you can also use HTTP on localhost, LAN IP, and Tailscale."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please start the URL with \"https://\". For local development, you can also use HTTP on localhost, LAN IP, and Tailscale."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please start the URL with \"https://\". For local development, you can also use HTTP on localhost, LAN IP, and Tailscale."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Please start the URL with \"https://\". For local development, you can also use HTTP on localhost, LAN IP, and Tailscale."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL debe comenzar con \"https://\". Para el desarrollo local, también es posible usar HTTP para localhost, IP de red y Tailscale."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL debe comenzar con \"https://\". Para el desarrollo local, también es posible usar HTTP para localhost, IP de red y Tailscale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL alkaa \"https:\" -merkillä. Paikallisessa kehityksessä voit käyttää myös HTTP:tä localhostissa, LAN-IP-osoitteessa ja Tailscale-nimen kautta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez l'URL par https://. Pour le développement local, vous pouvez également utiliser HTTP sur localhost, l'adresse IP du réseau local et Tailscale."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez l'URL par https://. Pour le développement local, vous pouvez également utiliser HTTP sur localhost, l'adresse IP du réseau local et Tailscale."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "URL https:// થી શરૂ થવું જોઈએ. સ્થાનિક વિકાસ માટે, localhost, LAN IP અને Tailscale ના HTTP નો ઉપયોગ કરી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להתחיל בכתובת ה-URL עם https://. ניתן להשתמש גם ב-HTTP עבור localhost, כתובות IP של רשת מקומית ו-Tailscale במהלך פיתוח מקומי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "URL https:// से शुरू होना चाहिए। स्थानीय विकास के लिए localhost, LAN IP और Tailscale नाम के HTTP का भी उपयोग किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL mora početi s https://. Za lokalni razvoj možete koristiti HTTP i localhost, IP adresu lokalne mreže i Tailscale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az URL-t https://-zal kezdje. A helyi fejlesztés során localhost, LAN IP és Tailscale nevű HTTP is használható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "URL harus dimulai dengan https://. Untuk pengembangan lokal, Anda juga dapat menggunakan HTTP pada localhost, IP LAN, dan Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL deve iniziare con https://. Durante lo sviluppo locale, puoi utilizzare anche HTTP su localhost, indirizzo IP della rete LAN e Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URLはhttps://から始めてください。ローカル開発ではlocalhost、LAN IP、Tailscale名のHTTPも利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL은 https://로 시작해주세요. 로컬 개발 시에는 localhost, LAN IP, Tailscale 이름의 HTTP도 사용 가능합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL https:// पासून सुरू करा. स्थानिक विकासासाठी localhost, LAN IP आणि Tailscale नावाचे HTTP देखील वापरले जाऊ शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "URL mesti bermula dengan https://. Untuk pembangunan tempatan, anda boleh menggunakan HTTP pada localhost, IP LAN, dan nama Tailscale."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin de URL met https://. Tijdens lokale ontwikkeling kan ook HTTP worden gebruikt voor localhost, LAN IP en Tailscale (bijv. \"http://tailscale.example.com\")."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "URL må starte med https://. For lokal utvikling kan du også bruke HTTP på localhost, LAN IP og Tailscale-navn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres URL powinien zaczynać się od https://. W środowisku lokalnym można również używać adresów HTTP dla localhost, IP w sieci LAN i Tailscale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A URL deve começar com https://. Para desenvolvimento local, você também pode usar HTTP em localhost, endereço IP da LAN e Tailscale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A URL deve começar com https://. Para desenvolvimento local, você também pode usar HTTP em localhost, endereço IP da LAN e Tailscale."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa URL trebuie să înceapă cu https://. În timpul dezvoltării locale, puteți utiliza și HTTP pe localhost, adresa IP a rețelei locale și numele Tailscale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URL должен начинаться с https://. Для локальной разработки доступны HTTP-адреса localhost, IP-адреса локальной сети и Tailscale."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL začnite s https://. Pre lokálne vývojové prostredie môžete použiť HTTP aj na localhost, IP adresy LAN a Tailscale."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "URL začnite z https://. Za lokalno razvojo lahko uporabite tudi HTTP na localhost, IP-ju LAN in Tailscale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "URL börjar med https://. För lokal utveckling kan du använda localhost, LAN IP och HTTP med namnet Tailscale."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, \"https://\" உடன் தொடங்க வேண்டும். உள்ளூர் மேம்பாட்டிற்கு localhost, LAN IP மற்றும் Tailscale பெயரில் HTTP பயன்படுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "URL https://తో ప్రారంభించండి. స్థానిక అభివృద్ధిలో localhost, LAN IP మరియు Tailscale పేరుతో HTTP కూడా ఉపయోగించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเริ่มต้น URL ด้วย https สามารถใช้ HTTP บน localhost, IP LAN และชื่อ Tailscale ในการพัฒนาแบบ Local ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL \"https://\" ile başlayın. Yerel geliştirme sırasında localhost, yerel ağ IP adresi ve Tailscale adı gibi HTTP adreslerini de kullanabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "URL має починатися з https://. Під час локального розроблення можна використовувати HTTP для localhost, IP локальної мережі та Tailscale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng bắt đầu URL bằng https://. Trong môi trường phát triển cục bộ, bạn có thể sử dụng HTTP với localhost, địa chỉ IP của mạng LAN và Tailscale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请以https://开头。在本地开发中，可以使用localhost、局域网IP和Tailscale名称的HTTP。"
          }
