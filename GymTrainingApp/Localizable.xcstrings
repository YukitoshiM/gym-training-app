    "health_meals_body_ai.39d757a8749c": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:657\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء إدخال اسم الأكلة والكمية إذا كانت معروفة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, introduïu el nom del menjar i la quantitat si es coneix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte název a případně i množství potraviny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv navnet på maden, samt mængden hvis du kender den."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte geben Sie den Namen des Lebensmittels sowie die Menge ein, falls bekannt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακαλούμε εισάγετε το όνομα και, αν είναι δυνατόν, την ποσότητα των τροφίμων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter the name and, if known, the quantity of the food."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter the name and, if known, the quantity of the food."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter the name and, if known, the quantity of the food."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter the name and, if known, the quantity of the food."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, ingrese el nombre del alimento y, si es posible, la cantidad."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, ingrese el nombre del alimento y, si es posible, la cantidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna ruoan nimi ja, jos mahdollista, myös määrä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez saisir le nom de l'aliment et, si possible, la quantité."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez saisir le nom de l'aliment et, si possible, la quantité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખોરાકની ઓળખાણ અને જો શક્ય હોય તો, જથ્થાની માહિતી દાખલ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא הזן את שם המזון ואת הכמות, אם ידוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया भोजन के नाम और यदि संभव हो तो मात्रा दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite naziv i, ako znate, količinu hrane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, a termék nevét és, ha tudod, a mennyiséget is írd be."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nama makanan dan, jika memungkinkan, juga jumlahnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il nome e, se possibile, anche la quantità del cibo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品名と、分かれば量も入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식 이름과, 알면 분량을 입력해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाद्यपदार्थाचे नाव आणि शक्य असल्यास त्याचे प्रमाण लिहा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan nama dan, jika mungkin, kuantiti makanan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul het voedsel en, indien mogelijk, de hoeveelheid in."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn navnet på maten, samt mengden hvis du vet det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź nazwę produktu oraz, jeśli to możliwe, również jego ilość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira o nome do alimento e, se possível, a quantidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira o nome do alimento e, se possível, a quantidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți numele alimentului și, dacă este posibil, și cantitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите название продукта и, если возможно, количество."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte názov potravy a, ak viete, aj množstvo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite ime hrane in, če je znano, tudi količino."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange matens namn och, om möjligt, mängden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவுப் பொருளின் பெயர் மற்றும், தெரிந்தால் அளவையும் உள்ளிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆహార పేరు మరియు మీకు తెలిస్తే పరిమాణాన్ని నమోదు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาใส่ชื่ออาหาร และถ้าทราบ ให้ใส่ปริมาณด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yiyeceğin adını ve mümkünse miktarını girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть назву продукту та, якщо можливо, кількість."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng nhập tên và, nếu biết, lượng của thực phẩm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入食物名称，如果知道的话，也请输入数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
