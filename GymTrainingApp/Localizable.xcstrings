    "domain_catalog.a02090ea0171": {
      "comment": "GymTrainingApp/Domain/CoachModels.swift:460\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "السجل المرسل إلى الذكاء الاصطناعي كبير جدًا. الرجاء جمع المزيد من السجلات والمحاولة مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historial enviat a AI és massa gran. Recolliu més registres i torneu-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie pro odeslání do AI je příliš velká. Zkuste to znovu po další agregaci záznamů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-historikken er for stor. Prøv igen efter at have samlet flere data."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufzeichnungsverlauf für die KI ist zu groß. Versuchen Sie es nach dem Zusammenfassen erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ιστορικό που στέλνεται στην τεχνητή νοημοσύνη είναι πολύ μεγάλο. Παρακαλούμε προσπαθήστε ξανά αφού συγκεντρώσετε περισσότερες πληροφορίες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The history of sending to AI is too large. Please try again after further aggregation."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The history of sending to AI is too large. Please try again after further aggregation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The history of sending to AI is too large. Please try again after further aggregation."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The history of sending to AI is too large. Please try again after further aggregation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial enviado a la IA es demasiado grande. Inténtalo nuevamente después de agregar más registros."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial enviado a la IA es demasiado grande. Inténtalo nuevamente después de agregar más registros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI:lle lähetetty historia on liian suuri. Yritä uudelleen, kun olet yhdistänyt tallenteet."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le historique envoyé à l'IA est trop important. Veuillez réessayer après avoir consolidé davantage les données."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le historique envoyé à l'IA est trop important. Veuillez réessayer après avoir consolidé davantage les données."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ને મોકલવામાં આવેલી હિસ્ટ્રી વધારે છે. વધુ રેકોર્ડ એકત્રિત કર્યા પછી ફરી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההיסטוריה ששלחת ל-AI גדולה מדי. אנא נסה שוב לאחר איסוף הקלטות נוספות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI को भेजने के लिए इतिहास बहुत बड़ा है। रिकॉर्ड को और एकत्रित करके फिर से प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše je podataka za slanje u AI. Pokušajte ponovno nakon što se podaci još jednom agregiraju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl sok adat van az AI-nak küldött előzményekben. Kérjük, gyűssük össze a rekordokat újra, majd próbáld meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat yang dikirim ke AI terlalu besar. Silakan coba lagi setelah mengumpulkan catatan lebih lanjut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia inviata all'IA è troppo lunga. Riprova dopo aver aggregato i dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIへ送る履歴が大きすぎます。記録をさらに集計してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI로 전송된 기록이 너무 큽니다. 더 많은 기록을 수집한 후 다시 시도해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ला पाठवलेला इतिहास खूप मोठा आहे. अधिक नोंदी जमा करून पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sejarah yang dikirim kepada AI terlalu besar. Sila cuba semula selepas mengumpul rekod lebih lanjut."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aantal historische gegevens voor de AI is te groot. Probeer het opnieuw nadat je de gegevens verder hebt geanalyseerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Historikken sendt til AI er for stor. Prøv igjen etter å ha samlet inn flere data."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia wysyłana do AI jest zbyt duża. Spróbuj ponownie po zebraniu dodatkowych danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico enviado para a IA é muito grande. Tente novamente após agregar mais registros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico enviado para a IA é muito grande. Tente novamente após agregar mais registros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul trimis către AI este prea mare. Încearcă din nou după ce ai agregat mai multe înregistrări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История отправки в ИИ слишком велика. Пожалуйста, повторите попытку после дальнейшего сбора данных."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Historické záznamy pre AI sú príliš veľké. Skúste to znovu po zhromaždení ďalších údajov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisov je preveč za poslanje AI. Poskusite znova po dodatnem seštevanju podatkov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många historier har skickats till AI. Försök igen efter att ha sammanställt resultaten ytterligare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI க்கு அனுப்பப்பட்ட வரலாறு மிகவும் பெரியது. மேலும் தரவுகளை சேகரித்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AIకి పంపిన చరిత్ర చాలా పెద్దది. మరింత సమాచారం సేకరించి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประวัติการส่งไปยัง AI มีขนาดใหญ่เกินไป กรุณาบันทึกเพิ่มเติมแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI'ye gönderilen geçmiş çok uzun. Daha fazla veri toplayıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто багато історії, яку потрібно надіслати до AI. Спробуйте ще раз після подальшого збору даних."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử gửi cho AI quá lớn. Vui lòng tổng hợp lại và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI发送的历史记录过大。请先进一步汇总，再尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI傳送的歷史記錄過多。請先進行更詳細的彙總後再嘗試。"
          }
        }
      }
    },
