    "health_meals_body_ai.776a04d597c7": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:241\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه خطة تأكيد مصممة خصيصًا لأهدافك والمعدات المتاحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest és un pla de confirmació adaptat als vostres objectius i a l'equip disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plán přizpůsobený vašemu cíli a dostupnému vybavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et plan, der er skræddersyet til dit mål og de tilgængelige redskaber."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Plan, der auf Ihrem Ziel und den verfügbaren Geräten basiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόγραμμα ελέγχου προσαρμοσμένο στον στόχο και τον εξοπλισμό που μπορείτε να χρησιμοποιήσετε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A plan tailored to your goals and available equipment."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A plan tailored to your goals and available equipment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A plan tailored to your goals and available equipment."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A plan tailored to your goals and available equipment."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan personalizado según tu objetivo y los equipos disponibles."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan personalizado según tu objetivo y los equipos disponibles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on suunnitelma, joka perustuu tavoitteeseen ja käytettävissä oleviin laitteisiin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plan est adapté à votre objectif et aux équipements disponibles."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce plan est adapté à votre objectif et aux équipements disponibles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તમારા ધ્યેય અને ઉપલબ્ધ સાધનો સાથે સુસંગત યોજના છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוכנית בדיקה בהתאם ליעד ולציוד הזמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लक्ष्य और उपलब्ध उपकरणों के अनुरूप एक योजना है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan prilagođen vašem cilju i dostupnom opremu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy személyre szabott terv, amely az adott cél és a rendelkezésre álló edzőfelszerelésekhez igazodik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah rencana verifikasi yang sesuai dengan target dan peralatan yang tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un piano personalizzato in base al tuo obiettivo e alle attrezzature disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標と利用できる器具に合わせた確認用プランです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표와 사용할 수 있는 장비에 맞는 확인용 계획입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे तुमच्या लक्ष्यानुसार आणि उपलब्ध उपकरणांनुसार तयार केलेले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah rencana untuk semak yang sesuai dengan matlamat dan peralatan yang tersedia."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een gepersonaliseerd plan op basis van uw doel en beschikbare apparatuur."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en tilpasset plan basert på målet ditt og de tilgjengelige treningsutstyrene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan dostosowany do Twojego celu i dostępnego sprzętu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um plano para verificar com base no seu objetivo e nos equipamentos disponíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um plano para verificar com base no seu objetivo e nos equipamentos disponíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un plan de verificare adaptat obiectivului și echipamentelor disponibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План, разработанный с учетом вашей цели и доступного оборудования."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Plán špecifický pre vaše ciele a dostupné vybavenie."
