          "stringUnit": {
            "state": "translated",
            "value": "Neexistuje žádný jasný návrh pro zastavení u cviků, které byly zaznamenány více než 3krát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen klare forslag til stagnation for øvelser, der er registreret 3 gange eller flere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine eindeutigen Stagnationsmöglichkeiten für Übungen, die mehr als 3 Mal erfasst wurden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν σαφείς προτάσεις παύσης για τα είδη που έχουν καταγραφεί 3 φορές ή περισσότερες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no clear stagnation candidates for exercises recorded more than 3 times."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no clear stagnation candidates for exercises recorded more than 3 times."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no clear stagnation candidates for exercises recorded more than 3 times."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no clear stagnation candidates for exercises recorded more than 3 times."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay candidatos claros para detenerse en los ejercicios que se han registrado más de 3 veces."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay candidatos claros para detenerse en los ejercicios que se han registrado más de 3 veces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ole selkeää pysähdysvaihtoehtoa harjoituksiin, joita on kirjattu yli 3 kertaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas d'arrêt clair pour les exercices enregistrés au moins 3 fois."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas d'arrêt clair pour les exercices enregistrés au moins 3 fois."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જે કસરતો 3 વારથી વધુ વખત નોંધાયેલ છે, તેમાં કોઈ સ્પષ્ટ અવરોધ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תרגילים שהוקלטו יותר מ-3 פעמים, כך שאין אפשרות ברורה להשהיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसे अभ्यासों में स्पष्ट रूप से कोई रुकावट नहीं है जिन्हें 3 या अधिक बार दर्ज किया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne postoji jasna točka stagnacije za vježbe koje su zabilježene više od 3 puta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs egyértelmű lelassulási lehetőség a 3 alkalomnál többet rögzített edzések esetében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada opsi berhenti yang jelas untuk item yang tercatat lebih dari 3 kali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono opzioni chiare per rimanere fermi in nessuno degli esercizi registrati più di 3 volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3回以上記録された種目に明確な停滞候補はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3회 이상 기록된 운동에는 명확한 정체 구간이 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ज्या व्यायामांची 3 किंवा अधिक वेळा नोंद आहे, त्यांच्यासाठी कोणताही निश्चित पर्याय नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada senaman yang telah direkodkan lebih daripada 3 kali, jadi tidak ada pilihan yang jelas untuk berhenti."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen duidelijke stagnatie-opties voor oefeningen die meer dan 3 keer zijn geregistreerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingen klare stagnasjonsforslag for øvelser som er registrert 3 eller flere ganger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma wyraźnych punktów stagnacji dla ćwiczeń, które zostały zarejestrowane co najmniej 3 razy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há opções claras de pausa para exercícios registrados mais de 3 vezes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há opções claras de pausa para exercícios registrados mais de 3 vezes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există exerciții în care a fost înregistrat de cel puțin 3 ori."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет четких вариантов для остановки, если упражнение было записано более 3 раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre žiadny z cvikov, ktoré boli zaznamenané viac ako 3-krát, neexistuje jasná možnosť zastavenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za te, ki so zabeležene več kot 3krat, ni jasne možnosti zamrznitve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga tydliga stagnationstillfällen för övningar som har registrerats 3 gånger eller fler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "3 முறைக்கு மேல் பதிவு செய்யப்பட்ட பயிற்சிகளில், தெளிவான முன்னேற்றத்திற்கான வாய்ப்புகள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "3 సార్లు లేదా అంతకంటే ఎక్కువ నమోదు చేసిన వ్యాయామాలకు స్పష్టమైన ఆగిపోయే అవకాశం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการที่บันทึกมากกว่า 3 ครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 veya daha fazla kez kaydedilmiş egzersizlerde belirgin bir ilerleme yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає чітких варіантів зупинки для вправ, які були записані 3 або більше разів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bài tập nào được ghi lại hơn 3 lần, nên không có lựa chọn thay thế rõ ràng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经记录了3次以上的运动，没有明显的停滞点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於超過3次的運動，沒有明顯的停滯點。"
          }
        }
      }
    },
