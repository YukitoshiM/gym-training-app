            "value": "திட்டம் இல்லாமல், ஒரு வகையைச் சேர்த்துப் பதிவு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏ ప్రణాళిక లేకుండా క్రీడలను జోడించి రికార్డ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มประเภทและบันทึกโดยไม่มีแผน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlama olmadan egzersiz türlerini ekleyip kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте вид діяльності та записуйте його без плану."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm môn thể thao và ghi chú mà không có kế hoạch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在没有计划的情况下添加项目并记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在沒有計畫的情況下新增運動項目並記錄"
          }
        }
      }
    },
