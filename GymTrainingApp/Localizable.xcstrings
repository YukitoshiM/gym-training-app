    "domain_catalog.f34feca2145c": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:231\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دعونا نجعلها في الشكل الذي سوف يستمر غدا أيضا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fem-ne una forma que també duri demà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že to bude fungovat i zítra"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at det fortsætter i morgen"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestalten Sie den Tag so, dass er auch morgen weitergeht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάστε έτσι ώστε να συνεχίσετε αύριο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's set it up so that it continues tomorrow"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's set it up so that it continues tomorrow"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's set it up so that it continues tomorrow"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's set it up so that it continues tomorrow"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegurémonos de que continúe así mañana."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegurémonos de que continúe así mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, että voit jatkaa huomenna"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisons-nous pour que cela continue demain aussi."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisons-nous pour que cela continue demain aussi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગળ પણ ચાલુ રાખવાની રીત બનાવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בואו נסדירו את זה כך שזה ימשיך גם מחר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे कल भी जारी रखने के लिए व्यवस्थित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Osigurajmo da se sve nastavi i sutra"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tervezzük meg úgy, hogy ez a nap is sikeres legyen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mari atur agar tetap berlanjut besok"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizziamoci per continuare anche domani"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日も続く形に整えましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일도 지속 가능한 형태로 관리합시다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उद्याच्या दिवसासाठी योग्य तयारी करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mari kita atur agar terus bermaya hingga esok"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat het morgen weer kan"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "La oss sørge for at vi fortsetter i morgen også"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbajmy o to, aby wszystko dobrze się skończyło"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare-se para continuar amanhã"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare-se para continuar amanhã"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigurăm că totul continuă să funcționeze bine mâine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте так, чтобы прогресс продолжался и завтра."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uistite sa, že to bude fungovať aj zajtra"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripravimo se na jutrišnjo aktivnost"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att det fortsätter imorgon"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நாளைக்கு ஏற்றவாறு மாற்றியமைக்கலாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రేపటికీ కొనసాగేలా చూసుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้กิจกรรมประจำวันเป็นไปอย่างต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarın da devam edecek şekilde ayarlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Давайте підготуємось до продовження завтра"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy điều chỉnh để duy trì tiến độ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让一切都朝着明天继续发展"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓明天也能持續"
          }
