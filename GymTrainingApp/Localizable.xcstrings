    "health_meals_body_ai.7bd42e67d0fc": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:328\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو المرشح الذي لم يزد الحد الأقصى لوزن استخدامه في المرات الثلاث الأخيرة. يرجى أيضًا مراعاة النموذج وعدد المرات وRPE."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es tracta d'un candidat el pes màxim d'ús del qual no ha augmentat en les últimes tres vegades. Tingueu en compte també la forma, el nombre de vegades i RPE."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá se, že v posledních 3 trénincích nepozorujete výrazný nárůst maximální váhy. Zvažte také vaši techniku, počet opakování a subjektivní hodnocení (RPE)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er muligvis ikke i stand til at øge din maksimale vægt yderligere inden for de sidste 3 træninger. Vurder også din form, antal gentagelser og RPE (Rate of Perceived Exertion)."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt Kandidaten, bei denen das maximale Gewicht in den letzten 3 Trainingseinheiten nicht gestiegen ist. Bitte berücksichtigen Sie auch Form, Anzahl der Wiederholungen und RPE (Rate of Perceived Exertion)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τελευταίες 3 προπονήσεις δείχνουν ότι το μέγιστο βάρος που χρησιμοποιείτε δεν έχει αυξηθεί. Λάβετε υπόψη το στυλ, τον αριθμό επαναλήψεων και την υποκειμενική κλίμακα δυσκολίας (RPE)."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You may be approaching a point where your maximum weight lifted has plateaued. Please consider your form, repetitions, and RPE when making this assessment."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You may be approaching a point where your maximum weight lifted has plateaued. Please consider your form, repetitions, and RPE when making this assessment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You may be approaching a point where your maximum weight lifted has plateaued. Please consider your form, repetitions, and RPE when making this assessment."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You may be approaching a point where your maximum weight lifted has plateaued. Please consider your form, repetitions, and RPE when making this assessment."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que tu mayor peso máximo ha aumentado en las últimas 3 sesiones. Considera también la forma, el número de repeticiones y la escala de percepción del esfuerzo (RPE)."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que tu mayor peso máximo ha aumentado en las últimas 3 sesiones. Considera también la forma, el número de repeticiones y la escala de percepción del esfuerzo (RPE)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahdollisesti maksimipaino ei ole kasvanut viimeisillä treeneillä. Arvioi myös tekniikkaa, toistoja ja RPE-arvoa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble que votre poids maximal utilisé n'ait pas augmenté ces dernières fois. Veuillez également prendre en compte votre forme, le nombre de répétitions et votre niveau d'effort perçu (RPE)."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble que votre poids maximal utilisé n'ait pas augmenté ces dernières fois. Veuillez également prendre en compte votre forme, le nombre de répétitions et votre niveau d'effort perçu (RPE)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા 3 વખતનો મહત્તમ વજન વધારો નથી. ફોર્મ, સંખ્યા અને RPE પણ ધ્યાનમાં લો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שמשקל השימוש המקסימלי שלך לא גדל בחמישה האימונים האחרונים. אנא השווה גם את הטכניקה, מספר החזרות ורמת העומס (RPE)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 3 बार में अधिकतम उपयोग की गई वजन में वृद्धि नहीं हुई है। कृपया फॉर्म, संख्या और RPE को भी ध्यान में रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgleda da se maksimalna težina koju koristite nije povećala u posljednje 3 treninga. Razmislite o svojoj tehnici, broju repeticija i subjektivnoj ocjeni napor (RPE)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi 3 edzésben nem növekedett a maximális súly, ezért kérlek, figyeld meg a formádat, a számokat és a subjektív erőnléti értéket is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemungkinan besar, beban maksimal yang digunakan dalam 3 sesi terakhir belum meningkat. Pertimbangkan juga aspek postur, jumlah repetisi, dan skala persepsi usaha (RPE)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere un candidato in cui il peso massimo utilizzato negli ultimi 3 allenamenti non è aumentato. Considera anche la forma, il numero di ripetizioni e l'RPE (percezione dello sforzo)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近3回で最大使用重量が伸びていない候補です。フォーム、回数、RPEも合わせて判断してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 3회 동안 최대 사용 중량을 늘리지 않은 후보입니다. 자세, 횟수, RPE도 함께 고려해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील ३ सत्रांमध्ये जास्तीत जास्त वापरलेली वजन वाढलेले नाही, त्यामुळे फॉर्म, संख्या आणि RPE (रेटेड पेक्षा) यानुसार तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mungkin merupakan calon di mana berat maksimum yang digunakan telah meningkat dalam 3 kali terakhir. Sila pertimbangkan bentuk, jumlah, dan RPE juga."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lijkt erop dat u recentelijk niet significant meer gewicht hebt kunnen tillen. Beoordeel dit op basis van uw vorm, aantal herhalingen en RPE (Rate of Perceived Exertion)."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er en av kandidatene som ikke har økt maksimal vektbruk de siste 3 gangene. Vurder form, antall repetisjoner og RPE (Rate of Perceived Exertion) også."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potencjalne zwiększenie maksymalnej wagi w ostatnich 3 treningach. Proszę również uwzględnić formę, liczbę powtórzeń i subiektywną ocenę wysiłku (RPE)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que o peso máximo utilizado nos últimos 3 treinos não aumentou. Considere também a forma, número de repetições e escala de percepção de esforço (RPE)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que o peso máximo utilizado nos últimos 3 treinos não aumentou. Considere também a forma, número de repetições e escala de percepção de esforço (RPE)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare că nu ați reușit să creșteți semnificativ greutatea maximă utilizată în ultimele 3 sesiuni. Vă rugăm să luați în considerare forma, numărul de repetări și nivelul de efort (RPE) atunci când faceți acest lucru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В последних трех тренировках вес, который вы поднимаете, не увеличился. Также учитывайте форму, количество повторений и субъективную оценку нагрузки (RPE)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je možné, že vaše maximálne zaťaženie v posledných 3 tréningoch neporostlo. Zvážte aj svoj typ vykonávania, počet opakovaní a subjektívne hodnotenie námahy (RPE)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgleda, da se največji izračunani teži v zadnjih 3 treningih niso povečali. Upoštevajte tudi svojo formo, število ponovitev in subjektivno ocenjevanje (RPE)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verkar ha en potentiell ökning av det maximala vikten du lyfter under de senaste 3 gångerna. Bedöm även form, antal repetitioner och RPE (Rate of Perceived Exertion)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த 3 முறை, அதிகபட்ச பயன்பாட்டு எடை அதிகரிக்கவில்லை என்று தெரிகிறது. சரியான வடிவம், எண்ணிக்கை மற்றும் RPE ஆகியவற்றையும் கருத்தில் கொள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత 3 సార్లు, గరిష్టంగా ఉపయోగించిన బరువు పెరగడం లేదు. ఫారం, సంఖ్య మరియు RPE (వ్యాయామ తీవ్రత) కూడా పరిగణనలోకి తీసుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนว่าน้ำหนักสูงสุดที่คุณยกใน 3 ครั้งล่าสุดไม่ได้เพิ่มขึ้น โปรดพิจารณาจากรูปแบบ, จำนวนครั้ง และระดับความรู้สึกเมื่อออกกำลังกาย (RPE) ด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 3 antrenmanda maksimum ağırlıkta artış olmamaktadır. Form, tekrar sayısı ve RPE değerlerini de göz önünde bulundurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З останніх трьох тренувань не було помітно збільшення максимального ваги. Також врахуйте форму, кількість повторень та рівень відчуття навантаження (RPE)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có khả năng tăng trọng lượng tối đa trong 3 lần tập gần đây. Vui lòng đánh giá thêm về tư thế, số lần lặp lại và mức độ gắng sức (RPE)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近3次最大使用重量没有增加的候选。请同时考虑姿势、次数和RPE。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 3 次的最大使用重量沒有增加，請結合姿勢、次數和 RPE 來判斷。"
          }
        }
      }
    },
