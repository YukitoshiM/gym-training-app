    "health_meals_body_ai.abbfa3552a40": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift:568\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم API يستجيب، لكن النموذج المطلوب غير متوفر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor API respon, però el model requerit no està disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server API reaguje, ale nemůžete použít potřebný model."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "API-serveren svarer, men den nødvendige model kan ikke bruges."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Server antwortet, aber das benötigte Modell ist nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής API απαντά, αλλά δεν μπορεί να χρησιμοποιήσει το απαιτούμενο μοντέλο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the required model."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the required model."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the required model."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the required model."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de API responde, pero no puede utilizar el modelo necesario."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de API responde, pero no puede utilizar el modelo necesario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "API-palvelin vastaa, mutta tarvittavia malleja ei ole käytettävissä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur API répond, mais le modèle requis n'est pas disponible."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur API répond, mais le modèle requis n'est pas disponible."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "API સર્વર પ્રતિસાદ આપી રહ્યું છે, પરંતુ જરૂરી મોડેલ ઉપલબ્ધ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת ה-API מגיב, אך אי אפשר להשתמש במודל הדרוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API सर्वर प्रतिक्रिया दे रहा है, लेकिन आवश्यक मॉडल उपलब्ध नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Server API odgovara, ali ne može koristiti potrebne modele."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az API szerver válaszol, de a szükséges model nem elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server API merespons, tetapi tidak dapat menggunakan model yang diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server API risponde, ma non è possibile utilizzare il modello richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIサーバーは応答していますが、必要なモデルを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 서버는 응답하지만, 필요한 모델을 사용할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "API सर्व्हर प्रतिसाद देत आहे, परंतु आवश्यक असलेले मॉडेल उपलब्ध नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan API berfungsi, tetapi tidak dapat menggunakan model yang diperlukan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De API-server reageert, maar het benodigde model kan niet worden gebruikt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "API-serveren svarer, men du kan ikke bruke nødvendige modeller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer API odpowiada, ale nie można wykorzystać wymaganych modeli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor API está respondendo, mas não consegue utilizar o modelo necessário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor API está respondendo, mas não consegue utilizar o modelo necessário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul API răspunde, dar nu poate utiliza modelul necesar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-сервер отвечает, но недоступны необходимые модели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "API server odpovedá, ale nemôžete použiť požadovaný model."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streznik API je na voljo, vendar ne morete uporabiti zahtevanega modela."
