        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להביא את הזרוע לקיר בצורה מקבילה ולהרחיב רק את החלק האחורי של המרפק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी बांह को फर्श के समानांतर लाएं, और केवल अपनी कलाई और हाथ को पीछे की ओर फैलाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilazite nadlaktice pod kutom s podom i istežite samo dijelove ruke prema nazad."
          }
        },
        "hu": {
          "stringUnit": {
