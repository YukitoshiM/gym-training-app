    "training.4ec785b46677": {
      "comment": "GymTrainingApp/Features/Exercises/ExerciseListView.swift:48\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تسجيل الأحداث المخصصة من زر الإضافة في أعلى اليمين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu registrar esdeveniments personalitzats des del botó Afegeix a la part superior dreta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete přidat vlastní typ cvičení z tlačítka v pravém horním rohu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan tilføje en brugerdefineret kategori fra knappen øverst til højre."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können benutzerdefinierte Übungen über den Button \"Hinzufügen\" oben rechts hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να προσθέσετε μια προσαρμοσμένη κατηγορία πατώντας το κουμπί \"Πρόσθεσε\" στην δεξιά πλευρά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add custom categories from the \"Add\" button in the top right."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add custom categories from the \"Add\" button in the top right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add custom categories from the \"Add\" button in the top right."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add custom categories from the \"Add\" button in the top right."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede registrar un nuevo tipo de ejercicio desde el botón \"Añadir\" en la esquina superior derecha."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede registrar un nuevo tipo de ejercicio desde el botón \"Añadir\" en la esquina superior derecha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit lisätä mukautettuja harjoituksia oikeassa yläkulmassa olevasta painikkeesta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez enregistrer des exercices personnalisés à partir du bouton \"Ajouter\" en haut à droite."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez enregistrer des exercices personnalisés à partir du bouton \"Ajouter\" en haut à droite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જમણા ઉપરના \"વધારા\" બટન પરથી તમે કસ્ટમ પ્રકાર ઉમેરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להוסיף סוג אימון מותאם אישית באמצעות הכפתור הנוסף בצד ימין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दाएं ओर के \"जोड़ें\" बटन से आप कस्टम प्रकार दर्ज कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete dodati prilagođenu kategoriju klikom na gumb \"Dodaj\" u gornjem desnom kutu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jobb oldalon található \"Hozzáadás\" gomb segítségével létrehozhat személyre szabott edzéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menambahkan kategori khusus dari tombol \"Tambah\" di pojok kanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile aggiungere un nuovo tipo di esercizio dal pulsante \"Aggiungi\" in alto a destra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の追加ボタンからカスタム種目を登録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 상단의 추가 버튼을 통해 사용자 정의 항목을 등록할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उजव्या बाजूच्या 'ॲड' बटणावर क्लिक करून तुम्ही कस्टम प्रकार नोंदवू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menambah jenis latihan khusus daripada butang \"Tambah\" di bahagian atas kanan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "U kunt een eigen categorie toevoegen via de knop bovenaan rechts."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan legge til egne treningsøkter fra knappen øverst til høyre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można dodać niestandardową kategorię, klikając przycisk \"Dodaj\" w prawym górnym rogu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode adicionar um novo tipo de exercício clicando no botão \"Adicionar\" no canto superior direito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode adicionar um novo tipo de exercício clicando no botão \"Adicionar\" no canto superior direito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți adăuga tipuri personalizate prin butonul \"Adaugă\" din colțul din dreapta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете добавить пользовательский вид активности, нажав кнопку \"Добавить\" в правом верхнем углу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Z tlačidla \"Pridať\" v pravom hornom rohu môžete pridať vlastné typy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte lahko prilagojeno aktivnost z gumbom na desni strani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lägga till anpassade övningar från knappen högst upp till vänster."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வலது பக்கத்தில் உள்ள \"கூடுதல்\" பொத்தானிலிருந்து, நீங்கள் விரும்பும் உடற்பயிற்சிகளைச் சேர்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుడివైపున ఉన్న \"జోడించు\" బటన్ నుండి మీరు అనుకూల రకాన్ని నమోదు చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเพิ่มประเภทการออกกำลังกายแบบกำหนดเองได้จากปุ่ม \"เพิ่ม\" ทางด้านขวา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağ üstteki \"Ekle\" düğmesinden özel egzersizleri kaydedebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете додати власні види активності, натиснувши кнопку \"Додати\" у верхньому правому куті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể thêm danh mục tùy chỉnh từ nút \"Thêm\" ở góc trên bên phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以通过右上角的“添加”按钮来注册自定义运动项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右上方新增按鈕可新增自訂項目。"
          }
        }
      }
    },
