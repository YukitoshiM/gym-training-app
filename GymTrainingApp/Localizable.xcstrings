        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De schattingen zijn ter informatie. U kunt deze in het onderstaande veld zelf aanpassen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimert verdi er kun en veiledning. Du kan fritt justere verdien i det nederste feltet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowane wartości są orientacyjne. Możesz dowolnie je edytować w niżej sekcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores estimados são apenas referências. Você pode ajustá-los livremente na caixa abaixo."
