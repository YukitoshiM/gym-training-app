    "domain_catalog.6e6324cfc621": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:483\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتحقق من وزنك فحسب، بل تحقق أيضًا من محيط الخصر وسجلات الطعام. حتى لو ظل وزنك كما هو، إذا كان محيط خصرك يتناقص، فأنت تحرز تقدمًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comproveu no només el vostre pes, sinó també la circumferència de la cintura i els registres dels aliments. Fins i tot si el teu pes es manté igual, si la teva circumferència de cintura està disminuint, estàs avançant."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte nejen svou hmotnost, ale i obvod pasu a zaznamenávejte stravu. Pokud se i při stabilní hmotnosti sníží obvod pasu, znamená to pokrok."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se din vægt sammen med din taljelængde og kostregistrering. Selv hvis din taljelængde falder, er der stadig fremskridt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beachten Sie nicht nur Ihr Gewicht, sondern auch Ihren Bauchumfang und Ihre Ernährung. Wenn der Bauchumfang trotz eines stabilen Gewichts sinkt, handelt es sich um Fortschritte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε το βάρος σας μαζί με την περιφέρεια του κορμού και τις σημειώσεις για τη διατροφή σας. Ακόμα κι αν η περιφέρεια του κορμού σας μειώνεται, αυτό σημαίνει πρόοδο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at your weight, waist circumference, and dietary record together. Even if your weight remains the same, if your waist circumference is decreasing, it means progress."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at your weight, waist circumference, and dietary record together. Even if your weight remains the same, if your waist circumference is decreasing, it means progress."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at your weight, waist circumference, and dietary record together. Even if your weight remains the same, if your waist circumference is decreasing, it means progress."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at your weight, waist circumference, and dietary record together. Even if your weight remains the same, if your waist circumference is decreasing, it means progress."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Considera tanto tu peso como la circunferencia abdominal y registra tus comidas. Incluso si tu circunferencia abdominal disminuye, indica progreso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Considera tanto tu peso como la circunferencia abdominal y registra tus comidas. Incluso si tu circunferencia abdominal disminuye, indica progreso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastele paitsi painoa myös vatsanympärystä ja ruokapäiväkirjaa yhdessä. Jos vatsanympärys pienenee, vaikka paino pysyisi samana, on edistystä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser votre poids, votre tour de taille et vos données alimentaires. Même si votre tour de taille diminue, cela indique une progression."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser votre poids, votre tour de taille et vos données alimentaires. Même si votre tour de taille diminue, cela indique une progression."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન ઉપરાંત પેટની પરિમિતિ અને આહારનો રેકોર્ડ પણ જુઓ. જો પેટની પરિમિતિ ઘટી રહી હોય તો, તે એક પ્રગતિ છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את המשקל, היקף המותניים והרשמי מזון ביחד. גם אם ההיקף נשאר זהה, עדיין יש התקדמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल अपने वजन के अलावा, पेट के घेरे और भोजन के रिकॉर्ड को भी देखें। यदि पेट का घेरा स्थिर है, लेकिन कम हो रहा है, तो इसका मतलब है कि प्रगति हो रही है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte svoju težinu, mjere struja i zapis o prehrani zajedno. Ako su mjere struja smanjene, čak i ako je težina ostala ista, to znači napredak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg a testsúlyt, a mellszövet körfogását és az étkezési naplót együtt. Ha a körfogad csökken, akkor már haladsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berat badan, lingkar pinggang, dan rekam makanan bersama-sama. Jika lingkar pinggang turun meskipun berat badan stabil, berarti ada kemajuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Considerare il peso, la circonferenza vita e le informazioni sull'alimentazione insieme. Anche se la circonferenza vita diminuisce, si può considerare un progresso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重だけでなく腹囲と食事記録を合わせて見ます。横ばいでも腹囲が落ちていれば進捗ありです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸무게뿐만 아니라 허리둘레와 식단 기록을 함께 확인합니다. 수평으로 유지되더라도 허리둘레가 줄어들면 진행 상황이 있다는 의미입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजनासोबतच कंबर आणि आहाराच्या नोंदीचाही विचार करा. जर कंबरेमध्ये बदल झाला असेल, तर थोडीफार प्रगती दर्शवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berat badan bersama dengan sekeliling pinggang dan rekod makanan. Jika sekeliling pinggang berkurang walaupun jika berat badan kekal, itu bermakna kemajuan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je gewicht, tailleomtrek en eetdagboek samen. Zelfs als je gewicht gelijk blijft, maar je tailleomtrek afneemt, betekent dit al een vooruitgang."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på vekt, rundt midjen og matregistrering sammen. Selv om det er flatt, betyr det fremgang hvis rundt midjen går ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź wagę, obwód talii oraz zapisy dotyczące diety. Nawet jeśli waga pozostaje stała, a obwód talii maleje, oznacza to postęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte seu peso, circunferência abdominal e registros alimentares juntos. Mesmo que esteja estável, se a circunferência abdominal estiver diminuindo, há progresso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte seu peso, circunferência abdominal e registros alimentares juntos. Mesmo que esteja estável, se a circunferência abdominal estiver diminuindo, há progresso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi greutatea, circumferința taliei și înregistrează-ți alimentația împreună. Chiar dacă circumferința taliei scade, este un progres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите свой вес, а также обхват талии и записывайте свои приемы пищи. Даже если вес остается прежним, но обхват талии уменьшается, это говорит о прогрессе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite si nielen svoju hmotnosť, ale aj obvod pása a zaznamenané stravovanie. Ak sa obvod pása zníži aj pri stabilnej hmotnosti, znamená to pokrok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledate svojo težo, obodnico in tudi zapis prehrane. Čeprav je obodnica konstantna, če pade, je to napredek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se din vikt tillsammans med ditt midjemått och matdagbok. Även om midjemåttet sjunker är det en framgång."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடல் எடையுடன், இடுப்பு சுற்றளவையும், உணவுப் பழக்கத்தையும் சேர்த்துப் பார்க்கவும். உடல் எடை மாறா இருந்தாலும், இடுப்பு சுற்றளவில் மாற்றம் ஏற்பட்டால், அது முன்னேற்றத்தைக் குறிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువుతో పాటు కడుపు చుట్టుకొలత మరియు ఆహార రికార్డును కూడా చూడండి. కడుపు చుట్టుకొలత తగ్గితే, అది ఒక ప్రగతి అని అర్థం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูน้ำหนัก, รอบเอว, และบันทึกอาหารควบคู่กัน หากรอบเอวลดลง แม้ว่าน้ำหนักจะไม่เปลี่ยนแปลง ก็ยังถือว่าเป็นความก้าวหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece kiloyu değil, aynı zamanda karın çevresini ve beslenme kaydını birlikte değerlendirin. Karın çevresinde düşüş olsa bile, ilerleme kaydedildiğini gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте свою вагу разом з обхватом талії та записом про харчування. Навіть якщо обхват талії зменшується, це свідчить про прогрес."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem xét cả cân nặng, vòng bụng và nhật ký ăn uống. Ngay cả khi cân nặng không thay đổi, nhưng vòng bụng giảm thì vẫn là tiến bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不仅关注体重，还结合腹围和饮食记录进行评估。即使腹围没有变化，只要有下降趋势，就说明有所进展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不僅觀察體重，還結合腹圍和飲食記錄。即使腹圍沒有變化，只要有下降，就表示有所進展。"
          }
        }
      }
    },
