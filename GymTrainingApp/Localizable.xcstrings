    "health_meals_body_ai.16d5fbaa5425": {
      "comment": "GymTrainingApp/Features/Meals/MealListView.swift:839\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف تشغيل وظيفة الذكاء الاصطناعي في الإعدادات. يمكن حفظ الإدخال اليدوي كما هو."
