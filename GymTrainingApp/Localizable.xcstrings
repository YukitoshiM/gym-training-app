    "health_meals_body_ai.505ff00fae7c": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:359\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم التقاط الصور في ظروف مشابهة لآخر مرة حتى تتمكن من مقارنة التغييرات في المظهر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotografies es faran en condicions similars a la darrera vegada perquè pugueu comparar els canvis d'aparença."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro snadnější porovnání vzhledu, pořádejte snímání za podobných podmínek jako předtím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag billeder under lignende forhold som sidste gang, så du kan sammenligne resultaterne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Veränderungen im Aussehen vergleichen zu können, machen Sie Fotos unter ähnlichen Bedingungen wie beim letzten Mal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να μπορείτε να συγκρίνετε τις αλλαγές στην εμφάνιση, τραβήξτε φωτογραφίες με παρόμοιες συνθήκες όπως την προηγούμενη φορά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To compare visible changes, shoot under similar conditions to the previous time."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "To compare visible changes, shoot under similar conditions to the previous time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To compare visible changes, shoot under similar conditions to the previous time."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "To compare visible changes, shoot under similar conditions to the previous time."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder comparar los cambios físicos, tomamos fotos bajo condiciones similares a las anteriores."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para poder comparar los cambios físicos, tomamos fotos bajo condiciones similares a las anteriores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota uudet kuvat samalla tavalla kuin edellisellä kerralla, jotta voit verrata niitä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour pouvoir comparer les changements physiques, prenez des photos dans des conditions similaires à celles de la fois précédente."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour pouvoir comparer les changements physiques, prenez des photos dans des conditions similaires à celles de la fois précédente."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે અગાઉની પરિસ્થિતિ જેવી જ શરતોમાં ફોટો લેવાથી, દેખાવામાં આવતા ફેરફારોની સરખામણી કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשוות את המראה, מצלמים בתנאים דומים לאלו מהפעם הקודמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने पिछली बार की स्थितियों के समान परिस्थितियों में तस्वीरें लीं ताकि मैं दिखावे में बदलावों की तुलना कर सकूं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimite fotografije uz slične uvjete kao prethodno, kako biste mogli uspoređivati promjene u izgledu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korábbihoz hasonló körülmények között készítjük a képeket, hogy összehasonlítható legyen a megjelenés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membandingkan perubahan penampilan, ambil foto dengan kondisi yang mirip dengan sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per poter confrontare i cambiamenti visivi, scatta le foto nelle stesse condizioni della precedente volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目の変化を比較できるよう、前回と近い条件で撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외모 변화를 비교할 수 있도록, 이전과 유사한 조건으로 촬영합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शारीरिक बदलंची तुलना करण्यासाठी, मागील वेळेप्रमाणेच परिस्थितीत छायाचित्र घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk membandingkan perubahan penampilan, ambil gambar dalam keadaan yang serupa seperti sebelumnya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Om veranderingen in uiterlijk te vergelijken, neem ik foto's onder vergelijkbare omstandigheden als de vorige keer."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bilder under lignende forhold som forrige gang, slik at du kan sammenligne endringene i utseendet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby móc porównać zmiany w wyglądzie, fotografuję w podobnych warunkach jak poprzednio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para facilitar a comparação, tire fotos nas mesmas condições da vez anterior."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para facilitar a comparação, tire fotos nas mesmas condições da vez anterior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a putea compara schimbările fizice, vom face fotografii în condiții similare cu cele anterioare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для удобства сравнения, сделайте снимки в условиях, максимально похожих на предыдущие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografujte za podmienok, ktoré sú čo najbližšie k tým, aké boli pred týždňom, aby ste mohli porovnávať vzhľad."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite primerjati spremembe v videzu, posnemo pod enakimi pogoji kot pri prejšnjem treningu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bilder under liknande förhållanden som tidigare för att kunna jämföra visuella förändringar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முந்தைய நிலையைப் போலவே, தோற்ற மாற்றங்களை ஒப்பிட்டுப் பார்க்க, ஒரே மாதிரியான சூழ்நிலையில் புகைப்படம் எடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మునుపటి పరిస్థితులకు దగ్గరగా ఉండే పరిస్థితుల్లో ఫోటో తీయడం ద్వారా, శారీరక మార్పులను పోల్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายภาพในสภาพแวดล้อมที่ใกล้เคียงกับครั้งก่อน เพื่อเปรียบเทียบการเปลี่ยนแปลงรูปลักษณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel değişiklikleri karşılaştırmak için, öncekiyle benzer koşullarda fotoğraf çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для зручного порівняння, робіть фотографії в умовах, максимально схожих на попередні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để so sánh sự thay đổi về ngoại hình, hãy chụp ảnh trong điều kiện tương tự như lần trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了比较外观变化，请在与上次相似的条件下拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會在與上次相似的條件下拍攝照片，以便比較外觀變化。"
          }
        }
      }
    },
