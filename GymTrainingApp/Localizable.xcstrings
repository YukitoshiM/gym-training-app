    "domain_catalog.59ffb3a17375": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:391\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط جسمك من حيث الأرقام والمظهر"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusteu el vostre cos tant des dels números com de l'aparença"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dbejte na zdraví z obou stran – čísel i vzhledu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få en sund krop ved at fokusere på både tal og udseende."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie Ihren Körper sowohl durch Zahlen als auch durch Ihr Aussehen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιδείξτε μια ολοκληρωμένη προσέγγιση, λαμβάνοντας υπόψη τόσο τους αριθμούς όσο και την εμφάνιση του σώματός σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve your body by considering both numbers and appearance."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve your body by considering both numbers and appearance."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve your body by considering both numbers and appearance."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Improve your body by considering both numbers and appearance."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopta un enfoque que combine números y apariencia física."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopta un enfoque que combine números y apariencia física."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoida kehoasi sekä luvun että ulkonäön perusteella"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez soin de votre corps en tenant compte à la fois des chiffres et de l'apparence."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez soin de votre corps en tenant compte à la fois des chiffres et de l'apparence."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંખ્યા અને દેખાવ બંનેથી શરીરને વ્યવસ્થિત કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתאים את הגוף הן מבחינה מספרית והן מבחינת מראה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संख्या और दिखावट दोनों से अपने शरीर को बेहतर बनाएं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripremite tijelo uz pomoć brojeva i izgleda"
