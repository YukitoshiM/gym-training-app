    "domain_catalog.20465297f989": {
      "comment": "GymTrainingApp/Domain/FoodCompositionModels.swift:304\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إعادة حساب القيم الغذائية لجميع الأطعمة من جدول التركيب القياسي للأغذية اليابانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els valors nutricionals de tots els aliments s'han recalculat a partir de la taula de composició estàndard dels aliments japonesos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny nutriční hodnoty potravin byly znovu vypočítány z Japonské standardní tabulky složení potravin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har genberegnet næringsindholdet for alle fødevarer fra den japanske standardnæringstabell."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nährwerte aller Lebensmittel wurden anhand der japanischen Standard-Nährwerttabelle neu berechnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπολογίσαμε ξανά τις διατροφικές τιμές όλων των τροφίμων χρησιμοποιώντας τον εθνικό πίνακα συστατικών τροφίμων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We have recalculated the nutritional values of all foods using the Japanese Food Standard Composition Table."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We have recalculated the nutritional values of all foods using the Japanese Food Standard Composition Table."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We have recalculated the nutritional values of all foods using the Japanese Food Standard Composition Table."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We have recalculated the nutritional values of all foods using the Japanese Food Standard Composition Table."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "He recalculado el valor nutricional de todos los alimentos utilizando la Tabla de Composición Estándar de Alimentos de Japón."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "He recalculado el valor nutricional de todos los alimentos utilizando la Tabla de Composición Estándar de Alimentos de Japón."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskimme kaikki ruokien ravintoarvot uudelleen Japanin standardiaineosat-taulukosta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons recalculé la valeur nutritionnelle de tous les aliments à partir de la table des composants standard japonais."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons recalculé la valeur nutritionnelle de tous les aliments à partir de la table des composants standard japonais."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમે તમામ ખોરાકના પોષણ મૂલ્યોને જાપાનીઝ સ્ટાન્ડર્ડ ઘટકો કોષ્ટકમાંથી ફરીથી ગણતરી કર્યા છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חישבתי מחדש את ערכי התזונה של כל המזונות על סמך טבלת הרכב מזון סטנדרטית ביפן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने सभी खाद्य पदार्थों के पोषण मूल्य को \"जापानी फूड स्टैंडर्ड कंपोनेंट टेबल\" से फिर से गणना की है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunali smo nutritivne vrijednosti svih namirnica prema tablici standardnih sastojaka hrane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes élelmiszer tápértékét újra számítottuk a Japán Standard Élelmiszer Tartalom Táblázat alapján."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai gizi untuk semua makanan telah dihitung ulang berdasarkan Tabel Komposisi Makanan Standar Jepang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo ricalcolato il valore nutrizionale di tutti gli alimenti utilizzando l'Almanacco alimentare standard giapponese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全食品の栄養値を日本食品標準成分表から再計算しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 식품의 영양 성분을 일본 식품 표준 성분표를 기준으로 다시 계산했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व खाद्यपदार्थांचे पोषण मूल्य 'जपान फूड स्टँडर्ड कंपोनंट टेबल' वरून पुन्हा मोजले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai gizimakanan telah dikira semula daripada Senarai Komposisi Makanan Standard Jepun."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De voedingswaarden van alle voedingsmiddelen zijn opnieuw berekend met behulp van de Japanse standaardvoedingswaardetabel."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Næringsverdien for alle matvarer er blitt beregnet på nytt fra den japanske standardtabellen for næringsinnhold."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeprowadziliśmy ponowny obliczenie wartości odżywczych dla wszystkich produktów na podstawie Japońskiego Standardowego Tabeli Składu Żywieniowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recalculamos o valor nutricional de todos os alimentos com base na Tabela de Composição Alimentar Japonesa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recalculamos o valor nutricional de todos os alimentos com base na Tabela de Composição Alimentar Japonesa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am recalculat valoarea nutrițională a tuturor alimentelor folosind Tabela Standard de Compoziție Alimentară din Japonia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Питательная ценность всех продуктов пересчитана на основе таблицы пищевых веществ Японии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všeobecné nutričné hodnoty boli znovu vypočítané z Japonskej štandardnej tabuľky potravín."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi hranilni elementi posameznih živil so ponovno izračunani na podlagi Japanskega standardnega seznama sestavin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har räknat om näringsinnehållet för alla livsmedel med hjälp av Japan Food Standard Composition Table."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லா உணவு பொருட்களின் ஊட்டச்சத்து மதிப்புகளை ஜப்பானிய தரப்படுத்தப்பட்ட உணவு அட்டவணையிலிருந்து மீண்டும் கணக்கிட்டுள்ளோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని ఆహార పదార్థాల పోషక విలువలను జపాన్ ఫుడ్ స్టాండర్డ్ కాంపోనెంట్ టేబుల్ నుండి తిరిగి లెక్కించాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณค่าสารอาหารของอาหารทั้งหมดใหม่จากตารางสารอาหารมาตรฐานของญี่ปุ่น"
