    "domain_catalog.38480060807b": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:489\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سنركز على التغيرات في محيط الخصر وصور شكل الجسم. من الأسهل مقارنة الصور إذا التقطتها بنفس الزاوية وفي نفس الإضاءة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ens centrarem en els canvis en la circumferència de la cintura i en les fotos de la forma del cos. És més fàcil comparar fotos si les feu amb el mateix angle i amb la mateixa llum."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Důraz klademe na změny obvodu břicha a fotografie postavy. Pro snadnější porovnání je doporučujeme pořizovat fotografie stejným úhlem a za stejného osvětlení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fokuserer på ændringer i taljelængde og kropsform. Det er nemmest at sammenligne billeder, der er taget under samme betingelser (samme vinkel, samme lys)."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir legen Wert auf Veränderungen im Bauchumfang und im Körperfoto. Fotos, die unter gleichen Bedingungen (gleiche Perspektive, gleiche Beleuchtung) aufgenommen wurden, lassen einen besseren Vergleich zu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εστιάζουμε στις αλλαγές στην περίμετρο της κοιλιάς και στη φωτογραφία του σώματος. Οι φωτογραφίες είναι πιο εύκολες στον σύγκριση όταν τραβούνται από την ίδια γωνία και με το ίδιο φως."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We will focus on changes in your abdominal circumference and body shape photos. Photos taken from the same angle and with the same lighting will make comparisons easier."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We will focus on changes in your abdominal circumference and body shape photos. Photos taken from the same angle and with the same lighting will make comparisons easier."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We will focus on changes in your abdominal circumference and body shape photos. Photos taken from the same angle and with the same lighting will make comparisons easier."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We will focus on changes in your abdominal circumference and body shape photos. Photos taken from the same angle and with the same lighting will make comparisons easier."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaremos especial atención al cambio en la circunferencia y la forma del abdomen. Las fotos deben tomarse desde el mismo ángulo y con la misma luz para facilitar la comparación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestaremos especial atención al cambio en la circunferencia y la forma del abdomen. Las fotos deben tomarse desde el mismo ángulo y con la misma luz para facilitar la comparación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korostamme vatsanympäryksen ja kehon muodon muutoksia. Valokuvat, jotka on otettu samasta kulmasta ja valaistuksessa, ovat helpompi verrata."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous accordons une importance particulière aux changements de tour de taille et aux photos du corps. Il est plus facile de comparer si les photos sont prises sous le même angle et avec la même lumière."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous accordons une importance particulière aux changements de tour de taille et aux photos du corps. Il est plus facile de comparer si les photos sont prises sous le même angle et avec la même lumière."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પેટના પરિઘ અને શરીરના આકારની તુલના પર ધ્યાન આપવામાં આવશે. સમાન ખૂણા અને પ્રકાશમાં લેવામાં આવેલી છબીઓની સરખામણી કરવી સરળ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנו מתמקדים בהשוואה בין יקף הבטן ובין תמונות של צורת הגוף. תמונות שצולמות באותה זווית ובאותו אור יהיו קלות יותר להשוואה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेट के घेरे और शरीर के आकार की तस्वीरों में बदलाव पर ध्यान दें। यदि आप एक ही कोण और प्रकाश में तस्वीरें लेते हैं, तो तुलना करना आसान होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naglasimo promjene u obodu trupa i fotografijama tijela. Fotografije snimljene istim kutom i svjetlošću će biti lakše usporedivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A derék körülső átmérőjének és az alakjának változásaira összpontosítunk. A képek összehasonlításához fontos, hogy ugyanazon szögből és fényben készítsük őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberikan perhatian pada perubahan lingkar perut dan foto bentuk tubuh. Foto yang diambil dengan sudut dan pencahayaan yang sama akan memudahkan perbandingan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendere in considerazione i cambiamenti nel perimetro dell'addome e nelle foto del corpo. Le foto scattate dalla stessa angolazione e con la stessa illuminazione facilitano il confronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腹囲と体型写真の変化を重視します。写真は同じ角度、同じ光で撮ると比較しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복부 둘레와 체형 사진의 변화를 중점적으로 고려합니다. 같은 각도, 같은 조명으로 촬영하면 비교하기 쉽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोटाचा घेर आणि शरीराच्या आकारातील बदलांवर लक्ष केंद्रित केले जाईल. समान अँगल आणि प्रकाशात घेतलेले फोटोची तुलना करणे सोपे होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberikan penekanan kepada perubahan dalam gambar lingkar perut dan bentuk badan. Gambar diambil pada sudut dan cahaya yang sama akan memudahkan perbandingan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We richten ons op veranderingen in je buikomtrek en lichaamsbeeld. Foto's die vanuit dezelfde hoek en met hetzelfde licht zijn genomen, zijn gemakkelijker te vergelijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi legger vekt på endringer i midjeomkrets og kroppsbilde. Bilder tatt under samme vinkel og lysforhold gjør det lettere å sammenligne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwracamy uwagę na zmiany w obwodzie brzucha i sylwetce. Zdjęcia powinny być wykonane przy tej samej pozycji i oświetleniu, aby łatwo można było porównać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizamos a mudança na circunferência abdominal e nas fotos do corpo. Fotografar com o mesmo ângulo e iluminação facilita a comparação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizamos a mudança na circunferência abdominal e nas fotos do corpo. Fotografar com o mesmo ângulo e iluminação facilita a comparação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordăm o atenție specială modificărilor perimetrului abdominal și fotografiilor cu silueta corpului. Fotografii realizate din același unghi și în aceeași lumină facilitează compararea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обращаем внимание на изменения обхвата талии и формы тела. Фотографии, сделанные при одинаковом освещении и под одним углом, позволяют лучше сравнивать результаты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zameráme sa na zmeny obvodu pása a tvaru postavy. Fotografie, ktoré boli urobené pod rovnakým uhlom a za rovnakých svetelných podmienok, sa dajú ľahko porovnávať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poudarimo spremembe oboda in telesne slike. Fotografije, posnene iz istega kota in pod enakimi svetlobnimi pogoji, bodo lažje primerjave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi fokuserar på förändringar i midjemått och kroppsbild. För att göra jämförelser enklare är det viktigt att ta samma bild från samma vinkel och med samma ljus."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வயிற்று சுற்றளவு மற்றும் உடல் அமைப்பின் மாற்றங்களை முக்கியமாகக் கருதுகிறோம். ஒரே கோணத்தில், ஒரே வெளிச்சத்தில் புகைப்படங்கள் எடுக்கும்போது ஒப்பிடுவது எளிதாக இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉదర పరిమాణం మరియు శరీర ఆకృతి యొక్క మార్పులపై దృష్టి పెడుతుంది. ఒకే కోణంలో, ఒకే వెలుతురులో ఫోటోలు తీస్తే పోల్చడం సులభం అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะเน้นที่การเปลี่ยนแปลงของรอบเอวและรูปทรงตัว\nเพื่อให้ง่ายต่อการเปรียบเทียบ รูปภาพควรถ่ายในมุมและแสงเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karın çevresindeki ve vücut şeklinin değişimlerine odaklanıyoruz. Aynı açıda ve aynı ışıkta çekilmiş fotoğraflar karşılaştırmak için daha kolaydır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звертаємо увагу на зміни обхвату талії та фотографії фігури. Фотографії, зроблені в однаковому ракурсі та при однаковому освітленні, полегшують порівняння."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi ưu tiên việc theo dõi sự thay đổi của vòng bụng và hình ảnh cơ thể. Ảnh chụp với cùng góc và ánh sáng sẽ giúp so sánh dễ dàng hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重视腹围和身体形态的照片变化。使用相同的角度和光线拍摄照片可以更容易进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們主要關注您的腹圍和身體比例的變化。為了方便比較，請使用相同的角度和光線拍攝照片。"
          }
        }
      }
    },
