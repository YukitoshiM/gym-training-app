    "core_ui.cc1e78c76f29": {
      "comment": "GymTrainingApp/Features/Home/HomeView.swift:834",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تعلّم الحركات خلال 3 تمارين"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprèn els moviments en 3 entrenaments"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučte se pohyby během 3 tréninků"
          }
