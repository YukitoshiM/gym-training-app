        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valutare i cambiamenti nella forma fisica considerando il peso, la circonferenza vita e le foto, oltre alla forza muscolare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重だけでなく腹囲・写真・筋力を合わせて体型変化を評価"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸무게, 허리둘레, 사진, 근력을 종합적으로 고려하여 체형 변화를 평가합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, कंबर, स्नायू आणि शारीरिक स्थितीच्या आधारावर बदलांचे मूल्यांकन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai perubahan bentuk tubuh berdasarkan berat badan, sekeliling pinggang, foto, dan kekuatan otot"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Beoordeel je lichaamssamenstelling op basis van je gewicht, tailleomtrek en foto's, evenals je kracht"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurder kroppsformen basert på vekt, rundt midjen, fotografier og styrke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oceń zmiany sylwetki, uwzględniając wagę, obwód talii i zdjęcia, oraz siłę mięśni"
