    "health_meals_body_ai.f9c18792e243": {
      "comment": "GymTrainingApp/Features/BodyMetrics/BodyMetricDetailView.swift:267\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تحديد القيمة المستهدفة، سيتم عرض الفارق ونسبة الإنجاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després d'establir el valor objectiu, es mostraran la diferència i la taxa d'assoliment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavením hodnoty cíle zobrazíte rozdíl a procento dosažení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du indstiller en målværdi, vises forskellen og fremskridt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie einen Zielwert festlegen, werden die Differenz und der Fortschritt angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ορίσετε έναν στόχο, εμφανίζονται η διαφορά και το ποσοστό επίτευξης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "When you set a goal, it displays the difference and completion rate."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "When you set a goal, it displays the difference and completion rate."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you set a goal, it displays the difference and completion rate."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "When you set a goal, it displays the difference and completion rate."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al establecer un valor objetivo, se muestra la diferencia y el porcentaje de cumplimiento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Al establecer un valor objetivo, se muestra la diferencia y el porcentaje de cumplimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun asetat tavoitearvon, näytetään ero ja saavutetun prosenttiosuuden."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous définissez une valeur cible, nous afficherons la différence et le taux d'atteinte."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous définissez une valeur cible, nous afficherons la différence et le taux d'atteinte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે તમે ધ્યેય મૂલ્ય સેટ કરો છો, ત્યારે તફાવત અને પૂર્ણતા દર દર્શાવવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרת ערך מטרה תציג את ההבדל ואחוז ההשגה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप लक्ष्य मूल्य निर्धारित करते हैं, तो अंतर और उपलब्धि दर प्रदर्शित होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada postavite ciljnu vrijednost, prikazat će se razlika i postignuće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miután beállította a célértéket, megjeleníti a különbséget és a teljesítési arányt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah menetapkan nilai target, perbedaan dan tingkat pencapaian akan ditampilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostando il valore obiettivo, vengono visualizzate le differenze e il tasso di raggiungimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標値を設定すると、差分と達成率を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 값을 설정하면, 차이와 달성률을 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही लक्ष्य मूल्य सेट केल्यास, त्यातील फरक आणि प्रगती दर्शवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda menetapkan nilai matlamat, ia akan menunjukkan perbezaan dan kadar pencapaian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer u een doelwaarde instelt, worden de verschillen en het percentage van uw voortgang weergegeven."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du setter en målverdi, vises forskjellen og fremgangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienie wartości celu powoduje wyświetlenie różnicy i wskaźnika realizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao definir o valor do objetivo, exibe a diferença e a taxa de conclusão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao definir o valor do objetivo, exibe a diferença e a taxa de conclusão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce setați valoarea obiectivului, veți vedea diferența și procentul de realizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При установке целевого значения отображаются разница и процент достижения цели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po nastavení hodnoty cieľa, zobrazí rozdiel a percentuálnu úspešnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko nastavite ciljno vrednost, se prikažejo razlika in stopnja doseganja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du har ställt in ett målvärde visas skillnaden och framgångsgraden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறிக்கோள் மதிப்பை அமைக்கும்போது, ​​வேறுபாடு மற்றும் முன்னேற்றத்தைக் காணலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లక్ష్య విలువను సెట్ చేసినప్పుడు, దానితో పోలిస్తే సాధించిన స్థాయిని చూపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณตั้งค่าเป้าหมาย คุณจะสามารถดูความแตกต่างและอัตราความสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef değerini ayarladığınızda, fark ve başarı oranlarını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "При встановленні цільового значення, відображаються відмінність та рівень досягнення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn đặt giá trị mục tiêu, chúng tôi sẽ hiển thị sự khác biệt và tỷ lệ hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置目标值后，会显示差异和达成率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定目標值後，會顯示差異和達成率。"
          }
        }
      }
    },
