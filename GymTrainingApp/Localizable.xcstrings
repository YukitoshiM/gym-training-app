        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई गतिविधि डेटा उपलब्ध नहीं है। इसे वॉच पर सेट करके अनुमान लगाया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaci još nisu dostupni. Predpostavljamo da je početak putem sata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
