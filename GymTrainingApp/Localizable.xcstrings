          "stringUnit": {
            "state": "translated",
            "value": "No credits will be consumed. Summarize using only records stored on your device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No credits will be used, summary based on device records only."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "No credits will be consumed. Summarize using only records stored on your device."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No consumir créditos, solo usar los datos almacenados en el dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No consume créditos, solo utiliza los registros internos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei käytetä krediittejä, raportit luodaan laitteen sisäisistä tiedoista."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas utiliser de crédits, uniquement les données enregistrées sur votre appareil."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas consommer de crédits, uniquement les données locales sont utilisées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્રેડિટનો ઉપયોગ કરશો નહીં, ફક્ત ઉપકરણમાંના રેકોર્ડ પરથી સારાંશ મેળવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא להוציא נקודות, רק להשתמש בהקלטות המקומיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रेडिट का उपयोग नहीं करें, केवल डिवाइस पर मौजूद रिकॉर्ड के साथ सारांश प्राप्त करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne trošite kredite, izvješće generirajte samo iz internih podataka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem fogyaszt kreditet, csak a helyi adatokat használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menggunakan kredit, hanya menggunakan catatan di perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non consumi crediti, utilizza solo i dati memorizzati sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットは消費せず、端末内の記録だけで要約します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레딧을 소비하지 않고, 기기 내 기록만으로 요약합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रेडिट वापरणार नाही, फक्त डिव्हाइसमधील नोंदीनुसार सारांश तयार होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan gunakan kredit, hanya gunakan rekod dalam peranti."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen credits verbruiken, gebruik alleen de interne gegevens."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke bruk kreditter, bruk kun data fra enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zużywaj kredytów, a raporty będą oparte tylko na danych z urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não usa créditos e gera resumo apenas com os registros internos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consumir créditos, apenas usar os registos internos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu consumă credite și folosește doar înregistrările de pe dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не тратить кредиты, только на основе данных устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevyhodnocovať kredity, používajte len záznamy v zariadení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne porabiš kreditov, samo uporabi podatke na napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediter används inte, sammanfattning baserad på lokala data."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிரெடிட்களை பயன்படுத்த வேண்டாம், சாதனத்தில் உள்ள பதிவுகளையே வைத்து சுருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్రెడిట్‌లను ఉపయోగించకుండా, పరికరంలోని రికార్డుల ద్వారా మాత్రమే సారాంశం చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช้ ครีดิต, ใช้เฉพาะข้อมูลในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi harcamadan, cihazdaki verilerle özet oluştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не витрачати кредити, використовувати лише записи в пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tiêu thụ tín dụng, chỉ sử dụng dữ liệu trong thiết bị để tóm tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不消耗积分，仅根据设备内的记录进行总结。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不消費點數，僅根據裝置內記錄進行總結。"
          }
        }
      }
    },
    "ai_credit.automatic_report_credit_use_on": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift:136\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
