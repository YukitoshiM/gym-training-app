    "health_meals_body_ai.a83b5bccdf24": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:578\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "وزاد حجم التداول بأكثر من 30% عن الأسبوع السابق. في المرة القادمة، دعونا نحافظ على نفس المستوى ونتحقق من RPE ومؤشرات الاسترداد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El volum ha augmentat més d'un 30% respecte a la setmana anterior. La propera vegada, mantenim el mateix nivell i comprovem RPE i els indicadors de recuperació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objem cvičení se oproti předchozímu týdnu zvýšil o více než 30 %. V příštím tréninku se zaměřte na udržení tohoto objemu a zkontrolujte své hodnoty RPE (Rate of Perceived Exertion) a ukazatele regenerace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har øget din volumen med mere end 30 % i forhold til sidste uge. Næste gang bør du forsøge at opretholde dette niveau, og tjek RPE (Rate of Perceived Exertion) og restitutionen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Volumen hat sich um mehr als 30 % gegenüber der letzten Woche erhöht. Beim nächsten Training sollten Sie versuchen, dieses Niveau beizubehalten und RPE (Rate of Perceived Exertion) sowie die Erholung zu überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όγκο σας έχει αυξηθεί κατά 30% ή περισσότερο από την προηγούμενη εβδομάδα. Στην επόμενη προπόνηση, προσπαθήστε να διατηρήσετε αυτό το επίπεδο και ελέγξτε το RPE (Rate of Perceived Exertion) και τους δείκτες αποκατάστασης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your volume has increased by more than 30% compared to last week. Next time, aim to maintain this level and check your RPE and recovery indicators."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your volume has increased by more than 30% compared to last week. Next time, aim to maintain this level and check your RPE and recovery indicators."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your volume has increased by more than 30% compared to last week. Next time, aim to maintain this level and check your RPE and recovery indicators."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your volume has increased by more than 30% compared to last week. Next time, aim to maintain this level and check your RPE and recovery indicators."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen ha aumentado en más del 30% desde la semana pasada. La próxima vez, intenta mantener este nivel y revisa tu escala de esfuerzo percibido (RPE) e indicadores de recuperación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen ha aumentado en más del 30% desde la semana pasada. La próxima vez, intenta mantener este nivel y revisa tu escala de esfuerzo percibido (RPE) e indicadores de recuperación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Volyymi on kasvanut yli 30 % viime viikkoon verrattuna. Seuraavalla kerralla pyri säilyttämään sama määrä ja tarkista RPE-arvo sekä palautumisen mittarit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre volume a augmenté de plus de 30 % par rapport à la semaine dernière. Pour la prochaine séance, essayez de maintenir ce niveau et vérifiez votre ressenti (échelle RPE) ainsi que vos indicateurs de récupération."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre volume a augmenté de plus de 30 % par rapport à la semaine dernière. Pour la prochaine séance, essayez de maintenir ce niveau et vérifiez votre ressenti (échelle RPE) ainsi que vos indicateurs de récupération."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે અઠવાડિયામાં 30% થી વધુ વધારો દર્શાવ્યો છે. આગલી વખતે, આ જ સ્તર જાળવી રાખો અને RPE (રાઇટ પીસ એસ્ટેમ) અને પુનઃપ્રાપ્તિના સૂચકાંકો તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנפח גדל ביותר מ-30% מאז שבוע שעבר. בפעם הבאה, שמרו על נפח דומה ובדקו את מד RPE ושיפור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले सप्ताह की तुलना में, मात्रा 30% से अधिक बढ़ गई है। अगली बार, इसी स्तर को बनाए रखें और RPE (रेटेड पेस्ली स्केल) और रिकवरी इंडिकेटर की जांच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš volumen je povećan za više od 30% u odnosu na prošli tjedn. Idnji put, pokušajte održati sličan volumen i provjerite svoje vrijednosti RPE (perceived rate of exertion) i pokazatelje oporavka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A volumene 30%-kal nagyobb, mint a héten. A következő edzésen próbáljuk ezt megtartani, és ellenőrizzük az RPE-t és a regenerációs mutatókat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume telah meningkat lebih dari 30% dibandingkan minggu lalu. Pada latihan berikutnya, usahakan untuk mempertahankan volume ini dan periksa RPE serta indikator pemulihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume è aumentato del 30% o più rispetto alla settimana scorsa. Nella prossima sessione, mantenete questo livello e verificate il vostro RPE (Rate of Perceived Exertion) e gli indicatori di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前週よりボリュームが30%以上増えています。次回は同程度を維持し、RPEと回復指標を確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 주보다 부피가 30% 이상 증가했습니다. 다음에는 비슷한 수준을 유지하고, RPE 및 회복 지표를 확인해 보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील आठवड्याच्या तुलनेत, तुमच्या शरीरातील चरबीचे प्रमाण ३०% पेक्षा जास्त वाढले आहे. पुढील प्रशिक्षणात हेच प्रमाण कायम ठेवा आणि RPE (Rate of Perceived Exertion) आणि पुनर्वसन निर्देशक तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah latihan telah meningkat sebanyak 30% atau lebih sejak minggu lepas. Untuk sesi seterusnya, cuba pertahankan tahap ini dan periksa RPE serta penunjuk pemulihan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je volume is met meer dan 30% toegenomen ten opzichte van vorige week. Bij de volgende training, probeer dit niveau te behouden en controleer je RPE (Rate of Perceived Exertion) en herstelindicatoren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumet har økt med mer enn 30 % siden forrige uke. Neste gang bør du prøve å opprettholde dette nivået, og sjekk RPE (Rate of Perceived Exertion) og restitusjonsindikatoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Objętość wzrosła o ponad 30% w porównaniu z poprzednim tygodniem. Następnym razem staraj się utrzymać podobny poziom i sprawdź RPE oraz wskaźnik regeneracji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume tem aumentado em mais de 30% em relação à semana passada. Na próxima vez, tente manter este nível e verifique a escala de percepção e os indicadores de recuperação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O volume tem aumentado em mais de 30% em relação à semana passada. Na próxima vez, tente manter este nível e verifique a escala de percepção e os indicadores de recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumul a crescut cu peste 30% față de săptămâna trecută. La următoarea sesiune, încercați să mențineți acest nivel și verificați indicatorii RPE și de recuperare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объем увеличился на более чем 30% по сравнению с предыдущей неделей. В следующий раз постарайтесь поддерживать примерно такой же объем, а также проверьте свои показатели RPE и восстановления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Objem je o viac ako 30 % vyšší, než v predchádzajúcom týždni. Nasledujúci tréning sa snažte udržať podobný objem a skontrolujte svoje hodnotiace stupnice (RPE) a ukazovatele regenerácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš volumen je povečan za več kot 30% glede na prejšnji teden. Pri naslednem treningu se poskusite ohranjati približno enako, in preverite svojo raven napora (RPE) ter indikatorje regeneracije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Volymen har ökat med mer än 30 % sedan förra veckan. Nästa gång bör du försöka bibehålla ungefär samma nivå och kontrollera din RPE (Rate of Perceived Exertion) och återhämtningsindikator."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த வாரத்தை விட, அளவு 30% அதிகமாக உள்ளது. அடுத்த முறை அதே அளவை பராமரிக்கவும், RPE மற்றும் மீட்பு குறிகாட்டிகளை சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మునుపటి వారంతో పోలిస్తే, 30% కంటే ఎక్కువ పరిమాణం పెరిగింది. తదుపరిసారి కూడా ఇదే స్థాయిని కొనసాగించండి మరియు RPE (గుర్తించదగిన శ్రమ స్థాయి) మరియు పునరుద్ధరణ సూచికలను చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณการออกกำลังกายเพิ่มขึ้นมากกว่า 30% เมื่อเทียบกับสัปดาห์ที่แล้ว ครั้งต่อไป ให้พยายามรักษาระดับไว้ และตรวจสอบค่า RPE และตัวชี้วัดการฟื้นตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçen haftaya göre hacim %30'dan fazla arttı. Bir sonraki antrenmanda bu seviyeyi koruyun ve RPE (Rate of Perceived Exertion) ve iyileşme göstergelerini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш об'єм збільшився на 30% або більше. Наступного разу постарайтеся підтримувати такий рівень, а також перевірте свої показники RPE та відновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khối lượng tập luyện tăng hơn 30% so với tuần trước. Trong buổi tập tiếp theo, hãy cố gắng duy trì mức này và kiểm tra RPE (đánh giá chủ quan về mức độ mệt) và chỉ số phục hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上周比增加了30%以上。 下次请保持同等水平，并确认RPE和恢复指标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上周比增加了30%以上。 下次保持同等水平，并确认RPE和恢复指标。"
          }
        }
      }
    },
