          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skifter hjemmeside-punkter og næste handling i henhold til formålet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Startseite an, um den nächsten Schritt zu bestimmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζετε τα σημεία ελέγχου στην αρχική σελίδα και την επόμενη ενέργεια ανάλογα με τον στόχο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between home screen check points and next actions based on the purpose."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between home screen check points and next actions based on the purpose."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between home screen check points and next actions based on the purpose."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between home screen check points and next actions based on the purpose."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia los puntos de verificación en la pantalla principal y lo siguiente a hacer según el objetivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia los puntos de verificación en la pantalla principal y lo siguiente a hacer según el objetivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit vaihtaa kotisivun tarkistuspisteitä ja seuraavaa vaihetta tavoitteesi mukaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier les points de contrôle sur la page d'accueil et la prochaine action en fonction de votre objectif."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier les points de contrôle sur la page d'accueil et la prochaine action en fonction de votre objectif."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ધ્યેયો અનુસાર, હોમ પરના ચકાસણી પોઈન્ટ અને આગળ શું કરવું તે બદલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשנות את נקודות הבדיקה בבית ומה לעשות בהמשך, בהתאם למטרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उद्देश के अनुसार, होम पेज पर जांचने के बिंदु और आगे क्या करना है, इसे बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažurirajte svoj dom, prilagođen za određeni cilj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A cél alapján automatikusan átváltja a kezdőképernyőn megjelenő pontokat és a következő lépéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengubah titik pemeriksaan di beranda dan tindakan selanjutnya sesuai dengan tujuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base all'obiettivo, vengono modificati i punti di controllo sulla homepage e le prossime azioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的に合わせてホームの確認ポイントと次にやることを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목적에 맞춰 홈 화면의 확인 지점과 다음 단계를 전환합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उद्दिष्टानुसार, होमपेजवरील तपासणीचे मुद्दे आणि पुढील कृती बदलली जाते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar titik semakan di rumah dan aktiviti seterusnya mengikut matlamat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de startpunten en de volgende stappen aanpassen op basis van je doel."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan endre startpunkt og neste handling i hovedmenyen, basert på formålet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosowujemy domowe punkty kontrolne i kolejne kroki w zależności od celu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda os pontos de verificação na tela inicial e a próxima ação, de acordo com o objetivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda os pontos de verificação na tela inicial e a próxima ação, de acordo com o objetivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom schimba punctele de verificare de pe pagina principală și următoarea acțiune în funcție de scop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В зависимости от цели, меняются точки контроля на главной странице и следующие действия."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe cieľa upravíte svoje hlavné body a ďalšie kroky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi cilja prilagodimo tudi glavne točke za preverjanje in naslednji korak."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan anpassa hemskärmen efter dina behov och vad du vill göra härnäst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இலக்கிற்கு ஏற்றவாறு, முகப்புப் பக்கத்தில் உள்ள குறிப்புகளை மாற்றி, அடுத்து என்ன செய்ய வேண்டும் என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లక్ష్యానికి అనుగుణంగా హోమ్ స్క్రీన్ యొక్క తనిఖీ పాయింట్‌లను మరియు తదుపరి ఏమి చేయాలో మార్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเปลี่ยนจุดตรวจสอบในหน้าแรกและสิ่งที่ควรทำตามวัตถุประสงค์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaca göre ana sayfadaki kontrol noktalarını ve bir sonraki adımı değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично перемикається на наступні дії відповідно до обраної мети."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi các điểm kiểm tra trên trang chủ và hoạt động tiếp theo phù hợp với mục đích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据目的，切换主页的检查点和下一步行动。"
          }
