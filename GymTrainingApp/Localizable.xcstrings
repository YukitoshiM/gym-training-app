    "training.d6713c7cb074": {
      "comment": "GymTrainingApp/Features/Plans/PlanListView.swift:59\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إنشاؤه بناءً على الغرض والمجالات المهمة والمعدات القابلة للاستخدام والنتائج السابقة. يمكنك تغيير الصنف والقيمة قبل الحفظ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es crea en funció del propòsit, àrees importants, equips utilitzables i resultats anteriors. Podeu canviar l'element i el valor abans de desar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytváří se na základě vašeho cíle, zaměření, dostupného vybavení a předchozích výsledků. Před uložením můžete upravit cvičení a hodnoty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på dit mål, fokusområde, tilgængeligt udstyr og tidligere resultater. Du kan ændre øvelser og værdier før gemning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird anhand von Ziel, Fokusbereich, verfügbaren Geräten und bisherigen Erfolgen erstellt. Vor dem Speichern können Sie Übungen und Werte ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργείται με βάση τον σκοπό, την κύρια περιοχή, τον διαθέσιμο εξοπλισμό και τα προηγούμενα αποτελέσματα. Μπορείτε να τροποποιήσετε τις ασκήσεις και τις τιμές πριν αποθηκεύσετε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Created based on your goals, target areas, available equipment, and past performance. You can modify the exercises and numbers before saving."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Created based on your goals, target areas, available equipment, and past performance. You can modify the exercises and numbers before saving."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Created based on your goals, target areas, available equipment, and past performance. You can modify the exercises and numbers before saving."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Created based on your goals, target areas, available equipment, and past performance. You can modify the exercises and numbers before saving."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea en función de tu objetivo, área de enfoque, equipo disponible y resultados anteriores. Puedes modificar las opciones y valores antes de guardar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea en función de tu objetivo, área de enfoque, equipo disponible y resultados anteriores. Puedes modificar las opciones y valores antes de guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luodaan perustuen tavoitteeseen, keskittymisalueeseen, käytettävissä oleviin laitteisiin ja aiempiin tuloksiin. Voit muuttaa harjoituksia ja arvoja ennen tallennusta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Créé en fonction de vos objectifs, des zones ciblées, de l'équipement disponible et de vos réalisations antérieures. Vous pouvez modifier les exercices et les valeurs avant d'enregistrer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Créé en fonction de vos objectifs, des zones ciblées, de l'équipement disponible et de vos réalisations antérieures. Vous pouvez modifier les exercices et les valeurs avant d'enregistrer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ તમારા ધ્યેય, મુખ્ય ભાગો, ઉપયોગ કરી શકાય તેવા સાધનો અને અગાઉની પ્રગતિના આધારે બનાવવામાં આવે છે. સેવ કરતા પહેલા તમે કસરત અને સંખ્યા બદલી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יוצרת על סמך המטרה, אזורי הדגש, הציוד הזמין והישגים קודמים. ניתן לשנות את התרגיל והערכים לפני שמירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके उद्देश्य, मुख्य क्षेत्रों, उपलब्ध उपकरणों और पिछले प्रदर्शन के आधार पर बनाया गया है। सहेजने से पहले आप गतिविधियों और संख्याओं को बदल सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreira se na temelju cilja, ključnih dijelova tijela, dostupne opreme i prethodnih rezultata. Možete promijeniti kategorije i vrijednosti prije spremanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a cél a cél, a hangsúlyos izomcsoportok, az elérhető eszközök és a korábbi teljesítmény alapján kerül meghatározásra. A mentés előtt megváltoztathatja a feladatokat és a számokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat berdasarkan tujuan, area fokus, peralatan yang tersedia, dan pencapaian sebelumnya. Anda dapat mengubah jenis dan angka sebelum menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato in base a obiettivi, aree di focus, attrezzature disponibili e risultati precedenti. È possibile modificare esercizi e valori prima del salvataggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的・重点部位・使える器具・過去の実績から作成しています。保存前に種目と数値を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목적, 주요 부위, 사용 가능한 장비, 과거 성과를 기반으로 생성합니다. 저장하기 전에 운동 종류와 숫자를 변경할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे उद्दिष्टांवर आधारित आहे, ज्यात उद्देश, मुख्य भाग, वापरण्यायोग्य उपकरणे आणि मागील कामगिरीचा समावेश आहे. साठवण्यापूर्वी तुम्ही व्यायाम प्रकार आणि संख्या बदलू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat berdasarkan matlamat, bahagian fokus, peralatan yang tersedia, dan prestasi sebelumnya. Anda boleh mengubah suai aktiviti dan nilai sebelum menyimpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gemaakt op basis van je doelen, focusgebieden, beschikbare apparatuur en eerdere prestaties. Je kunt de oefeningen en waarden wijzigen voordat je opslaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Basert på mål, fokusområder, tilgjengelig utstyr og tidligere resultater. Du kan endre øvelser og verdier før du lagrer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzony na podstawie celu, skupionych obszarów, dostępnych urządzeń i wcześniejszych osiągnięć. Możesz zmienić ćwiczenia i wartości przed zapisaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criado com base em seus objetivos, áreas de foco, equipamentos disponíveis e resultados anteriores. Você pode alterar os exercícios e valores antes de salvar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criado com base em seus objetivos, áreas de foco, equipamentos disponíveis e resultados anteriores. Você pode alterar os exercícios e valores antes de salvar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este creat pe baza scopului, a zonei de accent, a echipamentelor disponibile și a rezultatelor anterioare. Puteți modifica exercițiile și valorile înainte de salvare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создается на основе целей, целевых групп мышц, доступного оборудования и предыдущих результатов. Перед сохранением можно изменить упражнения и значения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vytvorený na základe vašich cieľov, zameraných oblastí, dostupného vybavenia a minulých výsledkov. Pred uložením môžete upraviť typy a čísla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarjeno glede na cilj, ključne dele, na razpolaganem oporu in prejšnjo uspešnost. Pred shranjevanjem lahko spremenite vadbo in številke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapas baserat på mål, fokusområden, tillgänglig utrustning och tidigare resultat. Du kan ändra övningar och värden innan du sparar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது உங்கள் நோக்கம், முக்கியப் பகுதி, பயன்படுத்தக்கூடிய உபகரணங்கள் மற்றும் கடந்தகால சாதனைகளின் அடிப்படையில் உருவாக்கப்படுகிறது. சேமிப்பதற்கு முன், பயிற்சிகள் மற்றும் எண்களை மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది లక్ష్యం, ముఖ్యమైన ప్రాంతం, ఉపయోగించగల పరికరాలు మరియు గత విజయాల ఆధారంగా రూపొందించబడుతుంది. సేవ్ చేయడానికి ముందు మీరు వ్యాయామాలను మరియు సంఖ్యలను మార్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างจากวัตถุประสงค์, ส่วนที่เน้น, อุปกรณ์ที่ใช้ และผลลัพธ์ในอดีต สามารถแก้ไขได้ก่อนบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaç, odaklanılacak bölge, kullanılabilir ekipman ve geçmiş başarılarınızdan oluşturulur. Kaydetmeden önce egzersizi ve sayıları değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюється на основі вашої мети, зони для тренувань, доступного обладнання та попередніх результатів. Можна змінити види та значення перед збереженням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tạo dựa trên mục tiêu, vùng tập trung, dụng cụ có thể sử dụng và thành tích trước đây. Bạn có thể thay đổi bài tập và số lần trước khi lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能基于您的目标、重点部位、可用的设备以及过去的成就。在保存之前，您可以更改项目和数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此等級是根據您的目的、重點部位、可用的器材以及過去的成就來設定的。在儲存之前，您可以更改項目和數字。"
          }
        }
      }
    },
