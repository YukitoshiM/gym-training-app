    "domain_catalog.c69fe4f4931d": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:141\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ جذعك مشدودًا، وادفع مرفقيك للأمام قليلًا، وادفع نفسك للأعلى فوق رأسك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu el nucli estret, empenyeu els colzes lleugerament cap endavant i empenyeu-vos per sobre del cap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upevněte trpáň a lehce vyložte lokty, abyste zvedli hlavu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr din kerne og løft armene let fremad, så du presser dem op mod hovedet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärken Sie Ihre Rumpfmuskulatur und heben Sie die Arme leicht nach vorne, um den Kopf anzuheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενισχύστε τον κορμό και σηκώστε τους αγκώνες προς τα εμπρός, ώστε να πιέζετε το κεφάλι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your core and raise your head by extending your arms forward and lifting the dumbbell overhead."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your core and raise your head by extending your arms forward and lifting the dumbbell overhead."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your core and raise your head by extending your arms forward and lifting the dumbbell overhead."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Strengthen your core and raise your head by extending your arms forward and lifting the dumbbell overhead."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece tu core y, con el codo ligeramente extendido, levanta la cabeza hacia arriba."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece tu core y, con el codo ligeramente extendido, levanta la cabeza hacia arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista ytimiä ja nosta kyynärvarret kevyesti eteenpäin, jolloin pää nousee ylös."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcer le tronc et lever légèrement les bras, en les portant vers le haut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforcer le tronc et lever légèrement les bras, en les portant vers le haut."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરના કેન્દ્રને મજબૂત બનાવો અને હાથને હળવેથી આગળ લાવીને માથા તરફ ઉપર ધકેલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזקו את הליבה והרימו את הזרועות קדימה, תוך העברת הראש מעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोर को मजबूत बनाएं, और हल्के से आगे निकालकर सिर पर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprijed podižite ruku, a zatim podignite glavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erősítsd a gerinced, és emeld fel az egyik karral, hogy a fej felett tartsd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuatkan inti tubuh, lalu angkat lengan ke depan dan ke atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafforzare il core e sollevare leggermente i gomiti verso l'alto, spingendo la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体幹を固め、肘を軽く前に出して頭上へ押し上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코어를 강화하고, 팔꿈치를 살짝 앞으로 내밀어 머리 위로 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीराचा मध्यभाग मजबूत करा आणि कोपर हलकेपणाने पुढे करून डोक्याच्या दिशेने वर न्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuatkan inti tubuh, kemudian angkat lengan ke atas dengan sedikit menekannya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De core versterken en de ellebogen licht naar voren bewegen om het hoofd omhoog te duwen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr kjernen, og løft armene lett fremover mot hodet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzmocnij rdzeń i delikatnie wyciągnij łokcie, aby podnieść głowę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortaleça o core e levante o braço, empurrando-o em direção à cabeça."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortaleça o core e levante o braço, empurrando-o em direção à cabeça."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Consolidă centrul corpului și ridică ușor brațele, împingându-le spre cap."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укрепите свой корпус и слегка вытяните руки вперед, чтобы поднять голову."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Posilite core a mierne vytiahnite ramena dopredu, aby ste zdvihli činku nad hlavu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krepite trup in rahlo podite ramo, da dvignete glavo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokusera på din kärna, lyft armarna framåt och pressa upp dem mot huvudet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடலின் மையப்பகுதியை வலுப்படுத்தி, முழங்கால்களை லேசாக முன்னோக்கி நீட்டி தலையின் மேல் உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీర మధ్య భాగాన్ని బలోపేతం చేయండి, మోచేతులను కొద్దిగా ముందుకు తీసుకువచ్చి తల పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสริมสร้างความแข็งแรงของส่วนกลางลำตัว และยกแขนขึ้นด้านหน้าเล็กน้อยแล้วดันไปด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkezi vücudu güçlendirin ve kollarınızı hafifçe öne çıkararak başınıza doğru kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміцнюйте корпус і висувайте лікті вперед, піднімаючи голову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng cường sức mạnh trung tâm cơ thể, đưa khuỷu tay ra phía trước và nâng lên trên đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强化核心肌群，并轻微向前伸展手臂，向上抬起头部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強化核心肌群，輕輕向前伸出手臂，向上推起頭部。"
          }
        }
      }
    },
