        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Več ko naredite, jasnejši postane naslednji korak"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju mer du gör, desto tydligare blir nästa steg"
