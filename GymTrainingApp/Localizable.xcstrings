        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimated values are for reference only. You can freely adjust them in the input field below."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimated values are for reference only. You can freely adjust them in the input field below."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimated values are for reference only. You can freely adjust them in the input field below."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones son valores orientativos. Puede modificarlos libremente en el campo de entrada inferior."
