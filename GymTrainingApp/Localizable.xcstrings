            "value": "سنرشدك في الصباح والمساء أثناء مشاهدة رد الفعل على الإشعار."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Us guiarem al matí i al vespre mentre observeu la reacció a la notificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posílám doporučení ráno a večer podle toho, jak reagujete na notifikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender dig rådgivning om morgenen og aftenen baseret på dine reaktioner på notifikationer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werde Ihnen morgens und abends Hinweise geben, basierend auf Ihren Reaktionen auf Benachrichtigungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρέχουμε οδηγίες το πρωί και το βράδυ με βάση την ανταπόκρισή σας στις ειδοποιήσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We will send reminders in the morning and evening based on your notification responses."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We will send reminders in the morning and evening based on your notification responses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We will send reminders in the morning and evening based on your notification responses."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We will send reminders in the morning and evening based on your notification responses."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proporcionaremos indicaciones por la mañana y por la noche en función de sus interacciones con las notificaciones."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proporcionaremos indicaciones por la mañana y por la noche en función de sus interacciones con las notificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoita sinulle aamulla ja illalla, kun vastaat ilmoituksiin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous fournirons des conseils matinal et nocturne en fonction de vos réponses aux notifications."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous fournirons des conseils matinal et nocturne en fonction de vos réponses aux notifications."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચનાઓ પરની પ્રતિક્રિયાને જોતા સવારે અને સાંજે સૂચનો આપવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני אדריך אותך בבוקר ובערב בהתאם לתגובות שלך להודעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाओं पर प्रतिक्रिया देखते हुए, सुबह और शाम को मार्गदर्शन प्रदान किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslat ćemo vam savjete ujutro i navečer, ovisno o vašem odgovoru na notifikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítésekre adott reakciók alapján adunk tanácsokat reggel és este."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan panduan di pagi dan malam berdasarkan respons notifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche vengono inviate al mattino e alla sera in base alle tue reazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知への反応を見ながら朝・夜に案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에 대한 반응을 보면서 아침/저녁으로 안내합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेशांना प्रतिसाद देताना सकाळी आणि संध्याकाळी सूचना पाठवल्या जातील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan panduan pada pagi dan malam berdasarkan tindak balas notifikasi."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We geven je advies in de ochtend en avond, afhankelijk van je reactie op notificaties."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi gir deg veiledning om morgenen og kvelden basert på din respons på varsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostarczam wskazówki rano i wieczorem w oparciu o Twoje reakcje na powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio orientações pela manhã e à noite com base nas suas respostas às notificações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Envio orientações pela manhã e à noite com base nas suas respostas às notificações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom oferi îndrumări dimineața și seara, pe baza reacției la notificări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отправляются утром и вечером в зависимости от вашей активности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe vašich reakcií na notifikácie vám budem poskytovať rady ráno a večer."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi vašega odziva vas bomo obveščali zjutraj in zvečer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ger dig vägledning på morgonen och kvällen baserat på dina reaktioner på notiser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகளுக்குப் பதிலளிக்கும் முறையைப் பொறுத்து, காலை மற்றும் மாலை நேரங்களில் உங்களுக்கு வழிகாட்டுகிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్లకు ప్రతిస్పందనను బట్టి ఉదయం మరియు రాత్రి సమయంలో సూచనలు అందిస్తాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะแจ้งเตือนในช่วงเช้าและเย็น โดยพิจารณาจากการตอบสนองต่อการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimlere tepkilerinizi gözlemleyerek sabah ve akşam saatlerinde size hatırlatırız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надавайте поради вранці та ввечері, враховуючи вашу реакцію на сповіщення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ gửi hướng dẫn buổi sáng và tối dựa trên phản hồi của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据您的反馈，在早上和晚上提供建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據您的回覆，早上和晚上提供建議。"
          }
        }
      }
    },
