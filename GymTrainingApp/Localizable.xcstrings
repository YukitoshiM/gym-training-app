    "domain_catalog.b80a2858a8d1": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:394\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الجلوس، ارفعي كعبيك ومددي ساقيك السفلية ببطء واقبضيهما."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre estàs assegut, aixeca els talons i estira i contrau lentament les cames inferiors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedněte si a zvedejte patu, pomalu protahujte a smršťujte nohy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sid ned med fødderne på gulvet og stræk dine lår langsomt ud og ind."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie den Fuß und heben Sie die Ferse an, dehnen und falten Sie das Bein langsam."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθιστή θέση, σηκώστε τα πέλματα και τεντώστε/συρρίγγυψτε απαλά τις γάμπες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with your heels raised and slowly extend and contract your lower legs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with your heels raised and slowly extend and contract your lower legs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with your heels raised and slowly extend and contract your lower legs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit with your heels raised and slowly extend and contract your lower legs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentarse con los talones elevados y estirar y contraer lentamente las piernas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentarse con los talones elevados y estirar y contraer lentamente las piernas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Istu ja nosta jalkaterät ylös, venytä ja kutista alaraajaa hitaasti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopter une position assise et lever le talon, puis étirer et contracter lentement la jambe inférieure."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopter une position assise et lever le talon, puis étirer et contracter lentement la jambe inférieure."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બેઠાં પોઝમાં ઘાને ઉપર ઉઠાવો અને નીચેના પગને ધીમેથી લંબાવો અને સંકોચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להישען וליישר את כף הרגל, תוך התארכות והידוק הברכיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैठकर पैरों की उंगलियों को ऊपर उठाएं और धीरे-धीरे अपने निचले अंगों को फैलाएं और सिकुड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjedite i podignite petu, polako istegnite i skratite donji dio noge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ülve emeld meg a sarjad, és lazán nyújtsd ki az alsótesten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Duduk dengan mengangkat tumit, lalu meregangkan dan menekuk kaki depan secara perlahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seduto, sollevare i talloni e allungare/accorciare le gambe lentamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座った姿勢で踵を上げ、下腿をゆっくり伸ばし縮める。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앉은 자세에서 발꿈치를 들어 올리고, 하체를 천천히 늘였다 줄이기."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बसलेल्या स्थितीत पायाच्या बोटांना वर उचलून, हळूवारपणे पाय ताणणे आणि दुमवणे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Duduk dalam posisi tegak, angkat tumpi, dan rentangkan dan kempiskan kaki."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zit in een comfortabele houding, hef je hielen op en strek en trek je benen langzaam uit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitt med rett rygg og løft hælene, strekk og klem ut bena sakte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usiądź, podnieś piętę i powoli rozciągnij/zwiń noge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentar-se com os pés elevados e alongar/encolher as pernas lentamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentar-se com os pés elevados e alongar/encolher as pernas lentamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustează gleznele în poziție șezută și întinde/îndoaie coatele lent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сидя, поднять пятки и медленно вытягивать/сжимать ноги."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedíte a zdvíhate päty, pomaly rozširujete a zmenšujete nohy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedite v položaju in dvignite pete, nato počasi raztegnite in upognite noge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sittande: Lyft foten och sträck ut benet långsamt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உட்கார்ந்த நிலையில், குதிகாலை உயர்த்தி, கீழ் கால்களை மெதுவாக நீட்டி சுருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక కూర్చున్న భంగిమలో, పాదాలను పైకి ఎత్తి, కాలును నెమ్మదిగా సాగదీయడం మరియు కుంచించుకుపోవడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นั่งตัวตรง ยกส้นเท้า และยืด-หดขาอย่างช้าๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturarak, topuğu kaldırıp, bacakları yavaşça uzatıp kısalma."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сидіть, піднімайте п'ятки та повільно розтягуйте та скорочуйте ноги."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngồi thẳng, nâng gót chân lên và từ từ kéo giãn và thu lại chân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐在姿势中抬起脚跟，然后缓慢伸展和收缩下腿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "坐在姿势中抬起脚跟，然后缓慢伸展和收缩下腿。"
          }
        }
      }
    },
