        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujeme obvod pása z prednej, zadnej a bočnej strany."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preveril sem obseg pasu, gledano s strani, zgorje in spodaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerade midjan genom att kombinera fram- och baksida."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்புற மற்றும் பின்புறத்தை சேர்த்து இடுப்பு அளவைச் சரிபார்க்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందు మరియు వెనుక వైపులను కలిపి నడుము పరిమాణాన్ని పరిశీలించాను."
