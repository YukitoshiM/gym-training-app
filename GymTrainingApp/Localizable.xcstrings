        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fordítsa túl a hátát, és forgassa a gerinját balról jobbra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan melengkungkan punggung terlalu parah, serta tekuk tubuh ke samping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
