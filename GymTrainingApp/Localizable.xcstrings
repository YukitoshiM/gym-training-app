    "health_meals_body_ai.b5035ba9b9f0": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:716\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى التحقق من معلومات الاتصال على شاشة الإعدادات والمحاولة مرة أخرى. يتم تجديد الشهادات قصيرة المدى تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comproveu la informació de connexió a la pantalla de configuració i torneu-ho a provar. Les certificacions a curt termini es renoven automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte informace o připojení v nastavení a zkuste to znovu. Krátkodobé ověření se automaticky obnoví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft forbindelsesoplysningerne i indstillingsmenuen og prøv igen. Kortvarig autentificering opdateres automatisk."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte überprüfen Sie die Verbindungsinformationen im Menü „Einstellungen“ und versuchen Sie es erneut. Die Kurzzeit-Authentifizierung wird automatisch aktualisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τις πληροφορίες σύνδεσης στην οθόνη ρυθμίσεων και προσπαθήστε ξανά. Η βραχυπρόθεσμη αυθεντικοποίηση ανανεώνεται αυτόματα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check the connection information on the settings screen and try again. Short-term authentication will automatically renew."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check the connection information on the settings screen and try again. Short-term authentication will automatically renew."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check the connection information on the settings screen and try again. Short-term authentication will automatically renew."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check the connection information on the settings screen and try again. Short-term authentication will automatically renew."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la información de conexión en la pantalla de configuración y vuelva a intentarlo. La autenticación corta se actualiza automáticamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique la información de conexión en la pantalla de configuración y vuelva a intentarlo. La autenticación corta se actualiza automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista asetuksissa olevat yhteystiedot ja yritä uudelleen. Lyhytaikainen tunnistautuminen päivittyy automaattisesti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier les informations de connexion sur l'écran des paramètres et réessayer. L'authentification à court terme se met automatiquement à jour."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier les informations de connexion sur l'écran des paramètres et réessayer. L'authentification à court terme se met automatiquement à jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેટિંગ સ્ક્રીન પરના કનેક્શનની માહિતી તપાસો અને ફરી પ્રયાસ કરો. ટૂંકા ગાળાનું પ્રમાણિતકરણ આપોઆપ અપડેટ થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את פרטי החיבור במסך ההגדרות ונסה שוב. אימות קצר מתבצע באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग स्क्रीन पर कनेक्शन की जानकारी जांचें और फिर से प्रयास करें। अल्पकालिक प्रमाणीकरण स्वचालित रूप से नवीनीकृत हो जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite informacije o povezivanju na ekranu postavki i pokušajte ponovno. Kratkotrajno autenticiranje se automatski ažurira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze a beállítások menüjében található kapcsolati információkat, majd próbálja újra. A rövid időszakos engedélyezés automatikusan frissül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa informasi koneksi di layar pengaturan dan coba lagi. Otentikasi singkat akan diperbarui secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificare le informazioni di connessione nel menu delle impostazioni e riprovare. L'autenticazione a breve termine si aggiorna automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定画面の接続情報を確認して再試行してください。短期認証は自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 화면의 연결 정보를 확인하고 다시 시도해 주세요. 단기 인증은 자동으로 갱신됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग स्क्रीनवरील कनेक्शन माहिती तपासा आणि पुन्हा प्रयत्न करा. अल्पकालीन प्रमाणीकरण आपोआप अपडेट होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila semak maklumat sambungan dalam skrin tetapan dan cuba semula. Pengesahan jangka pendek akan diperbaharui secara automatik."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de verbindingsinformatie op het instellingenmenu en probeer opnieuw. Korte authenticatie wordt automatisch vernieuwd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft tilkoblingsinformasjonen i innstillingsmenyen og prøv igjen. Kortvarig autentisering oppdateres automatisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź informacje połączenia w ustawieniach i spróbuj ponownie. Krótkotrwałe uwierzytelnianie jest automatycznie odnawiane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as informações de conexão na tela de configurações e tente novamente. A autenticação temporária é atualizada automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as informações de conexão na tela de configurações e tente novamente. A autenticação temporária é atualizada automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați informațiile de conectare în ecranul de setări și încercați din nou. Autentificarea temporară se va actualiza automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте информацию о подключении в настройках и попробуйте снова. Кратковременная аутентификация автоматически обновляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte informácie o pripojení v nastaveniach a skúste to znova. Krátkodobé overenie sa automaticky obnoví."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite in poskusajte znova. Kratkotrajno avtenticiranje se samodejno osveži."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera anslutningsinformationen i inställningarna och försök igen. Korttidsautentisering uppdateras automatiskt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகள் திரையில் உள்ள இணைப்புத் தகவலைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும். குறுகிய கால அங்கீகாரம் தானாகவே புதுப்பிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్ స్క్రీన్ లోని కనెక్షన్ సమాచారాన్ని తనిఖీ చేసి మళ్ళీ ప్రయత్నించండి. స్వల్పకాలిక ధృవీకరణ ఆటోమేటిక్‌గా అప్‌డేట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาตรวจสอบข้อมูลการเชื่อมต่อในหน้าตั้งค่าและลองใหม่อีกครั้ง การยืนยันแบบชั่วคราวจะมีการอัปเดตโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar ekranındaki bağlantı bilgilerini kontrol edin ve tekrar deneyin. Kısa süreli kimlik doğrulama otomatik olarak güncellenecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте інформацію про підключення на екрані налаштувань і спробуйте ще раз. Короткострокове автентифікація автоматично оновлюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng kiểm tra thông tin kết nối trên màn hình cài đặt và thử lại. Xác thực ngắn hạn sẽ tự động cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查设置界面的连接信息并重新尝试。短期认证会自动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認設定畫面的連接資訊後再嘗試。 短期驗證會自動更新。"
          }
        }
      }
    },
