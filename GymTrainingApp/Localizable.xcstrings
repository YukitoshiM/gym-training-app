        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan membengkokkan punggung terlalu banyak, putar badan ke kiri dan kanan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd overstrekken van de rug en draai het lichaam naar links en rechts."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå å overstrekke ryggen, og vri kroppen til venstre og høyre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj nadmiernego wyginania tułowia i skręcania ciała w bok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não arqueie demais as costas e gire o tronco lateralmente."
