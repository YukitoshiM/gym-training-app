    "health_meals_body_ai.7dca00d85e73": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:633\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "عند العثور على مسار خارجي للركض، سيتم عرض المسافة والسرعة وفرق الارتفاع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan es trobi una carrera a l'aire lliure amb una ruta, es mostrarà la distància, la velocitat i la diferència d'altitud."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud najdete trasu s běháním venku, zobrazí se vzdálenost, rychlost a rozdíl nadmořské výšky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis et løb med GPS-sporing findes, vises distance, hastighed og højdeforskel."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Lauf mit GPS-Daten gefunden wurde, werden Distanz, Geschwindigkeit und Höhenunterschied angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν βρεθεί μια διαδρομή με δυνατότητα τρένου σε εξωτερικό χώρο, εμφανίζονται η απόσταση, η ταχύτητα και η διαφορά υψομέτρου."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If an outdoor run with GPS tracking is found, it will display distance, speed, and elevation change."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If an outdoor run with GPS tracking is found, it will display distance, speed, and elevation change."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If an outdoor run with GPS tracking is found, it will display distance, speed, and elevation change."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "If an outdoor run with GPS tracking is found, it will display distance, speed, and elevation change."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se encuentra una carrera al aire libre con distancia, velocidad y diferencia de elevación, se mostrarán estos datos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se encuentra una carrera al aire libre con distancia, velocidad y diferencia de elevación, se mostrarán estos datos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos löydät reitin ulkoisessa juoksussa, näytetään etäisyys, nopeus ja korkeusero."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une course en extérieur avec un itinéraire est détectée, elle affiche la distance, la vitesse et la différence d'altitude."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une course en extérieur avec un itinéraire est détectée, elle affiche la distance, la vitesse et la différence d'altitude."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમને રૂટ સાથેની આઉટડોર રન મળે, તો અંતર, ઝડપ અને ઊંચાઈના તફાવતને દર્શાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם נמצא ריצה חיצונית עם מיקום, תצוגה של מרחק, מהירות ושינוי גובה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको रूट वाली बाहरी दौड़ मिलती है, तो दूरी, गति और ऊंचाई में अंतर प्रदर्शित करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako pronađete trku u prirodi s određenom udaljenosti, prikazat će se udaljenost, brzina i razliku u nadmorskoj visini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy útvonalon történő kültéri futást talált, megjeleníti a távolságot, sebességet és a magasságkülönbséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika menemukan lari di luar ruangan dengan rute, tampilkan jarak, kecepatan, dan perbedaan ketinggian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se viene rilevata una corsa all'aperto con percorso definito, vengono visualizzati la distanza, la velocità e la variazione di quota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルート付きの屋外ランニングが見つかると、距離・速度・高度差を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이와 함께 야외 달리를 찾으면, 거리・속도・고도 차이를 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर तुम्हाला रूट असलेले (मार्ग असलेला) आऊटडोअर रन सापडले, तर अंतर, वेग आणि उंचीतील फरक दर्शविला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda menemui larian di luar ruangan dengan laluan, ia akan menunjukkan jarak, kelajuan dan perbezaan ketinggian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u een route met buitenlopen vindt, worden afstand, snelheid en hoogteverschil weergegeven."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du finner en løpetur med GPS, vises avstand, hastighet og høydeforskjell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli znajdziesz trasę biegu na świeżym powietrzu, wyświetli się odległość, prędkość i różnica wysokości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontrar uma corrida ao ar livre com rota, exibe distância, velocidade e diferença de altitude."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontrar uma corrida ao ar livre com rota, exibe distância, velocidade e diferença de altitude."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă găsiți o cursă în aer liber cu traseu, afișează distanța, viteza și diferența de altitudine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если найдена тренировка на открытом воздухе с указанием маршрута, отображаются расстояние, скорость и изменение высоты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak nájdete tréning v prírode s trasou, zobrazí vzdialenosť, rýchlosť a rozdiel nadmorskej výšky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če najdete trening z možnostjo vožnje na prostem, boste prikazali razdaljo, hitrost in višinski rozd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du hittar en löprunda utomhus med GPS visas distans, hastighet och höjdskillnad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளியில் ஓடும்போது, பாதையின் தூரம், வேகம் மற்றும் உயர வேறுபாட்டை காண்பிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రూట్ ఉన్న బహిరంగ పరుగును కనుగొంటే, దూరం, వేగం మరియు ఎత్తు వ్యత్యాసాన్ని చూపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากพบการวิ่งกลางแจ้งที่มีเส้นทาง โปรแกรมจะแสดงระยะทาง ความเร็ว และความแตกต่างของระดับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaya koşusu (yol kenarı) bulduğunuzda, mesafe, hız ve yükseklik farkını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо знайдено тренування на відкритому повітрі з маршрутом, відображаються відстань, швидкість та різниця висот."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu tìm thấy hoạt động chạy ngoài trời với lộ trình, ứng dụng sẽ hiển thị khoảng cách, tốc độ và chênh lệch độ cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果找到带有路线的户外跑步，则会显示距离、速度和海拔差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果找到包含路線的戶外跑步，則會顯示距離、速度和高度差。"
          }
        }
      }
    },
