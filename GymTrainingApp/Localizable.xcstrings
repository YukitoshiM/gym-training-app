        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn indicatiewaarden met een lage betrouwbaarheid. Sla deze niet op in uw meetgegevens of grafieken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er kun veiledende verdier. Lagre ikke målinger eller grafer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Są to wartości orientacyjne, które należy traktować z ostrożnością. Nie należy ich zapisywać w wynikach pomiarów ani na wykresach."
