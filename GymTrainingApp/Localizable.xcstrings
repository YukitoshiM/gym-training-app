        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड को एक साथ और अगले कार्य और अगले महीने के लक्ष्यों का सुझाव दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predloži sljedeće aktivnosti i ciljeve za naredni mjesec na temelju zabilježene aktivnosti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javasold a következő tevékenységet és az idei célokat a rögzített adatok alapján"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyarankan tindakan selanjutnya dan target bulan berikutnya berdasarkan catatan"
