        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Health non autorisé, seul l'historique des applications est sauvegardé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હેલ્થ પરવાનગી ન મળી - ફક્ત એપ્લિકેશન હિસ્ટ્રી સેવ કરેલી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מאפשר שמירה של בריאות, רק היסטוריית אפליקציה שומרת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वास्थ्य डेटा सहेजने की अनुमति नहीं है, केवल ऐप इतिहास सहेजा गया है।"
