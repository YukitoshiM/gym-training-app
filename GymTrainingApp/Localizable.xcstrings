        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड सहेजे गए हैं। आप बाद में कनेक्ट होने के बाद इसे फिर से जेनरेट कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis je spremljen. Možete ga ponovno generirati nakon što se ponovo povežete."
