    "domain_catalog.818335950a33": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:491\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من وزنك ومقدار تدريب العضلات ومستوى التعب والنوم. في الأيام التي يكون فيها التعب مرتفعًا، يكون التصميم بحيث لا تقوم بالتمدد بقوة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comproveu el vostre pes, la quantitat d'entrenament muscular, el nivell de fatiga i el son. Els dies en què la fatiga és alta, el disseny és tal que no us estireu massa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte svou hmotnost, objem tréninku, úroveň únavy a spánku. V dnech s vysokou úrovní únavy navrhněte, aby se nemusely nutně zvyšovat hodnoty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se din vægt, mængden af styrketræning, træthedsniveau og søvn. Design appen, så den ikke tvinger dig til at træne, når du er meget træt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Gewicht, Trainingsmenge, Erschöpfungsgrad und Schlaf anzeigen. Das System ist so konzipiert, dass es an Tagen mit hohem Erschöpfungsgrad nicht versucht, Ihr Ziel unnötig zu steigern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε το βάρος, την ποσότητα των ασκήσεων και το επίπεδο κόπωσης, καθώς και τον ύπνο σας. Σχεδιάστε έτσι ώστε να μην αναγκάζεστε να αυξήσετε τα βάρη όταν είστε πολύ κουρασμένοι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, muscle training volume, fatigue level, and sleep quality. Design it so that you don't push yourself too hard when you are fatigued."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, muscle training volume, fatigue level, and sleep quality. Design it so that you don't push yourself too hard when you are fatigued."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, muscle training volume, fatigue level, and sleep quality. Design it so that you don't push yourself too hard when you are fatigued."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, muscle training volume, fatigue level, and sleep quality. Design it so that you don't push yourself too hard when you are fatigued."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa tu peso, cantidad de entrenamiento, nivel de fatiga y calidad del sueño. Diseña para que no fuerces el aumento en días de alta fatiga."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa tu peso, cantidad de entrenamiento, nivel de fatiga y calidad del sueño. Diseña para que no fuerces el aumento en días de alta fatiga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastele painoa, lihasharjoittelun määrää ja väsymystasoa sekä unta. Suunnittele, että jos olet hyvin väsynyt, et pakota itseäsi harjoittamaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser votre poids, le volume de musculation, votre niveau de fatigue et votre sommeil. Concevoir pour ne pas forcer les jours où la fatigue est élevée."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser votre poids, le volume de musculation, votre niveau de fatigue et votre sommeil. Concevoir pour ne pas forcer les jours où la fatigue est élevée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન, સ્નાયુ તાલીમનું પ્રમાણ, થાક અને ઊંઘ જુઓ. જ્યારે થાક વધારે હોય ત્યારે બિનજરૂરી રીતે વધારવાનું ટાળો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את המשקל, כמות אימוני הכוח ומצב עייפות ושינה. תכננו כך שאם העייפות גבוהה, לא תצטרכו להגדיל באופן מלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वजन, मांसपेशियों के व्यायाम की मात्रा, थकान, और नींद को देखें। जब थकान अधिक हो तो जबरदस्ती बढ़ाने से बचने के लिए डिज़ाइन करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte svoju težinu, količinu treninga, razinu umora i kvalitetu sna. U danima visokog umora, osigurajte da se ne morate prisiljavati na veći napor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg a testsúlyt, az izomterápia mennyiségét és a fáradtságot, valamint a pihenést. Ha nagyon fáradt vagy, tervezd úgy, hogy ne próbálj túl nagy terheléshez alkalmazkodni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berat badan, jumlah latihan, tingkat kelelahan, dan kualitas tidur. Rancang agar tidak memaksa meningkatkan berat badan saat kelelahan tinggi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizzare il peso, la quantità di allenamento, il livello di affaticamento e le ore di sonno. Progettare in modo da non forzare l'aumento nei giorni di elevato affaticamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重、筋トレ量、疲労度、睡眠を見ます。疲労が高い日は無理に伸ばさない設計にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸무게, 근력 운동량, 피로도, 수면 상태를 확인합니다. 피로도가 높을 때는 무리하게 늘리지 않도록 설계합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, स्नायूंचा व्यायाम, थकवा आणि झोप यांचा मागोवा घ्या. जास्त थकवा जाणवत असल्यास, जबरदस्तीने वाढ करण्याऐवजी, आराम करण्यासाठी डिझाइन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berat badan, kuantiti latihan, tahap keletihan, dan tidur. Rangkaikan supaya anda tidak perlu memaksa diri jika tahap keletihan tinggi."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je gewicht, hoeveelheid krachttraining, vermoeidheidsniveau en slaap. Ontwerp het zo dat je niet gedwongen wordt om te trainen als je erg moe bent."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på vekt, mengde trening, og hvor sliten du er. Designet for å unngå å presse deg for hardt når du er veldig sliten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź wagę, ilość treningów, poziom zmęczenia i jakość snu. W dniach o wysokim poziomie zmęczenia, zaprojektuj aplikację tak, aby nie wymuszała dalszego ćwiczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja seu peso, volume de treino, nível de fadiga e sono. Projete o sistema para não forçar em dias de alta fadiga."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja seu peso, volume de treino, nível de fadiga e sono. Projete o sistema para não forçar em dias de alta fadiga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi greutatea, volumul de antrenament, nivelul de oboseală și calitatea somnului. Proiectează-o astfel încât să nu forțezi exercițiile în zilele cu oboseală mare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите свой вес, количество силовых тренировок и уровень усталости. В дни высокой усталости, не заставляйте себя чрезмерно тренироваться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite si svoju hmotnosť, objem tréningu, úroveň únavy a spánok. V dňoch s vysokou úrovňou únavy navrhujeme, aby ste sa nenechali nútiť k cvičeniu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledajte svojo težo, količino treninga, raven utrujenosti in spanja. V dneh z visoko utrujenostjo, zasnovajte, da ne boste nujno poskušali doseči novih rezultatov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se din vikt, mängd styrketräning, trötthetsnivå och sömn. Designa för att inte pressa dig på dagar då du är väldigt trött."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடை, தசைக் கட்டுப் பயிற்சி அளவு, சோர்வு மற்றும் தூக்கத்தை கண்காணிக்கவும். அதிக சோர்வு ஏற்படும் நாட்களில், தானாகவே அளவை குறைக்க வடிவமைக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు, కండరాల వ్యాయామ పరిమాణం, అలసట మరియు నిద్రను చూడండి. అలసట ఎక్కువగా ఉన్న రోజుల్లో, అనవసరంగా పెంచకుండా ఉండేలా రూపొందించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูน้ำหนัก, ปริมาณการฝึก, ระดับความเหนื่อย, และคุณภาพการนอนหลับ ออกแบบให้ไม่บังคับเมื่อรู้สึกเหนื่อยมากเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık, egzersiz miktarı, yorgunluk seviyesi, uyku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте свою вагу, об’єм силових тренувань та рівень втоми. Спроектуйте програму так, щоб у дні високої втоми не було необхідності надмірно навантажуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem cân nặng, khối lượng tập, mức độ mệt mỏi và thời gian ngủ. Thiết kế để không ép khi mức độ mệt mỏi cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看体重、力量训练量、疲劳程度和睡眠情况。在疲劳严重时，采用不强迫增加的设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀察體重、肌力訓練量、疲勞程度和睡眠狀況。在疲勞較高的日子，設計成不強迫增加體重的模式。"
          }
        }
      }
    },
    "domain_catalog.8184e17f695d": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:494\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الشريط إلى اليسار واليمين مع إبقاء ذراعيك ممدودتين، باستخدام الجزء الخلفي من كتفيك وظهرك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obriu la banda cap a l'esquerra i la dreta mantenint els braços estesos, utilitzant la part posterior de les espatlles i l'esquena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozepněte gumovou pásku vpravo a vlevo, přičemž využijte ramena a záda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold armene udstrakt og åbn håndledsremmen til venstre og højre ved hjælp af skuldrene og ryggen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arme ausgestreckt halten und das Band seitlich öffnen, wobei die Schulter- und Rückenmuskulatur beansprucht wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά από τεντωμένα χέρια, ανοίξτε τον ιμάντα στα δεξιά και αριστερά χρησιμοποιώντας τους ώμους και την πλάτη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your arms and use your shoulders and back to open the resistance band to the left and right."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your arms and use your shoulders and back to open the resistance band to the left and right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your arms and use your shoulders and back to open the resistance band to the left and right."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your arms and use your shoulders and back to open the resistance band to the left and right."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende los brazos y abre la banda a ambos lados, utilizando los hombros y la espalda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Extiende los brazos y abre la banda a ambos lados, utilizando los hombros y la espalda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa rannekeet sivusuunnassa pitämällä käsiä suorina ja käytä hartioita ja selkää."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendez vos bras et ouvrez le élastique de chaque côté, en utilisant ainsi les épaules et le dos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendez vos bras et ouvrez le élastique de chaque côté, en utilisant ainsi les épaules et le dos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને સીધા રાખીને, બેન્ડને ડાબે-જમણે ખોલો, અને ખભાના પાછળના ભાગ અને espaldaનો ઉપયોગ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להישיר את הידיים ולהפעיל רצועה מצד לצד, תוך שימוש בשרירי הכתפיים והגב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी बाहों को सीधा रखते हुए, बैंड को बाएं और दाएं ओर खोलें, और अपनी पीठ और कंधों का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite ruke ispružene i otvarajte traku prema lijevoj i desnoj strani, koristeći mišiće ramena i leđa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyitd ki a gumit a karoddal balra és jobbra, miközben a vállaidat és hátadat használod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat lengan terentang, buka pita ke kiri dan kanan menggunakan bahu dan punggung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allungare le braccia e aprire la fascia elastica lateralmente, utilizzando i muscoli della spalla e della schiena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕を伸ばしたままバンドを左右に開き、肩後部と背中を使う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔을 쭉 뻗은 채로 밴드를 좌우로 벌리고, 어깨 뒤쪽과 등을 사용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हात सरळ ठेवून दोरीला डावीकडे-उजवीकडे ओढा, ज्यामुळे खांद्यांचा आणि पाठीचा कणा यांचा वापर होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentangkan lengan, buka gelang ke kiri dan kanan menggunakan bahu dan belakang badan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Breid je armen uit en gebruik je schouders en rug om het touw naar links en rechts te bewegen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold armene utstrakt og åpne båndet fra side til side ved hjelp av skuldrene og ryggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozciągnij ramiona i otwórz gumę w lewo i prawo, wykorzystując mięśnie barków i pleców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os braços estendidos e abra a faixa para os lados, usando os ombros e as costas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os braços estendidos e abra a faixa para os lados, usando os ombros e as costas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întindeți brațele și deschideți banda lateral, utilizând umerii și spatele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположите эластичную ленту по бокам, держа руки вытянутыми, используя мышцы плеч и спины."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmote ruku a spáť zdvihnite činku, využívajúc ramenné svaly a zad."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raztegnete roke in z gumo razgibate ramo in hrbet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sträcka ut armarna och öppna bandet åt vänster och höger, använd axlarna och ryggen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கைகளை நீட்டி, பெண்டில்-ஐ இடது மற்றும் வலது பக்கமாக திறந்து, உங்கள் தோள்பட்டை மற்றும் முதுகை பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులను చాపి, బ్యాండ్‌ను ఎడమ మరియు కుడి వైపుకు తెరిచి, భుజం వెనుక భాగం మరియు వెన్నును ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยายแขน, ดึงแถบไปด้านซ้ายและขวา โดยใช้กล้ามเนื้อหลังและไหล่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolunu uzatarak, bandı sol ve sağa doğru açarak omuz arkasını ve sırtını kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримаючи руки прямими, відкривайте гумку вліво і вправо, використовуючи плечі та спину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khuỷu tay thẳng, mở băng ra trái hoặc phải bằng cách sử dụng vai và lưng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手臂伸直，然后左右打开手腕，利用肩后部和背部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持手臂伸直，然後左右拉開束帶，利用肩後部和背部。"
          }
        }
      }
    },
