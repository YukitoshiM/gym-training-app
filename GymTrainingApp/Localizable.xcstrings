    "health_meals_body_ai.51e5b8720d81": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:321\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الكمية المتبقية من البروتين بناءً على هدفك وسجل الطعام اليوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la quantitat restant de proteïnes en funció del vostre objectiu i del registre d'aliments d'avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě vašeho cíle a záznamu o jídle zobrazuje zbývající množství bílkovin."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på dit mål og din daglige kostregistrering, viser vi det resterende proteinindhold."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf Ihrem Ziel und Ihren heutigen Essensprotokollen wird der verbleibende Proteinbedarf angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει την υπόλοιπη ποσότητα πρωτεΐνης, βάσει του στόχου και των ημερήσιων καταγραφών διατροφής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the remaining protein based on your goals and today's food log."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the remaining protein based on your goals and today's food log."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the remaining protein based on your goals and today's food log."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the remaining protein based on your goals and today's food log."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la cantidad restante de proteínas según tu objetivo y registro de comidas del día."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la cantidad restante de proteínas según tu objetivo y registro de comidas del día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään jäljellä oleva proteiinimäärä tavoitteen ja tämän päivän ruokapäiväkirjan perusteella."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En fonction de votre objectif et de vos repas, nous affichons la quantité de protéines restante."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En fonction de votre objectif et de vos repas, nous affichons la quantité de protéines restante."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ધ્યેય અને આજની આહાર રેકોર્ડના આધારે, બાકી પ્રોટીનની માત્રા દર્શાવવામાં આવી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערך המטרה והרשומת הארוחה של היום מציגים את כמות החלבון הנותרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य और आज के भोजन लॉग से, शेष प्रोटीन की मात्रा प्रदर्शित होती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na temelju cilja i dnevnog bilježnika hrane, prikazuje se preostalo proteina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A cél és a mai étkezési napló alapján megjeleníti a megmaradt fehérje mennyiséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari target dan catatan makanan Anda hari ini, kami menampilkan sisa protein yang tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base al tuo obiettivo e ai tuoi appunti alimentari odierni, viene visualizzata la quantità rimanente di proteine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標と今日の食事記録から、残りのタンパク質量を表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표와 오늘의 식사 기록에서, 남은 단백질 양을 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या लक्ष्याच्या आधारावर आणि आजच्या जेवणाच्या नोंदीनुसार, किती प्रथिने शिल्लक आहेत हे दर्शवते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia menunjukkan jumlah protein yang tinggal berdasarkan matlamat dan catatan makanan anda hari ini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van uw doel en uw dagelijkse voedingslogboek, wordt de resterende hoeveelheid eiwit weergegeven."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Basert på målet ditt og dagens matlogg, viser vi hvor mye protein du har igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie Twojego celu i dzisiejszego dziennika żywieniowego, wyświetlam pozostałą ilość białka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base no seu objetivo e no registro da sua refeição, mostra a quantidade restante de proteína."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base no seu objetivo e no registro da sua refeição, mostra a quantidade restante de proteína."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe baza obiectivului și a înregistrărilor alimentare de astăzi, afișăm cantitatea rămasă de proteine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображает оставшееся количество белка на основе вашей цели и записи о еде сегодня."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe vašich cieľov a denného záznamu o strave, zobrazuje zostatok bielkovín."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi cilja in dnevnih zapis o prehrani prikazuje preostanek beljakovin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat på ditt mål och dagens måltidslogg visas mängden protein som återstår."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் குறிக்கோள் மற்றும் இன்றைய உணவு பதிவுகளின் அடிப்படையில், மீதமுள்ள புரத அளவைக் காண்பிக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లక్ష్యం మరియు ఈరోజు ఆహార రికార్డు నుండి, మిగిలిన ప్రోటీన్ పరిమాణాన్ని చూపుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงปริมาณโปรตีนที่เหลือ โดยอิงจากเป้าหมายและบันทึกอาหารของคุณในวันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefiniz ve gün içindeki beslenme kaydı ile kalan protein miktarını gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі вашої цілі та записів про харчування сьогодні, відображається залишок білка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị lượng protein còn lại dựa trên mục tiêu và nhật ký ăn uống ngày hôm nay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据目标和今天的饮食记录，显示剩余蛋白质量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據目標和今天的飲食記錄，顯示剩餘蛋白質。"
          }
        }
      }
