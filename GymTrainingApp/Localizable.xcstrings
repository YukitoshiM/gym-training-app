    "health_meals_body_ai.4047b572f3a1": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift:562\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم API يستجيب، لكن النموذج المساعد للطهي/التقرير غير متوفر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor API respon, però el model auxiliar de cuina/informes no està disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server API reaguje, ale nemůžete použít modely pro pomoc s recepty a reporty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "API-serveren svarer, men modellen til mad og rapporter kan ikke bruges."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Server antwortet, aber das Modell zur Unterstützung bei Rezepten und Berichten ist nicht verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομισός API απαντά, αλλά δεν μπορεί να χρησιμοποιήσει τα μοντέλα για βοήθεια στην προετοιμασία φαγητού και τη δημιουργία αναφορών."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the cooking/report assistance model."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the cooking/report assistance model."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the cooking/report assistance model."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server is responding, but cannot use the cooking/report assistance model."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de API responde, pero no puede utilizar los modelos para recetas o informes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de API responde, pero no puede utilizar los modelos para recetas o informes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "API-palvelin vastaa, mutta ruoan ja raporttien apumalleja ei ole käytettävissä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur API répond, mais les modèles d'aide à la cuisine et aux rapports ne sont pas disponibles."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur API répond, mais les modèles d'aide à la cuisine et aux rapports ne sont pas disponibles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "API સર્વર પ્રતિસાદ આપી રહ્યું છે, પરંતુ રસોઈ અને રિપોર્ટ માટેના મોડેલ ઉપલબ્ધ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת ה-API מגיב, אך אי אפשר להשתמש במודלים לסיוע ביצירת מתכונים ודוחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API सर्वर प्रतिक्रिया दे रहा है, लेकिन खाना पकाने और रिपोर्टिंग के लिए सहायक मॉडल उपलब्ध नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Server API odgovara, ali ne može koristiti modele za pomoć u pripremi hrane i izvještajima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az API szerver válaszol, de a konyhával és jelentésekkel kapcsolatos model nem elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server API merespons, tetapi tidak dapat menggunakan model untuk bantuan memasak atau laporan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server API risponde, ma non è possibile utilizzare i modelli per la preparazione dei pasti o per la creazione di report."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIサーバーは応答していますが、料理・レポートの補助モデルを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 서버는 응답하지만, 요리 및 보고서 보조 모델을 사용할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "API सर्व्हर प्रतिसाद देत आहे, परंतु जेवण आणि अहवालासाठी सहाय्यक मॉडेल उपलब्ध नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan API berfungsi, tetapi tidak dapat menggunakan model untuk bantuan masakan dan laporan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De API-server reageert, maar het model voor recepten en rapporten kan niet worden gebruikt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "API-serveren svarer, men du kan ikke bruke modellene for matlaging og rapportering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer API odpowiada, ale nie można wykorzystać modeli do pomocy w przygotowywaniu posiłków i tworzeniu raportów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor API está respondendo, mas não consegue utilizar o modelo para receitas e relatórios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor API está respondendo, mas não consegue utilizar o modelo para receitas e relatórios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul API răspunde, dar nu poate utiliza modelul pentru ajutor în gătit sau raportare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-сервер отвечает, но недоступны модели для помощи в приготовлении пищи и составлении отчетов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "API server odpovedá, ale nemôžete použiť modely pre prípravu jedál a generovanie reportov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Streznik API je na voljo, vendar ne morete uporabiti modelov za pomoč pri pripravi hrane ali poročanju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "API-servern svarar, men kan inte använda modellerna för mat och rapporter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "API சர்வர் பதிலளிக்கிறது, ஆனால் சமையல் மற்றும் அறிக்கையிடலுக்கான மாதிரியைப் பயன்படுத்த முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "API సర్వర్ ప్రతిస్పందిస్తోంది, వంట మరియు నివేదిక సహాయక మోడల్‌ను ఉపయోగించలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ API ตอบสนอง แต่ไม่สามารถใช้โมเดลสำหรับการทำอาหารและรายงานได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API sunucusu yanıt vermektedir, ancak yemek ve raporlama için yardımcı modeller kullanılabilir değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "API-сервер відповідає, але не може використовувати моделі для приготування їжі та створення звітів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ API đang phản hồi, nhưng không thể sử dụng mô hình hỗ trợ nấu ăn và báo cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API服务器正在响应，但无法使用烹饪和报告辅助模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API伺服器已回應，但無法使用食譜和報告輔助模型。"
          }
        }
      }
    },
    "health_meals_body_ai.4060e1dc437c": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:245\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الحصول على بيانات النوم. لا تقم بتقييم القيم التي لم يتم الحصول عليها على أنها 0."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han obtingut dades de son. No avalueu els valors no obtinguts com a 0."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsou k dispozici žádná data o spánku. Hodnotíme hodnotu 0, pokud nejsou k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søvndata er ikke tilgængelig. Værdien 0 bruges ikke for manglende data."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegen keine Schlafdaten vor. Nicht erfasste Werte werden als 0 gewertet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν δεδομένα ύπνου. Δεν αξιολογούνται οι μη διαθέσιμες τιμές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep data has not been obtained. We will not evaluate the missing value as 0."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep data has not been obtained. We will not evaluate the missing value as 0."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep data has not been obtained. We will not evaluate the missing value as 0."
