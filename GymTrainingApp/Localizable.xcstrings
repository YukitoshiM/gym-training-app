        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка є приблизною. Ви можете вільно редагувати значення в нижньому полі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị ước tính là giá trị tham khảo. Bạn có thể tự do chỉnh sửa trong ô nhập bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
