            "value": "Er zijn geen dagelijkse gegevens om te vergelijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen daglige data for sammenligning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak możliwości porównania danych z jednego dnia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há dados diários comparáveis"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há dados diários comparáveis"
          }
        },
        "ro": {
