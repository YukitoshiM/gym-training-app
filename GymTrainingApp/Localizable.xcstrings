    "core_ui.5882525e2748": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:391",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحفظ على جهازك إلا أنواع الميزات التي تستخدمها. لا يتم تسجيل الوزن أو الصور أو تفاصيل الوجبات أو نبض القلب أو الموقع أو الملاحظات، ولا تُرسل تلقائيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només es desen al dispositiu els tipus de funcions que utilitzes. El pes, les fotos, els detalls dels àpats, la freqüència cardíaca, la ubicació i les notes no es registren ni s'envien automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V zařízení se ukládají pouze typy funkcí, které používáte. Hmotnost, fotografie, podrobnosti jídel, tepová frekvence, poloha a poznámky se nezaznamenávají ani automaticky neodesílají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de typer funktioner, du bruger, gemmes på din enhed. Vægt, billeder, måltidsoplysninger, puls, placering og noter registreres eller sendes ikke automatisk."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Gerät werden nur die verwendeten Funktionstypen gespeichert. Gewicht, Fotos, Mahlzeitendetails, Herzfrequenz, Standort und Notizen werden weder erfasst noch automatisch gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη συσκευή αποθηκεύονται μόνο οι τύποι λειτουργιών που χρησιμοποιείς. Βάρος, φωτογραφίες, λεπτομέρειες γευμάτων, καρδιακός ρυθμός, τοποθεσία και σημειώσεις δεν καταγράφονται ούτε αποστέλλονται αυτόματα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the types of features you use are stored on your device. Weight, photos, meal details, heart rate, location, and notes are not recorded or sent automatically."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the types of features you use are stored on your device. Weight, photos, meal details, heart rate, location, and notes are not recorded or sent automatically."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the types of features you use are stored on your device. Weight, photos, meal details, heart rate, location, and notes are not recorded or sent automatically."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the types of features you use are stored on your device. Weight, photos, meal details, heart rate, location, and notes are not recorded or sent automatically."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan en tu dispositivo los tipos de funciones que utilizas. El peso, las fotos, los detalles de comidas, la frecuencia cardiaca, la ubicación y las notas no se registran ni se envían automáticamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan en tu dispositivo los tipos de funciones que utilizas. El peso, las fotos, los detalles de comidas, la frecuencia cardiaca, la ubicación y las notas no se registran ni se envían automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laitteeseesi tallennetaan vain käyttämiesi toimintojen tyypit. Painoa, kuvia, ateriatietoja, sykettä, sijaintia ja muistiinpanoja ei kirjata eikä lähetetä automaattisesti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les types de fonctions utilisés sont stockés sur votre appareil. Le poids, les photos, le détail des repas, la fréquence cardiaque, la position et les notes ne sont ni enregistrés ni envoyés automatiquement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les types de fonctions utilisés sont stockés sur votre appareil. Le poids, les photos, le détail des repas, la fréquence cardiaque, la position et les notes ne sont ni enregistrés ni envoyés automatiquement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપકરણમાં ફક્ત તમે વાપરેલી સુવિધાના પ્રકારો સાચવાય છે. વજન, ફોટા, ભોજનની વિગતો, હૃદયગતિ, સ્થાન અને નોંધો રેકોર્ડ કે આપમેળે મોકલાતાં નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק סוגי התכונות שבהם נעשה שימוש נשמרים במכשיר. משקל, תמונות, פרטי ארוחות, דופק, מיקום והערות אינם נרשמים או נשלחים אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके उपयोग किए गए फ़ीचर के केवल प्रकार डिवाइस पर सहेजे जाते हैं। वज़न, फ़ोटो, भोजन का विवरण, हृदय गति, स्थान और नोट रिकॉर्ड या अपने-आप नहीं भेजे जाते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na uređaju se spremaju samo vrste značajki koje koristite. Težina, fotografije, detalji obroka, puls, lokacija i bilješke ne bilježe se niti se automatski šalju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a használt funkciók típusát tároljuk az eszközödön. A testsúly, a fotók, az étkezések részletei, a pulzus, a hely és a jegyzetek nem kerülnek rögzítésre vagy automatikus elküldésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jenis fitur yang Anda gunakan yang disimpan di perangkat. Berat badan, foto, detail makanan, detak jantung, lokasi, dan catatan tidak direkam atau dikirim secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul dispositivo vengono salvati solo i tipi di funzioni usate. Peso, foto, dettagli dei pasti, frequenza cardiaca, posizione e note non vengono registrati né inviati automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使った機能の種類だけを端末内に保存します。体重、写真、食事内容、心拍、位置、メモは記録せず、自動送信もしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용한 기능의 종류만 기기에 저장됩니다. 체중, 사진, 식사 내용, 심박수, 위치, 메모는 기록되거나 자동 전송되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही वापरलेल्या वैशिष्ट्यांचे प्रकारच डिव्हाइसवर जतन केले जातात. वजन, फोटो, जेवणाचा तपशील, हृदयगती, स्थान आणि नोंदी रेकॉर्ड केल्या जात नाहीत किंवा आपोआप पाठवल्या जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jenis ciri yang anda gunakan disimpan pada peranti. Berat, foto, butiran hidangan, kadar denyutan jantung, lokasi dan nota tidak direkodkan atau dihantar secara automatik."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de typen functies die je gebruikt, worden op je apparaat opgeslagen. Gewicht, foto's, maaltijdgegevens, hartslag, locatie en notities worden niet geregistreerd of automatisch verzonden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare typene funksjoner du bruker, lagres på enheten. Vekt, bilder, måltidsdetaljer, puls, posisjon og notater registreres eller sendes ikke automatisk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na urządzeniu zapisywane są tylko typy używanych funkcji. Masa ciała, zdjęcia, szczegóły posiłków, tętno, lokalizacja i notatki nie są zapisywane ani automatycznie wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os tipos de recursos usados são armazenados no dispositivo. Peso, fotos, detalhes das refeições, frequência cardíaca, localização e notas não são registrados nem enviados automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os tipos de funcionalidades usados são armazenados no dispositivo. Peso, fotos, detalhes das refeições, frequência cardíaca, localização e notas não são registados nem enviados automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar tipurile de funcții pe care le folosești sunt salvate pe dispozitiv. Greutatea, fotografiile, detaliile meselor, pulsul, locația și notițele nu sunt înregistrate sau trimise automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве сохраняются только типы используемых функций. Вес, фотографии, сведения о питании, пульс, местоположение и заметки не записываются и не отправляются автоматически."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V zariadení sa ukladajú iba typy funkcií, ktoré používate. Hmotnosť, fotografie, podrobnosti jedál, tepová frekvencia, poloha a poznámky sa nezaznamenávajú ani automaticky neodosielajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V napravi se shranijo samo vrste funkcij, ki jih uporabljate. Teža, fotografije, podrobnosti obrokov, srčni utrip, lokacija in opombe se ne beležijo ali samodejno pošiljajo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast typerna av funktioner du använder sparas på enheten. Vikt, bilder, måltidsuppgifter, puls, plats och anteckningar registreras eller skickas inte automatiskt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பயன்படுத்தும் அம்சங்களின் வகைகள் மட்டுமே சாதனத்தில் சேமிக்கப்படும். எடை, புகைப்படங்கள், உணவு விவரங்கள், இதயத் துடிப்பு, இருப்பிடம் மற்றும் குறிப்புகள் பதிவு செய்யப்படவோ தானாக அனுப்பப்படவோ மாட்டாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఉపయోగించే ఫీచర్ల రకాలు మాత్రమే పరికరంలో సేవ్ అవుతాయి. బరువు, ఫోటోలు, భోజన వివరాలు, హృదయ స్పందన, స్థానం మరియు నోట్లు రికార్డ్ చేయబడవు లేదా ఆటోమేటిక్‌గా పంపబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบจะเก็บเฉพาะประเภทฟีเจอร์ที่คุณใช้ไว้ในอุปกรณ์ โดยจะไม่บันทึกหรือส่งน้ำหนัก รูปภาพ รายละเอียดอาหาร อัตราการเต้นหัวใจ ตำแหน่ง และบันทึกย่อโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kullandığın özellik türleri cihazında saklanır. Kilo, fotoğraflar, öğün ayrıntıları, kalp atış hızı, konum ve notlar kaydedilmez veya otomatik gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На пристрої зберігаються лише типи використовуваних функцій. Вага, фотографії, відомості про харчування, пульс, розташування та нотатки не записуються й не надсилаються автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ loại tính năng bạn dùng được lưu trên thiết bị. Cân nặng, ảnh, chi tiết bữa ăn, nhịp tim, vị trí và ghi chú không được ghi lại hoặc tự động gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备内只保存你使用过的功能类型。不会记录或自动发送体重、照片、餐食详情、心率、位置和备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置內只儲存你使用過的功能類型。不會記錄或自動傳送體重、照片、餐點內容、心率、位置與備註。"
          }
        }
      }
    },
