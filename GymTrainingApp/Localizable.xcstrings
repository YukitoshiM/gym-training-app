    "domain_catalog.b1f2c64a95cc": {
      "comment": "GymTrainingApp/Domain/AIModels.swift:66\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إدارة وجهة الاتصال ومعلومات المصادقة بواسطة BodyMode. لا يتم عرض عنوان الاتصال على الشاشة أو في سجل التشخيص."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode gestionarà la destinació de la connexió i la informació d'autenticació. L'adreça de connexió no es mostra a la pantalla ni al registre de diagnòstic."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode spravuje připojení a informace pro ověření. Na obrazovce ani v logu diagnostiky nezobrazuje adresu připojení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode håndterer forbindelses- og autentificeringsoplysninger. Adressen vises ikke på skærmen eller i logfiler."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode verwaltet Verbindungs- und Authentifizierungsinformationen. Die Bildschirm- oder Diagnoseprotokolle zeigen keine Verbindungsinformationen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διευθύνσεις σύνδεσης και οι πληροφορίες ελέγχου διαχειρίζονται από την εφαρμογή BodyMode. Στις οθόνες ή στα αρχεία καταγραφής δεν εμφανίζονται διευθύνσεις σύνδεσης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode manages the connection and authentication information. It does not display the connection address on the screen or in diagnostic logs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode manages the connection and authentication information. It does not display the connection address on the screen or in diagnostic logs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode manages the connection and authentication information. It does not display the connection address on the screen or in diagnostic logs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode manages the connection and authentication information. It does not display the connection address on the screen or in diagnostic logs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode gestiona la información de conexión y autenticación. No muestra la dirección de conexión en la pantalla ni en los registros de diagnóstico."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode gestiona la información de conexión y autenticación. No muestra la dirección de conexión en la pantalla ni en los registros de diagnóstico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode hallinnoi yhteydenottotietoja ja tunnistautumistietoja. Yhteydenottosoitteita ei näytetä käyttöliittymässä tai diagnosointilohkoissa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode gère les informations de connexion et d'authentification. L'adresse de connexion n'est pas affichée sur l'écran ou dans les journaux de diagnostic."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode gère les informations de connexion et d'authentification. L'adresse de connexion n'est pas affichée sur l'écran ou dans les journaux de diagnostic."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંડા અને પ્રમાણીકરણની માહિતી BodyMode દ્વારા સંચાલિત કરવામાં આવશે. સ્ક્રીન અથવા ડાયગ્નોસ્ટિક લોગમાં કનેક્શન એડ્રેસ દર્શાવવામાં આવશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode מנהלת את פרטי החיבור והאימות. לא מוצגים כתובות חיבור על המסך או בלוגים של אבחון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन और प्रमाणीकरण जानकारी BodyMode द्वारा प्रबंधित की जाती है। स्क्रीन या डायग्नोस्टिक लॉग पर कनेक्शन एड्रेस प्रदर्शित नहीं किया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode upravlja podacima za povezivanje i autentifikaciju. Na ekranu ili logovima dijagnosticiranja ne prikazuje adresu veze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kapcsolati és hitelesítő információkat a BodyMode kezeli. A képernyőn vagy diagnosztikai naplóban nem jeleníti meg a kapcsolódási címet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode mengelola informasi koneksi dan autentikasi. Alamat koneksi tidak ditampilkan di layar atau log diagnostik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode gestisce le informazioni di connessione e autenticazione. Non visualizza l'indirizzo di connessione sullo schermo o nei log diagnostici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続先と認証情報はBodyModeが管理します。画面や診断ログには接続アドレスを表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정보 및 인증 정보는 BodyMode에서 관리합니다. 화면이나 진단 로그에는 연결 주소를 표시하지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन आणि प्रमाणीकरण माहिती BodyMode द्वारे नियंत्रित केली जाईल. स्क्रीन किंवा निदान नोंदीमध्ये कनेक्शन ॲड्रेस दर्शविला जाणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklumat sambungan dan pengesahan dikendalikan oleh BodyMode. Alamat sambungan tidak dipaparkan pada skrin atau log diagnosis."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding en authenticatie-informatie worden beheerd door BodyMode. Het toont geen verbindingsadres op het scherm of in de diagnose-logs."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode administrerer tilkoblings- og autentiseringsinformasjonen. Vi viser ikke tilkoblingsadressen på skjermen eller i loggfiler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode zarządza danymi połączenia i uwierzytelniania. Adres połączenia nie jest wyświetlany na ekranie ani w dziennikach diagnostycznych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O BodyMode gerencia as informações de conexão e autenticação. Não exibe o endereço de conexão na tela ou nos logs de diagnóstico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O BodyMode gerencia as informações de conexão e autenticação. Não exibe o endereço de conexão na tela ou nos logs de diagnóstico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode gestionează adresa de conectare și informațiile de autentificare. Nu afișează adresa de conectare pe ecran sau în jurnalele de diagnostic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode управляет информацией о подключении и аутентификации. Адрес подключения не отображается на экране или в логах диагностики."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode spravuje pripojené zariadenie a informácie na overenie. Na obrazovke ani v zázname diagnostiky nezobrazuje adresu pripojenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode upravlja povezave in informacije za avtenticacijo. Na zaslonu ali v logih ne prikazuje naslova povezave."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode hanterar anslutnings- och autentiseringsinformationen. Adressen visas inte på skärmen eller i loggfiler."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்பு மற்றும் அங்கீகார தகவல்களை BodyMode நிர்வகிக்கிறது. திரையில் அல்லது கண்டறியும் பதிவுகளில் இணைப்பு முகவரியைக் காட்டாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనెక్షన్ మరియు ప్రమాణీకరణ సమాచారం BodyMode ద్వారా నిర్వహించబడుతుంది. స్క్రీన్ లేదా డయాగ్నస్టిక్ లాగ్‌లలో కనెక్షన్ చిరునామాను ప్రదర్శించము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลการเชื่อมต่อและข้อมูลประจำตัวจะถูกจัดการโดย BodyMode หน้าจอหรือบันทึกการวินิจฉัยจะไม่แสดงที่อยู่ในการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı ve kimlik bilgileri BodyMode tarafından yönetilir. Ekran veya tanı loglarında bağlantı adresini göstermiyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація про підключення та автентифікацію зберігається в BodyMode. Адреса підключення не відображається на екрані або в логах діагностики."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin kết nối và xác thực do BodyMode quản lý. Ứng dụng không hiển thị địa chỉ kết nối trên màn hình hoặc nhật ký chẩn đoán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode 会管理连接信息和认证信息。屏幕和诊断日志不会显示连接地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BodyMode會管理連線資訊和驗證資訊。螢幕或診斷記錄不會顯示連線位址。"
          }
        }
      }
    },
