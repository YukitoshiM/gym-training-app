            "value": "एआई की प्रमाणीकरण जानकारी गलत या समाप्त हो गई है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacije o AI-u su neispravne ili istekle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI hitelesítő információk helytelenek vagy lejártak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi autentikasi AI tidak valid atau sudah kedaluwarsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni di autenticazione dell'IA non sono valide o scadute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIの認証情報が不正か、期限切れです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 인증 정보가 유효하지 않거나 만료되었습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एआयचे प्रमाणीकरण (authentication) माहिती चुकीची आहे किंवा ती कालबाह्य झाली आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklumat pengesahan AI mungkin tidak tepat atau tamat tempoh."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De authenticatiegegevens van de AI zijn ongeldig of verlopen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-informasjonen er feil eller utløpt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje uwierzytelniające do AI są nieprawidłowe lub wygasły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações de autenticação da IA estão inválidas ou expiradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações de autenticação da IA estão inválidas ou expiradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Informațiile de autentificare ale inteligenței artificiale sunt incorecte sau expirate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация для аутентификации ИИ недействительна или истекла срок действия."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Informácie pre overenie AI boli zneužité alebo majú vypršajúci platnosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacije za avtenticacijo AI so napačne ali iztečene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-autentiseringsinformationen är felaktig eller har löpt ut."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI அங்கீகாரத் தகவல் தவறானது அல்லது காலாவதியாகிவிட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI యొక్క ప్రామాణీకరణ సమాచారం తప్పుగా ఉందా లేదా గడువు ముగిసిందా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลประจำตัว AI ไม่ถูกต้อง หรือหมดอายุ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka kimlik bilgileri geçersiz veya süresi dolmuştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація для аутентифікації AI не дійсна або закінчилася термін дії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin xác thực của AI không hợp lệ hoặc đã hết hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 AI 认证信息可能已失效或过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 的驗證資訊可能已失效或過期。"
          }
        }
      }
    },
