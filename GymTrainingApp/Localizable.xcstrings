    "core_ui.ddbfa4c66ff8": {
      "comment": "GymTrainingApp/Features/Home/OmakaseHomeView.swift:229\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من السجلات. ويستمر حتى لو قمت بإغلاق الشاشة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprovació de registres. Continua encara que tanqueu la pantalla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznamy jsou načítány. Po zavření obrazovky pokračuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg undersøger dine registreringer. Du kan fortsætte, selvom du lukker skærmen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich überprüfe Ihre Aufzeichnungen. Auch wenn Sie den Bildschirm schließen, geht es weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργασία καταγραφής... Μπορείτε να κλείσετε την οθόνη και θα συνεχιστεί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking records... This will continue even if you close the screen."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking records... This will continue even if you close the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking records... This will continue even if you close the screen."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking records... This will continue even if you close the screen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando el registro. Sigue incluso si cierras la pantalla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando el registro. Sigue incluso si cierras la pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistetaan kirjaamista. Voit sulkea näytön, ja prosessi jatkuu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours d'enregistrement. L'application continuera même si vous fermez l'écran."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours d'enregistrement. L'application continuera même si vous fermez l'écran."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું રેકોર્ડની ચકાસણી કરી રહ્યો છું. સ્ક્રીન બંધ કરવાથી પણ તે ચાલુ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקת תיעוד בתהליך. אפשר לסגור את המסך ולהמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड की जांच की जा रही है। स्क्रीन बंद करने पर भी यह जारी रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjeravam zapis. Možete zatvoriti ekran, a proces će nastaviti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítés ellenőrzése. A képernyő bezárása után is folytatódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang memverifikasi catatan. Tetap berjalan meskipun layar ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto controllando le registrazioni. Rimarrà attivo anche se chiudi lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を確認中です。画面を閉じても続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 확인 중입니다. 화면을 닫아도 계속 진행됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंदी तपासणी करत आहे. स्क्रीन बंद केल्यास, प्रक्रिया चालू राहील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya sedang menyemak catatan. Ia akan berterusan walaupun anda menutup skrin."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik controleer je registraties. Het proces gaat verder, zelfs als je het scherm sluit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg sjekker registreringene dine. Du kan lukke skjermen, og det fortsetter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzam zapisy. Nawet po zamknięciu ekranu, proces będzie kontynuowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando o registro. Continua mesmo fechando a tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando o registro. Continua mesmo fechando a tela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificarea înregistrărilor este în curs. Rămâne activ chiar și după ce închideți ecranul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Происходит проверка данных. Закрытие экрана не прервет процесс."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizácia záznamu. Po zatvorení obrazovky pokračuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverjanje zapisov. Uporaba, tudi če zaprete zaslon, se nadaljuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar spelade aktiviteter. Fortgår även om du stänger skärmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவுகளை சரிபார்க்கப்படுகிறது. திரையை மூடினாலும் தொடரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డును సమీక్షిస్తున్నాము. స్క్రీన్‌ను మూసివేసినా కొనసాగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังตรวจสอบบันทึก โปรดรอ หากปิดหน้าก็จะยังคงดำเนินอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı kontrol ediliyor. Ekranı kapatın, devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряю записи. Можна закрити екран, і все продовжиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra bản ghi. Bạn có thể đóng màn hình mà không bị gián đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查记录。即使关闭屏幕，也会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查记录。即使关闭屏幕，也会继续。"
          }
        }
      }
