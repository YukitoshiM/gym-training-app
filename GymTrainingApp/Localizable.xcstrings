    "health_meals_body_ai.ee7759267a4d": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:335\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذا كأساس لتحديد متوسط الاتجاهات الأسبوعية، بدلاً من التغييرات اليومية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitzeu-ho com a base per determinar les tendències mitjanes setmanals, en lloc dels canvis diaris."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte jako základ pro posouzení, nikoli jen denních změn, ale průměrných hodnot za týden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug dette til at vurdere tendenser over uger, ikke kun daglige ændringer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie dies als Grundlage, um den Wochen-Durchschnitt zu beurteilen, anstatt sich auf tägliche Veränderungen zu konzentrieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το ως βάση για να αξιολογήσετε τις εβδομαδιαίες τάσεις, και όχι τις καθημερινές αλλαγές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use weekly averages instead of daily changes to assess trends."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Use weekly averages instead of daily changes to assess trends."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use weekly averages instead of daily changes to assess trends."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use weekly averages instead of daily changes to assess trends."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizaré esto como base para evaluar las tendencias semanales, no los cambios diarios."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizaré esto como base para evaluar las tendencias semanales, no los cambios diarios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytämme päivittäisiä muutoksia sen sijaan, että arvioisimme viikoittaista keskimääräistä trendiä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez-les pour évaluer les tendances hebdomadaires, plutôt que les changements quotidiens."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez-les pour évaluer les tendances hebdomadaires, plutôt que les changements quotidiens."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દૈનિક ફેરફારોને બદલે, અઠવાડિયાની સરેરાશ વલણને નક્કી કરવા માટે આનો ઉપયોગ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשתמש בנתונים של מגמת השבוע הממוצעת, ולא בשינויים היומיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दैनिक बदलावों की बजाय, साप्ताहिक औसत प्रवृत्ति का आकलन करने के लिए इसका उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite to kao osnovu za procjenu, a ne samo dnevne promjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a napi változások helyett, inkább a heti átlagos trendek elemzésére."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan sebagai bahan untuk menilai tren mingguan, bukan perubahan harian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzeremo i dati relativi all'andamento settimanale, piuttosto che alle variazioni quotidiane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日々の変化ではなく、週平均の傾向を判断する材料にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상적인 변화가 아닌, 주간 평균 경향을 판단하는 기준으로 활용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दैनंदिन बदलांऐवजी, साप्ताहिक सरासरी ट्रेंडचा वापर करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan sebagai bahan untuk menilai trend mingguan, bukan perubahan harian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik deze om de wekelijkse gemiddelde trend te bepalen, en niet alleen dagelijkse veranderingen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk dette som et grunnlag for å vurdere ukens gjennomsnittlige trend, ikke daglige endringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystaj to jako podstawę do oceny, a nie pojedynczych zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use como base para avaliar tendências semanais, e não apenas mudanças diárias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use como base para avaliar tendências semanais, e não apenas mudanças diárias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosiți aceste informații pentru a evalua tendința săptămânală, nu doar schimbările zilnice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте не ежедневные изменения, а средние значения за неделю для оценки прогресса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používajte ako materiál na posúdenie, nie denné zmeny, ale priemerné hodnoty za týždeň."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite to kot osnovo za ocenjevanje trendov, ne le dnevnih sprememb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd som underlag för att bedöma veckovisa trender, inte enskilda dagars variationer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தினசரி மாற்றங்களை விட, வார சராசரி போக்குகளை அடிப்படையாகக் கொள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రోజువారీ మార్పుల కంటే, వారానికి సగటు ట్రెండ్‌ను అంచనా వేయడానికి ఇది ఉపయోగపడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เป็นข้อมูลในการตัดสินแนวโน้มรายสัปดาห์ ไม่ใช่การเปลี่ยนแปลงในแต่ละวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük değişiklikler yerine, haftalık ortalama eğilimi belirlemek için kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте це для визначення загальної тенденції за тиждень, а не лише щоденних змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng như một tiêu chí để đánh giá xu hướng hàng tuần, thay vì những thay đổi hàng ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将作为判断每周平均趋势的依据，而不是每日的变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将每日的变化作为判断每周平均趋势的依据。"
          }
        }
      }
    },
