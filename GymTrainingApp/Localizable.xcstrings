            "value": "Sağlığınızı göz önünde bulundurarak planınıza uygun ilerleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слідкуйте за своїм самопочуттям і дотримуйтесь плану."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tiếp tục theo kế hoạch khi bạn cảm thấy tốt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
