    "health_meals_body_ai.0eea7055641a": {
      "comment": "GymTrainingApp/Features/Meals/MealNutritionSourceViews.swift:281\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أدخلت الأرقام من ملصق التغذية. يرجى التحقق من المبلغ القياسي وكل قيمة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaig introduir els números de l'etiqueta nutricional. Si us plau, comproveu la quantitat estàndard i cada valor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte hodnotu z údajů o výživě. Zkontrolujte základní množství a každou hodnotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har indtastet værdien fra ernæringsangivelsen. Kontroller, at den stemmer overens med standardmængden og de enkelte værdier."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe den Wert aus der Nährwertanzeige eingegeben. Bitte überprüfen Sie die Menge und jeden Wert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχω εισάγει αριθμούς από την αναφορά θρεπτικών συστατικών. Παρακαλώ ελέγξτε τις βάσεις και τους κάθε αριθμό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "I have entered the values from the nutrient display. Please check the standard amount and each value."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "I have entered the values from the nutrient display. Please check the standard amount and each value."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I have entered the values from the nutrient display. Please check the standard amount and each value."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "I have entered the values from the nutrient display. Please check the standard amount and each value."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "He introducido los valores desde la información nutricional. Verifique las cantidades con la cantidad base y cada valor."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "He introducido los valores desde la información nutricional. Verifique las cantidades con la cantidad base y cada valor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötin arvot ravintosisältöstä. Tarkista, että ne vastaavat määriä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai saisi les valeurs à partir de l'affichage nutritionnel. Veuillez vérifier la quantité de référence et chaque valeur."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai saisi les valeurs à partir de l'affichage nutritionnel. Veuillez vérifier la quantité de référence et chaque valeur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પોષણ દર્શાવમાંથી મૂલ્ય દાખલ કરવામાં આવ્યું. પ્રમાણભૂત અને દરેક મૂલ્યની ચકાસણી કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את הערכים מתוך התצוגה התזונתית. אנא וודא שהערכים והכמות הם נכונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोषण सामग्री से संख्या दर्ज की गई है। कृपया मानक मात्रा और प्रत्येक संख्या की जांच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unjeli smo vrijednosti iz prikaza hranjivih sastojaka. Provjerite osnovnu količinu i svaku vrijednost."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A táplálkozási információkból értékeket írtam be. Kérjük, ellenőrizze a referenciaértéket és az egyes értékeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah memasukkan angka dari tampilan nutrisi. Periksa jumlah dan setiap angka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho inserito i valori dall'etichetta nutrizionale. Verificare la quantità di riferimento e ogni valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "栄養表示から数値を入力しました。基準量と各数値を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양 정보에서 값을 입력했습니다. 기준량과 각 값을 확인해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोषक तत्त्वांच्या माहितीमधून मूल्य प्रविष्ट केले आहे. कृपया प्रमाणित आणि प्रत्येक मूल्याची पडताळणी करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah memasukkan nilai daripada paparan nutrisi. Sila semak kuantiti dan setiap nombor."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de waarden ingevoerd vanuit de voedingswaarden. Controleer de referentiewaarde en de individuele waarden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har skrevet inn verdier fra næringsstoffvisning. Vennligst sjekk referanseverdien og hver verdi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisałem wartość z etykiety. Sprawdź, czy jest zgodna z podstawową ilością i każdą wartością."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscrevi valores a partir das informações nutricionais. Verifique as quantidades e os valores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscrevi valores a partir das informações nutricionais. Verifique as quantidades e os valores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am introdus numerele din afișajul nutrienților. Verificați cantitatea de referință și fiecare valoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введены значения из информации о питательных веществах. Проверьте базовые значения и каждое значение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadali hodnoty z údajov o výžive. Skontrolujte referenčné hodnoty a jednotlivé čísla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesli ste vrednosti iz prikaza hranilnih sestavin. Prosim, preverite standardno količino in vsako vrednost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag har matat in värden från näringsdeklarationen. Kontrollera basvärdet och varje värde."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஊட்டச்சத்து விவரங்களிலிருந்து மதிப்புகளை உள்ளிடப்பட்டுள்ளது. தரநிலைகள் மற்றும் ஒவ்வொரு மதிப்பையும் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోషకాహారం నుండి విలువలను నమోదు చేసాను. ప్రామాణిక పరిమాణం మరియు ప్రతి విలువను తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนค่าจากรายการอาหาร กรุณาตรวจสอบกับปริมาณมาตรฐานและตัวเลขต่างๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besin gösteriminden değeri girdim. Standart miktar ve her bir değeri kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введено значення з відображення харчових показників. Перевірте базову кількість та кожне значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã nhập số từ thông tin dinh dưỡng. Vui lòng kiểm tra so với lượng tiêu chuẩn và các giá trị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从营养显示中输入数值。请检查基准量和每个数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已从营养显示中输入数值。请确认基准量和每个数值。"
          }
        }
      }
    },
