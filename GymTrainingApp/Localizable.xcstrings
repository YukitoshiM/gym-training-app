            "value": "He pogut continuar la meva formació. Augmentar el vostre registre de recuperació augmentarà la precisió dels ajustos de la setmana vinent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokončujete trénink. Zvyšováním počtu záznamů o regeneraci zlepšíte přesnost příštího plánu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg fortsætter med træningen. Jo flere restitutioner, desto bedre bliver justeringen næste uge."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich kann weiterhin trainieren. Durch das Erhöhen der Aufzeichnung über die Erholung wird die Genauigkeit der Anpassungen nächste Woche verbessert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορώ να συνεχίσω την προπόνηση. Η αύξηση των καταγραφών αποκατάστασης θα βελτιώσει την ακρίβεια των προτάσεων για την επόμενη εβδομάδα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm continuing my training. Increasing recovery records will improve the accuracy of next week's adjustments."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm continuing my training. Increasing recovery records will improve the accuracy of next week's adjustments."
          }
        },
        "en-GB": {
          "stringUnit": {
