    "health_meals_body_ai.7453de0b9772": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:188\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تسجيلها. وتضيف الخبرة أيضًا إلى أساس الاستعداد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No gravat. L'experiència també s'afegeix a la base de la preparació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezaznamenáno. Zahrnuje i odhadované hodnoty a úroveň připravenosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke registreret. Også oplevet og forberedelsesgrundlaget tages med i betragtningen"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erfasst. Auch das subjektive Gefühl und die Grundlage für die Vorbereitung können berücksichtigt werden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει καταγραφεί. Λαμβάνονται υπόψη η αίσθηση και οι λόγοι προετοιμασίας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recorded. This also includes subjective feelings and preparation reasons."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recorded. This also includes subjective feelings and preparation reasons."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recorded. This also includes subjective feelings and preparation reasons."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Not recorded. This also includes subjective feelings and preparation reasons."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No registrado. Se incluyen también la percepción y la preparación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No registrado. Se incluyen también la percepción y la preparación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kirjattu. Tähän voidaan lisätä myös kokemuksen perusteella."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Non enregistré. Cela inclut également les sensations et les justifications de préparation."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Non enregistré. Cela inclut également les sensations et les justifications de préparation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અપહાયેલ. આ ઉપરાંત, શરીરના અનુભવ અને તૈયારીની દલીલોનો પણ સમાવેશ થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נרשם. ניתן להשתמש גם בנתונים סובייקטיביים כבסיס"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड नहीं किया गया। इसमें शारीरिक अनुभव और तैयारी के आधार भी शामिल हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezabilježeno. Uključuje osjećaj i osnovu za pripremljenost"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez még nem szerepel. A tapasztalati adatok és a felkészültség is figyelembe kell venni"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dicatat. Ini juga mencakup dasar untuk merasakan dan mempersiapkan diri"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non registrato. Si considerano anche la percezione e la preparazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未記録。体感も準備度の根拠に加えられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록되지 않았습니다. 체감 및 준비 상태 근거를 추가할 수 있습니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंद केलेले नाही. शारीरिक अनुभव आणि तयारीच्या आधारावर नोंद करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum direkod. Juga mengambil kira perasaan dan asas kesediaan"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet geregistreerd. Ook de subjectieve ervaring en de basis voor de voorbereiding worden meegenomen"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke registrert. Kroppsopplevelse og forberedelsesgrunnlag inkluderes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niezarejestrowane. Uwzględnia się również odczucie oraz podstawy do oceny gotowości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não registrado. Inclui também a percepção e a base para a preparação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não registrado. Inclui também a percepção e a base para a preparação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost înregistrat. Se iau în considerare atât senzația, cât și gradul de pregătire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зафиксировано. Учитываются ощущения и обоснование готовности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenané len subjektívne vnímanie a dôvod prípravy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezabeleženo. Upoštevati tudi občutek in raven pripravljenosti"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej registrerat. Kroppsupplevelse och beredskap kan inkluderas"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்யப்படவில்லை. உடல் உணர்வுகளையும், தயார் நிலையில் இருப்பதற்கான காரணங்களையும் சேர்க்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డ్ చేయలేదు. శరీర అనుభూతి మరియు సిద్ధతకు సంబంధించిన కారణాలను కూడా పరిగణనలోకి తీసుకుంటాము"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้บันทึก สามารถเพิ่มข้อมูลเกี่ยวกับความรู้สึกและระดับความพร้อมได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt edilmemiş. Duyusal deneyim ve hazırlık gerekçesi de eklenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не зафіксовано. Враховується відчуття та рівень готовності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ghi lại. Cần thêm cơ sở cho cảm nhận và mức độ chuẩn bị"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录。还可以作为感知的依据和准备度的依据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录。体感和准备度的依据也包含在此。"
          }
        }
      }
    },
