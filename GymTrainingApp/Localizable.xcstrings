    "health_meals_body_ai.efb7ffef371a": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:268\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\ngu: NLLB fallback used because TranslateGemma mixed writing systems; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك السماح بالخطوات والنشاط والنوم ومعدل ضربات القلب أثناء الراحة ومعدل ضربات القلب ومعدل التنفس ودرجة حرارة جلد المعصم لكل عنصر تحتاجه. سيتم التعامل مع العناصر غير المسموح بها على أنها لم يتم الحصول عليها بعد، ويمكن استخدام الإدخال اليدوي كما هو."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu permetre passos, activitat, son, freqüència cardíaca en repòs, HRV, freqüència respiratòria i temperatura de la pell del canell per a cada element que necessiteu. Els elements que no estiguin permesos es tractaran com a no obtinguts encara i l'entrada manual es pot utilitzar tal qual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete povolit sběr údajů pro konkrétní položky (počet kroků, aktivita, spánek, srdeční frekvence v klidu, HRV, dýchání, teplota na zápěstí). Pokud položku nezvolíte, bude považována za neuloženou a můžete ji zadat ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan give tilladelse til at registrere specifikke data, såsom skridt, aktiviteter, søvn, hvilepuls, HRV (hjertevariabilitet), vejrtrækning og håndledstemperatur. Data, der ikke er aktiveret, vil blive behandlet som uregistrerede, og du kan stadig manuelt indtaste dem."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die folgenden Elemente nach Bedarf auswählen: Schritte, Aktivität, Schlaf, Ruheherzfrequenz, HRV, Atemfrequenz, Handgelenktemperatur. Nicht ausgewählte Elemente werden als nicht erfasst behandelt und können manuell eingegeben werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να επιτρέψετε συγκεκριμένα στοιχεία, όπως βήματα, δραστηριότητα, ύπνο, καρδιακούς παλμούς σε ηρεμία, HRV, αναπνοές και θερμοκρασία του δέρματος στον καρπό. Τα στοιχεία που δεν επιτρέπετε θα αντιμετωπιστούν ως μη συλλεχθέντα και μπορείτε να τα εισάγετε χειροκίνητα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant permission for steps, activity, sleep, resting heart rate, HRV, breathing rate, and wrist skin temperature as needed. Unrequested items will be treated as not obtained, and you can still use manual input."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant permission for steps, activity, sleep, resting heart rate, HRV, breathing rate, and wrist skin temperature as needed. Unrequested items will be treated as not obtained, and you can still use manual input."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant permission for steps, activity, sleep, resting heart rate, HRV, breathing rate, and wrist skin temperature as needed. Unrequested items will be treated as not obtained, and you can still use manual input."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant permission for steps, activity, sleep, resting heart rate, HRV, breathing rate, and wrist skin temperature as needed. Unrequested items will be treated as not obtained, and you can still use manual input."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes permitir los siguientes elementos: pasos, actividad, sueño, frecuencia cardíaca en reposo, HRV, respiración, temperatura de la piel en la muñeca. Los elementos no permitidos se tratarán como \"no obtenidos\" y puedes utilizarlos manualmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes permitir los siguientes elementos: pasos, actividad, sueño, frecuencia cardíaca en reposo, HRV, respiración, temperatura de la piel en la muñeca. Los elementos no permitidos se tratarán como \"no obtenidos\" y puedes utilizarlos manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit antaa luvan askeleille, aktiviteeteille, unelle, levossa mitattavalle sydämen sykkeelle, HRV:lle (heart rate variability), hengitykselle ja ranteen ihon lämpötilalle. Jos et halua antaa lupaa, tiedot merkitään \"ei tallennettu\", ja voit syöttää ne manuaalisesti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez autoriser les éléments suivants : nombre de pas, activité, sommeil, fréquence cardiaque au repos, HRV, fréquence respiratoire, température de la peau à l'avant-bras. Les éléments non autorisés seront considérés comme non acquis et peuvent être saisis manuellement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez autoriser les éléments suivants : nombre de pas, activité, sommeil, fréquence cardiaque au repos, HRV, fréquence respiratoire, température de la peau à l'avant-bras. Les éléments non autorisés seront considérés comme non acquis et peuvent être saisis manuellement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પગલાઓ, પ્રવૃત્તિઓ, ઊંઘ, શાંત ધબકારા, એચઆરવી, શ્વાસ, હાથની ચામડીનું તાપમાન દરેક વસ્તુને મંજૂરી આપી શકાય છે. જે વસ્તુઓને મંજૂરી નથી, તે અસ્વીકાર્ય ગણવામાં આવે છે, અને હાથનો ઉપયોગ કરવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאשר את הפעולות הבאות: מספר צעדים, פעילות גופנית, שינה, דופק במנוחה, HRV, קצב נשימה, טמפרטורת עור בגב יד. ניתן להתייחס לפריטים שאינם מאפשרים כלא מאובטח ולהשתמש בהם באופן ידני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप आवश्यक तत्वों के अनुसार कदम, गतिविधि, नींद, आराम के दौरान हृदय गति, HRV, श्वसन दर और कलाई के त्वचा तापमान को अनुमति दे सकते हैं। यदि आप किसी तत्व को अनुमति नहीं देते हैं, तो इसे \"प्राप्त नहीं\" के रूप में माना जाएगा और आप इसे मैन्युअल रूप से दर्ज कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete odabrati koje podatke želite prikupljati, uključujući broj koraka, aktivnosti, spavanje, srčani ritam u miro, HRV, broj otkucaja, temperaturu kože na zapešću. Neodabranim podacima se pristupa kao neuhvacenim, a ručni unos možete koristiti i dalje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lépések, aktivitás, alvás, pihenő állapotban mért pulzus, HRV (szívfrekvencia variabilitás), légzés, zápok hőmérséklete mellett kiválaszthatjuk, hogy melyekkel szeretnénk adatokat rögzíteni. Azon adatok, melyeket nem engedélyezünk, a bejegyzésekben \"nem megadatott\"ként jelennek meg, és manuálisan is beírhatunk értékeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat memberikan izin untuk jumlah langkah, aktivitas, tidur, detak jantung saat istirahat, HRV, pernapasan, dan suhu kulit di pergelangan tangan sesuai dengan item yang diperlukan. Item yang tidak diberikan akan ditangani sebagai \"belum diperoleh\", dan Anda dapat menggunakannya secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile autorizzare i seguenti elementi: passi, attività, sonno, frequenza cardiaca a riposo, HRV, numero di respiri, temperatura della pelle al polso. Gli elementi non autorizzati verranno trattati come non acquisiti e possono essere inseriti manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩数、アクティビティ、睡眠、安静時心拍、HRV、呼吸数、手首皮膚温を必要な項目ごとに許可できます。許可しない項目は未取得として扱い、手入力はそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸음 수, 활동, 수면, 휴식 시 심박수, HRV, 호흡수, 손목 피부 온도를 필요한 항목별로 허용할 수 있습니다. 허용하지 않은 항목은 미획득으로 처리하며, 수동 입력도 그대로 사용 가능합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाय, ॲक्टिव्हिटी, झोप, विश्रांतीमधील हृदय गती, HRV, श्वासाची संख्या आणि मनगटावरील त्वचेचे तापमान या आवश्यक गोष्टींची निवड करता येते. निवड न केलेल्या गोष्टी 'मिळालेली नाही' म्हणून नोंदवल्या जातील आणि तुम्ही त्या मॅन्युअली ॲड करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh mengizinkan jumlah langkah, aktiviti, tidur, denyutan jantung semasa istirahat, HRV, bilangan pernafasan, suhu kulit di pergelangan tangan untuk setiap item yang diperlukan. Item yang tidak diizinkan akan ditangani sebagai belum diperoleh, dan anda boleh menggunakan input manual secara langsung."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de volgende gegevens toestaan: stappen, activiteit, slaap, hartslag in rust, HRV, ademhalingsfrequentie en temperatuur van je pols. Niet-toegestane gegevens worden als \"niet verzameld\" beschouwd en kunnen handmatig worden ingevoerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gi tillatelse for å spore skritt, aktivitet, søvn, hvilepuls, HRV (variabilitet i hvilepuls), pustefrekvens og hudtemperatur på håndleddet. Elementer du ikke har gitt tillatelse til, vil bli behandlet som \"ikke registrert\", og du kan fortsatt taste inn manuelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zezwolić na zbieranie danych dla wybranych kategorii, takich jak kroki, aktywność, sen, tętno w spoczynku, HRV, oddech i temperatura skóry na nadgarstku. Niezapewnione dane będą traktowane jako nieznane, a ręczne wpisy pozostaną dostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode permitir os seguintes itens: passos, atividades, sono, frequência cardíaca em repouso, HRV, respiração, temperatura da pele na mão. Os itens não permitidos serão tratados como \"não obtido\", e você pode usá-los manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode permitir os seguintes itens: passos, atividades, sono, frequência cardíaca em repouso, HRV, respiração, temperatura da pele na mão. Os itens não permitidos serão tratados como \"não obtido\", e você pode usá-los manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți autoriza anumite elemente, cum ar fi numărul de pași, activitatea, somnul, ritmul cardiac în repaus, HRV (variația frecvenței cardiace), respirația și temperatura pielii de la încheietură. Elementele neautorizate vor fi tratate ca fiind neobținute, iar introducerea manuală poate fi utilizată direct."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно разрешить получение данных для необходимых параметров: шаги, активность, сон, частота сердечных сокращений в состоянии покоя, HRV, частота дыхания, температура кожи на запястье. Неразрешенные параметры будут отображаться как \"неполучены\", а ручной ввод можно использовать как обычно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete povoliť zber údajov pre konkrétne položky: počet krokov, aktivita, spánok, tepová frekvencia v kluse, HRV, dýchanie, teplota na zápästí. Nezneužité údaje sa zobrazia ako \"nie získané\" a môžete ich manuálne zadávať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko omogočite dostop do potrebnih podatkov: število korakov, aktivnost, spanje, srčni utrip v miro, HRV, dihal, temperaturo kože na zapestju. Neomogočene podatke obravnavam kot neprejete in jih lahko ročno vneseš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ge tillåtelse för steg, aktivitet, sömn, vilopuls, HRV, andningsfrekvens och hudtemperatur på handleden, efter behov. Om du inte ger tillåtelse kommer dessa värden att behandlas som \"icke-upptagna\", och du kan fortfarande använda dem manuellt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படி, செயல்பாடு, தூக்கம், ஓய்வு நேரத்தில் இதயத் துடிப்பு, HRV, சுவாசம், மணிக்கட்டு சரும வெப்பநிலை போன்ற தேவையான தகவல்களை அனுமதிக்கலாம். அனுமதிக்காத தகவல்களைப் பயன்படுத்தாமல், தேவைக்கேற்ப உள்ளீடுகளைச் சேர்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దూరం, కార్యాచరణ, నిద్ర, విశ్రాంతి సమయంలో హృదయ స్పందన, HRV, శ్వాస, వేలికి ఉండే చర్మ ఉష్ణోగ్రత వంటి అవసరమైన అంశాలను ఎంచుకోవచ్చు. ఎంచుకోని అంశాలను \"సంగ్రహించబడలేదు\"గా పరిగణిస్తారు మరియు వాటిని మాన్యువల్‌గా నమోదు చేసుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถอนุญาตให้เข้าถึงรายการที่ต้องการได้ เช่น จำนวนก้าว, กิจกรรม, การนอนหลับ, อัตราการเต้นของหัวใจขณะพัก, HRV, จำนวนการหายใจ, อุณหภูมิผิวบริเวณข้อมือ หากไม่อนุญาต ให้ถือว่าเป็นข้อมูลที่ยังไม่ได้บันทึก สามารถใช้การป้อนข้อมูลด้วยตนเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İhtiyaç duyduğunuz her kategori için adım, aktivite, uyku, dinlenme sırasında kalp atışı, HRV (kalp varyansı), nefes sayısı ve bilek cilt sıcaklığını izin verebilirsiniz. İzin vermediğiniz kategoriler için verileri \"alınmadı\" olarak işaretleyebilirsiniz ve manuel olarak da girebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна дозволити запит даних про кроки, активність, сон, частоту серцевих скорочень у спокої, HRV, дихання, температуру шкіри на зап'ясті для потрібних пунктів. Недозволені пункти вважаються не отриманими, а введені вручну дані можна використовувати як є."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể cho phép thu thập số lượng bước, hoạt động, giấc ngủ, nhịp tim khi nghỉ ngơi, HRV, tần số thở, nhiệt độ da ở cổ tay theo các mục cần thiết. Các mục không được cho phép sẽ được coi là chưa thu thập và bạn vẫn có thể nhập thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以允许步数、活动、睡眠、静息心率、HRV和呼吸频率等所需项目。对于未允许的项目，请将其视为未获取，并且可以直接手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以允许步数、活动、睡眠、静息心率、HRV和呼吸次数等所需项目。对于未允许的项目，请将其视为“未获取”，并且可以直接手动输入。"
          }
        }
      }
    },
