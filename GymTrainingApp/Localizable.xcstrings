          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar la postura y el equilibrio de las partes del cuerpo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomioi asento ja kehon osien tasapaino"
