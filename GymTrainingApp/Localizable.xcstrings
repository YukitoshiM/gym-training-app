    "health_meals_body_ai.b695d78f775e": {
      "comment": "GymTrainingApp/Features/BodyMetrics/BodyMetricListView.swift:27\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد القيم الرقمية التي تتقلب من يوم لآخر، مثل الوزن ومحيط الخصر، على الاتجاهات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els valors numèrics que varien d'un dia a un altre, com ara el pes i la circumferència de la cintura, es basen en tendències."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnoty jako hmotnost a obvod pasu se mohou denně měnit, proto je sledujte v grafu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal som vægt og taljelængde kan variere fra dag til dag, så det er bedst at se udviklingen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Gewicht und Taillenumfang können diese Werte täglich schwanken. Betrachten Sie die Veränderungen in der Übersicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τιμές που αλλάζουν καθημερινά, όπως το βάρος και η περιφέρεια της κοιλιάς, πρέπει να εξετάζονται μέσω των τάσεων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers like weight and waist circumference can fluctuate daily. It's best to view these changes over time."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers like weight and waist circumference can fluctuate daily. It's best to view these changes over time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers like weight and waist circumference can fluctuate daily. It's best to view these changes over time."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers like weight and waist circumference can fluctuate daily. It's best to view these changes over time."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores que varían diariamente, como el peso y la circunferencia de la cintura, deben ser observados a través de gráficos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores que varían diariamente, como el peso y la circunferencia de la cintura, deben ser observados a través de gráficos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paino ja vyötärönympärys voivat vaihdella päivittäin, joten tarkastele muutosta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs qui varient quotidiennement, comme le poids et la taille, doivent être interprétées à travers leur évolution."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs qui varient quotidiennement, comme le poids et la taille, doivent être interprétées à travers leur évolution."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન અને પેટની પરિઘ જેવા આંકડા, જે દરરોજ બદલાય છે, તેને ટ્રેન્ડમાં જોવા મળે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערכים כמו משקל ומספר המותניים יכולים להשתנות מדי יום, ולכן מומלץ לבדוק את השינויים לאורך זמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन और पेट का घेरा जैसे दैनिक रूप से बदलते नंबरों को देखने के लिए, ट्रांज़िशन देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brojevi koji se mijenjaju svaki dan, kao što je težina i obod struka, trebaju se gledati u trendu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A testsúly és a mellszög változásai természetesen eltérhetnek. A változásokat grafikonon is megtekintheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka seperti berat badan dan lingkar pinggang yang berfluktuasi setiap hari sebaiknya dilihat dalam bentuk transisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeri come peso e circonferenza della vita possono variare nel tempo; è consigliabile analizzarli tramite grafici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重や腹囲のように日々ぶれる数値は、推移で見る前提です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 변하는 체중이나 허리둘레와 같은 수치는 변화 추이를 확인하기 위한 것입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन आणि कंबर यांसारखी आकडेवारी दररोज बदलू शकते, त्यामुळे बदलांचा मागोवा घेणे महत्त्वाचे आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka seperti berat dan sekeliling perut boleh berubah setiap hari, jadi lihat perubahannya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Getallen zoals gewicht en taille die dagelijks fluctueren, worden het beste bekeken in een grafiek."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdier som vekt og mageomkrets kan variere fra dag til dag, så se på utviklingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartości, takie jak waga i obwód talii, mogą się zmieniać każdego dnia, dlatego należy je analizować na wykresach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores que variam diariamente, como peso e circunferência da cintura, devem ser analisados através do gráfico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores que variam diariamente, como peso e circunferência da cintura, devem ser analisados através do gráfico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorile care fluctuează zilnic, cum ar fi greutatea și circumferința taliei, trebuie analizate în funcție de tendințe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о весе и объеме талии, которые могут меняться со временем, лучше всего отслеживать в виде графика."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čísla, ako je hmotnosť a obvod pása, sa môžu meniť každý deň, preto ich sledujte v grafoch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Težo in obod telesa lahko spreminjate, zato je pomembno gledati trende."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vikten kan variera från dag till dag, så fokusera på förändringen över tid."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடை மற்றும் இடுப்பு சுற்றளவு போன்ற மதிப்புகள் தினமும் மாறுபடலாம், எனவே அவற்றைப் போக்குகளாகப் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు మరియు కడుపు చుట్టుకొలత వంటి రోజురోజుకు మారుతూ ఉండే సంఖ్యలను, మార్పును గమనించడానికి అనువుగా చూసుకోవాలి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขที่เปลี่ยนแปลงไปในแต่ละวัน เช่น น้ำหนักและรอบเอว ควรดูจากแนวโน้ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo ve karın çevresi gibi günlük olarak değişen değerler, zaman içindeki değişimleri göstermek için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вага та обхват талії – це показники, які можуть змінюватися щодня, тому їх слід розглядати в динаміці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chỉ số như cân nặng và vòng bụng có thể thay đổi hàng ngày, vì vậy hãy xem xét xu hướng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日波动的数据（如体重和腰围），应以趋势图的形式查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每日波动的数据（如体重和腰围），应以趋势图的形式查看。"
          }
        }
      }
    },
