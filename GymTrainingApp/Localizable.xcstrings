    "core_ui.6d46fc51fc89": {
      "comment": "GymTrainingApp/Features/Shared/CoachPersonaPicker.swift:165\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لدينا شخصين لكل غرض. عندما تقوم بتغيير الشخص، سيتغير نوع جسمك المثالي وطريقة التحدث."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenim dues persones per a cada propòsit. Quan canvieu de persona, canviarà el vostre tipus de cos ideal i la vostra manera de parlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro každý cíl máme připravené dvě osoby. Změnou osob se mění i jejich styl komunikace a doporučení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har to personer til hvert formål. Ved at ændre personen, ændres også den ønskede kropsform og måden, man taler på."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jeden Zweck stehen zwei Personen zur Verfügung. Durch den Wechsel der Person ändern sich auch die ideale Körperform und die Art der Kommunikation."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχουμε δύο διαφορετικούς χαρακτήρες για κάθε στόχο. Αλλάζοντας τον χαρακτήρα, αλλάζει και ο τρόπος που μιλάει και η ιδανική σωματική διάπλαση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We have two different people for each purpose. Changing the person changes the ideal body type and conversation style."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We have two different people for each purpose. Changing the person changes the ideal body type and conversation style."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We have two different people for each purpose. Changing the person changes the ideal body type and conversation style."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We have two different people for each purpose. Changing the person changes the ideal body type and conversation style."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenemos dos personajes para cada objetivo. Cambiar de personaje cambia la forma en que se habla del cuerpo ideal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenemos dos personajes para cada objetivo. Cambiar de personaje cambia la forma en que se habla del cuerpo ideal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaiselle tavoitteelle on valittu kaksi henkilöä. Henkilön vaihtamalla voit muuttaa ihannemuotoa ja puhetyyliä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous proposons deux profils pour chaque objectif. En changeant de profil, vous obtiendrez une approche différente et un corps idéal."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous proposons deux profils pour chaque objectif. En changeant de profil, vous obtiendrez une approche différente et un corps idéal."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ધ્યેય માટે, અમે બે વ્યક્તિઓની પસંદગી કરી છે. વ્યક્તિ બદલવાથી, આદર્શ શરીર અને વાતચીત બદલાશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ישנן שתי דמויות שונות לכל מטרה. שינוי הדמויות משנה את הצורה האידיאלית ואת סגנון הדיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक उद्देश्य के लिए, हमने दो व्यक्तियों को शामिल किया है। व्यक्ति बदलने पर, आदर्श शरीर और बातचीत बदल जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za svaki cilj imamo dva različita profila. Promjenom profila, mijenja se i način razgovora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden célhoz két személyt definiálhat. A személyek megváltoztatása esetén az ideális testformáról és a kommunikációs stílusról is változnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menyediakan 2 orang untuk setiap tujuan. Dengan mengubah orang tersebut, Anda akan mendapatkan tipe tubuh dan cara berbicara yang berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ogni obiettivo, sono disponibili due profili. Cambiando il profilo, cambiano anche il modo di parlare e l'aspetto ideale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的ごとに2人の人物を用意しています。人物を変えると、理想体型と話し方が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 목표에 대해 2명의 인물을 설정했습니다. 인물을 변경하면, 이상적인 체형과 대화 방식이 바뀝니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक उद्दिष्टासाठी, दोन व्यक्तींची निवड केली आहे. व्यक्ती बदलल्यास, आदर्श शरीरयष्टी आणि बोलण्याची पद्धत बदलते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami menyediakan 2 orang untuk setiap matlamat. Dengan mengubah individu, corak bicaranya dan bentuk badan akan berubah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor elk doel zijn er twee personen. Door de persoon te veranderen, verandert ook de manier van communiceren en het gewenste lichaam."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har satt opp to personer for hvert formål. Ved å endre personen, vil du få en annen samtale om ønsket kropp og måte å snakke på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla każdego celu przygotowaliśmy dwóch różnych użytkowników. Zmiana osoby zmienia również sposób komunikacji i proponowane cele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temos duas pessoas para cada objetivo. Mudar a pessoa altera o estilo de comunicação e a forma ideal de alcançar o corpo desejado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Temos duas pessoas para cada objetivo. Mudar a pessoa altera o estilo de comunicação e a forma ideal de alcançar o corpo desejado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru fiecare scop, avem pregătiți doi utilizatori. Schimbând persoanele, veți obține un stil de comunicare și o imagine ideală diferite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для каждой цели предусмотрены два персонажа. Изменяя персонажа, вы можете изменить и его речь, и образ тела."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre každý cieľ máme pripravených dvoch ľudí. Zmena osoby zmení aj váš ideálny vzhľad a spôsob komunikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za vsak cilj imamo dva različna profile. Z menami lahko dosežete idealno postavo in komunikacijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har för varje syfte två olika personer. Genom att byta person ändras idealformen och sättet att prata."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு நோக்கத்திற்கும், இரண்டு நபர்களைத் தயார் செய்துள்ளோம். நபர்களை மாற்றும்போது, ​​உங்களுக்கு விருப்பமான உடல் அமைப்பையும், உரையாடலையும் பெறலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి లక్ష్యానికి 2 మంది వ్యక్తులను కలిగి ఉన్నాము. వ్యక్తులను మార్చడం ద్వారా, మీరు కోరుకున్న శరీర ఆకృతి మరియు సంభాషణను పొందవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีผู้คน 2 คนสำหรับแต่ละวัตถุประสงค์ เมื่อเปลี่ยนผู้คน จะเปลี่ยนรูปแบบการพูดคุยเพื่อให้ได้รูปร่างที่ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her amaç için iki farklı kişi bulunmaktadır. Kişiyi değiştirmek, ideal vücut tipini ve konuşma tarzını değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для кожної мети передбачено двох персонажів. Зміна персонажа змінює ідеальний тип фігури та стиль спілкування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi cung cấp 2 nhân vật khác nhau cho mỗi mục đích. Thay đổi nhân vật sẽ thay đổi hình dáng và cách giao tiếp lý tưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们为每个目的准备了2位人物。 切换人物，理想身材和说话方式也会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們為每個目的準備了2位人物。 變換人物會改變理想體型和說話方式。"
          }
        }
      }
    },
