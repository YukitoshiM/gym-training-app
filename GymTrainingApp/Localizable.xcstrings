        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai mesuré votre tour de taille en regardant devant et derrière."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેં આગળ અને પાછળને જોડીને વળાંક માપ્યો."
