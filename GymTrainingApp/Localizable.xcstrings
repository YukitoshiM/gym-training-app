          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform squats, push-ups, and jumps consecutively."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizar sentadillas, flexiones y saltos continuamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizar sentadillas, flexiones y saltos continuamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita jatkuvasti kumartumista, punnerruksia ja hyppyjä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuer des squats, des pompes et des sauts en continu."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuer des squats, des pompes et des sauts en continu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સતત રીતે કૂદકો મારવો, હાથથી ઊભા થવું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביצוע רצף של שכיבה, תרגול יד, קפיצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैठने, पुश-अप की मुद्रा और कूदने का क्रम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvršite kontinuirane aktivnosti: sjesti, položaj za podizanje ruku, skakanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folyamatosan végezzünk: hanyóközben állást, nyújtózást, ugrást."
