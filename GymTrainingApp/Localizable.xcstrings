    "runtime_messages.1e9b7e0b1de9": {
      "comment": "GymTrainingApp/Data/AppStore+DailyRecommendation.swift:416\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أنجزت ثلاثة أشياء اليوم. وسوف أعكس ذلك في اقتراح الغد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Avui he aconseguit tres coses. Ho reflectiré a la proposta de demà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosáhli jste všech tří cílů dne. Budou zahrnuty do návrhu pro zítra."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har nået de tre mål for i dag. Det vil blive reflekteret i morgendagens forslag."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die drei heute erreicht. Ich werde dies in den Vorschlägen für morgen berücksichtigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτεύχθηκαν οι τρεις σημερινοί στόχοι. Θα συμπεριληφθούν στις προτάσεις για αύριο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "I have achieved all three for today. This will be reflected in tomorrow's suggestions."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "I have achieved all three for today. This will be reflected in tomorrow's suggestions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I have achieved all three for today. This will be reflected in tomorrow's suggestions."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "I have achieved all three for today. This will be reflected in tomorrow's suggestions."
          }
        },
        "es-ES": {
          "stringUnit": {
