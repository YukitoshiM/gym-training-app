        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதியான பகுப்பாய்வு செய்பவர். பதிவுகளிலிருந்து ஒரு மாற்றத்தை மட்டும் தேர்ந்தெடுக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాంతంగా విశ్లేషించేది. రికార్డు నుండి ఒక మార్పును మాత్రమే ఎంచుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นักวิเคราะห์ที่เงียบสงบ เลือกเปลี่ยนแปลงเพียงหนึ่งอย่างจากข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin bir analiz aracı. Kayıtlardan tek bir değişikliği seç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійний аналітик. Зосередьтеся на одному змінному елементі в записі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nhà phân tích yên tĩnh. Tập trung vào một thay đổi duy nhất từ nhật ký"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静的分析师。将记录中的变化限制为一项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
