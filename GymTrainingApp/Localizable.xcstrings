            "value": "Focus on aligning your shoulders, upper back, and chest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on aligning your shoulders, upper back, and chest."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on aligning your shoulders, upper back, and chest."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrarse en la alineación de hombros, espalda y parte superior del pecho."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Centrarse en la alineación de hombros, espalda y parte superior del pecho."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiero olkapäitä ja rintaa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Alignez vos épaules, votre haut du dos et votre poitrine."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alignez vos épaules, votre haut du dos et votre poitrine."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખભા, પીઠ અને છાતીના ઉપરના ભાગને વ્યવસ્થિત કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ליישר את אזור הכתפיים והגב העליון"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कंधों, पीठ और छाती के ऊपरी हिस्से को व्यवस्थित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izravnajte ramena, prsnice i gornji dio leđa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa össze a vállakat, a hátat és a felsőtestet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memastikan kesejajaran bahu, punggung, dan bagian atas dada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allinea spalle, schiena e parte superiore del torace"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩・背中・胸上部を中心に整える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어깨, 등, 가슴 위 부분을 중심으로 자세를 맞춥니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खांदे, पाठ आणि छातीच्या भागाला व्यवस्थित ठेवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyempurnakan bahagian bahu, belakang, dan bahagian atas dada"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus op het corrigeren van je schouders, bovenrug en borst."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus på skulder, rygg og øvre del av brystet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skup się na wyrównaniu ramion, pleców i górnej części klatki piersiowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhe os ombros, a parte superior do tronco e os cotovelos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinhe os ombros, a parte superior do tronco e os cotovelos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Corectează postura: umeri, spate, piept superior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфокусируйтесь на правильном положении плеч, спины и верхней части груди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrovnajte ramena, chrbát a hornú časť hrude"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na ramena, hrbet in zgornjo del prsnih kost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokusera på axlar, rygg och övre bröstparti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோள்கள், முதுகு மற்றும் மார்பின் மேல் பகுதியைச் சீரமைத்தல்"
