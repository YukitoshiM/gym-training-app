    "core_ui.08b9d0492bce": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:840",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لاستخدام مسودات الذكاء الاصطناعي والتعليق الأسبوعي، فعّل ميزات الذكاء الاصطناعي ثم اختبر الاتصال."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilitzar els esborranys d'IA i els comentaris setmanals, activa les funcions d'IA i després comprova la connexió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li používat návrhy AI a týdenní zpětnou vazbu, zapněte funkce AI a poté otestujte připojení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vil bruge AI-udkast og ugentlig feedback, skal du slå AI-funktioner til og derefter teste forbindelsen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere für KI-Entwürfe und wöchentliches Feedback zuerst die KI-Funktionen und teste dann die Verbindung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να χρησιμοποιήσεις προσχέδια AI και εβδομαδιαία σχόλια, ενεργοποίησε τις λειτουργίες AI και έπειτα έλεγξε τη σύνδεση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To use AI drafts and weekly feedback, turn on AI features, then test the connection."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "To use AI drafts and weekly feedback, turn on AI features, then test the connection."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To use AI drafts and weekly feedback, turn on AI features, then test the connection."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "To use AI drafts and weekly feedback, turn on AI features, then test the connection."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar borradores de IA y comentarios semanales, activa las funciones de IA y después prueba la conexión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar borradores de IA y comentarios semanales, activa las funciones de IA y después prueba la conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat käyttää tekoälyluonnoksia ja viikoittaista palautetta, ota tekoälytoiminnot käyttöön ja testaa sitten yhteys."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser les brouillons IA et le bilan hebdomadaire, activez les fonctions IA puis testez la connexion."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser les brouillons IA et le bilan hebdomadaire, activez les fonctions IA puis testez la connexion."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ડ્રાફ્ટ અને સાપ્તાહિક પ્રતિસાદ વાપરવા માટે AI સુવિધાઓ ચાલુ કરો, પછી કનેક્શન તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להשתמש בטיוטות AI ובמשוב שבועי, יש להפעיל את תכונות ה-AI ואז לבדוק את החיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ड्राफ़्ट और साप्ताहिक टिप्पणी उपयोग करने के लिए AI सुविधाएँ चालू करें, फिर कनेक्शन जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za upotrebu AI skica i tjednih komentara uključite AI značajke, a zatim provjerite vezu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az MI-vázlatok és a heti visszajelzés használatához kapcsold be az MI-funkciókat, majd ellenőrizd a kapcsolatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan draf AI dan masukan mingguan, aktifkan fitur AI, lalu uji koneksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare le bozze IA e il feedback settimanale, attiva le funzioni IA e poi verifica la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI下書きや週次コメントを使う場合は、AI機能をオンにしてから接続確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 초안과 주간 피드백을 사용하려면 AI 기능을 켠 뒤 연결을 확인하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI मसुदे आणि साप्ताहिक अभिप्राय वापरण्यासाठी AI वैशिष्ट्ये सुरू करा, नंतर कनेक्शन तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menggunakan draf AI dan maklum balas mingguan, hidupkan ciri AI, kemudian uji sambungan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel AI-functies in en test daarna de verbinding om AI-concepten en wekelijkse feedback te gebruiken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "For å bruke AI-utkast og ukentlig tilbakemelding må du slå på AI-funksjoner og deretter teste tilkoblingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby używać szkiców AI i cotygodniowych uwag, włącz funkcje AI, a następnie sprawdź połączenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar rascunhos de IA e comentários semanais, ative os recursos de IA e depois teste a conexão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar rascunhos de IA e feedback semanal, ative os funcionalidades de IA e depois teste a ligação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a folosi schițele AI și feedbackul săptămânal, activează funcțiile AI, apoi testează conexiunea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать черновики ИИ и еженедельные комментарии, включите функции ИИ, затем проверьте подключение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete používať návrhy AI a týždennú spätnú väzbu, zapnite funkcie AI a potom otestujte pripojenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite uporabljati osnutke UI in tedenske povratne informacije, vklopite funkcije UI in nato preizkusite povezavo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på AI-funktioner och testa sedan anslutningen för att använda AI-utkast och veckovis feedback."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI வரைவுகளையும் வாராந்திர கருத்தையும் பயன்படுத்த, AI அம்சங்களை இயக்கி பின்னர் இணைப்பைச் சோதிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI డ్రాఫ్ట్‌లు మరియు వారపు ఫీడ్‌బ్యాక్ ఉపయోగించడానికి AI ఫీచర్లను ఆన్ చేసి, తర్వాత కనెక్షన్‌ను పరీక్షించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการใช้ร่างจาก AI และความคิดเห็นรายสัปดาห์ ให้เปิดฟีเจอร์ AI แล้วตรวจสอบการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI taslaklarını ve haftalık geri bildirimi kullanmak için AI özelliklerini aç, ardından bağlantıyı test et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використовувати чернетки ШІ та щотижневі коментарі, увімкніть функції ШІ, а потім перевірте підключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để dùng bản nháp AI và nhận xét hằng tuần, hãy bật tính năng AI rồi kiểm tra kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用AI草稿和每周反馈，请先开启AI功能，再测试连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用AI草稿和每週反饋，請先開啟AI功能，再測試連線。"
          }
        }
      }
    },
