    "health_meals_body_ai.051a5a9c5eea": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:137\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك التحقق من مستويات نومك وتعافيك ونشاطك مرة واحدة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu comprovar els vostres nivells de son, recuperació i activitat alhora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete si prohlédnout souhrn dat o spánku, odpočinku a aktivitách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se din søvn, restitution og aktivitetsniveau sammen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Schlaf, Erholung und Aktivität zusammen überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να δείτε τα δεδομένα ύπνου, ανάκαμψης και δραστηριότητας μαζί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view your sleep, recovery, and activity in one place."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view your sleep, recovery, and activity in one place."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view your sleep, recovery, and activity in one place."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can view your sleep, recovery, and activity in one place."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede consultar su sueño, recuperación y actividad de forma conjunta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede consultar su sueño, recuperación y actividad de forma conjunta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit tarkistaa unen, palautumisen ja aktiivisuuden yhdessä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez consulter votre sommeil, votre récupération et votre niveau d'activité."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez consulter votre sommeil, votre récupération et votre niveau d'activité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઊંઘ, પુનઃપ્રાપ્તિ અને પ્રવૃત્તિને એકસાથે ચકાસી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבדוק את השינה, ההתאוששות והפעילות יחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप नींद, आराम और गतिविधि की मात्रा को एक साथ देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete pregledati svoje dane spavanja, oporavka i aktivnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alvást, pihenést és aktivitást egyszerre megtekintheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat melihat total waktu tidur, pemulihan, dan aktivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi visualizzare e confrontare il sonno, il recupero e l'attività fisica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠・回復・活動量をまとめて確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면, 회복, 활동량을 함께 확인하실 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही झोप, विश्रांती आणि हालचाल यांचा एकत्रितपणे आढावा घेऊ शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh melihat data tidur, pemulihan, dan aktiviti secara keseluruhan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je slaap-, herstel- en activiteit in één overzicht."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se søvn, hvile og aktivitet sammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz sprawdzić dane dotyczące snu, regeneracji i aktywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode verificar seu sono, recuperação e nível de atividade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode verificar seu sono, recuperação e nível de atividade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți verifica împreună somnul, recuperarea și activitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете просмотреть данные о сне, отдыхе и активности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete získať prehľad o spánku, regenerácii a aktivitách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko preverite spanje, regeneracijo in aktivnost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan enkelt se din sömn, återhämtning och aktivitetsnivå tillsammans."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தூக்கம், ஓய்வு மற்றும் செயல்பாடுகளை ஒரே இடத்தில் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిద్ర, కోలుకోవడం మరియు కార్యాచరణను ఒకేసారి చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถตรวจสอบการนอน, การฟื้นตัว และกิจกรรมต่างๆ ได้อย่างครบถ้วน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku, dinlenme ve aktivite verilerini tek bir yerde görüntüleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна переглянути дані про сон, відновлення та активність разом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem tổng hợp dữ liệu giấc ngủ, phục hồi và hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以查看睡眠、恢复和活动量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以查看睡眠、恢復和活動量。"
          }
        }
      }
    },
