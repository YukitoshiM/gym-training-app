        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São apenas valores de referência, não devem ser armazenados em registros ou gráficos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São apenas valores de referência, não devem ser armazenados em registros ou gráficos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt valori de referință cu nivel scăzut de încredere. Nu le salvați în înregistrările sau graficele dvs."
