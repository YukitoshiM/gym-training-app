    "core_ui.647335981a99": {
      "comment": "GymTrainingApp/Features/Onboarding/InitialSetupView.swift:390",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دع الباقي لـ BodyMode. يقترح لك كل يوم ما يصل إلى ثلاثة إجراءات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa que BodyMode se n'encarregui. Cada dia et suggereix fins a tres accions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechte zbytek na BodyMode. Každý den navrhne až tři akce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad BodyMode tage over herfra. Hver dag foreslås op til tre handlinger."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Überlasse den Rest BodyMode. Jeden Tag werden bis zu drei Aktionen vorgeschlagen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άφησε το BodyMode να συνεχίσει από εδώ. Κάθε μέρα προτείνει έως τρεις ενέργειες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Let BodyMode take it from here. Each day, it suggests up to three actions."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Let BodyMode take it from here. Each day, it suggests up to three actions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let BodyMode take it from here. Each day, it suggests up to three actions."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Let BodyMode take it from here. Each day, it suggests up to three actions."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el resto en manos de BodyMode. Cada día te sugerirá hasta tres acciones."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el resto en manos de BodyMode. Cada día te sugerirá hasta tres acciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna BodyModen jatkaa tästä. Se ehdottaa joka päivä enintään kolme toimintoa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez BodyMode prendre le relais. Chaque jour, l'app propose jusqu'à trois actions."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez BodyMode prendre le relais. Chaque jour, l'app propose jusqu'à trois actions."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બાકીનું BodyMode પર છોડી દો. તે દરરોજ વધુમાં વધુ ત્રણ ક્રિયાઓ સૂચવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכאן BodyMode מטפל בשאר. בכל יום מוצעות עד שלוש פעולות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब बाकी BodyMode पर छोड़ दें। यह हर दिन अधिकतम तीन काम सुझाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepustite dalje BodyModeu. Svaki dan predlaže do tri radnje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bízd innen a BodyMode-ra. Naponta legfeljebb három műveletet javasol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Serahkan selanjutnya kepada BodyMode. Setiap hari, aplikasi menyarankan hingga tiga tindakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia fare a BodyMode. Ogni giorno ti suggerirà fino a tre azioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとはBodyModeに任せてください。毎日、今日やることを最大3つ提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 BodyMode에 맡기세요. 매일 최대 3개의 행동을 추천합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आता पुढचे BodyMode वर सोडा. ते दररोज जास्तीत जास्त तीन कृती सुचवेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Serahkan selebihnya kepada BodyMode. Setiap hari, aplikasi mencadangkan sehingga tiga tindakan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de rest aan BodyMode over. Elke dag krijg je maximaal drie acties voorgesteld."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "La BodyMode ta over herfra. Hver dag foreslås opptil tre handlinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól BodyMode zająć się resztą. Każdego dnia zaproponuje do trzech działań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o restante com o BodyMode. Todos os dias, ele sugere até três ações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe o resto com o BodyMode. Todos os dias são sugeridas até três ações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă BodyMode să continue de aici. În fiecare zi, îți recomandă până la trei acțiuni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дальше позаботится BodyMode. Каждый день приложение предлагает до трёх действий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechajte zvyšok na BodyMode. Každý deň navrhne najviac tri akcie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od tu naprej prepustite BodyModeu. Vsak dan predlaga do tri dejanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt BodyMode ta över härifrån. Varje dag föreslås upp till tre åtgärder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இனி BodyMode பார்த்துக்கொள்ளட்டும். தினமும் அதிகபட்சம் மூன்று செயல்களைப் பரிந்துரைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇక నుంచి BodyMode చూసుకుంటుంది. ప్రతి రోజు గరిష్ఠంగా మూడు చర్యలను సిఫార్సు చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากนี้ให้ BodyMode ดูแล ทุกวันระบบจะแนะนำสิ่งที่ควรทำไม่เกิน 3 อย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradan sonrasını BodyMode'a bırak. Her gün en fazla üç eylem önerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далі подбає BodyMode. Щодня застосунок пропонує до трьох дій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để BodyMode lo phần còn lại. Mỗi ngày, ứng dụng đề xuất tối đa ba hành động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来交给BodyMode。每天最多为你建议3项行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來交給BodyMode。每天最多為你建議3項行動。"
          }
        }
      }
    },
