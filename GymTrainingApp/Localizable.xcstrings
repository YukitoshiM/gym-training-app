        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoeveelheid verbruikte energie is nog niet geregistreerd. De voedingsgegevens zijn wel opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Energiforbruk i \"Health\" er ikke registrert. Kostholdsregistrering er lagret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać zużycia energii przez aplikację Health. Zapisano jedynie dane dotyczące posiłków."
