        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho misurato la circonferenza della vita combinando le misurazioni frontali e laterali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正面と背面を合わせてウエストまわりを確認しました。"
