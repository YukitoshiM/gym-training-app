        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can register by granting location permissions in the app settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can register by granting location permissions in the app settings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can register by granting location permissions in the app settings."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes registrarte permitiendo el acceso a la ubicación en la aplicación de configuración."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes registrarte permitiendo el acceso a la ubicación en la aplicación de configuración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit rekisteröityä antamalla sijaintipalvelut asetuksissa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En autorisant l'accès à la localisation dans l'application, vous pouvez vous enregistrer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En autorisant l'accès à la localisation dans l'application, vous pouvez vous enregistrer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "\"સેટિંગ્સ\" એપ્લિકેશનમાં સ્થાનની પરવાનગી આપવાથી, તમે નોંધણી કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להירשם על ידי מתן אישור למיקום באפליקציית ההגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"सेटिंग ऐप\" में लोकेशन की अनुमति देने पर पंजीकरण संभव है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete se registrirati ako dopustite pristup lokaciji u aplikaciji za postavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az \"Állapot\" alkalmazásban engedélyezed a helyzet követést, akkor regisztrálhatsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan mengizinkan lokasi di aplikasi pengaturan, Anda dapat mendaftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilitando la posizione nelle impostazioni dell'app, potrai registrarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定アプリで位置情報を許可すると登録できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 앱에서 위치 정보 접근을 허용하면 등록할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "'सेटिंग्ज' ॲपमध्ये लोकेशन (स्थान) परवानगी दिल्यास नोंदणी करता येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh mendaftar dengan mengizinkan maklumat lokasi dalam aplikasi Tetapan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Door locatie-informatie toe te staan in de instellingen, kunt u zich registreren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan registrere deg ved å gi tillatelse til posisjonsinformasjon i appen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz się zarejestrować, jeśli w aplikacji \"Ustawienia\" zezwolisz na dostęp do lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso à localização nas configurações permite o registro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso à localização nas configurações permite o registro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți înregistra activând permisiunea pentru locație în aplicația de setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При согласии с запросом на доступ к местоположению, вы сможете зарегистрироваться."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri povolení prístupu k polohu v nastaveniach môžete zaregistrovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S aktiviranjem lokacije v aplikaciji lahko ustvarite račun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan registrera dig genom att tillåta platsinformation i appinställningarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகள் பயன்பாட்டில், இருப்பிடத்தை அனுமதிப்பதன் மூலம் பதிவு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్ యాప్‌లో స్థాన సమాచారాన్ని అనుమతించడం ద్వారా నమోదు చేసుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถลงทะเบียนได้โดยอนุญาตให้แอปเปิดตำแหน่งที่ตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Ayarlar\" uygulamasında konum bilgisi izni vererek kaydolabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареєструватися можна, якщо у додатку \"Налаштування\" дозволено доступ до місцезнаходження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đăng ký bằng cách cho phép ứng dụng truy cập vị trí trong cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用设置中允许位置信息，即可注册"
          }
        },
        "zh-Hant": {
