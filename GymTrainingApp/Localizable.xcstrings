        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वास्थ्य की खपत ऊर्जा अभी तक प्राप्त नहीं हुई है। केवल भोजन का रिकॉर्ड संग्रहीत है।"
