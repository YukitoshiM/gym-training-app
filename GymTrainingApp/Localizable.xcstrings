    "domain_catalog.c035ffe6187c": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:336\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "احملي ثقلًا أمام صدرك واجلسي في وضع القرفصاء مع وضع الجزء العلوي من جسمك في وضع مستقيم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Agafeu un pes davant del pit i poseu-vos a la gatzoneta amb la part superior del cos dret."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte váhu před hrudníkem a ohýbejte se v záklonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft en vægt foran brystet og stå med overkroppen ret, mens du bøjer dig ned."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer Gewichtsplatte vor der Brust arbeiten und im Stehen aufstehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε ένα βάρος μπροστά στο στήθος και σηκωθείτε, διατηρώντας το πάνω μέρος του σώματος ίσιο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a weight in front of your chest and squat down with your upper body upright."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a weight in front of your chest and squat down with your upper body upright."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a weight in front of your chest and squat down with your upper body upright."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a weight in front of your chest and squat down with your upper body upright."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén un peso frente al pecho y agáchate manteniendo el tronco erguido."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén un peso frente al pecho y agáchate manteniendo el tronco erguido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä käsipainoa rinnan edessä ja kumarrut ylös."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez un poids devant vous et pliez-vous en gardant le haut du corps droit."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez un poids devant vous et pliez-vous en gardant le haut du corps droit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છાતી પર વજન લઈને, શરીરને ઊભું રાખીને બેસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להחזיק משקולת בחלק הקדמי של החזה ולשבת עם הגוף זקוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सीने पर वजन रखें, और अपने ऊपरी शरीर को सीधा रखते हुए झुकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite uteg pred grdom i držite tijelo izduženo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a súlyt a derék előtt, és álljon, majd üljön le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat beban di depan dada, lalu tekuk tubuh sambil menjaga bagian atas tetap tegak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere un peso davanti al petto e piegarsi mantenendo il busto eretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸の前で重りを持ち、上体を立てたまましゃがむ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가슴 앞에 무게를 들고, 상체를 세운 채로 앉습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "छातीच्या मध्यभागी वजन उचला, शरीर सरळ ठेवून खाली वाका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat beban di hadapan dada, kemudian bungkukkan badannya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Til een gewicht voor je borst en buig je omhoog met je bovenlichaam recht."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft en vekt foran brystet og stå i oppreist stilling mens du bøyer deg fremover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnieś ciężar przed klatką piersiową i ustaw się w pozycji stojącej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure um peso na frente do peito e sente-se com as pernas retas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure um peso na frente do peito e sente-se com as pernas retas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți o greutate în fața pieptului și așezați-vă cu corpul drept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимите вес перед грудью и встаньте прямо, затем согнитесь в коленях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte činku pred hrudníkom a zdvíhajte sa v sede."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite utež pred prsmi,nato pa se postavite v položaj za stojišče."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft en vikt framför bröstet och stå med överkroppen rak samtidigt som du böjer dig ner."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மார்பில் எடையை வைத்து, உங்கள் உடலை நேராக நிறுத்தி குனியவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఛాతీ ముందు బరువును పట్టుకుని, శరీరాన్ని నిటారుగా ఉంచి కూర్చోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเวทไว้ที่หน้าอก, ยืนตัวตรง แล้วก้มตัวลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlığı göğsünde tutarak, üst vücudunu dik tutarak çömel."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте вагу перед грудьми, залишаючись у вертикальному положенні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng tạ ở ngực, giữ thân trên thẳng và cúi người xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在胸前举起哑铃，保持上半身站立"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在胸前舉起啞鈴，並保持身體站立"
          }
        }
      }
    },
