          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführen einer Reihe von Übungen: Hocken, Liegestütze, Springen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελέστε συνεχόμενα διατάσεις, σαν να σκύβετε, σαν να κάνετε κράμπες και άλματα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform squats, push-ups, and jumps consecutively."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform squats, push-ups, and jumps consecutively."
          }
        },
        "en-GB": {
