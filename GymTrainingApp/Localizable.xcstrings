    "health_meals_body_ai.bff7fb34d198": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:647\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تشغيل \"استخدام وظيفة الذكاء الاصطناعي\" في الإعدادات. يمكن حفظ السجلات اليدوية كما هي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, activeu \"Utilitza la funció AI\" a la configuració. Els registres manuals es poden desar tal com estan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve výchozím nastavení zapněte funkci \"Použít AI\". Ruční záznamy můžete uložit i takto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver \"Brug AI-funktion\" i indstillingerne. Du kan gemme manuel registrering som den er."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie \"KI-Funktionen verwenden\" in den Einstellungen. Die manuelle Aufzeichnung kann so gespeichert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε την επιλογή \"Χρήση λειτουργίας AI\" στις ρυθμίσεις. Μπορείτε να αποθηκεύσετε τις χειροκίνητες καταγραφές όπως είναι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on \"Use AI function\" in settings. You can still save this manual record."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on \"Use AI function\" in settings. You can still save this manual record."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on \"Use AI function\" in settings. You can still save this manual record."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on \"Use AI function\" in settings. You can still save this manual record."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite \"Usar la función de IA\" en la configuración. Puede guardar los registros manualmente de esta manera."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite \"Usar la función de IA\" en la configuración. Puede guardar los registros manualmente de esta manera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota AI-toiminnon käyttö päälle asetuksista. Manuaaliset merkinnät voidaan tallentaa tällä tavalla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez \"Utiliser la fonctionnalité IA\" dans les paramètres. Vous pouvez toujours enregistrer manuellement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez \"Utiliser la fonctionnalité IA\" dans les paramètres. Vous pouvez toujours enregistrer manuellement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેટિંગ્સમાં \"AI સુવિધાનો ઉપયોગ કરો\" ને ચાલુ કરો. તમે મેન્યુઅલી યાદોને સાચવી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעילו את \"שימוש בפונקציית AI\" בהגדרות. ניתן לשמור את הרישום באופן ידני כעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग में \"AI सुविधा का उपयोग करें\" को चालू करें। आप मैन्युअल रिकॉर्डिंग को इस तरह से सहेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite \"Koristiti AI funkciju\" u postavkama. Ručni zapis možete zadržati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az \"AI funkció használata\" opciót a beállításokban. A manuális rögzítés így is menthető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan \"Gunakan fitur AI\" dalam pengaturan. Catatan manual dapat disimpan seperti ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva \"Usa la funzione AI\" nelle impostazioni. Puoi salvare manualmente le registrazioni in questo modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で「AI機能を使う」をオンにしてください。手動記録はこのまま保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 \"AI 기능을 사용\"을 켜주세요. 수동 기록은 그대로 저장할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंगमध्ये \"AI कार्य वापरा\" हे चालू करा. मॅन्युअल नोंदी जशीच्या तशी जतन करता येतील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan \"Gunakan Fungsi AI\" dalam tetapan. Catatan manual boleh disimpan seperti ini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel \"AI-functie gebruiken\" in in de instellingen. U kunt deze handmatige opname nog steeds opslaan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver \"Bruk AI-funksjon\" i innstillingene. Du kan fortsatt lagre manuelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz \"Używaj funkcji AI\" w ustawieniach. Ręczne zapisy można nadal zachować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a opção \"Usar a função AI\" nas configurações. Pode guardar manualmente os registos desta forma."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a opção \"Usar a função AI\" nas configurações. Pode guardar manualmente os registos desta forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează opțiunea \"Folosește funcția AI\" în setări. Înregistrările manuale pot fi salvate așa cum sunt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите функцию \"Использовать ИИ\" в настройках. Ручные записи можно сохранить таким образом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite funkciu \"Používať AI\" v nastaveniach. Ručné zaznamenávanie môžete uložiť takto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vključite funkcijo \"Uporaba AI\" v nastavitvah. Ročni zapisi lahko shranite tako."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera \"Använd AI-funktion\" i inställningarna. Du kan spara manuellt registreringar som de är."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகளில் \"AI செயல்பாட்டைப் பயன்படுத்து\" என்பதை இயக்கவும். கைமுறையாக பதிவுகளைச் சேமிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"AI ఫంక్షన్‌ను ఉపయోగించు\" అనేదాన్ని సెట్టింగ్‌లలో ఆన్ చేయండి. మాన్యువల్ రికార్డింగ్ ఈ విధంగా సేవ్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้งาน \"ใช้ฟังก์ชัน AI\" ในส่วนการตั้งค่า สามารถบันทึกด้วยตนเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarda \"AI özelliğini kullan\" seçeneğini açın. Manuel kayıt bu şekilde kaydedilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У налаштуваннях увімкніть \"Використовувати функцію AI\". Ручний запис можна зберегти таким чином."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng bật \"Sử dụng chức năng AI\" trong cài đặt. Bạn vẫn có thể lưu lại mục ghi bằng tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中启用“使用AI功能”。手动记录可以继续保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定中，請開啟「使用 AI 功能」。 手動記錄可以繼續保存。"
          }
        }
      }
    },
