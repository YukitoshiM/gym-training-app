        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद की पुष्टि की जा रही है। पूरा होने पर स्वचालित रूप से दिखाई देगा।।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naloga se čeka potvrda. Automatski će biti ažurirana nakon potvrde."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás jóvá kell még tennie. Automatikusan megjelenik a végrehajtás után."
