        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 승인 대기 중입니다. 완료되면 자동으로 반영됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खरेदीची प्रतीक्षा केली जात आहे. पूर्ण झाल्यावर आपोआप अपडेट होईल."
