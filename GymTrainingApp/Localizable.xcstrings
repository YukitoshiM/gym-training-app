    "domain_catalog.50c6a86a89fe": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:350\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ الدمبلز بالقرب من جسمك وقم بخفض الجزء العلوي من جسمك باستخدام الوركين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu les manuelles a prop del vostre cos i baixeu la part superior del cos amb els malucs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte činky blízko těla a nakloňte se, přičemž pohyb provádějte hlavně v kyčli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold håndvægten tæt på kroppen og sænk overkroppen, mens du bruger hofterne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurzhantel in der Nähe des Körpers halten und den Oberkörper durch die Hüfte nach unten drücken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τον δίσκο κοντά στο σώμα σας και γυρίστε το πάνω μέρος του σώματος, χρησιμοποιώντας την κίνηση των γονάτων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the dumbbell close to your body and lower your upper body with hip movement."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the dumbbell close to your body and lower your upper body with hip movement."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the dumbbell close to your body and lower your upper body with hip movement."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the dumbbell close to your body and lower your upper body with hip movement."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén las mancuernas cerca del cuerpo y inclínate hacia arriba, utilizando la cadera como punto de apoyo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén las mancuernas cerca del cuerpo y inclínate hacia arriba, utilizando la cadera como punto de apoyo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kahvakuula lähelläsi ja laske ylävartaloa polvien avulla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir l'haltère près du corps et se pencher en utilisant les hanches."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir l'haltère près du corps et se pencher en utilisant les hanches."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડમ્બેલને શરીરની નજીક રાખો અને હિપ્સ દ્વારા ઉપરના ભાગને નીચે કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו את המשקולת קרוב לגוף, והשליכו את הגוף קדימה תוך שימוש בעיקר בשרירי הירכיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शरीर के करीब डम्बल को रखें और कूल्हे की गति से ऊपरी शरीर को नीचे करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite dumbbell blizu tijela i nagnete gornji dio tijela, koristeći gluteus kao izvor snage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd az ellógatot a test közelében, és hajtj ki a felsőtestet a combok mozgása által."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang dumbbell dekat tubuh, lalu condongkan badan dengan gerakan dari pinggul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni i pesi vicino al corpo e piega il busto, mantenendo le ginocchia dritte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダンベルを体の近くに保ち、股関節主導で上体を倒す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덤벨을 몸 가까이에 두고, 엉덩이를 중심으로 상체를 숙인다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डंबल शरीराच्या जवळ ठेवा आणि नितंबांच्या मदतीने शरीराला वरच्या दिशेने वाकवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan dumbbell berada di dekat tubuh, kemudian condongkan bahagian atas tubuh dengan mengandalkan lutut."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de kettlebell dichtbij en kantel je bovenlichaam, waarbij je de heupen gebruikt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold vektstangen nær kroppen og bruk hoftene til å senke overkroppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj hantl blisko ciała i opieraj się na nim, aby wyginać tułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o haltere perto do corpo e incline o tronco, utilizando os quadris."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o haltere perto do corpo e incline o tronco, utilizando os quadris."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți gantera aproape de corp și aplecați-vă, folosind mișcarea șoldurilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите гантель рядом с собой и наклоняйте корпус, чтобы опустить верхнюю часть тела."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte rúbiky blízko tela a ohývajte trup, pričom sa zamerajte na pohyby v bedrách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite žogo blizu teles in se nagnete z glavo naprej, pri čemer uporabite gibanje kolena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll hanteln nära kroppen och böj dig i höften för att luta överkroppen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உடலுக்கு அருகில் தண்டுகளை வைத்திருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
