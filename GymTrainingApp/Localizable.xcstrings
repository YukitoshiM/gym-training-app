        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık verisi yetkilendirilmemiş, sadece uygulama geçmişi kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Health не дозволено, збережено лише історію додатку."
