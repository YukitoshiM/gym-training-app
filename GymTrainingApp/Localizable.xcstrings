        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरण: एका व्यायामाची संख्या कमी करून विश्रांती जास्त घ्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: Kurangkan satu jenis latihan untuk istirahat yang lebih lama"
          }
        },
