    "training.7d2c88039500": {
      "comment": "GymTrainingApp/Features/Plans/AIPlanCoachView.swift:337\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تمرير الأحداث المسجلة المقابلة للمعدات المحددة فقط إلى الذكاء الاصطناعي كمرشحين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només els esdeveniments registrats corresponents a l'equip seleccionat es transmeten a AI com a candidats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskytujeme pouze registrované cviky, které odpovídají vybranému vybavení, jako návrhy pro AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de registrerede øvelser, der svarer til det valgte udstyr, sendes videre til AI som forslag."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die registrierten Übungen, die zu der ausgewählten Ausrüstung passen, werden an das KI-System übergeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο τα είδη που είναι καταγεγραμμένα και αντιστοιχούν στο επιλεγμένο εξοπλισμό, θα μεταφερθούν στον AI ως προτάσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the registered exercises that correspond to the selected equipment are passed to the AI as candidates."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the registered exercises that correspond to the selected equipment are passed to the AI as candidates."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the registered exercises that correspond to the selected equipment are passed to the AI as candidates."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the registered exercises that correspond to the selected equipment are passed to the AI as candidates."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pasan los ejercicios registrados que corresponden al equipo seleccionado como candidatos a la IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pasan los ejercicios registrados que corresponden al equipo seleccionado como candidatos a la IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain valitulle laitteelle rekisteröidyt harjoitukset lähetetään AI:lle ehdollisina."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les exercices enregistrés correspondant à l'équipement sélectionné sont proposés à l'IA."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les exercices enregistrés correspondant à l'équipement sélectionné sont proposés à l'IA."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માત્ર પસંદ કરેલા સાધનો સાથે સંબંધિત, નોંધાયેલા કસરતોને જ AI ને સૂચવવા માટે પાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכנית מציגה רק את התרגילים הרשומים המתאימים לציוד שנבחר למערכת הבינה המלאכותית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिलेक्ट किए गए उपकरण के अनुरूप केवल पंजीकृत अभ्यासों को ही AI को सुझाए के रूप में दिया जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepoznajte samo one upisane vježbe koje odgovaraju odabranom opremu i predate ih AI-ju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak azokat a regisztrált edzéseket javasolja az AI-nak, amelyek a kiválasztott eszközhöz tartoznak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya memberikan item yang terdaftar sesuai dengan peralatan yang dipilih kepada AI sebagai opsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa solo gli esercizi registrati corrispondenti all'attrezzatura selezionata all'IA come opzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した器具に対応する登録済み種目だけをAIへ候補として渡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 장비에 해당하는 등록된 운동만 AI에게 후보로 전달합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या उपकरणासाठी नोंदवलेले व्यायामच AI ला सुचवण्यासाठी पाठवले जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya senaman yang telah ditetapkan yang sesuai dengan peralatan yang dipilih akan dikembalikan kepada AI sebagai pilihan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de geregistreerde oefeningen die overeenkomen met het geselecteerde apparaat worden aan de AI doorgegeven."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de registrerte øvelsene som samsvarer med det valgte utstyret, sendes til AI som forslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazujemy tylko zarejestrowane ćwiczenia, które odpowiadają wybranemu sprzętowi do AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os exercícios já registrados correspondentes ao equipamento selecionado são enviados ao AI como opções."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os exercícios já registrados correspondentes ao equipamento selecionado são enviados ao AI como opções."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferim doar exercițiile înregistrate, corespunzătoare echipamentului selectat, către AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаем только зарегистрированные упражнения, соответствующие выбранному оборудованию, в ИИ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre AI posielame len registrované cviky, ktoré zodpovedajú vybranému zariadeniu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite samo tiste vnete, ki so združene z izbranimi orodji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast de registrerade övningarna som matchar det valda verktyget skickas till AI."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கப்பட்ட உபகரணங்களுக்கு ஏற்ற, பதிவு செய்யப்பட்ட பயிற்சிகளை மட்டும் AI-க்கு பரிந்துரைக்கிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న పరికరానికి సంబంధించిన, నమోదు చేసిన వ్యాయామాలను మాత్రమే AI కి సూచనగా అందిస్తాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งเฉพาะรายการที่ลงทะเบียนแล้วซึ่งสอดคล้องกับอุปกรณ์ที่เลือกไปยัง AI เท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen ekipmanlara uygun olan ve önceden kaydedilmiş egzersizleri sadece AI'ye öneri olarak verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаємо лише ті зареєстровані вправи, які відповідають обраному обладнанню, як варіанти для AI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đưa các bài tập đã đăng ký tương ứng với dụng cụ đã chọn cho AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只将与您选择的器械相对应的已注册项目，作为候选选项传递给 AI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只將與所選器材相符的已記錄運動項目作為候選項傳送給AI。"
          }
        }
      }
    },
