        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a few things now and review everything later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a few things now and review everything later."
          }
        },
        "en-US": {
