        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai atteint les 3 objectifs d'aujourd'hui. Cela sera pris en compte dans les suggestions de demain."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું આજે ​​ત્રણ કાર્યો પૂર્ણ કરી લીધા છે. આવતી કાલના સૂચનોમાં તેનો સમાવેશ થશે."
