        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de laatste 7 dagen van beweging en voedingsgegevens bekeken (3 bewegingen, 8 voedingen)"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har kontrollert de siste 7 dagers treningshistorikk (3 økter) og kostholdsregistreringer (8)."
          }
        },
        "pl": {
          "stringUnit": {
