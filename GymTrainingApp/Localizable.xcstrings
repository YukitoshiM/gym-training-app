        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menunjukkan item yang berubah secara bersamaan sebagai kemungkinan penyebab, tetapi tidak menentukan alasan atau kondisi medis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica gli elementi che sono cambiati contemporaneamente, senza però stabilire cause o condizioni mediche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に変化した項目を候補として示すもので、原因や医療状態を断定しません。"
