            "state": "translated",
            "value": "Faça da próxima vez um progresso significativo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți totul într-o singură sesiune"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте так, чтобы прогресс продолжался и в следующий раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamerajte sa na jeden konkrétny cieľ"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite naslednjo pot za nadaljnje izboljšave"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör nästa steg till en framgång"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடுத்த முறை மேம்படுத்தவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరిసారి అభివృద్ధి చేయడానికి ప్రయత్నించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้เป็นกิจกรรมที่พัฒนาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki de gelişime odaklanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Давайте робимо наступний крок таким, щоб він приносив результат"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tập trung vào một mục tiêu để phát triển"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也让它成为一次增长"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也讓這次的進度更長"
          }
        }
      }
    },
