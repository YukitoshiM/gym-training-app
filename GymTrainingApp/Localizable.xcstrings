        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록과 함께 다음 행동 및 다음 달 목표를 제안"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंदी आणि पुढील कृती तसेच पुढील महिन्याचे ध्येय सुचवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangkan tindakan seterusnya dan matlamat bulan akan datang berdasarkan catatan"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel opnamen voor met de volgende actie en het doel voor de komende maand"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Foreslå neste handling og målet for neste måned basert på tidligere registreringer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygeneruj propozycje kolejnych działań i cel na następny miesiąc na podstawie zapisanych danych"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerir próximos passos e metas para o próximo mês com base nos registos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerir próximos passos e metas para o próximo mês com base nos registos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerează următoarea acțiune și obiectivele lunii, pe baza înregistrărilor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить следующие действия и цели на следующий месяц, основываясь на сохраненных данных"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhniť ďalšie aktivity a ciele na budúci mesiac na základe vašich záznamov"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predlagajte naslednje dejanje in cilje za naslednji mesec na podlagi že zbranih podatkov"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Föreslå sammanfattade registreringar samt nästa åtgärd och målet för nästa månad"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்யப்பட்ட நாட்களுடன் அடுத்த நடவடிக்கையையும், மாதத்திற்கான இலக்குகளையும் பரிந்துரைக்கவும்"
          }
