        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுகாதாரத் தகவல் கிடைக்கவில்லை, பயன்பாட்டு வரலாறு மட்டும் சேமிக்கப்பட்டுள்ளது."
