    "release_delta.scheduled_report_explanation": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إنشاؤه تلقائيًا عند فتح التطبيق لأول مرة بعد الموعد المحدد. إذا لم يكن بالإمكان الاتصال بالذكاء الاصطناعي، فسيتم الاحتفاظ بملخص في الجهاز."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es genera automàticament quan obres l'aplicació per primera vegada després de l'hora programada. Si no pots connectar amb la IA, es manté un resum a l'aparell."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky generuje zprávu po prvním otevření aplikace po naplánovaném čase. Pokud není možné připojení k AI, zůstane uložená souhrn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereres automatisk, når du åbner appen første gang efter det planlagte tidspunkt. Hvis der ikke kan oprettes forbindelse til AI, gemmes en opsummering på din enhed."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird automatisch erstellt, wenn Sie die App zum ersten Mal nach dem geplanten Zeitpunkt öffnen. Bei Problemen mit der Verbindung werden die gespeicherten Informationen angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργείται αυτόματα όταν ανοίξετε την εφαρμογή για πρώτη φορά μετά τη προγραμματισμένη ώρα. Εάν δεν μπορεί να συνδεθεί με το AI, διατηρείται μια περίληψη στην εφαρμογή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically generated when you first open the app after the scheduled time. If AI connection fails, retains summary within the device."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically generated when you first open the app after the scheduled time. If AI connection fails, a summary will be left on your device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically generated when you first open the app after the scheduled time. If AI connection fails, it leaves a summary on your device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically generated when you first open the app after the scheduled time. If AI connection fails, it leaves a summary on your device."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se genera automáticamente cuando abres la aplicación por primera vez después del horario programado. Si no se puede conectar con la IA, se conserva un resumen en el dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se genera automáticamente al abrir la aplicación por primera vez después del horario programado. Si no se puede conectar con la IA, se conserva un resumen en el dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luodaan automaattisesti, kun avaat sovelluksen ensimmäisen kerran aikataulutetun ajan jälkeen. Jos yhteys AI:hin ei onnistu, tallennetaan tiedot."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Généré automatiquement lors de la première ouverture de l'application après l'heure prévue. Si la connexion à l'IA échoue, un résumé est conservé sur votre appareil."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Généré automatiquement lors de la première ouverture de l'application après l'heure prévue. En cas d'impossibilité de connexion à l'IA, le résumé local est conservé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આપની અપેક્ષિત સમયે એપ્લિકેશન ખોલ્યા પછી, આપોઆપ જનરેટ થશે. જો AI સાથે કનેક્શન ન થઈ શકે, તો ઉપકરણ પરનો સારાંશ સચવાયેલ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יוצר דוח אוטומטי בעת הפתיחה הראשונה לאחר הזמנה מתוזמנת. במקרה של תקשורת עם AI לא אפשרית, הדוח יירשם באופן מקומי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्वचालित रूप से उत्पन्न होता है जब आप पहली बार निर्धारित समय के बाद ऐप खोलते हैं। यदि AI से कनेक्ट नहीं किया जा सकता है, तो डिवाइस पर सारांश सहेजा जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski se generira kada prvi put otvorite aplikaciju nakon zakazano vrijeme. Ako nije moguće povezati s AI-om, ostaje izvješće iz uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tervszerű időpont után, amikor először nyitod meg az alkalmazást, automatikusan generálódik. Ha nem tud kapcsolni az AI-hez, a helyi összefoglalót használja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara otomatis dibuat saat aplikasi dibuka setelah waktu yang dijadwalkan. Jika tidak dapat terhubung ke AI, ringkasan tetap disimpan di perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Generato automaticamente al primo utilizzo dell'app dopo l'orario previsto. Se non è possibile connettersi all'AI, conserva un riepilogo sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定時刻後に最初にアプリを開いた時、自動生成します。AIに接続できない場合も端末内の要約を残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정된 시간에 앱을 처음 켰을 때 자동으로 생성됩니다. AI 연결이 불가능한 경우에도, 기기 내 요약 정보를 유지합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियोजित वेळेनंतर, ॲप उघडल्यावर आपोआप तयार होईल. AI कनेक्ट न झाल्यास, तुमच्या डिव्हाइसवर माहिती साठवली जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan akan dihasilkan secara automatik apabila aplikasi dibuka untuk pertama kalinya selepas masa yang ditetapkan. Jika tidak dapat berhubung dengan AI, ringkasan dalam peranti akan disimpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Na de geplande tijd, genereert het automatisch een rapport bij de eerste opening van de app. Als er geen verbinding met AI mogelijk is, blijft een samenvatting op uw apparaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereres automatisk første gang du åpner appen etter det planlagte tidspunktet. Hvis tilkoblingen til AI mislykkes, lagres en oppsummering på enheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie generowany po pierwszym otwarciu aplikacji po ustalonym czasie. W przypadku problemów z połączeniem, zapisuje podsumowanie w urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerado automaticamente quando você abre o aplicativo após o horário agendado. Se não for possível conectar ao AI, mantém um resumo no dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerado automaticamente quando a aplicação é aberta após o horário agendado. Se não for possível conectar à IA, mantém um resumo no dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se generează automat la prima deschidere a aplicației după ora programată. Dacă nu se poate conecta la AI, se păstrează un rezumat local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически генерируется при первом открытии приложения после запланированного времени. Если не удается подключиться к AI, сохраняются данные в устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky generuje prvý záznam po otvorení aplikácie v určenom čase. Ak sa nepodarí pripojiť k AI, zostane uložený prehľad."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomatično ustvari, ko prvič odprete aplikacijo po napovedanem času. Če se ne poveže z AI, shranjuje povzetek v napravi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereras automatiskt vid första öppningen efter schemalagd tid. Om anslutning till AI misslyckas, sparas en sammanfattning på enheten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டமிடப்பட்ட நேரத்தில் முதல் முறை பயன்பாட்டைத் திறக்கும்போது, தானாகவே உருவாக்கப்படும். AI உடன் இணைக்க முடியாவிட்டால், சாதனத்தில் உள்ள சுருக்கத்தை சேமித்து வைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమయానికి అనుగుణంగా, అప్లికేషన్‌ను మొదటిసారి తెరిచినప్పుడు, స్వయంచాలకంగా రిపోర్టు సృష్టించబడుతుంది. AI కనెక్ట్ కాకపోతే, పరికరంలో ఉన్న సమాచారాన్ని ఉపయోగిస్తాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะสร้างโดยอัตโนมัติเมื่อเปิดแอปครั้งแรกหลังจากเวลาที่กำหนด AI ไม่สามารถเชื่อมต่อได้ จะเก็บข้อมูลสรุปไว้ในเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlanan zamanda ilk açıldığında otomatik olarak oluşturulur. AI ile bağlantı kurulamazsa, cihazdaki özet kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично генерується при першому відкритті програми після запланованого часу. Якщо не вдасться підключитися до AI, збережеться зведення в пристрої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động tạo khi bạn mở ứng dụng lần đầu sau thời gian dự định. Nếu không thể kết nối với AI, vẫn lưu lại bản tóm tắt trong thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预定时间后首次打开应用时，会自动生成。如果无法连接AI，则保留本地摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預定時間後首次開啟應用程式時，自動生成。若無法連接AI，則保留裝置內摘要。"
          }
        }
      }
    },
