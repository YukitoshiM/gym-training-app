        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des valeurs de référence indicatives. Ne les enregistrez pas dans vos mesures ou graphiques."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સંદર્ભ મૂલ્યો ઓછા વિશ્વસનીય છે. તેને તમારા માપદંડા અથવા ગ્રાફમાં સાચવશો નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ערכים מומלצים, אך לא מדויקים. אין לשמור את הנתונים או הגרפים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये एक कम विश्वसनीय रेफरेंस वैल्यू है। इसे वास्तविक माप या ग्राफ में सेव न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo su samo okvirne vrijednosti. Nemojte ih čuvati u vlastitim zapisima ili grafikama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy támpont, amely nem feltétlenül pontos. Ne mentse az eredményeket vagy a grafikonokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah nilai referensi dengan tingkat kepercayaan rendah. Jangan simpan dalam catatan atau grafik pengukuran Anda."
