    "domain_catalog.293caccc9c79": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:235\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ذراعيك على الوسادة وقم بثنيهما وفردهما حتى لا يطفو مرفقاك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Col·loqueu els braços sobre el coixinet i doblegueu-los i estireu-los perquè els colzes no surin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístěte paže na podložku a provádějte flexi a extenzi loktů, aby se nezatížené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg armene på et polstring og bevæg dem op og ned, så albuerne ikke rører underlaget."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arme auf einer Polsterfläche positionieren und die Arme so bewegen, dass sie nicht abrutschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετήστε τα χέρια σας σε ένα μαξιλαράκι και κάντε κυκλικές κινήσεις με τους αγκώνες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend and straighten your elbows while placing your hands on pads to prevent them from sinking."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend and straighten your elbows while placing your hands on pads to prevent them from sinking."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend and straighten your elbows while placing your hands on pads to prevent them from sinking."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend and straighten your elbows while placing your hands on pads to prevent them from sinking."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca los codos sobre un cojín y muévete con los codos hacia arriba y abajo sin que se caigan."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca los codos sobre un cojín y muévete con los codos hacia arriba y abajo sin que se caigan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä käsivarsia padilla ja liikuttaa kyynärpäitä ylös ja alas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos bras sur un support et pliez-les et étirez-les pour maintenir la position."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez vos bras sur un support et pliez-les et étirez-les pour maintenir la position."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને પેડ પર મૂકો, અને ખભાને ઉપર-નીચે કરતી વખતે, હાથને સ્થિર રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להניח את הידיים על משענת ולשנות את כיוון המרפקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी बाहों को पैड पर रखें, और सुनिश्चित करें कि आपकी कलाई ऊपर न उठें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite ruke na oslonac i savijte i ispravljajte ruke kako biste izbjegli da se ruke ne prevrnute."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hajtsd a kettlebell-t, miközben a karod a padon van, és a könyököd ne legyen túl hajlított."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan lengan di bantalan, lalu tekuk dan luruskan siku agar tidak melayang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posizionare le braccia su un supporto e muovere i pesi con movimenti controllati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕をパッドに乗せ、肘が浮かないように曲げ伸ばしする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔을 패드에 대고, 팔꿈치가 뜨지 않도록 구부리고 펼칩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हातांना पॅडवर ठेवा, ज्यामुळे हात खाली न पडतील अशा प्रकारे वाकवा-सरळ करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan tangan di atas bantal, tekuk dan rentangkan siku agar tidak melayang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats je armen op de ondersteuning en beweeg ze heen en weer, waarbij je ervoor zorgt dat je ellebogen niet losraken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasser armene på en pute og beveg albuene opp og ned uten at de skal flyte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj ramiona na podkładce i wykonuj ruchy zginając i prostując łokcie, aby uniknąć ich wybijania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os cotovelos em um apoio e mova-os para cima e para baixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os cotovelos em um apoio e mova-os para cima e para baixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așezați brațele pe o suprafață și mișcați-le în sus și în jos, menținând coatele nemișcate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите руки на упор и выполняйте скручивания, чтобы локти не касались пола."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiestnite ruky na podložku a otáčajte lakťami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite blazinico za roke in jih gibajte navzgor in navoz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera armarna på ett stöd och böj och sträck ut armarna samtidigt som du håller dem stabila."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கைகளை பேட்டில் வைத்து, உங்கள் முழங்கைகள் அசையாமல் இருக்க, அவற்றை மடக்கி நீட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులను ప్యాడ్‌పై ఉంచి, మోచేతులు కదలకుండా వంచండి మరియు సాగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแผ่นรองที่แขน, งอและเหยียดแขนโดยให้ข้อศอกไม่สัมผัสพื้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolunu yastığa yerleştirerek, dirseklerinin hareket etmesini sağla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покладіть руки на підкладку та виконуйте рухи ліктями вгору-вниз, щоб вони не випадали."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt khuỷu tay lên miếng đệm và điều chỉnh để khuỷu tay không bị lỏng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手臂放在垫子上，保持肘部不弯曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將手臂放在墊上，並確保肘部不會彎曲或伸直。"
          }
        }
      }
    },
