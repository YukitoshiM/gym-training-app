          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your upper arm parallel to the floor and extend only your forearm backwards."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your upper arm parallel to the floor and extend only your forearm backwards."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your upper arm parallel to the floor and extend only your forearm backwards."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your upper arm parallel to the floor and extend only your forearm backwards."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca el brazo al suelo, manteniendo el codo como punto de referencia y estira el brazo hacia atrás."
