    "domain_catalog.aab8a869a7c4": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:132\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع الجزء العلوي من جسمك باستخدام مفاصل الورك كنقطة ارتكاز دون تقويس أسفل ظهرك كثيرًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aixequeu la part superior del cos utilitzant les articulacions del maluc com a punt de suport sense arquejar massa la part baixa de l'esquena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepřetěžujte záda, zvedněte se pomocí kyčlí jako opory."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå at bøje for meget i ryggen, og brug hofterne som et anker til at løfte kroppen op."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht zu stark die Wirbelsäule überdehnen, sondern den Oberkörper aus der Hüfte heraus heben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην λυγίζετε υπερβολικά την πλάτη σας, χρησιμοποιήστε τους γοφούς ως σημείο ισορροπίας για να σηκώσετε το σώμα σας προς τα πάνω."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, use your hip joints as leverage to lift your upper body."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, use your hip joints as leverage to lift your upper body."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, use your hip joints as leverage to lift your upper body."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, use your hip joints as leverage to lift your upper body."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar el cuerpo desde la cadera, sin arquear demasiado la espalda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Levantar el cuerpo desde la cadera, sin arquear demasiado la espalda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä venitä liikaa ja käytä lonkkaa tukipisteenä nostaaksesi ylävartalon."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Remonter doucement le haut du corps à partir des hanches, sans trop plier le dos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remonter doucement le haut du corps à partir des hanches, sans trop plier le dos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું પેટને વધારે સીધું ન કરો, અને હિપ્સને આધાર તરીકે ઉપયોગ કરીને તમારા શરીરને ઉપર લાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תגרום לגב להתכופף, והשתמש במפשעה כנקודת ייחוס כדי להרים את הגוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पीठ को ज्यादा न मोड़ें, और अपनी जांघों को सहारा के रूप में उपयोग करके अपने ऊपरी शरीर को उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne previše istezujte leđa, već se podignite uz pomoć zglobova u koljenima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne hajlítsa túl a gerincét, és használja a csípőjét mint alapként, hogy felálljon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak memiringkan punggung secara berlebihan, tetapi mengangkat tubuh menggunakan sendi pinggul sebagai titik tumpu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitare di afflettere eccessivamente la schiena, utilizzando le ginocchia come punto di appoggio per sollevare il busto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰を反らしすぎず、股関節を支点に上体を起こす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리를 과도하게 굽히지 않고, 엉덩이를 지점으로 삼아 상체를 들어 올린다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोट जास्त ताणून घेऊ नका, जांघच्या सांध्याला आधार म्हणून शरीर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak terlalu menekuk punggung, dan menggunakan sendi lutut sebagai tumpuan untuk mengangkat tubuh ke atas."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Til je bovenlichaam op vanuit je heupen, zonder je rug te overstrekken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå å bøye for mye i ryggen, og bruk hoftene som et støttepunkt for å løfte overkroppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wyginaj zbyt mocno pleców i podnieś ciało, wykorzystując biodra jako punkt oparcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite arquear demais a coluna e utilize os quadris como ponto de apoio para levantar o tronco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite arquear demais a coluna e utilize os quadris como ponto de apoio para levantar o tronco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitați să vă aplecați prea mult înapoi și ridicați-vă de sus, folosind șoldurile ca punct de sprijin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перенапрягать поясницу, а поднимать тело вверх, используя тазобедренные суставы в качестве опоры."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenechávajte sa preťažiť a zdvihnite si telo pomocou svojich bedier."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne prekomplicirajte z hrbtom, uporabite kolena kot točko in se rahlo dvignite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Höj kroppen uppåt, samtidigt som du håller ryggen rak och använder höfterna som stöd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதுகை அதிகமாக வளைக்காமல், இடுப்பை ஆதாரமாகக் கொண்டு உடலை உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నుపూసను నేలకు తాకకుండా, కాలును ఉపయోగించి శరీరాన్ని పైకి లేపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งอเอวให้น้อยที่สุด และใช้เข่าเป็นจุดพักเพื่อยกตัวขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli çok fazla bükmeyin, kalçalarınızı destek noktası olarak kullanarak üst vücudunuzu yukarı kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не згинати спину надмірно, а підніматися, використовуючи стегна як опору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cúi quá nhiều, sử dụng khớp háng làm điểm tựa để nâng người lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免过度弯腰，利用髋关节作为支撑点抬起上半身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要過度彎曲腰部，利用髖關節作為支點，抬起上半身。"
          }
        }
      }
    },
