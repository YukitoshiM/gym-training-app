    "domain_catalog.66d79da7b3e4": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:487\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ جسمك في خط مستقيم، واسحب مرفقيك إلى الخلف وادفع صدرك نحو المقاود."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint el cos en línia recta, estira els colzes cap enrere i porta el pit cap al manillar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte tělo v rovině a zatáhněte paže dozadu, abyste přiblížili hrudník k řízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold kroppen i en lige position og træk armene tilbage for at bringe håndtaget tættere på brystet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Körper gerade halten und die Arme nach hinten ziehen, um das Brustbein in Richtung Lenkrad zu bewegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε το σώμα σε ευθεία γραμμή και τραβήξτε τους αγκώνες προς τα πίσω, προσεγγίζοντας τη μέση με τον άξονα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your body in a straight line, and pull your elbows back to bring your chest closer to the handle."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your body in a straight line, and pull your elbows back to bring your chest closer to the handle."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your body in a straight line, and pull your elbows back to bring your chest closer to the handle."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your body in a straight line, and pull your elbows back to bring your chest closer to the handle."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el cuerpo en línea recta y tira los codos hacia atrás para acercar el pecho al manillar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el cuerpo en línea recta y tira los codos hacia atrás para acercar el pecho al manillar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä vartalo suorassa ja vedä kyynärpäät taaksepäin, jolloin rintakehä on lähellä ohjauspalikkaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez votre corps droit et tirez les coudes vers l'arrière pour rapprocher la poitrine du guidon."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez votre corps droit et tirez les coudes vers l'arrière pour rapprocher la poitrine du guidon."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરને સીધી રાખો અને હાથને પાછળની તરફ ખેંચીને છાતીને હેન્ડલની નજીક લાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשמור על גוף ישר ולמשוך את המרפקים לכיוון החזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर को सीधा रखें और कोहनी को पीछे की ओर खींचकर छाती को हैंडल की ओर लाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite tijelo u ravnoj liniji i podižite rame prema prednjoj strani, držeći ruku na upravljaču."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a testet egyenesen, és húzza a könyeket a hátra, hogy a mellkas a kormányhoz közel legyen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga tubuh tetap lurus, lalu menarik siku ke belakang dan mendekatkan dada ke handle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere il corpo in linea retta e avvicinare il petto al manubrio tirando i gomiti indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体を一直線に保ち、肘を後ろへ引いて胸をハンドルへ近づける。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸을 일직선으로 유지하고 팔꿈치를 뒤로 당겨 가슴을 핸들 쪽으로 가져옵니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर सरळ ठेवा आणि कोपर मागे ओढा, ज्यामुळे छाती हातात येईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan badan dalam garis lurus, tarik siku ke belakang dan mendekatkan tangan ke palang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je lichaam in een rechte lijn en trek je ellebogen naar achteren om je borst naar de hendel te brengen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold kroppen rett og trekk armene bakover for å bringe brystet nærmere håndtaket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj ciało w prostej linii i przyciągnij łokcie do tyłu, zbliżając klatkę piersiową do kierownicy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o corpo em linha reta e puxe os cotovelos para trás, aproximando o peito do guidão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o corpo em linha reta e puxe os cotovelos para trás, aproximando o peito do guidão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți-vă postura dreaptă și trageți brațele înapoi, apropiindu-vă de manivelă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите тело в прямой линии и тяните локти назад, приближая грудь к рулю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte telo v rovine a pritom zdvihnite paže k hrudi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite telo v ravni liniji in povlecite ramo nazaj, da približate roke k volanu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll kroppen i rak linje och dra armarna bakåt samtidigt som du för bröstet mot handtaget."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உடலை நேராக வைத்து, உங்கள் முழங்கால்களை பின்னோக்கி இழுத்து, உங்கள் மார்பை ஹேண்டில் அருகில் கொண்டு வரவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీరాన్ని నిటారుగా ఉంచి, మోచేతులను వెనక్కి లాగి ఛాతీని హ్యాండిల్‌కు దగ్గరగా తీసుకురండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาท่าทางให้เป็นแนวตรง และดึงข้อไปด้านหลัง พร้อมกับนำมือมาจับพวงมาลัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudunuzu düz tutun ve kollarınızı geriye çekerek omuzlarınızı direğe yaklaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте тіло прямо та відводьте лікті назад, щоб підвести груди до ручки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ cơ thể thẳng, kéo khuỷu tay về phía trước và đưa tay đến gần vị trí cầm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持身体成直线，并将手臂向后拉，使胸部靠近手柄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持身體成直線，將手臂向後拉，並將胸部靠近手柄。"
          }
        }
      }
    },
    "domain_catalog.670b1b812dc2": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:324\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا بأس إذا لم تتعجل. دعونا نلقي نظرة على السجلات ونقرر معًا ما يمكننا القيام به اليوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Està bé si no tens pressa. Mirem els registres i decidim junts què podem fer avui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemusíte se spěchat. Společně si stanovme realistické cíle na základě vašich pokroků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er okay at tage det roligt. Lad os sammen finde ud af, hvad du kan gøre i dag, baseret på dine fremskridt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist in Ordnung, langsam zu sein. Gemeinsam können wir anhand Ihrer Fortschritte festlegen, was Sie heute erreichen möchten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν χρειάζεται να βιάζεστε. Μαζί, θα δούμε τα αρχεία σας και θα αποφασίσουμε τι μπορείτε να κάνετε σήμερα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay to take things slowly. Let's work together to decide what you can achieve today, based on your progress."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay to take things slowly. Let's work together to decide what you can achieve today, based on your progress."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay to take things slowly. Let's work together to decide what you can achieve today, based on your progress."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "It's okay to take things slowly. Let's work together to decide what you can achieve today, based on your progress."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay necesidad de apresurarse. Revisemos tus registros y decidamos juntos qué puedes lograr hoy."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay necesidad de apresurarse. Revisemos tus registros y decidamos juntos qué puedes lograr hoy."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tarvitse kiirehtiä. Tarkastele aiempaa kehitystäsi ja päädytään yhdessä, mitä tänään voidaan tehdä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est pas nécessaire d'être pressé. En regardant vos progrès, décidons ensemble ce que vous pouvez faire aujourd'hui."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est pas nécessaire d'être pressé. En regardant vos progrès, décidons ensemble ce que vous pouvez faire aujourd'hui."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તેમાં કોઈ તાકીદ નથી. રેકોર્ડ જોતા, આપણે સાથે મળીને નક્કી કરી શકીએ કે આજે શું કરવું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין צורך למהר. בואו נגדיר יחד מה אפשר לעשות היום, תוך התבוננות בנתונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जल्दी करने की ज़रूरत नहीं है। रिकॉर्ड देखकर, हम मिलकर यह तय करेंगे कि आज क्या करना है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema potrebe da brza. Razmislite zajedno o tome što možete danas postići gledajući svoje postignute rezultate."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem kell sietni. Nézzük a rekordokat, és egyetemben döntsünk el, mit tudunk ma megtenni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu terburu-buru. Mari kita tentukan bersama apa yang bisa Anda lakukan hari ini, sambil melihat catatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è bisogno di affrettarsi. Analizzando i progressi, decidiamo insieme cosa è possibile fare oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急がなくて大丈夫です。記録を見ながら、今日できることを一緒に決めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조급해할 필요 없습니다. 기록을 보면서, 오늘 할 수 있는 것을 함께 결정합시다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "घाई करण्याची आवश्यकता नाही. नोंदी पाहून, आज काय करता येईल हे आपण ठरवूया."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak perlu tergesa-gesa. Mari kita bersama-sama menentukan apa yang boleh dilakukan hari ini berdasarkan rekod."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is prima om niet te haasten. Kijk naar je voortgang en beslis samen wat je vandaag kunt doen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er greit å ta det rolig. La oss finne ut hva du kan gjøre i dag, ved hjelp av dine tidligere resultater."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie musisz się spieszyć. Razem przeanalizujmy swoje postępy i ustalmy realistyczne cele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há necessidade de pressa. Vamos definir juntos o que você pode fazer hoje, observando seus registros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há necessidade de pressa. Vamos definir juntos o que você pode fazer hoje, observando seus registros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este nevoie să te grăbești. Împreună, putem stabili ce poți face astăzi, analizând progresul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не нужно спешить. Давайте вместе определим, что вы можете сделать сегодня, основываясь на ваших результатах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemusíte sa spýchať. Spoločne si pozrieme vaše pokroky a dohodneme sa na tom, čo môžete dnes urobiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pospešujte. Skozi spremljanje napredka, skupaj določimo, kaj lahko dosežete danes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är okej att ta det lugnt. Tillsammans kan vi bestämma vad du kan göra idag, baserat på dina resultat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவசரப்பட வேண்டிய அவசியமில்லை. உங்கள் முன்னேற்றத்தை வைத்து, இன்று என்ன செய்ய வேண்டும் என்று முடிவு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "త్వరపడాల్సిన అవసరం లేదు. రికార్డులను చూస్తూ, మనం ఏమి చేయగలమో కలిసి నిర్ణయించుకుందాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องเร่งรีบ เราจะมาวางแผนร่วมกันว่าวันนี้คุณสามารถทำอะไรได้บ้าง โดยดูจากบันทึกของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acele etmenize gerek yok. Kayıtları gözden geçirerek, bugün neler yapabileceğinizi birlikte belirleyelim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не поспішайте. Разом подивіться на записи та визначте, що ви можете зробити сьогодні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần vội, hãy cùng nhau xác định những gì bạn có thể làm mỗi ngày dựa trên nhật ký của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没关系，我们可以一起根据记录来决定今天能做什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "没关系，我们可以一起在记录的基础上决定今天能做的事情。"
          }
        }
      }
    },
