    "health_meals_body_ai.b869cf466465": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:205\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تمكنت من تأكيد التوازن بين التعافي والتدريب الذي تمكنت من مواصلته."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaig poder confirmar l'equilibri entre la recuperació i l'entrenament que vaig poder continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky tomu, že jsme pokračovali v tréninku, jsme mohli sledovat rovnováhu mezi tréninkem a regenerací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kunne fortsætte træningen, og jeg fik styr på balancen mellem restitution og træning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die fortgesetzte Übung konnten wir den Ausgleich zwischen Training und Erholung feststellen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορήσαμε να αξιολογήσουμε την ισορροπία μεταξύ της συνεχούς προπόνησης και της αποκατάστασης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We were able to confirm the balance between continued training and recovery."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We were able to confirm the balance between continued training and recovery."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We were able to confirm the balance between continued training and recovery."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We were able to confirm the balance between continued training and recovery."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos confirmar el equilibrio entre el entrenamiento que pudimos mantener y la recuperación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos confirmar el equilibrio entre el entrenamiento que pudimos mantener y la recuperación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytimme jatkuvaa harjoittelua ja tarkastimme palautumisen tasapainon."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai pu vérifier l'équilibre entre l'entraînement que j'ai réussi à maintenir et la récupération."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai pu vérifier l'équilibre entre l'entraînement que j'ai réussi à maintenir et la récupération."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જે ટ્રેનિંગને તમે ચાલુ રાખી શકો, તેના આધારે, તમે પુનઃપ્રાપ્તિ અને સંતુલનનું મૂલ્યાંકન કરી શક્યા."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן היה להתמקד באימונים שהצליחו, ובדיקת האיזון עם ההתאוששות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस व्यायाम को जारी रखा, उसके आधार पर, रिकवरी और संतुलन का आकलन किया जा सका।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možemo provjeriti ravnotežu između treninga i oporavka, uz fokus na treniranje koje ste uspješno izdržali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzés sikerességének és a regeneráció közötti egyensúlyt figyelembe véve értékelhettem az edzéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan berfokus pada latihan yang berhasil dilakukan, kita dapat memastikan keseimbangan antara pemulihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato possibile verificare l'equilibrio tra allenamento e recupero, basandosi sull'allenamento che è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "継続できたトレーニングを軸に、回復とのバランスを確認できました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지속 가능한 운동을 중심으로, 회복과의 균형을 확인했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जे प्रशिक्षण नियमितपणे करता आले, त्याचे परिणाम आणि शरीराची पुनर्प्राप्ती (recovery) यांचा समतोल पाहता आला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan memberi tumpuan kepada latihan yang boleh diteruskan, kita dapat memastikan keseimbangan antara pemulihan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Door de trainingen die voortzetten, kon ik het evenwicht tussen herstel en prestatie inzien."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne fokusere på treningen som vi klarte å opprettholde, og vurdere balansen mellom trening og restitusjon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można było sprawdzić równowagę między treningiem i regeneracją, koncentrując się na tych, które udało się kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi possível verificar o equilíbrio entre o treino contínuo e a recuperação, com base nos treinos que foram realizados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi possível verificar o equilíbrio entre o treino contínuo e a recuperação, com base nos treinos que foram realizados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am putut evalua echilibrul dintre antrenament și recuperare, concentrându-ne pe activitățile pe care le puteam continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основываясь на тренировках, которые удалось продолжить, мы смогли оценить баланс между нагрузкой и восстановлением."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dôležité bolo pokračovať v tréningu a zároveň sledovať, ako sa telo zotavuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite trening, ki vam je uspelo ohraniti, ter preverite ravnovanje med treningom in regeneracijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att fokusera på träningen som du klarade av, kunde jag kontrollera balansen mellan återhämtning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்ந்து பயிற்சி செய்ததை அடிப்படையாக வைத்து, உடலின் மீதான தாக்கத்தை மதிப்பிட முடிந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిరంతరంగా కొనసాగించగలిగిన వ్యాయామాలను దృష్టిలో ఉంచుకుని, కోలుకునే ప్రక్రియతో సమతుల్యతను అంచనా వేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถทำซ้ำการออกกำลังกายที่ทำได้ และตรวจสอบความสมดุลระหว่างการฟื้นตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre boyunca uygulanan egzersizleri temel alarak, dinlenmeyle dengenin sağlandığını gözlemledim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуючи тренування, які вдалося продовжити, ми змогли перевірити баланс між відновленням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựa trên các bài tập đã duy trì, chúng ta có thể kiểm tra sự cân bằng giữa tập luyện và phục hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过持续进行的训练，我们确认了运动与恢复之间的平衡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過持續的運動，我們確認了恢復與平衡。"
          }
        }
      }
    },
