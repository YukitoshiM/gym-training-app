    "health_meals_body_ai.e9872cc8c9d1": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:1087\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن حفظ مجموعات الصور. يمكنك إعادة التحليل من تفاصيل المجموعة بعد الاتصال."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es poden desar conjunts de fotos. Podeu tornar a analitzar els detalls establerts després de connectar-vos."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor fotografií můžete uložit. Po připojení můžete analýzu znovu spustit z podrobností souboru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan gemme et sæt af billeder. Du kan genanalysere fra detaljerne efter tilslutning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamte Foto-Sets können gespeichert werden. Nach der Verbindung können Sie die Analyse erneut durchführen, indem Sie Details des Sets auswählen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να αποθηκεύσετε ένα σύνολο φωτογραφιών. Μετά τη σύνδεση, μπορείτε να αναλύσετε ξανά τις λεπτομέρειες του συνόλου."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo sets can be saved. You can re-analyze from the set details after connecting."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo sets can be saved. You can re-analyze from the set details after connecting."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo sets can be saved. You can re-analyze from the set details after connecting."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo sets can be saved. You can re-analyze from the set details after connecting."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes guardar un conjunto de fotos. Después de conectarte, puedes volver a analizarlo desde los detalles del conjunto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes guardar un conjunto de fotos. Después de conectarte, puedes volver a analizarlo desde los detalles del conjunto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat voidaan tallentaa. Voit analysoida ne uudelleen \"Yksityiskohdat\"-osiosta yhdistämisen jälkeen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ensembles de photos peuvent être sauvegardés. Après la connexion, vous pouvez effectuer une nouvelle analyse à partir des détails de l'ensemble."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ensembles de photos peuvent être sauvegardés. Après la connexion, vous pouvez effectuer une nouvelle analyse à partir des détails de l'ensemble."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટાનો સમૂહ સાચવી શકાય છે. કનેક્ટ કર્યા પછી, સેટ વિગતોમાંથી ફરીથી વિશ્લેષણ કરી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשמור סדר של תמונות. לאחר חיבור, ניתן לבצע ניתוח חוזר מהפרטים של הסדרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप फोटो सेट को सहेज सकते हैं। कनेक्शन के बाद, सेट विवरण से फिर से विश्लेषण किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije možete spremiti. Nakon povezivanja, možete ponovno analizirati iz detalja seta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képeket menteni lehet. A csatlakozás után a részletekben újraelemzhetjük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Set foto dapat disimpan. Setelah terhubung, Anda dapat menganalisis ulang dari detail set."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie di foto possono essere salvate. Dopo la connessione, puoi rianalizzarle dal dettaglio del set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真セットは保存できます。接続後にセット詳細から再分析できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 세트는 저장할 수 있습니다. 연결 후 세부 정보에서 다시 분석할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो सेट जतन करता येतात. कनेक्ट झाल्यावर, सेट तपशीलातून पुन्हा विश्लेषण करता येते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Set gambar boleh disimpan. Anda boleh menganalisis semula daripada butiran set selepas sambungan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt een set foto's opslaan. Na de verbinding kun je de analyse opnieuw uitvoeren via de details van de set."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lagre bildesett. Du kan analysere på nytt fra detaljene etter at du har koblet deg til."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zestaw zdjęć można zapisać. Po połączeniu, szczegóły zestawu można przeanalizować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos podem ser salvas. Após a conexão, você pode reanalisá-las nos detalhes do conjunto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos podem ser salvas. Após a conexão, você pode reanalisá-las nos detalhes do conjunto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seturile de fotografii pot fi salvate. După conectare, poți reanaliza din detaliile setului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наборы фотографий можно сохранить. После подключения, вы можете повторно проанализировать их в разделе \"Детали набора\"."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupinu fotografií môžete uložiť. Po pripojení môžete z detailov skupiny znovu analyzovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografije lahko shranite. Po povezavi lahko analizirate z gumbom \"Podrobnosti\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan spara bildset. Du kan analysera om igen från detaljerna efter anslutning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படத் தொகுப்புகளைச் சேமிக்கலாம். இணைக்கப்பட்ட பிறகு, தொகுப்பு விவரங்களிலிருந்து மறுபகுப்பாய்வு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో సెట్‌ను సేవ్ చేయవచ్చు. కనెక్ట్ అయిన తర్వాత, సెట్ వివరాల నుండి తిరిగి విశ్లేషించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถบันทึกชุดรูปภาพได้ หลังจากเชื่อมต่อ สามารถวิเคราะห์ซ้ำจากรายละเอียดชุดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf setlerini kaydedebilirsiniz. Bağlandıktan sonra, detaylardan tekrar analiz edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна зберегти набір фотографій. Після підключення можна повторно проаналізувати з деталей набору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể lưu bộ ảnh. Sau khi kết nối, bạn có thể phân tích lại từ chi tiết bộ ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以保存照片集。 连接后，可以在“设置”中进行重新分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以保存照片集。 连接后，可以在“设置”中进行重新分析。"
          }
        }
      }
    },
