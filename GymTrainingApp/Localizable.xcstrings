    "health_meals_body_ai.23786a963f38": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:348\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تشعر بالإعياء أو الألم، فأعط الأولوية لمشاعرك على الأرقام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no us trobeu bé o teniu dolor, prioritzeu els vostres sentiments sobre els números."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud máte problémy se zdravím nebo bolest, upřednostněte své vlastní pocity před číslami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du føler dig utilpas eller har smerter, skal du prioritere din egen fornemmelse frem for tallene."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie Beschwerden oder Schmerzen haben, sollten Sie Ihre eigenen Empfindungen gegenüber den Zahlen priorisieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν αισθάνεστε άσχημα ή έχετε πόνο, δώστε προτεραιότητα στην προσωπική σας αντίληψη παρά στις τιμές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are feeling unwell or experiencing pain, please prioritize your own feelings over the numbers."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are feeling unwell or experiencing pain, please prioritize your own feelings over the numbers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are feeling unwell or experiencing pain, please prioritize your own feelings over the numbers."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are feeling unwell or experiencing pain, please prioritize your own feelings over the numbers."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tiene alguna molestia o dolor, priorice su propio criterio sobre los valores."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tiene alguna molestia o dolor, priorice su propio criterio sobre los valores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sinulla on huono olo tai kipuja, priorisoi oma tuntemuksesi lukuja enemmän."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ressentez un inconfort ou une douleur, privilégiez votre propre ressenti plutôt que les chiffres."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ressentez un inconfort ou une douleur, privilégiez votre propre ressenti plutôt que les chiffres."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમને કોઈ સ્વાસ્થ્ય સમસ્યા અથવા દુખાવો હોય, તો કૃપા કરીને સંખ્યાને બદલે તમારી પોતાની લાગણીઓને પ્રાધાન્ય આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם יש מצב לא תקין או כאבים, עדיף לתת עדיפות לתחושה האישית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको कोई स्वास्थ्य समस्या या दर्द है, तो कृपया संख्या के बजाय अपनी व्यक्तिगत भावना को प्राथमिकता दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se osjećate loše ili imate bolova, prioritizirajte vlastito iskustvo umjesto brojeva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha érzik, hogy nem jól vannak vagy fájdalmat éreznek, akkor inkább a saját érzéseiket vegyük figyelembe, mint az adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda merasa tidak enak badan atau sakit, prioritaskan perasaan Anda sendiri daripada angka tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai problemi di salute o dolori, dai priorità alla tua percezione piuttosto che ai numeri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体調や痛みがある場合は数値より本人の感覚を優先してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 상태나 통증이 있을 경우, 수치를 우선시하지 말고 본인의 감각을 따르세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर तुम्हाला शारीरिक समस्या किंवा वेदना जाणवत असतील, तर कृपया आकडेवारीपेक्षा आपल्या भावनांना अधिक महत्त्व द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda berasa tidak sihat atau ada sakit, prioritaskan perasaan anda sendiri daripada nombor."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u zich niet goed voelt of pijn hebt, geef dan de voorkeur aan uw eigen gevoel, boven de numerieke waarden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du føler deg dårlig eller har smerter, prioriter dine egne opplevelser fremfor tallene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli odczuwasz dyskomfort lub ból, priorytetowo traktuj swoje odczucia, a nie wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estiver a sentir algum desconforto ou dor, dê prioridade à sua própria sensação em vez dos números."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estiver a sentir algum desconforto ou dor, dê prioridade à sua própria sensação em vez dos números."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă aveți probleme de sănătate sau dureri, prioritizați senzațiile personale în locul valorilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас плохое самочувствие или есть боль, прислушивайтесь к своим ощущениям, а не к цифрам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak máte problémy so zdravím alebo bolesť, uprednostnite svoje vlastné vnímanie pred číslami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če imate težave s zdravjem ali bolečino, se posvetujte z osebnim izkušanjem, ne glede na številke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du känner dig dålig eller har ont, prioritera dina egna känslor framför siffrorna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடல்நிலை அல்லது வலி இருந்தால், இந்த எண்களை விட உங்கள் சொந்த உணர்வுக்கு முன்னுரிமை கொடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు ఆరోగ్య సమస్యలు లేదా నొప్పి ఉంటే, సంఖ్యలను కంటే మీ వ్యక్తిగత అనుభూతికి ప్రాధాన్యత ఇవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมีอาการผิดปกติหรือความเจ็บปวด โปรดให้ความสำคัญกับความรู้สึกของตนเองมากกว่าตัวเลข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğer sağlık durumunuzda veya ağrıda bir değişiklik varsa, lütfen sayısal değerlerden ziyade kendi hislerinize öncelik verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у вас є проблеми зі здоров'ям або біль, звертайте увагу на свої відчуття, а не лише на цифри."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn cảm thấy không khỏe hoặc đau, hãy ưu tiên cảm nhận của bản thân hơn là số liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果身体不适或有疼痛，请优先考虑自己的感觉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果身体不适或有疼痛，请优先考虑个人的感觉。"
          }
        }
      }
    },
