            "state": "translated",
            "value": "Log a few things now and review everything later."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra algunas cosas ahora y revisa todo más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra algunas cosas ahora y revisa todo más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa muutama asia nyt ja tarkastele kaikkea myöhemmin."
