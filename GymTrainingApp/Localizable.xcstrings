    "domain_catalog.d94b736f99ef": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:97\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بثني الوركين للحفاظ على ثبات الجزء العلوي من جسمك واسحب الشريط نحو الضفيرة الشمسية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Doble els malucs per mantenir la part superior del cos estable i estira la barra cap al plexe solar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohněte kyčle a upevněte horní část těla, poté táhněte činku směrem k pasu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj i hofterne og fastgør overkroppen, og træk stangen mod maven."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beuge deine Hüften und stabilisiere deinen Oberkörper, während du die Stange zur Mitte deines Bauches ziehst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λυγίστε τη μέση σας και σταθεροποιήστε το άνω μέρος του σώματός σας, τραβώντας το ράβδο προς την περιοχή της κοιλιάς."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your hips to stabilize your upper body and pull the bar towards your abdomen."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your hips to stabilize your upper body and pull the bar towards your abdomen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your hips to stabilize your upper body and pull the bar towards your abdomen."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your hips to stabilize your upper body and pull the bar towards your abdomen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Doblar las caderas para estabilizar el torso y tirar de la barra hacia el abdomen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Doblar las caderas para estabilizar el torso y tirar de la barra hacia el abdomen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taiva lonkat ja tue ylävartaloa, vedä tanko vatsaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliez vos hanches pour stabiliser votre corps et tirez la barre vers le bas."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliez vos hanches pour stabiliser votre corps et tirez la barre vers le bas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પગની સાંધાને વાળીને શરીરને સ્થિર કરો અને બારને પેટ તરફ ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתכופף את מפרק הישבן ולהגדיר את גוף העליון, תוך שאיבת המתח לכיוון הבטן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कूल्हों को मोड़े और अपने ऊपरी शरीर को स्थिर रखें, फिर बार को अपनी पेट की ओर खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savijte kukove i stabilizirajte gornji dio tijela, povlačeći uteg prema trbuhu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hajtsd ki a derékot, és stabilízd a felsőtestet, majd húzd lefelé a bárral."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melengkungkan pinggul untuk menstabilkan tubuh bagian atas, lalu menarik bar ke arah perut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piega le anche per stabilizzare il tronco e tira la barra verso l'addome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "股関節を曲げて上体を固定し、バーをみぞおち方向へ引く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "골반을 구부려 상체를 고정하고, 바를 배 쪽으로 잡아당깁니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कूल्हे वाकवून शरीराचा वरचा भाग स्थिर ठेवा आणि बार पोटाच्या दिशेने ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menekukkan lutut untuk menahan bahagian atas badan, lalu menarik bar ke arah perut."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig je heupen om je bovenlichaam stabiel te houden en trek het gewicht naar je navel toe."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy hoftene og stabiliser overkroppen, og trekk stangen mot magen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgiń biodra, aby ustabilizować tułów, a następnie pociągnij drążek w kierunku brzucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre o quadril e mantenha o tronco firme, puxando a barra em direção ao abdômen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre o quadril e mantenha o tronco firme, puxando a barra em direção ao abdômen."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îndoaie șoldurile pentru a menține echilibrul și trage bara spre abdomen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согните тазобедренный сустав и зафиксируйте верхнюю часть тела, затем тяните штангу к животу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyrovnáme kĺb a upevňujeme ho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasukajte kolenske skle in stabilizirajte telo, nato pa potisnite ute proti trebuhu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj höfterna och fixera överkroppen, dra sedan stången mot magen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடை எலும்புகளை வளைத்து, உடலை நிலையாக வைத்து, பார்களை வயிற்றுப் பகுதிக்கு இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కటి కీళ్లను వంచి, శరీరాన్ని పైకి ఉంచండి, బార్‌ను కడుపు వైపుకు లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งอสะโพกและรักษาท่าทางลำตัว จากนั้นดึงบาร์ไปในทิศทางท้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalçalarınızı bükün ve üst vücudunuzu sabitleyin, ardından bara karın bölgesine doğru çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стисніть ноги та зафіксуйте верхню частину тіла, тягнучи штангу до живота."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gập khớp háng để giữ thăng bằng cơ thể, sau đó kéo thanh tạ về phía bụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弯曲髋关节，固定上半身，并将杠杆向腹部方向拉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彎曲髖關節，固定上身，並將槓桿拉向腹部"
          }
        }
      }
    },
