      "comment": "GymTrainingApp/Features/Onboarding/InitialSetupView.swift:553\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تحرك نحو جسمك المثالي دون تردد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mou-te cap al teu cos ideal sense dubtar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postupujte k ideálnímu tělu, bez váhání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom videre mod din ideelle krop, uden at tøve."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie selbstbewusst auf den Weg zu Ihrem idealen Körper."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προχωρήστε με αυτοπεποίθηση προς τον ιδανικό σας σωματότυπο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Move confidently towards your ideal body."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Move confidently towards your ideal body."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move confidently towards your ideal body."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Move confidently towards your ideal body."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance sin dudar hacia tu cuerpo ideal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance sin dudar hacia tu cuerpo ideal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edisty kohti ihannetilaa vaivattomasti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancez sans hésitation vers votre corps idéal."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancez sans hésitation vers votre corps idéal."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આદર્શ શરીર તરફ, નિશ્ચિતપણે આગળ વધો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צעד בביטחון לעבר הגוף הרצוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आदर्श शरीर की ओर, बिना किसी हिचकिचाहट के आगे बढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripremite se za idealan tijelo, bez oklijeva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kényelmesen haladjunk a tökéletes test felé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan menuju tubuh ideal Anda tanpa ragu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungi il tuo ideale, senza esitazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理想の身体へ、迷わず進む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 몸매를 향해, 망설이지 않고 나아가세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या ध्येयाकडे, सहजपणे वाटचाल करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergerak ke arah badan ideal, tanpa ragu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga onbeperkt vooruit naar je ideale lichaam."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå fremover mot din ideelle kropp, uten å nøle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zwątpień zmierzaj w stronę swojego idealnego ciała."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance sem hesitação em direção ao seu corpo ideal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avance sem hesitação em direção ao seu corpo ideal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mergeți cu încredere spre corpul ideal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко достигайте своей идеальной формы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Postupujte k svojmu ideálnemu telu bez váhaní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko dosežete idealno stanje telesa brez oklevanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå framåt mot din idealiska kropp, utan tvekan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இலக்கை நோக்கி, தயக்கமின்றி முன்னேறுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఆదర్శ శరీరానికి, సందేహాలు లేకుండా ముందుకు సాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุ่งมั่นไปสู่รูปร่างที่ต้องการ โดยไม่มีความลังเล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İdeal vücuda ulaşmak için, emin adımlarla ilerle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не бійтеся, рухайтесь до свого ідеального тіла!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến lên một cách tự tin để đạt được cơ thể lý tưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻松迈向理想身材。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "順利邁向理想的身材。"
          }
        }
      }
