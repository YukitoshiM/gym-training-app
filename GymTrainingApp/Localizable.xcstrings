    "domain_catalog.79f861a463c1": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:28\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إدارة التعب وتحسين الأحداث الكبرى من خلال الوزن والتكرار وRPE والتقنية"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona la fatiga i millora els esdeveniments importants mitjançant pes, repeticions, RPE i tècnica"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě váhy, počtu opakování, RPE a techniky spravujte únavu a zaměřte se na hlavní cviky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug vægt, antal gentagelser, RPE og teknik til at styre din træthed og fokusere på de vigtigste øvelser."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie die Ermüdung und konzentrieren Sie sich auf die wichtigsten Übungen anhand von Gewicht, Anzahl und RPE sowie Technik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιώντας βάρος, επαναλήψεις, RPE και τεχνική, διαχειριστείτε την κόπωση και εστιάστε στην ενίσχυση των βασικών ασκήσεων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage fatigue by comparing weight, repetitions, RPE, and technique to maximize key exercises."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage fatigue by comparing weight, repetitions, RPE, and technique to maximize key exercises."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage fatigue by comparing weight, repetitions, RPE, and technique to maximize key exercises."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage fatigue by comparing weight, repetitions, RPE, and technique to maximize key exercises."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona la fatiga y enfócate en desarrollar las principales disciplinas basándote en peso, repeticiones, RPE y técnica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona la fatiga y enfócate en desarrollar las principales disciplinas basándote en peso, repeticiones, RPE y técnica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä painoa, toistoja, RPE:tä ja tekniikkaa hallitaksesi väsymystä ja keskittyäksesi tärkeimpiin liikkeisiin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérer la fatigue en fonction du poids, du nombre de répétitions et de l'intensité, et se concentrer sur les exercices principaux."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérer la fatigue en fonction du poids, du nombre de répétitions et de l'intensité, et se concentrer sur les exercices principaux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન, પુનરાવર્તનો, RPE અને ટેકનિકના આધારે, થાકને નિયંત્રિત કરીને મુખ્ય કસરતોમાં સુધારો કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניהול עייפות על ידי השוואה בין משקל, מספר חזרות, RPE וטכניקה, תוך התמקדות בתרגילים העיקריים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, संख्या, RPE और तकनीक के आधार पर, थकान का प्रबंधन करें और मुख्य गतिविधियों को विकसित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebi informacije o težini, broju ponavljanja, subjektivnoj ocjeni napor i tehnici za upravljanje umorom i usmjeri se na ključne vježbe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A súly, a számok, az RPE és a technika alapján, a fáradtságot ellenőrizd, és a fő mozdulatokat fejleszd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengelola kelelahan dengan membandingkan berat, jumlah, RPE, dan teknik untuk memperpanjang latihan utama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci l'affaticamento e concentra i tuoi allenamenti principali confrontando peso, ripetizioni, RPE e tecnica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重量・回数・RPE・技術から、疲労を管理して主要種目を伸ばす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무게, 반복 횟수, RPE 및 기술을 기반으로 피로를 관리하고 주요 운동을 강화합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, संख्या आणि RPE तसेच तंत्राच्या आधारावर, थकवा व्यवस्थापित करा आणि मुख्य व्यायाम वाढवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan membandingkan berat, jumlah, RPE, dan kemahiran, menguruskan keletihan dan meningkatkan latihan utama"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer vermoeidheid door gewicht, aantal herhalingen, RPE en techniek om de belangrijkste oefeningen te verbeteren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk vekt, antall repetisjoner, RPE og teknikk for å administrere tretthet og fokusere på de viktigste øvelsene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj zmęczeniem i skup się na głównych ćwiczeniach, porównując wagę, liczbę powtórzeń, RPE i technikę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie a fadiga e maximize os principais exercícios com base em peso, repetições, RPE e técnica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie a fadiga e maximize os principais exercícios com base em peso, repetições, RPE e técnica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionează oboseala și concentrează-te pe exercițiile principale, comparând greutatea, numărul de repetări, RPE și tehnica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определите уровень усталости на основе веса, количества повторений, RPE и техники, чтобы эффективно тренировать основные упражнения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe váhy, počtu opakovaní, RPE a techniky spravujte únavu a maximalizujte výkon."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi teže, števila ponovitev, RPE in tehnike upravljajte utrujenost in poudarite ključne vaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera trötthet genom att jämföra vikt, antal repetitioner, RPE och teknik för att fokusera på de viktigaste övningarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடை, எண்ணிக்கை, RPE மற்றும் நுட்பத்தை வைத்து, சோர்வை நிர்வகித்து முக்கிய பயிற்சிகளை மேம்படுத்தவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు, సంఖ్య, RPE మరియు సాంకేతికత ఆధారంగా, అలసటను నిర్వహించి, ముఖ్యమైన వ్యాయామాలను పెంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการความเหนื่อยโดยใช้ข้อมูล น้ำหนัก จำนวนครั้ง ระดับความรู้สึก และเทคนิค เพื่อพัฒนาท่าทางหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık, tekrar sayısı, RPE ve teknik bilgilerinden faydalanarak, yorgunluğu yönet ve temel egzersizleri geliştir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте дані про вагу, кількість повторень, RPE та техніку для управління втомою та розвитку основних видів діяльності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý sự mệt mỏi và tăng cường các bài tập chính dựa trên trọng lượng, số lần, mức độ khó và kỹ thuật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过比较重量、次数和RPE，管理疲劳并提高主要运动项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過比較重量、次數和RPE，來管理疲勞並擴大主要運動項目"
          }
        }
      }
    },
