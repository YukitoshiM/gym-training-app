    "health_meals_body_ai.3b0096995c03": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:449\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى مراقبة صحتك والمضي قدما كما هو مخطط له."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, vigileu la vostra salut i procediu com està previst."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte svůj zdravotní stav a postupujte podle plánu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg planen, mens du holder øje med dit helbred."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie Ihren Fortschritt im Auge und halten Sie sich an Ihren Plan."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προχωρήστε σύμφωνα με το πρόγραμμά σας, παρακολουθώντας την κατάστασή σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with your plan while monitoring your health."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with your plan while monitoring your health."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with your plan while monitoring your health."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with your plan while monitoring your health."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga avanzando según lo planeado, teniendo en cuenta su estado físico."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga avanzando según lo planeado, teniendo en cuenta su estado físico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä suunnitelmasta kiinni, kun tarkkailet vointiasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre programme en fonction de votre état de santé."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre programme en fonction de votre état de santé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા સ્વાસ્થ્યને ધ્યાનમાં રાખીને, યોજના મુજબ આગળ વધો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסו להתקדם בהתאם ללוח הזמנים, תוך התחשבות במצב הבריאותי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने स्वास्थ्य की स्थिति को ध्यान में रखते हुए, योजना के अनुसार आगे बढ़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratite svoj plan i budite aktivni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsuk be a terveket, figyelve a testérzetünket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan sesuai rencana sambil memantau kondisi kesehatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui il programma tenendo conto del tuo stato di salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体調を見ながら予定どおり進めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 상태를 고려하여 계획대로 진행하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपल्या आरोग्यानुसार योजनेनुसार पुढे जा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan anda terus maju mengikut jadual yang ditetapkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg uw schema en blijf op koers."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg planen, samtidig som du vurderer hvordan du har det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postępuj zgodnie z planem, obserwując swój stan zdrowia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o seu progresso de acordo com o planeado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o seu progresso de acordo com o planeado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuați progresul conform planului, ținând cont de starea dumneavoastră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старайтесь следовать плану, несмотря на ваше состояние."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte svoje zdravie a postupujte podľa plánu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite aktivni in sledite načrtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ planen och se till att det går bra för dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உடல்நிலைக்கு ஏற்ப திட்டங்களைச் செயல்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఆరోగ్యాన్ని దృష్టిలో ఉంచుకుని, ప్రణాళిక ప్రకారం ముందుకు సాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดดำเนินการตามแผนตามสภาพร่างกาย"
          }
        },
        "tr": {
          "stringUnit": {
