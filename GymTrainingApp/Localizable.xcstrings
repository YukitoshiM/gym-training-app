          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Portionen von Hauptnahrung, Hauptgericht und Gemüse kombinieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδυάστε μικρές ποσότητες από κύρια τροφή, κύριο γεύμα και λαχανικά."
