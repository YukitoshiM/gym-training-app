        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca el brazo al suelo, manteniendo el codo como punto de referencia y estira el brazo hacia atrás."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie kyynärpäät lattiaa vasten ja pidä vain kyynärpäistä eteenpäin."
