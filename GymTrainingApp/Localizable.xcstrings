    "core_ui.ca5b5635259a": {
      "comment": "GymTrainingApp/Advertising/AdvertisingSettingsViews.swift:66",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لتقديم الإعلانات، تتلقى Google عنوان IP ومعلومات أساسية عن الجهاز والتطبيق وبيانات تشخيص SDK وأدائه وبيانات ظهور الإعلانات والتفاعل معها. قد يُستنتج موقعك التقريبي من عنوان IP. لا تُضمّن في طلبات الإعلانات بيانات الوزن أو نبض القلب أو النوم أو الوجبات أو الصور أو التمارين أو الأهداف أو GPS أو مواقع النوادي المسجلة في BodyMode."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per publicar anuncis, Google rep la teva adreça IP, informació bàsica del dispositiu i de l'app, dades de diagnòstic i rendiment de l'SDK, i dades d'impressions i interaccions amb anuncis. La ubicació aproximada es pot inferir de l'adreça IP. El pes, la freqüència cardíaca, el son, els àpats, les fotos, els entrenaments, els objectius, les dades GPS i les ubicacions de gimnasos registrats a BodyMode no s'inclouen a les sol·licituds d'anuncis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Za účelem zobrazování reklam obdrží Google vaši IP adresu, základní údaje o zařízení a aplikaci, diagnostická a výkonnostní data SDK a údaje o zobrazeních a interakcích s reklamami. Z IP adresy může být odvozena přibližná poloha. Hmotnost, tepová frekvence, spánek, jídla, fotografie, tréninky, cíle, GPS data a polohy posiloven zaznamenané v BodyMode nejsou součástí reklamních požadavků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved annoncelevering modtager Google din IP-adresse, grundlæggende oplysninger om enhed og app, SDK-diagnose- og ydeevnedata samt data om annoncevisninger og interaktioner. Din omtrentlige placering kan udledes af din IP-adresse. Vægt, puls, søvn, måltider, billeder, træninger, mål, GPS-data og fitnesscenterplaceringer registreret i BodyMode medtages ikke i annonceanmodninger."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Werbeauslieferung erhält Google deine IP-Adresse, grundlegende Geräte- und App-Informationen, Diagnose- und Leistungsdaten des SDK sowie Daten zu Anzeigenaufrufen und -interaktionen. Dein ungefährer Standort kann aus der IP-Adresse abgeleitet werden. Gewicht, Herzfrequenz, Schlaf, Mahlzeiten, Fotos, Trainings, Ziele, GPS-Daten und in BodyMode erfasste Studiostandorte sind nicht in Werbeanfragen enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για την προβολή διαφημίσεων, η Google λαμβάνει τη διεύθυνση IP σου, βασικές πληροφορίες συσκευής και εφαρμογής, διαγνωστικά δεδομένα και δεδομένα απόδοσης SDK, καθώς και δεδομένα εμφανίσεων και αλληλεπιδράσεων με διαφημίσεις. Η κατά προσέγγιση τοποθεσία σου μπορεί να συναχθεί από τη διεύθυνση IP. Βάρος, καρδιακός ρυθμός, ύπνος, γεύματα, φωτογραφίες, προπονήσεις, στόχοι, δεδομένα GPS και τοποθεσίες γυμναστηρίων που καταγράφονται στο BodyMode δεν περιλαμβάνονται στα αιτήματα διαφημίσεων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "For ad delivery, Google receives your IP address, basic device and app information, SDK diagnostic and performance data, and ad impression and interaction data. Your approximate location may be inferred from your IP address. Weight, heart rate, sleep, meals, photos, workouts, goals, GPS data, and gym locations recorded in BodyMode are not included in ad requests."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "For ad delivery, Google receives your IP address, basic device and app information, SDK diagnostic and performance data, and ad impression and interaction data. Your approximate location may be inferred from your IP address. Weight, heart rate, sleep, meals, photos, workouts, goals, GPS data, and gym locations recorded in BodyMode are not included in ad requests."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For ad delivery, Google receives your IP address, basic device and app information, SDK diagnostic and performance data, and ad impression and interaction data. Your approximate location may be inferred from your IP address. Weight, heart rate, sleep, meals, photos, workouts, goals, GPS data, and gym locations recorded in BodyMode are not included in ad requests."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "For ad delivery, Google receives your IP address, basic device and app information, SDK diagnostic and performance data, and ad impression and interaction data. Your approximate location may be inferred from your IP address. Weight, heart rate, sleep, meals, photos, workouts, goals, GPS data, and gym locations recorded in BodyMode are not included in ad requests."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar publicidad, Google recibe tu dirección IP, información básica del dispositivo y la app, datos de diagnóstico y rendimiento del SDK, y datos de visualización e interacción con publicidad. Tu ubicación aproximada puede inferirse a partir de tu dirección IP. El peso, la frecuencia cardiaca, el sueño, las comidas, las fotos, los entrenamientos, las objetivos, los datos GPS y las ubicaciones de gimnasios registrados en BodyMode no se incluyen en las solicitudes de publicidad."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mostrar anuncios, Google recibe tu dirección IP, información básica del dispositivo y la app, datos de diagnóstico y rendimiento del SDK, y datos de visualización e interacción con anuncios. Tu ubicación aproximada puede inferirse a partir de tu dirección IP. El peso, la frecuencia cardiaca, el sueño, las comidas, las fotos, los entrenamientos, las metas, los datos GPS y las ubicaciones de gimnasios registrados en BodyMode no se incluyen en las solicitudes de anuncios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainosten toimittamista varten Google vastaanottaa IP-osoitteesi, laitteen ja sovelluksen perustiedot, SDK:n diagnostiikka- ja suorituskykytiedot sekä tiedot mainosten näyttökerroista ja vuorovaikutuksesta. Likimääräinen sijaintisi voidaan päätellä IP-osoitteesta. BodyModeen tallennettua painoa, sykettä, unta, aterioita, kuvia, harjoituksia, tavoitteita, GPS-tietoja ja kuntosalien sijainteja ei sisällytetä mainospyyntöihin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour diffuser des publicités, Google reçoit votre adresse IP, des informations générales sur l'appareil et l'app, les données de diagnostic et de performance du SDK, ainsi que les données d'affichage et d'interaction avec les publicités. Votre position approximative peut être déduite de votre adresse IP. Le poids, la fréquence cardiaque, le sommeil, les repas, les photos, les entraînements, les objectifs, les données GPS et les lieux de salle enregistrés dans BodyMode ne sont pas inclus dans les demandes publicitaires."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour diffuser des publicités, Google reçoit votre adresse IP, des informations générales sur l'appareil et l'app, les données de diagnostic et de performance du SDK, ainsi que les données d'affichage et d'interaction avec les publicités. Votre position approximative peut être déduite de votre adresse IP. Le poids, la fréquence cardiaque, le sommeil, les repas, les photos, les entraînements, les objectifs, les données GPS et les lieux de salle enregistrés dans BodyMode ne sont pas inclus dans les demandes publicitaires."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાહેરાત બતાવવા Google તમારું IP સરનામું, ઉપકરણ અને એપની મૂળભૂત માહિતી, SDK નિદાન અને કાર્યક્ષમતા ડેટા તથા જાહેરાત દેખાવ અને ક્રિયાપ્રતિક્રિયા ડેટા મેળવે છે. IP સરનામાથી અંદાજિત સ્થાન નક્કી થઈ શકે છે. BodyModeમાં રેકોર્ડ કરેલું વજન, હૃદયગતિ, ઊંઘ, ભોજન, ફોટા, વર્કઆઉટ, લક્ષ્યો, GPS ડેટા અને જિમ સ્થાન જાહેરાત વિનંતીઓમાં શામેલ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לצורך הצגת מודעות, Google מקבלת את כתובת ה-IP, מידע בסיסי על המכשיר והיישום, נתוני אבחון וביצועים של ה-SDK ונתוני חשיפה ואינטראקציה עם מודעות. ייתכן שמיקום משוער יוסק מכתובת ה-IP. משקל, דופק, שינה, ארוחות, תמונות, אימונים, יעדים, נתוני GPS ומיקומי חדרי כושר שנרשמו ב-BodyMode אינם נכללים בבקשות למודעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज्ञापन दिखाने के लिए Google आपका IP पता, डिवाइस और ऐप की मूल जानकारी, SDK के निदान और प्रदर्शन डेटा तथा विज्ञापन दिखने और इंटरैक्शन का डेटा प्राप्त करता है। IP पते से अनुमानित स्थान निकाला जा सकता है। BodyMode में दर्ज वज़न, हृदय गति, नींद, भोजन, फ़ोटो, वर्कआउट, लक्ष्य, GPS डेटा और जिम स्थान विज्ञापन अनुरोधों में शामिल नहीं होते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prikazivanje oglasa Google prima vašu IP adresu, osnovne podatke o uređaju i aplikaciji, dijagnostičke podatke i podatke o radu SDK-a te podatke o prikazima oglasa i interakcijama. Približna lokacija može se izvesti iz IP adrese. Težina, puls, san, obroci, fotografije, treninzi, ciljevi, GPS podaci i lokacije teretana zabilježeni u BodyModeu nisu uključeni u zahtjeve za oglase."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hirdetések megjelenítéséhez a Google megkapja az IP-címedet, az eszköz és az alkalmazás alapadatait, az SDK diagnosztikai és teljesítményadatait, valamint a hirdetésmegjelenítési és interakciós adatokat. Az IP-címedből hozzávetőleges hely állapítható meg. A BodyMode-ban rögzített testsúly, pulzus, alvás, étkezések, fotók, edzések, célok, GPS-adatok és edzőtermi helyek nem szerepelnek a hirdetési kérelmekben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menayangkan iklan, Google menerima alamat IP Anda, informasi dasar perangkat dan aplikasi, data diagnostik dan performa SDK, serta data tayangan dan interaksi iklan. Perkiraan lokasi dapat disimpulkan dari alamat IP. Berat badan, detak jantung, tidur, makanan, foto, latihan, tujuan, data GPS, dan lokasi gym yang dicatat di BodyMode tidak disertakan dalam permintaan iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per pubblicare gli annunci, Google riceve il tuo indirizzo IP, informazioni di base sul dispositivo e sull'app, dati diagnostici e sulle prestazioni dell'SDK e dati su visualizzazioni e interazioni con gli annunci. La posizione approssimativa può essere dedotta dall'indirizzo IP. Peso, frequenza cardiaca, sonno, pasti, foto, allenamenti, obiettivi, dati GPS e posizioni delle palestre registrati in BodyMode non sono inclusi nelle richieste pubblicitarie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告配信では、IPアドレス、端末・アプリの概要情報、SDKの診断・パフォーマンス情報、広告の表示・操作情報がGoogleに送信され、IPアドレスから概算位置が推定される場合があります。BodyModeで記録した体重、心拍、睡眠、食事、写真、トレーニング、目標、GPS・ジム位置は広告リクエストに含めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 제공을 위해 Google로 IP 주소, 기기 및 앱의 기본 정보, SDK 진단 및 성능 데이터, 광고 노출 및 상호작용 데이터가 전송됩니다. IP 주소로 대략적인 위치가 추정될 수 있습니다. BodyMode에 기록된 체중, 심박수, 수면, 식사, 사진, 운동, 목표, GPS 데이터 및 헬스장 위치는 광고 요청에 포함되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जाहिरात वितरणासाठी Google तुमचा IP पत्ता, डिव्हाइस आणि अॅपची मूलभूत माहिती, SDK निदान व कार्यक्षमता डेटा आणि जाहिरात प्रदर्शन व परस्परसंवाद डेटा प्राप्त करते. IP पत्त्यावरून अंदाजे स्थान ठरवले जाऊ शकते. BodyMode मध्ये नोंदवलेले वजन, हृदयगती, झोप, जेवण, फोटो, वर्कआउट्स, उद्दिष्टे, GPS डेटा आणि जिम स्थाने जाहिरात विनंत्यांमध्ये समाविष्ट केली जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyiarkan iklan, Google menerima alamat IP anda, maklumat asas peranti dan aplikasi, data diagnostik dan prestasi SDK, serta data paparan dan interaksi iklan. Lokasi anggaran mungkin disimpulkan daripada alamat IP. Berat, kadar denyutan jantung, tidur, hidangan, foto, senaman, matlamat, data GPS dan lokasi gim yang direkodkan dalam BodyMode tidak disertakan dalam permintaan iklan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor advertentieweergave ontvangt Google je IP-adres, algemene apparaat- en appgegevens, diagnostische en prestatiegegevens van de SDK en gegevens over advertentievertoningen en interacties. Je globale locatie kan uit je IP-adres worden afgeleid. Gewicht, hartslag, slaap, maaltijden, foto's, trainingen, doelen, GPS-gegevens en sportschoollocaties die in BodyMode zijn geregistreerd, worden niet opgenomen in advertentieverzoeken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "For annonselevering mottar Google IP-adressen din, grunnleggende informasjon om enheten og appen, SDK-diagnostikk- og ytelsesdata samt data om annonsevisninger og interaksjoner. Omtrentlig posisjon kan utledes fra IP-adressen. Vekt, puls, søvn, måltider, bilder, treningsøkter, mål, GPS-data og treningssenterposisjoner registrert i BodyMode inkluderes ikke i annonseforespørsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W celu wyświetlania reklam Google otrzymuje Twój adres IP, podstawowe informacje o urządzeniu i aplikacji, dane diagnostyczne i wydajnościowe SDK oraz dane o wyświetleniach i interakcjach z reklamami. Przybliżona lokalizacja może zostać wywnioskowana z adresu IP. Masa ciała, tętno, sen, posiłki, zdjęcia, treningi, cele, dane GPS i lokalizacje siłowni zapisane w BodyMode nie są dołączane do żądań reklamowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para exibir anúncios, o Google recebe seu endereço IP, informações básicas do dispositivo e do app, dados de diagnóstico e desempenho do SDK e dados de exibição e interação com anúncios. Sua localização aproximada pode ser inferida pelo endereço IP. Peso, frequência cardíaca, sono, refeições, fotos, treinos, metas, dados de GPS e locais de academias registrados no BodyMode não são incluídos nas solicitações de anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para exibir anúncios, o Google recebe o seu endereço IP, informações básicas do dispositivo e do app, dados de diagnóstico e desempenho do SDK e dados de exibição e interação com anúncios. A sua localização aproximada pode ser inferida pelo endereço IP. Peso, frequência cardíaca, sono, refeições, fotos, treinos, objetivos, dados de GPS e locais de ginásios registados no BodyMode não são incluídos nas solicitações de anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru afișarea reclamelor, Google primește adresa IP, informații generale despre dispozitiv și aplicație, date de diagnostic și performanță ale SDK-ului și date despre afișările și interacțiunile cu reclamele. Locația aproximativă poate fi dedusă din adresa IP. Greutatea, pulsul, somnul, mesele, fotografiile, antrenamentele, obiectivele, datele GPS și locațiile sălilor înregistrate în BodyMode nu sunt incluse în solicitările de reclame."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для показа рекламы Google получает ваш IP-адрес, основные сведения об устройстве и приложении, диагностические данные и данные производительности SDK, а также сведения о показах рекламы и взаимодействиях с ней. По IP-адресу может быть определено примерное местоположение. Вес, пульс, сон, питание, фотографии, тренировки, цели, данные GPS и местоположения спортзалов, записанные в BodyMode, не включаются в рекламные запросы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na zobrazovanie reklám dostáva Google vašu IP adresu, základné údaje o zariadení a aplikácii, diagnostické a výkonnostné údaje SDK a údaje o zobrazeniach a interakciách s reklamami. Z IP adresy možno odvodiť približnú polohu. Hmotnosť, tepová frekvencia, spánok, jedlá, fotografie, tréningy, ciele, GPS údaje a polohy posilňovní zaznamenané v BodyMode nie sú súčasťou reklamných požiadaviek."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za prikazovanje oglasov Google prejme vaš naslov IP, osnovne podatke o napravi in aplikaciji, diagnostične podatke in podatke o delovanju SDK ter podatke o prikazih oglasov in interakcijah. Približna lokacija se lahko izpelje iz naslova IP. Teža, srčni utrip, spanje, obroki, fotografije, vadbe, cilji, podatki GPS in lokacije fitnesov, zabeleženi v BodyMode, niso vključeni v oglasne zahteve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För annonsvisning tar Google emot din IP-adress, grundläggande enhets- och appinformation, SDK-diagnostik- och prestandadata samt data om annonsvisningar och interaktioner. Din ungefärliga plats kan härledas från IP-adressen. Vikt, puls, sömn, måltider, bilder, träningspass, mål, GPS-data och gymplatser som registrerats i BodyMode ingår inte i annonsförfrågningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விளம்பரங்களை வழங்க Google உங்கள் IP முகவரி, சாதனம் மற்றும் ஆப்பின் அடிப்படைத் தகவல், SDK கண்டறிதல் மற்றும் செயல்திறன் தரவு, மேலும் விளம்பரக் காட்சி மற்றும் தொடர்புத் தரவைப் பெறுகிறது. IP முகவரியிலிருந்து தோராயமான இருப்பிடம் கணிக்கப்படலாம். BodyMode-ல் பதிவான எடை, இதயத் துடிப்பு, தூக்கம், உணவு, புகைப்படங்கள், வொர்க்அவுட்கள், இலக்குகள், GPS தரவு மற்றும் ஜிம் இருப்பிடங்கள் விளம்பரக் கோரிக்கைகளில் சேர்க்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రకటనలను అందించడానికి Google మీ IP చిరునామా, పరికరం మరియు యాప్ ప్రాథమిక సమాచారం, SDK నిర్ధారణ మరియు పనితీరు డేటా, అలాగే ప్రకటన ప్రదర్శన మరియు పరస్పర చర్య డేటాను స్వీకరిస్తుంది. IP చిరునామా నుంచి సుమారు స్థానం అంచనా వేయబడవచ్చు. BodyModeలో రికార్డ్ చేసిన బరువు, హృదయ స్పందన, నిద్ర, భోజనం, ఫోటోలు, వర్కౌట్లు, లక్ష్యాలు, GPS డేటా మరియు జిమ్ స్థానాలు ప్రకటన అభ్యర్థనల్లో చేర్చబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อแสดงโฆษณา Google จะได้รับที่อยู่ IP ข้อมูลพื้นฐานของอุปกรณ์และแอป ข้อมูลการวินิจฉัยและประสิทธิภาพของ SDK รวมถึงข้อมูลการแสดงผลและการโต้ตอบกับโฆษณา ตำแหน่งโดยประมาณอาจถูกอนุมานจากที่อยู่ IP น้ำหนัก อัตราการเต้นหัวใจ การนอน อาหาร รูปภาพ การฝึก เป้าหมาย ข้อมูล GPS และตำแหน่งยิมที่บันทึกใน BodyMode จะไม่รวมอยู่ในคำขอโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam sunumu için Google; IP adresini, temel cihaz ve uygulama bilgilerini, SDK tanılama ve performans verilerini, reklam gösterimi ve etkileşim verilerini alır. IP adresinden yaklaşık konum tahmin edilebilir. BodyMode'da kaydedilen kilo, kalp atış hızı, uyku, öğünler, fotoğraflar, antrenmanlar, hedefler, GPS verileri ve spor salonu konumları reklam isteklerine dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для показу реклами Google отримує вашу IP-адресу, основні відомості про пристрій і застосунок, діагностичні дані та дані продуктивності SDK, а також відомості про покази реклами й взаємодію з нею. За IP-адресою може бути визначено приблизне розташування. Вага, пульс, сон, харчування, фотографії, тренування, цілі, дані GPS і розташування спортзалів, записані в BodyMode, не включаються до рекламних запитів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để phân phối quảng cáo, Google nhận địa chỉ IP, thông tin cơ bản về thiết bị và ứng dụng, dữ liệu chẩn đoán và hiệu suất SDK, cùng dữ liệu hiển thị và tương tác quảng cáo. Vị trí gần đúng có thể được suy ra từ địa chỉ IP. Cân nặng, nhịp tim, giấc ngủ, bữa ăn, ảnh, buổi tập, mục tiêu, dữ liệu GPS và vị trí phòng gym được ghi trong BodyMode không được đưa vào yêu cầu quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为投放广告，Google会接收你的IP地址、设备和应用基本信息、SDK诊断和性能数据，以及广告展示和互动数据。Google可能会根据IP地址推断大致位置。BodyMode中记录的体重、心率、睡眠、餐食、照片、训练、目标、GPS数据和健身房位置不会包含在广告请求中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為投放廣告，Google 會接收你的IP位址、裝置與App基本資訊、SDK診斷和效能資料，以與廣告顯示與互動資料。Google可能會根據IP位址推估約略位置。BodyMode 中記錄的體重、心率、睡眠、餐點、照片、訓練、目標、GPS資料與健身房位置不會包含在廣告要求中。"
          }
        }
      }
    },
