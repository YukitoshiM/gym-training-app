        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinare piccoli porzioni di carboidrati, proteine e verdure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主食・主菜・野菜を小さめに組み合わせる"
