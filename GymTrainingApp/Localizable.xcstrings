    "training.c1eb249e0b6c": {
      "comment": "GymTrainingApp/Features/Plans/PlanListView.swift:81\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتسجيل الحدث الخاص بك وحدد الأهداف وابدأ تدريبك التالي دون تردد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el teu esdeveniment i marca objectius i comença el teu proper entrenament sense dubtar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaregistrujte cvičení a cílové hodnoty, abyste mohli bez váhání začít s dalšími tréninky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer øvelsen og det sæt mål, så du kan starte din næste træning uden at tøve."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrieren Sie Übungen und Ziele, um sofort mit dem nächsten Training zu beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράψτε τις ασκήσεις και τους στόχους σας για να ξεκινήσετε το επόμενο πρόγραμμα άσκησης χωρίς δισταγμό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Register exercises and set goals to start your next workout without hesitation."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Register exercises and set goals to start your next workout without hesitation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Register exercises and set goals to start your next workout without hesitation."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Register exercises and set goals to start your next workout without hesitation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tus ejercicios y objetivos para comenzar tu próximo entrenamiento sin dudar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tus ejercicios y objetivos para comenzar tu próximo entrenamiento sin dudar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää harjoitus ja aseta tavoitteet, niin voit aloittaa seuraavan treenin huoletta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos exercices et objectifs pour démarrer votre prochain entraînement sans hésitation."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos exercices et objectifs pour démarrer votre prochain entraînement sans hésitation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કસરત અને સેટ ધ્યેયોની નોંધ લો, અને તરત જ આગામી તાલીમ શરૂ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף תרגיל ומטרה, ותתחיל באימונים הבאים בלי לחשוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी गतिविधियों और सेट लक्ष्यों को पंजीकृत करके, बिना किसी हिचकिचाहट के अगले प्रशिक्षण को शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte kategoriju vježbe i ciljeve, te bez oklijeva započnite sljedeću trening."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon meg egy feladatot és egy csoportos célot, hogy bátran kezdje el a következő edzést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarkan jenis latihan dan tujuan set, lalu mulailah latihan berikutnya tanpa ragu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra gli esercizi e gli obiettivi di gruppo per iniziare subito il prossimo allenamento senza esitazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種目とセット目標を登録して、次のトレーニングを迷わず始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 종류와 함께 목표를 등록하여 다음 훈련을 망설이지 마세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यायाम प्रकार आणि एकत्रित लक्ष्येची नोंद करा, आणि पुढील प्रशिक्षणाला लगेच सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarkan aktiviti dan sasaran set, dan mulakan latihan seterusnya tanpa ragu-ragu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer oefeningen en setdoelen, zodat je direct kunt beginnen met de volgende training."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer øvelser og settmål, og begynn med neste treningsøkt uten å nøle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarejestruj ćwiczenia i zestaw cele, aby bez wahania rozpocząć następny trening."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seus exercícios e metas, e comece seu próximo treino sem hesitar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seus exercícios e metas, e comece seu próximo treino sem hesitar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează exercițiul și obiectivele asociate, pentru a începe antrenamentul fără ezitări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрируйте упражнение и целевую цель, чтобы легко начать следующую тренировку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte cvičenia a cieľové hodnoty, a začnite s ďalším tréningom bez váhania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte vadbo in nastavitve ciljev, da lahko brez oklevanja začnete naslednjo vadbo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrera övningar och mål, så att du kan börja träningen utan tvekan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயிற்சியையும், அதற்கான இலக்குகளையும் பதிவு செய்து, அடுத்த பயிற்சியை உடனடியாகத் தொடங்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యాయామం మరియు లక్ష్యాలను నమోదు చేసి, తదుపరి వ్యాయామాన్ని వెంటనే ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มชนิดของการออกกำลังกายและเป้าหมาย เพื่อเริ่มต้นการฝึกซ้อมครั้งต่อไปได้อย่างมั่นใจ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersizi ve hedef hedeflerini kaydederek, bir sonraki antrenmanı kolayca başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареєструйте види вправ та цілі для кожного, щоб без вагань почати наступне тренування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đăng ký bài tập và mục tiêu theo bộ để bắt đầu buổi tập luyện tiếp theo một cách dễ dàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注册项目和对应的目标，以便您可以轻松开始下一次训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請註冊項目和相應的目標，以便隨時開始訓練。"
          }
        }
      }
    },
