    "core_ui.5f8bbdddc70b": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:440\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن سجل التشخيص سجلات لحركات iPhone وApple Watch واتصالاتها وعمليات التمرين. ولا يتم إرساله تلقائيًا خارجيًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El registre de diagnòstic inclou registres dels moviments, comunicacions i operacions d'entrenament de l'iPhone i Apple Watch. No s'envia automàticament a l'exterior."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostický log obsahuje záznamy o fungování a komunikaci iPhone i Apple Watch, stejně jako provedené cvičení. Není automaticky zasílán na externí servery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoseloggen indeholder oplysninger om iPhone og Apple Watch's funktion, kommunikation og træningsaktiviteter. Den sendes ikke automatisk til eksterne enheder."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diagnose-Log enthält Aufzeichnungen über die Funktion, Kommunikation und Trainingsaktivitäten Ihres iPhones und Apple Watch. Er wird nicht automatisch an Dritte gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το αρχείο καταγραφής διαθέτει καταγραφή της λειτουργίας, επικοινωνίας και των δραστηριοτήτων του iPhone και του Apple Watch. Δεν αποστέλλεται αυτόματα στο εξωτερικό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic log includes records of iPhone and Apple Watch usage, communication, and workout activities. It is not automatically sent to external sources."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic log includes records of iPhone and Apple Watch usage, communication, and workout activities. It is not automatically sent to external sources."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic log includes records of iPhone and Apple Watch usage, communication, and workout activities. It is not automatically sent to external sources."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic log includes records of iPhone and Apple Watch usage, communication, and workout activities. It is not automatically sent to external sources."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de diagnóstico incluye el funcionamiento, la comunicación y las actividades del iPhone y Apple Watch. No se envía automáticamente a terceros."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de diagnóstico incluye el funcionamiento, la comunicación y las actividades del iPhone y Apple Watch. No se envía automáticamente a terceros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostiikkalogi sisältää iPhone- ja Apple Watch -laitteiden toiminnan, yhteydenpidon sekä harjoittelun tiedot. Se ei lähetetä automaattisesti ulos."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal de diagnostic contient les données relatives au fonctionnement, à la communication et aux activités de votre iPhone et de votre Apple Watch. Il n'est pas automatiquement envoyé à l'extérieur."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal de diagnostic contient les données relatives au fonctionnement, à la communication et aux activités de votre iPhone et de votre Apple Watch. Il n'est pas automatiquement envoyé à l'extérieur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડાયગ્નોસ્ટિક લોગમાં iPhone અને Apple Watchના ઑપરેશન, કોમ્યુનિકેશન અને વર્કઆઉટની કામગીરીની માહિતી શામેલ છે. આ આપોઆપ બાહ્ય ઉપકરણ પર મોકલવામાં આવતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יומן הדיאגנוזה כולל תיעוד של פעולת, תקשורת ופעילות גופנית במכשיר iPhone וב-Apple Watch. הוא לא נשלח אוטומטית למקום חיצוני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लॉग में iPhone और Apple Watch के उपयोग, संचार और वर्कआउट के रिकॉर्ड शामिल हैं। यह स्वचालित रूप से बाहर नहीं भेजा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Log aktivnosti uključuje podatke o radu i komunikaciji iPhonea i Apple Watcha, kao i podacima o vježbi. Automatski se ne šalju na van."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagnosztikai napló tartalmazza az iPhone és Apple Watch működésének, kommunikációjának és edzésvezérlésének adatait. Automatikusan nem küldődik ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Log diagnosis mencakup rekaman aktivitas dan komunikasi iPhone serta Apple Watch. Tidak dikirim secara otomatis ke pihak lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il log diagnostico include informazioni sull'attività fisica e sulla comunicazione tra iPhone e Apple Watch. Non viene automaticamente inviato all'esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断ログにはiPhoneとApple Watchの動作・通信・ワークアウト操作の記録が含まれます。外部へは自動送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 로그에는 iPhone 및 Apple Watch의 작동, 통신, 운동 기록이 포함됩니다. 외부로 자동 전송되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निदान लॉगमध्ये iPhone आणि Apple Watch च्या कार्याचा, संपर्काचा आणि वर्कआउटच्या नोंदी समाविष्ट आहेत. हे आपोआप बाहेर पाठवले जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log diagnosis termasuk rekod operasi, komunikasi, dan aktiviti menggunakan iPhone dan Apple Watch. Ia tidak dihantar secara automatik ke pihak lain."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De diagnose-log bevat gegevens over de werking, communicatie en workouts op uw iPhone en Apple Watch. Deze worden niet automatisch naar buiten verzonden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoseloggen inneholder informasjon om iPhone og Apple Watch sin funksjonalitet, kommunikasjon og treningsaktiviteter. Den sendes ikke automatisk til eksterne enheter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log diagnostyczny zawiera informacje o działaniu i komunikacji iPhone'a oraz Apple Watch, a także o wykonywanych ćwiczeniach. Nie jest automatycznie wysyłany na zewnątrz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O log de diagnóstico inclui registros de funcionamento, comunicação e atividades do iPhone e Apple Watch. Não é enviado automaticamente para fora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O log de diagnóstico inclui registros de funcionamento, comunicação e atividades do iPhone e Apple Watch. Não é enviado automaticamente para fora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnalul de diagnostic include înregistrări ale funcționării, comunicării și activităților fizice pe iPhone și Apple Watch. Nu sunt trimise automat către exterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал диагностики содержит информацию о работе и взаимодействии iPhone и Apple Watch, а также об использовании тренировок. Он автоматически не отправляется на внешние устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostický log obsahuje záznamy o fungovaní, komunikácii a aktivitách na iPhone a Apple Watch. Neposielajú sa automaticky na externé servery."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logarizem diagnostike vsebuje podatke o delovanju in komunikaciji iPhonea ter Apple Watch, ter uporabi za vadbo. Niso poslane na zunanjo stran."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosloggen innehåller information om iPhone och Apple Watch-funktioner, kommunikation och träningsaktiviteter. Den skickas inte automatiskt till dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த பதிவில், ஐபோன் மற்றும் ஆப்பிள் வாட்ச் ஆகியவற்றின் செயல்பாடுகள், தகவல் தொடர்பு மற்றும் உடற்பயிற்சி தொடர்பான தரவுகள் அடங்கும். இது தானாகவே வெளி அனுப்பப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డయాగ్నస్ లాగ్‌లో iPhone మరియు Apple Watch యొక్క పనితీరు, కమ్యూనికేషన్ మరియు వ్యాయామ కార్యకలాపాల రికార్డులు ఉంటాయి. ఇది స్వయంచాలకంగా బయటికి పంపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลการทำงานของ iPhone และ Apple Watch รวมถึงการออกกำลังกาย จะถูกเก็บไว้ในบันทึก หากต้องการส่งออก สามารถทำได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanılama günlükleri, iPhone ve Apple Watch'un çalışma, iletişim ve egzersiz operasyonlarının kayıtlarını içerir. Dışarıya otomatik olarak gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал діагностики містить записи щодо роботи та зв'язку iPhone та Apple Watch, а також дій під час тренувань. Він не надсилається автоматично назовні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trữ nhật ký chẩn đoán bao gồm hoạt động, kết nối và thao tác tập luyện trên iPhone và Apple Watch. Không tự động gửi ra bên ngoài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断日志包含iPhone和Apple Watch的设备操作、通信和锻炼记录。不会自动发送给外部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断日志包含iPhone和Apple Watch的运行、通信和锻炼操作记录。不会自动发送给外部。"
          }
        }
      }
    },
