    "core_ui.738330e87b19": {
      "comment": "GymTrainingApp/Features/Onboarding/InitialSetupView.swift:565\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتعيين عدد معقول من المرات والوقت"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estableix un nombre raonable de vegades i temps"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte rozumný počet a dobu trvání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil et passende antal og tid"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie eine realistische Anzahl und Dauer fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε έναν λογικό αριθμό και χρόνο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a reasonable number of repetitions and time."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a reasonable number of repetitions and time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a reasonable number of repetitions and time."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a reasonable number of repetitions and time."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Establezca un número y tiempo razonables."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Establezca un número y tiempo razonables."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä sopiva määrä toistoja ja aikaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un nombre et une durée raisonnables."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un nombre et une durée raisonnables."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરળ અને યોગ્ય સંખ્યા અને સમય સેટ કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדר מספר וזמן סבירים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी क्षमता के अनुसार, उचित संख्या और समय निर्धारित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite razumnu količinu i vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa be a megengedhető számot és időtartamot"
          }
