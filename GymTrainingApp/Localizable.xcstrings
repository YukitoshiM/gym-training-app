    "health_meals_body_ai.6e80ae6c0ed4": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:576\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أحدث قيمة تم تسجيلها بواسطة تطبيق Noise وما إلى ذلك. لم يتم ضبطها على 0 إذا لم يتم الحصول عليها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Últim valor registrat per l'aplicació Noise, etc. No s'estableix en 0 si no s'ha adquirit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejnovější hodnoty zaznamenané v aplikaci Noise. Pokud není hodnota k dispozici, ponechte ji na 0."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seneste værdi fra Noise-appen osv. 0, hvis ikke registreret."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Werte, die von Apps wie Noise aufgezeichnet wurden. Unbekannte Werte werden nicht auf 0 gesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τελευταίες τιμές που καταγράφηκαν από εφαρμογές όπως η \"Noise\". Δεν θα οριστούν σε 0 αν δεν υπάρχουν δεδομένα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest values recorded by Noise app (if applicable). If no value is available, it will remain 0."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest values recorded by Noise app (if applicable). If no value is available, it will remain 0."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest values recorded by Noise app (if applicable). If no value is available, it will remain 0."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Latest values recorded by Noise app (if applicable). If no value is available, it will remain 0."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Último valor registrado por la aplicación de ruido, etc. Si no hay valor, se establece en 0."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Último valor registrado por la aplicación de ruido, etc. Si no hay valor, se establece en 0."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisin arvo, jonka Noise-sovellus (tai muu sovellus) on tallentanut. Jos arvoa ei ole saatavilla, se jätetään 0:ksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur la plus récente enregistrée par Noise, etc. Ne définissez pas 0 pour les valeurs non enregistrées."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur la plus récente enregistrée par Noise, etc. Ne définissez pas 0 pour les valeurs non enregistrées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Noise એપ્લિકેશન વગેરે દ્વારા રેકોર્ડ કરેલ સૌથી તાજેતરનું મૂલ્ય. જો કોઈ મૂલ્ય મેળવી શકાય તેમ નથી, તો તેને 0 તરીકે સેટ કરશો નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכים העדכניים ביותר שמחושבים על ידי אפליקציות כמו Noise. אם אין ערך, השאר אותו 0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शोर ऐप आदि द्वारा दर्ज की गई नवीनतम वैल्यू। यदि उपलब्ध नहीं है, तो इसे 0 पर सेट न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovije vrijednosti koje je zabilježila aplikacija Noise. Ako nema podataka, ostavi vrijednost na 0."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Noise alkalmazás által rögzített legutóbbi érték. Ha nincs érték, akkor 0-t nem használunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai terbaru dari aplikasi seperti Noise. Jika belum ada, biarkan bernilai 0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori più recenti registrati da app come Noise. Se non è disponibile, lascia il valore a 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Noiseアプリなどが記録した最新値。未取得は0にしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Noise 앱 등이 기록한 최신 값입니다. 미수집인 경우 0으로 설정하지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noise ॲपद्वारे रेकॉर्ड केलेले नवीनतम मूल्य. उपलब्ध नसल्यास, 0 सेट करू नका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai terkini daripada aplikasi seperti Noise. Jika tidak ada, jangan ditetapkan kepada 0."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De meest recente waarde die door Noise (of vergelijkbare app) is geregistreerd. Als er geen waarde is, wordt deze niet op 0 ingesteld."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyeste verdi fra Noise-app (eller lignende). Ikke sett verdien til 0 hvis den ikke er registrert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsze wartości z aplikacji Noise (jeśli dostępne). W przypadku braku danych, wartość pozostaje na 0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Último valor registrado por aplicativos como Noise. Se não houver, deixe em 0."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Último valor registrado por aplicativos como Noise. Se não houver, deixe em 0."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valoarea cea mai recentă înregistrată de aplicația Noise etc. Dacă nu există valoare, aceasta va fi setată la 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние значения, полученные из приложения Noise и других. Не устанавливайте значение 0 для отсутствующих данных."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najaktuálnejšie hodnoty zaznamenané aplikáciou Noise. Ak hodnota nie je dostupná, nech sa zobrazí 0."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnovejšo vrednost, ki jo je zabeležila aplikacija Noise. Če ni na voljo, nastavite na 0."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaste värden från app som Noise, etc. Sätt inte värdet till 0 om det inte har hämtats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Noise பயன்பாடு போன்றவற்றுடன் பதிவு செய்யப்பட்ட சமீபத்திய மதிப்புகள். கிடைக்காதவை 0 ஆக இருக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Noise యాప్ మొదలైన వాటి ద్వారా నమోదు చేసిన తాజా విలువ. పొందలేనిది 0 కి మార్చదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าล่าสุดที่บันทึกโดยแอป Noise หากยังไม่มี ให้แสดงเป็น 0"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gürültü uygulaması gibi, en son değerler. Alınmayan değerler için 0 kullanmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найновіші значення, отримані додатком Noise тощо. Якщо значення відсутні, не встановлюйте їх на 0."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị mới nhất từ ứng dụng Noise (nếu có). Nếu chưa có, để giá trị là 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由Noise应用等记录的最新值。未获取时，不设为0。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Noise 應用等記錄的最新值。未取得時，不會設定為 0。"
          }
        }
      }
    },
