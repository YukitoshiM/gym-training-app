        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankopen worden beoordeeld. Na voltooiing automatisch toegepast."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet venter på godkjenning. Vil bli automatisk registrert etter fullføring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Występujemy o zatwierdzenie. Po zakończeniu automatycznie zostanie to odzwierciedlone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está aguardando aprovação. Será refletida automaticamente após a conclusão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está pendente de aprovação. Será refletida automaticamente após a conclusão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Achiziția este în așteptare. Va fi reflectată automat după finalizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ находится в процессе обработки. Обновление произойдет автоматически после завершения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákup čaká na schválenie. Po potvrdení sa automaticky zohľadní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupnja čaka na potrditev. Po uspešni potrditvi se bodo avtomatično upodobili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet väntar på godkännande. Reflekteras automatiskt efter genomförande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாங்கியது இன்னும் சரிபார்க்கப்படவில்லை. முடிந்ததும் தானாகவே சேர்க்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనుగోలు ఆమోదం కోసం వేచి ఉంది. పూర్తయిన తర్వాత స్వయంచాలకంగా ప్రతిబింబిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรอการอนุมัติ โปรแกรมจะแสดงผลโดยอัตโนมัติเมื่อเสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma işlemi onay bekliyor. Tamamlandıktan sonra otomatik olarak yansıtılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Замовлення на розгляді. Автоматично відобразиться після завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ xác nhận. Sẽ tự động hiển thị sau khi hoàn thành."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买正在等待审核。完成后自动生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待審核。完成後將自動反映。"
          }
        }
      }
    },
    "ai_credit.purchase_terms": {
      "comment": "GymTrainingApp/Features/Reports/AICreditStoreView.swift:50\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نقاط الشراء لا تنتهي صلاحيتها. لا يمكن نقلها أو بيعها. عند الشراء، لن تظهر الإعلانات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els crèdits de compra no caduquen. No es poden transferir ni canviar. Fins i tot després de comprar, l'anunci no s'eliminarà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredity z nákupu nelze ztratit. Nelze je převést ani vyměnit. I po nákupu zůstane zobrazena reklama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købekreditter udløber ikke. Kan ikke overføres eller indløses. Bannerannoncer vises stadig, selvom du har købt kreditter."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf-Credits sind nicht abnutzbar. Sie können nicht übertragen oder verkauft werden. Bannerwerbung ist auch nach dem Kauf sichtbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αξίες αγοράς δεν λήγουν. Δεν μπορούν να μεταφερθούν ή να εξαργυρωθούν. Ακόμα και μετά την αγορά, οι διαφημιστικές προτάσεις παραμένουν ορατές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase credits do not expire. Cannot be transferred or redeemed. Banners will still appear after purchase."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase credits do not expire. Cannot be transferred or redeemed. Banners will still appear after purchase."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase credits do not expire. Cannot be transferred or redeemed. Banners will still appear after purchase."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase credits do not expire. They cannot be transferred or redeemed. Banners will still appear even after purchase."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los créditos de compra no caducan. No se pueden transferir ni canjear. La compra no elimina los anuncios publicitarios."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los créditos de compra no caducan. No se pueden transferir ni canjear. Al comprar, los anuncios no desaparecerán."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostokrediitit eivät vanhene. Niitä ei voi siirtää tai vaihtaa rahaksi. Banner-mainoksia ei näy ostamisen jälkeen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits d'achat ne s'épuisent pas. Ils ne peuvent pas être transférés ou échangés. L'affichage des bannières publicitaires n'est pas supprimé après l'achat."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les crédits d'achat ne s'épuisent pas. Ils ne peuvent pas être transférés ou échangés. Les bannières publicitaires restent visibles même après l'achat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખરીદી ક્રેડિટ સમાપ્ત થતી નથી. ટ્રાન્સફર અથવા વેચાણ શક્ય નથી. ખરીદ્યા પછી પણ જાહેરાતો દેખાશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקודות הרכישה לא עוברות לבעלים אחר. אין אפשרות למכירה. פרסום ממומן עדיין יופיע לאחר הרכישה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खरीद के क्रेडिट समाप्त नहीं होते। इन्हें हस्तांतरित या भुनाया नहीं जा सकता। बैनर विज्ञापन भी दिखाई देंगे।।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krediti za kupnju ne istječu. Ne mogu se prenositi ili prodavati. Nakon kupnje, oglasi neće biti prikazani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlási kreditek nem érvénytelenülnek. Nem adhatók át vagy pénzbe cserélhetők. A bannerek továbbra is megjelennek, még akkor is, ha vásároltál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit pembelian tidak akan kedaluwarsa. Tidak dapat ditransfer atau ditukar. Banner iklan tetap terlihat meskipun sudah membeli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I crediti per l'acquisto non scadono. Non possono essere trasferiti o convertiti. L'acquisto non rimuove la pubblicità banner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入クレジットは失効しません。譲渡・換金はできません。購入してもバナー広告は非表示になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매 크레딧은 만료되지 않습니다. 양도 또는 현금화는 불가능합니다. 구매해도 배너 광고가 표시되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खरेदी केलेले क्रेडिट रद्द होत नाही. ते हस्तांतरित किंवा विनिमय करता येत नाही. खरेदी केल्यावर बॅनर जाहिरात दिसणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit pembelian tidak akan tamat. Tidak boleh ditukar atau dijual. Banner iklan akan tetap diseragam walaupun anda membeli."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Aankoop-credits vervallen niet. Niet overdraagbaar of inwisselbaar. Banneradvertenties blijven zichtbaar, zelfs na aankoop."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpekreditter er ikke ugyldige. Kan ikke overføres eller selges. Bannerannonser vises fortsatt selv om du kjøper kreditter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredyty zakupowe nie wygasają. Nie można ich przenieść ani wymienić. Nawet po zakupie, banery reklamowe pozostaną widoczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os créditos de compra não expiram. Não podem ser transferidos ou convertidos. A exibição de anúncios não será desativada após a compra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os créditos da compra não expiram. Não podem ser transferidos ou convertidos. A exibição de anúncios será mantida mesmo após a compra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creditele de achiziție nu expiră. Nu pot fi transferate sau vândute. Anunțurile publicitare nu vor mai apărea, chiar dacă ați cumpărat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредиты не истекают. Нельзя передавать или обменивать. Баннерная реклама будет отображаться даже после покупки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nákupné kredity neexpire. Nelze ich previesť ani predať. Aj po kúpe sa zobrazia reklamy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit za nakup ne izgubi veljavnosti. Ne morete ga prenesti ali prodati. Ko kupite, oglasi ne bodo prikazane."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inköpskrediter är inte försvinnande. Kan inte överlåtas eller säljas. Bannerannonser visas även efter köp."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாங்கும் கிரெடிட்கள் காலாவதியாகாது. மாற்றவோ, விற்போமோ முடியாது. விளம்பரங்கள் மறைக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొనుగోలు క్రెడిట్‌లు చెల్లవు. వాటిని బదిలీ చేయడం లేదా అమ్మడం సాధ్యం కాదు. మీరు కొనుగోలు చేసినప్పటికీ, ప్రకటనలు కనిపించవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครดิตสำหรับการซื้อจะไม่หมดอายุ ไม่สามารถโอนหรือแลกเปลี่ยนได้ แม้ซื้อแล้วก็ยังแสดงโฆษณาได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alınan krediler geçersiz olmaz. Devredilemez veya nakde çevrilemez. Banner reklamları satın alırsanız da görünmeyecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кредити не спливають. Не можна передавати або обмінювати. Баннерні оголошення залишаються, навіть якщо придбано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm tín dụng mua không hết hạn. Không thể chuyển nhượng hoặc đổi ra tiền mặt. Banner quảng cáo vẫn hiển thị ngay cả khi đã mua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买积分不可退还。无法转让或兑换。即使购买，横幅广告也不会消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "積分不會失效。無法轉讓或兌換。即使購買，彈出廣告仍會顯示。"
          }
        }
      }
    },
    "ai_credit.purchase_unknown": {
      "comment": "GymTrainingApp/Data/AICreditPurchaseStore.swift:73\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التحقق من حالة الشراء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut verificar l'estat de la compra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemůžeme zjistit stav nákupu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke kontrollere købstilstanden."
          }
        },
