          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχω ελέγξει τις 3 τελευταίες δραστηριότητες και τις 8 καταγραφές διατροφής."
          }
        },
        "en-AU": {
          "stringUnit": {
