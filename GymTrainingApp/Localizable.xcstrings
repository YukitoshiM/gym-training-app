            "value": "Klidný analytik. Zaměřte se na jednu změnu v záznamech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stille analytiker. Fokuser på at ændre én ting ad gangen baseret på dine registreringer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ruhiger Analytiker. Konzentrieren Sie sich auf eine Änderung in den Aufzeichnungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας ήσυχος αναλυτής. Επιλέξτε μία αλλαγή από τις καταγραφές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet analyst. Focus on making one change based on your records"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet analyst. Focus on making one change based on your records"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet analyst. Focus on making one change based on your records"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet analyst. Focus on making one change based on your records"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Analista tranquilo. Enfócate en cambiar un solo aspecto a partir del registro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Analista tranquilo. Enfócate en cambiar un solo aspecto a partir del registro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiljainen analysoija. Valitse yksi muutos, joka perustuu kirjaimiin"
