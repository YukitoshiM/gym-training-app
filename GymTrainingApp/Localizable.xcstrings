    "health_meals_body_ai.a6282305f882": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:443\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد اخترته بناءً على غرضي المعلن، والمعدات المتاحة، وعدد التمارين في الأسبوع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
