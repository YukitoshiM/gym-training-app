    "training.4b13f017ef21": {
      "comment": "GymTrainingApp/Features/Plans/AIPlanCoachView.swift:40\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تضمين أي أحداث متاحة في الخطة. يرجى مراجعة وإعادة إنشاء المعدات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es va incloure cap esdeveniment disponible al pla. Revisa i recrea l'equip."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadané cvičení není zahrnuto v plánu. Zkontrolujte vybavení a aktualizujte plán."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der var ikke nogen træningsformer inkluderet i planen. Se over udstyret og opret den igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Übungen sind nicht im Plan enthalten. Bitte überprüfen und neu erstellen Sie den Plan."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρόγραμμα δεν περιλαμβάνει τους διαθέσιμους τύπους. Ελέγξτε και αναδημιουργήστε τη λίστα εξοπλισμού."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected exercises are not included in the plan. Please review and recreate the plan."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected exercises are not included in the plan. Please review and recreate the plan."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected exercises are not included in the plan. Please review and recreate the plan."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected exercises are not included in the plan. Please review and recreate the plan."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron ejercicios disponibles en el plan. Revisa los equipos y crea uno nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron ejercicios disponibles en el plan. Revisa los equipos y crea uno nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitut harjoitteet eivät sisältyneet suunnitelmaan. Tarkista laitteet ja luo uusi suunnitelma."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre d'exercices disponibles n'était pas inclus dans le plan. Veuillez revoir les équipements et les réorganiser."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre d'exercices disponibles n'était pas inclus dans le plan. Veuillez revoir les équipements et les réorganiser."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉપલબ્ધ કસરતો યોજનામાં શામેલ નથી. સાધનસામગ્રીની સમીક્ષા કરીને ફરીથી બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסוגים הזמינים אינם כלולים בתכנית. אנא בדוק/י את הציוד והתאם/י אותו מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध व्यायाम योजना में शामिल नहीं हैं। कृपया उपकरण की समीक्षा करें और फिर से बनाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na planu nema dostupnih programa. Provjerite i ažurirajte opremu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megadott program nem tartalmazza a rendelkezésre álló edzésciklot. Kérjük, ellenőrizze és frissítse a programot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada jenis latihan yang tercantum dalam rencana. Silakan periksa peralatan dan buat ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma non include gli esercizi disponibili. Rivedi l'elenco e crealo nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な種目が計画に含まれていませんでした。器具を見直して再作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 운동 종류가 계획에 포함되지 않았습니다. 장비를 다시 확인하고 수정해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध व्यायाम प्रकार योजनेत समाविष्ट नाहीत. कृपया उपकरणे तपासा आणि पुन्हा तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis latihan yang tersedia tidak termasuk dalam rencana. Sila semak semula dan tukar semula peralatan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekozen oefeningen zijn niet opgenomen in het plan. Controleer de apparatuur en maak het plan opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var ikke noen treningsøvelser planlagt. Vennligst se gjennom utstyret og oppdater planen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W planie nie uwzględniono dostępnych ćwiczeń. Przejrzyj dostępne urządzenia i zmień plan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível incluir os exercícios planejados. Revise os equipamentos e crie um novo plano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível incluir os exercícios planejados. Revise os equipamentos e crie um novo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul de exerciții disponibile nu este inclus în plan. Revizuiți și actualizați lista de exerciții."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В плане не указаны доступные упражнения. Пожалуйста, пересмотрите список и создайте новый план."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoznam dostupných cvičení nebol zahrnutý v pláne. Prosím, znova si ho skontrolujte a upravte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na načrtu niso navedeni na voljo opremi. Prosim, preverite in posodobite seznam opreme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det angivna antalet övningar ingick inte i planen. Se över utrustningen och skapa om den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளடக்கத்தில் உள்ள பயிற்சிகள் கிடைக்கவில்லை. உபகரணங்களை மறுபரிசீலனை செய்து மீண்டும் உருவாக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్లాన్‌లో అందుబాటులో ఉన్న వ్యాయామాలు లేవు. పరికరాలను సమీక్షించి, మళ్లీ సృష్టించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่สามารถใช้งานไม่ได้อยู่ในแผน โปรดตรวจสอบและแก้ไขรายการอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanılabilir egzersizler planın içinde yer almamaktadır. Ekipmanları gözden geçirin ve yeniden oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У плані відсутні доступні види діяльності. Перегляньте список обладнання та оновіть його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài tập chưa được đưa vào kế hoạch. Vui lòng xem xét lại và tạo lại kế hoạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划中未包含可用的动作。请重新选择并创建新的计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的動作未包含在計畫中。請重新檢視器材並進行調整。"
          }
        }
      }
    },
