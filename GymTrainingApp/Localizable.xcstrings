        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La funzionalità IA è disattivata nelle impostazioni. L'inserimento manuale può essere salvato così come è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI機能は設定でオフです。手動入力はこのまま保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 기능은 설정에서 꺼져 있습니다. 수동 입력도 그대로 저장할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI वैशिष्ट्ये सेटिंगमध्ये बंद आहेत. मॅन्युअल इनपुट जसेच्या तसे सेव्ह केले जाऊ शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungsi AI telah dimatikan dalam tetapan. Input manual boleh disimpan seperti apa adanya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-functie staat uit, via instellingen. Handmatige invoer kan worden opgeslagen zoals het is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-funksjonene er slått av i innstillingene. Du kan lagre manuelle innganger som de er."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcje AI są wyłączone w ustawieniach. Można zachować ręczne wpisy w obecnym stanie."
