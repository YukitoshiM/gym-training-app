          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht even en probeer het opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igjen etter noen minutter."
          }
        },
        "pl": {
