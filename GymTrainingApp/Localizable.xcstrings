    "domain_catalog.f3b5cbad91e8": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:11\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على لوحي كتفك معًا وارفع صدرك، ثم اخفض البار إلى منتصف صدرك وادفعه للأعلى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Premeu els omòplats junts i aixequeu el pit, baixant la barra al centre del pit i empenyent-lo cap amunt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přibližte lopatky k sobě, vytáhněte hrudník a táhněte činku směrem ke středu hrudníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring skulderbladene tættere sammen, åbn brystet og skub stangen op mod midten af brystet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte deine Schulterblätter aus und senke die Stange in der Mitte deiner Brust nach unten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγκεντρώστε τους οστούς της ωμοπλάτης και ανοίξτε το στήθος, τραβώντας το ράβδο προς το κέντρο του θώρακα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together, open your chest, and push the bar towards the center of your chest."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together, open your chest, and push the bar towards the center of your chest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together, open your chest, and push the bar towards the center of your chest."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together, open your chest, and push the bar towards the center of your chest."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar las escápulas y bajar la barra al centro del pecho, empujándola hacia arriba."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar las escápulas y bajar la barra al centro del pecho, empujándola hacia arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä hartiat lähellä toisiaan, vedä tanko alas rintaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez vos omoplates, ouvrez votre poitrine et poussez la barre vers le centre de votre poitrine."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez vos omoplates, ouvrez votre poitrine et poussez la barre vers le centre de votre poitrine."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખભાની હાડકાંને નજીક લાવો, છાતીને પહોળી કરો અને બારને છાતીના મધ્યમાં નીચે લઈ જઈને ઉપર ઉઠાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתקרב את הצלעות ולמתוח את החזה, תוך שאיבת המתח למרכז החזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी को थोड़ा खोलें, लेकिन अपने सीने को फैलाएं और बार को अपने सीने के बीच में नीचे लाएं और ऊपर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priljubite lopatice, otprite prsnice i podižite se uz pomoć svijesti o tome da ste ruku držali u sredini prsnica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyűsse a lapátokat, húzza lefelé a bárral a mell közepére."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga tulang selangka tetap sejajar, lalu menarik bar ke tengah dada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina le scapole, apri il petto e spingi la barra verso il centro del torace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩甲骨を寄せて胸を張り、バーを胸の中央へ下ろして押し上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어깨뼈를 모아 가슴을 활짝 열고, 바를 가슴 중앙으로 밀어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खांद्याचे हाड एकत्र ठेवून छाती उघडा, बार छातीच्या मध्यभागी ओढा आणि वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menegatkan tulang belikat, membuka dada, dan menarik bar ke arah tengah dada."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng je schouderbladen naar elkaar toe en til het gewicht naar je middenborst door middel van je ellebogen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold skulderbladene tett sammen og trekk stangen mot midten av brystet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przybliż obojczyki, wyprostuj klatkę piersiową i pociągnij drążek w kierunku środka klatki piersiowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime as escápulas e levante o corpo, puxando a barra para o centro do peito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime as escápulas e levante o corpo, puxando a barra para o centro do peito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apropie coastele și trage bara spre centrul pieptului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согните локти, не сгибая их слишком сильно, и подтяните штангу к центру грудной клетки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte lopatky, vytvorte hrudník a potiahnutím činky smerom k stredu hrudníka ju zdvíhajte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zložite ramo in raztegnete hrbet, ter potisnite ute proti sredini prsnih kost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulla ihop skulderbladen och sträck bröstet, dra stången neråt mot mitten av bröstet och pressa uppåt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோள்பட்டை எலும்புகளை ஒன்றிணைத்து, மார்பை விரித்து, பார்களை மார்பின் மையப்பகுதிக்கு இழுத்து உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భుజం కడ్వలను దగ్గర చేసి, ఛాతీని నిలువుగా ఉంచి, బార్‌ను ఛాతీ మధ్యలోకి దించి పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวบสะกะและยืดอก ดึงบาร์ลงมาตรงกลางอก แล้วยกขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuz kemiklerinizi bir araya getirin, göğsünüzü geniş tutun ve bara göğsünüzün ortasına doğru itin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зблизьте лопатки та розправте груди, опускаючи штангу в центр грудей та піднімаючи її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gần nhau các xương sườn, hóp ngực và đưa thanh tạ về trung tâm ngực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近肩胛骨，挺胸，并将杠杆向胸部中央下拉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近肩胛骨，挺胸，並用槓桿向中央拉至胸部"
          }
        }
      }
    },
    "domain_catalog.f4577fa825e1": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:423\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضعية التعليق، قم بقمع الارتداد وارفع ساقيك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En posició penjada, suprimiu el retrocés i aixequeu les cames."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte se v pozici, ve které využijete sílu nohou, abyste zvedali nohy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en hængende position og kontroller bevægelsen, mens du løfter benene."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Position mit gebeugten Beinen und kontrollieren Sie die Bewegung, während Sie die Beine anheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τη θέση με το σώμα γυμνασμένο και ελέγξτε την αντίσταση, σηκώνοντας τα πόδια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a hanging position, controlling the momentum, and lift your legs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a hanging position, controlling the momentum, and lift your legs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a hanging position, controlling the momentum, and lift your legs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a hanging position, controlling the momentum, and lift your legs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una posición colgada para controlar el movimiento y levanta las piernas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén una posición colgada para controlar el movimiento y levanta las piernas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tasapainossa ja käytä reunan apuna, nosta jalkaa ylös."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une position penchée en arrière pour contrôler le mouvement, puis soulevez la jambe."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une position penchée en arrière pour contrôler le mouvement, puis soulevez la jambe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લટકતી સ્થિતિમાં પ્રતિક્રિયાને નિયંત્રિત કરો અને પગ ઉંચો કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להישען ולנטר את התנועה, תוך הרמת הרגליים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "झुककर, शरीर को स्थिर रखकर और पैर ऊपर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držeći se, kontrolirajte pokret i podižite noge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a testet egyenesben, és használja a saját súlyát, hogy ellenálljon a mozgásnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan gerakan dengan posisi menggantung, lalu angkat kaki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenete una posizione di appoggio e controllate il movimento delle gambe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぶら下がった姿勢で反動を抑え、脚を持ち上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매달린 자세에서 반동을 줄이고 다리를 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाय ठेवताना, शरीराचा तोल सांभाळा आणि पाय वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan badan dalam posisi tergantung dan mengurangkan kesan pantulan, serta mengangkat kaki."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een hangende positie aan om de beweging te controleren en til je benen op."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en hengende posisjon og kontroller bevegelsen, løft benet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj pozycję w zwisie i kontroluj ruch, podnosząc nogi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a posição pendurada, controlando o movimento e elevando as pernas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a posição pendurada, controlando o movimento e elevando as pernas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți o poziție înclinată și controlați mișcarea, ridicând picioarele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте равновесие и контролируйте движение, поднимая ноги."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte sa v polohe, kde sa snažíte o rovnováhu, a zdvihnite nohy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite gib za stabilizacijo in dvigujte noge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängande position, kontrollera rörelsen och lyft benen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குனிந்த நிலையில், உடல் எடையை சமநிலைப்படுத்தி, கால்களை உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకవైపుకు ఆనించి, కదలికను నియంత్రించండి, కాళ్ళను పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ท่าแขวนตัวเพื่อควบคุมการเคลื่อนไหว และยกขาขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengenizi koruyarak ve bacaklarınızı yukarı kaldırarak, vücudunuzdaki gerginliği azaltın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайтеся в положенні на одній нозі та контролюйте рух, піднімаючи ногу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ tư thế treo người, kiểm soát động tác và nâng chân lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持悬垂姿势，控制反弹，抬起脚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持懸掛姿勢，控制反作用力，抬起腳。"
          }
        }
      }
    },
