    "domain_catalog.efc55a5e5d0d": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:167\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب الكابل من جانب جسمك، وقم بقمع الارتداد، وارفعه إلى جانب كتفك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estireu el cable des del costat del vostre cos, suprimiu el retrocés i aixequeu-lo al costat de l'espatlla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přitáhněte kabel z boku těla a využijte odraz k zvednutí paže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk kabellet hen over kroppen og brug modstanden til at løfte skuldrene."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabel von der Seite ziehen, um den Aufwärtsschub zu kontrollieren und die Schulter zur Seite zu heben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε το καλώδιο από τη πλευρά του σώματος, ελέγχοντας την κίνηση και σηκώνοντας τον ώμο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the cable from the side of your body, controlling the movement to lift your shoulder."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the cable from the side of your body, controlling the movement to lift your shoulder."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the cable from the side of your body, controlling the movement to lift your shoulder."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the cable from the side of your body, controlling the movement to lift your shoulder."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar de la cuerda desde el costado del cuerpo, controlando el movimiento y elevando el hombro."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar de la cuerda desde el costado del cuerpo, controlando el movimiento y elevando el hombro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä kaapelia vartalon sivulta ja käytä liikettä, jotta reaktiivisuus vähenee ja olkapää nousee sivulle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer le câble sur le côté du corps, en contrôlant le mouvement et en soulevant l'épaule."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirer le câble sur le côté du corps, en contrôlant le mouvement et en soulevant l'épaule."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરની બાજુમાંથી કેબલ ખેંચો અને હલનચલનને નિયંત્રિત કરીને ખભાની બાજુ પર ઉપર લઈ જાઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משך את הכבל מהצד של הגוף, תוך שליטה בתנועה והרמת הכתף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर के बगल से केबल को खींचें, और गति को नियंत्रित करते हुए कंधे के बगल में उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vije žicu od strane tijela, kontrolirajući pokret i podižući je prema ramenima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kabelt a test oldaláról húzva, a mozgást kontrollálva emeld fel a vállhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "menarik tali dari samping tubuh, mengontrol gerakan untuk mengangkat bahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirare il cavo lateralmente, controllando il movimento e sollevando le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ケーブルを体の横から引き、反動を抑えて肩の横へ上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸 옆에서 케이블을 잡아당겨, 움직임을 최소화하며 어깨 옆으로 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीराच्या बाजूने केबल ओढून, गती नियंत्रित ठेवून खांद्याच्या दिशेने वर उचलणे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik kabel dari sisi badan, dan gunakan momentum untuk mengangkat bahu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekt de kabel van de zijkant naar je lichaam en gebruikt de weerstand om je schouder op te tillen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk kabelen fra siden, og bruk motstanden for å løfte armene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociągnij linkę od siebie, kontrolując ruch i podnosząc ramię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a corda do lado do corpo, controlando o movimento e elevando o ombro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a corda do lado do corpo, controlando o movimento e elevando o ombro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage cârligul de-a lungul corpului, controlând mișcarea și ridică-l lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите канат, вытягивая его от тела в сторону, чтобы контролировать движение и поднимать плечо."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťahujte kábel z boku tela, aby ste minimalizovali odpory a zdvihli ho k bočnej časti ramena."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povleci žico čez telo in ohrani gib, pri tem pa dvigni ramo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra kabeln från sidan och använd momentumet för att lyfta axlarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடலின் பக்கத்திலிருந்து கேபிளை இழுத்து, இயக்கத்தை கட்டுப்படுத்தி தோள்பட்டைக்கு மேல் உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీరం యొక్క వైపు నుండి కేబుల్‌ను లాగడం, మరియు కదలికను నియంత్రించి భుజం వైపుకు పైకి ఎత్తడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงสายเคเบิลจากด้านข้างของร่างกาย และควบคุมแรงกระแทก เพื่อยกขึ้นไปด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabloyu vücudunuzun yanından çekerek, hareketi kontrol altında tutarak omuzlarınızı yukarı kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тягнути кабель від себе, контролюючи рух і піднімаючи плече."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo dây cáp từ bên thân, kiểm soát lực và nâng lên ngang vai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从身体两侧拉起绳索，控制反作用力，将肩部向侧面抬高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "从身体两侧拉起绳索，控制反作用力，将肩部向侧面抬高。"
          }
        }
      }
    },
    "domain_catalog.f041e32b3191": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:161\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دون أن تهز كتفيك، قم بثني مرفقيك قليلاً وارفعهما إلى الجانب."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense arronsar les espatlles, doblegueu lleugerament els colzes i aixequeu-los cap al costat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezklovějte ramena, mírně ohněte lokty a zvedejte je do strany."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå at runde skuldrene, og bøj let i albuerne, mens du løfter armene ud til siden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine aufrechte Haltung und beuge leicht deine Ellbogen, um sie seitlich anzuheben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην σκύζετε τους ώμους σας, αλλά λυγίστε ελαφρώς και σηκώστε τους προς τα πλάγια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your shoulders back and slightly bend your elbows while lifting them sideways."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your shoulders back and slightly bend your elbows while lifting them sideways."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your shoulders back and slightly bend your elbows while lifting them sideways."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your shoulders back and slightly bend your elbows while lifting them sideways."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener los hombros erguidos y doblar ligeramente los codos para levantar el cuerpo lateralmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener los hombros erguidos y doblar ligeramente los codos para levantar el cuerpo lateralmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä olkapalat suorina, taiva hieman ja nosta käsi sivulle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos épaules droit et pliez légèrement vos coudes tout en les levant sur le côté."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos épaules droit et pliez légèrement vos coudes tout en les levant sur le côté."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખભાને સીધા રાખો, હાથને હળવાશથી વાળીને બાજુ પર ઉઠાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא להתכופף את הכתפיים, ולשמור על מיקום הכתף מעט מושפל לצדדים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कंधों को झुकाएं नहीं, बल्कि अपनी कोहनी को थोड़ा मोड़कर उन्हें बगल में उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne naginjaite ramena, već lagano savijte ruke i podižite ih u stranu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne hajlítsa meg a vállakat, hanem tartsa őket enyhén hajlítva, és emelje oldalra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak membungkuk, lalu sedikit menekuk siku dan mengangkatnya ke samping."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le spalle dritte e piega leggermente i gomiti, sollevando lateralmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩をすくめず、肘を軽く曲げて横に持ち上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어깨를 둥글게 하지 않고, 가볍게 팔꿈치를 구부려 옆으로 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खांदे खाली न ठेवता, हलके वाकवून बाजूला उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan membungkuk, tekuk sedikit lengan dan angkat ke samping."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je schouders recht en buig je ellebogen licht om ze zijwaarts te bewegen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold skuldrene oppreist og bøy lett i albuene mens du løfter armen ut til siden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj proste plecy i delikatnie zginaj łokcie, unosząc ręce na boki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as ombros retas e flexione levemente os cotovelos para lateralizar o corpo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as ombros retas e flexione levemente os cotovelos para lateralizar o corpo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține umerii relaxați și îndoaie ușor antebrațele, ridicându-te lateral."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сгибайте плечи, слегка согните их и поднимите в стороны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenechajte sa pokrčiť, mierne ohnite lakte a zdvihnite ich do strany."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne nagibajte ramen, držite ramo blago upognjeno in dvignite jo na stran."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik att kuta ihop axlarna, böj lätt på armbågen och lyft den åt sidan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோள்களை நேராக வைத்து, கைகளை லேசாக மடக்கி, பக்கவாட்டில் உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భుజాలను వంచకుండా, భుజాలను కొద్దిగా వంచి, వాటిని పక్కకు ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลีกเลี่ยงการห่อไหล่ และงอข้อศอกเล็กน้อยเพื่อยกแขนขึ้นด้านข้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuzlarınızı öne eğmeyin, dirseklerinizi hafifçe bükerek yana kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сутуліться, а злегка зігніть руки та підніміть їх вбік."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ vai thẳng, gập nhẹ khuỷu tay và nâng cánh tay sang một bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要耸肩，轻微弯曲肘部并向两侧抬起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要聳肩，輕微彎曲肘部，並將手臂向側面抬起"
          }
        }
      }
    },
