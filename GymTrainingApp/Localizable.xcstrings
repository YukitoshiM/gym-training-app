    "health_meals_body_ai.c4e16ef103db": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:195\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد انخفض متوسط وزني الأسبوعي الأخير. من أجل دعم تضخم العضلات، فهو مرشح لزيادة المدخول الموصى به قليلاً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El meu pes mitjà setmanal recent ha disminuït. Per tal de donar suport a la hipertròfia muscular, és un candidat per augmentar lleugerament la ingesta recomanada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše průměrná váha za poslední týden klesá. Doporučujeme mírně zvýšit doporučenou denní dávku, aby podpořila svalový růst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gennemsnitlige vægtforbrug over den seneste uge er faldet. Dette kan indikere, at du har brug for at øge dit kalorieindtag lidt for at støtte muskelvækst."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr durchschnittlicher Wochengewicht ist gesunken. Als Unterstützung für den Muskelaufbau können Sie die empfohlene Menge leicht erhöhen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέσο βάρος σας την τελευταία εβδομάδα έχει μειωθεί. Αυτό μπορεί να οφείλεται στην αύξηση των θερμίδων, για να υποστηρίξετε τη μυϊκή ανάπτυξη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss has been observed. This may indicate a need to slightly increase your calorie intake to support muscle growth."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss has been observed. This may indicate a need to slightly increase your calorie intake to support muscle growth."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss has been observed. This may indicate a need to slightly increase your calorie intake to support muscle growth."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss has been observed. This may indicate a need to slightly increase your calorie intake to support muscle growth."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal ha disminuido. Considera aumentar ligeramente la ingesta para favorecer el crecimiento muscular."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal ha disminuido. Considera aumentar ligeramente la ingesta para favorecer el crecimiento muscular."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisen viikon keskimääräinen paino on laskenut. Tämä voi tukea lihasten kasvua, joten suositeltava annos voi olla hieman suurempi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire a diminué. Cela pourrait indiquer un besoin d'augmenter légèrement votre apport calorique pour favoriser la prise de masse musculaire."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire a diminué. Cela pourrait indiquer un besoin d'augmenter légèrement votre apport calorique pour favoriser la prise de masse musculaire."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા અઠવાડિયાનો સરેરાશ વજન ઘટી રહ્યું છે. સ્નાયુઓના વિકાસને ટેકો આપવા માટે, આહારની માત્રામાં થોડો વધારો કરવાની સંભાવના છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשקל הממוצע השבועי האחרון יורד. כיוון שזה תומך בהגדלת שרירים, זה יכול להיות מועמד להגדלת ההמלצות היומיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले सप्ताह का औसत वजन कम हो रहा है। मांसपेशियों के विकास को बढ़ावा देने के लिए, कृपया सेवन की मात्रा थोड़ी बढ़ाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša prosječna težina u posljednjoj tjednu se smanjuje. Razmislite o povećanju preporučene količine hranjivih sastojaka kako biste podržali mišićni rast."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utóbbi heti átlag súlyod csökken. Ehhez az izomépítés támogatásához, javaslom, hogy emeld meg a napi bevitel mennyiséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat badan rata-rata mingguan Anda menurun. Ini mungkin karena peningkatan asupan kalori untuk mendukung pertumbuhan otot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo peso medio settimanale è in diminuzione. Potrebbe essere un candidato per aumentare leggermente l'apporto calorico, a supporto della massa muscolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近の週平均体重が下がっています。筋肥大を支えるため、摂取目安を少し増やす候補です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 주 평균 체중이 감소하고 있습니다. 근육 성장을 지원하기 위해 섭취 권장량을 조금 늘리는 후보입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील आठवड्यातील सरासरी वजन कमी होत आहे. स्नायू वाढवण्यासाठी, आहारात थोडी वाढ करण्याची शक्यता आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Purata berat mingguan anda telah menurun. Ini mungkin merupakan calon untuk meningkatkan jumlah pengambilan, untuk menyokong pertumbuhan otot."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw gemiddelde gewicht over de afgelopen week is gedaald. Dit kan een indicatie zijn dat u voldoende eiwitten consumeert om spiergroei te ondersteunen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gjennomsnittlige vekt har gått ned den siste uken. Dette kan være et tegn på muskelvekst, så vurder å øke anbefalt inntak litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnia waga w ostatnim tygodniu jest niższa. Sugeruje to zwiększenie zalecanej ilości spożycia, aby wspomóc budowanie masy mięśniowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal tem diminuído. Considere aumentar ligeiramente a ingestão para apoiar o ganho de massa muscular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal tem diminuído. Considere aumentar ligeiramente a ingestão para apoiar o ganho de massa muscular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În ultima săptămână, greutatea medie a scăzut. Pentru a susține creșterea musculară, puteți lua în considerare creșterea ușoară a aportului caloric."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш средний вес за последнюю неделю снижается. Это может быть связано с набором мышечной массы, поэтому можно немного увеличить рекомендуемое количество калорий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša priemerná hmotnosť za poslednú týždeň klesla. Je to možné, aby ste podopreli svalový rast, preto zvážte mierne zvýšenie odporúčanej dávky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša povprečna telesna teža zadnjih tednih se zmanjšuje. To je lahko znak, da povečate priporočen dnevni odmerek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har tappat i genomsnittsvikt under den senaste veckan. Detta kan vara en indikation på att du behöver öka ditt kaloriintag något för att stödja muskeluppbyggnad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்திய வார சராசரி எடை குறைந்து வருகிறது. தசையை வளர்க்க, உட்கொள்ளும் அளவை சற்று அதிகரிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత వారపు సగటు బరువు తగ్గుతోంది. కండరాల పెరుగుదలకు మద్దతు ఇవ్వడానికి, తీసుకోవలసిన మోతాదును కొద్దిగా పెంచడం మంచిది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักเฉลี่ยรายสัปดาห์ของคุณลดลง ซึ่งเป็นไปตามความต้องการสำหรับการสร้างกล้ามเนื้อ ดังนั้นจึงเป็นตัวเลือกในการเพิ่มปริมาณที่แนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son haftanın ortalama ağırlığında düşüş var. Kas kütlesini desteklemek için, alım miktarını biraz artırmayı düşünebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середня вага за останній тиждень зменшується. Це може бути пов'язано з потребою у збільшенні споживання калорій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trọng lượng trung bình hàng tuần đang giảm. Đây là một lựa chọn để tăng lượng calo tiêu thụ, nhằm hỗ trợ phát triển cơ bắp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一周的平均体重下降。为了支持肌肉增长，建议稍微增加摄入量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一週的平均體重下降。為了支持肌肉生長，建議稍微增加攝取量。"
          }
        }
      }
    },
    "health_meals_body_ai.c51a6e397751": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:312\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور توضح التغيرات في المظهر، والأرقام مؤكدة بالقياسات الفعلية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fotos mostren els canvis d'aparença i els números es confirmen amb mesures reals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny vzhledu se sledují vizuálně, čísla ověřujeme měřením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder bruges til at se efter ændringer, mens tallet bekræftes gennem målinger."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Veränderungen werden visuell beurteilt, die Zahlen durch Messungen bestätigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι φωτογραφίες χρησιμοποιούνται για την παρακολούθηση των αλλαγών, ενώ οι αριθμητικές τιμές επαληθεύονται με μετρήσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual changes are assessed, and measurements confirm the data."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual changes are assessed, and measurements confirm the data."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual changes are assessed, and measurements confirm the data."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual changes are assessed, and measurements confirm the data."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto es para observar los cambios, las cifras se confirman mediante mediciones."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La foto es para observar los cambios, las cifras se confirman mediante mediciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva kertoo muutoksista, luvut tarkistetaan mittauksilla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos permettent de constater les changements physiques, les chiffres sont vérifiés par mesure."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos permettent de constater les changements physiques, les chiffres sont vérifiés par mesure."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો એ દેખાવમાં થતા ફેરફારો, આંકડા વાસ્તવિક માપથી ચકાસી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבדוק שינויים במראה באמצעות תמונות, ונתונים אמיתיים באמצעות מדידות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम देखने में बदलाव, संख्याएं मापने के माध्यम से सत्यापित करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izgled se može provjeriti na fotografiji, a vrijednosti se mjere."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megjelenés változásait a képekben, a számokat pedig a tényleges mérések alapján ellenőrizhetjük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan penampilan terlihat, angka diverifikasi melalui pengukuran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche fisiche sono visibili, i valori vengono confermati con misurazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は見た目の変化、数値は実測で確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외모 변화는 사진으로, 수치는 실제 측정으로 확인합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो हे केवळ दिसणाऱ्या बदलांचे आणि संख्यात्मक माहितीचे मापन आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan visual dan nilai diukur secara langsung."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De visuele veranderingen worden beoordeeld, de cijfers worden gemeten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk bildet for å se etter endringer, og bruk målinger for å bekrefte tallene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany w wyglądzie są oceniane wizualnie, a wartości mierzone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe as mudanças visuais, confirme os valores por medição."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe as mudanças visuais, confirme os valores por medição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografia indică schimbările în aspect, iar valorile sunt verificate prin măsurători."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение внешности, данные подтверждаются измерением."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena vzhľadu sa hodnotí vizuálne, čísla sa overujú meraním."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografija je za opazanje sprememb, števila pa se preverjajo s merjenjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder används för att se förändringar, siffror verifieras genom mätningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோற்ற மாற்றங்கள் புகைப்படத்தில், எண்களை அளவீடுகள் மூலம் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో అనేది మీ రూపాన్ని మార్చడానికి, సంఖ్యలు వాస్తవంగా తెలుసుకోవడానికి ఉపయోగపడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้รูปภาพเพื่อดูผลลัพธ์, ตัวเลขจะได้รับการตรวจสอบด้วยการวัดจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişimler görsel olarak, sayılar ölçümle doğrulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото показує зміни у вашому зовнішньому вигляді, а числові дані підтверджуються вимірюваннями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ kiểm tra sự thay đổi về ngoại hình và số liệu thông qua đo đạc thực tế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看外观变化，数值请通过实际测量确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外观变化，数值请通过实际测量确认。"
          }
        }
      }
    },
