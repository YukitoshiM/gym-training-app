          "stringUnit": {
            "state": "translated",
            "value": "व्यायाम, नींद और भोजन की आदतों को बनाए रखें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U redu je."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa meg a mozgás-, alvás- és táplálkozási szokásait"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan kebiasaan olahraga, tidur, dan makan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le tue abitudini di esercizio fisico, sonno e alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運動・睡眠・食事の習慣を保つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동, 수면, 식습관 유지"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यायाम, झोप आणि आहाराच्या सवयी चालू ठेवा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga kebiasaan senaman, tidur dan makan"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je gewoonten aan voor training, slaap en voeding."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppretthold vaner for trening, søvn og kosthold."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj regularne ćwiczenia, sen i dietę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha hábitos de exercício, sono e alimentação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha hábitos de exercício, sono e alimentação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți obiceiurile de exerciții, somn și alimentație"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте привычки: тренировки, сон и питание."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte si zvyk cvičiť, spánku a zdravého stravovania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohranjajte navade: telovadba, spanje in prehrana"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll vanor för träning, sömn och kost"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடற்பயிற்சி, தூக்கம் மற்றும் உணவு பழக்கத்தை பராமரிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వ్యాయామం, నిద్ర మరియు ఆహారపు అలవాట్లను కొనసాగించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษานิสัยการออกกำลังกาย, การนอนหลับ และการรับประทานอาหาร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz, uyku ve beslenme alışkanlıklarınızı sürdürün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуйте звичку: фізичні вправи, сон та харчування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duy trì thói quen tập thể dục, ngủ và ăn uống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持运动、睡眠和饮食习惯"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持运动、睡眠和饮食习惯"
          }
        }
      }
    },
    "core_ui.eed8ba416205": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:468\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف الخطط والسجل ومؤشرات الأداء الرئيسية الفعلية والوجبات والصور ومحادثات/ذكريات الذكاء الاصطناعي والأحداث المخصصة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Suprimeix els plans, l'historial, els KPI físics, els àpats, les fotos, les converses/records d'IA i els esdeveniments personalitzats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraníte plán, historii, klíčové ukazatele zdraví a kondice, jídlo, fotografie, konverzaci s AI a vlastní kategorie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet plan, historik, kropsmålinger, kost, billeder, AI-samtale og hukommelse, samt brugerdefinerede indstillinger."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan, Verlauf, Körper-KPI, Ernährung, Fotos, KI-Gespräch/Speicherung, benutzerdefinierte Aktivitäten löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφετε το πλάνο, το ιστορικό, τις φυσικές μετρήσεις, τη διατροφή, φωτογραφίες, συνομιλία και μνήμη AI, καθώς και προσαρμοσμένες δραστηριότητες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete plan, history, body KPIs, meals, photos, AI conversation/memory, and custom categories."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete plan, history, body KPIs, meals, photos, AI conversation/memory, and custom categories."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete plan, history, body KPIs, meals, photos, AI conversation/memory, and custom categories."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete plan, history, body KPIs, meals, photos, AI conversation/memory, and custom categories."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el plan, historial, KPI físico, comidas, fotos, conversación/memoria con IA y categorías personalizadas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el plan, historial, KPI físico, comidas, fotos, conversación/memoria con IA y categorías personalizadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista suunnitelma, historia, kehon mittarit, ruokapäiväkirja, valokuvat, AI-keskustelu ja muisti, sekä räätälöidyt aktiviteetit."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez le plan, l'historique, les indicateurs de santé, les repas, les photos, la conversation et la mémoire IA, ainsi que les catégories personnalisées."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez le plan, l'historique, les indicateurs de santé, les repas, les photos, la conversation et la mémoire IA, ainsi que les catégories personnalisées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "યોજના, ઇતિહાસ, શારીરિક KPI, આહાર, ફોટા, AI વાતચીત અને મેમરી, કસ્ટમ પ્રવૃત્તિઓ દૂર કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחק את התוכנית, היסטוריה, מדדי בריאות אישיים, תזונה, תמונות, שיחה וזיכרון AI, ומאפיינים מותאמים אישית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना, इतिहास, शारीरिक KPI, भोजन, तस्वीरें, AI बातचीत और स्मृति, कस्टम आइटम हटाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklonite plan, povijest, KPI za tijelo, prehranu, fotografije, razgovor s AI-om i prilagođene aktivnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A terv, az előzmények, a testhez tartozó mutatók, az étkezés, a képek, az AI-val való beszélgetés és a memória, valamint a saját beállítások eltávolítása."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus rencana, riwayat, KPI tubuh, makanan, foto, percakapan/ingatan AI, dan kategori khusus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina il piano, la cronologia, gli indicatori di benessere, l'alimentazione, le foto, la conversazione e la memoria AI, e le categorie personalizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画、履歴、身体KPI、食事、写真、AI会話・記憶、カスタム種目を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획, 기록, 신체 KPI, 식단, 사진, AI 대화 및 기억, 사용자 정의 항목 삭제."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना, इतिहास, शारीरिक मापदंड, आहार, फोटो, एआय संभाषण आणि स्मरणशक्ती, तसेच कस्टम पर्याय हटवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padamkan rencana, sejarah, KPI badan, makanan, foto, perbincangan dan ingatan AI, serta kategori khusus."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder planning, activiteitengeschiedenis, lichaamsmetingen, maaltijden, foto's, AI-gesprek en -herinneringen, en aangepaste activiteiten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett plan, historikk, kroppsmålinger, kosthold, bilder, samt AI-samtaler og minnefunksjoner, og tilpassede aktiviteter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa plan, historię, wskaźniki stanu fizycznego, posiłki, zdjęcia, rozmowy z AI i pamięć, oraz niestandardowe kategorie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui plano, histórico, KPIs físicos, alimentação, fotos, conversa/memória com IA e categorias personalizadas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui plano, histórico, KPIs físicos, alimentação, fotos, conversa/memória com IA e categorias personalizadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge planul, istoricul, indicatorii fizici, alimentația, fotografiile, conversațiile și memoria AI, precum și categoriile personalizate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите план, историю, показатели здоровья, питание, фотографии, разговор с ИИ и пользовательские данные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráňte plán, históriu, fyzické KPI, stravu, fotografie a konverzáciu s AI/pamäť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišite načrt, zgodovino, ključnike telesnega zdravja, prehrano, fotografije, AI pogovor in spomin ter prilagojene dejavnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort plan, historik, kroppsmätningar, kost, bilder, AI-samtal och minne, samt anpassade aktiviteter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டம், வரலாறு, உடல் KPI, உணவு, புகைப்படங்கள், AI உரையாடல் மற்றும் நினைவகம், தனிப்பயன் செயல்பாடுகளை நீக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రణాళిక, చరిత్ర, శారీరక KPI, ఆహారం, ఫోటోలు, AI సంభాషణ మరియు జ్ఞాపకాలు, అనుకూల అంశాలను తొలగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบแผน ประวัติ ตัวชี้วัดสุขภาพ อาหาร รูปภาพ การสนทนาและหน่วยความจำ AI และประเภทที่กำหนดเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan, geçmiş veriler, vücut KPI'leri, beslenme, fotoğraflar, yapay zeka sohbeti ve hafıza, özel kategorileri siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляються плани, історія, показники здоров'я, харчування, фотографії, розмови з AI та пам'ять, а також користувацькі категорії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa kế hoạch, lịch sử, chỉ số thể chất, chế độ ăn uống, ảnh, hội thoại và trí nhớ AI, danh mục tùy chỉnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除计划、历史记录、身体KPI、饮食、照片、AI对话和记忆，以及自定义项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "删除计划、历史记录、身体KPI、饮食、照片、AI对话和记忆，以及自定义项目。"
          }
        }
      }
    },
