    "domain_catalog.cf9aa255c8df": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:450\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ وركيك قريبين من الأرض، وقم بتمديد أطرافك القطرية ببطء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint els malucs a prop del terra, estira lentament les extremitats diagonals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstaňte v poloze, ve které jsou záda v kontaktu se zemí, a pomalu protáhněte ruce a nohy proti sobě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold knæene strakte og stræk langsomt arme og ben på tværs."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wirbelsäule am Boden ausrichten und langsam die gegenüberliegenden Arme und Beine dehnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατώντας τα γόνατα σας στο πάτωμα, τεντώστε αργά και στα δύο άκρα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your lower back close to the floor, slowly extend your arms and legs diagonally."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your lower back close to the floor, slowly extend your arms and legs diagonally."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your lower back close to the floor, slowly extend your arms and legs diagonally."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your lower back close to the floor, slowly extend your arms and legs diagonally."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Extender lentamente las piernas en diagonal, manteniendo la espalda en contacto con el suelo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Extender lentamente las piernas en diagonal, manteniendo la espalda en contacto con el suelo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä selkä lattiaa vasten ja venytä käsiä ja jalkoja hitaasti vastakkaisin suuntiin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendre lentement les bras et les jambes en diagonale, en gardant le dos au sol."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Étendre lentement les bras et les jambes en diagonale, en gardant le dos au sol."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું પેટને જમીનથી દૂર રાખીને, વિરુદ્ધ દિશામાં હાથ અને પગ ધીમેથી લંબાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו את הגב קרוב לקרקע, והרחיבו לאט את הגפיים בצורה אנכית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पीठ को फर्श से दूर रखते हुए, विपरीत हाथों और पैरों को धीरे-धीरे फैलाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzdržavajući leđa blizu poda, polako istegnite ruke i noge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a gerinccal a talajt, és húzza meg a lábait egyenesen, egymással szembe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga punggung tetap menempel di lantai, lalu meregangkan lengan dan kaki secara diagonal secara perlahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenendo la schiena a contatto con il pavimento, allungare lentamente le braccia e le gambe in diagonale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰を床に近づけたまま、対角の手足をゆっくり伸ばす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리가 바닥에 닿도록 하고, 대각선으로 팔다리를 천천히 뻗는다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोट जमिनीच्या दिशेने ठेवून, विरुद्ध बाजूचे हात आणि पाय हळूवारपणे सरळ करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyokong lutut dan meregangkan kaki secara perlahan dalam arah yang berlawanan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig je knieën licht en strek je armen diagonaal uit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold knærne i kontakt med gulvet mens du strekker ut armene diagonalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W pozycji leżącej, z wyprostowanymi nogami, delikatnie rozciągnij je na skos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantendo a coluna próxima ao chão, estique as pernas em diagonal lentamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantendo a coluna próxima ao chão, estique as pernas em diagonal lentamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menținând spatele aproape de podea, întindeți lent brațele și picioarele opuse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимая ноги и сохраняя расстояние между ними, медленно вытягивать руки по диагонали."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte si správne držanie tela a pomaly natiahajte ruky a nohy v protismer."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohranjajte stegno pri tleh in počasi raztegnite roke proti nasprotni strani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sträck ut armarna och benen diagonalt, långsamt och kontrollerat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதுகை தரையில் ஒட்டியபடி, எதிரெதிர் திசையில் கைகளையும் கால்களையும் மெதுவாக நீட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నుపూసను నేలకు తాకకుండా, ఒకదానికొకటి ఎదురుగా ఉన్న కాళ్లను నెమ్మదిగా చాచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืดแขนขาตามแนวทแยง โดยให้เอวสัมผัสพื้น และค่อยๆ ยืดออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli yere yaklaştırırken, çaprazda uzanarak bacaklarınızı yavaşça uzatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримаючи спину притулені до підлоги, повільно розтягувати руки та ноги по діагоналі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ lưng gần sát sàn, từ từ duỗi các chân đối diện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持膝盖靠近地面，缓慢伸展对角方向的腿部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持腰部靠近地面的位置，緩慢地伸展對應的手腳。"
          }
        }
      }
