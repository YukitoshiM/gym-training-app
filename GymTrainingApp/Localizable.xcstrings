        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs estimées sont des indications. Vous pouvez les modifier librement dans le champ ci-dessous."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આંકડો માત્ર અંદાજિત છે. તમે નીચેના ઇનપુટ ફીલ્ડમાં તેને કોઈપણ રીતે બદલી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכים המוערכים הם הערכות בלבד. ניתן לערוך אותם בחופשי במקט הראשוני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमानित मान केवल एक संदर्भ मूल्य है। आप नीचे दिए गए इनपुट फ़ील्ड में इसे स्वतंत्र रूप से संशोधित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Procjena je samo okvirna vrijednost. Možete slobodno ispravljati vrijednosti u donjem polju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értékek becslések, melyeket a megfelelő mezőkben módosíthat."
