        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai terakhir adalah kurang dari 85 dBA. Periksa juga durasi penggunaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultimo valore è inferiore a 85 dBA. Verifica anche la durata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近値は85 dBA未満です。継続時間とあわせて確認してください。"
