    "domain_catalog.08329aec4da4": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:215\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "واقعي مع شعور بالأمان. دمج التغييرات الصعبة في حياتك"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un realista amb sensació de seguretat. Incorporar canvis difícils a la teva vida"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Realistka s pocitem bezpečí, která přenášejí náročné změny do každodenního života."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En realistisk person, der føler sig tryg. Integrerer svære ændringer i hverdagen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Realistische Person mit einem Gefühl der Sicherheit. Umsetzung schwieriger Veränderungen in den Alltag"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρεαλιστική, με αίσθημα ασφάλειας. Μετατροπή δύσκολων αλλαγών στην καθημερινότητα"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A pragmatic individual who finds comfort in realistic goals, translating difficult changes into everyday life."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A pragmatic individual who finds comfort in realistic goals, translating difficult changes into everyday life."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A pragmatic individual who finds comfort in realistic goals, translating difficult changes into everyday life."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A pragmatic individual who finds comfort in realistic goals, translating difficult changes into everyday life."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Realista con sensación de seguridad. Incorporar cambios difíciles a la vida diaria"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Realista con sensación de seguridad. Incorporar cambios difíciles a la vida diaria"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytännöllinen, luotettava ihminen. Muuttaa vaikeita muutoksia osaksi arkea"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne réaliste rassurante, qui intègre des changements difficiles dans sa vie."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne réaliste rassurante, qui intègre des changements difficiles dans sa vie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સુરક્ષિત વાસ્તવિક વ્યક્તિ. મુશ્કેલ પરિવર્તનને જીવનમાં સામેલ કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישה פרקטית, מרגישה בטוח. להפוך שינויים קשים ליום יום"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक व्यावहारिक व्यक्ति, जो कठिन बदलावों को अपने जीवन में शामिल करना चाहता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Realistkinja koja se osjeća sigurno. Uključivanje teških promjena u život"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Realista szemlélet, ami biztonságot nyújt. A nehéz változásokat a mindennapokba építi be"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang realistis yang nyaman. Menerapkan perubahan sulit ke dalam kehidupan sehari-hari"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona realista che si sente sicura. Trasforma le sfide in abitudini quotidiane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安心感のある現実派。難しい変化を生活へ落とし込む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안심하는 현실주의자. 어려운 변화를 일상으로 녹이기"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तववादी दृष्टिकोन, ज्यामुळे आत्मविश्वास वाढतो. जीवनातील कठीण बदलांना सोपे बनवणे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Realist yang selesa. Mengaplikasikan perubahan yang sukar ke dalam kehidupan"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Realistische persoon die zich comfortabel voelt. Moeilijke veranderingen in het dagelijks leven integreren"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En realistisk person som gir trygghet. Integrerer vanskelige endringer i hverdagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Realistyczna osoba, która ceni stabilność. Przekształca trudne zmiany w codzienne nawyki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realista com segurança. Incorporando mudanças difíceis na vida"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Realista com segurança. Incorporando mudanças difíceis na vida"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O persoană realistă, care oferă siguranță. Integrarea schimbărilor dificile în viața de zi cu zi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прагматичный человек, который ценит стабильность. Превращение сложных изменений в повседневную жизнь"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Realistka, ktorá sa cíti bezpečne. Prevedie ťažké zmeny do každodenného života."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Realistična oseba, ki daje občutek varnosti. Uključite težko dosegljive spremembe v življenje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En realistisk person som ger trygghet. Förvandlar svåra förändringar till vardagen"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உண்மையைப் புரிந்து கொள்ளும் நபர். கடினமான மாற்றங்களை வாழ்க்கையில் செயல்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సురక్షితంగా ఉండే వాస్తవిక వ్యక్తి. కష్టమైన మార్పులను జీవితంలోకి తీసుకురావడం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนจริงที่รู้สึกมั่นใจ สามารถนำการเปลี่ยนแปลงที่ท้าทายมาปรับใช้ในชีวิตประจำวันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçekçi, güven verici biri. Zorlu değişiklikleri hayata dönüştürme"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прагматична, що дає відчуття безпеки. Перетворює складні зміни у повсякденне життя"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một người thực tế, cảm thấy an toàn. Biến những thay đổi khó khăn thành thói quen hàng ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安心的现实主义者。 将复杂的改变融入日常生活"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安心的现实主义者。 将复杂的改变融入日常生活"
          }
        }
      }
    },
    "domain_catalog.086cb45cf7dc": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:316\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قوية ودود. ربط الإنجاز بالثقة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Potent i accessible. Connecteu els assoliments amb la confiança"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Silné a přátelské. Přeměňte úspěch na sebevědomí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stærke og imødekommende. Omdannes succes til selvtillid."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraftvoll und einladend. Ermöglicht es Ihnen, Erfolge in Selbstvertrauen umzuwandeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δυνατά και φιλικά προς τον χρήστη. Μετατρέψτε την επιτυχία σε αυτοπεποίθηση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop strong and approachable muscles that lead to confidence in achieving your goals."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop strong and approachable muscles that lead to confidence in achieving your goals."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop strong and approachable muscles that lead to confidence in achieving your goals."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop strong and approachable muscles that lead to confidence in achieving your goals."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Músculos fuertes y fáciles de alcanzar. Conviértete en un atleta confiado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Músculos fuertes y fáciles de alcanzar. Conviértete en un atleta confiado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voimakas ja helposti lähestyttävä. Muuttaa saavutukset itseluottamukseksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Des muscles forts et accessibles, qui vous permettent de réussir avec confiance."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Des muscles forts et accessibles, qui vous permettent de réussir avec confiance."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મજબૂત અને આરામદાયક. સિદ્ધિને આત્મવિશ્વાસમાં ફેરવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרירים חזקים ונעימים למגע. עוזרים להפוך הצלחה לבטחון עצמי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शक्तिशाली और सहज। सफलता को आत्मविश्वास में बदलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snaga i prijateljski pristup. Pomoć u postizanju uspjeha s samopouzdanjem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erős és könnyen elérhető célok. Segít önbizalmat építeni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otot yang kuat dan mudah dilakukan. Ubah pencapaian menjadi kepercayaan diri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscoli forti e accessibili. Trasformare i risultati in fiducia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "力強く親しみやすい。達成を自信につなげる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강인하면서도 친근한 느낌을 줍니다. 성취를 자신감으로 연결합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मजबूत आणि आकर्षक स्नायू तयार करा, ज्यामुळे आत्मविश्वास वाढेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Otot yang kuat dan mudah digunakan. Hubungkan pencapaian dengan keyakinan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Krachtig en gebruiksvriendelijk. Zet je prestaties om in zelfvertrouwen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterke og vennlige muskler som gir deg selvtillit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Silne i przyjazne. Pomóż przekształcić osiągnięcia w pewność siebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortes e convidativos. Transforme a conquista em confiança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortes e convidativos. Transforme a conquista em confiança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mușchi puternici și prietenoși. Conectați realizarea cu încredere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильные и дружелюбные. Помогают превратить достижения в уверенность."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Silné a priateľské. Prepojte dosiahnuté výsledky so sebavedomím."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Močne in prijazne. Uporabite dosežke za gradnjo zaupanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraftfulla och bekväma. Förvandla framgång till självförtroende."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வலிமையான மற்றும் அணுகக்கூடிய. வெற்றியை தன்னம்பிக்கையாக மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శక్తివంతంగా మరియు సులభంగా నిర్వహించగలిగేలా ఉండాలి. విజయాలను విశ్వాసంగా మార్చుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แข็งแรงและเป็นธรรมชาติ ทำให้คุณรู้สึกมั่นใจในการบรรลุเป้าหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güçlü ve ulaşılabilir bir vücut yapısı oluşturun. Başarıyı özgüvenle birleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильні та дружні. Перетворюйте досягнення на впевненість."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sức mạnh và dễ thực hiện. Biến thành sự tự tin khi đạt được mục tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强壮且易于接近。 将成就转化为自信"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "强壮且易于接近。将成就转化为自信"
          }
        }
      }
    },
