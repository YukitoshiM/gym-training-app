        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre o sono por 3 dias e continue com exercícios 3 vezes por semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați somnul timp de 3 zile și continuați cu exercițiile de 3 ori pe săptămână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите сон в течение 3 дней и продолжайте заниматься 3 раза в неделю."
