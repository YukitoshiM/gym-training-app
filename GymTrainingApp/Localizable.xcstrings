        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "I chose from your specified goal, available equipment, and weekly exercise frequency."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I chose from your specified goal, available equipment, and weekly exercise frequency."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "I chose from your specified goal, available equipment, and weekly exercise frequency."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccioné según su objetivo, el equipo disponible y el número de entrenamientos semanales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccioné según su objetivo, el equipo disponible y el número de entrenamientos semanales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitsin tämän asetusten perusteella, määritellyn tavoitteen, käytettävissä olevat laitteet ja viikoittaisen harjoittelun määrän."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai choisi en fonction de vos objectifs, des équipements disponibles et du nombre d'entraînements par semaine."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai choisi en fonction de vos objectifs, des équipements disponibles et du nombre d'entraînements par semaine."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે ધ્યેય, ઉપલબ્ધ સાધન અને અઠવાડિયામાં કCuánt વખત કસરત કરવાનું પસંદ કર્યું છે તેના આધારે આ પસંદગી કરવામાં આવી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מתוך המטרות, הציוד הזמין ומספר האימונים בשבוע שהגדרתם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने आपके द्वारा निर्धारित उद्देश्य, उपलब्ध उपकरणों और साप्ताहिक व्यायाम की संख्या के आधार पर चयन किया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odabrali ste cilj, dostupnu opremu i broj tjednih treninga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beállítások alapján választottam: cél, elérhető eszközök, és heti edzés gyakoriság."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya memilih dari tujuan, peralatan yang tersedia, dan jumlah latihan mingguan yang telah diatur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho scelto in base agli obiettivi, all'attrezzatura disponibile e al numero di allenamenti settimanali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した目的、利用できる器具、週の運動回数から選びました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 목적, 이용 가능한 장비, 주 운동 횟수에서 선택했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही निवडलेले ध्येय, उपलब्ध उपकरणे आणि आठवड्यातील व्यायामाची संख्या यानुसार निवड केले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya memilih daripada tujuan, peralatan yang tersedia, dan jumlah latihan per minggu yang ditetapkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb gekozen op basis van uw doelen, beschikbare apparatuur en het aantal keren per week dat u wilt trainen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt fra dine mål, tilgjengelige utstyr og antall treningsøkter per uke."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierając z ustawionych celów, dostępnego sprzętu oraz liczby ćwiczeń w tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhi com base no seu objetivo, equipamento disponível e número de treinos por semana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhi com base no seu objetivo, equipamento disponível e número de treinos por semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am ales din scopul stabilit, echipamentul disponibil și numărul de sesiuni de exerciții pe săptămână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выбрали цель, доступное оборудование и количество тренировок в неделю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte z nastavených cieľov, dostupného vybavenia a počtu tréningových dní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrali ste cilj, opremo in število vaj na teden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valt baserat på dina mål, tillgängliga utrustning och antalet träningspass per vecka."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுத்த இலக்கு, பயன்படுத்தக்கூடிய உபகரணங்கள் மற்றும் வாரத்திற்கான உடற்பயிற்சி எண்ணிக்கையை அடிப்படையாகக் கொண்டு இது உருவாக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎంచుకున్న లక్ష్యం, అందుబాటులో ఉన్న పరికరాలు మరియు వారానికి వ్యాయామాల సంఖ్య ఆధారంగా ఇది సూచించబడింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกจากวัตถุประสงค์, อุปกรณ์ที่ใช้ได้ และจำนวนครั้งในการออกกำลังกายต่อสัปดาห์ที่กำหนดไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlanan amaç, kullanılabilir ekipman ve haftalık egzersiz sayısı seçildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви обрали з заданих цілей, доступного обладнання та кількості тренувань на тиждень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã chọn từ mục đích, dụng cụ có sẵn và số lần tập luyện mỗi tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我根据您设置的目的、可用的设备以及每周运动次数进行了选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我從設定的目的、可用的器材和每週運動次數中選擇了。"
          }
        }
      }
    },
