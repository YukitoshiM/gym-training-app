    "domain_catalog.108b69a035d3": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:322\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ساقيك الخلفيتين على المنصة وضع وزنك على ساقيك الأماميتين واجلس في وضع القرفصاء."
