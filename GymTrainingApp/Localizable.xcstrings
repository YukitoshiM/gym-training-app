    "health_meals_body_ai.a7c9d8a11521": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:184\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\nhu: NLLB fallback used to remove untranslated Japanese; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد انخفض متوسط وزني الأسبوعي الأخير بسرعة. هذا مرشح لزيادة الكمية الموصى بها قليلاً من أجل المضي قدمًا بطريقة معقولة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El meu pes mitjà setmanal recent ha anat disminuint ràpidament. Aquest és un candidat per augmentar una mica la ingesta recomanada per tal de procedir d'una manera raonable."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše průměrná váha za poslední týden klesá rychleji, než očekáváme. Doporučujeme mírně zvýšit doporučenou denní dávku, abyste dosáhli bezpečnějšího pokroku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gennemsnitlige vægtforbrug over den seneste uge er faldet hurtigt. For at sikre en bæredygtig fremgang, kan du overveje at øge dit kalorieindtag lidt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr durchschnittliches Wochengewicht ist schnell gesunken. Um einen unkomplizierten Fortschritt zu gewährleisten, können Sie die empfohlene Menge leicht erhöhen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέσο βάρος σας την τελευταία εβδομάδα έχει μειωθεί γρήγορα. Για να διατηρήσετε μια υγιή πρόοδο, προτείνουμε μια μικρή αύξηση στις θερμίδες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is occurring rapidly. To ensure sustainable progress, consider slightly increasing your calorie intake."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is occurring rapidly. To ensure sustainable progress, consider slightly increasing your calorie intake."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is occurring rapidly. To ensure sustainable progress, consider slightly increasing your calorie intake."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is occurring rapidly. To ensure sustainable progress, consider slightly increasing your calorie intake."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal está disminuyendo rápidamente. Para un progreso más gradual, considera aumentar ligeramente la ingesta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal está disminuyendo rápidamente. Para un progreso más gradual, considera aumentar ligeramente la ingesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisen viikon keskimääräinen paino on laskenut nopeasti. Jotta edistyminen olisi mahdollista, suositeltava annos voi olla hieman suurempi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire diminue rapidement. Pour maintenir une progression raisonnable, il pourrait être utile d'augmenter légèrement votre apport calorique."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire diminue rapidement. Pour maintenir une progression raisonnable, il pourrait être utile d'augmenter légèrement votre apport calorique."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા અઠવાડિયાનો સરેરાશ વજન ઝડપથી ઘટી રહ્યું છે. સરળ રીતે આગળ વધવા માટે, આહારની માત્રામાં થોડો વધારો કરવાની સંભાવના છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשקל הממוצע השבועי האחרון יורד במהירות. כדי להבטיח התקדמות סבירה, זה יכול להיות מועמד להגדלת ההמלצות היומיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले सप्ताह का औसत वजन तेजी से कम हो रहा है। इसे सुचारू रूप से जारी रखने के लिए, कृपया सेवन की मात्रा थोड़ी बढ़ाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša prosječna težina u posljednjoj tjedni se brzo smanjuje. Razmislite o povećanju preporučene količine hranjivih sastojaka kako biste osigurali umjeran napredak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legutóbbi hetek közepesen csökkentek a testsúlyukat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat badan rata-rata mingguan Anda menurun dengan cepat. Untuk menjaga kemajuan yang berkelanjutan, pertimbangkan untuk meningkatkan asupan kalori sedikit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo peso medio settimanale è in rapida diminuzione. Per un progresso sostenibile, potresti voler aumentare leggermente l'apporto calorico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近の週平均体重が速めに下がっています。無理のない進み方にするため、摂取目安を少し増やす候補です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 주 평균 체중이 빠르게 감소하고 있습니다. 무리하지 않은 진행을 위해 섭취 권장량을 조금 늘리는 후보입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील आठवड्यातील सरासरी वजन वेगाने कमी होत आहे. यामुळे, आहारात थोडी वाढ करून योग्य दिशेने प्रगती करावी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Purata berat mingguan anda menurun dengan cepat. Untuk memastikan kemajuan yang sihat, mungkin perlu meningkatkan jumlah pengambilan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw gemiddelde gewicht over de afgelopen week is snel gedaald. Om een gezonde progressie te behouden, kan het nuttig zijn om uw calorie-inname iets te verhogen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gjennomsnittlige vekt har gått ned raskt den siste uken. For å opprettholde en sunn fremgang, vurder å øke anbefalt inntak litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnia waga w ostatnim tygodniu jest znacznie niższa. Sugeruje to zwiększenie zalecanej ilości spożycia, aby zapewnić komfortowy postęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal está diminuindo rapidamente. Para um progresso sem esforço, considere aumentar ligeiramente a ingestão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal está diminuindo rapidamente. Para um progresso sem esforço, considere aumentar ligeiramente a ingestão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În ultima săptămână, greutatea medie a scăzut rapid. Pentru a asigura un progres sănătos, puteți lua în considerare creșterea ușoară a aportului caloric."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш средний вес за последнюю неделю снижается слишком быстро. Чтобы избежать перегрузок, можно немного увеличить рекомендуемое количество калорий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša priemerná hmotnosť za poslednú týždeň klesla rýchlo. Aby ste dosiahli realistický pokrok, zvážte mierne zvýšenie odporúčanej dávky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša povprečna telesna teža zadnjih tednikov se hitro zmanjšuje. Za bolj udoben napredek, poskusite povečati priporočen dnevni odmerek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har tappat i genomsnittsvikt snabbare än förväntat. För att undvika överträning, kan det vara bra att öka ditt kaloriintag något."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்திய வார சராசரி எடை வேகமாக குறைந்துள்ளது. பாதுகாப்பான முன்னேற்றத்திற்கு, உட்கொள்ளும் அளவை சற்று அதிகரிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత వారపు సగటు బరువు వేగంగా తగ్గుతోంది. సులభమైన మార్గంలో కొనసాగడానికి, తీసుకోవలసిన మోతాదును కొద్దిగా పెంచడం మంచిది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักเฉลี่ยรายสัปดาห์ของคุณลดลงอย่างรวดเร็ว ซึ่งเป็นไปเพื่อการพัฒนาที่เหมาะสม ดังนั้นจึงเป็นตัวเลือกในการเพิ่มปริมาณที่แนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son haftanın ortalama ağırlığında hızlı bir düşüş var. Zorlanmadan ilerlemek için, alım miktarını biraz artırmayı düşünebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середня вага за останній тиждень зменшується досить швидко. Щоб забезпечити комфортний прогрес, рекомендується трохи збільшити рекомендоване споживання калорій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trọng lượng trung bình hàng tuần đang giảm nhanh chóng. Để duy trì sự tiến bộ hợp lý, đây là một lựa chọn để tăng lượng calo tiêu thụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一周的平均体重迅速下降。为了实现无压力进展，建议稍微增加摄入量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一週的平均體重快速下降。為了確保安全進展，建議稍微增加攝取量。"
          }
        }
      }
    },
