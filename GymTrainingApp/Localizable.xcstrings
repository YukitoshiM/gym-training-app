    "health_meals_body_ai.1d91da8d5c82": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:579\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا سجل للتعرض العالي. يرجى مراعاة الابتعاد عن مصدر الصوت وخفض مستوى الصوت واستخدام وسائل حماية السمع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest és un rècord d'alta exposició. Penseu en allunyar-vos de la font del so, baixar el volum i utilitzar protecció auditiva."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je záznam o vysokém vystavení. Použijte ho jako argument pro odloučení od zdroje zvuku, snížení hlasitosti nebo použití ochranných pomůcek pro sluch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en registrering af høj eksponering. Brug dette som grundlag for at trække dig væk fra lydkilden, reducere volumen eller bruge høreværn."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine Aufzeichnung hoher Belastung. Nutzen Sie dies als Grundlage für Entscheidungen wie das Verlassen der Quelle, Reduzieren der Lautstärke oder Verwenden von Gehörschutz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι καταγραφή υψηλού επιπέδου έκθεσης. Χρησιμοποιήστε την ως ένδειξη για να απομακρυνθείτε από την πηγή ήχου, να μειώσετε τον όγκο ή να χρησιμοποιήσετε προστατευτικό εξοπλισμό ακουστικής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates a high level of exposure. Consider moving away from the sound source, reducing the volume, or using hearing protection as appropriate."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates a high level of exposure. Consider moving away from the sound source, reducing the volume, or using hearing protection as appropriate."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates a high level of exposure. Consider moving away from the sound source, reducing the volume, or using hearing protection as appropriate."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates a high level of exposure. Consider moving away from the sound source, reducing the volume, or using hearing protection as appropriate."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un registro de exposición elevada. Utilícelo como criterio para alejarse de la fuente de sonido, reducir el volumen o usar protección auditiva."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un registro de exposición elevada. Utilícelo como criterio para alejarse de la fuente de sonido, reducir el volumen o usar protección auditiva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on korkean altistuksen merkki. Harkitse äänen poistamista, äänen voimakkuuden pienentämistä tai kuulonsuojaimien käyttöä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une mesure d'exposition élevée. Utilisez-la comme base pour décider de vous éloigner de la source sonore, de réduire le volume ou d'utiliser une protection auditive."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est une mesure d'exposition élevée. Utilisez-la comme base pour décider de vous éloigner de la source sonore, de réduire le volume ou d'utiliser une protection auditive."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઉચ્ચ સ્તરના સંપર્કમાં આવવાની રેકોર્ડ છે. અવાજના સ્ત્રોતથી દૂર રહેવું, વોલ્યુમ ઘટાડવું અથવા સાંભળવાની સુરક્ષા માટેનાં ઉપકરણોનો ઉપયોગ કરવાનું વિચારો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהו רישום של חשיפה גבוהה. השתמשו במידע זה כדי להחליט: להתרחק ממקור הקול, להנמיך את עוצמת הקול, או להשתמש באמצעי הגנה לשמיעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उच्च जोखिम का रिकॉर्ड है। ध्वनि स्रोत से दूर रहें, ध्वनि को कम करें, या श्रवण सुरक्षा उपकरणों का उपयोग करने पर विचार करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je zapis o visokom izloženosti. Razmislite o tome da se udaljite od izvora zvuka, smanjite glasnoću ili koristite zaštitne slušalice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy magas expozíciót jelez. Fontos, hogy elváljon a zajforrástól, csökkentse a hangerőt, és használjon hallójárati védelemre szolgáló eszközt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah catatan paparan yang tinggi. Gunakan sebagai bahan pertimbangan untuk menjauhkan diri dari sumber suara, menurunkan volume, atau menggunakan pelindung pendengaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indica un'elevata esposizione. Considera di allontanarti dalla fonte sonora, ridurre il volume o utilizzare dispositivi di protezione acustica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高い曝露の記録です。音源から離れる、音量を下げる、聴覚保護具を使う判断材料にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 노출 기록입니다. 소스에서 멀어지거나, 음량을 줄이거나, 청각 보호 장비를 사용하는 것을 고려해 주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अतिexposure चा नोंदी आहे. आवाज कमी करण्यासाठी, आवाज कमी करणे, किंवा श्रवण संरक्षण उपकरणांचा वापर करण्याचा विचार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah rekod pendedahan yang tinggi. Gunakan maklumat ini untuk memutuskan sama ada untuk menjauhi sumber bunyi, menurunkan volume, atau menggunakan alat perlindungan pendengaran."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een registratie van een hoge blootstelling. Gebruik dit als argument om weg te gaan van de bron, het volume te verlagen of beschermende hoorapparaten te gebruiken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en registrering av høy eksponering. Bruk dette som grunnlag for å flytte deg bort fra lydkilden, redusere volumet eller bruke beskyttelsesutstyr."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest zapis dotyczący wysokiego narażenia. Rozważ usunięcie się z źródła dźwięku, zmniejszenie głośności lub użycie środków ochrony słuchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um registro de exposição elevada. Use-o como base para decidir se afastar-se da fonte sonora, diminuir o volume ou usar proteção auditiva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um registro de exposição elevada. Use-o como base para decidir se afastar-se da fonte sonora, diminuir o volume ou usar proteção auditiva."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este un înregistrare a expunerii la zgomot. Luați în considerare distanțarea de sursa de zgomot, reducerea volumului și utilizarea protecțiilor auditive ca factori de decizie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это запись о высоком уровне воздействия. Используйте эту информацию для принятия решения: отойти от источника звука, уменьшить громкость или использовать средства защиты слуха."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je záznam o vysokom vystavení. Použite to ako argument pre rozhodnutie, či sa vzdalíte od zdroja zvuku, znížte hlasitosť alebo použite ochranu sluchu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je zabeleženo kot visok nivo izpostavljenosti. Upoštevajte, da se morate odmakniti od virov zvoka, zmanjšati glasnost ali uporabiti zaščito sluha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är en notering om hög exponering. Använd detta som underlag för att flytta dig bort från ljudkällan, sänka volymen eller använda hörselskydd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகமான வெளிப்பாட்டின் பதிவுகள். ஒலி மூலத்திலிருந்து விலகி இருப்பது, ஒலியின் அளவைக் குறைப்பது, மற்றும் கேட்கும் பாதுகாப்பு உபகரணங்களைப் பயன்படுத்துவது போன்ற முடிவுகளை எடுக்க இது உதவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అధిక స్థాయికి గురయ్యే రికార్డు ఇది. ధ్వని మూలం నుండి దూరంగా ఉండటం, వాల్యూమ్‌ను తగ్గించడం మరియు వినికిడి పరికరాలను ఉపయోగించడం వంటి నిర్ణయాలకు సహాయపడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการสัมผัสกับเสียงที่สูง ควรใช้เป็นข้อมูลในการตัดสินใจ เช่น การหลีกเลี่ยงแหล่งกำเนิดเสียง ลดระดับเสียง หรือใช้อุปกรณ์ป้องกันการได้ยิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek maruz kalma durumunu kaydetti. Ses kaynağına yaklaşmamak, sesi azaltmak veya kulak koruyucu kullanmak gibi kararlar için bu bilgiyi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це запис про високий рівень впливу. Використовуйте цю інформацію для прийняття рішення: віддалятися від джерела звуку, зменшити гучність або використовувати засоби захисту слуху."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là nhật ký về mức độ tiếp xúc cao. Hãy sử dụng âm thanh để đánh giá việc rời xa nguồn âm, giảm âm lượng hoặc sử dụng thiết bị bảo vệ thính giác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一种高暴露记录。请根据音源的距离、音量降低或使用听力保护措施等判断材料来决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是高曝露的紀錄。請根據音源距離、音量降低、使用聽覺保護具等作為判斷依據。"
          }
        }
      }
    },
