            "value": "חיבור ה-Apple Watch מושהה זמנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch कनेक्शन अस्थायी रूप से बंद है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veza s Apple Watchom je privremeno prekinuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Watch-hoz való kapcsolat ideiglenesen megszakadt."
