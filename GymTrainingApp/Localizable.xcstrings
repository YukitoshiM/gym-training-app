            "value": "Пряма м'яз живота"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơ bụng ngang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腹斜肌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腹斜肌"
          }
        }
      }
    },
    "domain_catalog.5bca283426f5": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:370\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "استلق على ظهرك مع وضع باطن قدميك على الأرض وارفع وركيك أثناء شد الأرداف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estireu d'esquena amb les plantes dels peus a terra i aixequeu els malucs mentre estrenyu les natges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehněte si na záda, položte chodidla na zem a zvedejte boky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg dig på ryggen med fødderne på gulvet og løft hofterne, mens du spænder i balderne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rücken liegen, Füße auf dem Boden und Hüfte dabei leicht anspannen, um die Wirbelsäule zu unterstützen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξαπλώστε και στηρίξτε τα πόδια στο πάτωμα, ενώυτό κρατάτε τη μέση ψηλά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back with your feet flat on the floor, and lift your torso while tightening your hips."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back with your feet flat on the floor, and lift your torso while tightening your hips."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back with your feet flat on the floor, and lift your torso while tightening your hips."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on your back with your feet flat on the floor, and lift your torso while tightening your hips."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado boca arriba, con los pies apoyados en el suelo y elevando la cadera mientras mantienes la tensión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Acostado boca arriba, con los pies apoyados en el suelo y elevando la cadera mientras mantienes la tensión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Makaa selälläsi ja aseta jalkasi lattialle, samalla kun nostat alaselkääsi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, en appuyant les pieds au sol et en contractant les fessiers tout en soulevant le bas du dos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Allongé sur le dos, en appuyant les pieds au sol et en contractant les fessiers tout en soulevant le bas du dos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તummy પર સૂઈ જાઓ અને પગને ફ્લોર પર મૂકો, જ્યારે હિપ્સને સંકોચતા રાખીને પીઠ ઉપર ઉઠાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להישכב על הגב, למתוח את כפות הרגליים על הרצפה ולעשות תנועת הרמת מרפקים תוך שמירה על גוף מותח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेट के बल लेटें और पैरों को फर्श पर टिकाएं, जबकि कूल्हे को संकुचित करते हुए कमर को ऊपर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ležite na leđima, noge su na podu, a glavu podižete dok ste u položaju \"sjed\"."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejből, lábujjakkal a talajon, és a derékot emeld fel, miközben a hátadra nyomást gyakorolsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbaring telentang dengan menempelkan tumit ke lantai, lalu mengangkat pinggang sambil menarik pinggul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdraiarsi a pancia in giù, appoggiando i piedi a terra e sollevando il busto mantenendo la schiena tesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仰向けで足裏を床につけ、臀部を締めながら腰を持ち上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엎드려 발바닥을 바닥에 대고 엉덩이를 모으면서 허리를 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठीवर झोपून पायांना जमिनीवर सपाट ठेवा, कंबर वर उचलताना नितंबांवर दाब द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbaring, letakkan telapak kaki di lantai, angkat punggung sambil menegangkan pinggul."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Lig op je rug, met je voeten plat op de grond en je heupen licht naar buiten. Til je bovenlichaam op terwijl je je heupen vasthoudt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligg på ryggen med føttene i gulvet og løft hoftene mens du spenner magemusklene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połóż się na plecach, upewniając się, że stopy są w kontakcie z podłożem i delikatnie napinaj pośladki, jednocześnie unosząc tułów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se de bruços, apoiando os pés no chão e elevando a região lombar enquanto mantém a postura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se de bruços, apoiando os pés no chão e elevando a região lombar enquanto mantém a postura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așezați-vă întins pe spate, cu picioarele pe podea și sprijiniți-vă șoldurile, ridicând ușor trunchiul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лягте на спину, опираясь стопами о пол и поднимая таз, напрягая мышцы ягодиц."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ležte na chrbte, nohy pri zemi a zdvihnite si pás, pričom stlačte boky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ležite na hrbtu, položite stopala na tla in dvignite ramo, medtem ko ste napeti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligg på rygg med fötterna mot golvet, lyft höfterna samtidigt som du spänner magmusklerna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரையில் படுத்து, உங்கள் பாதங்களை தரையில் வைத்து, இடுப்பை இறுக்கி, உங்கள் முதுகை உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెల్లకిలా పడుకుని, పాదాలను నేలపై ఉంచి, నడుమును పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นอนหงาย โดยให้เท้าสัมผัสพื้น และยกสะโพกขึ้นพร้อมกับการกระชับกล้ามเนื้อบริเวณฝ่าเท้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatar pozisyonda ayak tabanlarınızı yere basın, kalçalarınızı sıkın ve sırtınızı yukarı kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ляжте на живіт, поставте стопи на підлогу та піднімайте таз, стискаючи сідниці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nằm thẳng, đặt bàn chân xuống sàn, nâng người lên bằng cách siết chặt hông."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仰卧，将脚底放在地面上，同时收紧臀部并抬起腰部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仰臥，將腳底放在地面上，同時收緊臀部並抬起腰部。"
          }
        }
      }
    },
