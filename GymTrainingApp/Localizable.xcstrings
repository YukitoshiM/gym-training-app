    "release_delta.evidence_unavailable": {
      "comment": "GymTrainingApp/Features/Plans/AIPlanCoachView.swift\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نظرًا لعدم إمكانية التحقق من الأدلة العلمية، فإن التوصيات تعتمد على السجل والمبادئ العامة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tant, es proposen basant-se en els registres i principis generals, ja que no es pot verificar l'evidència científica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvůli nedostatku vědeckých důkazů, doporučujeme na základě obecných principů a záznamů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da det ikke er muligt at verificere den videnskabelige evidens, baseres anbefalingerne på registrerede data og generelle principper."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgrund fehlender wissenschaftlicher Grundlage werden Aufzeichnungen und allgemeine Prinzipien verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λόγω αδυναμίας επαλήθευσης των επιστημονικών στοιχείων, προτείνουμε με βάση τις καταγεγραμμένες πληροφορίες και γενικές αρχές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to the inability to verify scientific evidence, suggestions are based on recordings and general principles."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to the inability to verify scientific evidence, suggestions are based on recordings and general principles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to the inability to verify scientific evidence, recommendations are based on records and general principles."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to the inability to verify scientific evidence, suggestions are based on recordings and general principles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Debido a que no es posible verificar la evidencia científica, se proponen recomendaciones basadas en los registros y principios generales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Debido a que no es posible verificar la evidencia científica, se proponen recomendaciones basadas en el registro y los principios generales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieteellistä näyttöä ei ole saatavilla, joten pohditaan yleisiä periaatteita."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En raison d'un manque de preuves scientifiques, les suggestions sont basées sur les enregistrements et les principes généraux."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En raison de l'impossibilité de vérifier les preuves scientifiques, la proposition est basée sur les enregistrements et les principes généraux."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈજ્ઞાનિક પુરાવા મેળવી શકાતા નથી, તેથી રેકોર્ડિંગ અને સામાન્ય સિદ્ધાંતો પર આધારિત દરખાસ્ત આપવામાં આવી છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לאמת את הראיות, ההערכה מבוססת על כללים כלליים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैज्ञानिक प्रमाण की जांच नहीं की जा सकी, इसलिए रिकॉर्डिंग और सामान्य सिद्धांतों पर आधारित सुझाव दिया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbog nedostatka mogućnosti provjere, preporučujemo na temelju zapisa i općih principa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem áll rendelkezésre tudományos bizonyíték, ezért a rekord és az általános elvek alapján javasolunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena tidak dapat memverifikasi bukti ilmiah, saran didasarkan pada catatan dan prinsip umum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A causa dell'impossibilità di verificare le basi scientifiche, si basa su registrazioni e principi generali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科学的根拠を確認できないため、記録と一般原則を中心に提案しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과학적 근거를 확인할 수 없으므로, 기록 및 일반 원칙을 중심으로 제안합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वैज्ञानिक पुरावे उपलब्ध नाहीत, त्यामुळे नोंदी आणि सामान्य नियमांनुसार मार्गदर्शन केले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengesahkan bukti saintifik, jadi ia adalah cadangan berdasarkan catatan dan prinsip umum."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat er geen wetenschappelijke bewijzen beschikbaar zijn, is dit gebaseerd op de gegevens en algemene principes."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Siden det ikke er mulig å verifisere vitenskapelige bevis, baserer vi oss på registrerte data og generelle prinsipper."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze względu na brak dostępu do danych, proponowane wartości opierają się na ogólnych zasadach i zapisanych informacjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Devido à impossibilidade de verificar as evidências científicas, a sugestão é baseada em registros e princípios gerais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Devido à impossibilidade de verificar as evidências científicas, a sugestão é baseada nos registos e princípios gerais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din cauza imposibilității de a verifica, se recomandă pe baza înregistrărilor și a principiilor generale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно проверить научные доказательства, поэтому предлагается на основе записей и общих принципов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvôli nedostatku vedeckých dôkazov, ponúkame návrhy založené na zázname a všeobecných princípoch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker ni na voljo znanstvenih podatkov, se posnujemo z zapiski in splošnimi načeli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftersom det är omöjligt att verifiera vetenskapliga bevis, baseras rekommendationen på en sammanfattning och allmänna principer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவியல் சான்றுகளைச் சரிபார்க்க முடியவில்லை, எனவே பதிவுகள் மற்றும் பொதுவான கொள்கைகளை அடிப்படையாகக் கொண்டு பரிந்துரைக்கிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాస్త్రీయ ఆధారాలను పొందలేము, కాబట్టి రికార్డు మరియు సాధారణ సూత్రాలపై ఆధారపడి సూచనలు ఇస్తున్నాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจากไม่สามารถตรวจสอบหลักฐานทางวิทยาศาสตร์ได้ จึงแนะนำโดยอิงจากข้อมูลและหลักการทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilimsel kanıtları kontrol edemiyoruz, bu nedenle kayıt ve genel prensiplere göre öneriler sunuyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оскільки неможливо перевірити наукові докази, пропонується на основі записів та загальних принципів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh bằng chứng khoa học, do đó đề xuất dựa trên ghi chép và nguyên tắc chung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认科学依据，因此主要基于记录和一般原则进行建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認科學證據，因此以記錄和一般原則為基礎的建議。"
          }
        }
      }
    },
    "release_delta.insufficient_direct_evidence": {
      "comment": "GymTrainingApp/Features/Home/OmakaseHomeView.swift\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نظرًا لعدم وجود أدلة مباشرة، فإن هذا هو مجرد دليل إرشادي يعتمد على تسجيل الاتجاهات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tant, és una indicació basada en la tendència dels registres, ja que hi ha prou evidència directa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvůli nedostatku přímých důkazů, je to pouze orientační doporučení založené na trendech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da der ikke er tilstrækkelig direkte evidens, er dette en vejledende vurdering baseret på tendenser."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte Beweise sind begrenzt. Es handelt sich um eine Richtlinie basierend auf der Aufzeichnungstendenz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λόγω έλλειψης άμεσων στοιχείων, παρέχουμε μια εκτίμηση με βάση τις τάσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to insufficient direct evidence, this is a guideline based on recording trends."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to insufficient direct evidence, this is a guideline based on recording trends."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to a lack of directly usable evidence, this is an approximate guideline based on recorded trends."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to insufficient direct evidence, this is a guideline based on recording trends."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Debido a la falta de evidencia directa, se prioriza una guía basada en las tendencias registradas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Debido a la falta de evidencia directa, se prioriza una guía basada en las tendencias registradas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suoraa näyttöä on vähän, joten käytetään yleistä ohjeistusta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En raison d'un manque de preuves directes, il s'agit d'une indication basée sur les tendances enregistrées."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En raison d'un manque de preuves directes, il s'agit d'une indication basée sur les tendances enregistrées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સીધી રીતે ઉપયોગ કરી શકાય તેવા પુરાવાની અછતને કારણે, આ રેકોર્ડિંગના વલણને ધ્યાનમાં રાખીને માર્ગદર્શન આપવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין ראיות ישירות מספיקות, ההערכה מבוססת על מגמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे उपयोग करने योग्य प्रमाण अपर्याप्त हैं, इसलिए रिकॉर्डिंग के रुझानों पर आधारित एक दिशानिर्देश प्रदान किया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbog nedostatka direktnih podataka, ovo je samo smjernica na temelju trendova."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem elegendő közvetlen bizonyíték, ezért a rekordot preferáljuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena bukti langsung tidak mencukupi, ini adalah perkiraan berdasarkan tren catatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A causa della mancanza di prove dirette, si basa su tendenze registrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接使える根拠が不足しているため、記録傾向を優先した目安です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 사용할 수 있는 근거가 부족하므로, 기록 경향을 우선한 참고 자료입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्यक्ष उपयोगी पुरावा उपलब्ध नाही, त्यामुळे नोंदीनुसार अंदाजित मूल्य वापरले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada bukti langsung yang mencukupi, jadi ia adalah anggaran berdasarkan tren."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat er geen directe bewijsstukken beschikbaar zijn, is dit een richtlijn gebaseerd op de trend van de gegevens."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Siden det ikke finnes direkte bevis, er dette en omtrentlig veiledning basert på registrerte trender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze względu na brak bezpośrednich dowodów, wartość jest jedynie przybliżoną wskazówką opartą na trendach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Devido à falta de evidências diretas, a sugestão é baseada nas tendências registradas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Devido à falta de evidência direta, é uma estimativa baseada nas tendências registadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din cauza lipsei de dovezi directe, se folosește ca ghid, bazat pe tendințele înregistrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно прямых доказательств, поэтому используется ориентир на основе тенденций."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvôli nedostatku priamych dôkazov, poskytujeme len orientačné údaje založené na trendoch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker ni na voljo neposrednih podatkov, je to vodilo glede na trende."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftersom det saknas direkt bevis, är detta en uppskattning baserad på trendanalys."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரடியாகப் பயன்படுத்தக்கூடிய சான்றுகள் குறைவாக இருப்பதால், பதிவுகளை அடிப்படையாகக் கொண்டு ஒரு பொதுவான வழிகாட்டியாக வழங்குகிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రత్యక్షంగా ఉపయోగించగల ఆధారాలు లేవు, కాబట్టి ట్రెండ్‌లను పరిగణనలోకి తీసుకుంటాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจากหลักฐานโดยตรงไม่เพียงพอ จึงเป็นเพียงแนวทาง โดยพิจารณาจากการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan kullanılabilecek kanıtlar yetersizdir, bu nedenle kayıt eğilimlerine göre bir kılavuz olarak kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оскільки немає прямих доказів, використовується орієнтовне значення на основі записів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đủ bằng chứng trực tiếp, do đó đây là chỉ dẫn dựa trên xu hướng ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺乏直接可用的证据，因此优先参考记录趋势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺乏直接可用的證據，因此以記錄趨勢為基礎的參考。"
          }
        }
      }
    },
