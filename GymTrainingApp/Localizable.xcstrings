    "domain_catalog.2c82919f0aad": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:309\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ظهرك على الوسادة وتحرك لأعلى ولأسفل، مع إبقاء ركبتيك في نفس الاتجاه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Col·loca l'esquena al coixinet i mou-te cap amunt i cap avall, mantenint els genolls en la mateixa direcció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zad umístěte na podložku a pohybujte se nahoru a dolů, udržujte správné držení těla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg et polstring på ryggen og hold knæene i en lige position, mens du bevæger dig op og ned."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Rücken auf einer Polsterfläche positionieren und die Knie in der gewünschten Position halten, während man sich auf- und ab bewegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετήστε ένα μαξιλαράκι στην πλάτη σας, διατηρώντας τη σωστή στάση και κινείτε το πάνω-κάτω."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a pad on your back, keep your knees aligned, and move up and down."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a pad on your back, keep your knees aligned, and move up and down."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a pad on your back, keep your knees aligned, and move up and down."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a pad on your back, keep your knees aligned, and move up and down."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un cojín en la espalda, mantén las rodillas juntas y muévete hacia arriba y abajo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un cojín en la espalda, mantén las rodillas juntas y muévete hacia arriba y abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä selkää padilla ja pidä polvet suorina, kun liikut ylös ja alas."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur votre dos pour maintenir la position, puis montez et descendez."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur votre dos pour maintenir la position, puis montez et descendez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મા espaldaને પેડ પર મૂકો, ઘૂંટણને સીધું રાખો અને ઉપર-નીચે કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להניח משענת לגב, לשמור על כיוון הברכיים ולנוע מעלה ומטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पीठ को पैड पर रखें, घुटनों को सीधा रखें और ऊपर-नीचे करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite se za oslonac, održavajte položaj koljena i podižite se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hátat egy párnára helyezve, a térdelést megtartva, fel- és lefelezzen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan bantalan di punggung, jaga posisi lutut, dan lakukan gerakan naik turun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggiare la schiena su un cuscino, mantenendo le ginocchia allineate e muovendosi su e giù."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背中をパッドにつけ、膝の向きを保って上下する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등을 패드에 대고, 무릎을 모으면서 상하 운동합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठीला पॅडवर ठेवा, गुडघे एका बाजूला ठेवा आणि वर-खाली करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan bantal di belakang, pertahankan posisi lutut dan bergerak ke atas dan bawah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg ondersteuning gebruiken en de knieën in een rechte positie houden, terwijl je omhoog en omlaag beweegt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasser en pute under ryggen og hold knærne i riktig posisjon mens du beveger deg opp og ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj prawidłową postawę pleców, upewniając się, że kolana są zgięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um apoio nas costas, mantenha as pernas retas e faça movimentos para cima e para baixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque um apoio nas costas, mantenha as pernas retas e faça movimentos para cima e para baixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşezați-vă spatele pe o suprafață, menținând poziția genunchilor și mișcându-vă în sus și în jos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прижмитесь к упору, сохраняя положение коленей и двигайтесь вверх-вниз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zad uložte na podložku a udržujte správnu polohu kolien pri pohybe nahor a doľava."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite blazinico za hrbet,držite kolena v položaju in se gibajte navzgor in navoz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg ett stöd under ryggen och håll knäna i position samtidigt som du böjer och sträcker dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின் பகுதியை பேட்-இல் வைத்து, முழங்கால்களை நேராக வைத்து மேலேவும் கீழேவும் நகர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నును ప్యాడ్‌పై ఉంచి, మోకాళ్లను ఒకే దిశలో ఉంచి పైకి క్రిందికి కదలండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางแผ่นรองที่หลัง, รักษาท่าขาตรง และเคลื่อนขึ้นลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkanı, dizlerini bükerek ve yukarı aşağı hareket ederek bir yastığa yerleştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покладіть спину на підкладку, тримайте коліна зігнутими та рухайтеся вгору-вниз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt miếng đệm vào lưng, giữ tư thế đầu gối và thực hiện động tác nâng hạ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将背部靠在垫子上，保持膝盖位置，上下运动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將背部靠在墊子上，並保持膝蓋位置"
          }
        }
      }
    },
