        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்று, உடற்பயிற்சியின் இடைவெளியை எடுத்து, பாதுகாப்பான செயல்பாட்டு அளவை முன்னுரிமைப்படுத்துங்கள்."
