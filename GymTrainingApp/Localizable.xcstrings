            "value": "Spojte zlepšenie vzhľadu s cvičením hlavných cvikov"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite skupno povečanje zunanjega videza in glavnih vaj"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öka både utseendet och vikten för de viktigaste övningarna tillsammans"
