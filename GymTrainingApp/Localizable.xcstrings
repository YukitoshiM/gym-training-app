        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe anhand Ihrer Ziele, verfügbaren Geräte und der Anzahl der Trainings pro Woche ausgewählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξαμε από τους στόχους, τον εξοπλισμό που μπορείτε να χρησιμοποιήσετε και τον αριθμό των προπονήσεων την εβδομάδα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "I chose from your specified goal, available equipment, and weekly exercise frequency."
