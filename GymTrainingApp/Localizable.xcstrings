        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě záznamů, identifikujte nejúčinnější techniku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug dine noter til at identificere den mest effektive teknik."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie sich anhand der Aufzeichnungen klarstellen, welche Übung am effektivsten ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από τα αρχεία, καθορίστε το πιο αποτελεσματικό στυλ."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "From the records, let's clearly identify the most effective technique."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "From the records, let's clearly identify the most effective technique."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "From the records, let's clearly identify the most effective technique."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "From the records, let's clearly identify the most effective technique."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir del registro, identifica claramente cuál es la técnica más efectiva."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir del registro, identifica claramente cuál es la técnica más efectiva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista, mitkä harjoitukset ovat tällä hetkellä tehokkaimpia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir des enregistrements, identifiez clairement la meilleure technique."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir des enregistrements, identifiez clairement la meilleure technique."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેકોર્ડ્સના આધારે, અત્યારે સૌથી વધુ અસરકારક કસરતને સ્પષ્ટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מההרשמות, הגדירו בצורה ברורה את התרגיל היעיל ביותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड से, अब तक के सबसे प्रभावी व्यायाम को स्पष्ट रूप से पहचानें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Iz podataka, jasno odredite najučinkovitiju tehniku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rekordok alapján határozd meg, melyik mozdulat az eddig a leghatékonyabb."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari catatan, tentukan gerakan yang paling efektif saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza i risultati per identificare la mossa più efficace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録から、今いちばん効果的な一手をはっきりさせましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 통해 현재 가장 효과적인 동작을 명확히 하세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंदीनुसार, सर्वात प्रभावी व्यायाम कोणता आहे हे स्पष्टपणे ठरवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari rekod, ketahui tangan yang paling berkesan sekarang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyseer op basis van je records welke oefening het meest effectief is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra loggene, finn ut hvilken øvelse som er mest effektiv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie zapisów, ustalmy najskuteczniejszą technikę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos registros, identifique a modalidade mais eficaz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos registros, identifique a modalidade mais eficaz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizează rezultatele pentru a identifica cea mai eficientă tehnică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из записей, определите наиболее эффективную технику."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe záznamov, jasne identifikujte najefektívnejšiu techniku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi zapisanih podatkov, jasno določite najučinkovitejši pristop."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från dina resultat, identifiera den mest effektiva tekniken."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவுகளிலிருந்து, தற்போது மிகவும் பயனுள்ள பயிற்சியை தெளிவாகக் கண்டறியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డుల నుండి, ప్రస్తుతం అత్యంత ప్రభావవంతమైన వ్యాయామం ఏమిటో స్పష్టంగా తెలుసుకోండి."
