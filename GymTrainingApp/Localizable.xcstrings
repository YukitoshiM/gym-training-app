    "health_meals_body_ai.bc649c604570": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift:165\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإنشاء تعليقات أسبوعية من مؤشرات الأداء الرئيسية لجسمك، والوجبات، وصور الجسم، وتاريخ تدريب العضلات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Creeu comentaris setmanals amb els KPI del vostre cos, els àpats, les fotos corporals i l'historial d'entrenament muscular."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě fyzických ukazatelů, jídelníčku, fotografií a historie cvičení vytvářím týdenní komentáře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret ugentlige kommentarer baseret på kropsmålinger, kost og billeder af din krop samt træningshistorik."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie wöchentliche Kommentare basierend auf Körper-KPIs, Ernährung und Fotos Ihres Körpers sowie Ihrem Trainingsverlauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε εβδομαδιαίες αναλύσεις με βάση τα βιομετρικά στοιχεία, τη διατροφή και τις φωτογραφίες του σώματος, καθώς και το ιστορικό σας προπονήσεων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Create weekly comments based on Body KPIs, diet, body photos, and workout history."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Create weekly comments based on Body KPIs, diet, body photos, and workout history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Create weekly comments based on Body KPIs, diet, body photos, and workout history."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Create weekly comments based on Body KPIs, diet, body photos, and workout history."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree comentarios semanales basándose en sus KPIs corporales, dieta y fotos de su físico, e historial de entrenamiento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree comentarios semanales basándose en sus KPIs corporales, dieta y fotos de su físico, e historial de entrenamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo viikoittaisia kommentteja fyysisistä mittareista, ruokavaliosta ja kehonkuvasta sekä treenihistoriasta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un commentaire hebdomadaire à partir de vos KPI corporels, de votre alimentation et de vos photos de silhouette ainsi que de votre historique d'entraînement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un commentaire hebdomadaire à partir de vos KPI corporels, de votre alimentation et de vos photos de silhouette ainsi que de votre historique d'entraînement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શારીરિક KPI, આહાર, શરીરના ચિત્રો અને વર્કઆઉટ હિસ્ટ્રી પરથી અઠવાડિક ટિપ્સ બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור תגובות שבועיות על סמך מדדי הגוף, תזונה ותמונות גוף, ויומן אימוני כוח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शारीरिक KPI, भोजन, शरीर का आकार की तस्वीरें और व्यायाम इतिहास से साप्ताहिक टिप्पणी तैयार करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreirajte tjedno izvješće na temelju KPI-ja za tijelo, prehrane i fotografija tijela, te povijesti treninga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A testbeli mutatók, az étkezési adatok és a testformájának fényképei alapján készítünk heti összefoglalót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat komentar mingguan berdasarkan KPI tubuh, pola makan, foto bentuk tubuh, dan riwayat latihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creare commenti settimanali basati su indicatori fisici, alimentazione e foto del corpo, cronologia degli allenamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身体KPI、食事、体型写真、筋トレ履歴から週次コメントを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신체 KPI, 식단, 체형 사진, 근력 운동 기록을 바탕으로 주간 코멘트를 작성합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शारीरिक मापदंड, आहार, आणि शारीरिक तज्ञांच्या छायाचित्रांवरून साप्ताहिक टिप्पणी तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat komen mingguan berdasarkan KPI badan, pemakanan, foto bentuk, dan sejarah latihan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak wekelijks een commentaar op basis van je lichaamsmetingen, voeding en foto's."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag ukentlige kommentarer basert på fysiske KPIer, kosthold og bilder av kropp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz tygodniowe komentarze na podstawie wskaźników stanu ciała, diety i zdjęć sylwetki, a także historii treningów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie comentários semanais com base em seus indicadores físicos, alimentação e fotos do seu corpo, além do histórico de treinos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie comentários semanais com base em seus indicadores físicos, alimentação e fotos do seu corpo, além do histórico de treinos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe baza indicatorilor fizici, a alimentației și a fotografiilor cu tipul de corp, precum și a istoricului de antrenament, se va crea un comentariu săptămânal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте еженедельные комментарии на основе ваших ключевых показателей здоровья, информации о питании и фотографий вашего тела, а также истории тренировок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe údajov o KPI, strave a fotografiách postavy, vytvorte týždenné komentáre."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarite tedenske komentarje na podlagi KPI telesne pripravljenosti, prehrane in fotografij telesne oblike ter zgodovine treningov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa veckovisa kommentarer baserat på dina fysiska KPI:er, kost och kroppsbilder samt träningshistorik."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடல் அளவீடுகள், உணவு, உடல் புகைப்படங்கள் மற்றும் உடற்பயிற்சி வரலாற்றிலிருந்து வாராந்திர கருத்துக்களை உருவாக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీర KPI, ఆహారం, శరీర ఆకృతి ఫోటోలు, వ్యాయామ చరిత్ర నుండి వారపు వ్యాఖ్యను రూపొందించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างความคิดเห็นรายสัปดาห์จากข้อมูลสุขภาพ, อาหาร, รูปภาพรูปร่าง และประวัติการออกกำลังกาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut KPI'ları, beslenme, vücut şekli fotoğrafları ve egzersiz geçmişinden haftalık yorumlar oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте щотижневі коментарі на основі фізіологічних показників, харчування та фотографій вашої фігури, а також історії тренувань."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo bình luận hàng tuần từ chỉ số thể chất, chế độ ăn uống, hình ảnh cơ thể và lịch tập luyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据身体KPI、饮食、体型照片和力量训练历史，生成每周评论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們從身體 KPI、飲食、體型照片和肌力訓練歷史中創建每週評論。"
          }
        }
      }
    },
