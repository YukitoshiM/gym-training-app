        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La funció AI està desactivada a la configuració. L'entrada manual es pot desar tal com està."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce AI je vypnutá v nastavení. Ruční zadávání můžete uložit tak, jak je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-funktionerne er slået fra i indstillingerne. Manuel input kan gemmes som det er."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Funktion ist in den Einstellungen deaktiviert. Manuelle Eingaben können so gespeichert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λειτουργίες τεχνητής νοημοσύνης είναι απενεργοποιημένες στις ρυθμίσεις. Μπορείτε να αποθηκεύσετε χειροκίνητα δεδομένα όπως είναι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. Manual input can be saved as is."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. Manual input can be saved as is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. Manual input can be saved as is."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. Manual input can be saved as is."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La función de IA está desactivada en la configuración. Puedes guardar la entrada manual tal cual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La función de IA está desactivada en la configuración. Puedes guardar la entrada manual tal cual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-toiminto on pois päältä asetuksissa. Manuaalinen syöttö voidaan tallentaa tällä hetkellä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonctionnalité AI est désactivée dans les paramètres. L'entrée manuelle peut être sauvegardée ainsi."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonctionnalité AI est désactivée dans les paramètres. L'entrée manuelle peut être sauvegardée ainsi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI સુવિધાઓ સેટિંગ્સમાં બંધ છે. મેન્યુઅલ ઇનપુટને પણ જેમ છે તેમ સાચવી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשמור את הקלט ידני הזה כפי שהוא, הפונקציות של ה-AI כבויות בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI सुविधाएँ सेटिंग्स में बंद हैं। आप मैन्युअल रूप से दर्ज किए गए डेटा को भी बिना किसी बदलाव के सहेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcije AI-a su isključene u postavkama. Ručni unos možete spremiti kao što je."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI funkció le van tiltva a beállításokban. A manuális bevitelt is jelenleg meg lehet menteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur AI dinonaktifkan dalam pengaturan. Input manual dapat disimpan seperti ini."
