          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioitu arvo on vain suuntaa antava. Voit muuttaa sitä vapaasti alla olevissa kentissä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs estimées sont des indications. Vous pouvez les modifier librement dans le champ ci-dessous."
