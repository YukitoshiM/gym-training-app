    "domain_catalog.fae7ab24c5bd": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:74\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "انحنِ للأمام قليلاً واستخدم صدرك وثلاثية الرؤوس لدفع نفسك للأعلى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclineu-vos lleugerament cap endavant i utilitzeu el pit i els tríceps per empènyer-vos cap amunt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehněte mírně do předklonu a zatáhněte hrudník a triceps, abyste vytvořili pohyb."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en let fremadgående stilling og press med brystet og triceps for at løfte kroppen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie eine leicht nach vorne geneigte Haltung ein und nutzen Sie Brust und Trizeps, um den Körper nach oben zu drücken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθείτε με ελαφρώς προκατειλημμένη στάση και χρησιμοποιήστε τους θώρακα και τους τρικέφαλο για να σπρώξετε το σώμα σας προς τα εμπρός."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean slightly forward, using your chest and triceps to push yourself up."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean slightly forward, using your chest and triceps to push yourself up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean slightly forward, using your chest and triceps to push yourself up."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lean slightly forward, using your chest and triceps to push yourself up."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate ligeramente y usa los músculos del pecho y tríceps para empujar el cuerpo hacia arriba."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclínate ligeramente y usa los músculos del pecho y tríceps para empujar el cuerpo hacia arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyykisty ja käytä rintaa ja olkapäitä työntämään itseäsi ylöspäin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentez-vous légèrement et utilisez votre poitrine et vos triceps pour pousser votre corps vers le haut."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentez-vous légèrement et utilisez votre poitrine et vos triceps pour pousser votre corps vers le haut."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હળવા અચળાણમાં, છાતી અને ઉપરના હાથના સ્નાયુઓનો ઉપયોગ કરીને શરીરને આગળ ધકેલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתכופף מעט ולהשתמש בחזה ובשרירי הזרוע העליונים כדי להרים את הגוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थोड़ा आगे झुककर, छाती और बाइसेप्स का उपयोग करके शरीर को ऊपर धकेलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagnite tijelo malo prema naprijed i koristite prsnu kost i triceps za podizanje tijela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyezze a testét enyhén előre, és használja a mellkasát és az oldalsó izmokat, hogy emelje fel a testet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Miringkan tubuh sedikit, lalu dorong tubuh menggunakan dada dan trisep."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinando leggermente il corpo, utilizzate petto e tricipiti per spingere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やや前傾し、胸と上腕三頭筋を使って体を押し上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약간 앞으로 기울고, 가슴과 삼두근을 사용하여 몸을 밀어냅니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हलक्या वक्र स्थितीत, छाती आणि ट्रायसेप्सच्या मदतीने शरीर पुढे ढकला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedikit condong ke hadapan, kemudian mendorong badan dengan menggunakan dada dan trisep."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Leun licht naar voren en duw jezelf op met je borst en triceps."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en lett overkroppsvinkel og press kroppen opp med brystmusklene og triceps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skręć lekko ciało i użyj klatki piersiowej oraz tricepsów, aby się uniosła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline-se ligeiramente e use os músculos do peito e tríceps para impulsionar o corpo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Incline-se ligeiramente e use os músculos do peito e tríceps para impulsionar o corpo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îndoiți ușor șoldurile și folosiți pieptul și tricepsul pentru a împinge corpul înainte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного наклонитесь вперед и используйте грудь и трицепс для отталкивания."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakloňte telo mierne dopredu a pritláčajte sa pomocou hrudníka a trpaslíkov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagnite se rahlo naprej in z uporabo prs in tricepsov potisnite telo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Luta dig något framåt och pressa upp kroppen med bröstet och triceps."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சற்று முன்னோக்கி சாய்த்து, மார்பு மற்றும் மேல் கைகளை பயன்படுத்தி உடலை உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొద్దిగా ముందుకు వంగి, ఛాతీ మరియు ట్రెసెప్స్ ఉపయోగించి శరీరాన్ని పైకి లేపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับท่าให้เอียงเล็กน้อย แล้วใช้หน้าอกและกล้ามเนื้อไทรเซปส์ดันตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz öne eğilerek, göğüs ve üst kol kaslarınızı kullanarak vücudunuzu itin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного нахиліться вперед і використовуйте груди та трицепс для підняття тіла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hơi nghiêng người về phía trước, sử dụng ngực và cơ tam đầu để đẩy cơ thể lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微前倾，利用胸部和肱三头肌将身体推向前方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微前傾，利用胸部和三頭肌的力量推動身體。"
          }
        }
      }
    },
