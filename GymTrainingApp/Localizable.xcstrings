    "core_ui.4c48305c3a97": {
      "comment": "GymTrainingApp/Advertising/AdvertisingSettingsViews.swift:124",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وجهة مثل Mail وأرسل البلاغ إلى دعم BodyMode. لا يتضمن البلاغ سجلات الجسم أو الصحة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria una destinació, com ara Mail, i envia l'informe al servei d'assistència de BodyMode. L'informe no inclou registres corporals ni de salut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte cíl, například Mail, a odešlete hlášení podpoře BodyMode. Hlášení neobsahuje údaje o těle ani zdraví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en destination, f.eks. Mail, og send indberetningen til BodyMode Support. Indberetningen indeholder ikke krops- eller sundhedsdata."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Ziel wie Mail und sende den Bericht an den BodyMode-Support. Der Bericht enthält keine Körper- oder Gesundheitsdaten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε προορισμό, όπως το Mail, και στείλε την αναφορά στην Υποστήριξη BodyMode. Η αναφορά δεν περιλαμβάνει δεδομένα σώματος ή υγείας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a destination such as Mail and send the report to BodyMode Support. The report does not include body or health records."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a destination such as Mail and send the report to BodyMode Support. The report does not include body or health records."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a destination such as Mail and send the report to BodyMode Support. The report does not include body or health records."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a destination such as Mail and send the report to BodyMode Support. The report does not include body or health records."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un medio, como Mail, y envía el informe al asistencia de BodyMode. El informe no incluye registros corporales ni de salud."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un destino, como Mail, y envía el reporte al soporte de BodyMode. El reporte no incluye registros corporales ni de salud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kohde, kuten Mail, ja lähetä ilmoitus BodyMode-tukeen. Ilmoitus ei sisällä keho- tai terveystietoja."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une destination, comme Mail, puis envoyez le rapport à l'assistance BodyMode. Le rapport ne contient aucune donnée corporelle ou de santé."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une destination, comme Mail, puis envoyez le rapport à l'assistance BodyMode. Le rapport ne contient aucune donnée corporelle ou de santé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail જેવી મોકલવાની જગ્યા પસંદ કરો અને રિપોર્ટ BodyMode સપોર્ટને મોકલો. રિપોર્ટમાં શરીર અથવા આરોગ્યના રેકોર્ડ શામેલ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבחור יעד כגון Mail ולשלוח את הדיווח לתמיכה של BodyMode. הדיווח אינו כולל רישומי גוף או בריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail जैसा गंतव्य चुनें और रिपोर्ट BodyMode सहायता को भेजें। रिपोर्ट में शरीर या स्वास्थ्य के रिकॉर्ड शामिल नहीं होते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite odredište, primjerice Mail, i pošaljite prijavu podršci za BodyMode. Prijava ne sadrži podatke o tijelu ni zdravlju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz célalkalmazást, például a Mailt, és küldd el a jelentést a BodyMode ügyfélszolgálatának. A jelentés nem tartalmaz test- vagy egészségügyi adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tujuan seperti Mail dan kirim laporan ke Dukungan BodyMode. Laporan tidak menyertakan data tubuh atau kesehatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una destinazione, ad esempio Mail, e invia il report all'assistenza BodyMode. Il report non contiene dati corporei o sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールなどの送信先を選び、BodyModeサポートへお送りください。身体や健康の記録は報告文に含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail 등의 전송 대상을 선택해 BodyMode 지원팀으로 신고 내용을 보내세요. 신고에는 신체 또는 건강 기록이 포함되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail सारखे पाठवण्याचे ठिकाण निवडा आणि अहवाल BodyMode Support कडे पाठवा. अहवालात शरीर किंवा आरोग्य नोंदी समाविष्ट नसतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih destinasi seperti Mail dan hantar laporan kepada Sokongan BodyMode. Laporan tidak mengandungi data badan atau kesihatan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een bestemming, zoals Mail, en stuur de melding naar BodyMode Support. De melding bevat geen lichaams- of gezondheidsgegevens."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et mål, for eksempel Mail, og send rapporten til BodyMode Support. Rapporten inneholder ikke kropps- eller helsedata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz miejsce docelowe, takie jak Mail, i wyślij zgłoszenie do Pomocy BodyMode. Zgłoszenie nie zawiera danych o ciele ani zdrowiu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um destino, como o Mail, e envie o relatório ao Suporte do BodyMode. O relatório não inclui registros corporais ou de saúde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher um destino, como o Mail, e envie o relatório ao Apoio do BodyMode. O relatório não inclui registos corporais ou de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o destinație, precum Mail, și trimite raportul către Asistența BodyMode. Raportul nu include date corporale sau de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложение, например Mail, и отправьте жалобу в поддержку BodyMode. Жалоба не содержит данных о теле или здоровье."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte cieľ, napríklad Mail, a odošlite hlásenie podpore BodyMode. Hlásenie neobsahuje údaje o tele ani zdraví."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite cilj, na primer Mail, in pošljite prijavo podpori BodyMode. Prijava ne vsebuje podatkov o telesu ali zdravju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en destination, till exempel Mail, och skicka rapporten till BodyMode Support. Rapporten innehåller inga kropps- eller hälsodata."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail போன்ற அனுப்பும் இடத்தைத் தேர்ந்தெடுத்து அறிக்கையை BodyMode Support-க்கு அனுப்பவும். அறிக்கையில் உடல் அல்லது ஆரோக்கியப் பதிவுகள் சேர்க்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail వంటి పంపే గమ్యాన్ని ఎంచుకుని రిపోర్టును BodyMode Supportకు పంపండి. రిపోర్టులో శరీర లేదా ఆరోగ్య రికార్డులు ఉండవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกปลายทาง เช่น Mail แล้วส่งรายงานไปยังฝ่ายสนับสนุน BodyMode รายงานจะไม่มีข้อมูลร่างกายหรือสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail gibi bir hedef seç ve bildirimi BodyMode Desteği'ne gönder. Bildirim vücut veya sağlık kayıtlarını içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть застосунок, наприклад Mail, і надішліть скаргу до підтримки BodyMode. Скарга не містить даних про тіло чи здоров’я."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nơi gửi, chẳng hạn như Mail, rồi gửi báo cáo đến Bộ phận hỗ trợ BodyMode. Báo cáo không chứa dữ liệu cơ thể hoặc sức khỏe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择邮件等发送方式，并将报告发送给BodyMode支持。报告不包含身体或健康记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇郵件等傳送方式，並將報告傳送給BodyMode支援。報告不包含身體或健康資料。"
          }
        }
      }
    },
