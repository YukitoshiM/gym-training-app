      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:111\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتصويب عمودك الفقري، واسحب مرفقيك إلى الخلف، واتكئ ظهرك معًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estireu la columna vertebral, estireu els colzes cap enrere i recolzeu l'esquena."
