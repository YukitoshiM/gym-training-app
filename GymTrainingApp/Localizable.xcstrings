        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allungare le gambe, utilizzando l'articolazione del ginocchio come asse, e contraendo i quadricipiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝関節を軸にして脚を伸ばし、大腿四頭筋を収縮させる。"
