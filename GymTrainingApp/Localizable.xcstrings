        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Veuillez réessayer. Si cela persiste, vérifiez l'état du serveur d'IA."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Veuillez réessayer. Si cela persiste, vérifiez l'état du serveur d'IA."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} ફરી પ્રયાસ કરો. જો એમ હોય, તો AI સર્વરની સ્થિતિ તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} נסה שוב. אם תרצה להמשיך, בדוק את מצב פעולת השרת של הבינה המלאכותית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया {{value1}} बार फिर प्रयास करें। यदि ऐसा होता है, तो AI सर्वर की स्थिति जांच लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Ponovite pokušaj. Ako to nastavite, provjerite da je AI server u funkciji."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, {{value1}}-szer újra próbálja. Ha ez nem sikerül, ellenőrizze az AI-szerver állapotát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Silakan mencoba lagi. Jika masalah berlanjut, periksa status server AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Riprova. Se necessario, verifica lo stato del server AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}再試行してください。続く場合はAIサーバーの稼働状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} 다시 시도해 주세요. 계속 진행하는 경우 AI 서버의 작동 상태를 확인해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} पुन्हा प्रयत्न करा. पुढे जाण्यापूर्वी AI सर्व्हर चालू आहे की नाही, हे तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Sila cuba semula. Jika anda ingin terus, sila periksa status pelayan AI."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Probeer het opnieuw. Als dit probleem aanhoudt, controleer dan of de AI-server actief is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Prøv igjen. Hvis dette fortsetter, sjekk at AI-serveren er aktiv."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Spróbuj ponownie. Jeśli problem nadal występuje, sprawdź stan działania serwera AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Tente novamente. Se continuar, verifique se o servidor de IA está em funcionamento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Tente novamente. Se continuar, verifique se o servidor de IA está em funcionamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Reîncepeți. Dacă doriți să continuați, verificați starea serverului AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Пожалуйста, попробуйте снова. Если проблема не исчезнет, проверьте состояние работы AI-сервера."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} skúste to znovu. Ak to budete ďalej robiť, skontrolujte, či je AI server funkčný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Poskusite znova. Če želite nadaljevati, preverite stanje delovanja AI strežnika."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Försök igen. Om detta uppstår, kontrollera att AI-servern är igång."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} மீண்டும் முயற்சிக்கவும். தொடர்ந்தால், AI சேவையகத்தின் செயல்பாட்டை சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} మళ్లీ ప్రయత్నించండి. అలా అయితే, AI సర్వర్ యొక్క స్థితిని తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}ลองอีกครั้ง โปรด หากต้องการดำเนินการต่อ กรุณาตรวจสอบสถานะการทำงานของเซิร์ฟเวอร์ AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} kez tekrar deneyin. Devam ediliyorsa, AI sunucunun çalışıp çalışmadığını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Будь ласка, спробуйте ще раз. Якщо це необхідно, перевірте стан роботи AI-сервера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Vui lòng thử lại. Nếu vẫn gặp sự cố, hãy kiểm tra trạng thái hoạt động của máy chủ AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}请重新尝试。如果继续，请确认 AI 服务器是否正常运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再次嘗試 {{value1}} 次。如果繼續使用，請確認 AI 伺服器的運作狀態。"
          }
        }
      }
    },
