    "health_meals_body_ai.f2d1aefd4747": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:148\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بفحص الصور من اتجاهات متعددة في وقت واحد. سيكون من الأسهل المقارنة إذا واصلت التصوير في نفس ظروف التصوير."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaig comprovar les fotos des de diverses direccions alhora. Serà més fàcil comparar si continueu disparant en les mateixes condicions de filmació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohlédli jsme více fotografií najednou. Pokud budete dodržovat stejné podmínky pro snímání, bude snazší porovnávat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg gennemgik flere billeder. Det er nemmere at sammenligne, hvis du holder de samme betingelser."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe mehrere Fotos aus verschiedenen Perspektiven zusammen betrachtet. Wenn Sie die Bedingungen für das Fotografieren einhalten, wird es einfacher, sie zu vergleichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξαμε πολλές φωτογραφίες μαζί. Για να συγκρίνετε, βεβαιωθείτε ότι έχετε τις ίδιες συνθήκες λήψης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We reviewed multiple photos together. To make comparisons easier, please ensure consistent shooting conditions."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We reviewed multiple photos together. To make comparisons easier, please ensure consistent shooting conditions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We reviewed multiple photos together. To make comparisons easier, please ensure consistent shooting conditions."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We reviewed multiple photos together. To make comparisons easier, please ensure consistent shooting conditions."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisamos varias fotos tomadas en diferentes ángulos. Para facilitar la comparación, es importante mantener las mismas condiciones al tomar las fotos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisamos varias fotos tomadas en diferentes ángulos. Para facilitar la comparación, es importante mantener las mismas condiciones al tomar las fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastimme useista eri kulmista otettuja kuvia. Jos pidät samoja olosuhteita ja jatkat, on helpompi verrata niitä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai consulté plusieurs photos prises sous différents angles. Pour faciliter la comparaison, il est préférable de maintenir les mêmes conditions de prise de vue."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai consulté plusieurs photos prises sous différents angles. Pour faciliter la comparaison, il est préférable de maintenir les mêmes conditions de prise de vue."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય દિશાના ફોટાને એકસાથે તપાસો. સમાન શરતો સાથે ચાલુ રાખવાથી સરખામણી કરવાનું સરળ બનશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקתי מספר תמונות בכיוונים שונים. כדי להמשיך, חשוב לשמור על תנאי צילום זהים, מה שיקל את ההשוואה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने कई दिशाओं से तस्वीरें एक साथ देखीं। यदि आप समान परिस्थितियों में लगातार तस्वीरें लेते हैं, तो तुलना करना आसान होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledali smo više fotografija. Ako nastavite uz iste uvjete snimanja, bit će lakše uspoređivati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Többirányú képeket egyszerre megtekintettem. A folyamatos, egyenletes fényviszonyok mellett könnyebben összehasonlíthatóak a képek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah melihat beberapa foto dari berbagai sudut. Dengan menjaga kondisi pengambilan gambar tetap sama, perbandingan akan menjadi lebih mudah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho controllato più foto da diverse angolazioni. Per ottenere risultati comparabili, è consigliabile mantenere le stesse condizioni di ripresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数方向の写真をまとめて確認しました。撮影条件を揃えて継続すると比較しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다양한 방향의 사진을 함께 확인했습니다. 촬영 조건을 맞춰 지속하면 비교하기 쉽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विविध दिशांमधील फोटो एकत्रितपणे पाहता आले. सर्वोत्तम परिणामांसाठी, समान परिस्थितीत नियमितपणे छायाचित्र काढणे उपयुक्त आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah menyemak beberapa gambar dari pelbagai sudut. Jika anda kekal dengan syarat yang sama, ia akan memudahkan untuk membandingkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb meerdere foto's van verschillende hoeken tegelijk bekeken. Door de opnameomstandigheden hetzelfde te houden, wordt het makkelijker om ze te vergelijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sjekket flere bilder samtidig. For å opprettholde, sørg for at forholdene er like, slik at du kan sammenligne dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdziłem wiele zdjęć z różnych perspektyw. Utrzymywanie spójnych warunków fotograficznych ułatwi porównanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiquei várias fotos em diferentes ângulos. Para facilitar a comparação, mantenha as condições de disparo consistentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiquei várias fotos em diferentes ângulos. Para facilitar a comparação, mantenha as condições de disparo consistentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am verificat mai multe fotografii împreună. Pentru a obține rezultate comparabile, este important să mențineți aceleași condiții de fotografiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы просмотрели несколько фотографий с разных ракурсов. Для удобства сравнения рекомендуется сохранять одинаковые условия съемки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoločne som si pozrel/a fotografie z rôznych uhlov. Ak budete pokračovať v fotografovaní za rovnakých podmienok, bude jednoduchšie porovnávať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabljali smo več fotografij, da smo jih pregledali. Če boste upoštevali enak način snemanja, bo primerjava enostavnejša."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag tittade på flera bilder tagna från olika vinklar. För att göra jämförelser, se till att du håller samma förhållanden och fortsätter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல கோணங்களில் உள்ள புகைப்படங்களை ஒரே நேரத்தில் பார்க்க முடிந்தது. சிறந்த முறையில் ஒப்பிட்டுப் பார்க்க, ஒரே மாதிரியான சூழ்நிலையில் தொடர்ந்து புகைப்படம் எடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వివిధ కోణాల నుండి ఫోటోలను ఒకేసారి చూడవచ్చు. షూటింగ్ పరిస్థితులను అనుగుణంగా ఉంటూ కొనసాగించడం ద్వారా పోల్చడం సులభమవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบภาพจากหลายมุมพร้อมกัน การถ่ายภาพในสภาพแวดล้อมที่เหมือนเดิมจะช่วยให้เปรียบเทียบได้ง่ายขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı açılardan çekilmiş fotoğrafları toplu olarak inceledim. Aynı koşullarda devam ederek karşılaştırma yapmak daha kolay olacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми переглянули кілька фотографій з різних ракурсів. Для зручного порівняння, важливо дотримуватися однакових умов зйомки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã xem xét nhiều ảnh chụp từ các góc khác nhau. Để so sánh dễ dàng hơn, hãy đảm bảo các điều kiện chụp giống nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已查看多角度的照片。如果您能保持相同的拍摄条件，则可以更容易地进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們已確認多個方向的照片。 保持相同的拍攝條件，可以更容易進行比較。"
          }
        }
      }
    },
