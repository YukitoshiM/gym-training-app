    "health_meals_body_ai.91022a59299a": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:746\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى التحقق من حالة تشغيل شبكتك وخادم الذكاء الاصطناعي. قد تستغرق معالجة الذكاء الاصطناعي ما يصل إلى 240 ثانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comproveu l'estat de funcionament de la vostra xarxa i del servidor d'IA. El processament d'IA pot trigar fins a 240 segons."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujistěte se, že jsou aktivní síť a server AI. Zpracování pomocí AI může trvat až 240 sekund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller, at netværket og AI-serveren er i drift. AI-behandlingen kan tage op til 240 sekunder."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte überprüfen Sie den Status der Netzwerk- und KI-Server. Die KI-Verarbeitung kann bis zu 240 Sekunden dauern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιωθείτε ότι οι υπηρεσίες δικτύου και του AI λειτουργούν. Η επεξεργασία από το AI μπορεί να διαρκέσει έως 240 δευτερόλεπτα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check that the network and AI server are running. AI processing may take up to 240 seconds."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check that the network and AI server are running. AI processing may take up to 240 seconds."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check that the network and AI server are running. AI processing may take up to 240 seconds."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Please check that the network and AI server are running. AI processing may take up to 240 seconds."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique que la conexión a la red y al servidor de IA estén activas. El procesamiento de IA puede tardar hasta 240 segundos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique que la conexión a la red y al servidor de IA estén activas. El procesamiento de IA puede tardar hasta 240 segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista, että verkko ja AI-palvelin ovat toiminnassa. AI-laskenta voi kestää jopa 240 sekuntia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le réseau et le serveur IA sont opérationnels. Le traitement par l'IA peut prendre jusqu'à 240 secondes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le réseau et le serveur IA sont opérationnels. Le traitement par l'IA peut prendre jusqu'à 240 secondes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નેટવર્ક અને AI સર્વરની સ્થિતિ તપાસો. AI પ્રક્રિયામાં 240 સેકન્ડ સુધી લાગી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא ודאו שהשרתים של הרשת וה-AI פועלים. עיבוד ה-AI עשוי לקחת עד 240 שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया नेटवर्क और AI सर्वर की स्थिति जांच लें। AI प्रोसेसिंग में अधिकतम 240 सेकंड लग सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite stanje mreže i AI servera. Obrada AI-ja može potrajati do 240 sekundi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze, hogy a hálózat és az AI-szerver működik-e. Az AI-feldolgozás akár 240 másodpercet is igénybe vehet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa status jaringan dan server AI. Pemrosesan AI mungkin memakan waktu hingga 240 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificare lo stato di funzionamento della rete e del server AI. L'elaborazione AI può richiedere fino a 240 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークとAIサーバーの稼働状態を確認してください。AI処理は最大240秒かかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 및 AI 서버의 작동 상태를 확인하십시오. AI 처리에 최대 240초가 소요될 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क आणि AI सर्व्हरची स्थिती तपासा. AI प्रक्रियेला 240 सेकंदांपर्यंत लागू होऊ शकते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila periksa status rangkaian dan pelayan AI. Pemprosesan AI mungkin mengambil sehingga 240 saat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of het netwerk en de AI-server actief zijn. Het verwerken kan tot 240 seconden duren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk at nettverket og AI-serveren er i drift. AI-behandling kan ta opptil 240 sekunder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy sieć i serwer AI są włączone. Przetwarzanie przez AI może trwać do 240 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se a conexão com a rede e o servidor de IA estão ativos. O processamento de IA pode levar até 240 segundos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se a conexão com a rede e o servidor de IA estão ativos. O processamento de IA pode levar até 240 segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați starea de funcționare a rețelei și a serverului AI. Procesarea AI poate dura până la 240 de secunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте состояние работы сети и сервера AI. Обработка AI может занимать до 240 секунд."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte, či je sieť a AI server funkčný. Proces spracovania AI môže trvať až 240 sekúnd."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosimo, preverite stanje omrežja in strežnika z umetno inteligenco. Obdelava lahko traja do 240 sekund."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att nätverket och AI-servern är igång. AI-bearbetning kan ta upp till 240 sekunder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நெட்வொர்க் மற்றும் AI சேவையகத்தின் செயல்பாட்டை சரிபார்க்கவும். AI செயலாக்கத்திற்கு அதிகபட்சமாக 240 வினாடிகள் ஆகலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నెట్‌వర్క్ మరియు AI సర్వర్ యొక్క స్థితిని తనిఖీ చేయండి. AI ప్రాసెసింగ్ 240 సెకన్ల వరకు పట్టవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดตรวจสอบสถานะการทำงานของเครือข่ายและเซิร์ฟเวอร์ AI การประมวลผล AI อาจใช้เวลาสูงสุด 240 วินาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ ve yapay zeka sunucusunun durumunu kontrol edin. Yapay zeka işlemleri en fazla 240 saniye sürebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте стан роботи мережі та серверу AI. Обробка AI може займати до 240 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng kiểm tra trạng thái hoạt động của mạng và máy chủ AI. Quá trình xử lý AI có thể mất tối đa 240 giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络和AI服务器的状态。AI处理可能需要最多240秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認網路和 AI 伺服器的狀態。AI 處理可能需要最多 240 秒。"
          }
        }
      }
    },
