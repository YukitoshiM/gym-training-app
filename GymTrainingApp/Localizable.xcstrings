    "domain_catalog.0d4594b21e65": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:487\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على وزنك ومحيط خصرك وتكرار التمارين بشكل مريح. إعطاء الأولوية للتسجيل دون انقطاع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu el vostre pes, la circumferència de la cintura i la freqüència d'exercici còmodament. Prioritzeu la gravació ininterrompuda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte svou hmotnost, obvod pasu a frekvenci cvičení. Prioritou je, aby záznamy nebyly přerušeny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold din vægt, taljelængde og træningsfrekvens på en behagelig måde. Prioriter, at dine data ikke går tabt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Gewicht, Ihr Bauchumfang und Ihre Trainingshäufigkeit auf eine natürliche Weise erhalten. Die kontinuierliche Aufzeichnung ist wichtig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε σταθερό το βάρος, την περιφέρεια του κορμού και τη συχνότητα των ασκήσεων σας. Δώστε προτεραιότητα στη διατήρηση της συνεχούς καταγραφής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain your weight, waist circumference, and exercise frequency without straining. Prioritize keeping your records consistent."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain your weight, waist circumference, and exercise frequency without straining. Prioritize keeping your records consistent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain your weight, waist circumference, and exercise frequency without straining. Prioritize keeping your records consistent."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain your weight, waist circumference, and exercise frequency without straining. Prioritize keeping your records consistent."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu peso, circunferencia abdominal y frecuencia de ejercicio sin esfuerzo. Prioriza mantener un registro continuo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu peso, circunferencia abdominal y frecuencia de ejercicio sin esfuerzo. Prioriza mantener un registro continuo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä paino, vatsanympärys ja liikuntatapahtumien määrä tasaisena. Priorisoi, että kirjaus ei katkea."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir votre poids, votre tour de taille et votre fréquence d'exercice sans effort. Privilégier la continuité des enregistrements."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir votre poids, votre tour de taille et votre fréquence d'exercice sans effort. Privilégier la continuité des enregistrements."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન, પેટની પરિમિતિ અને કસરતની આવૃત્તિને સરળતાથી જાળવો. રેકોર્ડિંગ અટકી ન જાય તેનું ધ્યાન રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על משקל, היקף מותניים ותדירות פעילות בצורה נוחה. תעדיפו שהרשומים לא יתפזלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वजन, पेट के घेरे, और व्यायाम की आवृत्ति को बिना किसी परेशानी के बनाए रखें। यह सुनिश्चित करना कि रिकॉर्डिंग में कोई रुकावट न आए, इस पर ध्यान दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Održavajte svoju težinu, mjere struja i frekvenciju vježbanja. Prioritet dajte kontinuitetu snimanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd meg a testsúlyt, a mellszövet körfogását és az edzés gyakoriságát. Prioritásként kezeljük, hogy a rekordok nem törljék el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan berat badan, lingkar pinggang, dan frekuensi olahraga dengan nyaman. Prioritaskan agar catatan tidak terputus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere il peso, la circonferenza vita e la frequenza dell'allenamento senza sforzo. Dare priorità alla continuità della registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重、腹囲、運動頻度を無理なく維持します。記録が途切れないことを優先します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸무게, 허리둘레, 운동 빈도를 자연스럽게 유지합니다. 기록이 끊기지 않도록 우선시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, कंबरचा घेर आणि व्यायामाची वारंवारता नियमित ठेवा. नोंदी पूर्ण राहतील याची काळजी घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan berat badan, sekeliling pinggang, dan frekuensi aktiviti. Prioritaskan agar rekod tidak terputus."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je gewicht, tailleomtrek en trainingsfrequentie comfortabel aan. Prioriteit is dat de gegevens niet verloren gaan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en stabil vekt, rundt midjen og treningsfrekvens. Prioriter at registreringen ikke blir brutt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj wagę, obwód talii i częstotliwość treningów bez wysiłku. Priorytetem jest ciągłe rejestrowanie danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu peso, circunferência abdominal e frequência de exercícios sem esforço. Priorize a continuidade do registro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu peso, circunferência abdominal e frequência de exercícios sem esforço. Priorize a continuidade do registro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține greutatea, circumferința taliei și frecvența antrenamentelor fără efort. Prioritizează menținerea unui jurnal continuu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте свой вес, обхват талии и частоту тренировок. Приоритетом является непрерывное ведение записей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte svoju hmotnosť, obvod pása a frekvenciu cvičení bez námahy. Prioritou je, aby záznamy neboli prerušené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržite svojo težo, obodnico in red treninga. Prioritizirajte, da se ne bo izbrisalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll din vikt, midjemått och träningsfrekvens stabila. Prioritera att ha kontinuerliga mätningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உடல் எடை, இடுப்பு சுற்றளவு மற்றும் உடற்பயிற்சி அளவை எளிதாக பராமரிக்கலாம். பதிவுகள் தொடர்ந்து இருப்பதை உறுதி செய்ய வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు, కడుపు చుట్టుకొలత మరియు వ్యాయామ ఫ్రీక్వెన్సీని సులభంగా నిర్వహించండి. రికార్డులు నిరంతరం కొనసాగేలా చూసుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาน้ำหนัก, รอบเอว, และความถี่ในการออกกำลังกายอย่างเป็นธรรมชาติ ให้อำนวยให้มีการบันทึกข้อมูลอย่างต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo, karın çevresi ve egzersiz sıklığınızı kolayca sürdürmenize yardımcı olur. Kayıtların kesilmemesini önceliklendirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуйте свою вагу, обхват талії та частоту тренувань без зайвого напруження. Пріоритетом є збереження записів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duy trì cân nặng, vòng bụng và tần suất tập luyện một cách thoải mái. Ưu tiên việc ghi lại liên tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无压力地维持体重、腹围和运动频率。优先保证记录的连续性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無理地維持體重、腹圍和運動頻率。優先考慮記錄不中斷。"
          }
        }
      }
    },
