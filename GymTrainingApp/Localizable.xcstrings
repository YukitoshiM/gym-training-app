        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il piano dell'AI. Riprova a crearlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIの計画を読み取れませんでした。もう一度作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 계획을 읽을 수 없습니다. 다시 만들어 주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI योजना वाचण्यात अयशस्वी. कृपया पुन्हा तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca rencana jurulatih AI. Sila buat semula."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-planning kon niet worden gelezen. Maak deze opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese AI-planen. Vennligst opprett den på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać planu AI. Prosimy o ponowne utworzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o plano do IA. Crie novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o plano do IA. Crie novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut interpreta planul AI. Vă rugăm să îl creați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось распознать план от AI. Пожалуйста, создайте его еще раз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa načítať plán od AI. Prosím, vytvorte ho znovu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo uspešno prebrali načrta AI. Prosim, ga ustvarite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag kunde inte läsa AI-planen. Skapa den igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI திட்டத்தை படிக்க முடியவில்லை. மீண்டும் உருவாக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ప్రణాళికను చదవలేకపోయాము. దయచేసి మళ్ళీ సృష్టించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านแผน AI ได้ โปรดสร้างใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI planını okuyamadım. Lütfen tekrar oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати план від AI. Будь ласка, створіть його ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc kế hoạch của AI. Vui lòng tạo lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
