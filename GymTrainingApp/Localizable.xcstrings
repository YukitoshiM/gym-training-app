    "domain_catalog.28ab7663b1cf": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:29\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتقييم تغيرات شكل الجسم ليس فقط من خلال الوزن ولكن أيضًا من خلال محيط الخصر والصور وقوة العضلات"
