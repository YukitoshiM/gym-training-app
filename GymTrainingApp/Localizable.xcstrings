    "training.a1576054e4f1": {
      "comment": "GymTrainingApp/Features/Plans/AIPlanCoachView.swift:344\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: قلل عدد الأحداث بمقدار حدث واحد وخذ فترات راحة أطول."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple: reduïu el nombre d'esdeveniments en un i feu pauses més llargues."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příklad: Snižte počet cviků a prodlužte odpočinek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempel: Reducer antallet af øvelser og forlæng pausen"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: Eine Übung weniger, um die Pause zu verlängern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παράδειγμα: Μειώστε μία άσκηση και αυξήστε τον χρόνο ξεκούρασης"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: Reduce the number of exercises and lengthen rest"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: Reduce the number of exercises and lengthen rest"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: Reduce the number of exercises and lengthen rest"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: Reduce the number of exercises and lengthen rest"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: Reduce el número de ejercicios y aumenta el descanso"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: Reduce el número de ejercicios y aumenta el descanso"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esimerkki: Vähennä sarjoja ja pidennä taukoa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : Réduire le nombre d'exercices pour une pause plus longue"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : Réduire le nombre d'exercices pour une pause plus longue"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉદાહરણ: એક કસરત ઘટાડીને વિરામને લાંબો કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לדוגמה: הפחת את מספר התרגילים כדי להאריך את ההפסקות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरण: एक व्यायाम कम करके ब्रेक लंबा करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primjer: Smanjite broj vježbi i produžite odmor"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Példa: Egyetlen gyakorlatot csökkents, hogy hosszabb legyen a pihenő idő"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: Kurangi jumlah latihan dan perpanjang istirahat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esempio: Riduci il numero di esercizi per prolungare la pausa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: 種目を1つ減らして休憩を長く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 운동 종류를 하나 줄여 휴식을 길게"
