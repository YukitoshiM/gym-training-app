    "domain_catalog.a2265283c677": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:218\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الهدوء والسرعة في اتخاذ القرارات. حماية السلامة وإمكانية تكرار نتائج"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranquil i ràpid per prendre decisions. Protegir la seguretat i la reproductibilitat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Buďte klidní a rozhodujte se rychle. Udržujte bezpečnost a opakovatelnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag roligt beslutninger og vær sikker."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheidungen ruhig und schnell treffen. Sicherheit und Wiederholbarkeit gewährleisten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε αποφάσεις με ψυχραιμία και αποτελεσματικότητα. Διασφαλίστε την ασφάλεια και την επανάληψη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Make calm, informed decisions. Prioritize safety and reproducibility."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Make calm, informed decisions. Prioritize safety and reproducibility."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make calm, informed decisions. Prioritize safety and reproducibility."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Make calm, informed decisions. Prioritize safety and reproducibility."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar decisiones con calma y rapidez. Proteger la seguridad y la capacidad de replicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomar decisiones con calma y rapidez. Proteger la seguridad y la capacidad de replicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysy rauhallisena ja tee nopeita päätöksiä. Säilytä turvallisuus ja toistettavuus."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez des décisions avec calme et rapidité. Protégez votre sécurité et votre capacité à reproduire les résultats."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez des décisions avec calme et rapidité. Protégez votre sécurité et votre capacité à reproduire les résultats."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શાંત રહો અને ઝડપથી નિર્ણયો લો. સલામતી અને પુનઃઉત્પાદનને જાળવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל החלטות בצורה רציונלית ומהירה. שמור על בטיחות ועל היכולת לשחזר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत रहें और जल्दी निर्णय लें। सुरक्षा और पुनरुत्पादन सुनिश्चित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budite oprezni i donosite brza odluka. Osiguravamo sigurnost i ponavljanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Légyjon nyugodt és gyorsan hozza meg a döntéseket. Tartsuk az biztonságot és a reprodukálhatóságot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpikir jernih dan mengambil keputusan dengan cepat. Menjaga keamanan dan kemampuan untuk diulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi decisioni in modo razionale e rapido. Proteggi la sicurezza e la ripetibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冷静で決断が早い。安全と再現性を守る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "침착하고 신속하게 판단합니다. 안전성과 반복성을 보장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शांतपणे आणि जलद निर्णय घ्या. सुरक्षितता आणि सातत्य जपा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersikap tenang dan membuat keputusan dengan cepat. Menjaga keselamatan dan kebolehulangan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak heldere en snelle beslissingen, en zorg voor veiligheid en reproduceerbaarheid."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta veloverveide beslutninger raskt. Beskytter sikkerhet og reproduserbarhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bądź spokojny i podejmuj szybkie decyzje. Zadbaj o bezpieczeństwo i powtarzalność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tome decisões de forma calma e rápida. Priorize sua segurança e repetibilidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tome decisões de forma calma e rápida. Priorize sua segurança e repetibilidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luați decizii cu calm și rapid. Păstrați siguranța și reproductibilitatea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принимайте взвешенные решения. Обеспечьте безопасность и возможность повторения результатов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Buďte pokojní a rýchlo sa rozhodujte. Udržujte bezpečnosť a opakovanosť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite miren in sprejemajte hitra odločitev. Zagotovite varnost in ponovljivost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta beslut snabbt och lugnt. Skydda säkerhet och resultat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதியாக முடிவெடுக்கவும். பாதுகாப்பையும், மீண்டும் அடையக்கூடிய தன்மையையும் உறுதிப்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాంతంగా మరియు త్వరగా నిర్ణయాలు తీసుకోండి. భద్రత మరియు పునరావృతం ఉండేలా చూసుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดสินใจได้อย่างมีสติและรวดเร็ว ปกป้องความปลอดภัยและความสามารถในการทำซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşünceli ve hızlı karar verin. Güvenliği ve tekrar edilebilirliği koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будьте спокійними та приймайте швидкі рішення. Дотримуйтесь безпеки та можливості повторення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyết định một cách bình tĩnh và nhanh chóng. Bảo vệ sự an toàn và khả năng lặp lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持冷静，并做出快速决策。 保护安全性和可重复性"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持冷静，并快速做出决定。 保护安全性和可重复性"
          }
        }
      }
    },
