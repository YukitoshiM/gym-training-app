    "training.plan_revision_adjust": {
      "comment": "GymTrainingApp/Data/AppStore+Workout.swift:366\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تعديل الحمل في الجلسة القادمة لتجنب عدم تحقيق الأهداف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu ajustar la càrrega per següents entrenaments, per evitar que no arribeu a l'objectiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete upravit zátěž pro příští trénink, aby nedocházelo k neúspěchům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan justere den næste belastning, så du ikke går for langt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Belastung für das nächste Mal an, um Untergrenzen zu vermeiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να προσαρμόσετε το φορτίο για την επόμενη φορά, ώστε να μην συνεχίζονται οι αποτυχίες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust next workout to avoid missing targets."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust next workout to avoid missed goals."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust next workout to avoid missing targets."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust next workout to avoid missed goals."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ajustar la carga para evitar que no se cumpla el objetivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ajustar la carga para evitar que no alcances tus metas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit säätää seuraavaa harjoittelua, jotta et ylitä rajojasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajuster la charge pour les prochaines séances afin d'éviter des jours sans progression."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajuster la charge pour éviter les jours sans progression."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે લક્ષ્ય સુધી પહોંચતા નથી, તો આગામી વર્કઆઉટને સમાયોજિત કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להתאים את העומס הבא כדי למנוע הישארות במצב של חוסר השגת המטרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि लक्ष्य पूरे नहीं होते हैं, तो अगले प्रशिक्षण में तीव्रता को समायोजित किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete prilagoditi sljedeću opterećenost kako biste izbjegli nedostatak rezultata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő edzés terhelését be tudod állítani, hogy ne maradjak el a célok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menyesuaikan beban untuk sesi berikutnya agar tidak terus-menerus gagal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi regolare il carico per i prossimi allenamenti, in modo da non avere periodi di inattività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未達が続かないよう、次回の負荷を調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 달성 실패 시, 다음 훈련 강도를 조절할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या प्रगतीनुसार, पुढील प्रशिक्षणाची तीव्रता कमी किंवा जास्त करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menyesuaikan beban untuk siri seterusnya supaya tidak berlaku kekangan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de volgende training aan, zodat je niet steeds tekort komt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan justere neste treningsintensitet for å unngå manglende mål."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dostosować obciążenie w następnym treningu, aby uniknąć niedotrzymania celów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ajustar a carga para evitar períodos sem atingir a meta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ajustar a carga para evitar falhas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți ajusta sarcina pentru următoarea sesiune, astfel încât să nu mai aveți zile fără progres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете скорректировать нагрузку на следующей тренировке, чтобы избежать отсутствия прогресса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete upraviť zaťaženie pre budúci tréning, aby ste sa vyhnuli dlhšiemu obdobiu bez dosiahnutia cieľa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko prilagodite naslednjo intenzivnost, da se izognete manjku."
          }
        },
        "sv": {
