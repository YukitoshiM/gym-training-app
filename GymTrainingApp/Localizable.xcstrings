    "domain_catalog.bf1f4a0fe72a": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:223\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع راحتي يديك في مواجهة بعضهما البعض واستخدم ساعديك للرفع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Col·loqueu els palmells l'un de l'altre i utilitzeu els avantbraços per aixecar-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeložte si ruce, aby se střely, a zároveň zvedejte předloktí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft ved at holde dine hænder mod hinanden og bruge din underarm."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Heben Sie Ihre Hände gegenüber und verwenden Sie dabei auch Ihren Unterarm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στερεώστε το ένα χέρι με το άλλο, χρησιμοποιώντας και τον εξωτερικό βραχίονα για να το σηκώσετε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your palms together and lift your forearms while doing so."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your palms together and lift your forearms while doing so."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your palms together and lift your forearms while doing so."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your palms together and lift your forearms while doing so."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta las manos, usando también el antebrazo, de forma opuesta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta las manos, usando también el antebrazo, de forma opuesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kädet vastakkain ja nosta ylävartaloa käyttämällä myös etuolkapäitä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez les paumes face à face, utilisez également votre avant-bras pour soulever."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez les paumes face à face, utilisez également votre avant-bras pour soulever."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથની હથેળીને સામસામે કરો અને આગળના હાથનો ઉપયોગ કરીને ઉપર ઉઠાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להרים את הידיים כך שהידיים פונות אחת לשנייה, תוך שימוש גם במרפק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने हाथों को एक-दूसरे के सामने रखें, और अपने पहले हाथ का भी उपयोग करके ऊपर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite ruke u suprotnim smjerovima, koristeći i predramena,"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kezünket egymással ellentétes irányban tartva, a karizma segítségével emeljük fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat tangan, gunakan lengan bawah juga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevare le mani, appoggiandole l'una sull'altra, e utilizzando anche il braccio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手のひらを向かい合わせにし、前腕も使いながら持ち上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손바닥을 마주 보게 하고, 팔꿈치도 사용하여 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हाताची तळवा एकमेकांवर ठेवून, मनगटाचा वापर करून वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat tangan dengan menghadap satu sama lain, serta menggunakan lengan bawah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Til met je handpalmen naar elkaar toe en gebruik ook je onderarm om op te tillen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft ved å vende håndflatene mot hverandre, og bruk også underarmsmusklene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciągnij rękę, upewniając się, że dłoń jest skierowana do przodu i użyj przedramienia, aby ją unieść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante as mãos com as palmas voltadas uma para a outra, usando também o antebraço."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante as mãos com as palmas voltadas uma para a outra, usando também o antebraço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridica mâna, astfel încât palmele să fie față în față, folosind și antebrațul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согните ладони друг к другу и поднимите предплечье, используя его."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdvihnite si obe ruky, pričom využite aj predlaktie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podajte roko in jo dvignite, pri tem pa uporabite tudi predmež."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft armarna genom att möta handflatorna och använda underarmen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கைகளை நேருக்கு நேராக வைத்து, முன் கையை பயன்படுத்தி தூக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులను ఎదురుగా ఉంచి, మోచేతులను కూడా ఉపయోగించి పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกโดยให้มือจับหันหน้าเข้าหากัน และใช้แขนด้านหน้าช่วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elinizi karşıya doğru kaldırın, aynı zamanda ön kolunuzu da kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте руки навхрест і піднімайте передпліччя, використовуючи їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ hai bàn tay đối diện và nâng bằng cả phần trước cánh tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将双手相对，同时使用前臂抬起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将双手相对，同时使用前臂来抬起。"
          }
        }
      }
    },
    "domain_catalog.bfa9f9e01dcb": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:53\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط المقعد وادفعه للأمام من ارتفاع الصدر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusteu el seient i empenyeu-lo cap endavant des de l'alçada del pit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte si pozici a posuňte tělo dopředu od hrudníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster sædet og skub det fremad fra brysthøjde."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzposition anpassen und den Körper nach vorne drücken, von der Brusthöhe aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε τη θέση και πιέστε προς τα εμπρός, από το ύψος του θώρακα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push forward from chest height."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push forward from chest height."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push forward from chest height."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push forward from chest height."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la posición y empuja hacia adelante desde el pecho."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la posición y empuja hacia adelante desde el pecho."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädä istuinta ja työntää eteenpäin rinnan korkeudelta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster la position et pousser vers l'avant à partir de la hauteur des épaules."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster la position et pousser vers l'avant à partir de la hauteur des épaules."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્લાનને ગોઠવો અને છાતીની ઊંચાઈથી આગળ ધપાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כוונן את הלוח, והזיזו אותו קדימה מהגובה של החזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीट को समायोजित करें और छाती की ऊंचाई से आगे की ओर धकेलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustirajte položaj i gurnite prema naprijed od visine prsa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa be a lábát, és nyomja előre a melltartás irányába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan posisi, lalu dorong dari dada ke depan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la posizione e spingi in avanti dal petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを調整し、胸の高さから前方へ押し出す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 영역을 조절하고, 가슴 높이에서 앞으로 밀어낸다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शीट समायोजित करा आणि छातीच्या उंचीपासून पुढे ढकलून घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan ketinggian, kemudian dorong ke hadapan dari ketinggian dada."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de stoel aan en duw jezelf vooruit vanaf borsthoogte."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster setet og skyv det fremover fra brysthøyde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj ustawienia i wypchnij ciało do przodu, od poziomu klatki piersiowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a posição e empurre para frente, da altura do peito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a posição e empurre para frente, da altura do peito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustați poziția și împingeți în față, de la nivelul pieptului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрегулируйте положение и надавите вперед, от груди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte si polohu a posúvajte ju dopredu od hrude."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite stol, da ga potisnete naprej od prsnih kost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera sätet och tryck framåt från brösthöjd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சட்டத்தை சரிசெய்து, மார்பின் உயரத்திலிருந்து முன்னோக்கித் தள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సీటును సర్దుబాటు చేసి, ఛాతీ ఎత్తు నుండి ముందుకు నెట్టండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับตำแหน่งแผ่นรอง และดันไปข้างหน้าจากระดับอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketleri ayarlayın ve göğüs seviyesinden öne doğru itin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте стрічку, відтягуючи її вперед від рівня грудей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh ghế, đẩy ngực về phía trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整座椅，从胸部高度向前推。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "调整座椅，从胸部高度向前推。"
          }
        }
      }
    },
