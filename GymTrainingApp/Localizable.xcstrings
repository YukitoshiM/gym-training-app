            "state": "translated",
            "value": "Ideální rychlost je ta, při které se můžete postupně zlepšovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den optimale hastighed er den, der giver dig mulighed for at vende tilbage."
          }
        },
