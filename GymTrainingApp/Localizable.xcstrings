    "health_meals_body_ai.14d3b7bdf022": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:543\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\ngu: NLLB fallback used because TranslateGemma mixed writing systems; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "من خلال تسجيل وجبات الطعام الخاصة بك، يمكنك التحقق من الفرق بين طاقة Apple Health أثناء الراحة وأثناء النشاط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En registrar els vostres àpats, podeu comprovar la diferència entre l'energia de Apple Health en repòs i durant l'activitat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud zaznamenáte jídlo, můžete porovnat rozdíl mezi spotřebovanou energií a energií při klidu/aktivitě v aplikaci Apple Health."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du registrerer et måltid, kan du se forskellen mellem dit måltids energiindhold og Apple Healths registrerede energiindhold (hvile/aktivitet)."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie eine Mahlzeit protokollieren, können Sie den Unterschied zwischen Ihrem Ruhe- und Aktivitätsenergieverbrauch im Apple Health überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την καταγραφή του γεύματος, μπορείτε να δείτε τη διαφορά μεταξύ της ενέργειας σε κατάσταση ηρεμίας και δραστηριότητας στο Apple Health."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "When you record your meal, you can check the difference between Apple Health's resting and active energy levels."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "When you record your meal, you can check the difference between Apple Health's resting and active energy levels."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you record your meal, you can check the difference between Apple Health's resting and active energy levels."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "When you record your meal, you can check the difference between Apple Health's resting and active energy levels."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al registrar tu comida, podrás comparar las diferencias con la energía en reposo y actividad de Apple Health."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Al registrar tu comida, podrás comparar las diferencias con la energía en reposo y actividad de Apple Health."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet tallentanut ruokapäiväkirjan, voit verrata sen Apple Healthin levossa ja aktiivisuuden energian välillä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un repas, vous pourrez ainsi comparer les différences avec l'énergie au repos et pendant l'activité de Apple Health."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un repas, vous pourrez ainsi comparer les différences avec l'énergie au repos et pendant l'activité de Apple Health."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે તમારા ખોરાકને રેકોર્ડ કરો છો, તો તમે Apple Health ની શાંત સમય અને સક્રિય સમયની ઊર્જા વચ્ચેનો તફાવત શોધી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשאתה מתעד ארוחה, תוכל לבדוק את ההבדל בין אנרגיה במנוחה ובפעילות ב-Apple Health."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप भोजन का रिकॉर्ड करते हैं, तो आप Apple Health में आराम और गतिविधि के समय के ऊर्जा अंतर को देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada zapišete jelo, možete provjeriti razliku između potrošnje energije tijekom odmora i aktivnosti u Apple Healthu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha rögzíti az étkezést, megtekintheti az Apple Health alkalmazásában a pihenő- és aktivitási időben elégetett energia különbségét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan mencatat makanan, Anda dapat membandingkan perbedaan antara energi istirahat dan aktivitas dengan Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrando il pasto, puoi verificare la differenza tra l'energia a riposo e l'energia durante l'attività di Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事を記録すると、Apple Healthの安静時・活動時エネルギーとの差を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사를 기록하면 Apple Health의 휴식 및 활동 시 에너지와의 차이를 확인할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आहाराची नोंद केल्यावर, ॲपल हेल्थमधील (Apple Health) 'विश्रांती' आणि 'सक्रियता' वेळेतील ऊर्जेतील फरक तपासता येतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan mencatat makanan, anda boleh melihat perbezaan antara tenaga istirahat dan aktiviti dalam Apple Health."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Door het opslaan van een maaltijd, kunt u de verschillen zien tussen de rust- en activiteitenergie in Apple Health."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du registrerer et måltid, kan du se forskjellen mellom energiforbruket i hvile og aktivitet i Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zapisaniu informacji o jedzeniu, możesz porównać różnicę między zużyciem energii podczas odpoczynku/aktywności w Apple Health."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registrar uma refeição, você pode comparar a diferença entre as necessidades calóricas e o consumo de energia do Apple Health."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registrar uma refeição, você pode comparar a diferença entre as necessidades calóricas e o consumo de energia do Apple Health."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când înregistrați mese, puteți verifica diferența dintre consumul de energie în repaus și activitate din Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сохранении записей о еде вы сможете сравнить потребление энергии во время отдыха и активности с данными из Apple Health."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď zaznamenáte jedlo, môžete porovnávať rozdiel medzi spotrebovanou energiou a energetickou úrovňou pri odpočinku/aktívnosti v aplikácii Apple Health."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko zabeležite hrano, lahko preverite razliko med energijo pri mirovanju in aktivnostih v aplikaciji Apple Health."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du registrerar en måltid kan du jämföra skillnaden mellan din energiförbrukning och Apple Healths \"vila\" och \"aktivitet\"."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் உணவுப் பதிவுகளைச் செய்யும் போது, Apple Health-ன் ஓய்வு மற்றும் செயல்பாட்டு நேரத்திற்கான ஆற்றல் வேறுபாட்டை நீங்கள் சரிபார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆహారాన్ని రికార్డ్ చేసినప్పుడు, Apple Health యొక్క విశ్రాంతి మరియు కార్యాచరణ సమయంలో శక్తి మధ్య వ్యత్యాసాన్ని మీరు చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อบันทึกข้อมูลอาหาร คุณสามารถตรวจสอบความแตกต่างระหว่างพลังงานที่ได้รับจากอาหารกับพลังงานที่ร่างกายใช้ในขณะพักหรือออกกำลังกายได้ (ผ่าน Apple Health)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğün kaydettiğinizde, Apple Health'teki dinlenme ve aktivite sırasında enerji tüketimi arasındaki farkı görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після запису прийому їжі, ви зможете перевірити різницю між енергією під час відпочинку та активності в Apple Health."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi ghi lại bữa ăn, bạn có thể so sánh sự khác biệt giữa lượng năng lượng khi nghỉ và hoạt động với Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录饮食后，可以与Apple Health的静息和活动能量进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄飲食後，可以確認與Apple Health的休息時和活動時能量差異。"
          }
        }
      }
    },
    "health_meals_body_ai.15277ebacd5d": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:614\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تحليلها كما هي. إذا قمت أيضًا بإضافة العرض الجانبي أو الخلفي، فيمكنك التحقق من ذلك من اتجاه مختلف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu analitzar-lo tal qual. Si també afegiu la vista lateral o posterior, podeu comprovar-la des d'una altra direcció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžeme pokračovat s analýzou. Přidáním údajů o stranách a zadní části můžeme získat komplexnější pohled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan analyseres videre. Ved at tilføje målinger fra siden og bagsiden, kan vi få et mere komplet billede."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann analysiert werden. Durch Hinzufügen von Seiten- oder Rückseiten können Sie die Daten aus verschiedenen Perspektiven überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορούμε να αναλύσουμε αυτό. Επίσης, προσθέτοντας τις πλευρές και την πίσω όψη, μπορούμε να το εξετάσουμε από διαφορετικές οπτικές γωνίες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We can analyze this data. Adding side or back views will allow for further verification from different angles."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We can analyze this data. Adding side or back views will allow for further verification from different angles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We can analyze this data. Adding side or back views will allow for further verification from different angles."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We can analyze this data. Adding side or back views will allow for further verification from different angles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos analizar esto. Añadiendo también vistas laterales o frontales, podemos obtener información desde diferentes ángulos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos analizar esto. Añadiendo también vistas laterales o frontales, podemos obtener información desde diferentes ángulos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voimme analysoida tämän. Voit myös lisätä sivun ja takapuolen, jolloin voit tarkistaa tiedot eri näkökulmista."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous pouvons analyser cela. Ajouter également des vues latérales ou arrière permet de compléter l'analyse sous différents angles."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous pouvons analyser cela. Ajouter également des vues latérales ou arrière permet de compléter l'analyse sous différents angles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આના પર વિશ્લેષણ કરી શકાય છે. આ ઉપરાંત, જો તમે બાજુ અને પાછળની તરફ પણ ઉમેરો, તો તમે અન્ય દિશાથી ચકાસી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לנתח זאת כעת. ניתן להוסיף גם צדדים וגם גב, כדי לבדוק מנקודות שונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम इस डेटा का विश्लेषण कर सकते हैं। यदि आप साइड और बैक भी जोड़ते हैं, तो आप अलग-अलग दिशाओं से भी जांच कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možemo analizirati ovo. Dodavanjem podataka o bočnom ili stražnjem dijelu, možemo provjeriti iz drugih smjera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel az adatokkal is lehet dolgozni. Ha a oldal és a hátoldal is hozzáadódnak, akkor más szempontból is ellenőrizhetjük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis dapat dilanjutkan seperti ini. Menambahkan pengukuran dari sisi samping atau belakang juga memungkinkan untuk memverifikasi dari sudut pandang yang berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possiamo analizzare questo. Aggiungendo anche la vista laterale o posteriore, possiamo ottenere informazioni da diverse angolazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま分析できます。横や背面も追加すると、別方向から補って確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 데이터를 분석할 수 있습니다. 옆면이나 뒷면도 추가하면 다른 방향에서 보완하여 확인할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "याचे विश्लेषण करणे शक्य आहे. तसेच, बाजू आणि मागील बाजूस देखील नोंदी घेतल्यास, अधिक माहिती मिळू शकेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis ini boleh dijalankan. Jika anda menambah bahagian samping dan belakang, ia akan membantu dalam mengesahkan daripada sudut yang berbeza."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan worden geanalyseerd. Door ook de zijkanten en achterkant toe te voegen, kun je vanuit verschillende hoeken controleren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan analyseres videre. Ved å legge til side- og bakside, kan vi få et mer komplett bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możemy to teraz przeanalizować. Dodanie danych z boku lub tyłu pozwoli na weryfikację z różnych perspektyw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos analisar isso. Adicionar também as laterais e a parte traseira permite verificar de diferentes ângulos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos analisar isso. Adicionar também as laterais e a parte traseira permite verificar de diferentes ângulos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Putem continua analiza. Adăugând și vizualizarea laterală sau din spate, putem verifica din alte perspective."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно проанализировать данные в таком виде. Добавление данных о боковой и задней поверхности позволит получить более полную картину."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžeme pokračovať s analýzou. Pridaním údajov o strane alebo zadnej časti môžeme overiť aj z iného úhlu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko analiziramo tudi to. Dodajanje meritev z različnih strani (horizontalno in vertikalno) omogoča dodatno preverjanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kan analyseras vidare. Genom att lägga till sidor eller baksida kan du få en mer komplett bild."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை வைத்து பகுப்பாய்வு செய்யலாம். மேலும், பக்கவாட்டில் மற்றும் பின்புறத்திலும் பகுப்பாய்வு செய்து சரிபார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీని ఆధారంగా విశ్లేషణ చేయవచ్చు. అదనంగా, పక్క మరియు వెనుక వైపులను కూడా జోడించడం ద్వారా వేరే కోణం నుండి ధృవీకరించుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถวิเคราะห์ได้ตามนี้ หากเพิ่มการวัดด้านข้างหรือด้านหลัง ก็จะช่วยให้เห็นภาพรวมที่สมบูรณ์มากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu verileri analiz edebiliriz. Ayrıca, yan ve arka tarafları da ekleyerek farklı açılardan kontrol edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна провести аналіз далі. Додавши показники з боків або ззаду, можна отримати додаткову інформацію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng ta có thể phân tích như vậy. Thêm các góc khác (ví dụ: bên, mặt sau) để kiểm tra từ nhiều hướng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以继续分析。如果添加横向或背面，也可以从不同方向进行补充检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以這樣分析。如果還能加入側面或背面，就能從不同方向進行確認。"
          }
        }
      }
    },
