        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag har granskat dina senaste 30 dagars aktiviteter, kost och träning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த 30 நாட்களில் உங்கள் உடல், உணவு மற்றும் உடற்பயிற்சி பதிவுகளை சரிபார்க்கியுள்ளோம்."
