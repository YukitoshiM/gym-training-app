        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza meg a sarat, miközben a térdei kinyúltak, és húzza össze a felső lábszárát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meluruskan lutut dan mengangkat tumit, lalu mengencangkan betis."
