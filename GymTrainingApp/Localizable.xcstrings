    "core_ui.288a496c1f39": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:887",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مسودات الذكاء الاصطناعي والتعليق الأسبوعي غير متاحين، لكن لا يزال بإمكانك حفظ الإدخالات اليدوية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els esborranys d'IA i els comentaris setmanals no estan disponibles, però encara pots desar registres manuals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrhy AI a týdenní zpětná vazba nejsou dostupné, ale ruční záznamy můžete stále ukládat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-udkast og ugentlig feedback er ikke tilgængelige, men manuelle registreringer kan stadig gemmes."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Entwürfe und wöchentliches Feedback sind nicht verfügbar. Manuelle Einträge können weiterhin gespeichert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προσχέδια AI και τα εβδομαδιαία σχόλια δεν είναι διαθέσιμα, αλλά μπορείς να αποθηκεύεις χειροκίνητες καταχωρίσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "AI drafts and weekly feedback are unavailable, but you can still save manual entries."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "AI drafts and weekly feedback are unavailable, but you can still save manual entries."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "AI drafts and weekly feedback are unavailable, but you can still save manual entries."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "AI drafts and weekly feedback are unavailable, but you can still save manual entries."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los borradores de IA y los comentarios semanales no están disponibles, pero puedes seguir guardando registros manuales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los borradores de IA y los comentarios semanales no están disponibles, pero puedes seguir guardando registros manuales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyluonnokset ja viikoittainen palaute eivät ole käytettävissä, mutta manuaaliset kirjaukset voi silti tallentaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les brouillons IA et le bilan hebdomadaire sont indisponibles, mais vous pouvez toujours enregistrer des saisies manuelles."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les brouillons IA et le bilan hebdomadaire sont indisponibles, mais vous pouvez toujours enregistrer des saisies manuelles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ડ્રાફ્ટ અને સાપ્તાહિક પ્રતિસાદ ઉપલબ્ધ નથી, પરંતુ તમે મેન્યુઅલ રેકોર્ડ સાચવી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיוטות AI ומשוב שבועי אינם זמינים, אך עדיין אפשר לשמור רישומים ידניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ड्राफ़्ट और साप्ताहिक टिप्पणी उपलब्ध नहीं हैं, लेकिन आप मैन्युअल रिकॉर्ड सहेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI skice i tjedni komentari nisu dostupni, ali ručne unose i dalje možete spremati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az MI-vázlatok és a heti visszajelzés nem érhetők el, de a kézi bejegyzések továbbra is menthetők."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf AI dan masukan mingguan tidak tersedia, tetapi entri manual tetap dapat disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bozze IA e il feedback settimanale non sono disponibili, ma puoi comunque salvare le registrazioni manuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI下書きや週次コメントは実行できませんが、手動記録は保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 초안과 주간 피드백은 사용할 수 없지만 수동 기록은 저장할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI मसुदे आणि साप्ताहिक अभिप्राय उपलब्ध नाहीत, पण तुम्ही हाताने केलेल्या नोंदी जतन करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf AI dan maklum balas mingguan tidak tersedia, tetapi entri manual masih boleh disimpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-concepten en wekelijkse feedback zijn niet beschikbaar, maar handmatige invoer kan nog steeds worden opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-utkast og ukentlig tilbakemelding er ikke tilgjengelig, men manuelle registreringer kan fortsatt lagres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkice AI i cotygodniowe uwagi są niedostępne, ale nadal możesz zapisywać wpisy ręczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunhos de IA e comentários semanais estão indisponíveis, mas você ainda pode salvar registros manuais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunhos de IA e feedback semanal estão indisponíveis, mas você ainda pode guardar registos manuais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schițele AI și feedbackul săptămânal nu sunt disponibile, dar poți salva în continuare înregistrări manuale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черновики ИИ и еженедельные комментарии недоступны, но ручные записи можно сохранять."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrhy AI a týždenná spätná väzba nie sú dostupné, no manuálne záznamy môžete naďalej ukladať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osnutki UI in tedenske povratne informacije niso na voljo, vendar lahko ročne vnose še vedno shranjujete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-utkast och veckovis feedback är inte tillgängliga, men manuella poster kan fortfarande sparas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI வரைவுகளும் வாராந்திர கருத்தும் கிடைக்கவில்லை; இருப்பினும் கைமுறை பதிவுகளைச் சேமிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI డ్రాఫ్ట్‌లు మరియు వారపు ఫీడ్‌బ్యాక్ అందుబాటులో లేవు, కానీ చేతితో చేసిన ఎంట్రీలను సేవ్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ร่างจาก AI และความคิดเห็นรายสัปดาห์ไม่ได้ แต่ยังบันทึกข้อมูลด้วยตนเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI taslakları ve haftalık geri bildirim kullanılamıyor, ancak manuel kayıtları kaydedebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чернетки ШІ та щотижневі коментарі недоступні, але ручні записи можна зберігати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể dùng bản nháp AI và nhận xét hằng tuần, nhưng bạn vẫn có thể lưu mục nhập thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI草稿和每周反馈不可用，但仍可保存手动记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI草稿和每週反饋無法使用，但仍可儲存手動記錄。"
          }
        }
      }
    },
