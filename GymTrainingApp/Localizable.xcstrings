    "health_meals_body_ai.215d8802d90e": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:611\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف تشغيل وظيفة الذكاء الاصطناعي في الإعدادات. يمكنك حفظ مجموعة الصور كما هي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La funció AI està desactivada a la configuració. Podeu desar el conjunt de fotos tal qual."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce AI je vypnutá v nastavení. Fotografie můžete uložit tak, jak jsou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-funktionerne er slået fra i indstillingerne. Du kan gemme dette foto sæt som det er."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Funktion ist in den Einstellungen deaktiviert. Dieses Foto kann so gespeichert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λειτουργίες τεχνητής νοημοσύνης είναι απενεργοποιημένες στις ρυθμίσεις. Μπορείτε να αποθηκεύσετε τις φωτογραφίες όπως είναι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. This photo set can be saved as is."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. This photo set can be saved as is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. This photo set can be saved as is."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI feature is turned off in settings. This photo set can be saved as is."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La función de IA está desactivada en la configuración. Puedes guardar este conjunto de fotos tal cual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La función de IA está desactivada en la configuración. Puedes guardar este conjunto de fotos tal cual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-toiminto on pois päältä asetuksissa. Voit tallentaa valokuvat tällä hetkellä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonctionnalité AI est désactivée dans les paramètres. Vous pouvez enregistrer l'ensemble photo ainsi."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonctionnalité AI est désactivée dans les paramètres. Vous pouvez enregistrer l'ensemble photo ainsi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI સુવિધાઓ સેટિંગ્સમાં બંધ છે. આ ફોટો સેટને જેમ છે તેમ સાચવી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לשמור את קבוצת התמונות הזו כפי שהיא, הפונקציות של ה-AI כבויות בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI सुविधाएँ सेटिंग्स में बंद हैं। आप इस सेट को बिना किसी बदलाव के सहेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcije AI-a su isključene u postavkama. Fotografije možete spremiti kao što su."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI funkció le van tiltva a beállításokban. Ez a képkészlet jelenleg megmarad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur AI dinonaktifkan dalam pengaturan. Foto-foto dapat disimpan seperti ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La funzionalità IA è disattivata nelle impostazioni. Le foto possono essere salvate così come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI機能は設定でオフです。写真セットはこのまま保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 기능은 설정에서 꺼져 있습니다. 사진 세트는 그대로 저장할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI वैशिष्ट्ये सेटिंगमध्ये बंद आहेत. हे फोटो सेट जसेच्या तसे सेव्ह केले जाऊ शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungsi AI telah dimatikan dalam tetapan. Anda boleh menyimpan set foto ini seperti apa adanya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-functie staat uit, via instellingen. Dit foto-set kan worden opgeslagen zoals het is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-funksjonene er slått av i innstillingene. Du kan lagre dette bildet som det er."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcje AI są wyłączone w ustawieniach. Zdjęcia można zachować w obecnym stanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As funções de IA estão desativadas nas configurações. Você pode salvar este conjunto de fotos como está."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As funções de IA estão desativadas nas configurações. Você pode salvar este conjunto de fotos como está."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcțiile AI sunt dezactivate în setări. Puteți salva acest set de fotografii așa cum este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции ИИ отключены в настройках. Фотографии можно сохранить как есть."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcia AI je vypnutá v nastaveniach. Fotografie môžete uložiť tak, ako sú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcije AI so izklopljene v nastavitvah. S to nastavitvijo lahko shranite trenutno galerijo fotografij."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-funktioner är avstängda i inställningarna. Du kan spara detta fotoalbum som det är."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI செயல்பாடு அமைப்புகளில் முடக்குப்பட்டுள்ளது. இந்த புகைப்படங்களை அப்படியே சேமிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ఫంక్షన్లు సెట్టింగ్‌లలో ఆఫ్‌లో ఉన్నాయి. ఈ ఫోటోలను అలాగే నిల్వ చేసుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟังก์ชัน AI ปิดอยู่ในการตั้งค่า สามารถบันทึกลงรูปภาพได้ตามนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI özellikleri, ayarlar üzerinden kapatılmıştır. Fotoğraf seti bu haliyle kaydedilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Функція AI вимкнена в налаштуваннях. Фотографії можна зберегти як є."
