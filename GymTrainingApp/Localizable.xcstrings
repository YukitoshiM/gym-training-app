            "value": "เซสชันหมดอายุ กรุณาเข้าสู่ระบบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum süresi doldu. Lütfen tekrar giriş yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесія закінчилася. Будь ласка, увійдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话已过期，请重新登录。"
          }
