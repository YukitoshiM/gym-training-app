    "health_meals_body_ai.8b421501c6ce": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:458\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد بيانات تشغيلية حتى الآن. نحن نقدر أنك تبدأ المجموعة باستخدام Watch."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha dades operatives. Calculem que comenceu el conjunt amb Watch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosud neexistují žádná data. Odhadujeme, že je možné začít sledovat pomocí zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er endnu ikke nogen data. Vi estimerer, at du kan starte med at indtaste via din smartwatch."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegen noch keine Aktivitätsdaten vor. Wir schätzen, dass Sie mit dem Starten über Ihr Smartwatch beginnen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμα δεδομένα από τις κινήσεις. Προτείνουμε να ξεκινήσετε τη μέτρηση χρησιμοποιώντας το ρολόι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No activity data is available yet. We estimate that starting with the watch will provide accurate data."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "No activity data is available yet. We estimate that starting with the watch will provide accurate data."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No activity data is available yet. We estimate that starting with the watch will provide accurate data."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "No activity data is available yet. We estimate that starting with the watch will provide accurate data."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay datos disponibles. Se estima que al iniciar desde el reloj, se obtendrán los datos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay datos disponibles. Se estima que al iniciar desde el reloj, se obtendrán los datos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimintadataa ei ole vielä kerätty. Aloita seuranta kellon avulla ja arvioi sen perusteella."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée n'est encore disponible. Nous estimons qu'en commençant via votre montre, vous pourrez obtenir des données."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée n'est encore disponible. Nous estimons qu'en commençant via votre montre, vous pourrez obtenir des données."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાલમાં કોઈ ડેટા ઉપલબ્ધ નથી. વૉચ પર સેટ શરૂ કરવાથી, તે અંદાજિત છે."
