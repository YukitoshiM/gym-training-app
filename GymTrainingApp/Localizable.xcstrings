    "core_ui.8db1bd8f5b87": {
      "comment": "GymTrainingApp/Features/Onboarding/AppTutorialView.swift:106",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما نفذت أكثر، أصبحت الخطوة التالية أوضح"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com més facis, més clar serà el pas següent"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím více toho uděláte, tím jasnější bude další krok"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mere du gør, desto tydeligere bliver næste skridt"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mehr du umsetzt, desto klarer wird der nächste Schritt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο περισσότερο κάνεις, τόσο πιο ξεκάθαρο γίνεται το επόμενο βήμα"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you do, the clearer the next step becomes"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you do, the clearer the next step becomes"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you do, the clearer the next step becomes"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you do, the clearer the next step becomes"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más haces, más claro se vuelve el siguiente paso"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más haces, más claro se vuelve el siguiente paso"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä enemmän teet, sitä selkeämmäksi seuraava vaihe muuttuu"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus vous agissez, plus l'étape suivante devient claire"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus vous agissez, plus l'étape suivante devient claire"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જેટલું વધુ કરશો, આગળનું પગલું એટલું સ્પષ્ટ બનશે"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ככל שמבצעים יותר, הצעד הבא נעשה ברור יותר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जितना करेंगे, अगला कदम उतना साफ़ होगा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što više radite, sljedeći korak postaje jasniji"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minél többet teszel, annál világosabbá válik a következő lépés"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin banyak Anda melakukannya, semakin jelas langkah berikutnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più fai, più chiaro diventa il passo successivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行するほど、次が明確になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행할수록 다음 단계가 더 분명해집니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जितके अधिक कराल तितकी पुढची पायरी स्पष्ट होईल"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin banyak anda lakukan, semakin jelas langkah seterusnya"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe meer je doet, hoe duidelijker de volgende stap wordt"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mer du gjør, desto tydeligere blir neste steg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Im więcej robisz, tym wyraźniejszy staje się kolejny krok"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais você faz, mais claro fica o próximo passo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais você faz, mais claro fica o próximo passo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu cât faci mai mult, cu atât următorul pas devine mai clar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем больше вы делаете, тем понятнее становится следующий шаг"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím viac toho urobíte, tým jasnejší bude ďalší krok"
