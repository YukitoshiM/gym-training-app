    "domain_catalog.ac6c2ce3f8a7": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:247\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بثني مرفقيك وتصويبهما فوق رأسك دون فتحهما كثيرًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobleu i estireu els colzes per sobre del cap sense obrir-los massa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepřetěžujte lokty, ohýbejte a protahujte je nad hlavou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå at bøje for meget i albuerne, og bevæg dem op og ned over hovedet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Überdehne deine Ellbogen nicht und bewege deine Arme in der Schulterregion auf und ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην ανοίγετε υπερβολικά τους αγκώνες σας, αλλά κάντε εναλλασσόμενες κινήσεις με τους αγκώνες πάνω από το κεφάλι."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid overextending your elbows and alternate bending and straightening them at head level."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid overextending your elbows and alternate bending and straightening them at head level."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid overextending your elbows and alternate bending and straightening them at head level."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid overextending your elbows and alternate bending and straightening them at head level."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No abrir demasiado los codos, sino realizar movimientos de flexión y extensión en la parte superior del brazo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No abrir demasiado los codos, sino realizar movimientos de flexión y extensión en la parte superior del brazo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä avaa kyynärpäitä liikaa, taivuta niitä päällä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pliez pas trop vos coudes, mais faites des mouvements avec vos coudes au-dessus de votre tête."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pliez pas trop vos coudes, mais faites des mouvements avec vos coudes au-dessus de votre tête."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને વધારે ખુલ્લું ન રાખો, પરંતુ માથા પર હાથને ઉપર-નીચે કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא לפתוח את הכתף יותר מדי, ולשלוט במיקום של הכתף מעל הראש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी को ज्यादा न खोलें, बल्कि अपने सिर के ऊपर अपनी कोहनी को ऊपर-नीचे करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne previše otvarajte ruke, već savijte i ispravljajte ruke iznad glave."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne nyissa túl a karokat, és hajtja meg és kinyújtva a karokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak terlalu membuka siku, lalu menekuk dan meluruskan lengan di atas kepala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non aprire troppo i gomiti, ma muovi i gomiti su e giù sopra la testa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘を開きすぎず、頭上で肘を曲げ伸ばしする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔꿈치가 너무 벌어지지 않도록 머리 위에서 팔꿈치를 앞뒤로 움직입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हाता जास्त वाकवू नका, डोक्याच्या वर हाताची हालचाल करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan terlalu menekuk siku, tetapi gerakkan siku di atas kepala."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg ervoor dat je ellebogen niet te veel worden gebogen, en oefen met het buigen en strekken van je ellebogen boven je hoofd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå å overstrekke albuene, og beveg dem opp og ned over hodet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zginaj łokcia zbyt mocno, a jedynie delikatnie go zginaj, wykonując ruch w górę i w dół nad głową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não exagere na flexão dos cotovelos e faça movimentos com os braços acima da cabeça."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não exagere na flexão dos cotovelos e faça movimentos com os braços acima da cabeça."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu depăși limita de mișcare a umerilor și flexează ușor umerii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сгибайте локти слишком сильно, а выполняйте движения над головой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenechajte sa príliš rozpažiť v ramienach, ohýbajte a rozpažujte ramená nad hlavou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne odpirajte roke preveč, bodite pozorni na položaj rok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna inte armbågen för mycket, böj och sträck på armen över huvudet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை அதிகமாகத் திறக்காமல், தலையின் மேல் கையை மடக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భుజాలను ఎక్కువగా తెరవకుండా, తల పైన భుజాలను వంచండి మరియు సాగదీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลีกเลี่ยงการงอข้อศอกมากเกินไป และให้ข้อศอกอยู่ในแนวเดียวกับศีรษะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirseklerinizi çok fazla açmayın ve başınızın üzerinde dirseklerinizi hareket ettirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не згинайте руки надмірно, а робіть рухи руками над головою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gập khuỷu tay quá nhiều, thay vào đó tập trung vào việc điều chỉnh khuỷu tay ở trên đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要过度弯曲肘部，在头顶上进行肘部的上下运动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要過度彎曲肘部，在頭部上方進行肘部活動"
          }
        }
      }
    },
    "domain_catalog.ac8f9d14bf9a": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:60\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الوسادة بمرفقك أو ساعدك وأغلق ذراعك أمام صدرك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Premeu el coixinet amb el colze o l'avantbraç i tanqueu el braç davant del pit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte lokty nebo předloktí k tlačení na podložku a zatáhněte paže směrem k hrudníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug albuerne eller underarmen til at presse puden mod kroppen, og luk armene sammen foran brystet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke den Pad mit deinen Ellbogen oder Unterarmen und schließe deine Arme vor der Brust."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χτυπήστε το μαξιλάρι με τους αγκώνες ή τον εξωτερικό βραχίονα και κλείστε τα χέρια μπροστά στο στήθος."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Press on the pad with your elbow or forearm and close your arms at chest level."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Press on the pad with your elbow or forearm and close your arms at chest level."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Press on the pad with your elbow or forearm and close your arms at chest level."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Press on the pad with your elbow or forearm and close your arms at chest level."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Presionar el cojín con los codos o el antebrazo y cerrar el brazo frente al pecho."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Presionar el cojín con los codos o el antebrazo y cerrar el brazo frente al pecho."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nappaa käsipainolla, pidä se lähellä rintaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le coussin avec vos coudes ou votre avant-bras, puis fermez votre bras devant vous."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le coussin avec vos coudes ou votre avant-bras, puis fermez votre bras devant vous."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથ અથવા હાથની અંદરના ભાગથી પેડને દબાવો અને છાતી પર હાથને લાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפעיל לחץ על המגן באמצעות הכתף או הזרוע, ולסגור את הזרוע מול החזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी या पहले हाथ का उपयोग करके पैड को दबाएं और अपने सीने के सामने अपने हाथ को बंद करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savijte ruke i pritisnite jastučić prema prsima, zatvarajući ruke pred tijelom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja a párnát a karokkal vagy az ulnakkal, majd zárja a kezet a mell előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menekan bantalan dengan siku atau lengan bawah, lalu menutup lengan di depan dada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione il cuscino con i gomiti o l'avambraccio e chiudi le braccia davanti al petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘または前腕でパッドを押し、胸の前で腕を閉じる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔꿈치 또는 앞쪽 팔꿈치로 패드를 밀어 가슴 앞으로 팔을 모읍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हाताने किंवा मनगटाने पॅडवर दाब द्या आणि छातीसमोर हात बंद करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menekan pad dengan siku atau lengan bawah, lalu menutup lengan di hadapan dada."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Duw met je ellebogen of onderarmen tegen het pad en sluit je armen voor je borst."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy albuene eller forarmen og press puten mot brystet, mens du lukker armen foran deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystaj łokieć lub przedramię do naciskania na poduszkę, a następnie zamknij rękę wzdłuż klatki piersiowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os cotovelos ou o antebraço para pressionar o apoio e feche o braço em frente ao peito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os cotovelos ou o antebraço para pressionar o apoio e feche o braço em frente ao peito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adu palmasul la piept și închide brațele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прижмите подушку к локтям и закройте руки перед собой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite lakte alebo predloktie na stlačenie vankúša a zatvorte ruky pred hrudníkom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na položaj rok in pritisnite blazinico z ramo, nato pa zaprite ramo pred telesom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck med armbåge eller underarm mot paddan och dra armen framåt mot bröstet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை மடக்கி, மார்புக்கு முன்னால் கையை மூடி, அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులు లేదా ముందు చేతితో ప్యాడ్‌ను నొక్కడం, ఛాతీ దగ్గర చేతులను మూయడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ข้อศอกหรือแขนในการดันแผ่นรอง และปิดแขนไว้ด้านหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirsekleriniz veya ön kollarınızla yeleği itin ve kolunuzu göğsünüzün önüne doğru çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть на подушку руками або передпліччями та закрийте руки перед грудьми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gập khuỷu tay hoặc trước cánh tay để đẩy đệm, sau đó đưa tay về phía ngực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手掌按压垫，并将手臂向前收紧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手掌按壓墊，並將手臂向前收攏"
          }
        }
      }
    },
