        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не скручивайте спину слишком сильно, поворачивайте корпус в стороны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenechajte sa preťažiť, otáčajte trupom v ľavom a pravom smere."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne preobremenite hrba,nato pa se nagnete z telesom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik att översträck ryggen och vrid kroppen åt sidorna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் முதுகை அதிகமாக வளைக்காமல், உடலின் மையத்தை இடது மற்றும் வலது பக்கமாக திருப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నును ఎక్కువగా వంచకుండా, శరీరాన్ని ఎడమ మరియు కుడి వైపుకు తిప్పండి."
