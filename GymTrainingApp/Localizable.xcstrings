    "core_ui.6d1f0a3fcc4b": {
      "comment": "GymTrainingApp/Features/Onboarding/AppTutorialView.swift:50\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "من السجل بأكمله، سنقترح تغييرات جيدة، والركود، والمعلومات المفقودة، بالإضافة إلى الخطوات التالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de tot el registre, suggerirem bons canvis, estancaments i informació que falta, així com els passos següents."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě vašich záznamů navrhujeme, jak pokračovat: pozitivní změny, stagnace nebo chybějící informace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på dine registreringer, vil jeg foreslå positive ændringer, stagnation eller manglende information samt næste skridt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Ihrer gesamten Aufzeichnung können wir positive Veränderungen, Stagnation oder fehlende Informationen sowie einen Vorschlag für den nächsten Schritt erkennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με βάση τις καταγραφές, προτείνουμε θετικές αλλαγές, σταθερότητα ή ελλείψεις πληροφοριών και την επόμενη κίνηση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your recorded data, we can identify positive changes, plateaus, and areas for improvement. We will also suggest the next best step."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your recorded data, we can identify positive changes, plateaus, and areas for improvement. We will also suggest the next best step."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your recorded data, we can identify positive changes, plateaus, and areas for improvement. We will also suggest the next best step."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your recorded data, we can identify positive changes, plateaus, and areas for improvement. We will also suggest the next best step."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en tus registros, te sugerimos mejoras, estancamiento o información faltante."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en tus registros, te sugerimos mejoras, estancamiento o información faltante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko tallennetusta tiedosta voidaan päätellä, onko kehitystä tapahtunut, onko tilanne pysynyt samana tai onko tietoa puuttuu. Ehdotamme seuraavaa toimintaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la base de vos enregistrements, nous vous proposons des améliorations, une stabilisation ou des informations manquantes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la base de vos enregistrements, nous vous proposons des améliorations, une stabilisation ou des informations manquantes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંપૂર્ણ રેકોર્ડમાંથી, સારા ફેરફારો, સ્થિરતા અને ખૂટતી માહિતી તેમજ આગામી પગલાની ભલામણ કરવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתוך הרשום, אציע שינויים חיוביים, הישארות או מידע חסר, וגם את ההמלצה הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड में, हम आपके अच्छे बदलावों, स्थिर स्थिति और लापता जानकारी के आधार पर सुझाव देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na temelju svih podataka, predlagamo pozitivne promjene, stagnaciju ili nedostatak informacija te sljedeći korak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatok alapján javaslatok a fejlődés, változatosság vagy hiányzó információk esetén."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan catatan, kami menyarankan perubahan positif, stagnasi, atau informasi yang kurang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizzando i dati, possiamo suggerire miglioramenti, stabilità o aree di attenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録全体から、良い変化・停滞・不足情報と次の一手を提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 기록을 바탕으로, 긍정적인 변화, 정체, 부족한 정보와 다음 단계를 제안합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपूर्ण रेकॉर्डमधून, चांगल्या बदलांचे, स्थिर राहण्याचे आणि अपूर्ण माहितीचे विश्लेषण करून पुढील सूचना देतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan rekod, kami cadangkan perubahan positif, stagnasi, dan maklumat yang kurang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van uw gegevens, stel ik verbeteringen, stagnatie of ontbrekende informatie voor."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Basert på registrerte data, foreslår vi positive endringer, stagnasjon eller mangler, samt neste steg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie wszystkich wpisów, proponujemy pozytywne zmiany, stabilizację lub brak informacji oraz kolejne kroki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base no seu registro, podemos identificar melhorias, estabilidade ou informações faltantes e sugerir o próximo passo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base no seu registro, podemos identificar melhorias, estabilidade ou informações faltantes e sugerir o próximo passo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe baza înregistrărilor, vă propunem îmbunătățiri, stagnare sau lipsă de informații și următoarea acțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На основе вашей записи, предлагаем следующие рекомендации: улучшение, стагнация или недостаток информации."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe záznamov navrhujeme, či došlo k zlepšeniu, stagnácii alebo nedostatku informácií."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi zapisanih podatkov predlagam, da se izboljšate, ostanete na istem nivoju ali pa poskušate popraviti pomanjke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat på dina inskrivningar, föreslår vi positiva förändringar, stagnation eller bristande information samt nästa steg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவில் இருந்து, நல்ல மாற்றங்கள், ஸ்திரத்தன்மை மற்றும் குறைபாடுகள் பற்றிய தகவல்களையும், அடுத்த கட்டத்திற்கான பரிந்துரைகளையும் காணலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డుల నుండి, మంచి మార్పులు, స్థిరత్వం, మరియు తక్కువ సమాచారం మరియు తదుపరి చర్యలను సూచిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากข้อมูลที่บันทึก, เราจะแนะนำถึงการเปลี่ยนแปลงที่ดี, การคงที่, และข้อมูลที่ขาดหายไป รวมถึงแนวทางต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlarınızdan, olumlu değişiklikler, istikrar veya eksik bilgiler ve bir sonraki adımı öneriyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі записів, пропоную позитивні зміни, стагнацію або відсутність інформації, а також наступний крок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựa trên dữ liệu đã ghi, chúng tôi sẽ đưa ra các gợi ý về sự tiến bộ, ổn định hoặc thiếu thông tin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从整体记录中，提供好的变化、停滞和不足信息以及下一步行动建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "从整体记录中，提供好的变化、停滞和不足信息以及下一步行动建议。"
          }
        }
      }
    },
