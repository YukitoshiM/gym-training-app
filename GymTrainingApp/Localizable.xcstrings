    "training.4343c0de2bfd": {
      "comment": "GymTrainingApp/Features/Plans/PlanEditorView.swift:729\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يرشدك Apple Watch خلال أوقات الرفع والخفض المحددة مع 1 إلى 3 أحاسيس لمسية في الثانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch us guiarà a través dels temps de pujada i baixada establerts amb 1 a 3 sensacions tàctils per segon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch vás upozorní na změny, které jste nastavili (např. 1-3x dotykem za sekundu)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch guider dig med 1-3 berøringer pr. sekund for at justere op/ned-tiden, der er indstillet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Apple Watch informiert Sie über die angepassten Aufwärts-/Abwärtszeiten (1–3 Berührungen pro Sekunde)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Watch θα σας υπενθυμίζει, μία έως τρεις φορές ανά δευτερόλεπτο, για να αυξήσετε ή να μειώσετε την ένταση, σύμφωνα με τις ρυθμίσεις που έχετε κάνει."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Watch will guide you with 1-3 tactile sensations per second, based on the up/down times set in the Apple Watch."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Watch will guide you with 1-3 tactile sensations per second, based on the up/down times set in the Apple Watch."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Watch will guide you with 1-3 tactile sensations per second, based on the up/down times set in the Apple Watch."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Watch will guide you with 1-3 tactile sensations per second, based on the up/down times set in the Apple Watch."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Watch te indicará las acciones de subir/bajar con 1 a 3 toques por segundo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El Apple Watch te indicará las acciones de subir/bajar con 1 a 3 toques por segundo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch näyttää 1–3 kertaa sekunnissa kosketuksen avulla, milloin nousu- ja laskumäärät ovat saavuttaneet asetettuja arvoja."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Apple Watch vous guidera à chaque fois que vous interagissez avec elle, une fois toutes les 1 à 3 secondes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Apple Watch vous guidera à chaque fois que vous interagissez avec elle, une fois toutes les 1 à 3 secondes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch દ્વારા સેટ કરેલા ઉપર-નીચે થતા સમયને, 1 સેકન્ડમાં 1 થી 3 વખત સ્પર્શ દ્વારા દર્શાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch יציג את זמני העלייה והירידה שהוגדרו, באמצעות 1 עד 3 הקשות בשנייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch द्वारा निर्धारित ऊपर-नीचे करने का समय, 1 सेकंड में 1-3 बार स्पर्श के माध्यम से प्रदर्शित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch će vas obavještavati o podizanju/spuštanju, 1 do 3 puta po sekundi, putem dodira."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Watch beállított emelési/csökkentési időt 1 másodperc alatt 1-3 érintéssel jelenti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch akan memberikan panduan melalui sentuhan 1 hingga 3 kali per detik untuk mengatur waktu naik dan turun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Apple Watch ti guiderà con 1-3 tocchi al secondo per indicare i tempi di aumento e diminuzione impostati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchが設定した上げ・下げ時間を、1秒あたり1〜3回の触覚で案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch가 설정한 올림/내리는 시간을 1초마다 촉각으로 안내합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch ने सेट केलेल्या 'वर' आणि 'खाली' वेळेची माहिती 1 सेकंदात 1 ते 3 वेळा स्पर्श करून दर्शवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch akan memberikan maklumat tentang masa naik dan turun dalam 1 hingga 3 sentuhan setiap saat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch geeft 1 tot 3 keer per seconde aan via tactiele feedback wanneer je omhoog of omlaag beweegt, zoals ingesteld in Apple Watch."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch vil gi deg veiledning via 1–3 berøringer per sekund, basert på de angitte opp- og nedtidsinnstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch wyświetla informacje o czasie trwania ćwiczeń (1-3 razy na sekundę) poprzez dotyk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Watch irá guiá-lo com 1 a 3 toques por segundo, para ajustar o tempo de subida e descida definido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Watch irá guiá-lo com 1 a 3 toques por segundo, para ajustar o tempo de subida e descida definido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch vă va indica, o dată la 1-3 secunde, timpul de ridicare/coborâre stabilit de dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch будет напоминать о необходимости поднять/опустить вес каждые 1-3 секунды при касании."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch vás upozorní na pohyb o 1 až 3 sekundy pomocou taktických vibrácií."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch vas bo vodil s 1 do 3 dotiki na sekundo, glede na nastavljene časovne intervale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch visar instruktioner för att öka/minska tiden, 1–3 gånger per sekund via känsel."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch அமைத்த மேல் மற்றும் கீழ் நேரத்தை, ஒவ்வொரு வினாடிக்கு 1 முதல் 3 முறை தொட்டு உணர்த்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch ద్వారా సెట్ చేసిన పైకి/క్రిందికి సమయాన్ని, ప్రతి సెకనుకు 1-3 సార్లు స్పర్శ ద్వారా తెలియజేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch จะแจ้งเตือนเวลาที่ตั้งไว้ในการเพิ่ม/ลด 1 ครั้งต่อวินาที (1-3 ครั้ง)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch, 1 saniyede 1-3 kez dokunma yoluyla, ayarladığınız yukarı/aşağı zamanlarını size bildirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch показує час підйону/спуска (1-3 рази на секунду) через тактильні відчуття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch sẽ thông báo cho bạn về thời gian tăng/giảm cường độ tập luyện, khoảng 1-3 lần mỗi giây bằng cảm giác xúc giác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch将通过每秒1-3次的触觉提示您进行抬升和下降。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch会通过每秒1-3次的触觉提示您抬起和放下时间。"
          }
        }
      }
    },
