    "domain_catalog.f74adb9e882d": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:388\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ ركبتيك مستقيمتين، وارفعي كعبيك وقبضي ساقيك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenir els genolls rectes, aixecar els talons i contraure els panxells."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protažení kolen, zvedněte patu a stáhněte lýtka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stræk knæene og løft hælene, og træk lægmusklerne sammen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Heben Sie den Fuß und strecken Sie das Knie, während Sie die Waden anspannen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανυψώστε τους αστραγάλους σας, διατηρώντας τα γόνατά σας τεντωμένα και συστέλλετε τους γαστροκνημίες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Extend your knees while lifting your heels, then contract your calf muscles."
          }
        },
        "en-CA": {
          "stringUnit": {
