    "health_meals_body_ai.a513563874a0": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:198\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد زاد متوسط وزني الأسبوعي الأخير بسرعة. ومن أجل التحكم في وتيرة الزيادة، فهذا مرشح لخفض الكمية الموصى بها قليلاً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El meu pes mitjà setmanal recent ha augmentat ràpidament. Per tal de controlar el ritme d'augment, aquest és un candidat per reduir lleugerament la ingesta recomanada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše průměrná váha za poslední týden se zvyšuje rychleji, než očekáváme. Doporučujeme mírně snížit doporučenou denní dávku, abyste zpomalili růst."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gennemsnitlige vægtforbrug over den seneste uge er steget hurtigt. For at regulere væksten, kan du overveje at reducere dit kalorieindtag lidt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr durchschnittliches Wochengewicht ist schnell gestiegen. Um den Anstieg zu kontrollieren, können Sie die empfohlene Menge leicht reduzieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέσο βάρος σας την τελευταία εβδομάδα έχει αυξηθεί γρήγορα. Για να ρυθμίσετε τον ρυθμό της αύξης, προτείνουμε μια μικρή μείωση στις θερμίδες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight gain is occurring rapidly. To moderate this increase, consider slightly reducing your calorie intake."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight gain is occurring rapidly. To moderate this increase, consider slightly reducing your calorie intake."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight gain is occurring rapidly. To moderate this increase, consider slightly reducing your calorie intake."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight gain is occurring rapidly. To moderate this increase, consider slightly reducing your calorie intake."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal está aumentando rápidamente. Para controlar el ritmo de aumento, considera reducir ligeramente la ingesta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal está aumentando rápidamente. Para controlar el ritmo de aumento, considera reducir ligeramente la ingesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisen viikon keskimääräinen paino on noussut nopeasti. Jotta kasvunopeus pysyisi hallinnassa, suositeltavaa annosta voidaan pienentää."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire augmente rapidement. Afin de stabiliser cette tendance, il serait préférable de réduire légèrement votre apport calorique."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire augmente rapidement. Afin de stabiliser cette tendance, il serait préférable de réduire légèrement votre apport calorique."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા અઠવાડિયાનો સરેરાશ વજન ઝડપથી વધી રહ્યું છે. વધારાની ગતિને નિયંત્રિત કરવા માટે, આહારની માત્રામાં થોડો ઘટાડો કરવાની સંભાવના છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשקל הממוצע השבועי האחרון גובר במהירות. כדי לייצב את קצב העלייה, זה יכול להיות מועמד להפחתת ההמלצות היומיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले सप्ताह का औसत वजन तेजी से बढ़ रहा है। इसे नियंत्रित करने के लिए, कृपया सेवन की मात्रा को थोड़ा कम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša prosječna težina u posljednjoj tjedni se brzo povećava. Razmislite o smanjenju preporučene količine hranjivih sastojaka kako biste uskladili tempo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utóbbi heti átlag súlyod gyorsan nőtt. Ahhoz, hogy az növekedési ütemet szabályozd, javaslom, hogy csökkentsd a napi bevitel mennyiségét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat badan rata-rata mingguan Anda meningkat dengan cepat. Untuk menyeimbangkan laju peningkatan, pertimbangkan untuk mengurangi asupan kalori sedikit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo peso medio settimanale è in rapida aumento. Per stabilizzare il ritmo, potresti voler ridurre leggermente l'apporto calorico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近の週平均体重が速めに増えています。増加ペースを整えるため、摂取目安を少し抑える候補です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 주 평균 체중이 빠르게 증가하고 있습니다. 증가 속도를 조절하기 위해 섭취 권장량을 조금 줄이는 후보입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील आठवड्यातील सरासरी वजन वेगाने वाढत आहे. त्यामुळे, आहारात थोडी घट करून योग्य दिशेने प्रगती करावी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Purata berat mingguan anda meningkat dengan cepat. Untuk menstabilkan kadar peningkatan, mungkin perlu mengurangkan jumlah pengambilan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw gemiddelde gewicht over de afgelopen week is snel toegenomen. Om een stabiele groei te bevorderen, kan het aan te raden zijn om uw calorie-inname iets te verminderen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gjennomsnittlige vekt har gått opp raskt den siste uken. For å regulere veksten, vurder å redusere anbefalt inntak litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnia waga w ostatnim tygodniu jest znacznie wyższa. Proszę zmniejszyć zalecaną ilość spożycia, aby kontrolować wzrost."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal está aumentando rapidamente. Para regular o ritmo de aumento, considere reduzir ligeiramente a ingestão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal está aumentando rapidamente. Para regular o ritmo de aumento, considere reduzir ligeiramente a ingestão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În ultima săptămână, greutatea medie a crescut rapid. Pentru a controla ritmul creșterii, puteți lua în considerare reducerea ușoară a aportului caloric."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш средний вес за последнюю неделю увеличивается слишком быстро. Чтобы сбалансировать темп роста, можно немного уменьшить рекомендуемое количество калорий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša priemerná hmotnosť za poslednú týždeň rýchlo stúpla. Aby ste udržali stabilný rast, zvážte mierne zníženie odporúčanej dávky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša povprečna telesna teža zadnjih tednikov se hitro povečuje. Za stabilizacijo rasta, poskusite nekoliko zmanjšati priporočen dnevni odmerek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din genomsnittliga vikttillväxt under den senaste veckan är snabbare än förväntat. För att stabilisera tillväxten, kan du minska ditt kaloriintag något."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்திய வார சராசரி எடை வேகமாக அதிகரித்துள்ளது. வேகத்தை சீராக்க, உட்கொள்ளும் அளவை சற்று குறைக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత వారపు సగటు బరువు వేగంగా పెరుగుతోంది. ఈ పెరుగుదల రేటును నియంత్రించడానికి, తీసుకోవలసిన మోతాదును కొద్దిగా తగ్గించడం మంచిది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักเฉลี่ยรายสัปดาห์ของคุณเพิ่มขึ้นอย่างรวดเร็ว ดังนั้นจึงเป็นตัวเลือกในการลดปริมาณที่แนะนำเพื่อให้การเพิ่มมีจังหวะที่เหมาะสม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son haftanın ortalama ağırlığında hızlı bir artış var. Artış hızını dengelemek için, alım miktarını biraz azaltmayı düşünebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середня вага за останній тиждень збільшується досить швидко. Для нормалізації темпу зростання, рекомендується трохи зменшити рекомендоване споживання калорій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trọng lượng trung bình hàng tuần đang tăng nhanh chóng. Đây là một lựa chọn để điều chỉnh tốc độ tăng trọng lượng bằng cách giảm lượng calo tiêu thụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一周的平均体重迅速上升。为了控制增长速度，建议稍微减少摄入量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一週的平均體重快速上升。為了控制增長速度，建議稍微減少攝取量。"
          }
        }
      }
    },
