    "health_meals_body_ai.aa2ce729eb99": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:545\nhr: NLLB fallback used because TranslateGemma mixed writing systems; human review required.\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يعتبر كل من تقدير كمية صورة الوجبة واستهلاك الطاقة للصحة قيمًا مرجعية. تحقق من المتوسطات الأسبوعية، وليس اليومية فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant l'estimació de la quantitat de la foto de l'àpat com el consum energètic de Salut són valors de referència. Consulteu les mitjanes setmanals, no només diàries."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad množství a spotřeby energie v aplikaci Health jsou pouze orientační hodnoty. Prohlédněte si je nejen denně, ale i průměrně týdně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimeringen af mængden af måltider og forbrugt energi er kun vejledende. Tjek det på ugebasis, ikke kun for én dag."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schätzung der Menge und der Energieverbrauch im Health sind nur Richtwerte. Bitte überprüfen Sie dies täglich, aber auch über die Woche."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και οι δύο εκτιμήσεις ποσότητας και ενέργειας που καταναλώθηκε στο Apple Health είναι απλώς ενδεικτικές. Παρατηρήστε την εβδομαδιαία μέση τιμή, όχι μόνο μία ημέρα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the estimated quantity of meal photos and the consumption of energy in Health are reference values. Please check on a weekly basis, not just daily."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the estimated quantity of meal photos and the consumption of energy in Health are reference values. Please check on a weekly basis, not just daily."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the estimated quantity of meal photos and the consumption of energy in Health are reference values. Please check on a weekly basis, not just daily."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the estimated quantity of meal photos and the consumption of energy in Health are reference values. Please check on a weekly basis, not just daily."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas estimaciones de cantidad y consumo de energía de Health son valores orientativos. Consulta los resultados a diario, pero también semanalmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas estimaciones de cantidad y consumo de energía de Health son valores orientativos. Consulta los resultados a diario, pero también semanalmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruokakuvan määrän ja Healthin kulutetun energian arviot ovat vain suuntaa antavia. Tarkista päivittäisen lisäksi viikoittainen keskiarvo."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations de quantité et la consommation d'énergie de Health sont des valeurs indicatives. Veuillez consulter quotidiennement, mais aussi en moyenne hebdomadaire."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations de quantité et la consommation d'énergie de Health sont des valeurs indicatives. Veuillez consulter quotidiennement, mais aussi en moyenne hebdomadaire."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખોરાકની તસવીરની માત્રાનો અંદાજ અને હેલ્થમાં વપરાયેલી ઊર્જા બંને ફક્ત સંદર્ભ મૂલ્યો છે. દરરોજ નહીં, પરંતુ અઠવાડિયાના સરેરાશમાં તપાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכת כמות ותוכן הארוחה, וגם צריכת אנרגיה ב-Health הם הערכות בלבד. בדוק לאורך שבוע ולא רק יום אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन की तस्वीरों की मात्रा का अनुमान और स्वास्थ्य में खपत ऊर्जा दोनों ही केवल अनुमानित मान हैं। कृपया इसे दिन के बजाय सप्ताह के औसत पर देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smatrajte količinu fotografije hrane i potrošnju energije u zdravlju, i to ne samo dnevno, nego i tjedno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az étel mennyiségének és az energiafelhasználásának becslése mindkettő tájékoztató jel, amelyeket naponta, hanem heti átlagban is ellenőriznie kell."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimasi jumlah dan konsumsi energi kesehatan dari foto makanan adalah nilai referensi. Periksa secara mingguan, bukan hanya harian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stima della quantità delle foto dei pasti e il consumo energetico di Health sono solo valori indicativi. Controllali su base giornaliera, non solo settimanale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事写真の量推定とHealthの消費エネルギーはいずれも参考値です。1日だけでなく週平均で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사 사진의 양 추정 및 건강 소모 에너지는 모두 참고 값입니다. 1일뿐만 아니라 주 평균으로 확인해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आहाराच्या फोटोंमधील अंदाजित प्रमाण आणि 'हेल्थ' मधील ऊर्जेचा वापर हे केवळ अंदाजे आकडे आहेत. दिवसाव्यतिरिक्त, आठवड्याच्या सरासरी आकडेवारी तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua-duanya adalah anggaran. Sila semak setiap hari, bukan hanya mingguan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De schatting van de hoeveelheid en de energieverbruik in Health zijn slechts indicaties. Controleer dit op een wekelijkse basis, niet alleen per dag."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimeringen av mengde og forbruk av energi fra måltider er kun veiledende. Sjekk både daglig og ukegjennomsnitt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowane ilości i zużycie energii w oparciu o zdjęcia posiłków są wartościami orientacyjnymi. Sprawdź je na poziomie tygodnia, a nie tylko jednego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estimativa da quantidade e o consumo de energia na saúde são apenas valores de referência. Verifique diariamente, mas também em média semanal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A estimativa da quantidade e o consumo de energia na saúde são apenas valores de referência. Verifique diariamente, mas também em média semanal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimarea cantității de mâncare și consumul de energie, prezentate în aceste rezultate, sunt valori orientative. Verificați-le pe parcursul săptămânii, nu doar într-o singură zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка количества и расхода энергии при питании – это ориентировочные значения. Проверяйте их не только в течение дня, но и в среднем за неделю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhad množstva a spotreby energie pri strave je len orientačný údaj. Skontrolujte aj priemerné hodnoty za týždeň, nie len za jeden deň."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocenjevanje količine hrane in porabljene energije v aplikaciji Health sta samo približni vrednosti. Preverjajte jih ne le na dan, ampak tudi povprečno za teden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Både uppskattningen av mängden och energiförbrukningen i Health är endast ungefärliga värden. Kontrollera istället veckans genomsnitt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவு புகைப்படத்தின் அளவு மற்றும் Health-ன் ஆற்றல் நுகர்வு ஆகிய இரண்டும் தோராயமான மதிப்பீடுகள் மட்டுமே. ஒரு நாள் மட்டுமல்ல, வாரத்திற்கான சராசரி மதிப்பையும் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆహార ఫోటోల పరిమాణం అంచనా మరియు ఆరోగ్య వినియోగ శక్తి రెండూ సూచన విలువలు మాత్రమే. రోజుకు కాకుండా వారపు సగటుతో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปริมาณและค่าพลังงานของรูปภาพอาหารเป็นเพียงค่าประมาณ โปรดตรวจสอบรายวัน รวมถึงค่าเฉลี่ยรายสัปดาห์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğün fotoğrafının miktarı ve Health'teki enerji tüketimi, her ikisi de yaklaşık değerlerdir. Günlük olarak değil, haftalık ortalama olarak kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка кількості та споживання енергії при їжі – це лише орієнтовні значення. Перевіряйте їх не тільки щодня, а й у середньому за тиждень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả ước tính số lượng và mức tiêu hao năng lượng của Health đều là giá trị tham khảo. Vui lòng kiểm tra hàng ngày, cũng như trung bình theo tuần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "饮食照片的数量估算和与Health的消耗能量均为参考值。请以一天平均为准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "飲食照片的數量估算和與Health的消耗能量，都是參考值。請以一天平均為基準。"
          }
        }
      }
    },
