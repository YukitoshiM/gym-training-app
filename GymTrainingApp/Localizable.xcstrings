        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשל חלוף זמן מהנתונים האחרונים, ההערכה אינה מדויקת וכוללת טווח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम वास्तविक माप के बाद अवधि समाप्त होने के कारण, परिवर्तन को निश्चित रूप से नहीं मान लिया जाता है और एक सीमा निर्धारित की जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbog dugog vremenskog razdoblja bez prethodnih mjerenja, promjene se procjenjuju s određenim marginama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó tényleges mérés óta eltelt idő miatt, az változást nem lehet biztosan megállapítani, ezért a tartományt szélesebben használjuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena waktu antara pengukuran terakhir, perubahan tidak dapat dipastikan dan memiliki rentang tertentu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A causa del tempo trascorso dall'ultima misurazione, la variazione è indicata in modo approssimativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の実測値から期間が空いているため、変化を断定せず幅を持たせています。"
