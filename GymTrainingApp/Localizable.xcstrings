    "health_meals_body_ai.9f8623da2f24": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:722\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى المحاولة مرة أخرى لاحقا. إذا استمرت المشكلة، يرجى التحقق من حالة نموذج خادم الذكاء الاصطناعي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, torna-ho a provar més tard. Si el problema persisteix, comproveu l'estat del model del servidor AI."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se to opakuje, zkontrolujte stav modelu na serveru AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igen efter en stund. Hvis det fortsætter, skal du kontrollere AI-serverens modelstatus."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie bitte und versuchen Sie es erneut. Wenn dies weiterhin der Fall ist, überprüfen Sie den Status des KI-Servers."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν συνεχίσετε, ελέγξτε την κατάσταση του μοντέλου στον AI server."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server model status."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server model status."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server model status."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server model status."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si continúa, compruebe el estado del modelo en el servidor de IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si continúa, compruebe el estado del modelo en el servidor de IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos haluat yrittää uudelleen, odota hetki. Jos ongelma jatkuu, tarkista AI-palvelimen mallin tila."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cela persiste, vérifiez l'état du modèle sur le serveur AI."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cela persiste, vérifiez l'état du modèle sur le serveur AI."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો પરિણામો સુધારવા માટે ફરી પ્રયાસ કરો, તો AI સર્વરના મોડેલની સ્થિતિ તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם זה ממשיך, אנא בדוק את מצב המודל של השרת AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि जारी रखते हैं, तो AI सर्वर के मॉडल स्थिति की जांच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Molimo, pokušajte ponovno nakon određenog vremena. Ako to nastavite, provjerite stanje modela na AI serveru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ez nem működik, próbálja újra, és ellenőrizze az AI szerver modell állapotát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika masih belum berhasil, periksa status model pada server AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necessario, riprova dopo un po'. Se continua, verifica lo stato del modello sul server AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間をおいて再試行してください。続く場合はAIサーバーのモデル状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 간격을 두고 다시 시도하십시오. 계속되는 경우 AI 서버 모델 상태를 확인하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही वेळ थांबून पुन्हा प्रयत्न करा. जर असेच होत असेल, तर AI सर्व्हर मॉडेलची स्थिती तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda masih mahu mencuba, sila semak status model pada pelayan AI."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het opnieuw na een tijdje. Als dit blijft aanhouden, controleer dan de status van het AI-servermodel."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igjen etter en stund. Hvis det fortsetter, sjekk statusen til AI-serveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli problem nadal występuje, sprawdź stan modelu serwera AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se persistir, verifique o estado do modelo no servidor AI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se persistir, verifique o estado do modelo no servidor AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă problema persistă, verificați starea modelului serverului AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если проблема не исчезла, попробуйте еще раз через некоторое время. Если это продолжается, проверьте состояние модели на сервере AI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to budete opakovať, overte si stav modelu na AI serveri."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čez nekaj časa poskusite znova. Če to še vedno poteka, preverite stanje modela na AI strežniku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du behöver göra om det, kontrollera AI-serverns status."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கொஞ்சம் நேரம் கழித்து மீண்டும் முயற்சிக்கவும். தொடர்ந்து இருந்தால், AI சேவையகத்தின் மாதிரியின் நிலையை சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొంత సమయం వేచి ఉండి మళ్ళీ ప్రయత్నించండి. కొనసాగితే, AI సర్వర్ మోడల్ స్థితిని తనిఖీ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากยังคงทำซ้ำ โปรดตรวจสอบสถานะของโมเดลบนเซิร์ฟเวอร์ AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir süre sonra tekrar deneyin. Devam ediyorsa, AI sunucusunun model durumunu kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо потрібно, повторіть через деякий час. Якщо це продовжується, перевірте стан моделі на сервері AI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu vẫn tiếp tục, vui lòng kiểm tra trạng thái mô hình trên máy chủ AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后再试。如果继续，请检查AI服务器的模型状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后再试。如果继续，请检查AI服务器的模型状态。"
          }
        }
      }
    },
