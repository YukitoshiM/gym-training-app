            "value": "రోగ నిర్ధారణ లేకుండా పంపండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งโดยไม่แนบบันทึกการวินิจฉัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanı verilerini göndermeden gönder"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати без діагностичних даних"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi mà không có nhật ký chẩn đoán"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不附带诊断信息发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不附上診斷記錄"
          }
        }
      }
    },
    "support.feedback_sensitive_warning": {
      "comment": "GymTrainingApp/Features/Settings/InAppFeedbackView.swift:68\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: GPT-5.6 Lunaで日本語残留を補修。健康・課金・プライバシー表現は公開後も人手確認対象。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: GPT-5.6 Lunaで日本語残留を補修。健康・課金・プライバシー表現は公開後も人手確認対象。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى عدم تضمين معلومات شخصية مثل القياسات أو تفاصيل النظام الغذائي والصور والمحادثات مع الذكاء الاصطناعي وكلمات المرور."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No incloure dades físiques, contingut alimentari, fotos, conversa amb IA ni informació d'autenticació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprovádějte žádné údaje o těle, stravě, fotografiích, rozhovorech s AI ani přihlašovací údaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medtag ikke kropsdata, kostoplysninger, billeder, samtaler med AI eller loginoplysninger."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte geben Sie keine Körperdaten, Ernährungsinformationen, Fotos, Gespräche mit der KI oder Anmeldeinformationen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην συμπεριλάβετε πληροφορίες σχετικά με το σώμα, τη διατροφή, τις φωτογραφίες, συνομιλίες με την τεχνητή νοημοσύνη ή στοιχεία ελέγχου."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include body measurements, food content, photos, conversations with AI, or authentication information."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include body measurements, food content, photos, conversations with AI, or authentication information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include body measurements, food content, photos, conversations with AI, or authentication information."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include body measurements, food content, photos, conversations with AI, or authentication information."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No incluyas valores corporales, contenido de tus comidas, fotos, conversaciones con AI ni credenciales de acceso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No incluya información sobre el cuerpo, contenido de la dieta, fotos, conversaciones con IA ni datos de autenticación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä kirjoita kehon arvoja, ruokavaliotietoja, kuvia, AI-keskusteluja tai kirjautumistietoja."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "N’incluez pas de données corporelles, de contenu alimentaire, de photos, de conversations avec l’AI ni d’identifiants."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez ne pas inclure d'informations relatives à votre corps, à votre alimentation ou à vos photos, ainsi que des conversations avec l'IA et des informations d'authentification."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરના આંકડા, આહારની માહિતી, ફોટા, AI સાથેની વાતચીત અને પ્રમાણીકરણ માહિતી પ્રદાન કરશો નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין לציין מידע אישי, כולל נתונים גופניים, תוכן תזונה, תמונות, שיחות עם AI או פרטי התחברות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर के आँकड़े, भोजन का विवरण, फ़ोटो, AI के साथ वार्तालाप या प्रमाणीकरण संबंधी जानकारी शामिल न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemojte navoditi tjelesne podatke, sadržaj prehrane, fotografije, razgovore s AI-jem ni podatke za prijavu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne adjon meg fizikai, élelmiszeri, képi, AI-val kapcsolatos vagy hiteles információkat. "
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan mencantumkan nilai tubuh, isi makanan, foto, percakapan dengan AI, atau informasi autentikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non includere dati relativi al corpo, alla dieta, foto, conversazioni con l'IA o informazioni di autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身体値、食事内容、写真、AIとの会話、認証情報は記載しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신체 수치, 식사 내용, 사진, AI와의 대화, 인증 정보는 입력하지 마세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे शारीरिक आणि आरोग्य संबंधित तपशील, जेवण, फोटो, AI च संभाषण किंवा तुमचा संपर्क क्रमांक यात समाविष्ट करू नका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan sertakan maklumat berkaitan badan, makanan, foto, perbualan dengan AI, atau maklumat pengautentikan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef geen informatie over lichaamsmetingen, voeding, foto's, gesprekken met AI of authenticatietoken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke oppgi kroppsmålinger, matinnhold, bilder, samtaler med AI eller påloggingsinformasjon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie należy podawać danych dotyczących ciała, diety, zdjęć, rozmów z AI ani informacji o uwierzytelnianiu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não inclua métricas corporais, informações sobre alimentação, fotos, conversas com a AI ou credenciais de autenticação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não inclua informações sobre o corpo, dieta, fotos, conversas com a IA ou credenciais de autenticação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu includeți valori corporale, informații despre alimentație, fotografii, conversații cu AI sau date de autentificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не указывайте данные о теле, питании, фотографии, разговорах с ИИ и другую личную информацию. Это может быть использовано для идентификации."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neposkytujte informácie o tele, strave, fotkách, rozhovoroch s AI alebo údaje o autentizácii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vključujte telesnih meritev, podatkov o prehrani, fotografij, pogovorov z AI ali poverilnic."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange inte kroppsmått, kostinformation, bilder, samtal med AI eller autentiseringsuppgifter. Detta är känslig information."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடல் அளவீடுகள், உணவு விவரங்கள், புகைப்படங்கள், AI உடனான உரையாடல்கள் அல்லது உள்நுழைவுச் சான்றுகளைச் சேர்க்க வேண்டாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీరానికి సంబంధించిన సంఖ్యలు, ఆహార వివరాలు, ఫోటోలు, AIతో సంభాషణ మరియు ప్రామాణీకరణ సమాచారాన్ని చేర్చవద్దు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดระบุข้อมูลส่วนตัว, ข้อมูลสุขภาพ, รูปภาพ, การสนทนากับ AI และข้อมูลประจำตัว ไม่ให้ปรากฏ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut ölçülerinizi, yeme alışkanlıklarınızı, fotoğraflarınızı, yapay zeka ile olan sohbetlerinizi ve kimlik bilgilerinizi eklemeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вказуйте дані про тіло, інформацію про харчування, фотографії, розмови з AI або облікові дані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng không cung cấp thông tin về cơ thể, chế độ ăn uống, hình ảnh, cuộc trò chuyện với AI hoặc thông tin xác thực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请勿填写身体数据、饮食内容、照片、与 AI 的对话或身份验证信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿提供身體數據、飲食內容、照片、與 AI 的對話或驗證資訊。"
          }
        }
      }
    },
