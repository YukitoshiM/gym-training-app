    "domain_catalog.72208ced79dd": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:281\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوة مع كامل قدمك والقرفصاء مع محاذاة ركبتيك وأصابع قدميك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Trepitja amb tota la planta del peu i posa-te a la gatzoneta amb els genolls i els dits dels peus alineats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postupte nohama a zarovnejte kolena a paty při sklonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå med hele foden og juster knæ og tæer, før du bøjer dig ned."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie Ihre Füße auf und richten Sie Knie und Zehen aus, bevor Sie sich beugen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθείτε με τα πόδια σας και ευθυγραμμίστε τους αστραγάλους και τις άκρες των ποδιών σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on your entire foot, align your knees and toes, and squat."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on your entire foot, align your knees and toes, and squat."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on your entire foot, align your knees and toes, and squat."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand on your entire foot, align your knees and toes, and squat."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca los pies completamente y alinea las rodillas y los dedos de los pies antes de agacharte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca los pies completamente y alinea las rodillas y los dedos de los pies antes de agacharte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskeudu koko jalkapohjalla, ja varmista, että polvet ja varpaat ovat samassa linjassa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pencher en alignant les pieds et les chevilles, puis le genou et la pointe du pied."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pencher en alignant les pieds et les chevilles, puis le genou et la pointe du pied."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પગની સપાટી પર ઊભા રહીને, ઘૂંટણ અને પગના અંગૂઠાને એકસાથે રાખીને નમી જાઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להניח את כפות הרגליים ולהתכופף, תוך שמירה על יישור הברכיים והאצבעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पूरे पैर की उंगलियों से ज़मीन पर टिके, और घुटनों और पैर की उंगलियों को एक साथ झुकाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stajte na cijelu podlogu i uskladite položaj koljena i prstiju"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egész talpon állva, és a térd- és ujjszögét egyenletesen tartva, húzz le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri dengan seluruh telapak kaki, sejajarkan lutut dan ujung jari kaki saat membungkuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia i piedi completamente e allinea ginocchia e dita dei piedi prima di piegarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足裏全体で踏み、膝とつま先の向きを揃えてしゃがむ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발 전체로 착지하고, 무릎과 발가락의 방향을 맞춰 앉습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाय आणि गुडघ्यांची दिशा जुळवून जमिनीवर वाका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdiri di seluruh telapak kaki, sejajarkan lutut dan pergelangan kaki sebelum bungkuk."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Stap met je hele voet en zorg ervoor dat je knieën en tenen op dezelfde hoogte zijn voordat je buigt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå på hele foten, juster knær og tær for å bøye deg ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stąpuj na całej powierzchni stóp, upewniając się, że kolana i palce są ustawione prosto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use toda a planta do pé para se abaixar, alinhando os joelhos e os dedos dos pés."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use toda a planta do pé para se abaixar, alinhando os joelhos e os dedos dos pés."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așază-ți picioarele complet și aliniează genunchii și degetele de la picioare în timp ce te apleci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приседать, выпрямив ноги и стопы, чтобы колени и кончики пальцев были параллельны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stúpte celou nohou a zarovnajte kolená a päty pri zdvíhaní"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stojte na celotni stopnji in uskladite položaj kolen ter toe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stå med hela foten och justera knä och tår för att sänka dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பாதத்தின் முழுப் பகுதியையும் பயன்படுத்தி, உங்கள் முழங்கால்கள் மற்றும் கால் விரல்களின் திசையை சீராக வைத்து குனியுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పాదాల అడుగు భాగంతో నడుస్తూ, మోకాళ్లు మరియు కాలి వేళ్ళను ఒకే దిశలో ఉంచి కూర్చోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนบนพื้นทั้งหมด แล้วโค้งตัว โดยให้เข่าและปลายเท้าชี้ไปในแนวเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayaklarınızla yere basarak, dizlerinizi ve ayak parmaklarınızı hizalayarak çömelin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стисніть стопами, вирівняйте коліна та п'яти, щоб зігнутися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt chân rộng và giữ cho đầu gối và ngón chân thẳng hàng khi cúi người."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用整个脚底支撑，并保持膝盖和脚尖方向一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用整個腳底踏穩，並將膝蓋和腳趾朝向同一方向彎曲。"
          }
        }
      }
    },
