    "domain_catalog.dc0e85fb5bb9": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:531\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقيق التوازن بين الجسم كله، بما في ذلك ساقيك"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibra tot el cos, incloses les cames"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyvíjejte celé tělo, včetně nohou, vyváženě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træn hele kroppen, inklusive benene, i balance."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gesamten Körper, einschließlich der Beine, ausgewogen trainieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναπτύξτε σωματικά με ισορροπημένο τρόπο, συμπεριλαμβάνοντας και τα πόδια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop legs and the entire body in a balanced way."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop legs and the entire body in a balanced way."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop legs and the entire body in a balanced way."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop legs and the entire body in a balanced way."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla todo el cuerpo, incluyendo las piernas, de forma equilibrada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla todo el cuerpo, incluyendo las piernas, de forma equilibrada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehitä koko kehoa tasapainoisesti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez votre corps de manière équilibrée, y compris les jambes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez votre corps de manière équilibrée, y compris les jambes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પગ સહિત સમગ્ર શરીરને સંતુલિત રીતે વિકસાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפתח את הגוף בצורה מאוזנת, כולל הרגליים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पूरे शरीर को, जिसमें पैर भी शामिल हैं, संतुलित तरीके से विकसित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvijajte tijelo, uključujući noge, ravnomjerno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alsótesten egyensúlyos fejlődést érhetünk el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menumbuhkan seluruh tubuh secara seimbang, termasuk kaki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sviluppare le gambe e il corpo in modo equilibrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脚を含む全身をバランスよく育てる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다리를 포함한 전신을 균형 있게 발달시킵니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संपूर्ण शरीराचा विकास, ज्यात पायचा समावेश आहे, तो संतुलित ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyempurnakan seluruh badan dengan seimbang, termasuk kaki"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Train je hele lichaam, inclusief je benen, op een evenwichtige manier."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Tren hele kroppen, inkludert benene, på en balansert måte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbaj o zrównoważony rozwój całego ciała, w tym nóg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenvolva o corpo de forma equilibrada, incluindo as pernas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenvolva o corpo de forma equilibrada, incluindo as pernas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezvoltați-vă corpul în mod echilibrat, inclusiv picioarele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбалансированно развивайте все тело, включая ноги."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyvíjajte celé telo, vrátane nôh, vyváženým spôsobom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Učinkovito vadite celo telo,vključno z nogami."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Träna hela kroppen, inklusive benen, på ett balanserat sätt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உடலின் அனைத்து பகுதிகளையும் சமமாக வளர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీరాన్ని సమతుల్యంగా పెంచుకోండి, ఇందులో కాళ్లు కూడా ఉంటాయి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูแลพัฒนาร่างกายให้สมดุล ทั้งส่วนบนและส่วนล่าง"
          }
        },
        "tr": {
