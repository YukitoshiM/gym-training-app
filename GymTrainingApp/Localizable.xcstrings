    "health_meals_body_ai.f411122ea062": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:89\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حسابه باستخدام الوزن الذي تم الحصول عليه، وعدد التكرارات، والإيقاع، ونطاق الحركة النسبي، وRPE فقط، ولن يتم منح القيم المفقودة 0 نقطة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es calcularà utilitzant només el pes obtingut, el nombre de repeticions, el tempo, el rang relatiu de moviment i RPE, i els valors que faltin no rebran 0 punts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočítáme hodnoty pouze z dostupných údajů (váha, počet opakování, tempo, relativní rozsah pohybu, RPE). Chybějící hodnoty nezapisujeme jako 0."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnes ud fra vægt, antal, tempo, relativ bevægelsesområde og RPE (Rate of Perceived Exertion), og manglende data sættes til 0."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechnung erfolgt anhand von Gewicht, Anzahl, Tempo, relativer Bewegungsfreiheit und RPE. Fehlende Werte werden mit 0 gewertet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπολογίστε το βάρος, τον αριθμό επαναλήψεων και την ταχύτητα με βάση τα δεδομένα που έχετε συλλέξει, χωρίς να χρησιμοποιείτε μη διαθέσιμες τιμές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing values are not set to 0."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing values are not set to 0."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing values are not set to 0."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing values are not set to 0."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula el volumen, la cantidad, el ritmo y el rango de movimiento relativo utilizando solo los datos disponibles, y no asigna valores cero a los datos faltantes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula el volumen, la cantidad, el ritmo y el rango de movimiento relativo utilizando solo los datos disponibles, y no asigna valores cero a los datos faltantes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasketaan vain paino, toistot, tempo ja suhteellinen liikealue sekä RPE-arvo. Puutteet merkitään 0:ksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculez en utilisant le poids, le nombre de répétitions, le tempo, l'amplitude relative et votre ressenti (échelle RPE). Ne laissez pas de valeurs manquantes à 0."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculez en utilisant le poids, le nombre de répétitions, le tempo, l'amplitude relative et votre ressenti (échelle RPE). Ne laissez pas de valeurs manquantes à 0."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન, સંખ્યા, ગતિ અને સંબંધિત હલનચલનની રેન્જ અને RPE નો ઉપયોગ કરીને ગણતરી કરવામાં આવે છે, અને ખૂટતી કિંમતોને 0 તરીકે દર્શાવવામાં આવતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חישוב על סמך משקל, מספר, קצב, טווח תנועה יחסי ו-RPE בלבד. ערכים חסרים מוגדרים כ-0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, बार, गति और सापेक्ष गति सीमा, और RPE का उपयोग करके गणना करें, और लापता मानों को 0 पर सेट न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunavamo težinu, broj, tempo i relativni raspon pokreta, a također i subjektivnu ocjenu naporom (RPE). Nedostajuće vrijednosti se ne izračunavaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A súlyt, a számot, az ütemet, a relatív mozgási tartományt és az RPE-t felhasználva számoljuk ki, de a hiányzó értékeket 0-ra állítsuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung dengan menggunakan berat, jumlah, tempo, rentang gerak relatif, dan RPE saja. Jangan memberikan nilai 0 untuk data yang hilang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolati solo con peso, numero, ritmo, range di movimento relativo e RPE (Rated Perceived Exertion), senza assegnare 0 a valori mancanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取得できた重量・回数・テンポ・相対可動域・RPEだけで算出し、欠測値は0点にしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수집된 무게, 횟수, 템포, 상대적 움직임 범위, RPE를 기준으로 계산하며, 누락된 값은 0점으로 처리합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, संख्या, गती आणि सापेक्ष हालचाल यानुसार गणना करा आणि काही नोंदी नसेल, तर त्यांना ० (शून्य) मानले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung menggunakan berat, jumlah, kelajuan, julat bergerak relatif dan RPE sahaja, dan jangan gunakan nilai yang hilang sebagai 0."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Berekenen op basis van gewicht, aantal, tempo, relatieve bewegingsbereik en RPE (Rate of Perceived Exertion), waarbij ontbrekende waarden worden aangegeven met 0."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregnes kun ved hjelp av vekt, antall, tempo, relativ bevegelsesområde og RPE (Rate of Perceived Exertion), og manglende verdier blir satt til 0."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczamy na podstawie uzyskanych danych dotyczących wagi, liczby powtórzeń, tempa i względnego zakresu ruchu oraz RPE. Wartości brakujące ustawiamy na 0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula apenas com peso, repetições, tempo e amplitude relativa do movimento, sem atribuir 0 a valores ausentes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula apenas com peso, repetições, tempo e amplitude relativa do movimento, sem atribuir 0 a valores ausentes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculat doar pe baza greutății, numărului, ritmului, amplitudinii relative și a RPE (Rating of Perceived Exertion), fără a atribui valori zero pentru valorile lipsă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитайте объем, вес, количество повторений, относительную амплитуду движения и RPE, не присваивая нулевые значения отсутствующим данным."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypočítajte objem a ďalšie údaje (váha, počet opakovaní, tempo, relatívna rozsiahosť pohybu, RPE) a nezakladajte hodnoty na 0."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunajte s pomočjo doseženih podatkov (teža, število, hitrost, relativni obseg gibanja, RPE). Ne uporabljajte pomanjkanja kot 0."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beräkna med hjälp av vikt, antal, tempo, relativ rörelseomfång och RPE, och sätt alla saknade värden till 0."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடை, எண்ணிக்கை, வேகம், சார்பு இயக்கம் மற்றும் RPE ஆகியவற்றின் அடிப்படையில் கணக்கிடவும், காணாமல் போன மதிப்புகளை 0 ஆக அமைக்க வேண்டாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు, సంఖ్య, వేగం మరియు సాపేక్ష కదలిక పరిధి, RPE ఆధారంగా లెక్కిస్తుంది. తప్పిపోయిన విలువలను 0గా చూపించదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณจากน้ำหนัก, จำนวนครั้ง, ความเร็ว, ช่วงการเคลื่อนไหว และ RPE เท่านั้น ไม่ให้ค่าที่ขาดเป็น 0"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık, tekrar sayısı, tempo ve göreceli hareket aralığı ile RPE değerlerini kullanarak hesaplayın. Eksik değerleri 0 olarak belirlemeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обчислюйте на основі ваги, кількості повторень, темпу та відносного діапазону руху, а також RPE. Не використовуйте нульові значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính toán dựa trên trọng lượng, số lần, nhịp độ, phạm vi vận động tương đối và RPE (Rating of Perceived Exertion), không gán giá trị 0 cho các giá trị bị thiếu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅通过重量、次数、节奏、相对活动范围和RPE进行计算，缺失值不设为0。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仅通过重量、次数、节奏、相对活动范围和RPE进行计算，缺失值不设为0分。"
          }
        }
      }
    },
