    "health_meals_body_ai.0cce0b71e377": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:241\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "وبما أنه لم يتم الحصول على مراحل النوم، فهذه درجة مرجعية تعتمد على الوقت الإجمالي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Com que no s'han obtingut les etapes del son, aquesta és una puntuació de referència basada en el temps total."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože nemáme údaje o fázech spánku, tento výsledek vychází z celkového času."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da søvndata ikke er tilgængelig, er dette et omtrentligt resultat baseret på den samlede tid."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Da die Schlafphasen noch nicht erfasst wurden, handelt es sich um eine Referenzbewertung, die auf der Gesamtdauer basiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λόγω μη διαθέσιμων δεδομένων ύπνου, το σκορ βασίζεται στην συνολική διάρκεια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score based on total time, as sleep stage data has not been obtained."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score based on total time, as sleep stage data has not been obtained."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score based on total time, as sleep stage data has not been obtained."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference score based on total time, as sleep stage data has not been obtained."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Dado que no se han registrado las etapas del sueño, esta es una puntuación de referencia basada en el tiempo total."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Dado que no se han registrado las etapas del sueño, esta es una puntuación de referencia basada en el tiempo total."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska uni- ja palautumistietoja ei ole, tämä on arvio, joka perustuu kokonaismäärään."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce score de référence est basé sur le temps total, car les données de sommeil ne sont pas encore disponibles."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce score de référence est basé sur le temps total, car les données de sommeil ne sont pas encore disponibles."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઊંઘના સ્તર મળ્યા નથી, તેથી કુલ સમય પર આધારિત સંદર્ભ સ્કોર છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכיוון שאין נתוני שינה, מדובר בציון משווה המבוסס על הזמן הכולל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चूंकि नींद का डेटा उपलब्ध नहीं है, इसलिए कुल समय पर आधारित एक अनुमानित स्कोर दिया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budući da nema podataka o fazama spanja, ovo je okvirna ocjena na temelju ukupnog vremena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mivel a különböző fázisok még nem szerepelt, ez egy átlagos pontszám, amely az összes időtartamot figyelembe veszi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena belum ada data tahap tidur, ini adalah skor referensi berdasarkan total waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un punteggio di riferimento basato sul tempo totale, poiché i dati relativi allo stadio del sonno non sono disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠ステージが未取得のため、合計時間を中心にした参考スコアです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 단계가 아직 기록되지 않았으므로, 총 시간을 기준으로 한 참고 점수를 제공합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "झोपेच्या टप्प्यांची माहिती नसल्यामुळे, एकूण वेळेवर आधारित अंदाजित स्कोअर आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah skor anggaran berdasarkan jumlah masa, kerana tahap tidur belum diambil."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat je slaapgegevens nog niet zijn verzameld, is dit een indicatie op basis van de totale tijd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi søvnmønsteret ditt ikke er registrert, er dette en omtrentlig score basert på total tid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze względu na brak danych dotyczących faz snu, wynik jest oparty głównie na całkowitym czasie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como não temos dados de sono, esta é uma pontuação de referência baseada no tempo total."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como não temos dados de sono, esta é uma pontuação de referência baseada no tempo total."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorul este calculat în funcție de timpul total, deoarece nu aveți date despre stadiile somnului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поскольку данные о сне отсутствуют, это ориентировочный результат, основанный на общей продолжительности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzhľadom na nedostatočné údaje o spánku, toto je referenčný skóre založený na celkovom čase."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker nimate podatkov o fazah spanja, je to povzetek, ki se osredotoča na skupno časovno trajanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftersom du inte har registrerat sömnsteg, är detta ett referensresultat baserat på den totala tiden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தூக்க நிலைகள் இன்னும் பெறப்படவில்லை, எனவே மொத்த நேரத்தை அடிப்படையாகக் கொண்ட ஒரு மதிப்பீடு இது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిద్ర దశలను పొందలేకపోతున్నందున, మొత్తం సమయాన్ని ఆధారంగా చేసుకున్న ఒక అంచనా స్కోర్ ఇది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจากยังไม่มีข้อมูลการนอนหลับ จึงเป็นคะแนนอ้างอิงโดยเน้นที่ระยะเวลาทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyku aşamaları henüz kaydedilmediği için, toplam süye dayalı bir referans puanıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оскільки дані про фази сну відсутні, цей показник є орієнтовним, заснованим на загальному часі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì chưa có dữ liệu về giai đoạn giấc ngủ, đây là điểm số tham khảo dựa trên tổng thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于未获取睡眠阶段，因此是基于总时间的参考分数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於沒有取得睡眠階段，因此這是一個以總時間為中心的參考分數。"
          }
        }
      }
    },
