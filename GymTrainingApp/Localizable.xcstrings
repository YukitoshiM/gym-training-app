    "training.a9ba22011245": {
      "comment": "GymTrainingApp/Features/Plans/PlanEditorView.swift:593\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الوزن الإضافي. يمكن تسجيل الوزن المساعد كقيمة سلبية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduïu el pes addicional. El pes d'ajuda es pot registrar com a valor negatiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte váhu pro přidání. Pro asistovanou váhu můžete zadat zápornou hodnotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast vægtøgning. Du kan registrere hjælpevægten som et negativt tal."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewicht hinzufügen. Hilfsgewichte können mit negativen Werten erfasst werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισάγετε το επιπλέον βάρος. Το βοηθητικό βάρος μπορεί να καταγραφεί με αρνητική τιμή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter additional weight. You can record assistance weight as a negative value."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter additional weight. You can record assistance weight as a negative value."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter additional weight. You can record assistance weight as a negative value."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter additional weight. You can record assistance weight as a negative value."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el peso adicional. El peso de asistencia puede registrarse como negativo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el peso adicional. El peso de asistencia puede registrarse como negativo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää paino. Apupainot voidaan merkitä negatiiviseksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le poids supplémentaire. Le poids d'assistance peut être enregistré avec un signe négatif."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le poids supplémentaire. Le poids d'assistance peut être enregistré avec un signe négatif."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન ઉમેરો. સહાયક વજનને નકારાત્મક તરીકે રેકોર્ડ કરી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן משקל נוסף. ניתן להכניס משקל עזר עם סימן מינוס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भार दर्ज करें। सहायक भार को नकारात्मक मान के रूप में दर्ज किया जा सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unesite težinu za pomoć. Težinu za asistenciju možete upisati negativno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a hozzáadott súlyt. A segítő súlyt negatív értékkel lehet rögzíteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan berat tambahan. Berat bantuan dapat dicatat sebagai angka negatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il peso aggiuntivo. Il peso di assistenza può essere registrato negativamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加算重量を入力。アシスト重量はマイナスで記録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 무게를 입력하세요. 보조 무게는 음수로 기록할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजनाची माहिती प्रविष्ट करा. सहाय्यक वजनासाठी नकारात्मक मूल्य नोंदवू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan berat tambahan. Berat bantuan boleh dicatat sebagai negatif."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg gewicht toe. U kunt een assistentiegewicht invoeren met een negatief getal."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn vektøkning. Du kan registrere assistansevekten som et negativt tall."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj wagę dodatkową. Możesz wpisać wartość ujemną dla wagi pomocniczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira o peso adicional. O peso de assistência pode ser registrado como negativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira o peso adicional. O peso de assistência pode ser registrado como negativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți greutatea suplimentară. Greutatea de asistență poate fi înregistrată ca negativ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите вес для увеличения нагрузки. Вес для помощи можно указать в отрицательном значении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte váhu, ktorú chcete pridávať. Váha asistencie môže byť znížená a zaznamenaná."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnesite dodatno težo. Za pomoč lahko uporabite negativne vrednosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange vikten för assistansen. Vikten kan registreras som negativt värde."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடையை சேர்க்கவும். உதவி எடையை எதிர்மறையாக பதிவு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువును జోడించండి. సహాయక బరువును ప్రతికూలంగా నమోదు చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ค่าเพิ่มน้ำหนัก สามารถบันทึกน้ำหนักช่วยเป็นลบได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlığı ekleyin. Destek ağırlığı negatif olarak kaydedilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть додаткову вагу. Вага допомоги може бути записана як від'ємне значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập thêm trọng lượng. Trọng lượng hỗ trợ có thể được ghi âm bằng số âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入增加重量。辅助重量可以设置为负数进行记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入增加重量。輔助重量可以記錄為負數。"
          }
        }
      }
    },
