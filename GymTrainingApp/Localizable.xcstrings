        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εκτιμήσεις είναι ενδεικτικές. Μπορείτε να τις τροποποιήσετε ελεύθερα στο κάτω πεδίο εισαγωγής."
          }
        },
        "en-AU": {
          "stringUnit": {
