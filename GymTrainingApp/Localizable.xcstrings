          "stringUnit": {
            "state": "translated",
            "value": "Combine small portions of your main food, protein source, and vegetables."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine small portions of your main food, protein source, and vegetables."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine small portions of your main food, protein source, and vegetables."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar pequeñas porciones de alimentos principales, verduras y proteínas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar pequeñas porciones de alimentos principales, verduras y proteínas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse pienempiä määriä pääruokaa, pääraaka-aineita ja kasviksia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Combiner de petites portions de céréales, de protéines et de légumes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combiner de petites portions de céréales, de protéines et de légumes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મુખ્ય ખોરાક, મુખ્ય ભોજન અને શાકભાજીને નાની માત્રામાં ભેગા કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שילוב של מזון עיקרי, מנה עיקרית וירקות בגודל קטן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य भोजन, मुख्य व्यंजन और सब्जियां को छोटे भागों में मिलाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinirajte mali porcije glavnih namirnica, proteina i povrća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kis adagokban kombinálja a fő ételeket, zöldségeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggabungkan makanan pokok, makanan utama, dan sayuran dalam ukuran kecil"
