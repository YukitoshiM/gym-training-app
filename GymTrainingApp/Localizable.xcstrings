    "core_ui.e98cf07747d2": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:292\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم عرض إنجاز عدد الوجبات وإنجاز السعرات الحرارية/PFC بشكل منفصل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assoliment del nombre d'àpats i l'assoliment de calories/PFC es mostren per separat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožňuje zobrazit dosažení počtu jídl a také dosažení cílových hodnot kalorií a makroživin zvlášť."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnåede antal måltider og kalorie- og PFC-målinger vises separat."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erreichung der Anzahl der Mahlzeiten sowie die Erreichung von Kalorien und PFC werden separat angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα εμφανίζονται ξεχωριστά η επίτευξη του αριθμού των γευμάτων και η επίτευξη των θερμίδων και των PFC."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the achievement of the number of meals and the achievement of calories and PFC separately."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the achievement of the number of meals and the achievement of calories and PFC separately."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the achievement of the number of meals and the achievement of calories and PFC separately."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the achievement of the number of meals and the achievement of calories and PFC separately."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el cumplimiento del número de comidas y las calorías/PFC por separado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el cumplimiento del número de comidas y las calorías/PFC por separado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruokapäivän määrän saavuttaminen sekä kalorien ja makrojen (PFC) saavuttaminen näytetään erikseen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez séparément l'atteinte du nombre de repas et l'atteinte des calories et des macronutriments."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez séparément l'atteinte du nombre de repas et l'atteinte des calories et des macronutriments."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આહારની સંખ્યા અને કેલરી તેમજ PFC ની સંખ્યાને અલગથી દર્શાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת השגת מספר הארוחות וכן השגת קלוריות ופחמימות/שומן/חלבונים בנפרד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन की संख्या के लक्ष्य और कैलोरी/PFC के लक्ष्यों को अलग-अलग दिखाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaz postignuća brojem obroka i brojem kalorija/PFC-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az étel napok számának elérését és a kalóriák/PFC-ek elérését külön megjelenítjük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah makan dan pencapaian kalori serta PFC akan ditampilkan secara terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza separatamente il raggiungimento del numero di pasti e l'obiettivo di calorie e macronutrienti (PFC)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事回数の達成と、カロリー・PFCの達成を別々に表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사 횟수의 달성 및 칼로리, PFC의 달성을 별도로 표시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आहाराच्या वेळा पूर्ण झाल्याचे आणि कॅलरी तसेच PFC च्या पूर्णतेचे स्वतंत्रपणे दर्शवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan kali makan dan pencapaian kalori serta PFC akan ditampilkan secara berasingan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aantal maaltijden en het bereiken van calorieën en macronutriënten worden apart weergegeven."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppnådde antall måltider vises separat sammen med kalorier og PFC-verdier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odzyskiwanie postępów i osiąganie celów dotyczących kalorii oraz makroskładników odżywczych (białka, tłuszcze, węglowodany) wyświetlane oddzielnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o progresso do número de refeições e a ingestão de calorias/PF (proteínas, carboidratos, gorduras) separadamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o progresso do número de refeições e a ingestão de calorias/PF (proteínas, carboidratos, gorduras) separadamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă afișăm separat progresul în atingerea numărului de mese și a caloriilor/PFC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достижение количества приемов пищи и потребления калорий/белка/жиров отображается отдельно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet jedál zobrazte oddelene, spolu s dosiahnutím cieľov v kalórie a PFC."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ločeno prikazuje doseganje števila obrokov ter kalorij in PFC."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar uppfyllandet av antalet måltider samt kalorier och PFC separat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவு எண்ணிக்கையை அடைவதையும், கலோரி மற்றும் PFC அளவை அடைவதையும் தனித்தனியாகக் காட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆహార విరామాల సంఖ్యను మరియు కేలరీలు, PFCలను వేర్వేరుగా ప్రదర్శించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงผลการบรรลุเป้าหมายของจำนวนมื้ออาหาร และปริมาณแคลอรี่/PFC แยกกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslenme sayısını ve kalori/PFC hedeflerini ayrı ayrı gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість прийомів їжі та досягнення калорій/PFC відображаються окремо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị thành tích số lần ăn và đạt được lượng calo/PFC riêng biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分别显示饮食次数的达成以及卡路里和PFC的达成情况。"
