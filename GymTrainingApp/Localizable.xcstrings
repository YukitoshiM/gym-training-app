    "domain_catalog.98506c24d2ee": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:260\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك قبضتك بشكل أضيق من المعتاد، وأغلق مرفقيك وادفع للأعلى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Agafa l'adherència més estreta del que és habitual, tanca els colzes i empeny cap amunt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte ruce těsněji, držte lokty blízko těla a zvedejte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en stram håndposition og løft armene, så de er tæt på hinanden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Hände eng zusammen und heben Sie den Arm leicht nach oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το σώμα σας πιο κοντά, με τους αγκώνες να είναι ελαφρώς κλειστοί και να πιέζετε προς τα πάνω."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip tightly, keeping your elbows close together as you push up."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip tightly, keeping your elbows close together as you push up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip tightly, keeping your elbows close together as you push up."
          }
