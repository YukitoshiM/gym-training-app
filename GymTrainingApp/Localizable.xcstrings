        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோற்றத்தையும், முக்கிய பயிற்சிகளின் எடையையும் ஒன்றாக அதிகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీర రూపం మరియు ప్రధాన వ్యాయామాల బరువును ఒకేసారి పెంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มทั้งรูปลักษณ์และน้ำหนักของท่าที่สำคัญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem görünümü hem de ağırlıkla ilgili egzersizleri birlikte geliştirin"
