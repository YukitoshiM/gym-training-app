    "domain_catalog.b0b9c30ff338": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:459\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ البار قريبًا من جسمك وارفعه عن الأرض دون تقريب ظهرك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu la barra a prop del vostre cos i aixequeu-la del terra sense arrodonir l'esquena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte tyč blízko těla a zvedejte se nohama ze země bez zakulaceného zad."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold stangen tæt på kroppen og løft den fra gulvet uden at runde ryggen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Stange in der Nähe Ihres Körpers und heben Sie sie vom Boden ab, ohne den Rücken zu krümmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τη μπάρα κοντά στο σώμα σας και τραβήξτε την από το πάτωμα, διατηρώντας την πλάτη ίσια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the bar close to your body and lift from the floor without rounding your back."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the bar close to your body and lift from the floor without rounding your back."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the bar close to your body and lift from the floor without rounding your back."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the bar close to your body and lift from the floor without rounding your back."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la barra cerca del cuerpo y levántese desde el suelo sin encorvar la espalda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la barra cerca del cuerpo y levántese desde el suelo sin encorvar la espalda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tanko lähellä vartaloa ja nouse ylöspakarat ilman selän koukistamista."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le bar près de votre corps et tirez-le vers le haut en gardant le dos droit."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le bar près de votre corps et tirez-le vers le haut en gardant le dos droit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરની નજીક બારને રાખો અને પીઠને સીધી રાખીને જમીનમાંથી ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את המוט קרוב לגוף, והרים אותו מהקרקע מבלי לכופף את הגב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर के करीब बार को रखें और बिना पीठ को मोड़े फर्श से उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite uteg blizu tijela i podižite ga od poda bez savijanja leđa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a pántot test közelségében, és húzza fel a hátát a talajról, ügyelve arra, hogy a háta ne legyen kinyújtva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan bar dekat dengan tubuh, dan angkat dari lantai tanpa membungkukkan punggung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la barra vicino al corpo e solleva, mantenendo la schiena dritta e tirando dal pavimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーを体の近くに保ち、背中を丸めずに床から引き上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바를 몸 가까이에 유지하고, 허리를 굽히지 않고 바닥에서 들어올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीराच्या जवळ बार ठेवून, पाठीला वाकवून जमिनीवरून वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan bar berada dekat dengan badan, dan angkat dari lantai tanpa membengkokkan punggung."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd het gewicht dicht bij je lichaam en til het van de grond zonder je rug te buigen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold stangen nær kroppen, og løft den fra gulvet uten å runde ryggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymaj pręt blisko ciała i podciągaj go od podłogi, nie wyginając pleców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a barra próxima ao corpo e levante-se, sem arredar as costas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a barra próxima ao corpo e levante-se, sem arredar as costas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Țineți bara aproape de corp și ridicați-o din picioare, menținând spatele drept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите штангу близко к телу и поднимайте ее, не округляя спину и не отрывая ноги от пола."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte tyč blízko tela a zdvihajte ju z podlahy bez prekrútenia chrbta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite bar blizu telesa in ga dvajte od tal brez sklepanja hrbla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll stången nära kroppen och lyft den från golvet utan att böja ryggen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடலின் அருகில் பட்டையை வைத்து, முதுகை வளைக்காமல் தரையில் இருந்து தூக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీరం దగ్గర బార్‌ను ఉంచి, వెన్నును వంచకుండా నేల నుండి పైకి లేవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับบาร์ไว้ใกล้กับตัว และดึงขึ้นจากพื้นโดยไม่ทำให้หลังงอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barı vücudunuza yakın tutun ve sırtınızı çatarak yere doğru çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте ганець близько до тіла та піднімайтеся від підлоги, не округляючи спину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thanh gần thân và nâng người lên từ sàn, giữ thẳng lưng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持杠杆靠近身体，不要弯腰，从地面向上抬起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持杠铃靠近身体，不要弯腰，从地面向上抬起。"
          }
        }
      }
    },
