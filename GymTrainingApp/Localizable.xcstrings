    "health_meals_body_ai.43dc3b27e76e": {
      "comment": "GymTrainingApp/Features/Meals/MealNutritionSourceViews.swift:245\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء إدخال رمز المنتج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduïu el codi del producte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte produktový kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
