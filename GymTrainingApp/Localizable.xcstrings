    "ai_credit.delete_warning": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:520\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف جميع السجلات المخزنة على الجهاز وحساب BodyMode. سيتم فقد جميع الرصيد المتبقي ولا يمكن استعادته."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminarà tots els registres i el compte de BodyMode. Perdreu tots els crèdits comprats i no podríeu recuperar-los."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže všechny záznamy a účet BodyMode. Zůstaté kreditů se ztratí a nelze je obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet alle data og BodyMode-kontoen. Alle resterende købte/bonus kreditter vil gå tabt og kan ikke gendannes."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Daten und Ihr BodyMode-Konto. Alle verbleibenden Kauf- und Bonus-Credits gehen verloren und können nicht wiederhergestellt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή όλων των εγγραφών και του λογαριασμού BodyMode. Όλα τα υπόλοιπα κρεδίτ θα χαθούν και δεν μπορούν να ανακτηθούν."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all device records and your BodyMode account. All remaining purchased and bonus credits will be lost and cannot be recovered."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all records and your BodyMode account. All remaining purchased and bonus credits will be lost and cannot be recovered."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all device records and your BodyMode account. All remaining purchased or bonus credits will be lost and cannot be recovered."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all records and your BodyMode account. All remaining purchased and bonus credits will be lost and cannot be recovered."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminará todos los registros y la cuenta de BodyMode. También perderás todos los créditos comprados y cualquier beneficio, sin posibilidad de recuperarlos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminará todos los registros y la cuenta de BodyMode. También perderás todos los créditos comprados y cualquier beneficio, y no podrás recuperarlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaan kaikki laitteen tiedot ja BodyMode-tili. Kaikki jäljellä olevat ostokset ja bonukset menetetään, eikä niitä voi palauttaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les données et votre compte BodyMode. Tous les crédits d'achat et de bonus seront perdus et ne pourront pas être récupérés."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les données et votre compte BodyMode. Tous les crédits d'achat et de bonus seront perdus et irrécupérables."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": " ઉપકરણમાંના તમામ રેકોર્ડ અને BodyMode એકાઉન્ટને કાઢી નાખો. બાકી રહેલી ખરીદી અને બોનસ ક્રેડિટ પણ ગુમાવશો, અને તેને પાછી મેળવી શકાશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאסיר את כל ההקלטות והחשבון ב-BodyMode. כל נקודות הקנייה והבונוסים יאבדו ואינן ניתנות לשחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर मौजूद सभी रिकॉर्ड और BodyMode खाते को हटा दें। शेष खरीद और बोनस क्रेडिट भी खो जाएंगे, जिन्हें पुनर्प्राप्त नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisat ćete sve podatke i račun BodyMode. Ostali kupljeni krediti i nagrade će biti izgubljeni i ne mogu se vratiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli az összes helyi adatot és a BodyMode fiókot. A megmaradt krediteket is elveszíti, és nem állíthatók vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus semua catatan dan akun BodyMode. Semua kredit yang tersisa juga akan hilang dan tidak dapat dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella tutti i dati e l'account BodyMode. Tutti i crediti rimanenti e di acquisto andranno persi, senza possibilità di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内の全記録とBodyModeアカウントを削除します。残っている購入・特典クレジットも失われ、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 모든 기록과 BodyMode 계정을 삭제합니다. 남은 구매 및 보너스 크레딧도 모두 사라지고 복구할 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिव्हाइसवरील सर्व नोंदी आणि BodyMode खात्याला हटवा. उर्वरित खरेदी केलेले क्रेडिट्स आणि फायदे देखील नष्ट होतील, जे परत मिळवता येणार नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padamkan semua rekod dan akaun BodyMode. Kredit yang tinggal juga akan hilang dan tidak boleh dipulihkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert alle gegevens en je BodyMode-account. Alle resterende aankopen en bonussen worden verloren en kunnen niet worden hersteld."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett alle data og BodyMode-kontoen. Alle gjenværende kjøp og bonuser vil gå tapt, og kan ikke gjenopprettes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń wszystkie dane i konto BodyMode. Pozostałe kredyty zakupowe i bonusowe zostaną utracone i nie będą można odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir todos os registros e conta BodyMode. Todos os créditos restantes e de bônus também serão perdidos, sem possibilidade de recuperação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga todos os registos e a conta BodyMode. Todos os créditos de compra e bónus também serão perdidos, sem possibilidade de recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Șterge toate înregistrările și contul BodyMode. Pierzi toate creditele rămas, iar recuperarea nu este posibilă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалит все записи и аккаунт BodyMode. Все оставшиеся кредиты будут потеряны и не могут быть восстановлены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstránite všetky záznamy a účet BodyMode. Zmiznú aj zostávajúce kredity, ktoré sa nedá obnoviť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišeš vse podatke in račun BodyMode. Vsi ostali kupljeni krediti in nagrade bodo izgubljeni, in jih ne bo mogoče obnoviti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar alla lokala data och BodyMode-kontot. Alla återstående köpta krediter försvinner och kan inte återställas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனத்தில் உள்ள அனைத்து பதிவுகளையும், BodyMode கணக்கையும் நீக்கவும். மீதமுள்ள கொள்முதல் மற்றும் போனஸ் கிரெடிட்களும் இழக்கப்படும், அவற்றை மீட்டெடுக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరికరంలోని అన్ని రికార్డులు మరియు BodyMode ఖాతాను తొలగించండి. మిగిలిన కొనుగోలు మరియు బోనస్ క్రెడిట్‌లను కూడా కోల్పోతారు, వాటిని తిరిగి పొందలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูลทั้งหมดและบัญชี BodyMode, ยอดคงเหลือที่เหลือจะหายไปและไม่สามารถกู้คืนได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazdaki tüm verileri ve BodyMode hesabını siler. Kalan kredi ve bonus krediler de kaybolur ve geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалить усі записи та обліковий запис BodyMode. Всі залишки кредитів будуть втрачені і неможливо відновити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa toàn bộ dữ liệu và tài khoản BodyMode. Tất cả tín dụng mua và nhận cũng sẽ bị mất vĩnh viễn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除设备内的所有记录和 BodyMode 账户。剩余的购买和奖励积分将丢失，无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除裝置內的所有記錄和 BodyMode 帳戶。剩餘的購買和獎勵點數將無法恢復。"
          }
        }
      }
    },
