        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите таз в нейтральном положении, притягивая к себе спину с помощью тяги."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte stabilný panvový kôš a stlmený chrbát, pričom ťahajte kábel smerom k bruchu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavežite kolnik in povlečite kabel, da se hrbet ovine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i kabeln så att bäckenet är stabilt och ryggen är rund, samtidigt som du drar handtaget mot magen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொழியை நிலைப்படுத்தி, முதுகை வளைத்து கயிற்றை கீழ் நோக்கி இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూతిని స్థిరంగా ఉంచి, వెన్నును నిటారుగా ఉంచడానికి కేబుల్ ను క్రిందికి లాగండి."
          }
        },
        "th": {
          "stringUnit": {
