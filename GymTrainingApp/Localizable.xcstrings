    "domain_catalog.a5bb33628c1d": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:295\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "القرفصاء على طول المسار، ومحاذاة الركبتين وأصابع القدمين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Poseu-vos a la gatzoneta al llarg de la pista, alineant els genolls i els dits dels peus."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste se ohnout, přičemž kolena a paty zůstávají ve stejné rovině."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj dig, så dine knæ og tæer peger i samme retning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beugen Sie sich, wobei die Knie und Zehen in derselben Richtung zeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε μια γκριπ με το σώμα σας, ευθυγραμμίζοντας τους αγκώνες και τις φτέρνες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat, aligning your knees and toes with the track."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat, aligning your knees and toes with the track."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat, aligning your knees and toes with the track."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Squat, aligning your knees and toes with the track."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja lentamente, manteniendo las rodillas y los dedos apuntando en la misma dirección."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja lentamente, manteniendo las rodillas y los dedos apuntando en la misma dirección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita liikkeet oikein ja pidä vartalo linjassa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pencher en suivant la trajectoire, alignant les genoux et les pointes des pieds."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pencher en suivant la trajectoire, alignant les genoux et les pointes des pieds."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માર્ગને અનુસરીને બેક કરો, ઘૂંટણ અને પગની આંગળીઓને એક જ દિશામાં રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התכווצו תוך שמירה על יציבה נכונה, והביאו את הברכיים והאצבעות לכיוון זהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी गति के अनुसार झुकें, और घुटनों और पैर की उंगलियों को एक साथ रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvrši držanje u položu, uskladavajući koljena i prste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megfelelő mozdulatban, a térd és a lábujjak irányának egyezőségét biztosítsd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjongkok sambil menjaga posisi lutut dan ujung jari sejajar dengan garis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adotta la posizione corretta e allinea le ginocchia e le punte dei piedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軌道に沿ってしゃがみ、膝とつま先の向きを揃える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 경로에 따라 앉고, 무릎과 발끝을 정렬합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्गानुसार वाका, आणि गुडघे आणि पायांची दिशा जुळवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bungkuk dengan mengikuti arah, dan sejajarkan lutut serta jari kaki."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig je, zodat je knieën en tenen op dezelfde lijn liggen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy deg og juster knær og tær slik at de peker i samme retning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonuj ćwiczenie, trzymając się linii, i dopasowuj ułożenie kolan i palców stóp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a postura, mantendo os joelhos e pés alinhados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a postura, mantendo os joelhos e pés alinhados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întinde-te, menținând poziția corectă și aliniind genunchii și vârfurile picioarelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за правильной осанкой и выпрямите колени и пальцы ног."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamerajte sa na správnu polohu a držte si kolená a päty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgibajte se v smeri, pri čemer usmerite kolena in toe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sätt dig med benen i en vinkel och justera knäna och tårnas position."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான முறையில் குனிந்து, முழங்காலையும், கால் விரல்களையும் ஒரே திசையில் வைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మార్గం ప్రకారం వంగి, మోకాళ్లు మరియు కాలి వేళ్లను ఒకే దిశలో ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก้มตัวตามแนวเส้น และจัดให้ข้อเข่าและปลายเท้าอยู่ในแนวเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket doğrultusunda çömel, diz ve ayak parmaklarını hizala."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сядьте, випрямляючи спину та ноги, щоб вони були паралельні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạ người theo đường thẳng, giữ cho đầu gối và ngón chân cùng hướng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿着轨迹蹲下，保持膝盖和脚尖方向一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿著軌跡彎曲，並將膝蓋和腳趾朝向同一方向。"
          }
        }
      }
    },
    "domain_catalog.a619e7918f83": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:404\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "استعد لليوم التالي دون لوم نفسك على عدم تحقيق الهدف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta't per al dia següent sense culpar-te de no aconseguir l'objectiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesnažte se to řešit, přizpůsobte to pro zítra"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå at fokusere på mangler, og juster til næste dag"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Verletzungen vermeiden und den Fokus auf den nächsten Tag legen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην επικρίνετε την αποτυχία, αλλά προσαρμόστε για την επόμενη ημέρα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't blame yourself for unmet goals, adjust for the next day"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't blame yourself for unmet goals, adjust for the next day"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't blame yourself for unmet goals, adjust for the next day"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't blame yourself for unmet goals, adjust for the next day"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No culpar al resultado, sino ajustar para el día siguiente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No culpar al resultado, sino ajustar para el día siguiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä syytä epäonnistumista, vaan säädä seuraavaa päivää"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas se sentir coupable pour les résultats non atteints, mais s'adapter pour le lendemain."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas se sentir coupable pour les résultats non atteints, mais s'adapter pour le lendemain."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અપૂર્ણતાને દોષ આપ્યા વિના આવતી કાલ માટે ગોઠવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תאשים את עצמך על חוסר הצלחה, התאם ליום הבא"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असफलता को दोष न दें और अगले दिन के लिए समायोजित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemojte kriviti za neuspjeh, prilagodite sljedeći dan"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kritizáljuk a sikertelenséget, hanem tervezzük meg a következő napot"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan menyalahkan kegagalan, sesuaikan untuk hari berikutnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non incolpare i risultati negativi, ma adattarsi al giorno successivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未達を責めず翌日へ調整"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미달에 대해 탓하지 않고 다음 날로 조정"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अपयशावर लक्ष केंद्रित न करता, पुढील दिवसासाठी योजना करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan menyalahkan kegagalan, sesuaikan untuk esok"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef jezelf de ruimte om morgen verder te gaan"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke skyld på manglende fremgang, juster for neste dag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie krytyzuj niedotrzymanych celów, dostosuj na następny dzień"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se culpe pelo que não alcançou, ajuste para o dia seguinte"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se culpe pelo que não alcançou, ajuste para o dia seguinte"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ne reproșăm pentru lipsa progresului, ci ajustăm pentru ziua următoare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вините себя за неудачи, а планируйте на следующий день."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesnažte sa obviňovať za nedosiahnuteľné, nastavte si cieľ na ďalší deň"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kritizirajte neuspehov, prilagodite naslednji dan"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik att skuldbelägga misslyckanden, justera för nästa dag"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோல்வியடையாமல், அடுத்த நாளுக்கு மாற்றியமைக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తప్పులను నిందించకుండా, రేపటి కోసం సర్దుబాటు చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าตำหนิเมื่อไม่สำเร็จ ให้ปรับปรุงสำหรับวันพรุ่งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarısızlığı sorgulamadan ertesi güne geçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не критикуйте невдачі, а скоригуйте на наступний день"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
