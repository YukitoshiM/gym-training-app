    "domain_catalog.6d905526f64f": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:253\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ ذراعيك العلويتين مغلقتين، وقم بخفض الشريط فوق جبهتك ومد مرفقيك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint els braços tancats, baixeu la barra sobre el front i esteneu els colzes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte paže a přesuňte tyč směrem k čelu, natáhněte lokty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold overarmen fast og sænk stangen op mod panden, mens du strækker albuen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Arm fixieren und die Stange zum Kopf hin absenken, wobei der Arm gestreckt wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τον αγκώνα σταθερό και χαμηλώστε τη μπάρα προς το μέτωπο, τεντώνοντας τον αγκώνα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your upper arm and lower the bar to your forehead, extending your elbow."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your upper arm and lower the bar to your forehead, extending your elbow."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your upper arm and lower the bar to your forehead, extending your elbow."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix your upper arm and lower the bar to your forehead, extending your elbow."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el brazo fijo y baja la barra hacia arriba, extendiendo el codo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el brazo fijo y baja la barra hacia arriba, extendiendo el codo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kyynärpäät paikallaan ja laske tangon otsalle, jolloin kyynärpäät venyvät."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez votre avant-bras et descendez la barre vers le haut de votre front, en étirant votre coude."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez votre avant-bras et descendez la barre vers le haut de votre front, en étirant votre coude."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા હાથને સ્થિર કરો, અને માથા પરની તરફ બારને નીચે લાવો, જેથી ખભા વિસ્તરે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להחזיק את הזרוע ולמשוך את החבל כלפי מעלה, כך שהמרפק יתארך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी बांह को स्थिर करें, और अपनी ठुड्डी के ऊपर तक बार को नीचे लाएं, जिससे आपकी कलाई खिली जाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite nadlaktice i spuštajte traku prema čelu, istežući lakte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A karokat a testhez rögzítve, az arc fölé irányítsa a súlyt, és kinyújtsa a könyököt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga lengan tetap lurus, menurunkan bar ke arah dahi dan meregangkan siku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissare il braccio e abbassare la barra verso la fronte, estendendo il gomito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上腕を固定し、額の上へバーを下ろして肘を伸ばす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔을 고정하고, 머리 위로 바를 내리고 팔꿈치를 펴세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊर्जेला स्थिर ठेवा आणि, कोपऱ्यातून बार खाली आणा, ज्यामुळे कोपर सरळ होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menegangkan lengan, menurunkan palang ke arah dahi dan meregangkan siku."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de bovenarmen vast en laat het gewicht naar je voorhoofd zakken, waarbij je je ellebogen buigt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold overarmen i ro, senk stangen opp mot pannen og strekk ut albuene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj nadgarstek, opuść pałę w kierunku czoła i wyprostuj łokieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o braço e abaixe a barra até que ela esteja acima da testa, estendendo o cotovelo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o braço e abaixe a barra até que ela esteja acima da testa, estendendo o cotovelo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixați brațul, coborâți bara spre frunte și întindeți cotul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепите предплечье, опустите штангу к голове и выпрямите локти."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte ramenný kĺb a nechajte tyč klesnúť smerom k čelu, pričom natiahnete lakte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavežite ramo in spustite bar v zgornjo del čela, pri čemer raztegnete ramo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst underarmarna och sänk stången över pannan, samtidigt som du sträcker ut armbågen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை நிலையாக வைத்து, தலையின் மேல் நோக்கி பாட்டை இறக்கி, மணிக்கட்டை நீட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులను స్థిరంగా ఉంచి, తల పైకి బార్‌ను దించండి మరియు మోచేతులను చాటండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืดแขนขึ้นและดึงบาร์ลงมาเหนือขมับ พร้อมกับเหยียดข้อศอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolunuzu sabitleyin, barı başınızın üzerine indirin ve dirseğinizi uzatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафіксуйте верхню частину руки та опустіть штангу до лінії потилиці, розгинаючи лікті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ cố định cánh tay, hạ thanh xuống và duỗi khuỷu tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定上臂，将哑铃从额上方下拉至肘部，并伸展手臂。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將手臂固定，並將槓桿拉至額頭上方，伸展肘部。"
          }
        }
      }
    },
