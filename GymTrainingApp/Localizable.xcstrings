    "health_meals_body_ai.eb9e09955b1e": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift:90\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى لو لم يكن الاتصال ممكنًا، فلن يتم حذف البيانات المسجلة. يمكنك الاستمرار في التسجيل يدويًا وإنشاء تعليقات الذكاء الاصطناعي فقط لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara que la connexió no sigui possible, les dades enregistrades no s'eliminaran. Podeu continuar gravant manualment i només generar comentaris d'IA més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I když se nepodaří připojit, uložená data zůstanou. Můžete pokračovat v ručním zadávání a později vygenerovat pouze AI komentář."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv hvis forbindelsen ikke er etableret, vil de registrerede data ikke forsvinde. Du kan fortsætte med manuel registrering og senere generere AI-kommentarer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch wenn die Verbindung nicht hergestellt werden kann, gehen keine gespeicherten Daten verloren. Sie können manuell weiter aufzeichnen und später nur noch KI-Kommentare generieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα και αν η σύνδεση δεν είναι δυνατή, τα αποθηκευμένα δεδομένα δεν θα διαγραφούν. Μπορείτε να συνεχίσετε τη χειροκίνητη καταγραφή και αργότερα να δημιουργήσετε μόνο σχόλια από την τεχνητή νοημοσύνη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if the connection fails, your recorded data will not be deleted. You can continue manual recording and generate AI comments later."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if the connection fails, your recorded data will not be deleted. You can continue manual recording and generate AI comments later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if the connection fails, your recorded data will not be deleted. You can continue manual recording and generate AI comments later."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Even if the connection fails, your recorded data will not be deleted. You can continue manual recording and generate AI comments later."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso si no se puede conectar, los datos registrados no se eliminarán. Puede continuar registrando manualmente y luego generar solo comentarios de IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso si no se puede conectar, los datos registrados no se eliminarán. Puede continuar registrando manualmente y luego generar solo comentarios de IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos yhteys ei onnistu, aiemmin tallennetut tiedot eivät katoa. Voit jatkaa manuaalista kirjausta ja myöhemmin luoda AI-kommentin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si la connexion échoue, les données enregistrées ne seront pas supprimées. Vous pouvez continuer à enregistrer manuellement et générer des commentaires d'IA plus tard."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Même si la connexion échoue, les données enregistrées ne seront pas supprimées. Vous pouvez continuer à enregistrer manuellement et générer des commentaires d'IA plus tard."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો કનેક્શન શક્ય ન હોય, તો રેકોર્ડ કરેલ ડેટા ડિલીટ થશે નહીં. તમે મેન્યુઅલ રેકોર્ડિંગ ચાલુ રાખી શકો છો અને પછી AI ટિપ્પણી જનરેટ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם אם החיבור לא הצליח, הנתונים הקיימים לא ימחקו. ניתן להמשיך בתיעוד ידני וליצור הערות AI בהמשך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भले ही कनेक्शन स्थापित न हो, पहले से रिकॉर्ड किए गए डेटा को हटाया नहीं जा सकता। आप मैन्युअल रूप से रिकॉर्डिंग जारी रख सकते हैं और बाद में केवल AI की टिप्पणियाँ जेनरेट कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čak i ako se ne može uspostaviti veza, prethodno snimljeni podaci neće biti izbrisani. Možete nastaviti ručnu evidenciju i zatim generirati samo AI komentare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha a kapcsolat nem létrejön, az előző adatok nem törlődnek. Folytassa a manuális rögzítést, majd később csak AI-al generálhatja a megjegyzéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meskipun koneksi tidak berhasil, data yang sudah dicatat tidak akan hilang. Anda dapat melanjutkan pencatatan manual dan kemudian hanya menghasilkan komentar AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche se la connessione non è riuscita, i dati registrati non verranno eliminati. È possibile continuare a registrare manualmente e generare commenti AI in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できない場合でも、記録済みデータは消えません。手動記録を続けたまま、あとでAIコメントだけ生成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 실패하더라도, 저장된 데이터는 삭제되지 않습니다. 수동 기록을 계속 진행하고 나중에 AI 코멘트만 생성할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर कनेक्शन होत नसेल, तरी मागील डेटा हटणार नाही. तुम्ही मॅन्युअल नोंदी चालू ठेवू शकता आणि नंतर फक्त AI चा अभिप्राय तयार करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika sambungan tidak berjaya, data yang telah disimpan tidak akan dihapus. Anda boleh terus mencatat secara manual dan kemudian menghasilkan komen AI sahaja."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs als de verbinding niet lukt, worden de opgeslagen gegevens niet verwijderd. U kunt doorgaan met handmatig registreren en later alleen een AI-commentaar genereren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv om forbindelsen ikke fungerer, vil de lagrede dataene ikke slettes. Du kan fortsette med manuell registrering og generere AI-kommentarer senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet jeśli połączenie nie przebiegło, dane już zapisane pozostaną. Możesz kontynuować ręczne wpisywanie i później wygenerować jedynie komentarz AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo que a conexão não seja estabelecida, os dados já registrados não serão apagados. Você pode continuar registrando manualmente e gerar comentários de IA posteriormente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo que a conexão não seja estabelecida, os dados já registrados não serão apagados. Você pode continuar registrando manualmente e gerar comentários de IA posteriormente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiar dacă conexiunea nu este stabilă, datele înregistrate nu vor fi șterse. Puteți continua să înregistrați manual și apoi puteți genera comentarii AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже если подключение не удалось, сохраненные данные не будут удалены. Вы можете продолжить ручное ведение журнала и позже получить только комментарий от ИИ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aj keď pripojenie nie je možné, uložené údaje sa nezmiznú. Môžete pokračovať v manuálnom zaznamenávaní a neskôr generovať len AI komentáre."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeprav se ne morete povezati, shranjeni podatki ne bodo izbrisani. Lahko nadaljujete ročno snemanje in pozneje ustvarite samo AI komentiranje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även om anslutningen inte fungerar, kommer de sparade data att förbli. Du kan fortsätta med manuell registrering och sedan generera AI-kommentarer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைப்பு இல்லாவிட்டாலும், சேமித்த தரவுகள் எதுவும் நீக்கப்படாது. கைமுறையாக பதிவு செய்வதை தொடரலாம், பின்னர் AI கருத்துக்களை உருவாக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనెక్షన్ సాధ్యం కానప్పటికీ, రికార్డ్ చేసిన డేటా తొలగించబడదు. మాన్యువల్ రికార్డింగ్‌ను కొనసాగించి, ఆ తర్వాత AI వ్యాఖ్యలను మాత్రమే ఉత్పత్తి చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ว่าการเชื่อมต่อจะไม่สำเร็จ ข้อมูลที่บันทึกไว้จะไม่ถูกลบ คุณสามารถดำเนินการบันทึกด้วยตนเองต่อไป และสร้างคำแนะนำจาก AI ในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı başarısız olsa bile, kaydedilmiş veriler silinmez. Manuel olarak kaydetmeye devam edebilir ve daha sonra sadece AI yorumunu oluşturabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіть якщо з'єднання не вдалося, збережені дані не будуть видалені. Ви можете продовжити ручне введення даних і пізніше отримати лише коментарі від AI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả khi không kết nối, dữ liệu đã ghi sẽ không bị xóa. Bạn có thể tiếp tục ghi thủ công và sau đó tạo ra chỉ các bình luận của AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使无法连接，记录的数据也不会消失。您可以继续手动记录，然后在稍后生成AI评论。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使無法連接，已記錄的數據不會消失。您可以繼續手動記錄，然後再生成AI評論。"
          }
        }
      }
    },
