        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Erlaubnis zur Ortung in der App können Sie sich registrieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να εγγραφείτε επιτρέποντας την πρόσβαση στην τοποθεσία στις ρυθμίσεις της εφαρμογής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can register by granting location permissions in the app settings."
