      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:304\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحديد نوع الحدث أو الشكل بناءً على حركات المعصم وحدها. سيتم تأكيد العدد المقدر للمرات وعكسه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No és possible determinar el tipus d'esdeveniment o forma basant-se només en els moviments del canell. Es confirmarà i reflectirà el nombre estimat de vegades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze pohyb zápěstí nestačí k určení cvičení a techniky. Po ověření odhadnutého počtu se aktualizuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke muligt at fastslå øvelsen og formen kun ved bevægelse af håndleddet. Bekræft estimeret antal, før du anvender det."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bewegung des Handgelenks allein ermöglicht es nicht, Übungen oder Formen eindeutig zu bestimmen. Bitte überprüfen Sie die geschätzte Anzahl, bevor Sie sie bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κίνηση του καρπού δεν επιτρέπει τον καθορισμό της άσκησης ή της τεχνικής. Ελέγξτε την εκτιμώμενη συχνότητα πριν την εφαρμογή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot determine the exercise and form based solely on wrist movement. Please confirm the estimated number before updating."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot determine the exercise and form based solely on wrist movement. Please confirm the estimated number before updating."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot determine the exercise and form based solely on wrist movement. Please confirm the estimated number before updating."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot determine the exercise and form based solely on wrist movement. Please confirm the estimated number before updating."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento del muñón por sí solo no permite determinar el ejercicio o la forma. Confirme el número estimado antes de reflejarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento del muñón por sí solo no permite determinar el ejercicio o la forma. Confirme el número estimado antes de reflejarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei voida päätellä lajia tai tekniikkaa pelkästään ranteen liikkeillä. Tarkista arvioitu määrä ennen päivittämistä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est impossible de déterminer l'exercice et la forme uniquement sur la base du mouvement de la poignée. Veuillez vérifier le nombre estimé avant de le mettre à jour."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est impossible de déterminer l'exercice et la forme uniquement sur la base du mouvement de la poignée. Veuillez vérifier le nombre estimé avant de le mettre à jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથની હલનચલનથી માત્ર કસરત અથવા સ્વરૂપને ચોક્કસ રીતે નક્કી કરી શકાતું નથી. અંદાજિત સંખ્યાની ચકાસણી કર્યા પછી જ તેને અપડેટ કરવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לקבוע את סוג הפעילות או את הטכניקה רק על ידי תנועות של המרפק. יש לבדוק את מספר ההערכות לפני שמוסיפים אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल हाथ से दर्ज किए गए डेटा का उपयोग करें। अनुमानित संख्या की पुष्टि करने के बाद ही इसे अपडेट किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokret ruke ne omogućuje određivanje aktivnosti i tehnike. Proverite broj prije nego što ga unesete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A karok mozgása alapján nem lehet biztosan megállapítani a feladatot és a formát. A becsült számokat ellenőrizve fogjuk frissíteni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakan pergelangan tangan saja tidak dapat menentukan jenis dan bentuk. Periksa perkiraan jumlah sebelum diterapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile determinare l'esercizio e la forma solo in base al movimento del polso. Conferma il numero stimato prima di applicarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手首の動きだけでは種目やフォームを断定できません。推定回数は確認してから反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손목 움직임만으로는 운동 종류나 자세를 단정할 수 없습니다. 추정 횟수는 확인 후 반영합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हाताच्या हालचालीतूनच व्यायाम प्रकार आणि आकार निश्चित करता येत नाही. अंदाजित वेळेची पडताळणी करूनच नोंद करावी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakan pergelangan tangan sahaja tidak dapat menentukan aktiviti dan bentuk. Jumlah anggaran akan disemak sebelum dipaparkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Met alleen de beweging van je pols kun je geen oefening of vorm definitief bepalen. Controleer het geschatte aantal voordat je dit wijzigt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke mulig å fastslå øvelse og form kun ved bevegelse i håndleddet. Bekreft estimert antall før du oppdaterer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruchy nadgarstka samej w sobie nie pozwalają na jednoznaczną identyfikację ćwiczeń i form. Szacowaną liczbę należy zweryfikować przed wprowadzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O movimento do pulso sozinho não permite determinar o exercício ou a forma. Confirme o número estimado antes de aplicar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O movimento do pulso sozinho não permite determinar o exercício ou a forma. Confirme o número estimado antes de aplicar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu se poate determina exercițiul și forma doar pe baza mișcărilor de la încheietură. Numărul estimat va fi verificat înainte de a fi aplicat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движения запястья не позволяют однозначно определить упражнение и технику. Подтвердите предполагаемое количество повторений перед внесением изменений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouhý pohyb zápästia nestačí na určení druhu a formy cvičenia. Po potvrdení odhadnú počty opakovaní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgolj gibanje rok na zapestju ne dovoljuje določitve vrste in tehnike. Pred uporabo preverite število in ga nato vnese."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är omöjligt att fastställa övningen och formen enbart baserat på armrörelser. Bekräfta uppskattad tid innan du sparar den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கையின் அசைவுகளை மட்டும் வைத்து, உடற்பயிற்சியின் வகை மற்றும் முறையைத் தீர்மானிக்க முடியாது. தோராயமான எண்ணிக்கையை உறுதி செய்த பிறகு, அதை மாற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతి కదలికల ద్వారా మాత్రమే వ్యాయామం మరియు ఆకృతిని నిర్ధారించలేము. అంచనా వేసిన సంఖ్యను ధృవీకరించిన తర్వాతనే నమోదు చేస్తాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเคลื่อนไหวของข้อมือเพียงอย่างเดียว ไม่สามารถระบุชนิดและรูปแบบได้ ควรตรวจสอบจำนวนครั้งก่อนบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "El bileğinin hareketleri ile egzersizi ve formu kesin olarak belirlemek mümkün değildir. Tahmini tekrar sayısını kontrol ettikten sonra güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рух зап'ястя само по собі не дозволяє визначити вправи та форму. Перевірте оцінену кількість, перш ніж застосовувати її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dựa vào chuyển động cổ tay không thể xác định rõ bài tập và kỹ thuật. Vui lòng kiểm tra số lần ước tính trước khi cập nhật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅通过手腕的动作无法确定项目和姿势。请在确认后反映估计次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅透過手腕的動作無法確定運動項目和姿勢。請確認後再反映估計次數。"
          }
        }
      }
    },
