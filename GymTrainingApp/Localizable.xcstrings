    "health_meals_body_ai.e8a45501dd61": {
      "comment": "GymTrainingApp/Features/Reports/AITrainerChatView.swift:28\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف نفكر معًا أثناء النظر في سجلاتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensarem junts mentre mirem els vostres registres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Společně probereme vaše výsledky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kan sammenligne dine resultater."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsam schauen wir uns Ihre Daten an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα εξετάσουμε μαζί τα δεδομένα σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's review your progress together."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's review your progress together."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's review your progress together."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's review your progress together."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizaremos juntos tus registros."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizaremos juntos tus registros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katsomme yhdessä tietojasi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous allons examiner ensemble vos données."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous allons examiner ensemble vos données."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા રેકોર્ડ સાથે મળીને વિચાર કરીએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נחשוב יחד על הנתונים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी जानकारी को देखकर हम साथ मिलकर विचार करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razmotrimo zajedno vaše podatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Együtt megvizsgáljuk az adatait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mari bersama-sama menganalisis catatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizziamo insieme i tuoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの記録を見ながら一緒に考えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 기록을 확인하면서 함께 생각해보겠습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या नोंदी पाहून आपण एकत्र विचार करू."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mari bersama-sama membincangkan berdasarkan rekod anda."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Laten we samen kijken naar je gegevens."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kan se gjennom dine resultater sammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razem przeanalizujemy Twoje dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos analisar juntos com seus dados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos analisar juntos com seus dados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom analiza împreună rezultatele tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы вместе рассмотрим ваши записи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoločne si pozrieme vaše záznamy a zvážime to."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupaj bomo razmislili o vaših podatkih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi går igenom dina resultat tillsammans."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பதிவுகளைப் பார்த்து, சேர்ந்து கலந்துரையாடுவோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రికార్డులను చూస్తూ కలిసి ఆలోచిద్దాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาดูกันว่าคุณสามารถทำได้มากแค่ไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birlikte kaydınızı inceleyerek değerlendirelim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разом подумаємо про ваші записи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng ta cùng xem xét lại kết quả của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起看看您的记录，共同思考。"
          }
        },
