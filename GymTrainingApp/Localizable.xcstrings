            "value": "હું એપલ વૉચ પર મોકલવા માટે ડેટા બનાવી શકતો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחתי ליצור נתוני פעולה לשליחה ל-Apple Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं Apple Watch पर भेजने के लिए कोई ऑपरेशन डेटा नहीं बना सका।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nisam uspio kreirati podatke za slanje na Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült létrehozni a parancst adatokat az Apple Watch-ra küldéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuat data perintah untuk dikirim ke Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono riuscito a creare i dati di comando da inviare ad Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchへ送る操作データを作れませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch로 전송할 명령 데이터를 생성하는 데 실패했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲपल वॉचवर पाठवण्यासाठी कमांड डेटा तयार करण्यात अयशस्वी."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mencipta data operasi untuk dihantar ke Apple Watch."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kon geen data maken om naar Apple Watch te sturen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg klarte ikke å opprette data for å sende til Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć danych operacyjnych do wysłania na Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar os dados da operação para enviar ao Apple Watch."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar os dados da operação para enviar ao Apple Watch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut crea date de comandă pentru a fi trimise către Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать данные для отправки на Apple Watch."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa vytvoriť dáta pre operáciu, ktoré majú byť zaslané na Apple Watch."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni je mogoče ustvariti podatkov za operacijo, ki jih želite pospremiti na Apple Watch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte skapa data för att skicka till Apple Watch."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்பிள் வாட்சுக்கு அனுப்ப வேண்டிய கட்டளை தரவை உருவாக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple వాచ్‌కు పంపడానికి ఆపరేషన్ డేటాను సృష్టించలేకపోయాను"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถสร้างข้อมูลคำสั่งที่จะส่งไปยัง Apple Watch ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch'e gönderilecek komut verisi oluşturulamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити дані операції для відправки на Apple Watch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo dữ liệu thao tác để gửi đến Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建发送给Apple Watch的操作数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建发送到Apple Watch的操作数据"
          }
        }
      }
    },
