    "core_ui.17c5baf0a5ab": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:240",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ مدرب الذكاء الاصطناعي خطط التمرين باستخدام المعدات التي حددتها فقط. وسيتم دائمًا تحديد عنصر واحد على الأقل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrenador d'IA crea plans d'entrenament només amb l'equip seleccionat. Sempre hi haurà almenys un element seleccionat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI trenér vytváří tréninkové plány pouze s vybraným vybavením. Vždy bude vybrána alespoň jedna položka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-coachen opretter træningsplaner udelukkende med det valgte udstyr. Mindst ét element vil altid være valgt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Coach erstellt Trainingspläne nur mit den ausgewählten Geräten. Mindestens ein Gerät bleibt immer ausgewählt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο προπονητής AI δημιουργεί πλάνα μόνο με τον εξοπλισμό που έχεις επιλέξει. Θα είναι πάντα επιλεγμένο τουλάχιστον ένα στοιχείο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI coach creates workout plans using only your selected equipment. At least one item will always be selected."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI coach creates workout plans using only your selected equipment. At least one item will always be selected."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI coach creates workout plans using only your selected equipment. At least one item will always be selected."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI coach creates workout plans using only your selected equipment. At least one item will always be selected."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador de IA crea planes usando solo el equipo seleccionado. Siempre habrá al menos un equipo seleccionado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador de IA crea planes usando solo el equipo seleccionado. Siempre habrá al menos un equipo seleccionado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyvalmentaja luo harjoitussuunnitelmat vain valitsemillasi välineillä. Vähintään yksi väline on aina valittuna."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coach IA crée des programmes uniquement avec l'équipement sélectionné. Au moins un équipement restera sélectionné."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coach IA crée des programmes uniquement avec l'équipement sélectionné. Au moins un équipement restera sélectionné."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI કોચ ફક્ત તમે પસંદ કરેલા સાધનો વડે વર્કઆઉટ પ્લાન બનાવે છે. ઓછામાં ઓછી એક આઇટમ હંમેશા પસંદ રહેશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאמן ה-AI יוצר תוכניות אימון רק עם הציוד שבחרת. תמיד ייבחר פריט אחד לפחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI कोच केवल आपके चुने हुए उपकरणों से वर्कआउट प्लान बनाता है। कम से कम एक उपकरण हमेशा चुना रहेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI trener izrađuje planove treninga samo s odabranom opremom. Uvijek će biti odabrana barem jedna stavka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az MI-edző kizárólag a kiválasztott eszközökkel készít edzéstervet. Legalább egy eszköz mindig ki lesz választva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelatih AI membuat rencana latihan hanya dengan peralatan yang dipilih. Setidaknya satu item akan selalu dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'allenatore IA crea programmi usando solo l'attrezzatura selezionata. Almeno un elemento resterà sempre selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIコーチは選択した器具だけでトレーニング計画を作ります。最低1つは選択されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 코치는 선택한 기구만 사용해 운동 계획을 만듭니다. 기구는 최소 1개가 항상 선택됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI कोच फक्त तुम्ही निवडलेल्या उपकरणांमधून वर्कआउट योजना तयार करतो. किमान एक उपकरण नेहमी निवडलेले असेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurulatih AI mencipta pelan senaman menggunakan peralatan yang dipilih sahaja. Sekurang-kurangnya satu item akan sentiasa dipilih."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-coach maakt trainingsplannen met alleen de gekozen apparatuur. Er is altijd minimaal één item geselecteerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-coachen lager treningsplaner med bare utstyret du har valgt. Minst ett element vil alltid være valgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener AI tworzy plany treningowe wyłącznie z użyciem wybranego sprzętu. Zawsze wybrany będzie co najmniej jeden element."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinador de IA cria planos usando apenas os equipamentos selecionados. Pelo menos um item sempre ficará selecionado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinador de IA cria planos usando apenas os equipamentos selecionados. Pelo menos um item sempre ficará selecionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenorul AI creează planuri folosind doar echipamentul selectat. Va fi selectat întotdeauna cel puțin un element."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ-тренер составляет планы только с выбранным оборудованием. Всегда будет выбрано хотя бы одно устройство."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI tréner vytvára tréningové plány iba s vybraným vybavením. Vždy bude vybraná aspoň jedna položka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener z UI ustvari načrte vadbe samo z izbrano opremo. Vedno bo izbran vsaj en element."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-coachen skapar träningsplaner med enbart den utrustning du har valt. Minst ett objekt är alltid valt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்தெடுத்த உபகரணங்களை மட்டும் பயன்படுத்தி AI கோச் வொர்க்அவுட் திட்டங்களை உருவாக்கும். குறைந்தது ஒரு உபகரணம் எப்போதும் தேர்ந்தெடுக்கப்பட்டிருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI కోచ్ మీరు ఎంచుకున్న పరికరాలతో మాత్రమే వర్కౌట్ ప్లాన్‌లను రూపొందిస్తుంది. కనీసం ఒక పరికరం ఎల్లప్పుడూ ఎంపికై ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้ช AI จะสร้างแผนฝึกโดยใช้อุปกรณ์ที่คุณเลือกเท่านั้น และจะมีอุปกรณ์อย่างน้อย 1 รายการถูกเลือกเสมอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI koçu, yalnızca seçtiğin ekipmanları kullanarak antrenman planları oluşturur. Her zaman en az bir öğe seçili olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ-тренер створює плани лише з вибраним обладнанням. Завжди буде вибрано принаймні один елемент."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huấn luyện viên AI chỉ tạo kế hoạch tập với thiết bị bạn đã chọn. Luôn có ít nhất một thiết bị được chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI教练只会使用你选择的器械制定训练计划。至少会选择一种器械。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI教練只會使用你選擇的器材制定訓練計畫。至少會選擇一種器材。"
          }
        }
      }
    },
    "core_ui.17de0f52b479": {
      "comment": "GymTrainingApp/Features/Onboarding/AppTutorialView.swift:42\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "صور الطعام ونوع الجسم. يتم تسجيل الوزن ومحيط الخصر والمجموعة كقيم رقمية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos d'aliments i tipus de cos. El pes, la circumferència de la cintura i el conjunt es registren com a valors numèrics."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše jídlo a tvar těla můžete zaznamenat pomocí fotografií. Váha, obvod pasu a další údaje zaznamenejte čísly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kost og kropsform vises på billeder. Vægt, taljeomfang og antallet registreres som tal."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ernährung und Figur werden mit Fotos festgehalten. Gewicht, Taille und Anzahl der Sätze werden als Zahlen gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διατροφή και η σωματική διάπλαση μπορούν να καταγραφούν με φωτογραφίες. Το βάρος, οι αναλογίες και οι ενέργειες θα καταγράφονται ως αριθμοί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your meals and body shape with photos. Track your weight, waist circumference, and sets using numbers."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your meals and body shape with photos. Track your weight, waist circumference, and sets using numbers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your meals and body shape with photos. Track your weight, waist circumference, and sets using numbers."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your meals and body shape with photos. Track your weight, waist circumference, and sets using numbers."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu alimentación y figura con fotos. Indica tu peso, circunferencia de cintura y otros datos numéricamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu alimentación y figura con fotos. Indica tu peso, circunferencia de cintura y otros datos numéricamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruoka ja kehon muoto voidaan tallentaa kuvilla. Paino, vyötärönympärys ja muut tiedot voidaan merkitä numeroina."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre alimentation et votre silhouette avec des photos. Indiquez votre poids, votre tour de taille et vos séries en chiffres."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez votre alimentation et votre silhouette avec des photos. Indiquez votre poids, votre tour de taille et vos séries en chiffres."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માળખ અને આકારની તસવીર. વજન, પેટનો પરિઘ અને સેટને સંખ્યામાં રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להכניס תמונות של התזונה והגזרה. ניתן לשמור את המשקל, היקף המותניים והסטים כערכים מספריים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन और शरीर का आकार, तस्वीरों में दर्ज करें। वजन, कमर और सेट को संख्या में दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jela i tijelo možete pratiti na fotografijama. Težinu, obod trbuha i broj kalorija ostavite u brojevima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az étel és a testformát képekkel rögzítjük. A súlyt, a mellszéletet és az edzésadatokat számokkal rögzítjük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makanan dan bentuk tubuh dapat dilihat dalam foto. Berat badan, lingkar perut, dan jumlah set akan dicatat sebagai angka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la tua alimentazione e forma fisica con foto. Indica il peso, la circonferenza vita e le serie di esercizi con numeri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事と体型は写真で。体重・腹囲・セットは数値で残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사와 체형은 사진으로 기록합니다. 몸무게, 허리둘레, 세트는 숫자로 기록합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आहार आणि शरीर प्रकार छायाचित्रांमध्ये दर्शवा. वजन, घेर आणि सेटची माहिती संख्यात्मक स्वरूपात नोंदवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makanan dan bentuk badan boleh ditala dalam gambar. Berat, lingkar pinggang, dan jumlah latihan akan dicatat dalam angka."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Eten en lichaamsvorm worden weergegeven in foto's. Gewicht, tailleomtrek en gewicht worden digitaal bijgehouden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kost og kroppsform vises på bilder. Vekt, midjeomkrets og antall sett registreres som tall."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieta i sylwetkę można zapisać na zdjęciach. Waga, obwód talii i liczba ćwiczeń zapisz w formie liczbowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre sua alimentação e forma física com fotos. Mantenha seu peso, circunferência abdominal e séries em números."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre sua alimentação e forma física com fotos. Mantenha seu peso, circunferência abdominal e séries em números."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați-vă alimentația și silueta cu ajutorul fotografiilor. Puteți înregistra greutatea, circumferința taliei și numărul de seturi folosind cifre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Питание и фигура можно отслеживать на фотографиях. Вес, обхват талии и другие параметры фиксируются в числовом формате."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Strava a tvar tela môžete zaznamenať pomocou fotografií. Váhu, obvod pasu a počet tréningov zaznamenávajte ako čísla."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabo hrane in telesne aktivnosti lahko vidite na fotografijah. Težo, obod in število vadb zapisa z numerično vrednostjo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa din kost och kroppsform på bilder. Registrera vikt, midjemått och antal set med siffror."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவு மற்றும் உடல் அமைப்பை புகைப்படத்தில் பதிவு செய்யவும். எடை, இடுப்பு சுற்றளவு மற்றும் செட் ஆகியவற்றை எண்களில் குறிப்பிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆహారం మరియు శరీర ఆకృతిని ఫోటోలలో నమోదు చేయండి. బరువు, చుట్టుకొలత మరియు సెట్ల సంఖ్యను సంఖ్యా రూపంలో ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกอาหารและรูปร่างด้วยรูปภาพ สามารถบันทึกน้ำหนัก รอบเอว และจำนวนเซ็ตเป็นตัวเลข"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslenme ve vücut şeklini fotoğraflarla kaydedin. Kilo, bel çevresi ve setleri sayısal olarak kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Їжу та фігуру тіла можна записати на фото. Вага, обхват та інші показники записуються у числах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thực phẩm và vóc dáng được hiển thị bằng ảnh. Cân nặng, số đo vòng bụng và các chỉ số khác được ghi lại dưới dạng số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用照片记录饮食和体型。用数字记录体重、腰围和组数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请用照片记录饮食和体型。体重、腰围和组数请以数值形式记录。"
          }
        }
      }
    },
