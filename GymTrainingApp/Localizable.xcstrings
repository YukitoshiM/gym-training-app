    "core_ui.e60c103c2985": {
      "comment": "GymTrainingApp/Features/Home/HomeView.swift:746\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالتبديل بين نقاط التحقق في الصفحة الرئيسية وما يجب فعله بعد ذلك حسب غرضك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
