        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주식, 주재료, 채소를 작게 조합하기"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य अन्न, मुख्य भाजी आणि भाज्या लहान आकारात एकत्र करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggabungkan makanan utama, hidangan utama dan sayur dalam saiz kecil"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine kleine porties van je hoofdmaaltijd, hoofdgerecht en groenten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiner små porsjoner av hovedmat, hovedrett og grønnsaker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz małe porcje głównego produktu, dania i warzyw."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine pequenas porções de carboidratos, proteínas e vegetais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine pequenas porções de carboidratos, proteínas e vegetais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinați alimentele principale, preparatele și legumele în porții mai mici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетайте основные продукты, основное блюдо и овощи в небольших порциях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používajte malé porcie zložiek: hlavné jedlo, hlavný zdroj bielkovín a zeleniny."
          }
        },
        "sl": {
          "stringUnit": {
