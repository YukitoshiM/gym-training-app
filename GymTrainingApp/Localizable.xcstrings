    "domain_catalog.59ed1c8a7b13": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:155\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط مقعدك، ومن دون أن تهز كتفيك، ادفع عجلة القيادة فوق رأسك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusteu el seient i, sense arronsar-vos les espatlles, premeu el volant per sobre del vostre cap."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte sedátko a přitahujte ručkami směrem k hlavě, aniž byste se ohýbali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster sædet, og løft skuldrene uden at bøje dem, mens du trækker håndtaget opad."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Sitzfläche an und drücken Sie das Handgelenk ohne Rundung nach oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε το κάθισμα και πιέστε τον ποντάκι προς τα πάνω χωρίς να σκύβετε τους ώμους."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push the handles upwards without hunching your shoulders."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push the handles upwards without hunching your shoulders."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push the handles upwards without hunching your shoulders."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the seat and push the handles upwards without hunching your shoulders."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar el asiento y empujar el manillar hacia arriba sin encorvar la espalda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar el asiento y empujar el manillar hacia arriba sin encorvar la espalda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädä istuinta ja vedä kahvaa ylöspäin ilman, että hartiat taittuvat."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster les supports et pousser le levier vers le haut sans arrondir les épaules."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster les supports et pousser le levier vers le haut sans arrondir les épaules."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સીટને એડજસ્ટ કરો અને ખભાને નમે વગર હેન્ડલને માથાની ઉપર તરફ ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאם את המושב, והרם את הידית מעל הראש מבלי לכופף את הכתפיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीट को समायोजित करें और बिना कंधे झुकाए, हैंडल को सिर के ऊपर धकेलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustirajte sjedište i podižite se, a zatim koristite ručke za podizanje prema glavi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be a széket, és emeld fel a kezét a vállodhoz, ne hajlítsd meg a hátad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan posisi kursi, lalu dorong pegangan ke atas tanpa membungkuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regolare la sedia e spingere il manubrio verso l'alto senza incurvare le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを調整し、肩をすくめずにハンドルを頭上へ押す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의자를 조절하여 어깨를 굽히지 않고 손잡이를 머리 위로 밀어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सीट समायोजित करून, खांदे खाली ठेवून हातातून मानच्या दिशेने दाब देणे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan kerusi, dan gerakkan tangan ke atas tanpa membungkuk."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de zitbank aan en duw het stuur naar boven zonder je schouders te buigen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster setet, og løft skuldrene mens du skyver håndtaket opp mot hodet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj podkładkę, aby plecy były proste, a ramię prowadzące do uchwytu skierowane w górę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar o assento e empurre o guidão para cima sem arredondar as costas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar o assento e empurre o guidão para cima sem arredondar as costas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustează scaunul și împinge maneta spre sus, fără a te curba."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрегулируйте положение сиденья, чтобы плечи оставались прямыми, и поднимайте рукоятку вверх."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravte sedadlo a zdvihnite ramena, aby ste ovládali riadiacu tyč nad hlavu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavi sedež in brez sklepanja ramen, dvigni roko proti glavi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justera sitsen och pressa stången uppåt utan att böja på ryggen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சீட்டை சரிசெய்து, தோள்பட்டைக்கு மேல் இல்லாமல் கையை தலையின் மேல் உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సీట్‌ను సర్దుబాటు చేయడం, భుజాలను వంచకుండా హ్యాండిల్‌ను తల పైకి నెట్టడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเบาะ และยกมือขึ้นด้านบนโดยไม่ก้มหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koltuğu ayarlayın ve omuzlarınızı çatarak, direksiyonu başınızın üzerine doğru itin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте сидіння, щоб плечі були в нормальному положенні, і відштовхуйте ручку вгору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh ghế sao cho thoải mái, đồng thời giữ thẳng vai khi đẩy tay lên trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整座椅，保持挺直，将手柄向上推动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "调整座椅，保持挺直，将手柄向上推动。"
