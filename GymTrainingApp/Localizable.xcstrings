        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita curvar demasiado la espalda y gira el tronco de lado a lado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä pyöritä selkää liikaa ja kierrä vartaloa sivusuunnassa."
