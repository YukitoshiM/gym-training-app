            "value": "Create habits that are easy to reduce and difficult to revert."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Create habits that are easy to reduce and difficult to revert."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea hábitos que sean fáciles de romper, pero difíciles de recuperar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea hábitos que sean fáciles de romper, pero difíciles de recuperar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo vaivaton tapa, jota on vaikea muuttaa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des habitudes que vous pouvez facilement abandonner, mais pas facilement reprendre."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des habitudes que vous pouvez facilement abandonner, mais pas facilement reprendre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્યથા, સરળતાથી ઘટાડી શકાય તેવા અને પાછું મેળવવાનું મુશ્કેલ હોય તેવી આદતો બનાવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ליצור הרגלים שקל לשנות, ולא קשה לחזור אליהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना किसी परेशानी के आदतें बनाएं जिन्हें वापस करना मुश्किल हो"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvorite navike koje su lako uklonjive, ali ne i vratne"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akár lehet, könnyen kivontatható szokásokat hozzunk létre"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat kebiasaan yang sulit untuk dihilangkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea abitudini che puoi ridurre senza difficoltà, rendendole difficili da ripristinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無理なく落とし、戻りにくい習慣を作る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무리 없이 습관을 만들고, 되돌리기 어려워지는 것"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सोप्या पद्धतीने सवयी कमी करा, ज्या परत आणणे कठीण असतील"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cipta tabiat yang sukar untuk diubah"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Creëer gewoonten die je gemakkelijk kunt verminderen en terugdraaien"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Skap vaner som er enkle å redusere, men vanskelige å gjenoppta"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stwórz nawyk, który łatwo się redukuje i trudno go odwrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie hábitos que sejam fáceis de abandonar, mas difíceis de recuperar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie hábitos que sejam fáceis de abandonar, mas difíceis de recuperar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Creează obiceiuri ușor de abandonat, care nu te vor împiedica să slăbești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте привычку, которую легко отменить"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorte si zvyk, ktorý je ľahko odstraňiteľný a ťažko obnoviteľný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarite navade, ki jih je enostavno zmanjšati in ne vračajo se"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa vanor som är lätta att bryta, men svåra att återgå till"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எளிதில் குறைத்து, மீண்டும் பெற கடினமான பழக்கங்களை தவிர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సులభంగా తగ్గించి, తిరిగి పొందడం కష్టమయ్యే అలవాట్లను సృష్టించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างนิสัยที่ไม่สามารถลดได้ง่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolayca azaltıp, geri alınması zor alışkanlıklar oluşturmayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте звичку, яку легко зменшити, але важко повернути"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo ra những thói quen mà bạn có thể bỏ qua một cách dễ dàng và khó thay đổi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不费力的情况下，养成难以改变的习惯"
          }
        },
        "zh-Hant": {
