    "health_meals_body_ai.84df3f0402ab": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:42\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل الجزء الأمامي والجانبي والخلفي وما إلى ذلك كمجموعة ليوم واحد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistra la part davantera, lateral, posterior, etc. com a conjunt durant un dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete zaznamenávat údaje pro jeden den (přední, boční, zadní atd.)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrerer for, side og bag i et dagligt sæt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Daten für einen Tag (z.B. Vorderseite, Seite, Rückseite) aufzeichnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράφω τις μετρήσεις (μπροστά, τα πλάγια, πίσω κ.λπ.) για μια ημέρα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Record front, side, and back views as a daily set."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Record front, side, and back views as a daily set."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Record front, side, and back views as a daily set."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Record front, side, and back views as a daily set."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra datos diarios, como vistas frontal, lateral y trasera."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra datos diarios, como vistas frontal, lateral y trasera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoitan päivittäiset tiedot, esimerkiksi etua, sivuilta ja takaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez des données quotidiennes, par exemple : avant, latéral, arrière."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez des données quotidiennes, par exemple : avant, latéral, arrière."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું દરરોજ આગળ, બાજુ અને પાછળની માહિતી સાચવી શકું છું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לתעד את הצד, הירך והגב כסט יומי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे, बगल और पीछे आदि को एक दिन के लिए रिकॉर्ड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisujem podatke za dan, uključujući prednju, bočnu i stražnju strane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naponta rögzíthetek azonos adatokat (front, oldal, hát)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekam data harian, seperti bagian depan, samping, dan belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso registrare dati giornalieri, come misurazioni frontali, laterali e posteriori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正面・横・背面などを1日分のセットとして記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전면, 측면, 후면 등을 하루 분량으로 기록합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समोर, बाजू आणि मागच्या बाजू इत्यादींची 1 दिवसाची माहिती नोंदवली."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekodkan bahagian depan, sisi, belakang, dll. sebagai satu set untuk sehari."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dagelijkse gegevens opslaan, bijvoorbeeld met voor- en achterkant."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg registrerer for-, side- og baksidesmålinger som en daglig oppføring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz rejestrować dane dla dnia, np. z przodu, z boku i z tyłu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre informações como \"frente\", \"lateral\" e \"trás\" em um único conjunto diário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre informações como \"frente\", \"lateral\" e \"trás\" em um único conjunto diário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrez seturi zilnice cu față, lateral și spate etc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записываю данные за день (спереди, сбоку, сзади и т.д.)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávame údaje pre jeden deň (predná, bočná, zadná strana)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisujem podatke za en dan (s strani, zgorje, spodaj itd.)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrera fram, sida och baksida som en daglig uppgift."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முன்புற, பக்கவாட்டு, பின்புறம் போன்றவற்றை ஒரு நாளுக்கான தரவாகப் பதிவு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందు, పక్క, వెనుక మొదలైన వాటిని ఒక రోజులో సేకరించి రికార్డ్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูล เช่น ด้านหน้า, ด้านข้าง, ด้านหลัง เป็นชุดประจำวัน สามารถบันทึกลงได้แม้เพียง 1 ครั้ง และสามารถเพิ่มภายหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön, yan ve arka gibi değerleri günlük olarak kaydedebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записую дані для одного дня (перед, бік, спина тощо)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại các thông tin như phía trước, hai bên, phía sau trong một ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录正面、横向、背面等一天的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将正面、侧面、背面等记录为每日一组。"
          }
        }
      }
    },
