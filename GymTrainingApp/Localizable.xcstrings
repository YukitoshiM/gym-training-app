    "core_ui.f369d217b16c": {
      "comment": "GymTrainingApp/App/RootTabView.swift:60\nPlaceholders: {{value1}}\nar-SA: Recovered missing Swift plan-name interpolation; verify in context.\nca: Recovered missing Swift plan-name interpolation; verify in context.\nzh-Hans: Recovered missing Swift plan-name interpolation; verify in context.\nzh-Hant: Recovered missing Swift plan-name interpolation; verify in context.\nhr: Recovered missing Swift plan-name interpolation; verify in context.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: لم يتم العثور على زيارة للنادي أو تمرين في التاريخ المجدول."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: No s'ha trobat cap visita al gimnàs ni entrenament a la data prevista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Pro naplánované datum nebyla nalezena návštěva posilovny ani trénink."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Der blev ikke fundet et fitnesscenterbesøg eller en træning på den planlagte dato."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Am geplanten Datum wurde weder ein Studiobesuch noch ein Training gefunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Δεν βρέθηκε επίσκεψη στο γυμναστήριο ή προπόνηση στην προγραμματισμένη ημερομηνία."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: No gym visit or workout was found on the scheduled date."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: No gym visit or workout was found on the scheduled date."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: No gym visit or workout was found on the scheduled date."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: No gym visit or workout was found on the scheduled date."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: No se encontró ninguna visita al gimnasio ni entrenamiento en la fecha programada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: No se encontró ninguna visita al gimnasio ni entrenamiento en la fecha programada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Suunnitulta päivältä ei löytynyt kuntosalikäyntiä tai harjoitusta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Aucune visite à la salle ni séance n'a été trouvée à la date prévue."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Aucune visite à la salle ni séance n'a été trouvée à la date prévue."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: નક્કી કરેલી તારીખે જિમ મુલાકાત અથવા વર્કઆઉટનો કોઈ રેકોર્ડ મળ્યો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: לא נמצאו ביקור בחדר כושר או אימון בתאריך המתוכנן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: तय तारीख पर जिम विज़िट या वर्कआउट रिकॉर्ड नहीं मिला।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Za zakazani datum nije pronađen posjet teretani ni trening."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: A tervezett napon nem található edzőtermi látogatás vagy edzés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Tidak ditemukan kunjungan gym atau latihan pada tanggal yang dijadwalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Non sono state trovate visite in palestra o sessioni di allenamento nella data prevista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}の予定日に、ジム訪問またはトレーニング実績が見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: 예정된 날짜에 헬스장 방문 또는 운동 기록을 찾을 수 없습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: नियोजित तारखेला जिम भेट किंवा वर्कआउटची नोंद सापडली नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Tiada lawatan gim atau senaman ditemui pada tarikh yang dijadualkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Er is geen sportschoolbezoek of training gevonden op de geplande datum."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Ingen treningsbesøk eller treningsøkt ble funnet på den planlagte datoen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: W zaplanowanym dniu nie znaleziono wizyty na siłowni ani treningu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Nenhuma visita à academia ou treino foi encontrado na data programada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Nenhuma visita à ginásio ou treino foi encontrado na data programada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Nu a fost găsită nicio vizită la sală sau sesiune de antrenament la data programată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: На запланированную дату не найдено посещение зала или тренировка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Pre naplánovaný dátum sa nenašla návšteva posilňovne ani tréning."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Za načrtovani datum ni bil najden obisk fitnesa ali vadba."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: Inget gymbesök eller träningspass hittades på det schemalagda datumet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: திட்டமிட்ட தேதியில் ஜிம் வருகை அல்லது வொர்க்அவுட் பதிவு எதுவும் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}: నిర్ణయించిన తేదీన జిమ్ సందర్శన లేదా వర్కౌట్ రికార్డు కనబడలేదు."
          }
        },
        "th": {
