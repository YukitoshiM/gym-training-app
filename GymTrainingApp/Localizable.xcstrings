        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiquei a circunferência da cintura, olhando para frente e para trás."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am verificat circumferința taliei, combinând fața și spatele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совместно проверил обхват талии спереди и сзади."
