    "health_meals_body_ai.c944b82d7eb8": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:107\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إجراء المقارنات مع زيادة عدد السجلات لنفس الحدث والقائمة والفترة الزمنية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es poden fer comparacions a mesura que augmenta el nombre de registres per al mateix esdeveniment, menú i període de temps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnání je možné, pokud zaznamenáte více záznamů stejného cvičení, stejné stravy a stejného časového intervalu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo flere målinger af samme øvelse, menu og tidspunkt, jo bedre kan du sammenligne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist möglich, Fortschritte zu vergleichen, wenn Sie mehrere Aufzeichnungen für dieselben Übungen, das gleiche Menü und die gleiche Tageszeit haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν καταγράφετε τις ίδιες ασκήσεις, το ίδιο μενού και την ίδια ώρα, μπορείτε να κάνετε συγκρίσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can compare your progress when you record the same exercises, meals, and time periods repeatedly."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can compare your progress when you record the same exercises, meals, and time periods repeatedly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can compare your progress when you record the same exercises, meals, and time periods repeatedly."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can compare your progress when you record the same exercises, meals, and time periods repeatedly."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más registros tengas de ejercicios, comidas y horarios similares, podrás compararlos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más registros tengas de ejercicios, comidas y horarios similares, podrás compararlos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saman harjoituksen, ruokavalion ja ajan sisällä tehdyt merkinnät mahdollistavat vertailun."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est possible de comparer les données lorsque vous enregistrez plusieurs fois le même exercice, le même menu et la même plage horaire."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est possible de comparer les données lorsque vous enregistrez plusieurs fois le même exercice, le même menu et la même plage horaire."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમાન પ્રકારની કસરત, મેનુ અને સમય દરમિયાનના રેકોર્ડ્સની સરખામણી કરી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ככל שיש יותר רשומות של אותם תרגילים, תפריטים וזמנים, ניתן להשוות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समान व्यायाम, भोजन और समय अवधि के रिकॉर्ड की तुलना करना संभव है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete uspoređivati podatke ako imate više zapisa istog vježbe, dijeta i vremena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasonlíthatja azokat a rekordokat, amelyek ugyanazt az edzést, azonos menüt és időpontot tartalmaznak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin banyak catatan untuk jenis latihan, menu, dan waktu yang sama, Anda dapat membandingkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile confrontare i risultati quando si registrano più volte le stesse attività, lo stesso menu e la stessa fascia oraria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ種目・メニュー・時間帯の記録が増えると比較できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동일한 운동 종류, 메뉴, 시간대의 기록이 많아지면 비교할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समान व्यायाम, आहार आणि वेळेच्या नोंदींची तुलना करता येते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin banyak rekod untuk jenis latihan, menu, dan masa yang sama, anda boleh membandingkannya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is mogelijk om vergelijkingen te maken wanneer je dezelfde oefeningen, maaltijden en tijden registreert."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo flere målinger av samme øvelse, meny og tidspunkt du registrerer, desto bedre kan du sammenligne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz porównać wyniki, gdy masz więcej wpisów dla tego samego ćwiczenia, menu i pory dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar é mais fácil quando você registra o mesmo exercício, a mesma refeição e o mesmo horário repetidamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar é mais fácil quando você registra o mesmo exercício, a mesma refeição e o mesmo horário repetidamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Compararea devine mai ușoară atunci când înregistrezi aceleași exerciții, același meniu și aceeași oră."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнение становится возможным, если у вас будет больше записей для одного и того же упражнения, меню и времени."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnanie je možné, ak zaznamenáte viacero záznamov pre rovnaký tréning, rovnakú stravu a rovnaký čas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Primerjavo je mogoče doseči, če se povečajo število zapisanih vaj, menijev in časov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju fler gånger du registrerar samma övning, samma meny och samma tidsperiod, desto lättare blir det att jämföra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே பயிற்சி, உணவு மற்றும் நேரத்தின் பதிவுகளை ஒப்பிட்டுப் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకే రకమైన వ్యాయామం, ఆహార ప్రణాళిక మరియు సమయ వ్యవధి యొక్క రికార్డులను పోల్చడానికి ఉపయోగపడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อบันทึกข้อมูลสำหรับกิจกรรม, เมนู และช่วงเวลาเดียวกัน จะสามารถเปรียบเทียบได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benzer egzersiz, menü ve zaman aralığındaki kayıtları karşılaştırmanıza olanak tanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порівняння стає можливим, коли збільшується кількість записів для однієї і тієї ж вправи, меню та часу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể so sánh khi ghi lại nhiều lần cùng một bài tập, thực đơn và thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加同项目、菜单和时间段的记录可以进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增加同项目、菜单和时间段的记录可以进行比较。"
          }
        }
      }
    },
