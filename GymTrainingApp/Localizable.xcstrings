        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆరోగ్యం అనుమతించబడలేదు, అప్లికేషన్ చరిత్ర మాత్రమే నిల్వ చేయబడింది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
