        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ రికార్డులను ఒకే చోట ఉంచుకోండి, తదుపరి చర్యలు మరియు వచ్చే నెల లక్ష్యాలను సూచించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำการบันทึก, การกระทำถัดไป และเป้าหมายรายเดือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtları, bir sonraki eylemi ve aylık hedefleri öner"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично запропонувати наступні дії та цілі на наступний місяць на основі записів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất các hành động tiếp theo và mục tiêu tháng tới dựa trên mục ghi lại"
          }
        },
        "zh-Hans": {
