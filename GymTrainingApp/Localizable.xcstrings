    "domain_catalog.886d55d3ef41": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:363\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع لوحي كتفك على المقعد وقم بإمالة حوضك للخلف أثناء مد الوركين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Col·loqueu els omòplats al banc i inclineu la pelvis cap enrere mentre estireu els malucs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístěte si lopatky na lavici, ohněte pánev a protáhněte kyčle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer en bænk under skulderbladene, og udstræk hofterne ved at læne kroppen tilbage."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege deine Schulterblätter auf eine Bank und dehne deine Hüften, während du deinen Becken nach hinten neigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετήστε την περιοχή γύρω από τους ώμους και την πλάτη σε μια σανίδα, ενώ παράλληλα λυγίζετε τη μέση σας και επεκτείνετε τη μέση σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a bench under your shoulder blades and stretch your hips while tilting your pelvis backwards."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a bench under your shoulder blades and stretch your hips while tilting your pelvis backwards."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a bench under your shoulder blades and stretch your hips while tilting your pelvis backwards."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a bench under your shoulder blades and stretch your hips while tilting your pelvis backwards."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar una banca cerca de las escápulas y extender las caderas mientras se inclina ligeramente el torso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar una banca cerca de las escápulas y extender las caderas mientras se inclina ligeramente el torso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta hartiat ja selkä oikeaan asentoon, venytä lonkat."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une planche près de vos omoplates, puis étirez vos hanches en inclinant légèrement votre bassin."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez une planche près de vos omoplates, puis étirez vos hanches en inclinant légèrement votre bassin."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખભાની આસપાસ બેન્ચ પર શરીરને મૂકો, પીઠને પાછળની તરફ વાળો અને પગની સાંધાને લંબાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להניח את אזור הצלעות על ספסל, ולהרחיב את מפרק הישבן תוך הטיית האגן אחורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कूल्हों के आसपास एक बेंच का उपयोग करें, अपनी कमर को पीछे की ओर झुकाएं और अपने कूल्हों को फैलाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite uteg na banku, savijte kukove prema nazad i razvijte kukove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyezze a vállakat a székszélen, és nyújtsa ki a derékot, miközben hajlítja a térdeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meletakkan bagian bahu dan tulang belakang di atas bangku, lalu meregangkan pinggul sambil menundukkan tulang pinggul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona le scapole su una panca e allunga le anche, inclinando leggermente il bacino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩甲骨付近をベンチに乗せ、骨盤を後傾させながら股関節を伸ばす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어깨뼈 주변에 벤치를 놓고, 골반을 뒤로 기울이면서 골반을 확장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खांद्याच्या भागावर बेंच ठेवा, कंबर खाली करत कूल्हे मोकळे करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan bahagian tulang belikat di atas bangku, kemudian meregangkan lutut dengan menengahkan pinggul."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats je schouderbladen op een bankje en strek je heupen terwijl je het gewicht naar je navel toe trekt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasser skulderbladene på en benk, og strekk ut hoftene ved å trekke korsryggen bakover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść poduszkę na obojczykach, pochylając biodra do tyłu, a następnie rozciągnij biodra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os ombros sobre uma superfície, incline o quadril para trás e alongue as articulações do quadril."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os ombros sobre uma superfície, incline o quadril para trás e alongue as articulações do quadril."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
