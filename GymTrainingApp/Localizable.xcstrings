    "domain_catalog.e569c630ac0d": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:18\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإمالة المقعد وادفع للأعلى قطريًا، مستهدفًا الجزء العلوي من صدرك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclineu el banc i empeny cap amunt en diagonal, apuntant a la part superior del pit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte štolu pod úhel a zvedejte činku diagonálně nahoru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster vinklen på bænken og løft håndvægten op mod siden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bank in Neigung positionieren und mit dem Hammer diagonal nach oben drücken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετήστε τον καθισμό σε γωνία και πιέστε το σωματικό σας βάρος προς τα πάνω, σε κεκλιμένη θέση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the bench at an angle and press upwards diagonally, targeting the upper chest."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the bench at an angle and press upwards diagonally, targeting the upper chest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the bench at an angle and press upwards diagonally, targeting the upper chest."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the bench at an angle and press upwards diagonally, targeting the upper chest."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar el banco y levantar la pesa en diagonal, apuntando al pecho."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar el banco y levantar la pesa en diagonal, apuntando al pecho."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta penkki kulmaan ja nosta käsipainoa ylöspäin, kohdistuen rintakehän alueelle sivusuunnassa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Incliner le banc et soulever le poids avec les mains, en visant la partie supérieure de la poitrine, en direction latérale."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incliner le banc et soulever le poids avec les mains, en visant la partie supérieure de la poitrine, en direction latérale."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બેંચ પર ખૂણો બનાવીને છાતીના ઉપરના ભાગને નિશાનમાં રાખી, આડી દિશામાં ઉપરની તરફ ધકેલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניחו את הבנץ' בזווית, והרימו משקל כלפי מעלה, תוך שמירה על מגע של המרפק עם הבנץ', לכיוון הצד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेंच पर कोण बनाकर, छाती के ऊपरी हिस्से को निशाना बनाते हुए तिरछे ऊपर की ओर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite bench pod kutem i podižite uteg prema gore, uz bok."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzőpánra állva, a felsőtesten koncentrálva, emeld fel a käsúlyt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur sudut pada bangku, lalu dorong dumbbell secara diagonal ke atas untuk menargetkan bagian dada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiziona la panca in modo da mirare alla parte superiore del petto e spingi il manubrio verso l'alto in diagonale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチに角度をつけ、胸上部を狙って斜め上へ押し上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벤치에 각도를 만들어 가슴 상부를 조준하여 대각선 위로 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बेंचवर कोन तयार करून छातीच्या भागावर लक्ष्य ठेवून तिरकस दिशेने उचलणे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenakan bangku dan tekankan dumbbell secara menyudut ke atas, menargetkan bahagian dada."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk met een dumbbell, waarbij je de bovenkant van je borst onder een hoek aanspreekt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligg på benken og løft vekten opp i en skrå vinkel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw ławkę pod kątem i wykonaj ćwiczenie, naciskając sztangę w górę, celując w górną część klatki piersiowej po przekątnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar o banco e levantar o haltere, mirando no canto superior do corpo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclinar o banco e levantar o haltere, mirando no canto superior do corpo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustați unghiul băncii și împingeți gantera în sus, spre partea superioară, într-o direcție laterală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жим лежа с наклоном, направленный на верх груди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte štolu pod úhlom a zamerajte sa na hornú časť hrude a zdvihnite ju diagonálne nahor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite nagib glave in z utežjo stisnite navzgor, v stranski smeri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinkla bänken och pressa upp hanteln i en diagonal rörelse."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெஞ்சில் கோணத்தை ஏற்படுத்தி, மார்பின் மேல் பகுதியை குறிவைத்து கிடைமட்டமாக உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బెంచ్‌పై కోణాన్ని మార్చి, ఛాతీ పై భాగాన్ని లక్ష్యంగా చేసుకుని వంపుగా పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับมุมม้านั่ง แล้วยกเวทด้วยการดันขึ้นไปในแนวทแยง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bench üzerine eğilerek, göğüs bölgesine odaklanarak çapraz şekilde yukarı kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покластися на лаву, орієнтуючись на верхню частину грудей, і підняти гантель вгору."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt ghế ở góc độ, sau đó đẩy tạ lên theo hướng chéo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将哑铃架倾斜，目标是胸部上方，然后向右上方向推动哑铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在凳子上调整角度，针对胸部上方区域进行斜向高举。"
          }
        }
      }
    },
