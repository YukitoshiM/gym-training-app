          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வாரமும், அதே நிபந்தனைகளின் அடிப்படையில்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వారానికి ఒకసారి, అదే పరిస్థితుల్లో"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบรายสัปดาห์・ภายใต้เงื่อนไขเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada bir kez, aynı koşullarda"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на тиждень, за одними й тими самими умовами"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng tuần, với cùng điều kiện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周一次，相同条件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每週一次、相同條件"
          }
        }
      }
    },
