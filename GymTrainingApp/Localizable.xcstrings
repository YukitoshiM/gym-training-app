    "health_meals_body_ai.88e74f83b764": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:724\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى المحاولة مرة أخرى لاحقا. إذا استمر الأمر، فيرجى التحقق من سجل خادم الذكاء الاصطناعي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, torna-ho a provar més tard. Si continua, comproveu el registre del servidor AI."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se to opakuje, zkontrolujte logy na serveru AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igen efter en stund. Hvis det fortsætter, skal du kontrollere AI-serverens logfil."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte warten Sie und versuchen Sie es erneut. Wenn dies weiterhin der Fall ist, überprüfen Sie die Protokolle des KI-Servers."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εάν συνεχίσετε, ελέγξτε τα αρχεία καταγραφής στον AI server."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server logs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server logs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server logs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "If this persists, check the AI server logs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si continúa, revise los registros del servidor de IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si continúa, revise los registros del servidor de IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos ongelma jatkuu, tarkista AI-palvelimen lokitiedostot."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cela persiste, consultez les logs du serveur AI."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cela persiste, consultez les logs du serveur AI."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો પરિણામો સુધારવા માટે ફરી પ્રયાસ કરો, તો AI સર્વરના લોગ્સ તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם זה ממשיך, אנא בדוק את הלוגים של שרת ה-AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि जारी रखते हैं, तो AI सर्वर के लॉग की जांच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Molimo, pokušajte ponovno nakon određenog vremena. Ako to nastavite, provjerite log na AI serveru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ez nem működik, próbálja újra, és ellenőrizze az AI szerver logjait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika masih belum berhasil, periksa log pada server AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se continua, verifica i log del server AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間をおいて再試行してください。続く場合はAIサーバーのログを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 간격을 두고 다시 시도하십시오. 계속되는 경우 AI 서버 로그를 확인하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही वेळ थांबून पुन्हा प्रयत्न करा. जर असेच होत असेल, तर AI सर्व्हर लॉग तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika anda masih mahu mencuba, sila semak log pada pelayan AI."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het opnieuw na een tijdje. Als dit blijft aanhouden, bekijk dan de logbestanden van de AI-server."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igjen etter en stund. Hvis det fortsetter, sjekk loggene fra AI-serveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli problem nadal występuje, sprawdź logi serwera AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se persistir, verifique os logs do servidor AI."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se persistir, verifique os logs do servidor AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă problema persistă, consultați log-urile serverului AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если проблема не исчезла, попробуйте еще раз через некоторое время. Если это продолжается, проверьте логи сервера AI."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to budete opakovať, overte si logy na AI serveri."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čez nekaj časa poskusite znova. Če to še vedno poteka, preverite log na AI strežniku."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du behöver göra om det, kontrollera AI-serverns logg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கொஞ்சம் நேரம் கழித்து மீண்டும் முயற்சிக்கவும். தொடர்ந்து இருந்தால், AI சேவையகத்தின் பதிவுகளை சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొంత సమయం వేచి ఉండి మళ్ళీ ప్రయత్నించండి. కొనసాగితే, AI సర్వర్ లాగ్‌ను చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากยังคงทำซ้ำ โปรดตรวจสอบบันทึกของเซิร์ฟเวอร์ AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir süre sonra tekrar deneyin. Devam ediyorsa, AI sunucusunun günlüklerini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо це продовжується, перевірте журнали сервера AI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu vẫn tiếp tục, vui lòng xem xét nhật ký trên máy chủ AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后再试。如果继续，请查看AI服务器的日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后再试。如果继续，请查看AI服务器的日志。"
          }
        }
      }
    },
