        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melakukan gerakan jongkok, push-up, dan melompat secara berurutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguire in sequenza squat, piegamenti sulle braccia e salti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しゃがむ、腕立て姿勢、ジャンプを連続して行う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앉아서 팔굽혀펴기를 연속적으로 수행합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली वाकणे, पुश-अप्स आणि उडी अशा क्रिया करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Melakukan senaman squat, push-up, dan lompat secara berterusan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer continu squats, push-ups en sprongen uit."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Utføre knebøy, push-ups og hopp etter hverandre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonuj ciągłe ćwiczenia: siadanie, podciąganie, skakanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizar sentadas, flexões e saltos continuamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizar sentadas, flexões e saltos continuamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Execută în continuu: a sta în genunchi, poziție de flotări, sărituri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнение последовательности: приседания, отжимания, прыжки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakovane vykonávajte polohy: sed, tlaky, skoky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvajajte nizač, vzpenjanje in skakanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utför armhävningar, knäböj och hopp i följd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குனிந்து, கைகளை உயர்த்தி, குதித்தல் ஆகியவற்றை தொடர்ச்சியாகச் செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకరిపై ఒకరు నిలబడటం, చేతులు పైకి ఎత్తడం, దూకడం వంటివి వరుసగా చేయడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำท่าก้มตัว, ท่าวิดพื้น, และกระโดดต่อเนื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayakta durma, kol basma ve zıplama hareketlerini ardışık olarak yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконуйте послідовно: присідання, віджимання, стрибки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thực hiện liên tục tư thế squat, chống đẩy và nhảy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续进行蹲下、俯卧撑和跳跃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續進行蹲、俯臥撐和跳躍。"
