          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे केवळ संबंधित बदल दर्शवते, ज्यामुळे कारण किंवा वैद्यकीय स्थिती निश्चित होत नाही."
          }
        },
        "ms": {
          "stringUnit": {
