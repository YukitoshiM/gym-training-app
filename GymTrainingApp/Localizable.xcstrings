    "domain_catalog.da5a773cf49d": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:485\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض وزن الجسم وحجم التدريب والوزن حسب الحدث. استخدم نتائجك السابقة للتحسن شيئًا فشيئًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el pes corporal, el volum d'entrenament i el pes per esdeveniment. Utilitzeu els vostres resultats anteriors per millorar a poc a poc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte svou hmotnost, objem tréninku a váhu podle cvičení. Postupně zvyšujte hodnoty na základě předchozích výsledků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se din vægt, træningsmængde og vægt pr. øvelse. Øg gradvist baseret på dine tidligere resultater."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Gewicht, Trainingsvolumen und Gewichte pro Übung anzeigen. Nutzen Sie Ihre vorherigen Ergebnisse, um Ihr Ziel schrittweise zu erreichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε το βάρος, την ένταση της προπόνησης και τα βάρη ανά άσκηση. Αυξήστε σταδιακά χρησιμοποιώντας τα δεδομένα από την προηγούμενη φορά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, training volume, and weight lifted for each exercise. Gradually increase it based on your previous performance."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, training volume, and weight lifted for each exercise. Gradually increase it based on your previous performance."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, training volume, and weight lifted for each exercise. Gradually increase it based on your previous performance."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "View your weight, training volume, and weight lifted for each exercise. Gradually increase it based on your previous performance."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa tu peso, volumen de entrenamiento y pesos por ejercicios. Aumenta gradualmente utilizando tus resultados anteriores."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa tu peso, volumen de entrenamiento y pesos por ejercicios. Aumenta gradualmente utilizando tus resultados anteriores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkastele painoa, harjoittelun määrää ja erilaisten harjoitusten painoja. Lisää vähitellen aiemman tuloksen perusteella."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser votre poids, le volume d'entraînement et les poids par exercice. Augmenter progressivement en utilisant vos résultats précédents."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualiser votre poids, le volume d'entraînement et les poids par exercice. Augmenter progressivement en utilisant vos résultats précédents."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વજન, તાલીમની માત્રા અને દરેક પ્રકારના વજન જુઓ. અગાઉના પરિણામનો ઉપયોગ કરીને ધીમે ધીમે વધારો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את המשקל, נפח האימונים ואת המשקל לפי סוג התרגיל. השתמשו בהישגים הקודמים כדי להגדיל אותם בהדרגה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने वजन, प्रशिक्षण की मात्रा, और प्रत्येक व्यायाम में इस्तेमाल किए गए वजन को देखें। पिछले प्रदर्शन के आधार पर धीरे-धीरे इसे बढ़ाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte svoju težinu, volumen treninga i težinu po vrsti vježbe. Koristite prethodne rezultate za postepeno povećanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg a testsúlyt, a tréning mennyiségét és a különböző edzéstechnikákhoz tartozó súlyokat. Kezdő szinten lévő eredményed alapján fokozatosan növeld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berat badan, volume latihan, dan beban per jenis latihan. Tingkatkan secara bertahap menggunakan rekor sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizzare il peso, il volume dell'allenamento e il peso per esercizio. Aumentare gradualmente utilizzando i risultati precedenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重、トレーニングボリューム、種目別重量を見ます。前回実績を使って少しずつ伸ばします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸무게, 운동량, 운동 종류별 무게를 확인합니다. 이전 성과를 바탕으로 조금씩 늘려갑니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वजन, व्यायामाची मात्रा आणि प्रत्येक प्रकारातील वजन तपासा. मागील कामगिरीनुसार हळूहळू वाढवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat berat badan, jumlah latihan, dan berat mengikut jenis senaman. Tingkatkan sedikit demi sedikit menggunakan prestasi sebelumnya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk je gewicht, trainingsvolume en gewichten per oefening. Verhoog geleidelijk aan op basis van eerdere resultaten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Se på vekt, treningsvolum og vekter per øvelse. Øk gradvis basert på tidligere resultater."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź wagę, objętość treningu oraz ciężar dla poszczególnych ćwiczeń. Stopniowo zwiększaj je, korzystając z poprzednich wyników."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja seu peso, volume de treino e pesos por exercício. Aumente gradualmente com base nos seus resultados anteriores."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja seu peso, volume de treino e pesos por exercício. Aumente gradualmente com base nos seus resultados anteriores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi greutatea, volumul antrenamentelor și greutățile în funcție de exerciții. Folosește-ți rezultatele anterioare pentru a crește treptat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите свой вес, объем тренировок и вес по каждому упражнению. Постепенно увеличивайте его, используя результаты предыдущих тренировок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite si svoju hmotnosť, objem tréningu a váhu podľa cvikov. Postupne sa zlepšujte na základe predchádzajúcich výsledkov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregledajte svojo težo, količino treninga in ute po vrstah. Uporabite prejšne rezultate za postopno povečanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se din vikt, träningsvolym och vikter per övning. Öka gradvis med hjälp av tidigare resultat."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடை, உடற்பயிற்சி அளவு மற்றும் ஒவ்வொரு பயிற்சி வகையின் எடை ஆகியவற்றை கண்காணிக்கவும். முந்தைய சாதனைகளை வைத்து படிப்படியாக அதிகரிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బరువు, శిక్షణ పరిమాణం మరియు రకానికి సంబంధించిన బరువును చూడండి. గతంలో సాధించిన ఫలితాలను ఉపయోగించి క్రమంగా పెంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูน้ำหนัก, ปริมาณการออกกำลังกาย, และน้ำหนักตามประเภทของการออกกำลังกาย สามารถปรับเพิ่มขึ้นทีละน้อย โดยอ้างอิงจากผลลัพธ์ก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo, antrenman hacmi ve egzersiz başına ağırlığı kontrol edin. Önceki performansınızı kullanarak yavaş yavaş artırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте свою вагу, об’єм тренувань і вагу за різними видами вправ. Поступово збільшуйте їх на основі попередніх результатів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem cân nặng, khối lượng tập luyện và trọng lượng theo bài tập. Tăng dần dựa trên kết quả trước đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看体重、训练量和不同项目的重量。根据之前的成绩，逐步增加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀察體重、訓練量和不同項目的重量。根據之前的成果，逐步增加。"
          }
        }
      }
    },
