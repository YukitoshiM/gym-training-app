    "core_ui.a2190945ec45": {
      "comment": "GymTrainingApp/Features/Shared/CoachPersonaPicker.swift:127",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تغيير نوع المدرب إلى تغيير السجلات التي يعطيها الذكاء الاصطناعي الأولوية والاقتراحات التي يقدمها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Canviar el tipus d'entrenador modifica quins registres prioritza la IA i les recomanacions que ofereix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna typu trenéra mění, které záznamy AI upřednostňuje a jaká doporučení poskytuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du ændrer coachtype, ændres de data, AI prioriterer, og de anbefalinger, du får."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Coach-Typ änderst, ändern sich die von der KI priorisierten Daten und ihre Empfehlungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή τύπου προπονητή αλλάζει ποιες εγγραφές δίνει προτεραιότητα το AI και ποιες προτάσεις παρέχει."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the coach type changes which records AI prioritizes and the recommendations it gives."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the coach type changes which records AI prioritizes and the recommendations it gives."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the coach type changes which records AI prioritizes and the recommendations it gives."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the coach type changes which records AI prioritizes and the recommendations it gives."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el tipo de entrenador modifica qué registros prioriza la IA y las recomendaciones que ofrece."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el tipo de entrenador modifica qué registros prioriza la IA y las recomendaciones que ofrece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmentajatyypin vaihtaminen muuttaa sitä, mitä tietoja tekoäly painottaa ja millaisia suosituksia se antaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de type de coach modifie les données que l'IA examine en priorité et les recommandations qu'elle propose."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de type de coach modifie les données que l'IA examine en priorité et les recommandations qu'elle propose."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોચનો પ્રકાર બદલવાથી AI જે રેકોર્ડને પ્રાથમિકતા આપે છે અને તેની ભલામણો બદલાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינוי סוג המאמן משנה אילו רישומים ה-AI מתעדף ואת ההמלצות שהוא מציע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोच का प्रकार बदलने से AI द्वारा प्राथमिकता दिए जाने वाले रिकॉर्ड और उसके सुझाव बदल जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjena vrste trenera mijenja zapise kojima AI daje prednost i preporuke koje pruža."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az edzőtípus módosítása megváltoztatja, mely adatokat helyezi előtérbe az MI, és milyen ajánlásokat ad."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah jenis pelatih akan mengubah catatan yang diprioritaskan AI dan rekomendasi yang diberikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare il tipo di allenatore modifica i dati a cui l'IA dà priorità e i consigli che fornisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "担当タイプを変えると、AIが優先して見る記録と提案内容が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치 유형을 변경하면 AI가 우선 확인하는 기록과 추천 내용이 달라집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोचचा प्रकार बदलल्यास AI कोणत्या नोंदींना प्राधान्य देते आणि कोणत्या शिफारसी देते ते बदलते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menukar jenis jurulatih mengubah rekod yang diutamakan AI dan cadangan yang diberikan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het coachtype wijzigt, verandert welke gegevens AI prioriteit geeft en welke aanbevelingen je ontvangt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du endrer coachtype, endres hvilke registreringer AI prioriterer og hvilke anbefalinger du får."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana typu trenera wpływa na dane, którym AI nadaje priorytet, oraz na przedstawiane zalecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o tipo de treinador muda quais registros a IA prioriza e as recomendações que ela oferece."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o tipo de treinador muda quais registos a IA prioriza e as recomendações que ela oferece."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbarea tipului de antrenor modifică înregistrările pe care AI le prioritizează și recomandările oferite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При смене типа тренера меняются данные, которым ИИ отдаёт приоритет, и его рекомендации."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmena typu trénera mení, ktoré záznamy AI uprednostňuje a aké odporúčania poskytuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprememba vrste trenerja spremeni, katerim zapisom UI daje prednost in kakšna priporočila ponuja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ändrar coachtyp ändras vilka poster AI prioriterar och vilka rekommendationer du får."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோச் வகையை மாற்றினால் AI எந்தப் பதிவுகளுக்கு முன்னுரிமை தருகிறது மற்றும் வழங்கும் பரிந்துரைகள் மாறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోచ్ రకాన్ని మార్చితే AI ఏ రికార్డులకు ప్రాధాన్యత ఇస్తుందో మరియు ఇచ్చే సిఫార్సులు మారుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปลี่ยนประเภทโค้ช ข้อมูลที่ AI ให้ความสำคัญและคำแนะนำที่ได้รับจะเปลี่ยนไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koç türünü değiştirmek, AI'ın öncelik verdiği kayıtları ve sunduğu önerileri değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час зміни типу тренера змінюються дані, яким ШІ надає пріоритет, і його рекомендації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đổi loại huấn luyện viên, các dữ liệu AI ưu tiên và đề xuất đưa ra cũng sẽ thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改教练类型会改变AI优先查看的记录和给出的建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改教練型別會改變AI優先檢視的記錄和給出的建議。"
          }
        }
      }
    },
