    "health_meals_body_ai.d4de549ad1bc": {
      "comment": "GymTrainingApp/Features/Meals/MealNutritionSourceViews.swift:286\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أستطع قراءة الملصق الغذائي. يرجى إعادة التقاط الصورة من الأمام في مكان مشرق، أو إدخالها يدوياً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No he pogut llegir l'etiqueta nutricional. Si us plau, torneu a prendre la foto de la part frontal en un lloc lluminós o introduïu-la manualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se načíst údaje o výživě. Pořiďte novou fotografii z přímého světla nebo zadejte ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kunne ikke læse ernæringsværdi. Tag et nyt billede fra et lyst sted mod lyset, eller indtast manuelt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nährwertanzeige konnte nicht gelesen werden. Bitte machen Sie ein neues Foto von vorne bei gutem Licht oder geben Sie den Wert manuell ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπόρεσα να διαβάσω την αναφορά θρεπτικών συστατικών. Παρακαλώ τραβήξτε ξανά από ένα φωτεινό μέρος, μπροστά ή εισάγετε χειροκίνητα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the nutrient display. Please take a new photo from a well-lit location, facing forward, or enter manually."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the nutrient display. Please take a new photo from a well-lit location, facing forward, or enter manually."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the nutrient display. Please take a new photo from a well-lit location, facing forward, or enter manually."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the nutrient display. Please take a new photo from a well-lit location, facing forward, or enter manually."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la información nutricional. Tómela nuevamente en un lugar bien iluminado, frente a la cámara, o introdúcela manualmente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la información nutricional. Tómela nuevamente en un lugar bien iluminado, frente a la cámara, o introdúcela manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "En pystynyt lukemaan ravintosisältöä. Ota uusi kuva valoisassa paikassa ja suoraan, tai syötä tiedot manuaalisesti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l'affichage nutritionnel. Veuillez le prendre directement en face dans un endroit lumineux ou saisir manuellement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l'affichage nutritionnel. Veuillez le prendre directement en face dans un endroit lumineux ou saisir manuellement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પોષણ દર્શાવ વાંચી શકાય તેમ નથી. કૃપા કરીને, તે પ્રકાશિત જગ્યામાં સીધી રીતે અથવા મેન્યુઅલી ફરીથી લો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחתי לקרוא את התצוגה התזונתית. אנא צלם שוב מול אור בהיר או הזן ידנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोषण सामग्री को पढ़ने में असमर्थ। कृपया उज्ज्वल जगह पर सीधे से तस्वीर लें या मैन्युअल रूप से दर्ज करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo uspjeli pročitati prikaz hranjivih sastojaka. Snimite ga ponovno s dobrom osvjetljenosti i direktno, ili unesite ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült a táplálkozási információk olvasása. Kérjük, világos helyen, közvetlenül fénykézze le, vagy írja be manuálisan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca tampilan nutrisi. Ambil kembali dari tempat yang terang dengan memotret langsung, atau masukkan secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono riuscito a leggere l'etichetta nutrizionale. Scattare nuovamente da una posizione ben illuminata, frontalmente, oppure inserire manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "栄養表示を読み取れませんでした。明るい場所で正面から撮り直すか、手入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양 정보를 읽을 수 없었습니다. 밝은 곳에서 정면으로 촬영하거나, 직접 입력해주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोषक तत्त्वांची माहिती वाचण्यात अयशस्वी. कृपया चांगल्या प्रकाशात आणि समोरून पुन्हा फोटो घ्या किंवा मॅन्युअली प्रविष्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membaca paparan nutrisi. Ambil semula dari hadapan di tempat yang terang atau masukkan secara manual."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De voedingswaarden konden niet worden gelezen. Neem een nieuwe foto vanaf voor, bij voldoende licht, of voer handmatig in."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lese næringsstoffvisning. Ta et nytt bilde fra et godt opplyst område, rett på, eller skriv inn manuelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać etykiety. Spróbuj zrobić zdjęcie w dobrym świetle, patrząc prosto na nią lub wprowadź dane ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as informações nutricionais. Tire uma nova foto em um local bem iluminado, de frente, ou insira manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler as informações nutricionais. Tire uma nova foto em um local bem iluminado, de frente, ou insira manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut citi afișajul nutrienților. Vă rugăm să faceți o nouă fotografie frontală într-o locație luminoasă sau introduceți manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось распознать информацию о питательных веществах. Сделайте фотографию с яркого света, прямо перед собой, или введите данные вручную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodarilo sa prečítať údaje o výžive. Počkajte na svetlú lokáciu, fotografujte priamo alebo zadajte ručne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nismo uspešno prebrali prikaza hranilnih sestavin. Poskusite posneti zjutraj odprt in direktno ali vnesati ročno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte läsa näringsdeklarationen. Ta en ny bild i bra ljus, framifrån, eller ange manuellt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஊட்டச்சத்து விவரங்களை படிக்க முடியவில்லை. பிரகாசமான இடத்தில், நேராக இருந்து மீண்டும் எடுக்கவும் அல்லது கைமுறையாக உள்ளிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోషకాహార ప్రదర్శనను చదవలేకపోయాము. ప్రకాశవంతమైన ప్రదేశంలో నేరుగా తీయండి లేదా మాన్యువల్‌గా నమోదు చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่านรายการอาหารได้ โปรดถ่ายภาพในที่ที่มีแสงสว่างเพียงพอ โดยหันกล้องไปด้านหน้า หรือป้อนข้อมูลด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besin gösterimini okuyamadım. Parlak bir ortamda doğrudan çekin veya elle girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати відображення харчових показників. Спробуйте зробити фото з хорошого освітлення та прямого кута, або введіть вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc được thông tin dinh dưỡng. Vui lòng chụp lại từ một nơi sáng, trực diện hoặc nhập thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取营养显示。请在光线充足的地方，正面拍摄，或手动输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取营养显示。请在光线充足的地方，正面拍摄，或手动输入。"
          }
        }
      }
    },
