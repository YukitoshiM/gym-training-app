        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalie a mudança na forma física, considerando o peso, a circunferência abdominal e as fotos, além da força muscular"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Avalie a mudança na forma física, considerando o peso, a circunferência abdominal e as fotos, além da força muscular"
          }
        },
        "ro": {
          "stringUnit": {
