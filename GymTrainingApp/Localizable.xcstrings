    "domain_catalog.27d78815325a": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:314\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مشرق وصريح. توضيح نقطة واحدة لتحسين المقبل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Brillant i franc. Aclarir un punt per millorar a continuació"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasný a přímý: Určete, co chcete dále zlepšit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiv og direkte. Fokuser på, hvad du vil opnå næste gang"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Freundlich und direkt: Konzentrieren Sie sich auf das nächste Ziel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αισιόδοξος και ειλικρινής. Καθορίζουμε το επόμενο στοιχείο που θα αναπτυχθεί."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive and straightforward. Clearly define the next area to improve"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive and straightforward. Clearly define the next area to improve"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive and straightforward. Clearly define the next area to improve"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive and straightforward. Clearly define the next area to improve"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Brillante y directo. Definir el próximo objetivo a alcanzar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Brillante y directo. Definir el próximo objetivo a alcanzar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiivinen ja selkeä, määritetään seuraava tavoite"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Clair et direct, pour définir clairement le prochain objectif à atteindre."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clair et direct, pour définir clairement le prochain objectif à atteindre."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રકાશિત અને સીધું. આગામીમાં વધારવા માટેના મુદ્દાને સ્પષ્ટ કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבריק וכנה. הגדרת נקודת השיפור הבאה באופן ברור"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उज्ज्वल और स्पष्ट। अगले विकास के लिए एक विशिष्ट बिंदु को स्पष्ट करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasno i otvoreno. Jasno definirajte sljedeći cilj"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyugodt és közvetlen: A következő fejlesztésre összpontosítsunk"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbicara dengan jujur dan terbuka. Memastikan satu hal untuk ditingkatkan selanjutnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Positivo e diretto. Definire chiaramente il prossimo obiettivo da raggiungere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るく率直。次に伸ばす一点を明確にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝고 솔직하게, 다음 발전을 위한 핵심 요소를 명확히 함"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सकारात्मक आणि स्पष्ट. पुढील सुधारणेसाठी नेमके क्षेत्र निश्चित करणे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerah dan jujur. Memastikan satu matlamat untuk ditingkatkan"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Positief en direct. Duidelijk maken waar je de volgende keer op wilt focussen"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiv og ærlig. Identifisere det neste målet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośredni i otwarty. Jasne określenie, co dalej rozwijać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro e direto. Defina o próximo objetivo a ser alcançado"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro e direto. Defina o próximo objetivo a ser alcançado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunicare directă și pozitivă. Identificarea clară a următorului obiectiv"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ясно и понятно: определите, над чем нужно работать дальше."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorený a priamy. Jasne definuje, na čo sa zameriať v ďalšom"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljubezniv in odprt. Jasno določite naslednji cilj za izboljšavo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Positiv och tydlig. Fokusera på nästa steg"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒளிமயமான மற்றும் நேர்மையான அணுகுமுறை. அடுத்ததாக மேம்படுத்த வேண்டிய விஷயத்தை தெளிவாக வரையறுக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రకాశవంతంగా మరియు సూటిగా ఉండండి. తదుపరి అభివృద్ధి కోసం ఒక అంశాన్ని స్పష్టంగా నిర్వచించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชัดเจนและตรงไปตรงมา เน้นการพัฒนาในด้านใดด้านหนึ่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık ve dürüst: Bir sonraki gelişime odaklanma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
