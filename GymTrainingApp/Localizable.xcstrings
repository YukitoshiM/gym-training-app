    "core_ui.690f0b405af4": {
      "comment": "GymTrainingApp/Features/Onboarding/InitialSetupView.swift:253\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صالة الألعاب الرياضية التي تذهب إليها أو تلك الموجودة في المنزل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccioneu el gimnàs al qual aneu o el que teniu a casa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si, cvičení, které provádíte ve svém gymu nebo doma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg det fitnesscenter eller udstyr, du bruger."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitnessstudio oder zu Hause auswählen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε το γυμναστήριο που επισκέπτεστε ή τα αντικείμενα που έχετε στο σπίτι σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select from the gym you attend or items at home."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Select from the gym you attend or items at home."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select from the gym you attend or items at home."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Select from the gym you attend or items at home."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el gimnasio o equipo que utilizas en casa."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el gimnasio o equipo que utilizas en casa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse käytössä oleva kuntosali tai kotona olevat laitteet"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionner le centre de remise en forme ou les équipements disponibles à la maison"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionner le centre de remise en forme ou les équipements disponibles à la maison"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે જીમમાં જવાય છો અથવા તમારા ઘરે જે સાધનો છે તે પસંદ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר את הסטודיו או את הציוד שיש לך בבית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी जिम या घर पर मौजूद चीजों को चुनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite teretanu ili opremu kod kuće"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon a használt edzőteremből vagy otthoni felszerelésből"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gym atau peralatan yang Anda miliki di rumah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il centro sportivo o l'attrezzatura che hai a casa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通っているジムや自宅にあるものを選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동하는 헬스장 또는 집에서 사용하는 운동 기구를 선택"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जात असलेल्या जिम किंवा घरी असलेल्या गोष्टी निवडा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih gim atau peralatan di rumah"
          }
        },
        "nl-NL": {
