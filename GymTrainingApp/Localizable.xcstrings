    "core_ui.bf6f0ec9eac4": {
      "comment": "GymTrainingApp/Features/Onboarding/AppTutorialView.swift:109\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم ترحيل نتائج التسجيل والتنفيذ إلى تحليل الذكاء الاصطناعي التالي. سيتم توجيه العملية الأولى بالمهمة المنزلية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els resultats de l'enregistrament i l'execució es traslladaran a la següent anàlisi d'IA. La primera operació estarà guiada per la missió domèstica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky záznamu a provedení budou přeneseny do další analýzy AI. První krok vás provede úkolem na domovské obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultaterne af registreringen og udførelsen overføres til næste AI-analyse. Den første handling guider dig gennem missionerne i hovedmenuen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnungen und Ergebnisse werden an die nächste KI-Analyse weitergeleitet. Die erste Aktion wird durch die Aufgaben auf der Startseite geführt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αποτελέσματα της καταγραφής και εκτέλεσης θα μεταφερθούν στην επόμενη ανάλυση AI. Η πρώτη λειτουργία σας καθοδηγεί από την κύρια οθόνη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recorded and executed results will be passed on to the next AI analysis. The first operation will guide you through the mission on the home screen."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recorded and executed results will be passed on to the next AI analysis. The first operation will guide you through the mission on the home screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recorded and executed results will be passed on to the next AI analysis. The first operation will guide you through the mission on the home screen."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recorded and executed results will be passed on to the next AI analysis. The first operation will guide you through the mission on the home screen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de registro y ejecución se transfieren al siguiente análisis de IA. La primera acción te guiará desde la misión en la pantalla principal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de registro y ejecución se transfieren al siguiente análisis de IA. La primera acción te guiará desde la misión en la pantalla principal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjattu ja suoritettu tieto siirretään seuraavaan AI-analyysiin. Ensimmäinen toiminto ohjaa sinut aloittamaan kotinäkymästä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats de l'enregistrement et de l'exécution seront transférés à l'analyse IA suivante. La première action vous guidera via la mission principale."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats de l'enregistrement et de l'exécution seront transférés à l'analyse IA suivante. La première action vous guidera via la mission principale."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા રેકોર્ડ અને એક્ઝિક્યુશનના પરિણામો આગામી AI વિશ્લેષણમાં ટ્રાન્સફર કરવામાં આવશે. પ્રથમ ક્રિયા હોમ મિશન દ્વારા માર્ગદર્શન આપશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאות התיעוד והביצוע יועברו לניתוח ה-AI הבא. הפעולה הראשונה תנחה אותך דרך המשימה בבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड और क्रियान्वयन परिणाम अगले AI विश्लेषण में स्थानांतरित किए जाएंगे। पहला ऑपरेशन होम मिशन द्वारा मार्गदर्शन करेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultati zapisa i izvođenja će se prebaciti u sljedeću analizu AI-a. Prvi korak vas vodi kroz misije na početnom ekranu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzített és a végrehajtott eredmények átkerülnek a következő AI elemzésbe. Az első lépés a háttérben található feladatok segítenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil pencatatan dan pelaksanaan akan diteruskan ke analisis AI berikutnya. Operasi pertama akan dipandu oleh misi di beranda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati della registrazione e dell'esecuzione verranno trasferiti all'analisi AI successiva. La prima operazione ti guiderà nella missione principale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録と実行結果は次のAI分析へ引き継がれます。最初の操作はホームのミッションが案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 및 실행 결과는 다음 AI 분석으로 이어집니다. 첫 번째 작업은 홈의 미션을 안내합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची नोंद आणि कार्यवाहीचे परिणाम पुढील AI विश्लेषणात हस्तांतरित केले जातील. पहिली क्रिया होम स्क्रीनवरील 'मिशन'द्वारे मार्गदर्शन करेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil dan pelaksanaan akan dipindahkan ke analisis AI seterusnya. Tindakan pertama adalah melalui misi di bahagian utama."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De registratie en uitvoeringsresultaten worden doorgegeven aan de volgende AI-analyse. De eerste actie wordt geleid door de missie op het startscherm."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatene fra registreringen og utførelsen overføres til neste AI-analyse. Første gang vil oppgaven i hovedmenyen veilede deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki zapisów i wykonania zostaną przekazane do następnej analizy AI. Pierwsze działanie poprowadzi Cię misja na głównym ekranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados de registro e execução serão transferidos para a próxima análise da IA. A primeira ação é guiada pela missão na tela inicial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados de registro e execução serão transferidos para a próxima análise da IA. A primeira ação é guiada pela missão na tela inicial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatele înregistrării și ale execuției vor fi transferate către următoarea analiză a AI-ului. Prima acțiune vă va ghida prin misiunea de pe ecranul principal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты записи и выполнения передаются следующему анализу ИИ. Первая операция поможет вам через главную задачу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky a záznamy budú prenesené do ďalšej analýzy AI. Prvý krok vás navede domovská stránka."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultate in izvedene dejavnosti prenesete v naslednjo analizo AI. Prva operacija vas bo vodila preko misij na domači strani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet av spelandet och utförandet överförs till nästa AI-analys. Första gången guidar \"uppdrag\" i huvudmenyn."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு மற்றும் செயல்பாட்டின் முடிவுகள் அடுத்த AI பகுப்பாய்வுக்கு அனுப்பப்படும். முதல் செயல்பாடு, முகப்புப் பக்கத்தில் உள்ள பணி உங்களுக்கு வழிகாட்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డ్ మరియు అమలు ఫలితాలు తదుపరి AI విశ్లేషణకు బదిలీ అవుతాయి. మొదటి చర్య హోమ్ మిషన్ ద్వారా మార్గనిర్దేశం చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลการบันทึกและดำเนินการจะถูกส่งต่อไปยังการวิเคราะห์ AI ครั้งถัดไป การทำงานครั้งแรกจะแนะนำจากภารกิจบนหน้าหลัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen ve uygulanan sonuçlar, sonraki yapay zeka analizine aktarılır. İlk işlem, ana ekranda bulunan görevler tarafından yönlendirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результати запису та виконання передаються до наступного аналізу AI. Перша дія – місія на головному екрані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả ghi lại và thực hiện sẽ được chuyển sang phân tích AI tiếp theo. Bước đầu tiên là nhiệm vụ trên trang chủ sẽ hướng dẫn bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录和执行结果将传递到下一个AI分析。首次操作会引导您在主页的任务中进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "记录和执行结果将传递给下一个AI分析。首次操作会引导您完成主页任务。"
          }
        }
      }
    },
    "core_ui.bf6f2859521c": {
      "comment": "GymTrainingApp/Features/Onboarding/InitialSetupView.swift:726",
