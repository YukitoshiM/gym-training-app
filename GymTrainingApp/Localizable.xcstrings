          "stringUnit": {
            "state": "translated",
            "value": "Fix your elbows against your body and lift the bar by controlling the recoil."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar los codos en su lugar, controlando el impulso y levantando la barra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijar los codos en su lugar, controlando el impulso y levantando la barra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä kyynärpäät tukevasti vartalon sivulla, käytä iskuja vain nostettaessa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez vos coudes contre votre corps et soulevez la barre en contrôlant l'impulsion."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixez vos coudes contre votre corps et soulevez la barre en contrôlant l'impulsion."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને શરીરની બાજુએ જાળવી રાખો, પ્રતિક્રિયાને નિયંત્રિત કરો અને બારને ઉપર ઉઠાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למקם את הכתף בצד הגוף, לשלוט בהנפה, ולהרים את המתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी को अपने शरीर के करीब रखें, प्रतिक्रिया को नियंत्रित करें और बार को ऊपर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiksirajte ruke na strani tijela, sprječavajući potisak i podižite uteg."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixálja a karokat, és tartsa meg a bárral, minimalizálva a nyomatást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memastikan siku menempel pada tubuh, lalu mengangkat bar dengan mengontrol tenaga dorong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa i gomiti sul corpo, controllando lo smorzamento e solleva la barra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘を体側に固定し、反動を抑えてバーを持ち上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔꿈치를 몸 옆으로 고정하고, 반동을 억제하며 바를 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हात शरीराच्या बाजूला स्थिर ठेवा, स्फोट नियंत्रित करून बार वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan siku ke sisi badan, sambil mengawal tenaga pantulan untuk mengangkat bar."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je ellebogen tegen je lichaam en gebruik een kleine beweging om het gewicht omhoog te brengen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fest albuene mot kroppen og løft stangen ved hjelp av kontrollert motstand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj pozycję łokcia, ograniczając siłę odruchową, i podnieś drążek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe os cotovelos no corpo, controlando o impulso e levante a barra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe os cotovelos no corpo, controlando o impulso e levante a barra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixează antebrațul și ridică bara, controlând impulsul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепите локти в боковом положении, контролируя движение и поднимая штангу вверх."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte lakte k telu, minimalizujte odpory a zdvihnite činku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na položaj rok in zadržite odbijanje ter dvigujte ute."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst armbågen mot kroppen, kontrollera kraften och lyft stången uppåt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை மடக்கி, பார்களை மேலே தூக்க, எதிர்வினை இல்லாமல் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులను శరీరం వైపుకు ఫిక్స్ చేసి, రియాక్షన్‌ను తగ్గించి బార్‌ను పైకి ఎత్తడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาระดับข้อศอก และยกบาร์โดยควบคุมแรงกระแทก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirseklerinizi vücudunuza sabitleyerek, itme gücünü azaltın ve bara tutunarak yukarı kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріпіть руки біля тіла, контролюючи рух і піднімайте штангу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khuỷu tay cố định, kiểm soát phản lực khi nâng thanh tạ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定肘部位置，并控制反作用力抬起杠杆"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定肘部位置，並控制反作用力，抬起槓桿"
          }
        }
      }
    },
