    "health_meals_body_ai.c80ab7033a1d": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:204\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بفحص سجلات جسدي وطعامي وتدريبي لآخر 30 يومًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaig comprovar el meu cos, el meu menjar i els registres d'entrenament dels darrers 30 dies."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontroloval jsem vaše záznamy ohledně těla, stravy a tréninku za posledních 30 dní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har gennemgået dine seneste 30 dages registreringer for krop, kost og træning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe Ihre letzten 30 Tage an körperlicher Aktivität, Ernährung und Training aufgezeichnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε καταγράψει τις τελευταίες 30 ημέρες για την υγεία, τη διατροφή και την άσκηση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "I have reviewed your recent 30-day activity, diet, and training record."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "I have reviewed your recent 30-day activity, diet, and training record."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I have reviewed your recent 30-day activity, diet, and training record."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "I have reviewed your recent 30-day activity, diet, and training record."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "He revisado tus registros recientes de actividad física, alimentación y entrenamiento (últimos 30 días)."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "He revisado tus registros recientes de actividad física, alimentación y entrenamiento (últimos 30 días)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet tarkastanut viimeisten 30 päivän liikunnan, ruokailun ja harjoittelun tiedot."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai consulté vos données récentes concernant votre activité physique, votre alimentation et votre entraînement (sur les 30 derniers jours)."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai consulté vos données récentes concernant votre activité physique, votre alimentation et votre entraînement (sur les 30 derniers jours)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા 30 દિવસના શારીરિક, આહાર અને તાલીમ રેકોર્ડની ચકાસણી કરી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקתי את היסטוריית האימונים, התזונה והפעילות הגופנית שלך של 30 יום האחרונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले 30 दिनों में आपके शारीरिक गतिविधि, भोजन और व्यायाम का रिकॉर्ड देखा गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerili ste svoje fizičke aktivnosti, prehranu i trening zadnjih 30 dana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utóbbi 30 napban rögzítettem az edzésedményeid, az étrendedet és a tested állapotát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah memeriksa catatan aktivitas, makanan, dan olahraga Anda selama 30 hari terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho controllato i tuoi dati relativi a corpo, alimentazione e allenamento degli ultimi 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近30日の身体、食事、トレーニング記録を確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 30일 동안의 신체, 식단, 운동 기록을 확인했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील ३० दिवसांचे शारीरिक, आहाराचे आणि प्रशिक्षणाचे रेकॉर्ड तपासले."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah menyemak rekod aktiviti, pemakanan, dan latihan anda dalam 30 hari kebelakangan ini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb uw recente activiteiten (lichaam, voeding, training) van de afgelopen 30 dagen bekeken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har sjekket dine trenings-, kostholds- og helseopptak de siste 30 dagene."
          }
        },
        "pl": {
          "stringUnit": {
