        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez à nouveau l'écran AI pour consulter le solde actuel. Vous n'avez plus besoin de regarder la vidéo."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI સ્ક્રીન ફરીથી ખોલો, જેથી નવી સપાટી જોઈ શકાય. તમારે ફરીથી વિડિઓ જોવાની જરૂર નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לראות את היתרה העדכנית, פתחו מחדש את המסך של ה-AI. אין צורך לצפות בסרטון שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI स्क्रीन को फिर से खोलने पर नवीनतम शेष राशि देखी जा सकती है। दोबारा वीडियो देखने की आवश्यकता नहीं है।।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno otvorite AI ekran da biste provjerili najnoviji iznos. Ne trebate ponovno gledati video."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI képernyőt újraindítva ellenőrizheti a legfrissebb egyenlegét. Nem kell újra megnézni a videót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kembali layar AI untuk melihat saldo terbaru. Tidak perlu menonton video lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri la schermata AI per visualizzare il saldo aggiornato. Non è necessario guardare nuovamente il video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI画面を開き直すと最新残高を確認できます。もう一度動画を見る必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 화면을 다시 열면 최신 잔액을 확인할 수 있습니다. 동영상을 다시 보지 않아도 됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI स्क्रीन पुन्हा उघडून तुम्ही नवीनतम शिल्लक तपासू शकता. पुन्हा व्हिडिओ पाहण्याची आवश्यकता नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka semula skrin AI untuk melihat baki terkini. Anda tidak perlu menonton video sekali lagi."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de AI-scherm opnieuw om uw huidige saldo te bekijken. U hoeft de video niet nogmaals te bekijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne AI-skjermen igjen for å se den nyeste saldoen. Du trenger ikke å se videoen på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz ponownie ekran AI, aby sprawdzić aktualny stan. Nie musisz oglądać filmu ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra novamente a tela do AI para verificar o saldo mais recente. Não é necessário assistir ao vídeo novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra novamente a secção AI para verificar o saldo mais recente. Não é necessário assistir ao vídeo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeschideți ecranul AI pentru a verifica soldul actual. Nu mai este necesar să vizualizați videoclipul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы увидеть актуальный баланс, откройте экран AI. Не нужно смотреть видео повторно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte AI obrazovku, aby ste zistili aktuálnu sumu. Nepotrebujete znovu sledovať video."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite zavihek AI in preverite najnovejši izračun. Ne boste morali gledati videoposnetka ponovno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna AI-skärmen igen för att se den senaste balansen. Du behöver inte titta på videon igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI திரையை மீண்டும் திறப்பதன் மூலம், சமீபத்திய நிலையை சரிபார்க்கலாம். மீண்டும் வீடியோ பார்க்க வேண்டியதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI స్క్రీన్‌ను తెరిస్తే, తాజా బ్యాలెన్స్‌ను చూడవచ్చు. మళ్లీ వీడియో చూడవలసిన అవసరం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอป AI ใหม่เพื่อดูยอดคงเหลือล่าสุด ไม่จำเป็นต้องดูวิดีโออีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ekranını açtığınızda en güncel bakiyenizi görebilirsiniz. Videoyu tekrar izlemenize gerek yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте розділ AI, щоб побачити актуальний баланс. Не потрібно дивитися відео повторно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại ứng dụng để kiểm tra số dư mới nhất. Không cần phải xem lại video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开AI界面即可查看最新余额。无需再次观看视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟 AI 畫面即可查看最新餘額。無需再次觀看影片。"
          }
        }
      }
