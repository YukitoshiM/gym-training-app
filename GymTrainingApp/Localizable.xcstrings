    "domain_catalog.05d19324262b": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:90\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اخفض كتفيك، وانفخ صدرك، وارفع جسمك عن طريق سحب مرفقيك نحو جانبيك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixeu les espatlles, infla el pit i aixequeu el cos estirant els colzes cap als costats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sklopte ramena a vytáhněte hrudník, abyste zvedli tělo s vědomím, že lokty jsou u těla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft kroppen ved at sænke skuldrene og åbne brystet, mens du trækker albuerne mod kroppen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Senke deine Schultern und hebe deinen Oberkörper mit der Bewegung deiner Ellbogen an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαμηλώστε τους ώμους σας και ανοίξτε το στήθος, χρησιμοποιώντας την αντίληψη για να σηκώσετε το σώμα σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your shoulders, open your chest, and lift your body by bringing your elbows towards your sides."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your shoulders, open your chest, and lift your body by bringing your elbows towards your sides."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your shoulders, open your chest, and lift your body by bringing your elbows towards your sides."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your shoulders, open your chest, and lift your body by bringing your elbows towards your sides."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar los hombros y abrir el pecho, levantando el cuerpo con la conciencia de llevar los codos hacia el costado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar los hombros y abrir el pecho, levantando el cuerpo con la conciencia de llevar los codos hacia el costado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta vartaloa pitämällä olkapalat alhaalla ja vetämällä käsi vartalon sivulle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaissez vos épaules, ouvrez votre poitrine et soulevez votre corps en tirant vos coudes vers l'intérieur."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaissez vos épaules, ouvrez votre poitrine et soulevez votre corps en tirant vos coudes vers l'intérieur."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખભાને નીચે રાખીને છાતીને પહોળી કરો અને હાથને શરીરની બાજુએ ખેંચવાની દિશામાં શરીરને ઉપર લાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להוריד את הכתפיים ולמתוח את החזה, תוך שימוש בתנועה של הכתף כדי להרים את הגוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने कंधों को नीचे करें और अपने सीने को फैलाएं, अपनी कोहनी को अपने शरीर के करीब खींचने की भावना के साथ अपने शरीर को ऊपर उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustite ramena i otprite prsnice, podižući se uz pomoć svijesti o tome da ste ruku držali na strani tijela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza a vállakat a mell felé, és emelje a testet a karok segítségével."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menurunkan bahu dan membuka dada, lalu mengangkat tubuh dengan menyadari posisi siku yang berada di sisi tubuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa le spalle e apri il petto, sollevando il corpo con la consapevolezza di tirare i gomiti verso il lato del corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩を下げて胸を張り、肘を体側へ引く意識で体を持ち上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어깨를 낮추고 가슴을 활짝 열어, 팔꿈치를 몸 옆으로 당기는 느낌으로 상체를 들어 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खांदे खाली ठेवून छाती उघडा, हाताने शरीराला वर उचलण्याचा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat badan dengan menekuk bahu dan menarik lengan ke sisi, dengan kesedaran untuk membuka dada."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je schouders zakken en strek je borst, en gebruik je ellebogen om jezelf omhoog te brengen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen skuldrene og åpne brystet, og løft kroppen ved å trekke albuene mot kroppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opuść ramiona i wyprostuj klatkę piersiową, podnosząc tułów, koncentrując się na utrzymaniu prawidłowej pozycji łokci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixe os ombros e eleve o peito, puxando os cotovelos para dentro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaixe os ombros e eleve o peito, puxando os cotovelos para dentro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridică-te, menținând umerii jos și trăgând antebrațele spre interior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опустите плечи и напрягите грудь, поднимая тело, удерживая локти в боковом положении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spočívajte ramená, vytvorte hrudník a zdvíhajte telo s vedomím, že lakte smerujete k telu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustite ramena in raztegnete hrbet, ter z ramo potisnite telo navzgor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sänk axlarna och sträck bröstet, lyft kroppen medvetet genom att dra armbågarna mot kroppen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோள்களைக் குறைத்து, மார்பை விரித்து, கைகளை உடலின் பக்கவாட்டில் இழுத்து உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భుజాలను కిందకు దించి ఛాతీని నిలువుగా ఉంచి, భుజాలను శరీరం వైపుకు లాగడం ద్వారా శరీరాన్ని పైకి లేపండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดระดับไหล่และยืดอก โดยให้มีสติในการดึงแขนเข้าหาตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuzlarınızı aşağı indirin ve göğsünüzü geniş tutun, dirseklerinizi vücudunuzun yan tarafına doğru çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опустіть плечі та розправте груди, піднімаючи тіло, уявляючи, що тримаєте руки біля себе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hóp vai, mở ngực và nâng cơ thể bằng cách đưa khuỷu tay về phía thân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挺胸，将肘部向身体侧面拉，以抬起身体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挺胸，並用肘部向身體側拉的方式抬起身體"
          }
        }
      }
    },
    "domain_catalog.0660b9fa7db9": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:473\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك وزنًا بكلتا يديك، وقم بتقوية جذعك، وامشي وظهرك مستقيمًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Agafeu un pes amb les dues mans, enduriu el nucli i camina amb l'esquena recta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte zátěž v obou rukách, posilujte střed těla a chodíte s rovnou zády."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en vægt i hver hånd, styrk din kerne og gå med ret rygsøjle."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Gewichte in beiden Händen und festigen Sie Ihren Rumpf, um dann mit geradem Rücken zu gehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε ένα βάρος στα χέρια σας, δυναμώνοντας τον κορμό και περπατήστε με ίσιο πλάτη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold weights in both hands and maintain a strong core while walking with an upright posture."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold weights in both hands and maintain a strong core while walking with an upright posture."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold weights in both hands and maintain a strong core while walking with an upright posture."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold weights in both hands and maintain a strong core while walking with an upright posture."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén pesas en ambas manos, fortalece el core y camina manteniendo la espalda recta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén pesas en ambas manos, fortalece el core y camina manteniendo la espalda recta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä painoja molemmissa käsissä ja vahvista keskivartaloa, jotta voit kävellä suorassa asennossa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir des poids dans chaque main, renforcer le tronc et marcher en gardant le dos droit."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir des poids dans chaque main, renforcer le tronc et marcher en gardant le dos droit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બંને હાથમાં વજન લઈને, શરીરના કેન્દ્રને મજબૂત કરીને પગથી ચાલો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזקו את הגוף על ידי החזקת משקולות ביד, והשחיזו את הגב תוך הליכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों हाथों में वजन लेकर, अपनी रीढ़ को सीधा करके चलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži utezi u obje ruke, čvrsto drži trbuh i hodaj uz ispruženu leđa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fogd a súlyt két kézzel, és erősítsd meg a gerinját, majd sétálj."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang beban di kedua tangan, kencangkan otot inti, dan berjalan sambil meluruskan punggung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni pesi in entrambe le mani, rafforza il core e cammina allungando la schiena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重りを両手に持ち、体幹を固めて背筋を伸ばして歩く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손에 무게를 들고, 코어 근육을 사용하여 허리를 곧게 펴고 걷습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन्ही हातांमध्ये वजन घेऊन, कंबर मजबूत करून आणि पाठीचा कणा सरळ ठेवून चाला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang beban di kedua tangan, teguhkan pergelangan tangan dan berjalan dengan menegangkan belakang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd gewichten in beide handen en verstevig je core om rechtop te lopen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold vekten i begge hender, styrk kjernen og gå med rett rygg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj obciążenie w obu rękach, utrzymaj stabilną postawę i idź."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure pesos nas mãos e mantenha o tronco firme, estendendo as costas enquanto caminha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure pesos nas mãos e mantenha o tronco firme, estendendo as costas enquanto caminha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține greutăți în ambele mâini, fixează-ți centrul și mergi cu spatele drept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возьмите в руки отягощения и зафиксируйте корпус, чтобы выпрямить спину и идти вперед."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte činky v oboch rukách a udržujte stabilný trup, aby ste sa mohli pohybovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite ute v obeh rokah, utrnite trupa in hodite z raztegnjenim hrbidom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll vikter i båda händerna och stabilisera kroppen för att gå med rak rygg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடையை இரண்டு கைகளில் பிடித்து, உடலை உறுதிப்படுத்தி, நேராக நடக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండు చేతుల్లో బరువును పట్టుకుని, శరీర మధ్య భాగాన్ని గట్టిగా ఉంచి, నిటారుగా నడవండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถือดัมเบลทั้งสองข้าง และเกร็งหน้าท้องเพื่อยืนและเดิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellerinde ağırlık tutarak, karın kaslarını sıkıp sırtını düzleştirerek yürü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте вагу в обох руках, утримуйте корпус і йдіть, випрямляючи спину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ tạ ở cả hai tay, giữ thân vững và đi với lưng thẳng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手握住哑铃，保持核心稳定，挺直背部行走"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手握住啞鈴，保持身體核心穩定，然後挺直背部並行走。"
          }
        }
      }
    },
