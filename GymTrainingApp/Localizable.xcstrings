    "health_meals_body_ai.9a20afa66267": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:584\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أحدث قيمة أقل من 85 ديسيبل. يرجى التحقق من المدة كذلك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor més recent és inferior a 85 dBA. Si us plau, comproveu també la durada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hodnota je nižší než 85 dBA. Zkontrolujte také dobu trvání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den seneste værdi er under 85 dBA. Tjek også varigheden af støjniveauet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert liegt unter 85 dBA. Bitte überprüfen Sie auch die Dauer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τιμή είναι κάτω από 85 dBA. Ελέγξτε επίσης τη διάρκεια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The last reading was below 85 dBA. Please also check the duration of exposure."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The last reading was below 85 dBA. Please also check the duration of exposure."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The last reading was below 85 dBA. Please also check the duration of exposure."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The last reading was below 85 dBA. Please also check the duration of exposure."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor es inferior a 85 dBA. Verifica también la duración."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor es inferior a 85 dBA. Verifica también la duración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisin arvo on alle 85 dBA. Tarkista myös kesto."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur mesurée est inférieure à 85 dBA. Veuillez également vérifier la durée de l'exposition."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur mesurée est inférieure à 85 dBA. Veuillez également vérifier la durée de l'exposition."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લું મૂલ્ય 85 dBA કરતા ઓછું છે. સમયગાળા સાથે પણ ચકાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערך הנוכחי הוא פחות מ-85 דציבלים. יש לבדוק גם את משך הזמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले मान 85 dBA से कम है। कृपया अवधि के साथ भी जांच लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadnji mjerenje je bilo ispod 85 dBA. Provjerite i trajanje izmjere."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utóbbi érték 85 dBA-nál alacsonyabb. A tartósságot is ellenőrizd."
