        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंबर स्थिर ठेवा आणि पाठीला वाकवून, कँडलला खाली ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik kabel ke bawah untuk menstabilkan pinggul dan melengkungkan belakang."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Til je heupen omhoog en trek de kabel naar beneden om je rug te ontspannen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold hoften stabil, og trekk kabelen ned for å runde ryggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj stabilną postawę, ciągnąc kabel w dół, aby wyprostować plecy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe o cabo para baixo, mantendo a pelve firme e arqueando as costas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe o cabo para baixo, mantendo a pelve firme e arqueando as costas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți cablul în jos, pentru a fixa pelvisul și a menține spatele drept."
          }
