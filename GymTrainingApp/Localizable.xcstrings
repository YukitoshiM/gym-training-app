    "health_meals_body_ai.c5c93f735c29": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:613\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد صورة واحدة أو أكثر لتحليلها. كلما زاد عدد الاتجاهات التي لديك، أصبح من الأسهل التحقق منها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccioneu una o més fotos per analitzar-les. Com més indicacions tingueu, més fàcil serà comprovar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro analýzu vyberte alespoň jednu fotografii. Čím více fotografií, tím snadnější je kontrola."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan analysere, hvis du vælger mindst ét billede. Jo flere billeder, desto nemmere er det at verificere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Auswählen mehrerer Fotos kann die Analyse durchgeführt werden. Je mehr Fotos, desto einfacher ist die Überprüfung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να αναλύσετε μία ή περισσότερες φωτογραφίες. Όσο περισσότερες φωτογραφίες, τόσο πιο εύκολη είναι η επαλήθευση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can analyze by selecting one or more photos. The more photos you select, the easier it is to verify."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You can analyze by selecting one or more photos. The more photos you select, the easier it is to verify."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can analyze by selecting one or more photos. The more photos you select, the easier it is to verify."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can analyze by selecting one or more photos. The more photos you select, the easier it is to verify."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes analizar si seleccionas una o más fotos. Cuantas más opciones tengas, será más fácil verificar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes analizar si seleccionas una o más fotos. Cuantas más opciones tengas, será más fácil verificar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos valitset yhden tai useamman kuvan, analyysi onnistuu. Mitkä tahansa kuvat helpottavat tarkastusta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En sélectionnant une ou plusieurs photos, vous pouvez effectuer l'analyse. Plus il y a d'angles, plus il est facile de vérifier."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En sélectionnant une ou plusieurs photos, vous pouvez effectuer l'analyse. Plus il y a d'angles, plus il est facile de vérifier."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક કે વધુ ફોટા પસંદ કરવાથી વિશ્લેષણ કરી શકાય છે. જેટલા વધુ ફોટા, તેટલું સરળતાથી ચકાસી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת תמונה אחת או יותר מאפשרת ניתוח. ככל שיש יותר תמונות, כך קל יותר לבדוק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक या अधिक फोटो चुनने पर विश्लेषण किया जा सकता है। जितने अधिक विकल्प होंगे, उतना ही आसान होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako odaberete jednu ili više fotografija, možete analizirati. Što više fotografija, to će biti lakše provjeriti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha több képet választ, akkor elemzést végezhetünk. Minél több kép van, annál könnyebben ellenőrizhető a helyzet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan memilih satu atau lebih foto, analisis dapat dilakukan. Semakin banyak arah yang dipilih, semakin mudah untuk diperiksa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se selezioni una o più foto, l'analisi è possibile. Più foto, più facile è la verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を1枚以上選ぶと分析できます。複数方向があるほど確認しやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 1개 이상을 선택하면 분석이 가능합니다. 여러 방향의 사진일수록 확인하기 쉽습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकापेक्षा जास्त फोटो निवडल्यास विश्लेषण करणे सोपे होते. जितके जास्त फोटो, तितकी अधिक अचूक माहिती मिळू शकेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menganalisis jika anda memilih satu atau lebih gambar. Semakin banyak gambar, semakin mudah untuk disemak."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je één of meer foto's selecteert, kan er een analyse worden uitgevoerd. Hoe meer foto's, hoe gemakkelijker het is om te controleren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan analysere ved å velge minst ett bilde. Jo flere bilder, desto lettere er det å verifisere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza możliwa po wybraniu jednego lub więcej zdjęć. Im więcej zdjęć, tym łatwiejsza weryfikacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao selecionar uma ou mais fotos, é possível realizar a análise. Quanto mais fotos, mais fácil será confirmar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao selecionar uma ou mais fotos, é possível realizar a análise. Quanto mais fotos, mais fácil será confirmar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți analiza dacă selectezi una sau mai multe fotografii. Cu cât ai mai multe fotografii, cu atât este mai ușor de verificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для анализа необходимо выбрать хотя бы одну фотографию. Чем больше фотографий, тем проще будет проверить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak vyberiete viacero fotografií, analýza je jednoduchšia. Čím viac fotografií, tým presnejšie výsledky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če izberete vsaj eno fotografijo, lahko analizirate. Več slik omogoča lažjo preverjanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan analysera när du väljer ett eller flera bilder. Ju fler bilder, desto lättare blir det att kontrollera."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு புகைப்படத்தைத் தேர்ந்தெடுப்பதன் மூலம் பகுப்பாய்வு செய்யலாம். அதிகமான புகைப்படங்களைத் தேர்ந்தெடுப்பது, தகவலைச் சரிபார்ப்பதை எளிதாக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ఫోటోను ఎంచుకోవడం ద్వారా విశ్లేషణ చేయవచ్చు. ఎక్కువ ఫోటోలను ఎంచుకోవడం వలన మరింత సులభంగా ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเลือกรูปภาพอย่างน้อย 1 รูป สามารถวิเคราะห์ได้ การเลือกหลายรูปช่วยให้ตรวจสอบได้ง่ายขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç fotoğraf seçtiğinizde analiz edilebilir. Ne kadar çok fotoğraf seçerseniz, kontrol etmek o kadar kolay olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо вибрати одну або кілька фотографій, аналіз буде доступний. Чим більше фотографій, тим легше перевірити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể phân tích khi chọn ít nhất một ảnh. Càng nhiều ảnh, bạn càng dễ dàng xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张或多张照片即可进行分析。 更多方向可以更容易确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一张或多张照片即可进行分析。 更多方向可以更容易确认。"
          }
        }
      }
    },
