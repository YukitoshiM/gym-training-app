    "domain_catalog.6c25cd154d21": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:356\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "باستخدام ركبتيك كنقطة ارتكاز، قم بجلب كعبيك نحو الوركين وقبض أوتار الركبة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitzant els genolls com a punt de suport, porta els talons cap als malucs i contrau els isquiotibials."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte kolena jako oporu, zvedněte patu směrem k kyčli a stáhněte hamstringy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug knæene som et anker til at bringe hælen tættere på hoften og træk hamstrings sammen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzen Sie das Knie als Stütze, um den Fuß zum Gesäß zu bewegen und die Oberschenkelrückseite anzuspannen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τα γόνατα ως σημείο ισορροπίας για να φέρετε τους αστραγάλους σας προς την περιοχή των γοφών και συστέλλετε τους μύς του οπίσθιου μηρού."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Using your knees as a pivot point, bring your heels closer to your hips and contract your hamstrings."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Using your knees as a pivot point, bring your heels closer to your hips and contract your hamstrings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using your knees as a pivot point, bring your heels closer to your hips and contract your hamstrings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Using your knees as a pivot point, bring your heels closer to your hips and contract your hamstrings."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar el talón a la pelvis utilizando las rodillas como punto de apoyo y contrayendo los isquiotibiales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar el talón a la pelvis utilizando las rodillas como punto de apoyo y contrayendo los isquiotibiales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä polvet tukipisteinä ja nosta kantapäitä kohti pakaroita, jolloin reisilihakset supistuvat."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les genoux comme point d'appui pour rapprocher le talon des fesses et contracter les ischio-jambiers."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser les genoux comme point d'appui pour rapprocher le talon des fesses et contracter les ischio-jambiers."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ઘૂંટણને આધાર તરીકે ઉપયોગ કરીને, પગને હિપ્સ તરફ લઈ જાઓ અને તમારી હેમસ્ટ્રિંગ્સને સંકોચાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמקדות בברך, הרמת החלק האחורי של הגוף וקשירת שרירי העכוז."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने घुटनों को सहारा के रूप में उपयोग करके एड़ी को श्रोणि की ओर ले जाएं, और अपनी जांघों की मांसपेशियों को संकुचित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite koljena kao točku oslonca i podignite pete prema zdjelji, napinajući hamstringove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a térdet mint alapként, hogy emelje fel a sarat a csípő irányába, és húzza össze a felső lábszárát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan lutut sebagai titik tumpu untuk mendekatkan tumit ke arah panggul, lalu mengencangkan hamstring."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzando le ginocchia come punto di appoggio, avvicinare il tallone alla pelvi e contraere i muscoli posteriori della coscia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝を支点にして踵を臀部へ近づけ、ハムストリングスを収縮させる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎을 지점으로 삼아 발뒤꿈치를 엉덩이 쪽으로 당기고, 대퇴사두근을 수축시킨다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गुडघे आधार म्हणून वापरून, पायाच्या मागील भागाला (Calf) जवळ आणा आणि Hamstring स्नायूंना ताणून घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan lutut sebagai tumpuan untuk mendekatkan tumit ke arah pinggul, serta mengencangkan otot hamstring."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je knieën als basis om je hielen naar je heupen te brengen en span je hamstrings aan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk knærne som et støttepunkt for å løfte hælene mot hoftene, og klem hamstrings."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj kolan jako punktu oparcia, aby unieść pięty w kierunku pośladków i napnij uda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os joelhos como apoio para levantar o calcanhar em direção aos glúteos, contraindo os isquiotibiais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os joelhos como apoio para levantar o calcanhar em direção aos glúteos, contraindo os isquiotibiais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește genunchii ca punct de sprijin pentru a aduce călcâiul în apropierea fesierilor și contractează mușchii ischiului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используя колени как опору, приближать пятки к тазу и сокращать бицепсы бедер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite kolená ako oporu a postupne posúvajte päty smerom k zadku, čím budete stláčať svaly medzi zadnými a vnútornými stranou stehien."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite kolena kot točko, dvignite stopalo proti gluteusom in stisnite hamstring."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd knäet som stöd för att lyfta foten mot höften och dra in hamstrings."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முட்டிகளை ஆதாரமாகக் கொண்டு, குதிகாலை இடுப்பு நோக்கி நகர்த்தி, தொடை எலும்புகளை சுருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోకళ్లపై ఆధారపడి, అడుగు భాగాన్ని పిరుదు ప్రాంతానికి దగ్గర చేసి, హమ్ స్ట్రింగ్స్‌ను బిగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เข่าเป็นจุดพัก แล้วดึงส้นเท้าเข้าหาสะโพก และเกร็งกล้ามเนื้อต้นขาด้านหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayak bileğinizi destek alarak topuğunuzu kalçanıza doğru hareket ettirip hamstring kaslarını sıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуючи коліна як опору, піднести п'яти до сідниць та скоротити квадріцепси."
