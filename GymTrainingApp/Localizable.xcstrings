    "domain_catalog.58d55c32f6a5": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:30\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إعطاء الأولوية للاستمرارية على الكمال ودعم مستويات النشاط والنوم والتمرين السهل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritzar la continuïtat per sobre de la perfecció i donar suport als nivells d'activitat, el son i l'exercici sense esforç"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upřednostňujte kontinuitu před dokonalostí a podporujte aktivitu, spánek a nenáročnou fyzickou aktivitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriterer kontinuitet frem for perfektion, og støtter aktivitetsniveau, søvn og moderat træning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorisierung von Kontinuität gegenüber Perfektion, Unterstützung bei Aktivität, Schlaf und moderater Bewegung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτεραιότητα στη συνέπεια έναντι της τελειότητας, υποστήριξη για την δραστηριότητα, τον ύπνο και τις ελαφρές ασκήσεις"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize consistency over perfection, supporting activity levels, sleep, and sustainable exercise."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize consistency over perfection, supporting activity levels, sleep, and sustainable exercise."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize consistency over perfection, supporting activity levels, sleep, and sustainable exercise."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize consistency over perfection, supporting activity levels, sleep, and sustainable exercise."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizar la continuidad sobre la perfección, apoyando la actividad física, el sueño y el ejercicio moderado"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizar la continuidad sobre la perfección, apoyando la actividad física, el sueño y el ejercicio moderado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriteettina jatkuvuus, tukee aktiivisuutta, unta ja kohtuullista liikuntaa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégier la continuité plutôt que la perfection, et soutenir l'activité physique, le sommeil et un entraînement sans effort."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégier la continuité plutôt que la perfection, et soutenir l'activité physique, le sommeil et un entraînement sans effort."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરફેક્ટતા કરતાં, પ્રવૃત્તિ, ઊંઘ અને સરળ કસરતને પ્રાધાન્ય આપો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להעדיף עקביות על מושלמות, ולתמוך בפעילות גופנית, שינה ופעילות סבירה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निरंतरता को प्राथमिकता दें, और गतिविधि, नींद और बिना किसी परेशानी के व्यायाम करने में मदद करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritet dajem dugotrajnosti umjesto savršenosti, podrška za aktivnosti, spavanje i neopterećujuće vježbe"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tartózkodásra és az aktivitáson, valamint a kényes mozgásra összpontosítva, támogatja a célokat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritaskan keberlanjutan daripada kesempurnaan, serta mendukung aktivitas, tidur, dan olahraga yang tidak berat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilegia la continuità rispetto alla perfezione, supportando l'attività fisica, il sonno e un esercizio moderato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完璧さより継続性を優先し、活動量・睡眠・無理のない運動を支援"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽보다 지속성을 우선시하고, 활동량, 수면, 무리 없는 운동을 지원"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "परिपूर्णतेपेक्षा सातत्यला प्राधान्य, तसेच शारीरिक हालचाल, झोप आणि योग्य व्यायामास मदत करणे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritaskan konsisten daripada kesempurnaan, serta menyokong aktiviti, tidur, dan senaman yang sesuai"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriteit geven aan consistentie boven perfectie, en ondersteuning bieden voor activiteit, slaap en een veilige trainingsroutine"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriterer kontinuitet fremfor perfeksjon, og støtter aktivitetsnivå, søvn og moderat trening"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorytetem jest ciągłość, a nie perfekcja, wspierając aktywność fizyczną, sen i umiarkowane ćwiczenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizando a continuidade em vez da perfeição, auxiliando na atividade física, sono e exercícios sem esforço excessivo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizando a continuidade em vez da perfeição, auxiliando na atividade física, sono e exercícios sem esforço excessivo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritizează continuitatea față de perfecțiune, susținând activitatea fizică, somnul și exercițiile moderate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приоритет – постоянство, а не совершенство, поддержка активности, сна и умеренных тренировок"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorita je trvalosť, podporuje aktívny životný štýl, spánok a nenáročné cvičenie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritizirajte vztrajnost pred popolnostjo in podprejte aktivnost, spanje ter nezahtevne treninge"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritera kontinuitet framför perfektion, och stöd aktivitet, sömn och ansträngningsfri träning"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்ச்சியான செயல்பாட்டை ஊக்குவிக்கவும், உடற்பயிற்சி, தூக்கம் மற்றும் அதிகப்படியான வேலைகளைத் தவிர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరిగ్గా కాకుండా నిలకడకు ప్రాధాన్యత ఇవ్వడం, మరియు వ్యాయామం, నిద్ర మరియు సులభమైన వ్యాయామాలకు సహాయం చేయడం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ความสำคัญกับการทำกิจกรรมอย่างต่อเนื่องมากกว่าความสมบูรณ์แบบ สนับสนุนการออกกำลังกายและการนอนหลับที่เหมาะสม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mükemmellik yerine devamlılığı önceliklendirme, aktivite, uyku ve aşırı olmayan egzersizlere destek sağlama"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пріоритет – стабільність, підтримка активності, сну та помірного навантаження"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ưu tiên sự bền bỉ hơn hoàn hảo, hỗ trợ hoạt động, giấc ngủ và tập luyện hợp lý"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先考虑持续性而非完美，支持活动量、睡眠和适度的运动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "优先考虑持续性而非完美，支持活动量、睡眠和适度的运动"
          }
        }
      }
    },
