        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Un analyste discret. Se concentrer sur un seul changement à partir des données enregistrées"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શાંત વિશ્લેષક. રેકોર્ડમાંથી ફક્ત એક જ ફેરફાર કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנליסט שקט. צמצמו שינויים בנתונים לנקודה אחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत विश्लेषक। रिकॉर्ड से एक बदलाव को सीमित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tihi analitičar. Izaberi jednu promjenu iz zapisa"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csendes elemző. A rekordokból kiválasztva egyetlen változatra koncentrál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Analis yang tenang. Memfokuskan pada satu perubahan dari catatan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analista silenzioso. Concentrati su un singolo cambiamento nei dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな分析家。記録から変更点を一つに絞る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고요한 분석가. 기록에서 변경 사항을 하나로 좁힙니다."
