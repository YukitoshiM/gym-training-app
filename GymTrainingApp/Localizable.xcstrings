    "release_delta.body_fat_estimate_reason": {
      "comment": "GymTrainingApp/Data/BodyMetricEstimateService.swift\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بناءً على نطاق مرجعي جماعي يعتمد على الطول والوزن والعمر والجنس، هذه ليست قياسات فردية لنسبة الدهون في الجسم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Basat en un rang de referència per a grups basat en alçada, pes, edat i sexe. No és una mesura individual de la proporció de greix corporal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě statistických údajů pro skupiny lidí (v závislosti na výšce, váze, věku a pohlaví), není to přesné měření tělesného tuku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på en generel referenceværdi baseret på højde, vægt, alder og køn. Ikke et individuelt målt fedtprocent."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf Durchschnittswerten für Körpergröße, Gewicht, Alter und Geschlecht. Nicht ein individueller Messwert für den Körperfettanteil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με βάση στατιστικές εκτιμήσεις που βασίζονται σε ύψος, βάρος, ηλικία και φύλο, δεν είναι ακριβείς μετρήσεις του ποσοστού λίπους."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on population-based reference ranges for height, weight, age, and gender. Not an individual body fat percentage measurement."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on population-based reference ranges for height, weight, age, and gender. Not an individual body fat percentage measurement."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on population-based reference ranges for height, weight, age and gender. Not an individual body fat percentage measurement."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on population-based reference ranges for height, weight, age, and gender. Not an individual body fat percentage measurement."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en rangos de referencia para grupos según altura, peso, edad y sexo. No son valores medidos de porcentaje de grasa corporal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Basado en rangos de referencia para grupos según altura, peso, edad y sexo. No es una medición individual de la grasa corporal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioitu alue, joka perustuu pituus-, paino- ja ikään liittyviin yleisiin arvoihin. Ei ole yksilöllinen kehon rasvaprosentin mittaus."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Basé sur une fourchette de référence pour les groupes, en fonction de la taille, du poids, de l'âge et du sexe. Ce n'est pas une mesure précise de votre pourcentage de graisse corporelle."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basé sur une fourchette indicative par sexe, âge et poids, ce n'est pas une mesure précise de la masse grasse."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઊંચાઈ, વજન અને ઉંમરના આધારે સામાન્ય શ્રેણીમાં ગણતરી કરેલ છે. આ વ્યક્તિગત શરીરનું ચામડીનું પ્રમાણ નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכה על בסיס קבוצתי המבוססת על גובה, משקל, גיל ומין. לא מדובר במדידת אחוז שומן אישית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊंचाई, वजन, आयु और लिंग के आधार पर समूह के संदर्भ में, यह व्यक्तिगत शरीर वसा प्रतिशत का माप नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na temelju skupne procjene na temelju visine, težine, dobi i spola, ovo nije izmjarena vrijednost tjela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A magasság, súly, életkor és nem alapján számított átlagos értékekre hivatkozunk, nem a személyes testsúly százalékos értéke."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan rentang referensi kelompok berdasarkan tinggi badan, berat badan, usia, dan jenis kelamin. Bukan hasil pengukuran persentase lemak tubuh secara individual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basato su un intervallo di riferimento per gruppi, in base a altezza, peso, età e sesso. Non è una misurazione individuale del tasso di grasso corporeo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身長・体重・年齢・性別による集団式の参考範囲で、個人の体脂肪率を測定した値ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키, 몸무게, 나이, 성별에 따른 집단적인 참고 범위이며, 개인의 체지방률 측정값이 아닙니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे वजन, उंची आणि वयानुसार, हे आकडे केवळ अंदाजे आहेत. तुमचे प्रत्यक्ष शरीर वसाचे प्रमाण नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berdasarkan anggaran berdasarkan tinggi, berat badan, umur dan jantina. Ini bukan anggaran kadar lemak badan individu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van een algemeen bereik gebaseerd op lengte, gewicht, leeftijd en geslacht. Dit is geen individueel metingresultaat voor lichaamsvet."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Basert på gjennomsnittlige verdier for høyde, vekt, alder og kjønn. Ikke en individuell måling av kroppsfett."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie danych dla grupy osób (w zależności od wzrostu, wagi, wieku i płci), nie jest to dokładny pomiar zawartości tłuszczu w ciele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseado em uma faixa de referência para grupos, considerando altura, peso, idade e sexo. Não é uma medição individual da taxa de gordura corporal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseado em intervalos de referência para grupos, considerando altura, peso, idade e sexo. Não é uma medição individual da taxa de gordura corporal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazat pe intervale generale pentru grupuri, în funcție de înălțime, greutate, vârstă și sex. Nu este o măsurătoare a procentului de grăsime corporală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка на основе общих диапазонов для группы людей (рост, вес, возраст, пол). Не является индивидуальным измерением жира в организме."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe referenčnej rozsahy založenej na výške, váhe, veku a pohlaví. Nie je to presná hodnota telesného tuku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi skupinskih povratnih cen glede na višino, težo, starost in spol, ni rezultat individualne meritve telesne maščobe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat på gruppreferensområde för längd, vikt, ålder och kön. Inte en individuell mätning av kroppsfett."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உயரம், எடை, வயது மற்றும் பாலினத்தின் அடிப்படையில் குழு மதிப்பீட்டின் வரம்பில் உள்ளது. இது தனிப்பட்ட உடல் கொழுப்பு சதவீத அளவீடு அல்ல."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎత్తు, బరువు, వయస్సు మరియు లింగ ఆధారంగా ఒక సాధారణ పరిధిని ఉపయోగించి, ఇది వ్యక్తిగత శరీర కొవ్వు శాతం యొక్క ఖచ్చితమైన కొలత కాదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ้างอิงจากช่วงค่าโดยประมาณตามข้อมูลส่วนสูง น้ำหนัก อายุ และเพศ ไม่ใช่ค่าที่วัดจริงสำหรับอัตราไขมันในร่างกาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boy, kilo, yaş ve cinsiyet gibi toplu değerlere göre bir referans aralığıdır. Kişinin vücut yağ oranı ölçümü değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі загальних орієнтовних значень для групи людей (залежно від зросту, ваги, віку та статі), це не є виміром індивідуальної жирової маси."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựa trên phạm vi tham khảo theo nhóm dựa trên chiều cao, cân nặng, tuổi và giới tính. Không phải là giá trị đo thực tế tỷ lệ mỡ cơ thể."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于身高、体重、年龄和性别等群体参考范围，而非个人体脂率测量值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於身高、體重、年齡和性別的群體參考範圍，而非個人體脂率測量值。"
          }
        }
      }
    },
