          "stringUnit": {
            "state": "translated",
            "value": "केवल वजन के आधार पर बदलाव का निर्धारण नहीं करते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne odlučujte o promjenama samo prema težini."
