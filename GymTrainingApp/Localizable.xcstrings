    "core_ui.4330553de90e": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:570",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم مفتاح API فقط للحصول على رموز قصيرة الأجل، ولا يُرسل مع طلبات الذكاء الاصطناعي العادية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La clau de l'API només s'utilitza per obtenir tokens de curta durada i no s'envia amb les sol·licituds d'IA habituals."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč API se používá pouze k získání krátkodobých tokenů a neodesílá se s běžnými požadavky AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøglen bruges kun til at hente kortlivede tokens og sendes ikke med normale AI-anmodninger."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel wird nur zum Abrufen kurzlebiger Token verwendet und nicht mit normalen KI-Anfragen gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλειδί API χρησιμοποιείται μόνο για την απόκτηση βραχύβιων διακριτικών και δεν αποστέλλεται με τα συνηθισμένα αιτήματα AI."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is used only to obtain short-lived tokens and is not sent with normal AI requests."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is used only to obtain short-lived tokens and is not sent with normal AI requests."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is used only to obtain short-lived tokens and is not sent with normal AI requests."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is used only to obtain short-lived tokens and is not sent with normal AI requests."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de API solo se usa para obtener tokens temporales y no se envía con las solicitudes normales de IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de API solo se usa para obtener tokens temporales y no se envía con las solicitudes normales de IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "API-avainta käytetään vain lyhytkestoisten tunnisteiden hankkimiseen, eikä sitä lähetetä tavallisten tekoälypyyntöjen mukana."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API sert uniquement à obtenir des jetons temporaires et n'est pas envoyée lors des requêtes IA normales."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API sert uniquement à obtenir des jetons temporaires et n'est pas envoyée lors des requêtes IA normales."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "API કી ફક્ત ટૂંકા સમયના ટોકન મેળવવા માટે વપરાય છે અને સામાન્ય AI વિનંતીઓ સાથે મોકલાતી નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח ה-API משמש רק לקבלת אסימונים קצרי-טווח ואינו נשלח בבקשות AI רגילות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API कुंजी केवल कम अवधि वाले टोकन लेने के लिए उपयोग होती है और सामान्य AI अनुरोधों के साथ नहीं भेजी जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "API ključ koristi se samo za dobivanje kratkotrajnih tokena i ne šalje se s uobičajenim AI zahtjevima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az API-kulcs csak rövid élettartamú tokenek lekérésére szolgál, és nem kerül elküldésre a szokásos MI-kérésekkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API hanya digunakan untuk memperoleh token berumur pendek dan tidak dikirim bersama permintaan AI biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave API viene usata solo per ottenere token temporanei e non viene inviata con le normali richieste IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーは短期トークンの取得だけに使い、通常のAI通信には送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 단기 토큰을 받는 데만 사용되며 일반 AI 요청에는 전송되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "API की फक्त अल्पकालीन टोकन मिळवण्यासाठी वापरली जाते आणि सामान्य AI विनंत्यांसोबत पाठवली जात नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API hanya digunakan untuk mendapatkan token jangka pendek dan tidak dihantar bersama permintaan AI biasa."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De API-sleutel wordt alleen gebruikt voor tijdelijke tokens en wordt niet meegestuurd met normale AI-verzoeken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøkkelen brukes bare til å hente kortvarige tokener og sendes ikke med vanlige AI-forespørsler."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz API służy wyłącznie do uzyskiwania krótkotrwałych tokenów i nie jest wysyłany ze zwykłymi żądaniami AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API é usada apenas para obter tokens temporários e não é enviada em solicitações normais de IA."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API é usada apenas para obter tokens temporários e não é enviada em solicitações normais de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia API este folosită doar pentru obținerea tokenurilor temporare și nu este trimisă cu solicitările AI obișnuite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API используется только для получения краткосрочных токенов и не отправляется с обычными запросами ИИ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľúč API sa používa iba na získanie krátkodobých tokenov a neodosiela sa s bežnými požiadavkami AI."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ključ API se uporablja samo za pridobitev kratkotrajnih žetonov in se ne pošilja z običajnimi zahtevami UI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nyckeln används endast för att hämta kortlivade token och skickas inte med vanliga AI-förfrågningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "API விசை குறுகிய கால டோக்கன்களைப் பெற மட்டுமே பயன்படுத்தப்படுகிறது; வழக்கமான AI கோரிக்கைகளுடன் அனுப்பப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "API కీ తక్కువ కాలం ఉండే టోకెన్లు పొందడానికి మాత్రమే ఉపయోగించబడుతుంది; సాధారణ AI అభ్యర్థనలతో పంపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ API ใช้เพื่อรับโทเค็นอายุสั้นเท่านั้น และจะไม่ถูกส่งไปกับคำขอ AI ตามปกติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı yalnızca kısa süreli belirteçler almak için kullanılır ve normal AI istekleriyle gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API використовується лише для отримання короткострокових токенів і не надсилається зі звичайними запитами ШІ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa API chỉ được dùng để lấy mã thông báo ngắn hạn và không được gửi trong các yêu cầu AI thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API密钥仅用于获取短期令牌，不会随普通AI请求发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API金鑰僅用於取得短期權杖，不會隨一般AI要求傳送。"
          }
        }
      }
    },
