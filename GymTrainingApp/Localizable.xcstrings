    "domain_catalog.07083bafb071": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:302\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اخفض وركيك إلى أقصى حد ممكن دون رفعهما، واضغط دون تمديد ركبتيك بالكامل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixeu els malucs tant com pugueu sense aixecar-los i premeu sense estirar els genolls completament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte si nohy do hloubky v rozsahu, ve kterém se nebudou ohýbat, a zároveň stiskněte kolena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løft hofterne så langt ned som muligt, uden at overstrække knæene, og tryk med benene."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hüfte in einem sicheren Bereich tief nach unten absenken und die Knie nicht vollständig ausfahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε τις κινήσεις ώστε να μην υπάρξει κίνηση στην κοιλιά, χαμηλώστε το σώμα σας βαθιά και πιέστε με τα γόνατά σας χωρίς να τα τεντώσετε πλήρως."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower deeply, keeping your lower back from arching and preventing your knees from locking out."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower deeply, keeping your lower back from arching and preventing your knees from locking out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower deeply, keeping your lower back from arching and preventing your knees from locking out."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower deeply, keeping your lower back from arching and preventing your knees from locking out."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar profundamente manteniendo la espalda recta, sin estirar las rodillas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar profundamente manteniendo la espalda recta, sin estirar las rodillas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vie selkä alas niin syvälle, että se ei purista polvia, ja pidä polvet koukussa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Descendre profondément dans une position confortable, sans forcer les genoux, et pousser."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descendre profondément dans une position confortable, sans forcer les genoux, et pousser."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માથાને એવી રીતે નીચે લાવો કે જેથી તમારું પેટ ઉપર રહે, અને ઘૂંટણને સંપૂર્ણપણે સીધું ન કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנח את הגב בעומק, תוך שמירה על יציבות, והרחיק את הברכיים מעט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमरे को इतना नीचे लाएं कि वह स्थिर रहे, और घुटनों को पूरी तरह से न मोड़े।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustite tijelo duboko, uzdržavajući ga da ne klize, i istegnite koljena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gerincet a lehető legmélyebb mértékben, de úgy, hogy a térde ne nyúljon teljesen ki, és emeljen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melakukan gerakan ini pada rentang yang aman agar tidak mengangkat pinggang, dan mendorong lutut tanpa meluruskan sepenuhnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevare la schiena in modo da non affletterla, mantenendo le ginocchia distese e spingendo delicatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰が浮かない範囲で深く下ろし、膝を伸ばし切らずに押す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리가 뜨지 않도록 깊게 내리고, 무릎을 완전히 펴지 않고 누른다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोटाला जास्त ताण येऊ नये यासाठी, हळूवारपणे खाली वाका आणि गुडघे पूर्णपणे सरळ करू नका."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menurunkan badan secara perlahan dalam julat yang tidak menyebabkan sakit belakang, sambil meregangkan lutut sepenuhnya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig diep en houd je rug recht, zonder je knieën volledig te strekken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk kroppen forsiktig ned, uten å strekke ut knærne fullstendig, og press."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opuść ciało głęboko, w zakresie, w którym nie odczuwasz dyskomfortu, jednocześnie rozciągając nogi i delikatnie je dociskając."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve o abdômen para baixo, mantendo as pernas esticadas e sem dobrar os joelhos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Leve o abdômen para baixo, mantendo as pernas esticadas e sem dobrar os joelhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coborâți încet, menținând o poziție sigură pentru spate, și întindeți genunchii fără a forța articulația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опускать тело в пределах, при которых не будет напрягаться поясница, и одновременно выпрямлять ноги, не доходя до полного выпрямления."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponáhňte si, aby ste sa udržali v bezpečnej polohe a hlboko sa ohnite, pričom neprekračujte hranicu, pri ktorej sa vaše kolená natiahnu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustite se globoko, tako da ne prekomplicirate z hrbtom in raztegnite kolena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sänk kroppen försiktigt, utan att översträck knäna, och tryck med benen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வலியைத் தவிர்க்கும் வகையில், முதுகை ஆழமாக மடக்கி, முட்டிகளை முழுமையாக நீட்டாமல் அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నుపూసను సురక్షితంగా ఉంచేలా, కాలును పూర్తిగా చాచి, మోకాళ్లను వంచి, ముందుకు నెట్టండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงหลังให้ลึกในระดับที่เอวไม่เสียรูป และดันเข่าให้เหยียดเต็มที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belinizi, yere değmeden ve dizlerinizi tamamen uzatmadan aşağı indirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опускати таз у межах, щоб він не піднімався, і відтягувати коліна, не розтягуючи їх повністю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạ người xuống sâu trong phạm vi không làm đau lưng, đồng thời giữ cho đầu gối không bị duỗi thẳng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在可控范围内深蹲，不要完全伸展膝盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不讓腰部抬起的情況下，將身體向前彎曲，並確保膝蓋沒有完全伸直。"
          }
        }
      }
    },
