        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilo, karın çevresi, fotoğraf ve kas gücü gibi faktörleri bir araya getirerek vücut şeklinizdeki değişimi değerlendirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінюйте зміни у фігурі, враховуючи вагу, обхват та фотографії, а також силу м'язів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá sự thay đổi vóc dáng dựa trên cân nặng, vòng bụng, ảnh và sức mạnh cơ bắp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "综合考虑体重、腹围和力量，评估体型变化"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不僅僅根據體重，還結合腹圍、照片和肌肉力量來評估身體變化"
          }
        }
      }
    },
