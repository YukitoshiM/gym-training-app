          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ એક એવી યાદી છે જે સમાંતરે બદલાયેલા પરિમાણોને સૂચવે છે, પરંતુ તે કારણ અથવા તબીબી સ્થિતિને નિશ્ચિત કરતું નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערך מציג את הפריטים שהשתנו בו זמנית כחשודים, אך אינו קובע סיבה או מצב רפואי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उन मापदंडों को दर्शाता है जो एक साथ बदले हैं, लेकिन यह कारण या चिकित्सा स्थिति को निश्चित नहीं करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo pokazuje potencijalne varijable koje su se promijenile, ali ne zaključuje uzrok ili medicinsku stanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez egy olyan lista, amely feltünteti azokat az értékeket, amelyek megváltoztak, de nem állapít meg okot vagy orvosi állapotot."
