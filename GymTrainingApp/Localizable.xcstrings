          "stringUnit": {
            "state": "translated",
            "value": "Health permission denied, only app history is saved."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Health permission denied, only app history is saved."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Health permission denied, only app history is saved."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Health no autorizado, solo se guarda el historial de la aplicación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Health no autorizado, solo se guarda el historial de la aplicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terveystiedot eivät ole hyväksyttyjä, vain sovellushistoria on tallennettu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Health non autorisé, seul l'historique des applications est sauvegardé."
