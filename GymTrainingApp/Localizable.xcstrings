    "domain_catalog.8f59183868a6": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:220\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دافئة وصريحة. انظر إلى الأرقام والمظاهر خلال نفس الفترة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Càlid i franc. Mireu els números i les aparicions durant el mateix període"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte upřímné a jasné formulace, které porovnávají čísla a vzhled v daném období."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm og ærlig. Sammenlign tal og udseende over samme periode"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Warmherzig und ehrlich. Vergleichen Sie Zahlen und Aussehen über einen bestimmten Zeitraum"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φιλικό και ειλικρινές. Παρακολούθηση αριθμών και εμφάνισης στην ίδια περίοδο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and direct language, comparing numbers and appearance over the same period."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and direct language, comparing numbers and appearance over the same period."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and direct language, comparing numbers and appearance over the same period."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and direct language, comparing numbers and appearance over the same period."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé amable y directo. Compara tus números y apariencia en el mismo período."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé amable y directo. Compara tus números y apariencia en el mismo período."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämpimä ja suora. Vertaa lukuja ja ulkonäköä samalla aikavälillä"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaleureux et direct : comparez les chiffres et l'apparence sur la même période."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaleureux et direct : comparez les chiffres et l'apparence sur la même période."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગરમ અને સીધા. સમાન સમયગાળામાં આંકડા અને દેખાવને જુઓ"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילים חמות וכנות, שמראות את התוצאות והמראה באותו פרק זמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गरम और सीधा, एक ही समय में संख्या और दिखावट को देखें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topli i iskreni. Smatrati brojeve i izgled u isto vrijeme"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyugodtabb és közvetlenebb: ugyanazon időtartamban figyeljük a számokat és a megjelenést"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kata-kata yang hangat dan jujur, melihat angka dan penampilan dalam periode yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii onesto e diretto: confronta numeri e aspetto fisico nello stesso periodo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かく率直。数字と見た目を同じ期間で見る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻하고 솔직하게, 숫자와 외모를 같은 기간에 비교"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समजूतदार आणि स्पष्ट, एकाच वेळी आकडेवारी आणि दिसण्यावर लक्ष केंद्रित करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopan dan jujur. Lihat angka dan penampilan dalam tempoh yang sama"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalm en eerlijk. Vergelijk cijfers en uiterlijk in dezelfde periode"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Varme og ærlige. Sammenlign tall og utseende over samme tidsperiode"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz słowa, które są szczere i porównuj liczby oraz wygląd w tym samym okresie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha palavras que sejam calorosas e diretas, comparando números e aparência no mesmo período."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha palavras que sejam calorosas e diretas, comparando números e aparência no mesmo período."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fii sincer și compară rezultatele și aspectul fizic în același interval de timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте и будьте честны. Смотрите цифры и внешний вид одновременно в течение определенного периода времени."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné a úprimné. Porovnajte čísla a vzhľad v rovnakom období."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplo in iskreno. Primerjajte številke in izgled v istem obdobju"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugn och ärlig. Jämför siffror och utseende under samma period"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதியான மற்றும் நேர்மையான அணுகுமுறை. ஒரே நேரத்தில் எண்களையும், தோற்றத்தையும் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రశాంతంగా మరియు నిజాయితీగా ఉండండి. ఒకే సమయంలో సంఖ్యలను మరియు రూపాన్ని చూడండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคำพูดที่จริงใจ และเปรียบเทียบตัวเลขและรูปร่างในช่วงเวลาเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samimi ve açık olun. Sayıları ve görünümü aynı dönemde karşılaştırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виражайте свої думки відкрито та чесно, порівнюючи цифри та зовнішній вигляд протягом одного періоду часу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thân thiện và thẳng thắn. So sánh số liệu và hình ảnh trong cùng một khoảng thời gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温和而坦率，在相同时间内观察数字和外观"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫和而直接，在相同期間觀察數字和外觀"
          }
        }
      }
    },
