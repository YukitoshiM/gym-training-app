        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng AI đã bị tắt trong cài đặt. Bạn có thể lưu bộ ảnh này như hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
