    "training.ecbede3ec48a": {
      "comment": "GymTrainingApp/Features/Plans/PlanEditorView.swift:161\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم نسخ الأهداف المحددة في بداية التمرين وتظل في السجل الخاص بك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els objectius establerts es copien al començament d'un entrenament i romanen al vostre historial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cíle sady se kopírují při zahájení cvičení a jsou uloženy v historii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sættets mål kopieres ved træningsstart og gemmes i historikken."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ziele für den Satz werden beim Start des Trainings kopiert und in der Historie gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στόχος του σετ αντιγράφεται κατά την έναρξη της προπόνησης και καταγράφεται στο ιστορικό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The set goal is copied at the start of each workout and saved in your history."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The set goal is copied at the start of each workout and saved in your history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The set goal is copied at the start of each workout and saved in your history."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The set goal is copied at the start of each workout and saved in your history."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La meta de la serie se copia al inicio del entrenamiento y se guarda en el historial."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La meta de la serie se copia al inicio del entrenamiento y se guarda en el historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarjan tavoite kopioidaan harjoittelun alussa ja tallennetaan historian."
