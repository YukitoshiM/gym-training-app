    "domain_catalog.01cf3683ebe8": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:530\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ركز على الكتفين والظهر وأعلى الصدر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Centra't en les espatlles, l'esquena i la part superior del pit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaměřte se na správné držení ramen, zad a horní části hrudníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fokus på skulder, ryg og øvre del af brystet"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzentriere dich auf die Ausrichtung von Schulter, Rücken und Brustbereich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εργαστείτε γύρω από τους ώμους, την πλάτη και την άνω περιοχή του θώρακα"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus on aligning your shoulders, upper back, and chest."
          }
