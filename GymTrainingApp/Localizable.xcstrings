          "stringUnit": {
            "state": "translated",
            "value": "Bijvoorbeeld: Verminder het aantal oefeningen en verleng de pauzes"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksempel: Reduser antall øvelser for å ta en lengre pause"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Np. zmniejsz liczbę ćwiczeń i wydłuż przerwę"
          }
        },
        "pt-BR": {
