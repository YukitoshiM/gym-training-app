    "core_ui.693f2367c5a9": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:345",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تتوفر المستشعرات، فلا يزال بإمكانك إدخال الوزن والتكرارات وRPE يدويًا. يقلّل أخذ العينات الموفر للطاقة من تكرار تحديث تقديرات الحركة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si els sensors no estan disponibles, encara pots introduir manualment el pes, les repeticions i l'RPE. El mostreig de baix consum redueix la freqüència d'actualització de les estimacions de moviment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud senzory nejsou dostupné, můžete stále ručně zadat hmotnost, opakování a RPE. Úsporné vzorkování snižuje četnost aktualizace odhadů pohybu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis sensorerne ikke er tilgængelige, kan du stadig indtaste vægt, gentagelser og RPE manuelt. Strømbesparende sampling reducerer, hvor ofte bevægelsesestimater opdateres."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sensoren nicht verfügbar sind, kannst du Gewicht, Wiederholungen und RPE weiterhin manuell eingeben. Energiesparendes Sampling verringert die Aktualisierungsrate der Bewegungsschätzung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν οι αισθητήρες δεν είναι διαθέσιμοι, μπορείς να εισαγάγεις χειροκίνητα βάρος, επαναλήψεις και RPE. Η δειγματοληψία χαμηλής κατανάλωσης μειώνει τη συχνότητα ενημέρωσης των εκτιμήσεων κίνησης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If sensors are unavailable, you can still enter weight, reps, and RPE manually. Low-power sampling reduces how often motion estimates update."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If sensors are unavailable, you can still enter weight, reps, and RPE manually. Low-power sampling reduces how often motion estimates update."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If sensors are unavailable, you can still enter weight, reps, and RPE manually. Low-power sampling reduces how often motion estimates update."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "If sensors are unavailable, you can still enter weight, reps, and RPE manually. Low-power sampling reduces how often motion estimates update."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los sensores no están disponibles, aún puedes introducir manualmente el peso, las repeticiones y el RPE. El muestreo de bajo consumo reduce la frecuencia de actualización de las estimaciones de movimiento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los sensores no están disponibles, aún puedes ingresar manualmente el peso, las repeticiones y el RPE. El muestreo de bajo consumo reduce la frecuencia de actualización de las estimaciones de movimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sensoreita ei voi käyttää, voit silti syöttää painon, toistot ja RPE:n käsin. Virransäästötila harventaa liikearvioiden päivityksiä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les capteurs sont indisponibles, vous pouvez toujours saisir manuellement le poids, les répétitions et le RPE. L'échantillonnage basse consommation réduit la fréquence de mise à jour des estimations de mouvement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les capteurs sont indisponibles, vous pouvez toujours saisir manuellement le poids, les répétitions et le RPE. L'échantillonnage basse consommation réduit la fréquence de mise à jour des estimations de mouvement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેન્સર ઉપલબ્ધ ન હોય તો પણ તમે વજન, રેપ્સ અને RPE મેન્યુઅલી દાખલ કરી શકો છો. લો-પાવર સેમ્પલિંગ મૂવમેન્ટ અંદાજના અપડેટની આવર્તન ઘટાડે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם החיישנים אינם זמינים, עדיין אפשר להזין משקל, חזרות ו-RPE ידנית. דגימה חסכונית בחשמל מפחיתה את תדירות עדכון הערכות התנועה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेंसर उपलब्ध न होने पर भी आप वज़न, रेप्स और RPE मैन्युअल रूप से दर्ज कर सकते हैं। कम ऊर्जा वाली सैंपलिंग मूवमेंट अनुमान की अपडेट दर घटाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako senzori nisu dostupni, težinu, ponavljanja i RPE i dalje možete unijeti ručno. Uzorkovanje s malom potrošnjom smanjuje učestalost ažuriranja procjene pokreta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az érzékelők nem érhetők el, a súly, az ismétlések és az RPE kézzel is megadhatók. Az energiatakarékos mintavételezés ritkábban frissíti a mozgásbecslést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika sensor tidak tersedia, Anda tetap dapat memasukkan berat, repetisi, dan RPE secara manual. Pengambilan sampel hemat daya mengurangi frekuensi pembaruan estimasi gerakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i sensori non sono disponibili, puoi comunque inserire manualmente peso, ripetizioni e RPE. Il campionamento a basso consumo riduce la frequenza di aggiornamento delle stime del movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサーが使えない場合も、重量・回数・RPEは手入力で記録できます。省電力サンプリングでは動作推定の更新頻度を下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "센서를 사용할 수 없어도 중량, 횟수, RPE를 직접 입력할 수 있습니다. 저전력 샘플링에서는 동작 추정 업데이트 빈도가 낮아집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेन्सर्स उपलब्ध नसले तरी वजन, रेप्स आणि RPE हाताने नोंदवू शकता. कमी-ऊर्जा सॅम्पलिंगमुळे हालचालींच्या अंदाजाची अपडेट वारंवारता कमी होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika sensor tidak tersedia, anda masih boleh memasukkan berat, ulangan dan RPE secara manual. Pensampelan jimat kuasa mengurangkan kekerapan anggaran pergerakan dikemas kini."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als sensoren niet beschikbaar zijn, kun je gewicht, herhalingen en RPE handmatig invoeren. Energiebesparende bemonstering verlaagt hoe vaak bewegingsschattingen worden bijgewerkt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis sensorene ikke er tilgjengelige, kan du fortsatt legge inn vekt, repetisjoner og RPE manuelt. Strømsparende sampling reduserer hvor ofte bevegelsesestimater oppdateres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli czujniki są niedostępne, nadal możesz ręcznie wprowadzać ciężar, powtórzenia i RPE. Próbkowanie energooszczędne zmniejsza częstotliwość aktualizowania szacunków ruchu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os sensores não estiverem disponíveis, você ainda poderá inserir peso, repetições e RPE manualmente. A amostragem de baixo consumo reduz a frequência de atualização das estimativas de movimento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os sensores não estiverem disponíveis, ainda pode introduzir peso, repetições e RPE manualmente. A amostragem de baixo consumo reduz a frequência de atualização das estimativas de movimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă senzorii nu sunt disponibili, poți introduce manual greutatea, repetările și RPE. Eșantionarea cu consum redus scade frecvența actualizării estimărilor de mișcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если датчики недоступны, вес, повторения и RPE можно вводить вручную. Энергосберегающая выборка снижает частоту обновления оценки движений."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak senzory nie sú dostupné, stále môžete ručne zadať hmotnosť, opakovania a RPE. Úsporné vzorkovanie znižuje frekvenciu aktualizácie odhadov pohybu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če senzorji niso na voljo, lahko težo, ponovitve in RPE še vedno vnesete ročno. Vzorčenje z nizko porabo zmanjša pogostost posodabljanja ocen gibanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om sensorer inte är tillgängliga kan du fortfarande ange vikt, repetitioner och RPE manuellt. Energisnål sampling minskar hur ofta rörelseuppskattningar uppdateras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சென்சார்கள் கிடைக்காவிட்டாலும் எடை, ரெப்ஸ் மற்றும் RPE-ஐ கைமுறையாக உள்ளிடலாம். குறைந்த மின்சார மாதிரிப்பில் அசைவு மதிப்பீடுகளின் புதுப்பிப்பு அடிக்கடி நடப்பது குறையும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెన్సర్లు అందుబాటులో లేకపోయినా బరువు, రెప్స్ మరియు RPEని చేతితో నమోదు చేయవచ్చు. తక్కువ-పవర్ శాంప్లింగ్ కదలిక అంచనాల అప్‌డేట్ తరచుదనాన్ని తగ్గిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ใช้เซ็นเซอร์ไม่ได้ คุณยังกรอกน้ำหนัก จำนวนครั้ง และ RPE ด้วยตนเองได้ การเก็บตัวอย่างแบบประหยัดพลังงานจะลดความถี่ในการอัปเดตการประเมินการเคลื่อนไหว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensörler kullanılamadığında da ağırlık, tekrar ve RPE değerlerini elle girebilirsin. Düşük güçte örnekleme, hareket tahminlerinin güncellenme sıklığını azaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо датчики недоступні, вагу, повторення та RPE можна вводити вручну. Енергоощадна вибірка знижує частоту оновлення оцінювання рухів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không dùng được cảm biến, bạn vẫn có thể nhập thủ công mức tạ, số lần lặp và RPE. Chế độ lấy mẫu tiết kiệm pin làm giảm tần suất cập nhật ước tính chuyển động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使传感器不可用，也可以手动输入重量、次数和RPE。低功耗采样会降低动作估算的更新频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使感測器無法使用，也可以手動輸入重量、次數與RPE。低功耗取樣會降低動作估算的更新頻率。"
          }
        }
      }
    },
