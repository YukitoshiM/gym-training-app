    "health_meals_body_ai.325f72991867": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:653\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام HTTP إلا داخل المضيف المحلي، وLAN، وTailscale. الرجاء استخدام HTTPS للخوادم الخارجية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP només es pot utilitzar dins de localhost, LAN i Tailscale. Utilitzeu HTTPS per a servidors externs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP je k dispozici pouze pro localhost, LAN a Tailscale. Pro externí servery používejte HTTPS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP kan kun bruges på localhost, LAN og Tailscale. Brug HTTPS til eksterne servere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP ist nur für localhost, LAN und Tailscale verfügbar. Verwenden Sie für externe Server HTTPS."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η HTTP λειτουργεί μόνο για localhost, LAN και Tailscale. Για εξωτερικούς διακομιστές, χρησιμοποιήστε HTTPS."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP can only be used on localhost, LAN, and Tailscale. Use HTTPS for external servers."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP can only be used on localhost, LAN, and Tailscale. Use HTTPS for external servers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP can only be used on localhost, LAN, and Tailscale. Use HTTPS for external servers."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP can only be used on localhost, LAN, and Tailscale. Use HTTPS for external servers."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP solo disponible para localhost, red local y Tailscale. Para servidores externos, use HTTPS."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP solo disponible para localhost, red local y Tailscale. Para servidores externos, use HTTPS."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP toimii vain localhostissa, LAN:ssa ja Tailscale-verkossa. Käytä HTTPS:ää ulkoisille palvelimille."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP ne fonctionne que sur localhost, réseau local et Tailscale. Utilisez HTTPS pour les serveurs externes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP ne fonctionne que sur localhost, réseau local et Tailscale. Utilisez HTTPS pour les serveurs externes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP ફક્ત localhost, LAN અને Tailscale માં જ વાપરી શકાય છે. બાહ્ય સર્વર માટે HTTPS નો ઉપયોગ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להשתמש רק ב-HTTP עבור localhost, רשת מקומית ו-Tailscale. יש להשתמש ב-HTTPS עבור שרתים חיצוניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP केवल localhost, LAN और Tailscale के भीतर उपयोग किया जा सकता है। बाहरी सर्वर के लिए HTTPS का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP je dostupan samo za localhost, lokalnu mrežu i Tailscale. Za vanjske servere koristite HTTPS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az HTTP csak localhost, LAN és Tailscale hálózatokon használható. Az external szerverekhez HTTPS protokollt használjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP hanya dapat digunakan pada localhost, LAN, dan Tailscale. Gunakan HTTPS untuk server eksternal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP è disponibile solo su localhost, rete LAN e Tailscale. Per i server esterni, utilizzare HTTPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPはlocalhost、LAN、Tailscale内だけ利用できます。外部サーバーにはHTTPSを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP는 localhost, LAN, Tailscale 내에서만 사용 가능합니다. 외부 서버에는 HTTPS를 사용하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP फक्त localhost, LAN आणि Tailscale मध्येच वापरले जाऊ शकते. बाह्य सर्व्हरसाठी HTTPS वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP hanya boleh digunakan pada localhost, LAN, dan Tailscale. Gunakan HTTPS untuk pelayan luaran."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP kan alleen worden gebruikt voor localhost, LAN en Tailscale. Gebruik HTTPS voor externe servers."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP kan kun brukes på localhost, LAN og Tailscale. Bruk HTTPS for eksterne servere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP działa tylko lokalnie, w sieci LAN i w Tailscale. Do połączenia z zewnętrznymi serwerami należy używać HTTPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HTTP só pode ser usado em localhost, LAN e Tailscale. Use HTTPS para servidores externos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O HTTP só pode ser usado em localhost, LAN e Tailscale. Use HTTPS para servidores externos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP poate fi utilizat doar pe localhost, rețea locală și Tailscale. Pentru servere externe, folosiți HTTPS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP доступен только для localhost, локальной сети и Tailscale. Для доступа к внешним серверам используйте HTTPS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP je možné použiť len na localhost, LAN a Tailscale. Na vonkajšie servery používajte HTTPS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP je na voljo samo za localhost, LAN in Tailscale. Za povezavo z eksternimi strežniki uporabite HTTPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP kan endast användas för localhost, LAN och Tailscale. Använd HTTPS för externa servrar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP, localhost, LAN மற்றும் Tailscale-இல் மட்டுமே பயன்படுத்த முடியும். வெளிப்புற சேவையகங்களுக்கு HTTPS பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP అనేది localhost, LAN మరియు Tailscale లో మాత్రమే ఉపయోగించబడుతుంది. బాహ్య సర్వర్ కోసం HTTPS ను ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถใช้ HTTP เฉพาะ localhost, LAN และ Tailscale เท่านั้น โปรดใช้ HTTPS สำหรับเซิร์ฟเวอร์ภายนอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP yalnızca localhost, yerel ağ ve Tailscale içinde kullanılabilir. Dış sunucular için HTTPS kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP доступний лише для localhost, локальної мережі та Tailscale. Для зовнішніх серверів використовуйте HTTPS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sử dụng localhost, mạng LAN và Tailscale. Vui lòng sử dụng HTTPS cho các máy chủ bên ngoài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在localhost、局域网和Tailscale中使用HTTP。对于外部服务器，请使用HTTPS。"
          }
