    "health_meals_body_ai.08aa1158cdcc": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:208\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ومن خلال إرسال الصور من اتجاهات متعددة في وقت واحد، يمكنك التحقق من وضعية الشخص وشكل جسمه، وهو ما لا يمكن رؤيته من المنظر الأمامي فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En enviar fotos des de diverses direccions alhora, podeu comprovar la postura i la forma del cos de la persona, que no es pot veure només des de la vista frontal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud odešlete více fotografií, můžete ověřit postoj a tvar těla, které nejsou vidět pouze z jedné strany."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved at sende flere billeder kan du få et mere komplet billede af din kropsholdning og -form, som ikke kun kan ses fra forfront."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie mehrere Fotos aus verschiedenen Perspektiven zusammen senden, können Sie so eine bessere Vorstellung von Ihrer Haltung und Ihrem Körperbau bekommen, als wenn Sie nur ein Foto machen würden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν στείλετε πολλές φωτογραφίες μαζί, μπορείτε να επιβεβαιώσετε τη στάση και το σχήμα του σώματος που δεν θα ήταν εμφανείς μόνο από την μπροστινή πλευρά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "When you send multiple photos together, you can confirm posture and body shape that cannot be understood from a single front view."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "When you send multiple photos together, you can confirm posture and body shape that cannot be understood from a single front view."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you send multiple photos together, you can confirm posture and body shape that cannot be understood from a single front view."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "When you send multiple photos together, you can confirm posture and body shape that cannot be understood from a single front view."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar varias fotos tomadas desde diferentes ángulos permite complementar y confirmar posturas y formas corporales que no se pueden ver solo desde el frente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar varias fotos tomadas desde diferentes ángulos permite complementar y confirmar posturas y formas corporales que no se pueden ver solo desde el frente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun lähetät useista eri kulmista otettuja kuvia, voit verrata asentoa ja vartalon muotoa, joita ei ole mahdollista nähdä vain yhdeltä kulmalta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En envoyant plusieurs photos prises sous différents angles, vous pouvez vérifier votre posture et votre silhouette, qui ne seraient pas visibles uniquement depuis l'avant."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En envoyant plusieurs photos prises sous différents angles, vous pouvez vérifier votre posture et votre silhouette, qui ne seraient pas visibles uniquement depuis l'avant."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય દિશાના ફોટાને એકસાથે મોકલવાથી, તમે ફક્ત આગળના ભાગમાં દેખાતી સ્થિતિ અને શરીરના પ્રકારને સુધારીને ચકાસી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כששולחים מספר תמונות בכיוונים שונים, ניתן לבדוק את המיקום והמבנה של הגוף בצורה משלימה, שלא ניתן לראות רק בתמונה מולית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप कई दिशाओं से तस्वीरें भेजते हैं, तो आप केवल सामने की ओर के कोण से पता नहीं चल सकने वाले शरीर की स्थिति और आकार को भी समझ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako pošaljite više fotografija, možete provjeriti položaj i izgled tijela koji nisu vidljivi samo s prednje strane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Többirányú képet elküldve, az egyes pozíciókat és testformákat kombináltan meg lehet vizsgálni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan mengirimkan beberapa foto sekaligus, kita dapat saling melengkapi dan memastikan postur serta bentuk tubuh yang tidak terlihat hanya dari satu sisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviare più foto da diverse angolazioni permette di confrontare la postura e la forma del corpo che altrimenti non sarebbero evidenti solo da una singola immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数方向の写真をまとめて送ると、正面だけでは分からない姿勢や体型を補い合って確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다양한 방향의 사진을 함께 보내면, 정면만으로는 알 수 없는 자세나 체형을 보완하여 확인할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विविध दिशांमधील फोटो एकत्रितपणे पाठवल्यास, केवळ समोरच्या बाजूचा फोटोमध्ये दिसणारे आणि इतर बाजूकडील माहिती मिळण्यास मदत होते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan menghantar beberapa gambar dari pelbagai sudut, kita dapat melengkapkan dan mengesahkan postur dan bentuk badan yang tidak dapat difahami hanya dengan melihat hadapan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Door meerdere foto's van verschillende hoeken te versturen, kunnen we de houding en lichaamsvorm die alleen met een voorwaartse foto niet duidelijk zijn, in combinatie bekijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved å sende flere bilder samtidig, kan du få en mer komplett forståelse av posisjonen og kroppsformen din, som kanskje ikke er tydelig fra et enkelt bilde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłając wiele zdjęć z różnych perspektyw, można sprawdzić pozycję i sylwetkę, które nie są widoczne tylko z przodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar várias fotos em diferentes ângulos permite comparar e confirmar a postura e o formato do corpo que não seriam aparentes apenas com uma foto frontal."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar várias fotos em diferentes ângulos permite comparar e confirmar a postura e o formato do corpo que não seriam aparentes apenas com uma foto frontal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimiterea mai multor fotografii împreună permite o verificare completă, în care postura și forma corpului, care nu pot fi observate doar din față, se completează reciproc."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка нескольких фотографий с разных ракурсов позволяет получить более полную информацию о позе и фигуре, которые не видны только на фронтальной фотографии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď posielate fotografie z rôznych uhlov, môžete spoločne overiť polohu a postoj, ktoré nie je možné odhaliť len z jedného pohľadu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko pošljete več fotografij, lahko preverite različne položaje in telesno obliko, ki niso vidne samo s prednje strani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att skicka flera bilder tagna från olika vinklar kan du komplettera varandra och få en bättre bild av din hållning och kroppsform, vilket bara är möjligt med en bild från framsidan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல கோணங்களில் உள்ள புகைப்படங்களை ஒன்றாக அனுப்பும்போது, முன்பை விட வேறுபட்ட தோற்றத்தை உறுதிப்படுத்த முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వివిధ కోణాల నుండి ఫోటోలను ఒకేసారి పంపడం ద్వారా, ముందు మాత్రమే కనిపించని భంగిమలు మరియు శరీర ఆకృతిని సరిగ్గా తెలుసుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งภาพจากหลายมุมพร้อมกัน จะช่วยให้สามารถตรวจสอบท่าทางและรูปร่างที่ไม่ชัดเจนเมื่อถ่ายจากด้านหน้าได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı açılardan çekilmiş fotoğrafları toplu olarak göndererek, sadece ön cepten bakıldığında anlaşılması zor olan pozisyonları ve vücut şekillerini tamamlayarak kontrol edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилаючи декілька фотографій з різних ракурсів, ви зможете отримати повну картину, включаючи позу та форму тіла, які не видно лише з одного боку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi gửi nhiều ảnh chụp từ các góc khác nhau, bạn có thể bổ sung thông tin về tư thế và hình dáng cơ thể mà chỉ nhìn từ một phía không thể nhận biết được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将多角度照片一起发送时，可以同时确认正面和侧面的姿势和体型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過一起查看多個方向的照片，我們可以補全正面無法看到的姿勢和體型。"
          }
        }
      }
    },
    "health_meals_body_ai.08b433c8bd55": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:544\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
