    "domain_catalog.a1f1d48b670f": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:67\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظي على خط مستقيم من رأسك إلى كعبك، وادفعي صدرك نحو الأرض."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint una línia recta des del cap fins als talons, empeny el pit cap a terra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte rovou pozici od hlavy až k patám, přičemž zvedejte hrudník směrem dolů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en lige position fra hoved til tå, og løft brystet mod gulvet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie eine gerade Linie vom Kopf bis zum Fuß, und drücken Sie den Brustkorb zur Decke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε ευθεία τη θέση από το κεφάλι μέχρι τα πέλματα, φέρνοντας τον θώρακα προς τα κάτω και πιέζοντάς τον."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and push your chest towards the floor."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and push your chest towards the floor."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and push your chest towards the floor."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and push your chest towards the floor."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la línea desde la cabeza hasta los talones, acercando el pecho al suelo y empujándolo hacia abajo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la línea desde la cabeza hasta los talones, acercando el pecho al suelo y empujándolo hacia abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä vartalosta aina päästä varpaisiin suora linja, ja paina rintaa kohti lattiaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une posture droite, du sommet de la tête aux talons, en rapprochant la poitrine du sol et en la poussant vers le bas."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une posture droite, du sommet de la tête aux talons, en rapprochant la poitrine du sol et en la poussant vers le bas."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માથાથી પગ સુધી સીધી રેખા જાળવી રાખો, છાતીને નીચે તરફ ખેંચીને ઉપર કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על קו ישר מהראש ועד העקב, והרחיקו את החזה מהרצפה תוך הרמת הגוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर से पैर तक सीधा रखें, और छाती को फर्श की ओर खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite tijelo u ravnoj liniji od glave do pete, uzglačavajući prsnu kost prema podu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a testet egyenesen, fejét a talajhoz húzva, és emelje fel a mellkasát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga posisi dari kepala hingga tumit, serta mendorong dada ke arah lantai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere la postura da testa ai piedi, avvicinando il petto al pavimento e spingendolo verso il basso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭から踵まで一直線を保ち、胸を床へ近づけて押し上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리부터 발끝까지 일직선을 유지하고, 가슴을 바닥으로 당겨 올립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डोक्यापासून पायापर्यंत सरळ रेषेत ठेवा, छातीला जमिनीच्या दिशेने ओढून वर उचला."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan badan dalam keadaan tegak dari kepala hingga kaki, serta condongkan dada ke arah lantai."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een rechte lijn van hoofd tot hak, en duw je borst naar beneden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en rett linje fra hode til tå, og press brystet mot gulvet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj proste ułożenie ciała od głowy do stóp, przyciągając klatkę piersiową w kierunku podłogi i wypychając ją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a postura reta, da cabeça aos pés, e empurre o peito em direção ao chão."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a postura reta, da cabeça aos pés, e empurre o peito em direção ao chão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți o poziție dreaptă, de la cap până în picioare, și împingeți pieptul spre podea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте прямую линию от головы до пят, прижимая грудь к полу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte rovú postoj od hlavy až po päty, pričom prsné kosti stláčajte smerom k podlahe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržite ravno držo od glave do pet, ter pritisnite prsnico proti tleh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll kroppen i rak linje från huvud till tå, och pressa bröstet mot golvet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலை முதல் கால் வரை நேராக வைத்து, மார்பை தரையில் அழுத்தி உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తల నుండి కాలి వరకు ఒక సరళ రేఖను కొనసాగించండి, ఛాతీని నేలకు దగ్గరగా చేసి పైకి ఎత్తండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาท่าทางให้ตรงจากศีรษะจรดปลายเท้า และดันหน้าอกเข้าหาพื้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başınızdan topuklarınıza doğru, göğsünüzü yere doğru iterek düz bir pozisyon koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуйте пряму лінію від голови до п'ят, притискаючи груди до підлоги."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thẳng từ đầu đến bàn chân, đưa ngực về phía gần sàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持头部到脚部的直线，并将胸部向地面推起"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持頭到腳的一條線，並將胸部向地面推擠。"
          }
        }
      }
    },
