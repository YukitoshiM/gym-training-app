    "domain_catalog.1ff7bc87bcdd": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:125\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ مرفقيك مثنيين قليلًا، ثم اخفض ذراعيك نحو فخذيك على شكل قوس."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint els colzes lleugerament doblegats, baixeu els braços cap a les cuixes en un arc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohněte lokty jen mírně a ohnutě, poté stáhněte paži směrem k noham."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj let i albuerne og sænk armen, så den danner en bue mod låret."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beuge deine Ellbogen leicht und senke deine Arme in einer Bogenbewegung zum Oberschenkel ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λυγίστε ελαφρώς τους αγκώνες σας και χαμηλώστε τα χέρια σας προς τη πλευρά, σχηματίζοντας μια καμπύλη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and lower your arms in an arc towards your thighs."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and lower your arms in an arc towards your thighs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and lower your arms in an arc towards your thighs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and lower your arms in an arc towards your thighs."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Doblar ligeramente los codos y bajar el brazo hacia el costado, formando una curva."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Doblar ligeramente los codos y bajar el brazo hacia el costado, formando una curva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taivaa kyynärpäitä hieman ja laske käsi alas reisien puolelle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos coudes légèrement pliés tout en abaissant votre bras vers le côté, formant une courbe."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos coudes légèrement pliés tout en abaissant votre bras vers le côté, formant une courbe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને હળવાશથી વાળીને, પગની તરફ નીચે લઈ જાઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתכופף מעט את הכתף ולשלוף את הזרוע כלפי מטה, תוך יצירת קשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी को थोड़ा मोड़े हुए स्थिति में, अपने हाथ को घुमाकर अपनी जांघ की ओर नीचे लाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savijte ruke lagano i spustite ruke u oblik kuka prema bočnoj strani tijela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hajtja meg enyhén a karokat, majd húzza lefelé a térd felé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menebuk siku sedikit, lalu menurunkan lengan membentuk lengkungan ke arah paha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni leggermente piegati i gomiti e abbassa le braccia lateralmente, formando un arco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘を軽く曲げたまま、腕を弧を描くように太もも側へ下ろす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가볍게 팔꿈치를 구부린 상태에서 팔을 활 모양으로 다리 쪽으로 내립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हलक्या पद्धतीने वाकलेले हात, पायांच्या बाजूला सरळ रेषेत खाली आणा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan siku sedikit, lalu menurunkan lengan ke arah paha."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig je ellebogen licht en laat je armen in een boog naar de zijkant bewegen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy lett i albuene og senk armen, slik at den danner en bue mot låret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatnie zgiń łokieć i opuść rękę wzdłuż uda, tworząc łuk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos levemente flexionados e abaixe o braço em arco em direção às pernas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos levemente flexionados e abaixe o braço em arco em direção às pernas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține antebrațul ușor îndoit și trage-ți coatele spre interior, formând o arcadă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте локти слегка согнутыми и опустите руки по дуге к внутренней стороне бедра."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržite mierne ohnuté lakte a ohnite predloktie smerom k noham."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na položaj rok, nato pa navoza z ramo v obliki kroga do kolena."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj lätt på armbågen och sänk ner armen i en båge mot låret."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை லேசாக மடக்கி, உடலை வளைத்து, தொடையின் பக்கமாக இறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులను కొద్దిగా వంచి, మోకాళ్ల వైపుకు వంగి, చేతులు వంపు తిరుగుతూ ఉండేలా చేయడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งอข้อศอกเล็กน้อย แล้วดึงแขนไปทางด้านข้างอย่างโค้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirseğinizi hafifçe bükün ve kolunuzu eğimli bir şekilde kalçalarınızın tarafına indirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Злегка зігніть руки та опустіть їх у сторони, утворюючи дугу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gập nhẹ khuỷu tay, sau đó đưa cánh tay xuống phía đùi theo đường cong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻微弯曲肘部，并将手臂向腿部下方拉伸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕微彎曲肘部，然後將手臂向身體側拉"
          }
        }
      }
    },
