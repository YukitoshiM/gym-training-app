        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zlepšujte hmotnost a obvod pasu udržitelným tempem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbedr vægt og taljemål i et holdbart tempo"
          }
        },
