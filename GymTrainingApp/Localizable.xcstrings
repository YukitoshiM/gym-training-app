    "domain_catalog.5c69a908bdc7": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:118\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع حوضك واسحب المقبض نحو بطنك أثناء الضغط على لوحي كتفك معًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aixequeu la pelvis i estireu el mànec cap a l'abdomen mentre premeu els omòplats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvedněte pánev a přitáhněte ručník směrem k břich, přičemž držte ramena blízko sebe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold hoften oprejst, og træk håndtaget mod maven, mens du samler skulderbladene."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie die Hüfte auf und ziehen Sie das Lenkrad zur Seite, während Sie die Schulterblätter zusammenziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στήστε τη λεκάνη σας, ενώ συγκεντρώνετε τους ώμους σας και τραβάτε το τιμόνι προς την κοιλιά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your hips forward and pull the handle towards your abdomen while bringing your shoulder blades together."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your hips forward and pull the handle towards your abdomen while bringing your shoulder blades together."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your hips forward and pull the handle towards your abdomen while bringing your shoulder blades together."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your hips forward and pull the handle towards your abdomen while bringing your shoulder blades together."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta las caderas y tira del manillar hacia el abdomen mientras acercas los omóplatos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta las caderas y tira del manillar hacia el abdomen mientras acercas los omóplatos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä selkä suorana ja vedä ranteet lähelle, samalla vetämällä ohjausta kohti vatsaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez votre bassin droit et tirez sur le levier vers l'avant, en rapprochant vos omoplates."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez votre bassin droit et tirez sur le levier vers l'avant, en rapprochant vos omoplates."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પેટને સીધો રાખો, ખભાને નજીક રાખીને હેન્ડલને પેટ તરફ ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרימו את בלוטת השד, והסירו את הכתפיים תוך משיכת המנוע לכיוון הבטן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कमर को सीधा रखें, और अपनी कंधे की हड्डियों को एक साथ रखते हुए, हैंडल को अपने पेट की ओर खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite trup, držeći ramena blizu, i povucite ručicu prema trupu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilítsa a gerincet, és húzza a kormányt a hasához, miközben a vállai össze vannak húzva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menegakkan pinggul, sambil menarik gagang ke arah perut dengan mendekatkan tulang selangka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solleva la zona pelvica e tira la maniglia verso l'addome, mantenendo le spalle unite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "骨盤を立て、肩甲骨を寄せながらハンドルを腹部へ引く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "골반을 세우고, 어깨뼈를 모으면서 핸들을 복부 방향으로 당깁니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंबर सरळ ठेवा आणि खांद्याच्या हाडांना एकत्र आणून, हँडलबेलला पोटाच्या दिशेने ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegakkan pinggul, sambil menarik kemudi ke arah perut dengan menyekat tulang belikat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Til je heupen omhoog en trek het stuur naar je buik terwijl je je schouderbladen samenbrengt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Støtt hoften og trekk håndtaket mot magen mens du trekker skulderbladene sammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj stabilną postawę, przyciągając łopatki i prowadząc uchwyt do brzucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a pelve ereta e puxe o volante em direção ao abdômen, juntando as escápulas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a pelve ereta e puxe o volante em direção ao abdômen, juntando as escápulas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridicați pelvisul și trageți mânerul spre abdomen, aducând umerii împreună."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите таз, подтягивайте ручку к животу, совмещая лопатки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilizujte panvu a pritláčajte ramenné kosti, pričom ťahajte riadítka smerom k bruchu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprite hrbid in približite ramo, ter povlečite roko proti prekladu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ bäckenet och dra handtaget mot magen medan du pressar ihop skulderbladen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொழியை நேராக வைத்து, தோள்பட்டை எலும்புகளை நெருக்கமாக கொண்டு வந்து, ஹேண்டில்-ஐ வயிற்றுக்கு இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూతిని పైకి ఎత్తి, భుజాలను దగ్గరగా చేసి హ్యాండిల్‌ను కడుపు వైపుకు లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งกระดูกสันหลัง และดึงหูไปทางด้านหน้าโดยใช้มือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalçalarınızı dik tutun, omuzlarınızı bir araya getirerek direksiyonu karınınıza doğru çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте таз у вертикальному положенні, тягніть ручку до живота, зводячи лопатки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đứng thẳng, kéo tay về phía bụng trong khi giữ xương vai gần nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起骨盆，同时将肩胛骨靠拢，并将手柄拉向腹部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起骨盆，同時將肩胛骨靠攏，並將手柄拉向腹部。"
          }
        }
      }
    },
