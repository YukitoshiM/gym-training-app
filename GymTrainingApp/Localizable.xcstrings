        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não arqueie demais as costas e gire o tronco lateralmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitați să vă aplecați prea mult și rotiți corpul lateral."
