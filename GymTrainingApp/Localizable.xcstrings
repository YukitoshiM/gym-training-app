    "health_meals_body_ai.097c8a28c9eb": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:707\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إن ارتداء Apple Watch بشكل مناسب وارتدائه حتى أثناء النوم سيساعد على أن تكون مؤشرات التعافي الخاصة بك متسقة. لن يتم ملء العناصر التي ليس لها قيمة عن طريق التخمين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Portar Apple Watch amb un ajust adequat i portar-lo fins i tot mentre dorms ajudarà a que els teus indicadors de recuperació siguin coherents. Els elements sense valor no s'ompliran per endevinar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte Apple Watch, abyste je nosili i během spánku, což usnadní získání všech ukazatelů. Chybějící hodnoty nebudeme odhadovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug et smartwatch passende og bær det, også mens du sover, for at få en bedre oversigt over dine resultater. Vi udfylder ikke manglende værdier med gæt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragen Sie Ihre Apple Watch bequem und auch während des Schlafs, um die Wahrscheinlichkeit zu erhöhen, dass alle relevanten Daten erfasst werden. Nicht verfügbare Werte werden nicht mit Schätzungen aufgefüllt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φορέστε το Apple Watch κατάλληλα και κατά τη διάρκεια του ύπνου για να έχετε πιο ακριβείς μετρήσεις. Δεν συμπληρώνουμε τις τιμές που λείπουν με υποθέσεις."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Wearing an Apple Watch moderately and during sleep will help ensure that recovery indicators are complete. We do not fill in missing values with estimates."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Wearing an Apple Watch moderately and during sleep will help ensure that recovery indicators are complete. We do not fill in missing values with estimates."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wearing an Apple Watch moderately and during sleep will help ensure that recovery indicators are complete. We do not fill in missing values with estimates."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Wearing an Apple Watch moderately and during sleep will help ensure that recovery indicators are complete. We do not fill in missing values with estimates."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar un reloj Apple y llevarlo durante el sueño ayuda a obtener más indicadores de recuperación. No se completan los campos sin valor con estimaciones."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar un reloj Apple y llevarlo durante el sueño ayuda a obtener más indicadores de recuperación. No se completan los campos sin valor con estimaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä Apple Watchia sopivasti ja pidä se päällä myös nukkumisen aikana, jolloin palautumismittarit ovat helpommin saatavilla. Puuttuvien arvojen kohdalla ei tehdä oletuksia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez votre montre Apple confortablement et pendant le sommeil pour faciliter l'obtention des indicateurs de récupération. Les valeurs manquantes ne sont pas estimées."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez votre montre Apple confortablement et pendant le sommeil pour faciliter l'obtention des indicateurs de récupération. Les valeurs manquantes ne sont pas estimées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch ને યોગ્ય રીતે પહેરો અને સૂતી વખતે પણ પહેરવાથી, પુનઃપ્રાપ્તિના આંકડાઓ સરળતાથી મેળવી શકાય છે. કયા કયા મૂલ્યો નથી તે માટે, આપણે અનુમાનિત કિંમતોનો ઉપયોગ નહીં કરીએ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאימו את השעון Apple בצורה נוחה והשתמשו בו גם בזמן השינה, כדי להקל על השגת מדדים רלוונטיים. לא נמליץ על השלמה של ערכים חסרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch को उचित रूप से फिट करके पहनें और सोते समय भी पहनने से रिकवरी के संकेत मिल सकते हैं। यदि कोई मान नहीं है, तो हम अनुमान लगाकर उसे पूरा नहीं करेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nošenje Apple Watcha tijekom treninga i spavanja može pomoći u prikupljanju podataka o oporavku. Ne nadoknadujemo vrijednosti koje su prazne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megfelelő edzéshez, valamint a pihenés közben viselje az Apple Watch-ot, hogy könnyebben megkapja a szükséges adatokat. A hiányzó értékeket nem fogja becsülni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenakan dan gunakan Apple Watch secara teratur, termasuk saat tidur, agar indikator pemulihan lebih lengkap. Item tanpa nilai tidak akan diperkirakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indossare un Apple Watch e indossarlo anche durante il sonno può facilitare l'ottenimento degli indicatori di recupero. Non si completano i campi vuoti con stime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchを適度にフィットさせて装着し、睡眠中も着用すると回復指標がそろいやすくなります。値がない項目は推測で補完しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch을 적절하게 착용하고 잠자는 동안에도 착용하면 회복 지표를 쉽게 얻을 수 있습니다. 값이 없는 항목은 추측으로 보완하지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch योग्य प्रकारे फिट करून वापरा आणि झोपताना देखील घाला, ज्यामुळे पुनर्प्राप्तीचे मापदंड मिळण्यास मदत होईल. ज्या ठिकाणी व्हॅल्यू नाही, तिथे अंदाज वापरून भरलेली नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenakan Apple Watch secara berkala dan semasa tidur akan memudahkan untuk mendapatkan penunjuk pemulihan. Item tanpa nilai tidak akan diisi dengan anggaran."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Draag een Apple Watch tijdens het sporten en slapen om de herstelindicatoren te verzamelen. Waarden die ontbreken, worden niet ingeroepen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en Apple Watch moderat og bruk den også om natten, da dette kan gjøre det lettere å få tak i restitusjonsmålinger. Vi fyller ikke ut manglende verdier med estimater."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noś Apple Watch na nadgarstku, nawet podczas snu, aby ułatwić zbieranie danych dotyczących regeneracji. Wartości brakujące nie są uzupełniane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar um smartwatch (Apple Watch) e usá-lo durante o sono pode ajudar a obter mais indicadores de recuperação. Não preenchemos valores ausentes com estimativas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar um smartwatch (Apple Watch) e usá-lo durante o sono pode ajudar a obter mais indicadores de recuperação. Não preenchemos valores ausentes com estimativas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Purtați ceasul Apple Watch și, dacă este posibil, purtați-l și în timpul somnului pentru a facilita obținerea indicatorilor de recuperare. Nu completăm valorile lipsă prin deducție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Носите Apple Watch умеренно и во время сна, чтобы показатели восстановления были более точными. Значения отсутствующих элементов не будут догаданы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používajte Apple Watch, ktorý si správne nasadíte a noste aj počas spánku, aby ste získali viac informácií o regenerácii. Chýbajúce hodnoty nebudeme odhadovať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporaba Apple Watcha in nosite ga med spanjem, da boste lažje dobili podatke o zdravju. Ne napovedujemo vrednosti za prazne elemente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd en Apple Watch bekvämt och bär den även under sömn för att få fler återhämtningsmätvärden. Vi fyller inte i saknade värden med gissningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch-ஐ சரியான முறையில் அணிந்து தூங்கும்போதும் அணியுங்கள், இது மீட்பு அளவுகளை எளிதாக்கும். மதிப்புகள் இல்லாத உள்ளீடுகளை ஊகத்தின் மூலம் நிரப்பாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchను సక్రమంగా ధరించి, నిద్ర సమయంలో కూడా ధరించడం వలన పునరుద్ధరణ సూచికలు సులభంగా లభిస్తాయి. విలువ లేని అంశాలను అంచనా ద్వారా పూరించము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสวม Apple Watch อย่างเหมาะสมและการใส่ตลอดเวลาขณะนอนหลับจะช่วยให้ข้อมูลเกี่ยวกับสุขภาพครบถ้วนมากขึ้น ไม่มีการคาดเดาค่าที่ยังไม่มี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch'unuzu uygun şekilde takın ve uyurken de kullanmak, iyileşme ölçümlerinizi daha kolay toplamanıza yardımcı olur. Eksik değerleri tahminle tamamlamamaktadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Носіння Apple Watch під час фізичної активності та сну може допомогти отримати більш повні показники відновлення. Значення відсутніх елементів не будуть додумуватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để có kết quả phục hồi tốt hơn, hãy đeo đồng hồ Apple Watch vừa vặn và đeo cả khi ngủ. Chúng tôi sẽ không ước tính giá trị cho các mục trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适度地佩戴Apple Watch，并在睡眠时佩戴，有助于获得更全面的恢复指标。对于没有值的项目，不会进行推测补充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請適度地佩戴Apple Watch，並在睡眠時也佩戴，這樣可以更容易獲得恢復指標。對於沒有值的項目，不會進行推測補全。"
          }
        }
      }
    },
