    "core_ui.5741ec6a7cf6": {
      "comment": "GymTrainingApp/Features/Record/RecordHubView.swift:43",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل بعض الأشياء الآن وراجع كل شيء لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra unes quantes coses ara i revisa-ho tot més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenejte teď několik věcí a vše si projděte později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer et par ting nu, og gennemgå det hele senere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse jetzt einige Angaben und sieh dir später alles gemeinsam an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατάγραψε λίγα πράγματα τώρα και εξέτασέ τα όλα αργότερα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a few things now and review everything later."
          }
