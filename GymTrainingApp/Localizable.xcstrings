    "domain_catalog.fd491d2bd8bd": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:376\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على ثبات جذعك، وارجع ساقيك إلى الخلف وقم بتقليص الأرداف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint el nucli ferm, fes un cop de peu cap enrere i contrau les natges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte trpáň a zatlačte nohy dozadu, abyste stáhli boky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør din kerne og spark med benene bagud for at trække hofterne ind."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixieren Sie Ihre Rumpfmuskulatur und treten Sie mit den Füßen nach hinten, um die Hüften zu kontrahieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθεροποιήστε τον κορμό και χτυπήστε τα πόδια προς τα πίσω για να συστέλλεται ο κοιλιακός σας μυς."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilize your core and kick your legs back to contract your hips."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilize your core and kick your legs back to contract your hips."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilize your core and kick your legs back to contract your hips."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilize your core and kick your legs back to contract your hips."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabiliza tu core y, con los pies, empuja hacia atrás para contraer las caderas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabiliza tu core y, con los pies, empuja hacia atrás para contraer las caderas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä ydin ja potkaise jalat taakse, jolloin lantio supistuu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixer le tronc et pousser les jambes vers l'arrière pour contracter les fessiers."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixer le tronc et pousser les jambes vers l'arrière pour contracter les fessiers."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરના કેન્દ્રને સ્થિર કરો, પગને પાછળ ધકેલીને હિપ્સને સંકોચાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזקו את הליבה ובעטו ברגליים אחורה כדי לכווץ את האגן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोर को स्थिर रखें, और पैरों को पीछे की ओर मारकर कूल्हों को संकुचित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zategnite trbušne mišiće i bacite noge prema nazad, usvajajući položaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilízd a gerinced, és rúgj ki a lábaival, hogy a deredet összehúzzd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilkan inti tubuh, lalu tendang kaki ke belakang untuk mengencangkan pinggul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissare il core e allungare le gambe indietro, contraendo i glutei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体幹を固定し、脚を後方へ蹴り出して臀部を収縮させる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코어를 고정하고, 다리를 뒤로 뻗어 엉덩이를 수축시킵니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीराचा मध्यभाग स्थिर ठेवा आणि पाय मागे मारून नितंबांना घट्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegakkan inti tubuh, kemudian tendang kaki ke belakang dan kempiskan pinggul."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De core stabiliseren en de benen naar achteren steken om de heupen in te trekken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fest kjernen, og spark føttene bakover for å trekke hoftene inn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabezpiecz rdzeń i kopnij nogami do tyłu, aby zaciągnąć biodra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe o core e chute as pernas para trás, contraindo os glúteos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe o core e chute as pernas para trás, contraindo os glúteos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixează centrul corpului și lovește picioarele înapoi pentru a contracta zona feselor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепите свой корпус и отталкивайтесь ногами назад, чтобы сжать таз."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zafixujte core a odrazte nohy dozadu, aby ste stiahli boky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadržite trup in z nogami v spodnji poziciji, da se nagobe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixera din kärna och sparka med benen bakåt för att dra in höfterna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடலின் மையப்பகுதியை உறுதி செய்து, கால்களை பின்னோக்கி தள்ளி இடுப்பை சுருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీర మధ్య భాగాన్ని స్థిరంగా ఉంచండి, కాళ్ళను వెనక్కి నెట్టి, పిరుదులను కుదించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล็อกส่วนกลางลำตัว และเหยียดขาออกด้านหลัง เพื่อกระชับสะโพก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkezi vücudu sabitleyin, bacaklarınızı geriye doğru savurarak kalçalarınızı sıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зафіксуйте корпус і відштовхуйте ноги назад, щоб звузити талію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ cố định trung tâm cơ thể, đá chân ra sau để co rút hông."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定核心肌群，并将双腿向后踢出，收缩臀部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定核心肌群，向後踢腿，收縮臀部。"
          }
        }
      }
    },
    "domain_catalog.fd6d8990ae12": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:25\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع الدمبلز للأسفل إلى جانبي صدرك دون الضغط على لوحي الكتف معًا وفتح مرفقيك كثيرًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Empenyeu les manuelles cap als costats del pit sense prémer els omòplats i obrir massa els colzes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přibližte lopatky k sobě, ohněte lokty a zvedejte činku směrem k hrudníku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring skulderbladene tættere sammen, og løft vægten ned mod brystet uden at bøje for meget i albuerne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte deine Schulterblätter aus und senke das Gewicht mit leicht geöffneten Ellbogen zur Seite vor deiner Brust ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγκεντρώστε τους οστούς της ωμοπλάτης και πιέστε το ράβδο προς τα κάτω, κοντά στην περιοχή του θώρακα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together and lower the dumbbell to your chest while keeping your elbows slightly open."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together and lower the dumbbell to your chest while keeping your elbows slightly open."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together and lower the dumbbell to your chest while keeping your elbows slightly open."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your shoulder blades together and lower the dumbbell to your chest while keeping your elbows slightly open."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar las escápulas y bajar la barra hacia el lado del pecho, manteniendo los codos abiertos lo menos posible."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Acercar las escápulas y bajar la barra hacia el lado del pecho, manteniendo los codos abiertos lo menos posible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä hartiat lähellä toisiaan, laske käsipainot alas rintaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez vos omoplates et poussez l'haltère vers le bas sur le côté de votre poitrine sans trop plier vos coudes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapprochez vos omoplates et poussez l'haltère vers le bas sur le côté de votre poitrine sans trop plier vos coudes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખભાની હાડકાંને નજીક લાવો, હાથને વધારે ખુલ્લું ન રાખો અને ડમ્બેલને છાતીની બાજુ પર નીચે લઈ જઈને દબાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתקרב את הצלעות, ולהוריד את הדסקית לצד החזה תוך שמירה על מיקום הכתף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी को खोलें नहीं, बल्कि डम्बल को अपने सीने के बगल में नीचे लाएं और दबाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Priljubite lopatice, spuštajući uteg prema prsima i gurajući ga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyűsse a lapátokat, és húzza lefelé a käsizt a mell előtt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga tulang selangka tetap sejajar, lalu menarik dumbbell ke samping tanpa terlalu membuka siku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvicina le scapole e sposta il manubrio lateralmente, mantenendo i gomiti non troppo aperti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肩甲骨を寄せ、肘を開きすぎずにダンベルを胸の横へ下ろして押す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어깨뼈를 모아, 팔꿈치가 너무 벌어지지 않도록 덤벨을 가슴 옆으로 밀어 내립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खांद्याचे हाड एकत्र ठेवा, जास्त वाकलेले हात आणि डंबेल छातीच्या बाजूला खाली ओढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menegangkan tulang belikat, sambil menarik dumbbell ke arah dada tanpa terlalu menekuk siku."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng je schouderbladen naar elkaar toe en til de dumbbell naar je borst door middel van je ellebogen, zonder ze te veel te buigen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold skulderbladene tett sammen og senk stangen mot brystet med lett bøyd albue."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przybliż obojczyki i delikatnie opuść ciężar wzdłuż klatki piersiowej, jednocześnie utrzymując prawidłową pozycję łokci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime as escápulas e abaixe o peso em direção ao peito, mantendo os cotovelos na posição correta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime as escápulas e abaixe o peso em direção ao peito, mantendo os cotovelos na posição correta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apropie coastele și trage gantera în jos, lângă piept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согните локти, не сгибая их слишком сильно, и опустите гантель к себе."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte lopatky, ohnite lakte a stláčajte činku smerom k hrudníku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zložite ramo in bodite pozorni na položaj rok, da ute spravite proti prs."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rulla ihop skulderbladen och sänk hanteln neråt mot bröstet utan att överexplicera armbågen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோள்பட்டை எலும்புகளை ஒன்றிணைத்து, டம்பலை மார்புக்கு அருகில் இறக்கி அழுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భుజం కడ్వలను దగ్గర చేసి, భుజాలను ఎక్కువగా తెరవకుండా డమ్బెల్‌ను ఛాతీ వైపుకు దించి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวบสะกะ และงอข้อศอกเล็กน้อย จากนั้นใช้ดัมเบลดันลงด้านข้างของอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omuz kemiklerinizi bir araya getirin, dirseklerinizi çok fazla açmayın ve ağırlığı göğsünüzün yan tarafına doğru itin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зблизьте лопатки та опустіть гантелі вбік, не згинаючи руки надмірно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gần nhau các xương sườn, giữ khuỷu tay không quá rộng và đưa tạ xuống phía bên ngực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近肩胛骨，同时避免过度弯曲肘部，并将哑铃向下推到胸部两侧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近肩胛骨，輕微彎曲肘部，將啞鈴向下推至胸部側面"
          }
        }
      }
    },
