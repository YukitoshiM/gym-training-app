    "domain_catalog.c3313a2b5bfb": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:222\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مراقب هادئ. إعطاء الأولوية للنوم والصحة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un observador tranquil. Prioritzar el son i la salut"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozorovatel, který klade důraz na odpočinek a zdraví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolig observatør. Prioriterer søvn og velvære."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachter mit ruhiger Haltung. Priorisierung von Schlaf und Wohlbefinden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παθητικός παρατηρητής. Δίνετε προτεραιότητα στον ύπνο και την υγεία σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm observer. Prioritise sleep and well-being."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm observer. Prioritise sleep and well-being."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm observer. Prioritise sleep and well-being."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm observer. Prioritise sleep and well-being."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Observador tranquilo. Prioriza el sueño y el bienestar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Observador tranquilo. Prioriza el sueño y el bienestar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaava tarkkailija. Prioriteettina ovat unen ja hyvinvoinnin seuranta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Observateur discret. Privilégiez le sommeil et votre bien-être."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observateur discret. Privilégiez le sommeil et votre bien-être."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શાંત નિરીક્ષક. ઊંઘ અને સ્વાસ્થ્યને પ્રાથમિકતા આપો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צופה שקט. העדיפו שינה ובריאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत पर्यवेक्षक। नींद और स्वास्थ्य को प्राथमिकता दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprezan promatrač. Prioritet dajete spavanju i svom zdravlju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyugodt megfigyelő. A pihenés és az egészség prioritása."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengamat yang tenang. Prioritaskan tidur dan kondisi tubuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osservatore discreto. Priorità al sonno e al benessere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな観察者。睡眠と体調を優先する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 관찰자. 수면과 건강을 우선시"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शांतपणे निरीक्षण करणारे. झोप आणि आरोग्याला प्राधान्य द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengamat yang tenang. Prioritaskan tidur dan kesihatan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Observatie zonder oordeel. Prioriteit voor slaap en welzijn."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Observatør med fokus på ro og velvære. Prioriter søvn og helse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwator, który ceni spokój. Priorytetem są sen i samopoczucie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observador discreto. Priorize o sono e o bem-estar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Observador discreto. Priorize o sono e o bem-estar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Observator calm. Prioritizați somnul și starea de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный наблюдатель. Приоритет – сон и самочувствие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozorujúci, ktorý uprednostňuje spánok a celkové zdravie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiho opazovalce. Prednost za spanje in zdravje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugn observatör. Prioritera sömn och välbefinnande."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதியான பார்வையாளர். தூக்கம் மற்றும் உடல்நிலையை முன்னுரிமைப்படுத்துங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాంతంగా గమనించే వ్యక్తి. నిద్ర మరియు శారీరక ఆరోగ్యాన్ని ప్రాధాన్యత ఇవ్వండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้สังเกตการณ์ที่ใจเย็น เน้นการพักผ่อนและการดูแลสุขภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin gözlemci. Uyku ve sağlığı önceliklendir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійний спостерігач. Пріоритет – сон і самопочуття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan sát viên bình tĩnh. Ưu tiên giấc ngủ và sức khỏe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静的观察者。优先考虑睡眠和身体状况"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個觀察者，優先睡眠和身體狀況"
          }
        }
      }
    },
