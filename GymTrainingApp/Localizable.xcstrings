    "domain_catalog.bc5c2cf53ef0": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:429\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على ثبات حوضك واسحب الكابل لأسفل أثناء تقريب ظهرك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu la pelvis ferma i estireu el cable cap avall mentre arrodoniu l'esquena."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte pánev v stabilní poloze a táhněte za kabel, abyste se mírně ohýbali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold hoften stabil, og træk kablet ned for at runde ryggen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie den Kabel, um die Hüfte zu stabilisieren und den Rücken leicht nach vorne zu beugen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στήστε τη λεκάνη σας και τραβήξτε τον ασκό προς τα κάτω με το καλώδιο, διατηρώντας την πλάτη σας ίσια."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down the cable while keeping your hips stable and rounding your back."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down the cable while keeping your hips stable and rounding your back."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down the cable while keeping your hips stable and rounding your back."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down the cable while keeping your hips stable and rounding your back."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta el abdomen, tirando del cable para mantener la espalda recta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta el abdomen, tirando del cable para mantener la espalda recta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä lantion suorana ja vedä kaapelia alas, jotta selkä pysyy suorana."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez sur le câble pour maintenir votre bassin stable et courber légèrement le dos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez sur le câble pour maintenir votre bassin stable et courber légèrement le dos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પેટને સ્થિર રાખો, અને પાછળના ભાગને સીધો રાખીને કેબલને નીચે ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו את בלוטת השד, והסירו את הגב תוך משיכת המנוע לכיוון הבטן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कमर को सीधा रखें, और अपनी पीठ को सीधा रखते हुए, हैंडल को अपने पेट की ओर खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite trup, a kabel podižite prema sebi uzglačavajući ramena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa stabil a gerincet, és húzza le a kábelt, hogy a hátja egyenes maradjon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik kabel ke arah perut sambil memposisikan pinggul dan mendekatkan tulang selangka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la zona pelvica stabile e tira il cavo verso l'addome, mantenendo le scapole unite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "骨盤を固定し、背中を丸めるようにケーブルを引き下げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "골반을 고정하고, 허리를 둥글게 만들도록 케이블을 아래로 당깁니다."
