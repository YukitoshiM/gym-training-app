    "core_ui.4cfa4f6e6a37": {
      "comment": "GymTrainingApp/Features/Onboarding/InitialSetupView.swift:727\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ربط القوة العضلية والقوة البدنية والتعافي بالمنافسة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectant la força muscular, la força física i la recuperació amb la competició"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propojte trénink svalů, sílu a kondici s výkonem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind styrke, udholdenhed og restitution med konkurrencen"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehung von Kraft, Ausdauer und Erholung zur Leistung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύνδεση της άσκησης με τη φυσική κατάσταση και την ανάρρωση"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect strength, fitness, and recovery to competition"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect strength, fitness, and recovery to competition"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect strength, fitness, and recovery to competition"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect strength, fitness, and recovery to competition"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el entrenamiento de fuerza con el rendimiento y la condición física."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el entrenamiento de fuerza con el rendimiento y la condición física."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä voima, kunto ja palautuminen kilpailuun"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Relier la force, l'endurance et la récupération à la performance sportive"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relier la force, l'endurance et la récupération à la performance sportive"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્નાયુ શક્તિ, શારીરિક ક્ષમતા અને પુનઃપ્રાપ્તિને સ્પર્ધામાં જોડો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיבור ביצועים ספורטיביים, כוח וכושר, והתאוששות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मांसपेशियों की ताकत, फिटनेस और रिकवरी को प्रतिस्पर्धा में शामिल करना"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite izdržljivost, snagu i oporavak s treniranjem"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az izomgyakorlatokat a versenyképességhez kapcsolja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghubungkan latihan kekuatan, daya, dan pemulihan dengan kompetisi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega le prestazioni, la forza e il recupero alle attività sportive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋力・体力・回復を競技につなげる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근력, 체력, 회복을 경쟁에 연결"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मांसपेशी आणि शारीरिक क्षमता तसेच पुनर्प्राप्तीला स्पर्धेत रूपांतरित करा"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghubungkan latihan kekuatan, tenaga dan pemulihan dengan prestasi"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind spierkracht, uithoudingsvermogen en herstel met prestaties"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble styrke, utholdenhet og restitusjon til konkurranse"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie treningu siłowego z osiąganiem wyników"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar o treino de força ao desempenho esportivo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar o treino de força ao desempenho esportivo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați performanța, forța și recuperarea cu activitatea sportivă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свяжите тренировки на силу с достижением результатов"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojte tréning svalov, fyzickú kondíciu a regeneráciu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite trening z utežmi s kondicijo in okrevanje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppla samman styrka, kondition och återhämtning med prestation"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடற்பயிற்சியை போட்டியாக மாற்றுதல்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కండర బలం, ఫిట్‌నెస్ మరియు కోలుకునే సామర్థ్యాన్ని పోటీకి అనుగుణంగా తీసుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมโยงความแข็งแรงของร่างกาย, ความฟิต และการฟื้นตัวเข้ากับการแข่งขัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas gücünü, dayanıklılığını ve iyileşmeyi rekabete bağlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зв'яжіть тренування м'язів, силу та відновлення з досягненням результатів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối sức mạnh, thể lực và khả năng phục hồi với hoạt động thi đấu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将力量、体能和恢复与竞技相结合"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将力量、体能和恢复与竞赛相结合"
          }
        }
      }
    },
