        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrali jste podle nastaveného cíle, dostupného vybavení a počtu tréninků v týdnu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
