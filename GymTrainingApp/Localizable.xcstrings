    "health_meals_body_ai.6055fa3672d8": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:581\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بالنسبة للأحداث المرشحة للركود، حاول خفض الوزن ومطابقة الممثلين المستهدفين، أو قم بتمديد فترة راحتك بمقدار 15 إلى 30 ثانية وقارن."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per als esdeveniments que són candidats a l'estancament, proveu de baixar el pes i igualar les vostres repeticions objectiu, o allarga el vostre descans de 15 a 30 segons i compareu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro kontrolu stagnace zkuste snížit váhu na cílový počet opakování nebo prodlužte pauzu o 15–30 sekund a porovnejte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at kontrollere stagnation, sammenlign om du har reduceret vægten én gang og opnået det ønskede antal gentagelser, eller om du har forlængt pausen med 15-30 sekunder."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Stillstände zu erkennen, vergleichen Sie, ob Sie das Gewicht einmal reduziert und die Zielanzahl erreicht haben, oder ob Sie die Pause um 15–30 Sekunden verlängern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τον έλεγχο στατικής κατάστασης, συγκρίνετε είτε μειώνοντας το βάρος και επαναλαμβάνοντας τον στόχο, είτε αυξάνοντας την ανάπαυση κατά 15-30 δευτερόλεπτα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "To identify stagnation, try reducing the weight once and aiming for the target number of repetitions, or extend your rest by 15-30 seconds and compare."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "To identify stagnation, try reducing the weight once and aiming for the target number of repetitions, or extend your rest by 15-30 seconds and compare."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To identify stagnation, try reducing the weight once and aiming for the target number of repetitions, or extend your rest by 15-30 seconds and compare."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "To identify stagnation, try reducing the weight once and aiming for the target number of repetitions, or extend your rest by 15-30 seconds and compare."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar si hay estancamiento, compare el número de repeticiones después de haber reducido ligeramente el peso o extendido el descanso en 15-30 segundos."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar si hay estancamiento, compare el número de repeticiones después de haber reducido ligeramente el peso o extendido el descanso en 15-30 segundos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaa vaihtoehtoja laskemalla ensin paino yhden asteen alhaisemmaksi ja tavoite toistoihin, tai pidennämällä lepoa 15–30 sekunnilla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vérifier si vous êtes en train de stagner, essayez de réduire le poids une fois et d'atteindre le nombre cible, ou d'augmenter la pause de 15 à 30 secondes pour comparer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vérifier si vous êtes en train de stagner, essayez de réduire le poids une fois et d'atteindre le nombre cible, ou d'augmenter la pause de 15 à 30 secondes pour comparer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થિરતા માટેના વિકલ્પો: વજન એકવાર ઘટાડીને લક્ષ્ય સંખ્યા સુધી પહોંચો અથવા 15-30 સેકન્ડ માટે આરામ વધારીને સરખાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוגי קיפאון: השווה בין הורדת משקל פעם אחת לשימוש במספר חזרות, או בין הפסקת מנוחה של 15-30 שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थगन के लिए, वजन को एक बार कम करके लक्ष्य संख्या प्राप्त करें या 15-30 सेकंड तक आराम लें और तुलना करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrste koje treba provjeriti su: smanjite težinu i pokušajte ponovno doći do cilja, ili produžite odmor za 15-30 sekundi i usporedite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljesítéshez tartozó tevékenységek közül válaszd ki, hogy csökkentsd az edzésmenet számát, vagy hosszabb szünetet tegyél, és hasonlítsd össze."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis latihan stagnasi adalah dengan menurunkan berat badan sekali lalu mencapai jumlah target, atau memperpanjang istirahat 15-30 detik untuk dibandingkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per identificare le possibili cause dello stallo, prova a ridurre il peso una volta e raggiungere il numero target, oppure allunga il riposo di 15-30 secondi per confrontare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停滞候補の種目は、重量を一度下げて目標回数をそろえるか、休憩を15〜30秒延ばして比較しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정체 가능 항목은, 무게를 한 번 낮춰 목표 횟수를 맞추거나, 휴식을 15~30초 연장하여 비교해 보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिरतेसाठी, वजन एकदा कमी करून लक्ष्य वेळेनुसार तपासा किंवा 15-30 सेकंदांचा ब्रेक वाढवून तुलना करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jenis latihan stagnasi ialah menurunkan berat badan sekali dan mencapai jumlah yang ditetapkan, atau memperpanjang rehat selama 15 hingga 30 saat untuk membandingkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te controleren op stagnatie, verlaag dan het gewicht even en probeer het doel aantal keren te bereiken, of verleng de rust 15-30 seconden en vergelijk."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "For å finne ut om du er i en stagnasjonsfase, kan du prøve å redusere vekten én gang og justere antall repetisjoner, eller ta en pause på 15–30 sekunder og sammenligne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby sprawdzić, czy występuje stagnacja, spróbuj zmniejszyć wagę i doprowadzić do osiągnięcia docelowej liczby powtórzeń lub wydłuż 15–30 sekund przerwy i porównaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar se há estagnação, compare o número de repetições com o peso reduzido ou aumente o descanso em 15-30 segundos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para verificar se há estagnação, compare o número de repetições com o peso reduzido ou aumente o descanso em 15-30 segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a identifica posibilele stagnări, încearcă să reduci greutatea o dată și să ajustezi numărul de repetări sau să prelungești pauza cu 15-30 secunde pentru comparație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы определить, есть ли застой, сравните результаты после уменьшения веса до целевого уровня или увеличения времени отдыха на 15–30 секунд."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre kontrolu stagnácie skúste znížiť váhu na cieľovú hodnotu, alebo predĺžte pauzu o 15–30 sekúnd a porovnajte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite možnost, kjer boste enkrat zmanjšali težo in dosežili cilj, ali podaljšali počitek za 15–30 sekund in primerjali."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att kontrollera om du är i ett stillastående, jämför antingen genom att sänka vikten och justera antalet repetitioner eller genom att förlänga vilan med 15–30 sekunder."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தடையில்லைக்கான விருப்பங்கள், எடையை ஒருமுறை குறைத்து இலக்கு எண்ணிக்கையை அடைய அல்லது 15-30 வினாடிகள் ஓய்வு எடுத்து ஒப்பிடலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థిరత్వం కోసం, బరువును ఒకసారి తగ్గించి, లక్ష్య సంఖ్యను సరిచేయడానికి ప్రయత్నించండి లేదా 15-30 సెకన్ల పాటు విరామాన్ని పెంచి పోల్చండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกประเภทของการหยุดชะงัก โดยลองลดน้ำหนักลง แล้วเปรียบเทียบกับจำนวนครั้งที่ต้องการ หรือพักเป็นเวลา 15-30 วินาที แล้วเปรียบเทียบกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durum kontrolünde değerlendirmek için, ağırlığı bir kez düşürerek hedeflenen tekrar sayısını tamamlayın veya dinlenme süresini 15-30 saniye uzatarak karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть варіант \"перевірка на стагнацію\", щоб порівняти результати після зменшення ваги до цільового рівня або збільшення відпочинку на 15-30 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bài tập gợi ý để kiểm tra sự trì trệ: giảm trọng lượng một lần và đạt được số lần mục tiêu, hoặc kéo dài thời gian nghỉ 15-30 giây rồi so sánh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果怀疑停滞，可以尝试降低重量并达到目标次数，或者延长休息时间15-30秒进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停滞的建议项目：可以尝试降低重量，达到目标次数，或者延长休息时间15〜30秒进行比较。"
          }
        }
      }
    },
    "health_meals_body_ai.61184419aea8": {
      "comment": "GymTrainingApp/Features/Meals/MealListView.swift:555\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تنعكس الإضافات إلى قاعدة بيانات الأغذية والرموز الشريطية، والتغييرات في تناول الطعام الفعلي على الفور في المجموع. سيتم إضافة المواد الغذائية التي تم إدخالها بحرية بعد تقدير الذكاء الاصطناعي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les addicions a la base de dades d'aliments i als codis de barres, i els canvis en la ingesta real d'aliments es reflecteixen immediatament en el total. Els aliments introduïts lliurement es sumaran després de l'estimació de l'IA."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidávání a úprava množství potravin z databáze, včetně skenování čárových kódů, se automaticky aktualizuje. Potraviny, které jste zadali ručně, budou zahrnuty po odhadu pomocí AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj og opdater mængder af mad fra databasen, samt manuelt indtastede fødevarer. AI vil automatisk beregne det samlede forbrug baseret på dine input."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte aktualisieren Sie die Gesamtsumme, indem Sie Lebensmittel und Barcodes hinzufügen oder die Menge ändern. Lebensmittel, die Sie manuell eingegeben haben, werden nach der KI-Schätzung zusammengefasst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισάγετε και ενημερώστε αμέσως τη βάση δεδομένων τροφίμων και την ποσότητα που καταναλώσατε. Τα τρόφιμα που έχουν καταχωρηθεί χειροκίνητα θα συνυπολογιστούν μετά από εκτίμηση του AI."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically update the total with additions and changes to the food database and barcode entries. AI-estimated values will be added for free-entered foods."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically update the total with additions and changes to the food database and barcode entries. AI-estimated values will be added for free-entered foods."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically update the total with additions and changes to the food database and barcode entries. AI-estimated values will be added for free-entered foods."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically update the total with additions and changes to the food database and barcode entries. AI-estimated values will be added for free-entered foods."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza la suma con la adición y modificación de alimentos y códigos de barras. Los alimentos ingresados libremente se suman después de la estimación de IA."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza la suma con la adición y modificación de alimentos y códigos de barras. Los alimentos ingresados libremente se suman después de la estimación de IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää ja päivitä ruoka-tietokannan sekä skannerin avulla tallennettujen ruokien määriä automaattisesti. Vapaasti syötetyistä ruoista tehdään laskelma AI:n avulla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez et modifiez les quantités des aliments, ainsi que les codes-barres, pour obtenir un total instantané. Les aliments entrés manuellement seront ajoutés après une estimation par l'IA."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez et modifiez les quantités des aliments, ainsi que les codes-barres, pour obtenir un total instantané. Les aliments entrés manuellement seront ajoutés après une estimation par l'IA."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખોરાક ડેટાબેઝ અને બાર્કોડની ઉમેરણ તેમજ વાસ્તવિક વપરાશના જથ્થાને તાત્કાલિક સરવાળામાં સમાવિષ્ટ કરો. મુક્ત રીતે દાખલ કરેલા ખોરાકના આઈ-પૂર્વ સંભાવના પછી સરવાળો કરવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לסכם מיד את הוספת מזון ושינוי כמויות. מזונות שנרשמו באופן חופשי יסוכמו לאחר הערכת AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया खाद्य पदार्थों और बारकोड को तुरंत जोड़ें और वास्तविक मात्रा में बदलाव करें। AI द्वारा अनुमानित खाद्य पदार्थों को भी शामिल किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski ažurirajte ukupnu vrijednost dodavanjem i izmjenama količine hrane koju ste unijeli. Hrana unesena putem slobodne upute će se izračunati nakon procjene AI-a."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A<0} élelmiszer adatbázisba és a vonalkódokhoz tartozó adatokba azonnal be tudod írni, valamint módosítani az adatok mennyiségét. A szabadon megadott élelmiszereket az AI becslése után számoljuk össze."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara otomatis menghitung total dari penambahan dan perubahan jumlah makanan serta kode batang. Makanan yang dimasukkan secara manual akan dihitung setelah perkiraan AI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna immediatamente la somma con l'aggiunta e le modifiche delle quantità di alimenti inserite nel database. Gli alimenti inseriti manualmente saranno sommati dopo la stima dell'IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品DBとバーコードの追加・実食量変更をすぐ合計へ反映します。自由入力した食品はAI推定後に合算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식 DB와 바코드 추가 및 실제 섭취량 변경을 즉시 합산합니다. 자유롭게 입력한 음식은 AI 추정 후 합산합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खाद्यपदार्थ डेटाबेस आणि बारकोडची माहिती तसेच खाल्लेल्या पदार्थांची मात्रा त्वरित एकत्रित करा. तुम्ही स्वतःहून नोंदवलेले खाद्यपदार्थ, AI च्या अंदाजानुसार एकत्रित केले जातील."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertakan dan ubah jumlah makanan yang anda masukkan serta senaraikan kepada jumlah keseluruhan. Makanan yang anda masukkan secara bebas akan diseragamkan selepas anggaran oleh AI."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg voedsel en barcodes toe en pas de hoeveelheden aan. Voedsel dat u zelf invoert, wordt berekend na een AI-schatting."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til og endre mengde av mat i databasen, og få totaloppsummering umiddelbart. Mat som er lagt inn manuelt, vil bli regnet sammen etter at AI har estimert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast dodaj i zaktualizuj bazę danych produktów spożywczych oraz wpisz rzeczywistą ilość spożytych produktów. Produkty wprowadzone ręcznie zostaną uwzględnione po analizie przez sztuczną inteligencję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o total com a adição e alteração do volume consumido de alimentos, bem como da leitura de código de barras. Alimentos inseridos manualmente serão somados após a estimativa da IA."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o total com a adição e alteração do volume consumido de alimentos, bem como da leitura de código de barras. Alimentos inseridos manualmente serão somados após a estimativa da IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă rugăm să adăugați și să modificați cantitățile din baza de date a alimentelor și să le includeți în total. Alimentele introduse liber vor fi calculate după estimarea AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически объединяйте данные из базы данных продуктов и информацию о количестве съеденного. Продукты, введенные вручную, будут объединены после оценки ИИ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky aktualizujte celkové údaje, keď pridáte alebo upravíte položky v databáze potravín a skenovaním čiarového kódu. Potraviny, ktoré ste zadali ručne, budú automaticky zahrnuté po odhadovaní AI."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte in posodabljajte podatke o hrani ter količino užitke, ki ste vnesli. Hrano, ki ste vnesli ročno, bodo AI ocenila in združili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till och uppdatera matdatabasen samt justera mängder med hjälp av streckkod. Måltider som har fyllts i manuellt kommer att beräknas automatiskt efter AI-analys."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உணவுப் பொருள் தரவுத்தளத்தையும், பார் கோட்-ஐயும் உடனடியாகச் சேர்த்து, உள்ளீட்டு அளவுகளை மாற்றியமைக்கவும். நீங்கள் உள்ளீடு செய்த உணவுப் பொருட்களை, AI மூலம் மதிப்பிட்ட பிறகு சேர்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆహార డేటాబేస్ మరియు బార్‌కోడ్‌ను వెంటనే సేకరించి, వినియోగించిన మొత్తాన్ని అంచనా వేస్తుంది. మీరు స్వయంగా నమోదు చేసిన ఆహారాన్ని AI ద్వారా అంచనా వేసిన తర్వాత లెక్కిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมผลรวมการเพิ่ม/แก้ไขรายการอาหารและปริมาณที่ป้อนด้วยตนเอง โดยใช้ฐานข้อมูลอาหาร และสแกนบาร์โค้ด อาหารที่ป้อนด้วยตนเองจะถูกคำนวณโดย AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yiyecek veritabanına ve barkod bilgilerine ek olarak, yediğiniz miktarları hemen topla. Manuel olarak girilen yiyecekler, yapay zeka tarafından tahmin edilen değerlerle birleştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично обчислюйте суму, додаючи продукти та зміни в кількості. Продукти, введені вручну, будуть обчислені після оцінки AI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động cập nhật tổng số lượng từ cơ sở dữ liệu thực phẩm và thay đổi thông tin về thực phẩm đã nhập thủ công. Thực phẩm được nhập thủ công sẽ được tính toán sau khi AI ước tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将食品DB和条形码的添加以及实际食量更改立即反映到总计中。自由输入的食物将在AI估算后合并。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會立即將食物資料庫和條碼新增、以及實際食用的量進行總結。自由輸入的食物會在AI估算後進行總結。"
          }
        }
      }
    },
