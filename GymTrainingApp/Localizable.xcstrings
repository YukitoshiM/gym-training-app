          "stringUnit": {
            "state": "translated",
            "value": "Helyezd el egy lábadat a padra, és helyezd a tömeget a másikba"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menempatkan satu kaki di atas meja dan membungkuk dengan menumpangkan berat badan pada kaki lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggiare un piede dietro a una superficie e piegarsi in avanti con l'altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろ足を台に置き、前脚に体重を乗せてしゃがむ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒷다리를 의자에 둔 채, 앞다리에 체중을 실어 쪼그라들기."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पाय स्टूलवर ठेवून, दुसरा पाय खाली वाकवणे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan kaki belakang di atas permukaan, dan condong ke hadapan dengan memegang berat badan pada kaki depan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaats één been op een platform en buig voorover met het andere been"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasser det ene beinet på en plattform og legg vekten til det andre beinet for å bøye deg ned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postaw tylną stopę na podwyższeniu i opuść ciężar ciała na przednią nogę, opadając."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar o pé de trás no apoio e inclinar-se para frente, colocando o peso no anteparo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar o pé de trás no apoio e inclinar-se para frente, colocando o peso no anteparo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune piciorul din spate pe un suport și apleacă-te în față, punând greutatea pe antebrațe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставить одну ногу на опору и наклониться вперед, опираясь на переднюю ногу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavte si zadnú nohu na podstielku a nabehnite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite eno nogo na steno in se nagnete z drugo nogo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera ena foten på en pall och luta dig framåt med den andra foten"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்புற காலை ஒரு மேடையில் வைத்து, முன் காலை பயன்படுத்தி குனிந்து கொள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెనుక పాదాన్ని ఒక బల్లపై ఉంచి, ముందు కాళ్ళపై బరువును మోపుతూ కూర్చోవడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางเท้าข้างหนึ่งบนพื้น และก้มตัวโดยให้ส่วนบนของร่างกายรับน้ำหนัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka ayağı bir platforma yerleştirip, ön bacağın üzerine ağırlığı koyarak eğilme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте одну ногу на стійку і опуститься в кнур."
