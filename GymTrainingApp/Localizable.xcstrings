        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખરીદીની પ્રક્રિયા સમતલ થઈ રહી છે. પૂર્ણ થયા પછી આપોઆપ પ્રતિબિંબિત થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרכישה עדיין בתהליך אישור. יופיעו אוטומטית לאחר ההשלמה."
