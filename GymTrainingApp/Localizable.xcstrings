    "core_ui.d624960db5e8": {
      "comment": "GymTrainingApp/Features/Home/OmakaseHomeView.swift:231\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سأقوم بالتحقق من السجلات بمجرد أن أتمكن من التواصل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisaré els registres tan aviat com em pugui comunicar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po obnovení připojení zkontrolujeme záznamy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg vil kontrollere dine data, når forbindelsen er etableret."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufzeichnungen werden bei erfolgreicher Verbindung überprüft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα ελέγξουμε τις καταγραφές μόλις γίνει η σύνδεση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We will verify your records as soon as communication is established."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We will verify your records as soon as communication is established."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We will verify your records as soon as communication is established."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We will verify your records as soon as communication is established."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaré los datos una vez que se establezca la conexión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaré los datos una vez que se establezca la conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedon lähetyksen jälkeen tarkistetaan tallennetut tiedot."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données seront vérifiées dès que la connexion sera établie."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données seront vérifiées dès que la connexion sera établie."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે કનેક્શન થઈ જાય, ત્યારે તમે કરેલી પ્રવૃત્તિની માહિતી ચકાસી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני אבדוק את ההקלטות ברגע שהתקשורת תושג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संचार संभव होने पर, रिकॉर्ड की जांच की जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podat će se provjeriti nakon uspostave veze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amint az kapcsolat létrejön, ellenőrizzük az adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah koneksi tersedia, kami akan memverifikasi catatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificherò i dati non appena la connessione sarà disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信でき次第、記録を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통신이 가능하면 기록을 확인합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन झाल्यावर, नोंदी तपासा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklumat akan disahkan apabila sambungan tersedia."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De gegevens worden gecontroleerd zodra de verbinding is actief."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vil bekrefte registreringen når forbindelsen er opprettet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po nawiązaniu połączenia sprawdzę zapisane dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaremos o registo assim que a comunicação estiver ativa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaremos o registo assim que a comunicação estiver ativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Voi verifica înregistrarea odată ce conexiunea este stabilită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После успешной передачи, мы проверим ваши данные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po pripojení k internetu overíme vaše záznamy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko bo omogočena komunikacija, boste lahko preverili podatke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag kommer att kontrollera dina resultat när kommunikationen är aktiv."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைய இணைப்பு கிடைத்தவுடன், பதிவுகளைச் சரிபார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కనెక్ట్ అయిన తర్వాత, రికార్డులను తనిఖీ చేస్తాను."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะตรวจสอบข้อมูลเมื่อมีการเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İletişim sağlandığında, kayıtları kontrol edeceğiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після встановлення зв'язку, перевіримо записи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi kết nối, chúng tôi sẽ kiểm tra lại dữ liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到后，将记录确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到后，我们会确认记录。"
          }
        }
      }
    },
