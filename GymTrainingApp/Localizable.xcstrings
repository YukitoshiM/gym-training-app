    "core_ui.4bf044eb7319": {
      "comment": "GymTrainingApp/Features/Settings/ProfileSettingsView.swift:770\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه ليس تقييمًا للقدرة أو المؤهلات. أشر إلى وجهة نظرك المفضلة في إجابتك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No és una avaluació d'habilitats o qualificacions. Indica la teva perspectiva preferida a la teva resposta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejedná se o hodnocení schopností nebo kvalifikací. Uvádí priority, na které je třeba se zaměřit v odpovědích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en vurdering af evner eller kvalifikationer. Det angiver de aspekter, der prioriteres i svaret."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist keine Bewertung von Fähigkeiten oder Qualifikationen. Es zeigt die Prioritäten an, auf die bei der Beantwortung einzugehen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν πρόκειται για αξιολόγηση δεξιοτήτων ή προσόντων. Δείχνει τα κριτήρια που θα χρησιμοποιήσετε στις απαντήσεις σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not an evaluation of abilities or qualifications. It indicates the priorities to consider in your responses."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not an evaluation of abilities or qualifications. It indicates the priorities to consider in your responses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not an evaluation of abilities or qualifications. It indicates the priorities to consider in your responses."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not an evaluation of abilities or qualifications. It indicates the priorities to consider in your responses."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una evaluación de habilidades o calificaciones. Indica los criterios a priorizar en la respuesta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una evaluación de habilidades o calificaciones. Indica los criterios a priorizar en la respuesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei ole kykyjen tai pätevyyksien arvio. Esitämme, mitkä näkökohdat ovat tärkeitä vastauksissa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une évaluation des capacités ou des qualifications. Il s'agit d'indiquer les aspects prioritaires à considérer dans la réponse."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une évaluation des capacités ou des qualifications. Il s'agit d'indiquer les aspects prioritaires à considérer dans la réponse."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ક્ષમતા અથવા લાયકાતનું મૂલ્યાંકન નથી. જવાબોમાં પ્રાથમિકતા આપવા માટેના પરિપ્રેક્ષ્યો દર્શાવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה לא הערכה של יכולות או תעודות. הנה נקודות העדיפות בתשובה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी क्षमताओं या योग्यताओं का मूल्यांकन नहीं है। यह बताता है कि उत्तर में किन पहलुओं को प्राथमिकता दी जानी चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo nije procjena vještina ili kvalifikacija. Navodi se koje su točke važne za odgovor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez nem értékel egy képességet vagy képesítést. A válaszban megmutatja, hogy mely szempontokat kell figyelembe venni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan untuk mengevaluasi kemampuan atau kualifikasi. Menunjukkan perspektif yang akan diprioritaskan dalam jawaban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si tratta di valutare capacità o qualifiche. Indica i punti prioritari in base alle risposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "能力や資格の評価ではありません。回答で優先する観点を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "능력이나 자격 평가가 아닙니다. 답변에서 우선순위를 나타냅니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्षमता किंवा कौशल्यांचे मूल्यांकन नाही. उत्तरांमध्ये प्राधान्यक्रमावर आधारित दृष्टिकोन दर्शविला आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukanlah penilaian keupayaan atau kelayakan. Ia menunjukkan pandangan yang perlu diberi tumpuan dalam jawapan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is geen beoordeling van vaardigheden of certificeringen. De prioriteit wordt aangegeven op basis van de antwoorden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en vurdering av ferdigheter eller kvalifikasjoner. Vi viser hvilke aspekter som bør prioriteres i svaret."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie jest to ocena umiejętności ani kwalifikacji. Wskażane są priorytetowe kryteria w odpowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é uma avaliação de habilidades ou qualificações. Apresenta os pontos prioritários na resposta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é uma avaliação de habilidades ou qualificações. Apresenta os pontos prioritários na resposta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este o evaluare a abilităților sau calificărilor. Indicați punctele pe care le considerați importante în răspuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не оценка способностей или квалификации. Указывает приоритетные аспекты для рассмотрения в ответах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nie je hodnota vašich schopností alebo kvalifikácií. Uvádzame priority, ktoré by ste mali zvážiť pri odpovedi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ni ocena sposobnosti ali kvalifikacij. Navede, na katerih točkah je treba poudariti v odgovoru."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är inte en bedömning av förmågor eller kvalifikationer. Här anges de aspekter som prioriteras i svaret."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது உங்கள் திறன்கள் மற்றும் தகுதிகளை மதிப்பிடுவதற்கான கருவி அல்ல. பதிலில் நீங்கள் முக்கியமாகக் கருதுவது என்ன என்பதை இங்கே குறிப்பிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది మీ సామర్థ్యాలు లేదా అర్హతల అంచనా కాదు. సమాధానంలో ప్రాధాన్యత ఇవ్వాల్సిన అంశాలను తెలియజేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่การประเมินความสามารถหรือคุณสมบัติ กรุณาเลือกมุมมองที่จะให้ความสำคัญในการตอบกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, yetenek veya niteliklerin değerlendirmesi değildir. Cevaplarda önceliklendirilmesi gereken yönleri gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не оцінка ваших здібностей або кваліфікації. Вказує на пріоритетні критерії для відповіді."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây không phải là đánh giá về khả năng hoặc chứng chỉ. Chúng tôi sẽ trình bày các yếu tố ưu tiên trong câu trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不代表能力或资格评估。以下是优先考虑的观点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这并非对能力或资格的评估。以下是优先考虑的观点。"
          }
        }
      }
    },
