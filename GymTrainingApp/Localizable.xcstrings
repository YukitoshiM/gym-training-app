    "domain_catalog.9ce2b7c6a4ef": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:410\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ادعم جسمك بمرفقيك وقدميك وحافظ على وضعيتك حتى لا يسقط جسمك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolza el teu cos amb els colzes i els peus i mantén la postura perquè el cos no caigui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podepřete se lokty a chodidly, abyste udrželi rovnováhu a zabránili kolapsu těla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug albuerne og fødderne til at støtte kroppen, og opret en korrekt holdning, så kroppen ikke falder sammen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Stütze deinen Körper mit den Ellbogen und Füßen ab und halte eine stabile Haltung ein, sodass der Rücken nicht nach hinten kippt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στηρίξτε το σώμα σας με τους αγκώνες και τα πόδια, διατηρώντας μια σταθερή στάση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Support your body with your elbows and feet, maintaining a posture that prevents your torso from sagging."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Support your body with your elbows and feet, maintaining a posture that prevents your torso from sagging."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Support your body with your elbows and feet, maintaining a posture that prevents your torso from sagging."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Support your body with your elbows and feet, maintaining a posture that prevents your torso from sagging."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyar el cuerpo con los codos y los pies, manteniendo una postura que evite que se caiga hacia un lado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoyar el cuerpo con los codos y los pies, manteniendo una postura que evite que se caiga hacia un lado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tue itseäsi kyynärillä ja jaloilla, pidä vartalosi tasapainossa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Soutenez votre corps avec vos coudes et vos pieds, en maintenant une posture stable."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soutenez votre corps avec vos coudes et vos pieds, en maintenant une posture stable."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથ અને પગનો ઉપયોગ કરીને શરીરને ટેકો આપો, જેથી શરીર એક તરફ ન જાય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתמוך בגוף באמצעות הכתפיים והרגליים, ולשמור על יציבה שתמנע נפילה של הגב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी और पैरों का उपयोग करके शरीर को सहारा दें, ताकि आपका शरीर स्थिर रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržavajte tijelo rukama i nogama, održavajući položaj u kojem se tijelo ne naginje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A karokkal és lábakkal támogassa a testet, hogy ne dőljen le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan tubuh dengan siku dan kaki, serta menjaga posisi agar bagian samping tidak jatuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostieni il corpo con i gomiti e i piedi, mantenendo una postura che impedisca al corpo di cadere lateralmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘と足で体を支え、体側が落ちないように姿勢を保つ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔꿈치와 발로 몸을 지지하며, 몸이 옆으로 쏠리지 않도록 자세를 유지합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हातांच्या आणि पायांच्या साहाय्याने शरीराला आधार द्या, ज्यामुळे शरीर एका बाजूला झुकणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menahan badan dengan siku dan kaki, serta mengekalkan postur agar bahagian sisi tidak jatuh."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je ellebogen en voeten om jezelf stabiel te houden, en zorg ervoor dat je lichaam niet naar één kant leunt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Støtt kroppen med albuene og føttene, og oppretthold en god holdning slik at den ikke faller sammen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj równowagę, opierając się na łokciach i stopach, aby uniknąć przewrócenia się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os cotovelos e os pés para se apoiar, mantendo a postura correta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os cotovelos e os pés para se apoiar, mantendo a postura correta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprijină-te cu antebrațele și picioarele pentru a menține echilibrul și postura corectă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте тело руками и ногами, сохраняя правильную осанку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte telo pomocou lakťov a nôh, aby sa nepohybovalo. Udržujte správnu polohu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte položaj rok, da se telo ne nagiba, ter ohranjajte pravilno držo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöd kroppen med armbågar och fötter, och behåll en korrekt hållning så att den inte sjunker ihop."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை மடக்கி, உடலின் பக்கவாட்டில் சமநிலையை பராமரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులు మరియు కాళ్ళతో శరీరాన్ని సపోర్ట్ చేయడం, శరీరం కదలకుండా ఉండేలా భంగిమను నిలుపుకోవడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ข้อศอกและเท้าในการประคองร่างกาย และรักษาท่าทางเพื่อให้ร่างกายไม่เสียสมดุล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirsekleriniz ve ayaklarınızla vücudunuzu destekleyin, böylece vücudunuzun yan tarafı düşmemeli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуйте тіло руками та ногами, зберігаючи правильну поставу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng khuỷu tay và chân để giữ thăng bằng, duy trì tư thế đúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手臂和脚支撑身体，保持身体侧部不弯曲"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手臂和腳支撐身體，並保持正確姿勢"
          }
        }
      }
    },
