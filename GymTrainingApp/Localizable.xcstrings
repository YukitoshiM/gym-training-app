          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünümü, beli ve kas dengesini iyileştir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поліпшуйте зовнішній вигляд, талію та м’язовий баланс"
