            "state": "translated",
            "value": "L'apprentissage est en pause. Vos anciennes données n'ont pas été supprimées."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શીખવું થોભાવ્યું છે. તમારા જૂના રેકોર્ડ કાઢી નાખવામાં આવ્યા નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלמידה מושהית. הרישומים הקודמים שלך לא נמחקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीखना रुका हुआ है। आपके पुराने रिकॉर्ड हटाए नहीं गए हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Učenje je pauzirano. Vaši prethodni zapisi nisu izbrisani."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tanulás szünetel. A korábbi bejegyzéseid nem lettek törölve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran dijeda. Catatan lama Anda tidak dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apprendimento è in pausa. I dati precedenti non sono stati eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習は停止中です。過去の記録自体は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "학습이 일시 중지되었습니다. 이전 기록은 삭제되지 않았습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शिकणे थांबवले आहे. तुमच्या जुन्या नोंदी हटवलेल्या नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelajaran dijeda. Rekod lama anda tidak dipadamkan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Leren is gepauzeerd. Je eerdere registraties zijn niet verwijderd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Læring er satt på pause. Tidligere registreringer er ikke slettet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauka jest wstrzymana. Twoje wcześniejsze wpisy nie zostały usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aprendizado está pausado. Seus registros anteriores não foram excluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O aprendizado está pausado. Os seus registos anteriores não foram excluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învățarea este întreruptă. Înregistrările anterioare nu au fost șterse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обучение приостановлено. Предыдущие записи не удалены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Učenie je pozastavené. Vaše predchádzajúce záznamy neboli vymazané."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Učenje je začasno ustavljeno. Vaši prejšnji vnosi niso bili izbrisani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inlärningen är pausad. Dina tidigare poster har inte raderats."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கற்றல் இடைநிறுத்தப்பட்டுள்ளது. உங்கள் பழைய பதிவுகள் நீக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేర్చుకోవడం నిలిపివేయబడింది. మీ పాత రికార్డులు తొలగించబడలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเรียนรู้หยุดชั่วคราว บันทึกที่ผ่านมาไม่ได้ถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğrenme duraklatıldı. Geçmiş kayıtların silinmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навчання призупинено. Попередні записи не видалено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc học đang tạm dừng. Dữ liệu trước đây của bạn chưa bị xóa."
