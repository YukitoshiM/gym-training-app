    "health_meals_body_ai.2494cf2da9de": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift:148\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\nmr: NLLB fallback used because TranslateGemma mixed writing systems; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا اقتراح يعتمد على الاتجاهات في البيانات المدخلة وليس تشخيصًا طبيًا. إذا كنت قلقًا بشأن صحتك أو ألمك، فيرجى استشارة أحد المتخصصين."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest és un suggeriment basat en les tendències de les dades d'entrada i no és un diagnòstic mèdic. Si us preocupa la vostra salut o el vostre dolor, consulteu un especialista."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato doporučení jsou založena na zadaných datech a nejsou lékařskou diagnózou. Pokud máte obavy ohledně svého zdraví nebo bolesti, poraďte se s odborníkem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslag baseret på inputdata er ikke en medicinsk diagnose. Hvis du er bekymret for din helbred eller smerter, skal du kontakte en fagperson."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind Vorschläge basierend auf den Eingabedaten und stellen keine medizinische Diagnose dar. Wenn Sie Bedenken bezüglich Ihrer Gesundheit oder Schmerzen haben, wenden Sie sich bitte an einen Fachmann."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προτάσεις βασίζονται στις τάσεις των δεδομένων εισόδου και δεν αποτελούν ιατρική διάγνωση. Εάν έχετε ανησυχίες σχετικά με την υγεία σας ή τον πόνο, συμβουλευτείτε έναν ειδικό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a suggestion based on the input data, but it is not a medical diagnosis. If you have any concerns about your health or pain, please consult with a professional."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a suggestion based on the input data, but it is not a medical diagnosis. If you have any concerns about your health or pain, please consult with a professional."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a suggestion based on the input data, but it is not a medical diagnosis. If you have any concerns about your health or pain, please consult with a professional."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a suggestion based on the input data, but it is not a medical diagnosis. If you have any concerns about your health or pain, please consult with a professional."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una sugerencia basada en los datos introducidos, y no constituye un diagnóstico médico. Si tiene dudas sobre su estado de salud o dolor, consulte a un profesional."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una sugerencia basada en los datos introducidos, y no constituye un diagnóstico médico. Si tiene dudas sobre su estado de salud o dolor, consulte a un profesional."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä ovat ehdotuksia, jotka perustuvat syötetyn datan trendeihin. Ne eivät ole lääketieteellisiä diagnooseja. Jos sinulla on huolia terveydestäsi tai kivuista, ota yhteyttä ammattilaiseen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces suggestions sont basées sur les données saisies et ne constituent pas un avis médical. Si vous avez des inquiétudes concernant votre état de santé ou vos douleurs, veuillez consulter un professionnel."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces suggestions sont basées sur les données saisies et ne constituent pas un avis médical. Si vous avez des inquiétudes concernant votre état de santé ou vos douleurs, veuillez consulter un professionnel."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઇનપુટ ડેટાના આધારે ભલામણો, પરંતુ તે તબીબી નિદાન નથી. જો તમને સ્વાસ્થ્ય અથવા દુખાવાની ચિંતા હોય, તો કૃપા કરીને કોઈ નિષ્ણાતની સલાહ લો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההמלצות מבוססות על מגמות הנתונים הקלט, ואינן מהוות אבחנה רפואית. אם יש לך חששות לגבי מצב הבריאות או כאבים, התייעץ עם איש מקצוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चिकित्सा निदान नहीं है, बल्कि इनपुट डेटा के रुझानों पर आधारित सुझाव हैं। यदि आपको स्वास्थ्य या दर्द के बारे में कोई चिंता है, तो कृपया किसी विशेषज्ञ से सलाह लें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo su preporuke temeljem trendova u ulaznim podacima, a nisu medicinska dijagnoza. Ako imate pitanja o svom zdravlju ili boli, obratite se stručnjaku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a javaslat az beépített adatok alapján készült, de nem orvosi diagnózis. Ha bármilyen egészségügyi problémád van, kérjük, fordulj szakemberhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah saran berdasarkan tren data yang diinput, bukan diagnosis medis. Jika Anda merasa khawatir tentang kondisi kesehatan atau rasa sakit, konsultasikan dengan ahli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono solo suggerimenti basati sui dati inseriti e non costituiscono una diagnosi medica. Se hai dubbi sulla tua salute o sul dolore, consulta un professionista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力データの傾向をもとにした提案で、医療上の診断ではありません。体調や痛みに不安がある場合は専門家へ相談してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 데이터의 경향을 바탕으로 제안하며, 이는 의학적 진단이 아닙니다. 건강 상태나 통증에 대해 걱정이 있다면 전문가와 상담하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आणि हा एक वैद्यकीय निदान नाही, जो प्रवृत्तीवर आधारित आहे. जर तुम्हाला तुमच्या आरोग्याबद्दल किंवा वेदनांबद्दल चिंता असेल तर तुम्ही तज्ज्ञांशी संपर्क साधा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan berdasarkan trend data masukan, tetapi bukan diagnosis perubatan. Jika anda mempunyai kebimbangan tentang kesihatan atau sakit, sila berunding dengan pakar."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn suggesties op basis van uw invoergegevens, maar geen medisch advies. Als u zich zorgen maakt over uw gezondheid of pijn, raadpleeg dan een specialist."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en medisinsk diagnose, men et forslag basert på inndataene dine. Hvis du er bekymret for helsen din eller har smerter, bør du kontakte en fagperson."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponowane rozwiązania oparte na trendach w danych wejściowych, a nie stanowią diagnozy medycznej. Jeśli masz wątpliwości dotyczące stanu zdrowia lub bólu, skonsultuj się ze specjalistą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma sugestão baseada nos dados inseridos e não constitui um diagnóstico médico. Se você tiver dúvidas sobre sua saúde ou dor, consulte um profissional."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma sugestão baseada nos dados inseridos e não constitui um diagnóstico médico. Se você tiver dúvidas sobre sua saúde ou dor, consulte um profissional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt sugestii bazate pe datele introduse și nu reprezintă un diagnostic medical. Dacă ai nelămuriri legate de starea ta de sănătate sau durere, consultă un specialist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не медицинская консультация, а предложение, основанное на тенденциях введенных данных. Если у вас есть опасения по поводу здоровья или боли, обратитесь к специалисту."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto návrhy vychádzajú z trendu vstupných údajov a nie sú lekárskou diagnostikou. Ak máte obavy ohľadom vášho zdravia, poraďte sa so špecialistom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predlagane vrednosti, ki temeljijo na vnosu podatkov, niso medicinska diagnoza. Če imate skrbi glede zdravja ali bolečin, se posvetujte s specialistom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är inte en medicinsk diagnos, utan ett förslag baserat på inmatad data. Om du har oro över din hälsa eller smärta, kontakta en läkare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளீட்டுத் தரவின் அடிப்படையில் பரிந்துரைகள், இது மருத்துவ ஆலோசனை அல்ல. உடல்நிலை அல்லது வலி குறித்து ஏதேனும் சந்தேகம் இருந்தால், ஒரு நிபுணரை அணுகவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వైద్యపరమైన నిర్ధారణ కాదు, ఇన్‌పుట్ డేటా ఆధారంగా సూచనలు ఇవ్వబడ్డాయి. మీకు ఆరోగ్యం లేదా నొప్పి గురించి ఆందోళన ఉంటే, దయచేసి నిపుణుడిని సంప్రదించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแนะนำตามแนวโน้มของข้อมูลที่ป้อน ซึ่งไม่ใช่การวินิจฉัยทางการแพทย์ หากมีข้อกังวลเกี่ยวกับสุขภาพหรืออาการ ควรปรึกษาผู้เชี่ยวชาญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öneriler, tıbbi teşhis değildir ve girdi verisinin eğilimlerine dayanmaktadır. Vücudunuzda veya ağrınızda herhangi bir sorun varsa, lütfen bir uzmana danışın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не медична консультація, а рекомендація на основі тенденцій вхідних даних. Якщо у вас є сумніви щодо вашого самопочуття або болю, зверніться до фахівця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là đề xuất dựa trên xu hướng dữ liệu đầu vào, không phải là chẩn đoán y tế. Nếu bạn có bất kỳ lo ngại nào về sức khỏe hoặc cơn đau, hãy tham khảo ý kiến chuyên gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于输入数据的建议，不构成医疗诊断。如果对身体状况或疼痛有疑问，请咨询专业人士。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基于输入数据的建议，不属于医疗诊断。如果对身体状况或疼痛有疑问，请咨询专业人士。"
          }
        }
      }
    },
