    "health_meals_body_ai.b2e71d0a9bc5": {
      "comment": "GymTrainingApp/Data/HealthDataManager.swift:246\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط كالمعتاد أثناء النظر إلى RPE."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusteu-vos com de costum mentre mireu RPE."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobte si RPE podle běžných hodnot, ale také s ohledem na zvuk a délku trvání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster i forhold til din normale RPE (Rate of Perceived Exertion)."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie Ihren RPE (Rate of Perceived Exertion) an, wie gewohnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρυθμίστε το RPE σας σύμφωνα με τις συνήθεις τιμές."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust your RPE as usual, using it as a guide."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust your RPE as usual, using it as a guide."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust your RPE as usual, using it as a guide."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust your RPE as usual, using it as a guide."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste según sea necesario, utilizando la escala RPE (escala de percepción del esfuerzo)."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste según sea necesario, utilizando la escala RPE (escala de percepción del esfuerzo)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädä RPE:n avulla, kuten normaalisti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez en fonction de votre ressenti habituel (échelle RPE)."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez en fonction de votre ressenti habituel (échelle RPE)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સામાન્ય રીતે, RPE (Rate of Perceived Exertion) નો ઉપયોગ કરીને તમારી પ્રવૃત્તિને સમાયોજિત કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התאימו את הרמות לפי RPE (ציון מאמץ)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सामान्य आदतों के अनुसार, RPE को ध्यान में रखते हुए समायोजित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prilagodite RPE (skalicu subjektivnog doživljaja napor) prema vašim navikama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a szokásos értéket, és figyelembe véve az RPE-t, állítsa be a megfelelő szintet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan RPE Anda sesuai dengan kondisi normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola in base al tuo livello di percezione dello sforzo (RPE), come al solito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段どおりを目安に、RPEを見ながら調整しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소와 같이 RPE를 참고하여 조절하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपल्या नेहमीच्या वेळेनुसार, RPE (Rate of Perceived Exertion) वापरून आवश्यक बदल करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesuaikan dengan RPE seperti biasa."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas uw RPE (Rate of Perceived Exertion) aan op basis van uw normale activiteitenniveau."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Juster RPE (Rate of Perceived Exertion) basert på dine vanlige aktiviteter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj RPE zgodnie z Twoimi zwyczajami, ale pamiętaj o tym, aby nie przeciążać się."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste conforme sua rotina habitual, utilizando a escala RPE como referência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste conforme sua rotina habitual, utilizando a escala RPE como referência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustați nivelul RPE (percepția efortului) în funcție de situația dumneavoastră, așa cum faceți de obicei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ориентируйтесь на свои обычные ощущения и корректируйте RPE (шкалу воспринимаемой нагрузки)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prispôsobte sa RPE (scale of perceived exertion), ako je zvyčajne, a upravujte podľa toho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite RPE kot vodilo in prilagujte glede na običajno aktivnost."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd RPE som riktmärke och justera efter behov."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதாரணமாக, RPE-ஐ பயன்படுத்தி சரிசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాధారణంగా ఉన్నప్పుడు, RPE ఆధారంగా సర్దుబాటు చేసుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับตามปกติ โดยใช้ RPE เป็นแนวทาง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalde olduğu gibi, RPE'yi göz önünde bulundurarak ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте як орієнтир і коригуйте відповідно до шкали RPE (Rate of Perceived Exertion)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh theo mục tiêu thông thường, đồng thời tham khảo giá trị RPE."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据平时情况，参考RPE值进行调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根据平时情况，参考RPE值进行调整。"
          }
        }
      }
    },
