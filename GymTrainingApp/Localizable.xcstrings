            "state": "translated",
            "value": "Nu există date zilnice comparabile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет данных для сравнения за день"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neexistujú porovnateľné denné dáta"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niso na voljo dnevni podatki za primerjavo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga dagliga data finns för jämförelse"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒப்பிட்டுப் பார்க்கக்கூடிய தினசரி தரவு எதுவும் இல்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పోల్చడానికి తగిన రోజువారీ డేటా లేదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีข้อมูลประจำวันที่สามารถเปรียบเทียบได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırabileceğiniz günlük veriler bulunmuyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає даних для порівняння за одним днем"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có dữ liệu hàng ngày nào để so sánh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可比较的日间数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可比較的每日數據。"
          }
        }
      }
    },
    "health_meals_body_ai.4c7bd8cd9b27": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:530\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتجميع الجزء الأمامي والجانبي والخلفي وما إلى ذلك في نفس اليوم. يمكنك حفظ حتى صورة واحدة وإضافة المزيد لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupeu la part davantera, lateral, posterior, etc. el mateix dia. Podeu desar fins i tot una imatge i afegir-ne més més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete seskupovat údaje z jednoho dne (přední, boční, zadní atd.). Uložení je možné i s jedním záznamem a později jej můžete doplnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samler for, side og bag på samme dag. Kan gemmes individuelt, og kan tilføjes senere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Daten für einen Tag zusammenfassen (z.B. Vorderseite, Seite, Rückseite). Sie können auch einzelne Datensätze speichern und später hinzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ομαδοποιώ τις μετρήσεις (μπροστά, τα πλάγια, πίσω κ.λπ.) στην ίδια ημέρα. Μπορείτε να αποθηκεύσετε και μία μόνο μέτρηση και να την προσθέσετε αργότερα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine front, side, and back views on the same day. You can save even one entry, and add more later."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine front, side, and back views on the same day. You can save even one entry, and add more later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine front, side, and back views on the same day. You can save even one entry, and add more later."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine front, side, and back views on the same day. You can save even one entry, and add more later."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina datos diarios, como vistas frontal, lateral y trasera. Puedes guardarlos individualmente y añadirlos más tarde."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina datos diarios, como vistas frontal, lateral y trasera. Puedes guardarlos individualmente y añadirlos más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistän päivittäiset tiedot. Voit tallentaa yhden tai useamman tiedon ja lisätä niitä myöhemmin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez les données du même jour : avant, latéral, arrière. Vous pouvez enregistrer une seule fois et ajouter des informations ultérieurement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez les données du même jour : avant, latéral, arrière. Vous pouvez enregistrer une seule fois et ajouter des informations ultérieurement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું સમાન દિવસે આગળ, બાજુ અને પાછળની માહિતી એકસાથે રાખી શકું છું. હું તેને એક જ વાર સાચવી શકું છું અને પછીથી તેમાં ઉમેરી પણ શકું છું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לאחד את הצד, הירך והגב באותו יום. ניתן לשמור גם אם יש רק רשומה אחת, ואפשר להוסיף עוד מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही दिन में आगे, बगल और पीछे आदि को एकत्रित करें। आप इसे एक बार सहेज सकते हैं और बाद में इसमें अतिरिक्त जानकारी भी जोड़ सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sastavljam dane u jedan zapis. Možete spremiti čak i jedan zapis i dodati više kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonos napokban rögzítve. Egyetlen bejegyzést is menthetünk, majd később hozzáadhatunk még."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggabungkan data harian, seperti bagian depan, samping, dan belakang. Dapat disimpan dalam satu file, dan dapat ditambahkan nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso raggruppare dati giornalieri, come misurazioni frontali, laterali e posteriori. Posso salvare anche una singola misurazione e aggiungerla in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正面・横・背面などを同じ日にまとめます。1枚でも保存でき、後から追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전면, 측면, 후면 등을 같은 날에 묶어 기록합니다. 한 장만 저장 가능하며, 나중에 추가할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समोर, बाजू आणि मागच्या बाजू इत्यादी एकाच दिवसात एकत्रित केली. १ एंट्री सेव्ह करता येते आणि नंतर ती ॲड करता येते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengumpul bahagian depan, sisi, belakang, dll. pada hari yang sama. Anda boleh menyimpan satu sahaja, dan menambah lagi kemudian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dagelijkse gegevens samenvoegen. Je kunt ze apart opslaan en later toevoegen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg samler for-, side- og baksidesmålinger på samme dag. Du kan lagre den, og legge til flere senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz zgrupować dane z tego samego dnia. Możesz zapisać pojedynczy wpis i dodać go później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe informações como \"frente\", \"lateral\" e \"trás\" no mesmo dia. Você pode salvar individualmente e adicionar mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe informações como \"frente\", \"lateral\" e \"trás\" no mesmo dia. Você pode salvar individualmente e adicionar mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot combina față, lateral și spate într-o singură înregistrare. Poți salva chiar și o singură înregistrare și să adaugi mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяю данные за один день (спереди, сбоку, сзади и т.д.). Можно сохранить в одном файле и добавить позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenávame údaje pre jeden deň (predná, bočná, zadná strana). Môžete uložiť aj jednotlivé záznamy a neskôr ich pridávať."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sodelam podatke za en dan. Lahko shranim tudi posamezne dne, nato pa jih dodam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanfatta fram, sida och baksida på samma dag. Du kan spara även om du bara har en, och lägga till fler senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நாளில் முன்புற, பக்கவாட்டு, பின்புறம் போன்றவற்றை ஒன்றாகப் பதிவு செய்யலாம். ஒரு முறை பதிவு செய்தாலும், பின்னர் சேர்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందు, పక్క, వెనుక మొదలైన వాటిని ఒకే రోజులో సేకరించవచ్చు. ఒకేసారి సేవ్ చేసుకోవచ్చు మరియు తరువాత అదనంగా కూడా చేర్చవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวบรวมข้อมูล เช่น ด้านหน้า, ด้านข้าง, ด้านหลัง ในวันเดียวกัน สามารถบันทึกลงได้ แม้เพียง 1 ครั้ง และสามารถเพิ่มภายหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön, yan ve arka gibi değerleri aynı güne göre toplayabilirsiniz. Tek bir kaydla kaydedebilir ve daha sonra ekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збираю дані для одного дня (перед, бік, спина тощо). Можна зберегти окремо, а потім додати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổng hợp các thông tin như phía trước, hai bên, phía sau vào cùng một ngày. Bạn có thể lưu trữ ngay cả khi chỉ có một mục, và thêm vào sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将正面、横向、背面等数据整理到同一天。即使只有一张照片也可以保存，并且可以后续添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将正面、侧面、背面等整理成同一天。即使只有一张照片也可以保存，之后还可以添加。"
          }
        }
      }
    },
