    "training.16261933d5eb": {
      "comment": "GymTrainingApp/Features/Plans/PlanEditorView.swift:373\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعديل الوزن وعدد التكرارات بناءً على الإنجازات السابقة. تأكيد وحفظ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El pes i el nombre de repeticions s'han ajustat en funció dels assoliments anteriors. Confirmeu i deseu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujeme váhu a počet opakování na základě dosavadních výsledků. Potvrďte a uložte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Justerer vægt og antal baseret på tidligere resultater. Bekræft og gem."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich passe Gewicht und Anzahl anhand Ihrer bisherigen Erfolge an. Bitte überprüfen und speichern Sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρύθμιζετε το βάρος και τον αριθμό επαναλήψεων με βάση τις προηγούμενες επιτυχίες σας. Επιβεβαιώστε και αποθηκεύστε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusting weight and repetitions based on your past achievements. Please confirm and save."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusting weight and repetitions based on your past achievements. Please confirm and save."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusting weight and repetitions based on your past achievements. Please confirm and save."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusting weight and repetitions based on your past achievements. Please confirm and save."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ajusta el peso y la cantidad en función de tus logros anteriores. Confirma y guarda."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ajusta el peso y la cantidad en función de tus logros anteriores. Confirma y guarda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säädetään painoa ja toistoja aiemman edistymisen perusteella. Tarkista ja tallenna."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustement du poids et du nombre en fonction des réalisations antérieures. Vérifiez et enregistrez."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustement du poids et du nombre en fonction des réalisations antérieures. Vérifiez et enregistrez."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અગાઉની સફળતાના આધારે વજન અને પુનરાવર્તનોને સમાયોજિત કરી રહ્યા છીએ. ચકાસો અને સાચવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתאים את המשקל והמספר בהתבסס על ההישגים הקודמים. בדוק ושמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले प्रदर्शन के आधार पर वजन और बार की संख्या को समायोजित कर रहे हैं। जांच करें और सहेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustiramo težinu i broj po prethodnim postignućima. Potvrdite i spremite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A korábbi eredmények alapján a súlyt és a számokat beállítom. Ellenőrizze, majd mentse el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyesuaikan berat dan jumlah berdasarkan pencapaian sebelumnya. Konfirmasi dan simpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola peso e numero in base ai risultati precedenti. Conferma e salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の達成状況から重量・回数を調整しています。確認して保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 달성 상황을 바탕으로 무게 및 횟수를 조정합니다. 확인하고 저장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील कामगिरीनुसार वजन आणि पुनरावृत्ती समायोजित करत आहे. कृपया तपासा आणि जतन करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyesuaikan berat dan jumlah berdasarkan prestasi sebelumnya. Sila semak dan simpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanpassing van gewicht en aantal op basis van eerdere resultaten. Controleer en sla op."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Justerer vekt og antall basert på tidligere resultater. Bekreft og lagre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosowuję wagi i liczb powtór na podstawie wcześniejszych osiągnięć. Potwierdź i zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustando peso e número com base nos resultados anteriores. Confirme e salve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustando peso e número com base nos resultados anteriores. Confirme e salve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez greutatea și numărul de repetări în funcție de rezultatele anterioare. Verific și salvez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основываясь на прошлых достижениях, корректируется вес и количество повторений. Подтвердите и сохраните."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava váhy a počtu opakovaní na základe dosiahnutých výsledkov. Potvrďte a uložte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urejanje teže in števila ponovitev glede na prejšnje dosežke. Potrdite in shranite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Justerar vikt och antal baserat på tidigare framgång. Kontrollera och spara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த கால சாதனைகளின் அடிப்படையில் எடை மற்றும் எண்ணிக்கையை சரிசெய்கிறோம். சரிபார்த்து சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గతంలో సాధించిన ఫలితాల నుండి బరువు మరియు సార్లు సర్దుబాటు చేస్తున్నాము. ధృవీకరించు మరియు సేవ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับน้ำหนักและจำนวนครั้งจากผลการทำในอดีต ตรวจสอบและบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş başarılarınızdan ağırlık ve tekrar sayısını ayarlıyoruz. Kontrol edin ve kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На основі попередніх досягнень коригуємо вагу та кількість повторень. Перевірте та збережіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh trọng lượng và số lần dựa trên kết quả trước. Xác nhận và lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据您之前的完成情况，我们已调整了重量和次数。请确认并保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據過去的達成情況調整重量和次數。確認後儲存。"
          }
        }
      }
    },
