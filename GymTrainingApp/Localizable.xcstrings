          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Da der letzte Messwert schon länger zurückliegt, wird keine eindeutige Veränderung festgestellt. Es handelt sich um eine Schätzung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λόγω του χρονικού διαστήματος που έχει περάσει από την τελευταία μέτρηση, δεν μπορούμε να επιβεβαιώσουμε τις αλλαγές και παρέχουμε ένα εύρος τιμών."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to the passage of time since the last measurement, changes are estimated with a margin."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Due to the passage of time since the last measurement, changes are estimated with a margin."
          }
        },
