      "comment": "GymTrainingApp/Features/Record/RecordHubView.swift:114\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بخطة أو قم بإضافة الأحداث وتسجيلها بسرعة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenceu amb un pla o afegiu i enregistreu esdeveniments sobre la marxa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete začít s plánem nebo přidat kategorie a zaznamenávat je přímo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med en plan, eller tilføj øvelser på stedet og noter dem."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie mit dem Plan oder fügen Sie Aktivitäten direkt hinzu und speichern Sie diese."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε από το πλάνο ή προσθέστε δραστηριότητες και καταγράψτε τις αμέσως."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Start tracking from your plan, or add exercises on the go."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Start tracking from your plan, or add exercises on the go."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Start tracking from your plan, or add exercises on the go."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Start tracking from your plan, or add exercises on the go."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza desde el plan o añade categorías en el momento y registra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Comienza desde el plan o añade categorías en el momento y registra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita suunnitelmasta tai lisää aktiviteetteja ja kirjaa ne heti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec le plan ou ajoutez des catégories sur place et enregistrez-les."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec le plan ou ajoutez des catégories sur place et enregistrez-les."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "યોજનાથી શરૂઆત કરો અથવા તરત જ પ્રવૃત્તિ ઉમેરીને રેકોર્ડ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל מהתוכנית או הוסף מאפיינים ותעד בזמן אמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना से शुरू करें या मौके पर आइटम जोड़कर रिकॉर्ड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Počnite s planom ili dodajte aktivnost na mjestu i zapamtite je."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elindíthatja a tervet, vagy azonnal hozzáadhatja az elemeket és rögzítheti őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari rencana atau tambahkan kategori di tempat untuk dicatat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con il piano o aggiungi categorie al volo e registra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画から開始するか、その場で種目を追加して記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획에서 시작하거나, 즉시 항목을 추가하여 기록합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "योजनेतून सुरुवात करा किंवा त्वरित पर्याय जोडा आणि रेकॉर्ड करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan rencana atau tambahkan kategori di tempat tersebut dan catat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met de planning of voeg activiteiten direct toe en registreer deze."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Start med en plan eller legg til aktiviteter på stedet og registrer dem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz rozpocząć od planu lub dodać kategorie na bieżąco i zapisać je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia a partir do plano ou adiciona categorias no momento e registra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia a partir do plano ou adiciona categorias no momento e registra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți de la plan sau adăugați exerciții direct și înregistrați-le."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с плана или добавьте данные на месте и запишите их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s plánom alebo pridajte nové aktivity a zaznamenávajte ich."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Začnite s načrtom ali dodajte dejavnost na mestu in zabeležite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta från planen eller lägg till aktiviteter direkt och spara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டத்தில் இருந்து தொடங்கலாம் அல்லது உடனடியாக செயல்பாடுகளைச் சேர்த்து பதிவு செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రణాళికతో ప్రారంభించండి లేదా వెంటనే అంశాలను జోడించి రికార్డ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มต้นจากแผน หรือเพิ่มประเภทในขณะนั้นแล้วบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planla başlayın veya anında kategorileri ekleyip kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть з плану або додайте категорії на місці та записуйте їх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu từ kế hoạch hoặc thêm danh mục ngay tại đây để ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从计划开始，或在现场添加并记录项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "从计划开始，或在现场添加并记录项目。"
          }
        }
      }
