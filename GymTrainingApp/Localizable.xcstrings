    "domain_catalog.8a82058b0b4a": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:31\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الألم ورد الفعل بعد التقطيع وأعد الحمل تدريجيًا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comproveu el dolor i la reacció després de l'obturació i retorneu gradualment la càrrega"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte bolest a reakce po tréninku a postupně zvyšujte zátěž."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft smerten og reaktionen efter træningen, og øg belastningen gradvist."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfe die Schmerzen und Reaktionen nach dem Ausgangszustand und passe das Gewicht schrittweise an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε τον πόνο και την αντίδραση μετά την άσκηση και αυξήστε σταδιακά το βάρος"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for pain and assess your reaction after the break, then gradually increase the load."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for pain and assess your reaction after the break, then gradually increase the load."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for pain and assess your reaction after the break, then gradually increase the load."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for pain and assess your reaction after the break, then gradually increase the load."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar el dolor y la reacción después de comenzar, y aumentar gradualmente la carga."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar el dolor y la reacción después de comenzar, y aumentar gradualmente la carga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista kipu ja reaktio, kun olet palannut, ja lisää kuormaa asteittain"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la douleur et les sensations après l'exercice, puis augmentez progressivement la charge."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la douleur et les sensations après l'exercice, puis augmentez progressivement la charge."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખાલી જગ્યા પછીના દુખાવો અને પ્રતિક્રિયા તપાસો, અને ધીમે ધીમે ભાર વધારો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את הכאבים והתגובה לאחר הפעילות, והגדל בהדרגה את העומס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली करने के बाद दर्द और प्रतिक्रिया की जांच करें, और धीरे-धीरे वजन बढ़ाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite i potvrdite bol i reakciju nakon prvog treninga, a zatim postupno povećavajte optereženje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd a fájdalmat és reakciót a terhelés után, és fokozatosan növeld"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa rasa sakit dan reaksi setelah latihan, lalu tingkatkan beban secara bertahap"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifico il dolore e la reazione dopo l'allenamento, aumentando gradualmente il carico"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランク後の痛みと反応を確認し、負荷を段階的に戻す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 상태 이후의 통증과 반응을 확인하고, 점진적으로 강도를 높임"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवात केल्यानंतर होणारी वेदना आणि प्रतिक्रियांची तपासणी करा, आणि हळूहळू भार वाढवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa sakit dan reaksi selepas latihan, kemudian tingkatkan beban secara bertahap"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de pijn en reactie na het herstel, en verhoog de belasting geleidelijk."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft smerte og reaksjon etter null belastning, og øk belastningen gradvis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź ból i reakcję po ćwiczeniu, a następnie stopniowo zwiększaj obciążenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a dor e a reação após o treino, e aumente gradualmente a carga"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a dor e a reação após o treino, e aumente gradualmente a carga"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați durerea și reacția după exercițiu și creșteți gradat intensitatea"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте боль и реакцию после тренировки, постепенно увеличивая нагрузку"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte bolesť a reakciu po cvičení a postupne zvyšujte zaťaženie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverimo bolečino in reakcijo po treningu ter postopno povečamo obremenitev."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera smärta och reaktion efter träningen, och öka belastningen gradvis"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் பழைய நிலைக்கு வந்த பிறகு, வலி மற்றும் உடல்நிலையை சரிபார்த்து, படிப்படியாக பயிற்சியின் அளவை அதிகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మునుపటి స్థితి తర్వాత నొప్పి మరియు ప్రతిస్పందనలను తనిఖీ చేసి, క్రమంగా బరువును పెంచడం"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบอาการและปฏิกิริยาหลังจากการออกกำลังกาย และค่อยๆ เพิ่มความเข้มข้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski haline döndükten sonraki ağrı ve tepkileri kontrol edin, yükü kademeli olarak artırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряю біль та реакцію після тренування, поступово збільшуючи навантаження"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra và điều chỉnh mức tạ theo phản ứng và cảm giác đau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认深蹲后的疼痛和反应，逐步增加负重"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "确认深蹲后的疼痛和反应，逐步增加负重。"
          }
        }
      }
    },
