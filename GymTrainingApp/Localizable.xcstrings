        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Health belum diaktifkan, hanya sejarah aplikasi yang disimpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen toestemming voor gezondheid, alleen appgeschiedenis is opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Helse ikke godkjent, kun app-historikk er lagret."
          }
        },
