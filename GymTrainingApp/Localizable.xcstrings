    "domain_catalog.573b24a5dd9c": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:315\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هادئ ومنطقي. اشرح الأرقام والأحاسيس بشكل منفصل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranquil i lògic. Explica els números i les sensacions per separat"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Buďte klidní a logičtí. Rozlišujte mezi čísly a fyzickými pocity při vysvětlování"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær rolig og logisk. Forklar med både tal og fornemmelse"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhevolles und logisches Vorgehen. Zahlen und Empfindungen getrennt erklären"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείνετε ήρεμοι και λογικοί. Εξηγήστε χρησιμοποιώντας αριθμούς και αισθήσεις"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay calm and logical. Explain using numbers and physical sensations"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay calm and logical. Explain using numbers and physical sensations"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay calm and logical. Explain using numbers and physical sensations"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay calm and logical. Explain using numbers and physical sensations"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la calma y explica de manera lógica, separando los números y las sensaciones."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la calma y explica de manera lógica, separando los números y las sensaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selitä asiat rauhallisesti ja loogisesti, erotatko lukuja ja tuntemuksia"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliquer calmement et logiquement, en distinguant les chiffres et les sensations"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliquer calmement et logiquement, en distinguant les chiffres et les sensations"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શાંત અને તાર્કિક રીતે, સંખ્યાઓ અને અનુભવોને અલગથી સમજાવો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להסביר בצורה רגועה ומדויקת, תוך הפרדה בין מספרים ותחושה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत और तर्कसंगत। संख्या और शारीरिक अनुभव को अलग-अलग बताएं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smirite se i razmislite. Razdijelite informacije između brojeva i osjećaja"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyugodtan és logikusan, különbséget kell tenni a számok és az érzések között"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpikir tenang dan rasional. Jelaskan perbedaan antara angka dan sensasi tubuh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni un approccio calmo e logico. Spiega le differenze tra numeri e sensazioni fisiche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ち着いて論理的。数値と体感を分けて説明する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차분하고 논리적으로, 수치와 감각을 분리하여 설명"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शांतपणे आणि तर्कशुद्ध पद्धतीने, संख्या आणि शारीरिक अनुभवांमध्ये फरक करून स्पष्टीकरण द्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersabar dan logik. Jelaskan dengan membezakan antara angka dan sensasi"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rustig en logisch. Leg uit met zowel cijfers als gevoel"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær rolig og logisk. Forklar tall og følelser separat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojnie i logicznie, wyjaśniając zarówno liczby, jak i odczucia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a calma e explique de forma lógica, separando números e sensações"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a calma e explique de forma lógica, separando números e sensações"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abordează subiectul calm și logic. Distinge între numere și senzație"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойно и логично. Объяснять, разделяя числовые данные и ощущения"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Buďte pokojní a logickí. Rozdeľte vysvetlenie na čísla a zmyslové vnímanie"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razumljajte in logično razložite, ločite številke od čutnih izkušenj"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var lugn och logisk. Förklara siffror och känslan separat"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதியாக, தர்க்கரீதியாக, எண்களையும், உடல் உணர்வுகளையும் தனித்தனியாக விளக்குங்கள்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాంతంగా మరియు తార్కికంగా ఉండండి. సంఖ్యలను మరియు అనుభూతిని వేర్వేరుగా వివరించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายอย่างใจเย็นและมีเหตุผล โดยแยกการวัดตัวเลขและการรับรู้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin ve mantıklı olun. Sayıları ve fiziksel deneyimi ayrı ayrı açıklayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійно та логічно. Роз'яснюйте, розрізняючи числові дані та відчуття"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giải thích một cách bình tĩnh và logic, phân biệt giữa số liệu và cảm nhận"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持冷静，并用数字和感觉来解释"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持冷靜，並將數字和身體感覺分開說明"
          }
        }
      }
    },
