    "health_meals_body_ai.a65c82a761d0": {
      "comment": "GymTrainingApp/Data/DailyRecommendationNotificationManager.swift:95\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "نظرًا لانخفاض الاستجابة للإشعارات، يتم تعليق الإشعارات تلقائيًا في الليل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A causa de la poca resposta a les notificacions, les notificacions se suspenen automàticament a la nit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky vypínám notifikace v noci, protože na ně nereagujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da der er få reaktioner på notifikationer, er natlige notifikationer automatisk slået fra."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Da die Reaktionen auf Benachrichtigungen gering sind, werden Nachtbenachrichtigungen automatisch deaktiviert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λόγω της χαμηλής ανταπόκρισης στις ειδοποιήσεις, οι νυχτερινές ειδοποιήσεις απενεργοποιούνται αυτόματα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We automatically pause notifications at night because we haven't received a response."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We automatically pause notifications at night because we haven't received a response."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We automatically pause notifications at night because we haven't received a response."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We automatically pause notifications at night because we haven't received a response."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar notificaciones excesivas, las notificaciones nocturnas están desactivadas automáticamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar notificaciones excesivas, las notificaciones nocturnas están desactivadas automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska vastaat harvoin ilmoituksiin, ilmoitukset on automaattisesti pysäytetty yöllä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont automatiquement désactivées car il y a peu de réponses."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont automatiquement désactivées car il y a peu de réponses."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂચનાઓ પર ઓછી પ્રતિક્રિયા મળતી હોવાથી, રાત્રિના સૂચનો આપોઆપ બંધ કરવામાં આવ્યા છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכיוון שאין תגובה לשלוח הודעות, ההודעות בלילה מופסקות באופן אוטומטי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचनाओं पर कम प्रतिक्रिया के कारण, रात में सूचनाएं स्वचालित रूप से बंद हो जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski isključujemo notifikacije navečer zbog nedostatnog odgovora na notifikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mivel kevésbé reagál a értesítésekre, ezért automatikusan kikapcsoljuk az éjszakai értesítéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena respons terhadap notifikasi sedikit, notifikasi malam secara otomatis dinonaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per evitare notifiche eccessive, disattiviamo automaticamente le notifiche notturne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知への反応が少ないため、夜の通知を自動で休止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림에 대한 반응이 적기 때문에, 밤 알림을 자동으로 멈춥니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेशांना कमी प्रतिसाद मिळत असल्याने, रात्रीच्या संदेशांना आपोआप बंद केले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem akan secara automatik menangguhkan notifikasi pada waktu malam kerana kurangnya tindak balas."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat er weinig reactie op notificaties is, worden deze automatisch uitgeschakeld 's avonds."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Siden responsen på varsler er lav, slås varslene automatisk av om natten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie wyłączam powiadomienia wieczorem, ponieważ nie otrzymuję na nie odpowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativei as notificações noturnas automaticamente, pois não há muitas respostas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativei as notificações noturnas automaticamente, pois não há muitas respostas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deoarece reacția la notificări este scăzută, notificările nocturne sunt oprite automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из-за низкой активности в уведомлениях, ночные уведомления автоматически отключаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky vypínam notifikácie v noci, pretože je zlé reakcie na notifikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker je odziv na obvestila majhen, avtomatično ustavimo nočna obvestila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftersom du inte reagerar på notiser, stänger vi automatiskt av notiser på kvällen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிவிப்புகளுக்குப் பதிலளிப்பது குறைவாக இருப்பதால், இரவில் அறிவிப்புகளை தானாகவே நிறுத்தி வைக்கிறோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నోటిఫికేషన్లకు ప్రతిస్పందన తక్కువగా ఉండటం వలన, రాత్రి సమయాల్లో నోటిఫికేషన్‌లను ఆటోమేటిక్‌గా నిలిపివేస్తున్నాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจากมีการตอบสนองต่อการแจ้งเตือนน้อย จึงได้ปิดการแจ้งเตือนในเวลากลางคืนโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimlere tepki vermediğiniz için, gece bildirimlerini otomatik olarak kapatıyoruz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично вимкнено сповіщення вночі через низьку реакцію на них."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Do phản hồi ít, chúng tôi tự động tắt thông báo vào ban đêm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于对通知的反应较少，已自动暂停夜间通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為對通知的回應較少，所以已自動關閉夜間通知。"
          }
        }
      }
    },
