        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz siłownię, w której ćwiczysz lub sprzęt dostępny w domu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione o ginásio que frequenta ou os equipamentos disponíveis em casa."
