        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ઘૂંટણને લંબાવીને, પગની ઘૂંટીને ઉપર ઉઠાવો અને તમારી કાંડાને સંકોચાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרמת קרסולי תוך כדי שמירת רגליים ישרות, כיווץ השוקיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने घुटनों को फैलाएं और एड़ी को ऊपर उठाएं, और अपनी पिंडली को संकुचित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Istežite koljena, a zatim podignite pete i napnuti potkoljenice."
