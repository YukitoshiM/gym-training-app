          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie einen Fuß auf einer Plattform und beugen Sie sich vor, indem Sie Ihr Gewicht auf den vorderen Fuß legen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
