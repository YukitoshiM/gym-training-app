          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie eine gerade Linie vom Kopf bis zum Fuß und achten Sie darauf, dass der Rücken nicht nach hinten sinkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρήστε ευθεία τη θέση από το κεφάλι μέχρι τα πέλματα, διατηρώντας την στάση σας για να μην καταρρεύσει η μέση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and keep your posture upright to prevent slouching."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and keep your posture upright to prevent slouching."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and keep your posture upright to prevent slouching."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a straight line from head to toe, and keep your posture upright to prevent slouching."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la línea desde la cabeza hasta los talones, manteniendo una postura que evite que la espalda se curve."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la línea desde la cabeza hasta los talones, manteniendo una postura que evite que la espalda se curve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä vartalosta aina päästä varpaisiin suora linja, ja säilytä ryhti, jotta vatsa ei lammekoon."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une posture droite, du sommet de la tête aux talons, en maintenant votre dos droit."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une posture droite, du sommet de la tête aux talons, en maintenant votre dos droit."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માથાથી પગ સુધી સીધી રેખા જાળવી રાખો, જેથી પીઠ ન પડે તે માટે યોગ્ય સ્થિતિ જાળવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על קו ישר מהראש ועד העקב, ושמרו על עמידה כדי למנוע נפילה של הגב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर से पैर तक सीधा रखें, और सुनिश्चित करें कि आपकी पीठ सीधी रहे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite tijelo u ravnoj liniji od glave do pete, održavajući položaj kako biste izbjegli napetost u leđima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a testet egyenesen, és ügyeljen arra, hogy a hátja ne dőljön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjaga posisi dari kepala hingga tumit, sambil mempertahankan postur agar punggung tidak melengkung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere la postura da testa ai piedi, mantenendo la schiena dritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頭から踵まで一直線を保ち、腰が落ちないように姿勢を維持する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리부터 발끝까지 일직선을 유지하며, 허리가 처지지 않도록 자세를 유지합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डोक्यापासून पायापर्यंत सरळ रेषेत ठेवा, ज्यामुळे कंबर खाली जाणार नाही याची काळजी घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan badan dalam keadaan tegak, sambil mengekalkan postur untuk mengelakkan punggung bungkuk."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een rechte lijn van hoofd tot hak, en zorg ervoor dat je rug niet buigt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en rett linje fra hode til tå, og oppretthold stillingen for å unngå at korsryggen bøyes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj proste ułożenie ciała od głowy do stóp, dbając o to, aby plecy nie opadały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a postura reta, da cabeça aos pés, e mantenha a coluna ereta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a postura reta, da cabeça aos pés, e mantenha a coluna ereta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți o poziție dreaptă, de la cap până în picioare, pentru a evita căderea spatelui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддерживайте прямую линию от головы до пят, сохраняя правильную осанку, чтобы не проваливаться в пояс."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržujte rovú postoj od hlavy až po päty, aby ste si zachovali správnu polohu chrbta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržite ravno držo od glave do pet, ter ohranjte pravilno postavo telesa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll kroppen i rak linje från huvud till tå, och bibehåll en hållning som förhindrar att ryggen sjunker ihop."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலை முதல் கால் வரை நேராக வைத்து, முதுகை வளைக்காமல் இருக்க சரியான நிலையில் இருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తల నుండి కాలి వరకు ఒక సరళ రేఖను కొనసాగించండి, వెన్నుపూసను నిటారుగా ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รักษาท่าทางให้ตรงจากศีรษะจรดปลายเท้า และพยุงหลังไม่ให้หงึกหงึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başınızdan topuklarınıza doğru, belinizin düşmemesi için pozisyonunuzu koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримуйте пряму лінію від голови до п'ят, зберігаючи правильну поставу, щоб поперек не опускався."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thẳng từ đầu đến bàn chân, duy trì tư thế để tránh lưng gập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持头部到脚部的直线，并维持姿势以防止腰部下沉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持頭到腳的一條線，並維持姿勢以防止腰部下垂。"
          }
        }
      }
    },
    "domain_catalog.3fe0220dd26a": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:361\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
