    "domain_catalog.fe37c9ed6763": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:466\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بدلًا من رفعه بذراعيك، قم بأرجحة الكيتلبل من خلال تمديد الورك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En lloc d'aixecar amb els braços, moveu el kettlebell a través de l'extensió del maluc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepřeměřujte paže, používejte pohyby kyčlí k manipulaci s kettlebell."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug ikke armene til at løfte, men brug hoftens bevægelser til at svinge kettlebell'en."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arme nicht heben, sondern mit dem Kettlebell durch Ausstrecken der Hüfte arbeiten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην σηκώνετε τα χέρια σας, αλλά χρησιμοποιήστε την έκταση των γονάτων για να κουνάτε το kettlebell."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use kettlebells by extending your hips, not lifting with your arms."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Use kettlebells by extending your hips, not lifting with your arms."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use kettlebells by extending your hips, not lifting with your arms."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use kettlebells by extending your hips, not lifting with your arms."
          }
        },
        "es-ES": {
