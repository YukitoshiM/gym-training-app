    "domain_catalog.be9bc1818213": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:46\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ارفع صدرك، واجمع الكابل معًا أمام صدرك، وقم بقبض عضلات الصدر الرئيسية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aixeca el pit, ajunta el cable davant del pit i contrau els músculs pectorals majors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napněte hrudník, přitáhněte kabel k hrudníku a stáhněte svaly prsů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spænd brystmusklerne ved at samle håndtagene foran brystet."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Brustmuskeln durch Zusammenziehen der Brust mit einem Kabelzug trainieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τεντώστε το στήθος σας και χρησιμοποιήστε έναν ιμάντα για να συστέλλετε τους μύες του θώρακα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Contract your pectorals by bringing the cable to meet in front of your chest."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Contract your pectorals by bringing the cable to meet in front of your chest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Contract your pectorals by bringing the cable to meet in front of your chest."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Contract your pectorals by bringing the cable to meet in front of your chest."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira el pecho y contrae los músculos del pecho con una banda conectada al pecho."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira el pecho y contrae los músculos del pecho con una banda conectada al pecho."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa rintalihakset vetämällä kaapelia rinnan etupuolelle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Contractez les pectoraux en rapprochant le câble devant vous."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contractez les pectoraux en rapprochant le câble devant vous."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છાતીને ફેલાવો, અને છાતી પર કેબલને એકસાથે ખેંચીને છાતીના સ્નાયુઓને મજબૂત બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למתוח את החזה, לחבר את הכבלים כך שיתנו תמיכה לשריר הכתף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी छाती को फैलाएं, और अपने सीने के सामने के हिस्से में केबल को समायोजित करके अपनी छाती की मांसपेशियों को मजबूत करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napinujte prsnu površinu, podudarite kabel pred grdom kako biste napeli mišiće prsnog dijela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzzon ki a hasát, és húzza a cábliat a derék előtti helyre, hogy a mellizma megemléssze."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegangkan dada, lalu sejajarkan kabel di depan dada untuk melatih otot dada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrapporre i muscoli pettorali, allineando il cavo davanti al petto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸を張り、ケーブルを胸の前で合わせて大胸筋を収縮させる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가슴을 넓게 벌리고, 케이블을 가슴 앞에서 교차하여 대흉근을 수축시킵니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "छातीचा स्नायू मजबूत करा, केबलला छातीच्या मध्यभागी आणून छातीचा स्नायू ताणवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegakkan dada, selaraskan kabel di hadapan dada untuk mengontrak otot dada."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Span je borstspieren aan en gebruik een kabel om je borstspieren te aanspannen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Spenn brystmusklene og juster kabelen slik at den går foran brystet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozciągnij klatkę piersiową i użyj kabla, aby skurczyć mięśnie klatki piersiowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre o peito e use a corda para contrair o peitoral."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre o peito e use a corda para contrair o peitoral."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îndoiți pieptul și utilizați cablul pentru a contracta mușchii pectorali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распрямите грудь и используйте кабель для сжатия мышц груди."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napnejte hrudné svaly a spáujte kladku pred hrudníkom, aby ste ich stiahli."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napnite prste,nato pa z kablom napnete mišice prsi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spänn bröstmusklerna genom att dra kabelvikt framför bröstet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மார்பை விரித்து, கேபிள்-ஐ உங்கள் மார்பில் சேர்த்து, உங்கள் மார்பின் தசைகளை சுருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఛాతీని చాపి, కేబుల్‌ను ఛాతీ ముందు ఉంచి, ఛాతీ కండరాలను బిగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยายหน้าอก, จับสายเคเบิลให้แนบกับหน้าอก เพื่อกระชับกล้ามเนื้อหน้าอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğsü genişleterek, kabloyu göğsünde birleştirerek büyük omuz kaslarını sık."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розправте груди, з'єднайте троси перед грудьми та стисніть м'язи грудей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhíu vai, điều chỉnh dây cáp để co cơ ngực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挺胸，并将杠杆在胸前对齐大胸肌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挺胸，並將槓桿在胸前對齊大胸肌"
          }
        }
      }
    },
