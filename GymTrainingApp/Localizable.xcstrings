    "domain_catalog.894b7cbd839d": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:317\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دافئة وحذرة. اختر الكلمات التي ستساعدك على المضي قدمًا بأمان دون تسرع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "càlid i atent. Trieu paraules que us ajudin a avançar amb seguretat i sense pressa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte uklidňující a opatrné fráze, které vám umožní postupovat bez stresu a bezpečně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Varm og forsigtig. Vælg ord, der giver dig mulighed for at gå frem roligt og sikkert"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wärme und vorsichtig. Wählen Sie Worte, die Ihnen helfen, ohne Eile und sicher voranzukommen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαλαρός και προσεκτικός, επιλέγοντας λέξεις που σας επιτρέπουν να προχωρήσετε με ασφάλεια και χωρίς άγχος."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and cautious language that encourages progress without rushing or compromising safety."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and cautious language that encourages progress without rushing or compromising safety."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and cautious language that encourages progress without rushing or compromising safety."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use warm and cautious language that encourages progress without rushing or compromising safety."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé amable y cauteloso. Elige palabras que te permitan avanzar con calma y seguridad."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé amable y cauteloso. Elige palabras que te permitan avanzar con calma y seguridad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämpimä ja harkitseva. Valitse sanoja, jotka mahdollistavat rauhallisen ja turvallisen etenemisen"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des mots chaleureux et prudents, qui vous permettent d'avancer calmement et en toute sécurité."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des mots chaleureux et prudents, qui vous permettent d'avancer calmement et en toute sécurité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ગરમ અને સાવધ. કોઈ પણ પ્રકારની તકલીફ ન થાય તે માટે, ધીમે ધીમે આગળ વધવા માટે યોગ્ય શબ્દો પસંદ કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילים חמות ומכובדות, שמאפשרות לנו להתקדם בצורה בטוחה ולא מהירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गरम और सावधानीपूर्वक, बिना घबराए सुरक्षित रूप से आगे बढ़ने के लिए उपयुक्त शब्द चुनें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topli i oprezni. Izaberite riječi koje vam omogućuju da napredujete bez brige i sigurno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyugodt és óvatos megközelítés, ahol a cél a fokozatos és biztonságos haladás"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih kata-kata yang hangat dan hati-hati, memungkinkan Anda maju dengan aman tanpa terburu-buru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli parole che siano calde e prudenti, permettendoti di progredire senza fretta e in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かく慎重。焦らず安全に前進できる言葉を選ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻하고 신중하게, 조급함 없이 안전하게 나아갈 수 있는 표현 선택"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समजूतदार आणि सावध दृष्टिकोन, ज्यामुळे शांतपणे आणि सुरक्षितपणे पुढे जावे"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhati-hati dan bijak. Pilih kata-kata yang membolehkan anda bergerak maju dengan selamat dan tanpa tergesa-gesa"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalm en voorzichtig. Kies woorden die je helpen om rustig en veilig vooruit te gaan"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg ord som er varme og forsiktige, slik at du kan gå fremover uten å bekymre deg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz słowa, które są ciepłe i ostrożne, pozwalając na spokojny i bezpieczny postęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha palavras que sejam calorosas e cuidadosas, permitindo que você avance com calma e segurança."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha palavras que sejam calorosas e cuidadosas, permitindo que você avance com calma e segurança."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește cuvinte calde și atente, care te ajută să progresezi în siguranță și fără stres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте слова, которые будут поддерживать и направлять, не вызывая спешки и беспокойства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte si slová, ktoré sú jemné a opatrné. Vyhýbajte sa stresu a postupujte bezpečne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplo in previdno. Izbira besed, ki vam omogočajo, da napredujete brez stresu in varno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugn och försiktig. Välj ord som ger dig möjlighet att gå framåt långsamt och säkert"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதியான மற்றும் கவனமான அணுகுமுறையுடன், பொறுமையுடன் பாதுகாப்பாக முன்னேற உதவும் வார்த்தைகளைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రశాంతంగా మరియు జాగ్రత్తగా ఉండండి. తొందరపడకుండా సురక్షితంగా ముందుకు సాగడానికి సరైన పదాలను ఎంచుకోండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคำพูดที่อบอุ่นและรอบคอบ สามารถก้าวไปข้างหน้าอย่างปลอดภัย โดยไม่เร่งรีบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin ve dikkatli olun. Acele etmeden, güvenli bir şekilde ilerlemenizi sağlayacak kelimeleri seçin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирайте слова, які дають відчуття тепла та обережності, дозволяючи вам поступово рухатися вперед, не поспішаючи та безпечно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn những lời nói nhẹ nhàng và cẩn thận, giúp bạn tiến bộ một cách an toàn và không gây áp lực"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温和而谨慎，选择能让你在不焦虑的情况下安全前进的措辞"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫和且謹慎，選擇能讓你安心、不急於求成的話語"
          }
        }
      }
    },
