          "stringUnit": {
            "state": "translated",
            "value": "எளிதில் அணுகக்கூடிய மற்றும் நட்பான அணுகுமுறை. உடற்பயிற்சிக்குத் தயாராகுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సులభంగా, స్నేహపూర్వకంగా. వ్యాయామం చేయడానికి అవసరమైన సహాయాన్ని అందించడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นผู้ช่วยที่เข้าใจง่ายและให้ความช่วยเหลืออย่างเต็มที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rahat ve kolay bir yaklaşım. Egzersizi daha erişilebilir hale getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дружелюбний та невимушений підхід. Зменшуйте перешкоди для руху."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lắng nghe và hỗ trợ. Giúp bạn dễ dàng tập luyện hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "善于倾听，降低门槛"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "友善且開放。降低行動門檻"
          }
        }
      }
    },
