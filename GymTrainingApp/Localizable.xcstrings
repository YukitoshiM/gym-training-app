    "core_ui.0200140f3573": {
      "comment": "GymTrainingApp/Advertising/AdvertisingSettingsViews.swift:50",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الإعلانات على iPhone فقط. لا تُستخدم سجلات الصحة أو الوجبات أو الصور أو الموقع في BodyMode لاختيار الإعلانات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els anuncis només es mostren a l'iPhone. Les dades de salut, àpats, fotos i ubicacions de BodyMode no s'utilitzen per seleccionar anuncis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamy se zobrazují pouze na iPhonu. Zdravotní údaje, jídla, fotografie a polohy BodyMode se nepoužívají k výběru reklam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Annoncer vises kun på iPhone. Sundheds-, måltids-, billed- og BodyMode-placeringsdata bruges ikke til at vælge annoncer."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbung wird nur auf dem iPhone angezeigt. Gesundheits-, Mahlzeiten-, Foto- und BodyMode-Standortdaten werden nicht zur Auswahl von Werbung verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διαφημίσεις εμφανίζονται μόνο στο iPhone. Δεδομένα υγείας, γευμάτων, φωτογραφιών και τοποθεσίας BodyMode δεν χρησιμοποιούνται για την επιλογή διαφημίσεων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Ads appear only on iPhone. Health, meal, photo, and BodyMode location records are not used to select ads."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ads appear only on iPhone. Health, meal, photo, and BodyMode location records are not used to select ads."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ads appear only on iPhone. Health, meal, photo, and BodyMode location records are not used to select ads."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ads appear only on iPhone. Health, meal, photo, and BodyMode location records are not used to select ads."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los publicidad solo aparecen en el iPhone. Los registros de salud, comidas, fotos y ubicación de BodyMode no se usan para seleccionar publicidad."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los anuncios solo aparecen en el iPhone. Los registros de salud, comidas, fotos y ubicación de BodyMode no se usan para seleccionar anuncios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainoksia näytetään vain iPhonessa. Terveys-, ateria-, kuva- ja BodyMode-sijaintitietoja ei käytetä mainosten valintaan."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicités s'affichent uniquement sur l'iPhone. Les données de santé, de repas, de photos et de position BodyMode ne servent pas à sélectionner les publicités."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publicités s'affichent uniquement sur l'iPhone. Les données de santé, de repas, de photos et de position BodyMode ne servent pas à sélectionner les publicités."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાહેરાતો ફક્ત iPhone પર દેખાય છે. આરોગ્ય, ભોજન, ફોટા અને BodyMode સ્થાન રેકોર્ડનો જાહેરાત પસંદ કરવા ઉપયોગ થતો નથી."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודעות מופיעות רק ב-iPhone. רישומי בריאות, ארוחות, תמונות ומיקום ב-BodyMode אינם משמשים לבחירת מודעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विज्ञापन केवल iPhone पर दिखते हैं। BodyMode के स्वास्थ्य, भोजन, फ़ोटो और स्थान रिकॉर्ड विज्ञापन चुनने में उपयोग नहीं होते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglasi se prikazuju samo na iPhoneu. Podaci o zdravlju, obrocima, fotografijama i lokacijama BodyModea ne koriste se za odabir oglasa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hirdetések csak iPhone-on jelennek meg. Az egészségügyi, étkezési, fotó- és BodyMode-helyadatokat nem használjuk hirdetések kiválasztására."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan hanya tampil di iPhone. Data kesehatan, makanan, foto, dan lokasi BodyMode tidak digunakan untuk memilih iklan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli annunci vengono mostrati solo su iPhone. I dati di salute, pasti, foto e posizione di BodyMode non vengono usati per selezionare gli annunci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告はiPhoneだけに表示し、健康・食事・写真やBodyModeの位置記録を広告選定に使用しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고는 iPhone에만 표시됩니다. 건강, 식사, 사진 및 BodyMode 위치 기록은 광고 선택에 사용되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जाहिराती फक्त iPhone वर दिसतात. आरोग्य, जेवण, फोटो आणि BodyMode स्थान नोंदी जाहिराती निवडण्यासाठी वापरल्या जात नाहीत."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Iklan hanya dipaparkan pada iPhone. Data kesihatan, hidangan, foto dan lokasi BodyMode tidak digunakan untuk memilih iklan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertenties worden alleen op de iPhone weergegeven. Gezondheids-, maaltijd-, foto- en BodyMode-locatiegegevens worden niet gebruikt om advertenties te selecteren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonser vises bare på iPhone. Helse-, måltids-, bilde- og BodyMode-posisjonsdata brukes ikke til å velge annonser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamy są wyświetlane tylko na iPhonie. Dane zdrowotne, posiłki, zdjęcia i lokalizacje BodyMode nie są używane do wyboru reklam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os anúncios aparecem apenas no iPhone. Registros de saúde, refeições, fotos e localização do BodyMode não são usados para selecionar anúncios."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os anúncios aparecem apenas no iPhone. Registos de saúde, refeições, fotos e localização do BodyMode não são usados para selecionar anúncios."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclamele apar doar pe iPhone. Datele de sănătate, mese, fotografii și locații BodyMode nu sunt folosite pentru selectarea reclamelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реклама показывается только на iPhone. Данные о здоровье, питании, фотографиях и местоположениях BodyMode не используются для подбора рекламы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamy sa zobrazujú iba na iPhone. Zdravotné údaje, jedlá, fotografie a polohy BodyMode sa nepoužívajú na výber reklám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglasi se prikazujejo samo v iPhonu. Podatki o zdravju, obrokih, fotografijah in lokacijah BodyMode se ne uporabljajo za izbiro oglasov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Annonser visas endast på iPhone. Hälso-, måltids-, bild- och BodyMode-platsdata används inte för att välja annonser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விளம்பரங்கள் iPhone-ல் மட்டுமே காட்டப்படும். ஆரோக்கியம், உணவு, புகைப்படம் மற்றும் BodyMode இருப்பிடப் பதிவுகள் விளம்பரங்களைத் தேர்ந்தெடுக்கப் பயன்படுத்தப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రకటనలు iPhoneలో మాత్రమే కనిపిస్తాయి. ఆరోగ్యం, భోజనం, ఫోటో మరియు BodyMode స్థానం రికార్డులు ప్రకటనలను ఎంచుకోవడానికి ఉపయోగించబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฆษณาแสดงบน iPhone เท่านั้น และจะไม่ใช้ข้อมูลสุขภาพ อาหาร รูปภาพ หรือตำแหน่งใน BodyMode เพื่อเลือกโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamlar yalnızca iPhone'da gösterilir. Sağlık, öğün, fotoğraf ve BodyMode konum verileri reklam seçimi için kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Реклама показується лише на iPhone. Дані про здоров’я, харчування, фотографії та розташування BodyMode не використовуються для добору реклами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quảng cáo chỉ hiển thị trên iPhone. Dữ liệu sức khỏe, bữa ăn, ảnh và vị trí trong BodyMode không được dùng để chọn quảng cáo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广告仅在iPhone上显示。健康、餐食、照片和BodyMode位置记录不会用于选择广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣告僅在iPhone上顯示。健康、餐點、照片和BodyMode位置記錄不會用於選擇廣告。"
          }
        }
      }
    },
