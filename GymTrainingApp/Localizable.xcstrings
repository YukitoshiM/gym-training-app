    "health_meals_body_ai.1a14ccfb8745": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:584\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان هدفك هو اكتساب العضلات، فيمكنك التفكير بشكل معقول في القيام بتمرين آخر هذا الأسبوع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el vostre objectiu és guanyar múscul, podeu considerar raonablement fer un entrenament més aquesta setmana."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je vaším cílem budovat svaly, můžete zvážit další trénink v tomto týdnu, ale buďte opatrní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis dit mål er muskelopbygning, kan du overveje at tilføje et ekstra træningspas denne uge inden for dine grænser."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Ihr Ziel Muskelaufbau ist, können Sie in Erwägung ziehen, diese Woche noch ein zusätzliches Training zu absolvieren, wobei Sie darauf achten sollten, dass dies im Rahmen Ihrer Möglichkeiten geschieht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν ο στόχος σας είναι η μυϊκή ανάπτυξη, μπορείτε να εξετάσετε την προσθήκη μιας επιπλέον προπόνησης αυτή την εβδομάδα, στο μέτρο των δυνάμεών σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "If your goal is muscle growth, you can consider adding one more workout this week within a reasonable range."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "If your goal is muscle growth, you can consider adding one more workout this week within a reasonable range."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If your goal is muscle growth, you can consider adding one more workout this week within a reasonable range."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "If your goal is muscle growth, you can consider adding one more workout this week within a reasonable range."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si su objetivo es aumentar la masa muscular, puede considerar realizar una sesión adicional de entrenamiento esta semana, dentro de lo razonable."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si su objetivo es aumentar la masa muscular, puede considerar realizar una sesión adicional de entrenamiento esta semana, dentro de lo razonable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos tavoitteesi on lihasten kasvattaminen, voit harkita yhden ylimääräisen harjoituksen viikossa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre objectif est le développement musculaire, vous pouvez envisager une séance d'entraînement supplémentaire cette semaine, dans la mesure où cela reste raisonnable."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre objectif est le développement musculaire, vous pouvez envisager une séance d'entraînement supplémentaire cette semaine, dans la mesure où cela reste raisonnable."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમારું લક્ષ્ય સ્નાયુઓનો વિકાસ કરવાનું હોય, તો તમે આ અઠવાડિયામાં એક વધુ વર્કઆઉટ કરવાનું વિચારી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם המטרה שלך היא הגדלת שרירים, תוכל לשקול אימון נוסף השבוע, במידה סבירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपका लक्ष्य मांसपेशियों का विकास है, तो आप इस सप्ताह एक अतिरिक्त प्रशिक्षण सत्र पर विचार कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako je vaš cilj izgradnja mišića, možete razmotriti dodatni trening ovog tjedna u umjereno mjeri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha az izomépítés a cél, akkor megfontolhatja, hogy egy további edzést végezzen, de csak kényelmes mértékben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tujuan Anda adalah membangun otot, Anda dapat mempertimbangkan untuk melakukan satu sesi latihan tambahan minggu ini dalam rentang yang wajar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'obiettivo è l'ipertrofia muscolare, puoi considerare un ulteriore allenamento questa settimana, nel rispetto dei tuoi limiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肥大が目的なら、無理のない範囲で今週もう1回のトレーニングを検討できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근육 성장이 목표라면, 무리 없는 범위 내에서 이번 주에 추가 훈련을 고려해볼 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर तुम्हाला स्नायू वाढवायचे असेल, तर तुम्ही आठवड्यातून एकदा अतिरिक्त व्यायाम करण्याचा विचार करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika mataram adalah mataram, anda boleh mempertimbangkan untuk melakukan satu lagi latihan minggu ini dalam had yang sesuai."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je doel spiergroei is, kun je overwegen om deze week nog een extra training te plannen, binnen redelijke grenzen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis målet ditt er å bygge muskler, kan du vurdere å trene én ekstra gang denne uken innenfor et realistisk område."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli celem jest zwiększenie masy mięśniowej, możesz rozważyć dodatkowy trening w tym tygodniu, jeśli to możliwe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu objetivo é aumentar a massa muscular, você pode considerar adicionar mais uma sessão de treino esta semana, dentro do que for possível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu objetivo é aumentar a massa muscular, você pode considerar adicionar mais uma sessão de treino esta semana, dentro do que for possível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă obiectivul este creșterea musculară, puteți lua în considerare o a doua sesiune de antrenament săptămânal, într-o măsură rezonabilă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ваша цель — увеличение мышечной массы, вы можете рассмотреть возможность дополнительной тренировки в течение недели, но не переусердствуйте."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je vaším cieľom budovanie svalov, môžete zvážiť ďalší tréning v tomto týždni, pričom sa budete držať rozumných hraníc."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če je vaš cilj povečanje mišic, lahko razmislite o dodatnem treningu v tem tednu, če vam to ustreza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om målet är muskeluppbyggnad kan du överväga ett extra träningspass den här veckan, inom rimliga gränser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடற்பயிற்சியின் நோக்கம் தசையை அதிகரிப்பது என்றால், சாத்தியமான வரம்பிற்குள் இந்த வாரம் ஒரு முறை பயிற்சி செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు కండరాలను పెంచాలని లక్ష్యంగా పెట్టుకుంటే, సాధ్యమయ్యే పరిధిలో ఈ వారం మరొక వ్యాయామం చేయడానికి ప్రయత్నించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากเป้าหมายคือการเพิ่มกล้ามเนื้อ ควรพิจารณาการออกกำลังกายเพิ่มเติม 1 ครั้งต่อสัปดาห์ ในระดับที่เหมาะสม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğer kilo vermek istiyorsanız, bu hafta bir antrenman daha yapabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ваша мета – нарощування м'язів, ви можете розглянути додатковий тренування цього тижня в розумних межах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu mục tiêu là tăng cơ, bạn có thể cân nhắc thêm một buổi tập trong tuần với cường độ vừa phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果目标是增加肌肉，您可以考虑每周进行一次额外的训练，但请确保在安全范围内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果目標是增強肌肉，您可以考慮在下週額外進行一次訓練。"
          }
        }
      }
    },
    "health_meals_body_ai.1a249c16e07b": {
