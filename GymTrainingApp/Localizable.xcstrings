    "domain_catalog.5d6a1ebd0a56": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:173\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دون تقويس جسمك، ارفع الدمبل للأمام حتى مستوى الكتف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense arquejar el cos, aixequeu les manuelles cap a l'alçada de les espatlles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvedněte paže a zvedněte činka do výšky ramen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold kroppen i en lige position og løft håndvægten op foran, så den når op til skulderhøjde."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Heben Sie die Hantel mit dem Rücken gerade und bringen Sie sie bis auf Schulterhöhe nach vorne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε το σώμα σας ίσιο και σηκώστε το αλτήρα μέχρι το ύψος των ώμων προς τα εμπρός."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back straight and lift the dumbbell to shoulder height in front of you."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back straight and lift the dumbbell to shoulder height in front of you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back straight and lift the dumbbell to shoulder height in front of you."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your back straight and lift the dumbbell to shoulder height in front of you."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el cuerpo y, con un mancuernas, llévalo hacia adelante hasta la altura de los hombros."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el cuerpo y, con un mancuernas, llévalo hacia adelante hasta la altura de los hombros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä vartalo suorana ja nosta käsipainoa niin, että se on hartioiden korkeudella eteenpäin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lever la barre devant, en gardant le dos droit et en l'élevant jusqu'à la hauteur des épaules."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lever la barre devant, en gardant le dos droit et en l'élevant jusqu'à la hauteur des épaules."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરને સીધું રાખીને, ડમ્બેલને ખભાની ઊંચાઈ સુધી આગળ વધારો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרימו את משקולות הברכיים כלפי מטה, והרימו אותן קדימה עד לגובה הכתף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर को सीधा रखें, और डम्बल को कंधे की ऊंचाई तक आगे उठाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite uteg do visine ramena, držeći tijelo izduženo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Testvé a testet, és emeld fel a käsizt a vállak magasságába."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat tubuh dan angkat dumbbell sejajar dengan bahu ke depan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevare i pesi mantenendo la schiena dritta e portandoli all'altezza delle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体を反らさず、ダンベルを肩の高さまで前方へ上げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덤벨을 어깨 높이까지 앞으로 들어 올리고, 몸을 숙이지 않도록 합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीराला वाकवून, डंबेलला खांद्याच्या उंचीपर्यंत पुढे न्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Angkat badan ke hadapan sehingga ketinggian bahu, tanpa membengkokkan badan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichaam naar achteren buigen en de dumbbell voorwaarts optillen tot op schouderhoogte."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold kroppen rett, og løft vekten til skulderhøyde fremover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unieś ciało i podnieś sztangę do wysokości ramion, przesuń ją do przodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o corpo e eleve o haltere até a altura dos ombros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o corpo e eleve o haltere até a altura dos ombros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridă-ți corpul și ridică ganterele până la nivelul umerilor, în față."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимите гантели вперед, не сгибая спину, до уровня плеч."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdvihnite telá, držte rovné a zdvihnite činku do výšky ramien dopredu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodno položijo in dvigajo ute proti sebi, do višine ramen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft vikten framåt, så att den når axeln."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடலை வளைக்காமல், டம்பல்களை தோள்பட்டை உயரத்திற்கு முன்னால் உயர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీరాన్ని వంచకుండా, డంబెల్‌ను భుజాల ఎత్తు వరకు ముందుకు తీసుకురండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเว้นการโค้งตัว และยกดัมเบลขึ้นไปด้านหน้าจนถึงระดับไหล่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücudu öne doğru eğmeden, ağırlığı omuz seviyesine kadar öne kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте тіло прямо, піднімайте гантелі вперед до рівня плечей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thẳng lưng, nâng tạ lên ngang vai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要弯曲身体，将哑铃向上抬至肩的高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要彎曲身體，將啞鈴向上抬至肩的高度。"
          }
        }
      }
    },
