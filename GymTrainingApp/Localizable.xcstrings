    "health_meals_body_ai.dc2cd2929fe4": {
      "comment": "GymTrainingApp/Data/HealthDataManager.swift:245\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنني أستطيع العمل عليها كالمعتاد. تحقق أيضًا من شعورك أثناء الإحماء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembla que puc treballar-hi com de costum. Comproveu també com us sentiu mentre escalfeu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete pokračovat normálně. Zkontrolujte také své pocity během rozcvičky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ud til, at du kan fortsætte som normalt. Tjek også fornemmelserne under opvarmningen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es scheint, dass Sie normal weiterarbeiten können. Überprüfen Sie auch Ihre Wahrnehmung während des Aufwärmens."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνεχίσετε κανονικά. Ελέγξτε επίσης τις αισθήσεις σας κατά τη διάρκεια του ζεστάματος."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems you can continue as usual. Also, check how you feel during the warm-up."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems you can continue as usual. Also, check how you feel during the warm-up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems you can continue as usual. Also, check how you feel during the warm-up."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems you can continue as usual. Also, check how you feel during the warm-up."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que puede continuar normalmente. Verifique también la sensación durante el calentamiento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que puede continuar normalmente. Verifique también la sensación durante el calentamiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää, että voit jatkaa normaalisti. Tarkista myös tuntemukset lämmittelyn aikana."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble que vous puissiez continuer normalement. Vérifiez également vos sensations pendant le échauffement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble que vous puissiez continuer normalement. Vérifiez également vos sensations pendant le échauffement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સામાન્ય રીતે તમે આ કરી શકો છો. વોર્મ અપ કરતી વખતેની લાગણી પણ તપાસો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני יכול להתקדם כרגיל. בדוק גם את התחושה במהלך חימום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान्य तरीके से काम कर सकते हैं। वार्म-अप के दौरान महसूस होने वाली बातों की भी जांच करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možemo nastaviti normalno. Provjerite i osjećaje tijekom zagrijavanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szokásos módon tudja végezni az edzést. Ellenőrizze a melegítő során érzettérzetet is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepertinya bisa melanjutkan seperti biasa. Periksa juga sensasi saat pemanasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra possibile continuare normalmente. Controllare anche le sensazioni durante il riscaldamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常どおり取り組めそうです。ウォームアップ中の感覚も確認しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소와 같이 진행할 수 있습니다. 워밍업 중의 느낌도 확인해 보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही नेहमीप्रमाणे व्यायाम करू शकता. वॉर्म-अप करताना येणाऱ्या अनुभवांची नोंद घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seharusnya boleh dijalankan seperti biasa. Pastikan juga untuk memeriksa sensasi semasa pemanasan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt waarschijnlijk gewoon verder gaan. Controleer ook je gevoel tijdens de warming-up."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ut som du kan fortsette som vanlig. Sjekk også hvordan det føles under oppvarmingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że mogę kontynuować normalnie. Sprawdź również odczucia podczas rozgrzewki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você pode continuar normalmente. Verifique também a sensação durante o aquecimento."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você pode continuar normalmente. Verifique também a sensação durante o aquecimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar trebui să puteți continua în mod normal. Verificați și senzațiile din timpul încălzirii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кажется, можно продолжать тренировку как обычно. Также обратите внимание на ощущения во время разминки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali by ste byť schopní pokračovať normálne. Skontrolujte aj svoje pocity počas rozcvičky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahko se vrnete k običnemu treningu. Preverite tudi občutke med ogrevanjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verkar kunna fortsätta som vanligt. Kontrollera även känslan under uppvärmningen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதாரணமாகச் செயல்பட முடியும். வார்ம்-அப் செய்யும் போது ஏற்படும் உணர்வுகளைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సాధారణ పద్ధతిలో చేయవచ్చు. వేర్వేరు సమయంలో అనుభూతిని కూడా తనిఖీ చేసుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนว่าคุณสามารถออกกำลังกายได้อย่างปกติ โปรดตรวจสอบความรู้สึกขณะวอร์มอัพด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal şekilde ilerleyebilirsiniz. Isınma sırasında hislerinizi de kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете продовжувати, як зазвичай. Також перевірте відчуття під час розминки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có vẻ như bạn có thể tiếp tục theo đúng kế hoạch. Hãy kiểm tra cảm giác trong quá trình khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "似乎可以正常进行。请确认热身时的感觉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "似乎可以正常進行。請確認暖身時的感覺。"
          }
        }
      }
    },
