            "value": "Avec les progrès réalisés, vous pouvez revoir le plan."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoir le plan après avoir atteint vos objectifs."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે પરિણામો મેળવ્યા છે, તેથી આગામી પ્લાન જુઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השגת היעדים, ניתן לבחון את התוכנית הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि सभी लक्ष्य पूरे हुए हैं, तो आप अगले प्रशिक्षण की योजना को फिर से देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budući da ste ostvarili postignute vrijednosti, možete pretražiti sljedeći plan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A teljesített célok alapján megtekintheti a következő tervet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena Anda telah memenuhi target, tinjau rencana untuk sesi berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con i risultati ottenuti, puoi rivedere il piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実績が揃ったので、次回計画を見直せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실적을 바탕으로, 다음 계획을 검토할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची प्रगती पाहून, पुढील योजनेत बदल करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan pencapaian yang ada, anda boleh meninjau rancangan seterusnya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk het volgende plan na het behalen van je doelen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se over neste plan, siden målene er oppnådd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponieważ wszystkie cele zostały zrealizowane, możesz przejrzeć plan na następny tydzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar o plano após atingir as metas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa o plano seguinte, pois atingiu os objetivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Având în vedere progresul, puteți revizui planul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поскольку вы выполнили все показатели, можно пересмотреть план."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po dosiahnutí cieľov môžete znova skontrolovať plán."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi cilji so dosegani, lahko pregledate naslednji načrt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftersom du har uppfyllt målen, granska nästa plan."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரியான அளவை அடைந்ததால், அடுத்த திட்டத்தை மறுபரிசீலிக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు మీ లక్ష్యాలను చేరుకున్నందున, తదుపరి ప్రణాళికను సమీక్షించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจากการออกกำลังกายของคุณเป็นไปตามเป้าหมาย คุณสามารถทบทวนแผนการออกกำลังกายครั้งต่อไปได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedefleriniz tamamlandı, bir sonraki planınızı gözden geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оскільки у вас є достатньо даних, перегляньте план на наступний раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xem lại kế hoạch tập luyện dựa trên kết quả hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成记录，可回顾下次计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成，可重新檢視下次計畫。"
          }
        }
      }
