        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आत्ता काही गोष्टी नोंदवा आणि नंतर सर्वांचा एकत्र आढावा घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log beberapa perkara sekarang dan semak semuanya kemudian."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer nu een paar dingen en bekijk later alles samen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer noen få ting nå, og se gjennom alt senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz teraz kilka rzeczy, a później przejrzyj wszystko razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre algumas coisas agora e revise tudo depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre algumas coisas agora e revise tudo depois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează câteva lucruri acum și revizuiește totul mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите несколько показателей сейчас и просмотрите всё позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenajte teraz niekoľko vecí a všetko si prejdite neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdaj zabeležite nekaj stvari, pozneje pa preglejte vse skupaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga några saker nu och granska allt senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது சிலவற்றைப் பதிவு செய்து, பின்னர் அனைத்தையும் ஒன்றாகப் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు కొన్ని విషయాలను రికార్డ్ చేసి, తర్వాత అన్నింటినీ ఒకేసారి సమీక్షించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสั้นๆ ตอนนี้ แล้วค่อยทบทวนทั้งหมดภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi birkaç şeyi kaydet, daha sonra hepsini birlikte gözden geçir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть кілька показників зараз і перегляньте все пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhanh vài mục ngay bây giờ và xem lại tất cả sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在快速记录几项，之后再统一回顾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在快速記錄幾項，之後再統一回顧。"
          }
        }
      }
    },
