        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez votre avant-bras pour qu'il soit parallèle au sol et étirez uniquement la partie arrière de votre bras."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Approchez votre avant-bras pour qu'il soit parallèle au sol et étirez uniquement la partie arrière de votre bras."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા હાથને ફ્લોર સાથે સમાંતર રાખો, અને ફક્ત ખભાથી આગળનો ભાગ પાછળની તરફ ખેંચો."
