    "core_ui.7538ba8df343": {
      "comment": "GymTrainingApp/Features/Onboarding/AppTutorialView.swift:133\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل. اسأل الذكاء الاصطناعي. تنفيذ. هناك ثلاثة أشياء فقط أفعلها كل يوم."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre. Pregunta a AI. Executar. Només hi ha tres coses que faig cada dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenejte. Zeptejte se AI. Proveďte. Každý den děláte jen tři věci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer. Spørg AI'en. Udfør. Du kan kun gøre 3 ting hver dag."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnen. Fragen Sie die KI. Ausführen. Es gibt nur drei Dinge, die Sie täglich tun sollten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράψτε. Ρωτήστε την AI. Εκτελέστε. Μόνο τρεις πράγματα κάνετε κάθε μέρα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Record. Ask AI. Execute. There are only three things to do each day."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Record. Ask AI. Execute. There are only three things to do each day."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Record. Ask AI. Execute. There are only three things to do each day."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Record. Ask AI. Execute. There are only three things to do each day."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra. Pregunta a la IA. Ejecuta. Solo hay tres cosas que debes hacer cada día."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra. Pregunta a la IA. Ejecuta. Solo hay tres cosas que debes hacer cada día."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaa ylös. Kysy AI:ltä. Suorita. Päivittäisen harjoittelun tulisi olla kolme asiaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez. Posez une question à l'IA. Exécutez. Il n'y a que trois choses à faire chaque jour."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez. Posez une question à l'IA. Exécutez. Il n'y a que trois choses à faire chaque jour."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રેકોર્ડ કરો. AIને પૂછો. ચલાવો. દરરોજ ફક્ત 3 વસ્તુઓ જ કરવાની છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תעד. שאל את ה-AI. בצע. יש רק שלושה דברים שאפשר לעשות בכל יום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करें। AI से पूछें। चलाएं। हर दिन केवल 3 चीजें करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapišite. Pitam AI-a. Izvrši. Samo tri stvari koje radite svaki dan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsem. Kérdezzem meg az AI-t. Futtassam. Csak három dolgot kell csinálni naponta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat. Tanyakan kepada AI. Lakukan. Hanya ada 3 hal yang perlu dilakukan setiap hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra. Chiedi all'AI. Esegui. Ci sono solo tre cose da fare ogni giorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録する。AIに聞く。実行する。毎日やるのは3つだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록합니다. AI에게 질문하고 실행합니다. 매일 하는 것은 3가지입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ला विचारा. कार्यवाही करा. दररोज फक्त ३ गोष्टी करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat. Tanya kepada AI. Laksanakan. Hanya 3 perkara yang perlu dilakukan setiap hari."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer. Stel vragen aan de AI. Voer uit. Er zijn slechts drie dingen die je elke dag moet doen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrer. Spør AI-en. Gjør. Det er bare tre ting du trenger å gjøre hver dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz. Zapytaj AI. Wykonaj. Tylko trzy czynności dziennie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar. Perguntar à IA. Executar. Apenas 3 coisas para fazer diariamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar. Perguntar à IA. Executar. Apenas 3 coisas para fazer diariamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrați. Puneți întrebări AI-ului. Executați. Trebuie să faceți doar 3 lucruri în fiecare zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записать. Спросить у ИИ. Выполнить. Всего нужно делать три вещи каждый день."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenajte. Pýtajte sa AI. Spustite. Denne robte len 3 veci."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapišite. Poročite AI. Izvedi. Samo 3 stvari, ki jih morate storiti vsak dan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in. Fråga AI:n. Utför. Bara tre saker per dag."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்யவும். AI-யிடம் கேட்கவும், செயல்படுத்தவும். தினமும் செய்ய வேண்டியவை மூன்று மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డ్ చేయండి. AIని అడగండి. అమలు చేయండి. ప్రతిరోజూ చేయడానికి 3 విషయాలు మాత్రమే ఉన్నాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก ถาม AI ทำ และทำทุกวันแค่ 3 อย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedin. Yapay zekaya sorun. Uygula. Her gün sadece 3 şey yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте. Запитайте AI. Виконайте. Щодня потрібно робити лише 3 речі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại. Hỏi AI. Thực hiện. Chỉ có 3 việc bạn cần làm mỗi ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录。向AI提问。执行。每天只需做三件事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "记录。向AI提问。执行。每天只需做三件事。"
          }
        }
      }
    },
