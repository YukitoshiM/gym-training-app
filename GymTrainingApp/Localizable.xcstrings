        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisci le prossime azioni e gli obiettivi mensili in base alle registrazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録をまとめて次の行動と翌月目標を提案"
          }
