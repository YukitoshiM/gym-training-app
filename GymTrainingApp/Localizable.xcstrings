    "domain_catalog.38aea37fa327": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:39\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ مرفقيك مثنيين قليلًا، وافتح صدرك واجمع الدمبل معًا على شكل قوس."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenint els colzes lleugerament doblegats, obre el pit i uneix les manuelles formant un arc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohněte lokty jen mírně a otevřete hrudník, poté zvedejte činku směrem k tělu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj let i albuerne og åbn brystet, mens du skubber vægten mod dig."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beuge deine Ellbogen leicht und öffne dabei deine Brust, während du das Gewicht mit einer Bogenbewegung nach vorne ziehst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λυγίστε ελαφρώς τους αγκώνες σας και ανοίξτε το στήθος, μετακινώντας το ράβδο προς τα κάτω σχηματίζοντας μια καμπύλη."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and open your chest while lowering the dumbbell in an arc."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and open your chest while lowering the dumbbell in an arc."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and open your chest while lowering the dumbbell in an arc."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your elbows slightly bent and open your chest while lowering the dumbbell in an arc."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar el brazo hacia el costado, manteniendo los codos ligeramente doblados y acercando la barra."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Bajar el brazo hacia el costado, manteniendo los codos ligeramente doblados y acercando la barra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa rinta ja laske käsipainoa hieman, pidä kyynärpäät avoinna."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos coudes légèrement pliés et ouvrez votre poitrine, puis rapprochez l'haltère en formant une courbe."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos coudes légèrement pliés et ouvrez votre poitrine, puis rapprochez l'haltère en formant une courbe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથને હળવાશથી વાળીને છાતી ખોલો અને ડમ્બેલને હાથની તરફ ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתכופף מעט את הכתף ולפתוח את החזה, תוך יצירת קשת ולהזיז את הדסקית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कोहनी को थोड़ा मोड़े हुए स्थिति में, अपने सीने को खोलें और डम्बल को घुमाकर अपनी ओर खींचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Savijte ruke lagano i otprite prsnice, spuštajući uteg prema dolje u obliku luka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hajtja meg enyhén a karokat, és nyitassa a mellét, majd húzza lefelé a käsizt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menebuk siku sedikit, lalu membuka dada dan menarik dumbbell ke samping dengan membentuk lengkungan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni leggermente piegati i gomiti e apri il petto, spostando il manubrio lateralmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肘を軽く曲げたまま胸を開き、弧を描くようにダンベルを寄せる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가볍게 팔꿈치를 구부린 상태에서 가슴을 열고, 활 모양으로 덤벨을 몸쪽으로 당깁니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हलक्या पद्धतीने वाकलेले हात आणि छाती उघडा, हाताने डंबेल जवळ घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekalkan siku sedikit, kemudian membuka dada dan menarik dumbbell ke arah tersebut."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig je ellebogen licht en open je borst, terwijl je de dumbbell naar je toe beweegt in een boog."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy lett i albuene og åpne brystet, mens du skyver stangen mot deg med en bue."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatnie zgiń łokieć i otwórz klatkę piersiową, jednocześnie przesuwając ciężar wzdłuż uda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos levemente flexionados e incline o corpo para frente, levando o peso para baixo em arco."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os cotovelos levemente flexionados e incline o corpo para frente, levando o peso para baixo em arco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Menține antebrațul ușor îndoit și trage gantera spre tine, formând o arcadă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте локти слегка согнутыми и подтяните гантель к себе, формируя дугу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržte mierne ohnuté lakte a otvorte hrudník, pričom ohýbate činku smerom k vám."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite pozorni na položaj rok, odprite ramo in navoza s ute v obliki kroga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj lätt på armbågen och öppna bröstet, dra sedan hanteln inåt i en båge."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைகளை லேசாக மடக்கி, மார்பை திறந்து, டம்பலை பக்கவாட்டில் இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులను కొద్దిగా వంచి, ఛాతీని తెరిచి, వంపు తిరుగుతూ డంబెల్‌ను దగ్గరగా తీసుకురావడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งอข้อศอกเล็กน้อย และเปิดอก พร้อมกับดึงดัมเบลเข้าหา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirseğinizin hafifçe bükülmüş halde, göğsünüzü açın ve ağırlığı eğimli bir şekilde yanınıza doğru çekin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Злегка зігніть руки та відкрийте груди, утворюючи дугу, коли тримаєте гантелі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gập nhẹ khuỷu tay và đưa tay về phía ngực, tạo thành đường cong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻微弯曲肘部，并将身体向前打开，同时将哑铃向外拉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕微彎曲肘部，然後打開胸腔，將啞鈴向外推"
          }
        }
      }
    },
