    "health_meals_body_ai.1b0c2ec5452e": {
      "comment": "GymTrainingApp/Features/Meals/MealNutritionSourceViews.swift:197\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حفظ المنتجات غير المسجلة على الجهاز بعد إدخالها وإعادة استخدامها للفحص التالي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els productes no registrats es desaran al dispositiu després de ser introduïts i reutilitzats per a la següent exploració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky, které nejsou zařazeny, jsou uloženy na zařízení po zadání a mohou být použity při příštím čtení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uregistrerede varer gemmes på enheden efter indtastning og genbruges ved næste aflæsning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht registrierte Produkte werden nach der Eingabe auf dem Gerät gespeichert und beim nächsten Lesen wiederverwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μη καταχωρημένα προϊόντα αποθηκεύονται στην συσκευή μετά την εισαγωγή και χρησιμοποιούνται ξανά κατά την επόμενη ανάγνωση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that have not been registered will be saved to the device and reused in the next reading."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that have not been registered will be saved to the device and reused in the next reading."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that have not been registered will be saved to the device and reused in the next reading."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that have not been registered will be saved to the device and reused in the next reading."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los productos no registrados se guardan en el dispositivo y se reutilizan en la próxima lectura."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los productos no registrados se guardan en el dispositivo y se reutilizan en la próxima lectura."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekisteröimättömät tuotteet tallennetaan laitteelle ja niitä käytetään seuraavalla kerralla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles non enregistrés seront sauvegardés sur l'appareil après saisie et pourront être réutilisés lors de la prochaine lecture."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles non enregistrés seront sauvegardés sur l'appareil après saisie et pourront être réutilisés lors de la prochaine lecture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અપહાયેલી વસ્તુઓને દાખલ કર્યા પછી, તે ઉપકરણ પર સાચવવામાં આવશે અને આગલી વખતે ફરીથી ઉપયોગમાં લેવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצרים שלא רשומים יועברו למכשיר לאחר הקלטה ויוכלו לשמש שוב בקריאה הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पंजीकृत उत्पाद को दर्ज करने के बाद डिवाइस पर सहेजें और अगले रीडिंग में फिर से उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proizvodi koji nisu registrirani se spremaju na uređaj nakon unosa i ponovno se koriste u sljedećem čitanju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hiányzó terméket a rendszer azonosítja, és a következő olvasáskor újra felhasználható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Barang yang belum terdaftar akan disimpan ke perangkat setelah diinput, dan dapat digunakan kembali pada pengambilan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prodotti non registrati vengono salvati sul dispositivo dopo l'inserimento e riutilizzati nella lettura successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未登録商品は入力後に端末へ保存し、次回の読取で再利用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록되지 않은 상품은 입력 후 기기에 저장하고, 다음 수집 시 재사용합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंद न केलेल्या वस्तू नोंदीनंतर डिव्हाइसवर सेव्ह करा आणि पुढील वेळी पुन्हा वापरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Barang yang belum didaftarkan akan disimpan ke dalam peranti selepas anda memasukkan, dan boleh digunakan semula pada pembacaan berikutnya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet geregistreerde producten worden na invoer opgeslagen op het apparaat en kunnen opnieuw worden gebruikt bij de volgende meting."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Uregistrerte varer lagres på enheten etter inntasting og kan brukes igjen ved neste lesing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nierejestrowany produkt zostanie zapisany w urządzeniu po wprowadzeniu i wykorzystany podczas kolejnego odczytu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Produtos não registrados serão salvos no dispositivo após a entrada e reutilizados na próxima leitura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Produtos não registrados serão salvos no dispositivo após a entrada e reutilizados na próxima leitura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Produsele neînregistrate vor fi salvate pe dispozitiv după introducere și reutilizate la următoarea citire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После ввода, товары, которые еще не зарегистрированы, будут сохранены на устройстве и использованы при следующем считывании."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkt, ktorý zatiaľ nie je zaregistrovaný, sa po zadávaní uloží do zariadenia a bude použit pri nasledujúcom čítaní."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proizvodi, ki niso zabeleženi, bodo shranjeni na naprave po vnosu in uporabljeni pri naslednji brani."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ej registrerad produkt sparas på enheten efter inmatning och återanvänds vid nästa läsning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவு செய்யப்படாத பொருட்களை உள்ளிட்டு, அடுத்த முறை எடுக்கும்போது மீண்டும் பயன்படுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రికార్డ్ చేయని వస్తువులను నమోదు చేసిన తర్వాత పరికరంలో నిల్వ చేసి, తదుపరి రీడింగ్‌లో తిరిగి ఉపయోగించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สินค้าที่ไม่ลงทะเบียนจะถูกบันทึกลงในอุปกรณ์ และสามารถนำกลับมาใช้ใหม่ได้ในการอ่านครั้งต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmemiş ürünler, girdikten sonra cihazınıza kaydedilir ve bir sonraki okuma sırasında yeniden kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Реєстровані товари зберігаються на пристрої після введення та використовуються під час наступного зчитування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hàng hóa chưa đăng ký sẽ được lưu vào thiết bị sau khi nhập và sử dụng lại trong lần đọc tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未注册商品在输入后会保存到设备，并在下次读取时再次使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未注册商品在输入后保存到设备，并在下次读取时重新利用。"
          }
        }
      }
    },
