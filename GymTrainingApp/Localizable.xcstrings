        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शांतपणे विश्लेषण करणारे. नोंदींमधील बदलांवर लक्ष केंद्रित करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisis yang tenang. Memfokuskan pada satu perubahan daripada rekod"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Een rustige analyse. Beperk de veranderingen tot één punt in de gegevens."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En stille analytiker. Fokuser på én endring fra loggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cichy analityk. Skoncentruj się na jednej zmianie w danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analista discreto. Concentre-se em uma única mudança nos registros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Analista discreto. Concentre-se em uma única mudança nos registros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un analist calm. Concentrează-te pe modificarea unei singure aspecte din înregistrări"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный аналитик. Сосредоточьтесь на одном изменении, которое можно внести на основе записей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tichý analytik. Zamerajte sa na jednu zmenu v zázname."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiho analizirate. Izberite eno spremembo na podlagi podatkov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugn analysator. Fokusera på att identifiera en förändring från loggningen"
