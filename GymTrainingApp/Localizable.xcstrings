    "training.b2778f7f4f92": {
      "comment": "GymTrainingApp/Features/Plans/AIPlanCoachView.swift:38\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أتمكن من قراءة خطة الذكاء الاصطناعي. يرجى إنشائه مرة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No he pogut llegir el pla de l'IA. Si us plau, torna a crear-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se načíst plán od AI. Vytvořte jej znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke læse AI-planen. Opret den igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich konnte den KI-Plan nicht lesen. Bitte erstellen Sie ihn erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπόρεσα να διαβάσω τον σχεδιασμό της τεχνητής νοημοσύνης. Δημιουργήστε το ξανά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the AI plan. Please create it again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the AI plan. Please create it again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the AI plan. Please create it again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the AI plan. Please create it again."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el plan del entrenador AI. Por favor, créalo nuevamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el plan del entrenador AI. Por favor, créalo nuevamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-suunnitelmaa ei voitu lukea. Luo se uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le plan proposé par l'IA. Veuillez en créer un nouveau."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le plan proposé par l'IA. Veuillez en créer un nouveau."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI યોજના વાંચી શકી નથી. કૃપા કરીને ફરીથી બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את תוכנית האימון של ה-AI. אנא צור אותה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
