    "health_meals_body_ai.1313855c233c": {
      "comment": "GymTrainingApp/Features/Meals/MealListView.swift:847\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ستزداد دقة التقدير إذا قمت بتدوين المبلغ بقدر ما تعرفه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La precisió de l'estimació augmentarà si anoteu la quantitat tant com sabeu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud uvedete odhad, zvýší se přesnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mere du skriver, desto højere er estimeringsnøjagtigheden."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Je genauer Sie die Menge angeben, desto höher ist die Genauigkeit der Schätzung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο περισσότερες πληροφορίες γράψετε, τόσο αυξάνεται η ακρίβεια της εκτίμησης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you write down, the more accurate the estimate will be."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you write down, the more accurate the estimate will be."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you write down, the more accurate the estimate will be."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The more you write down, the more accurate the estimate will be."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si indicas la cantidad en la medida que puedas, aumentará la precisión de la estimación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si indicas la cantidad en la medida que puedas, aumentará la precisión de la estimación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos pystyt arvioimaan myös määrän, arvioinnin tarkkuus paranee."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si possible, indiquez également la quantité, ce qui améliore la précision de l'estimation."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si possible, indiquez également la quantité, ce qui améliore la précision de l'estimation."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે સમજી શકો તે મુજબ, તમે માત્રા પણ લખો, જેનાથી અંદાજની ચોકસાઈ વધે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ככל שתוסיפו יותר מידע, כך הערכת הדיוק תעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जितना संभव हो सके मात्रा लिखें, इससे अनुमान की सटीकता बढ़ेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako navedete količinu u mjeri koja vam je poznata, to će poboljšati preciznost procjene."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minél pontosabban írjuk meg az adatokkal, annál nagyobb lesz a becslés pontossága."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan mencantumkan jumlah yang diketahui, akurasi perkiraan meningkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicando la quantità nel modo possibile, aumenta la precisione della stima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分かる範囲で量も書くと、推定精度が上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알고 있는 범위 내에서 양도 기록하면 추정 정확도가 높아집니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जेवढे समजू शकता तेवढे प्रमाण लिहा, ज्यामुळे अंदाजे अचूकता वाढेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin banyak maklumat yang anda masukkan, semakin tepat anggaran tersebut."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf zoveel mogelijk op, zodat de schatting nauwkeuriger wordt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mer du skriver inn, desto bedre blir estimeringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisywanie ilości w miarę możliwości poprawia dokładność oszacowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais informações você fornecer, maior será a precisão da estimativa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais informações você fornecer, maior será a precisão da estimativa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Specifică cantitatea cât mai precis posibil pentru a îmbunătăți acuratețea estimării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите количество (в пределах разумного), чтобы повысить точность оценки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak uvediete odhad, presnosť sa zvýši."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če vnesete količino, kjer je to mogoče, se poveča natančnost izračuna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ju mer du skriver, desto högre blir uppskattningsnoggrannheten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தெரிந்து கொள்ளும் அளவிற்கு அளவையும் குறிப்பிடவும், இதன் மூலம் மதிப்பீட்டின் துல்லியம் அதிகரிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీకు తెలిసిన పరిమాణాన్ని కూడా నమోదు చేయడం ద్వారా, అంచనా యొక్క ఖచ్చితత్వం పెరుగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุปริมาณเท่าที่ทราบ เพื่อเพิ่มความแม่นยำในการประมาณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne kadar çok bilgi verirseniz, tahmin doğruluğu artar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вказуючи приблизну кількість, точність оцінки збільшиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc ghi lại số lượng (nếu biết) sẽ giúp tăng độ chính xác của ước tính."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尽可能填写量，这会提高估算精度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尽可能填写，可以提高估算精度。"
          }
        }
      }
    },
