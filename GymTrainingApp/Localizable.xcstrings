    "domain_catalog.deb749236745": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:313\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هادئ وواقعي. التعرف بشكل ملموس على الاستمرارات الصغيرة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranquil i realista. Reconeix de forma concreta les petites continuacions"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klidný a realistický. Konkrétně uznáváte i malé, ale trvalé úsilí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolig og realistisk. Anerkend små, vedvarende fremskridt konkret"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhevoll und realistisch: Kleine, kontinuierliche Erfolge konkret anerkennen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ήρεμος και ρεαλιστικός. Αναγνωρίζει συγκεκριμένα τα μικρά, σταθερά βήματα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Calm and realistic. Acknowledge small, consistent efforts"
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Calm and realistic. Acknowledge small, consistent efforts"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Calm and realistic. Acknowledge small, consistent efforts"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Calm and realistic. Acknowledge small, consistent efforts"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave y realista. Reconozca y valore los pequeños logros de forma concreta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave y realista. Reconozca y valore los pequeños logros de forma concreta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rauhallinen ja realistinen. Tunnista pienet, jatkuvat edistysaskeleet"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme et réaliste. Reconnaître concrètement les petits progrès."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme et réaliste. Reconnaître concrètement les petits progrès."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શાંત અને વાસ્તવિક. નાના, સતત પ્રયત્નોને ઓળખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רגוע ומציאותי, להכיר בצורה קונקרטית בשינויים הקטנים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत और व्यावहारिक। छोटे-छोटे निरंतर प्रयासों को स्पष्ट रूप से पहचानें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Umirujuće i praktične. Konkretno prepoznajte male, kontinuirane napore."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyugodtan és realista módon, az apró, folyamatos sikereket is figyelembe vesszük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenang dan realistis. Mengakui secara konkret upaya kecil yang berkelanjutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo e realistico, riconoscendo concretamente piccoli progressi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかで現実的。小さな継続を具体的に認める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평온하고 현실적이며, 작은 꾸준함을 구체적으로 인정"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शांत आणि वास्तववादी दृष्टिकोन, लहान प्रयत्नांना प्रोत्साहन देणे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenang dan praktikal. Mengakui usaha kecil secara khusus"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rustig en realistisch. Erken kleine, consistente inspanningen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolig og realistisk. Anerkjenn små, kontinuerlige fremskritt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojny i realistyczny. Uznaj konkretne małe postępy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo e realista, reconhecendo a importância da consistência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo e realista, reconhecendo a importância da consistência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Relaxat și realist. Recunoașteți concret progresul mic"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный и реалистичный. Подчеркивает важность небольших, но постоянных усилий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kľudný a realistický. Konkrétne uznávajte malé, ale trvalé úsilie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umirjeno in realistično. Upoštevajte majhne, redne napredek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugn och realistisk. Erkänn små, kontinuerliga framsteg konkret"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைதியாகவும், யதார்த்தமாகவும், சிறிய முன்னேற்றங்களை அங்கீகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శాంతంగా మరియు వాస్తవికంగా, చిన్న ప్రయత్నాలను గుర్తించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นไปอย่างสงบและสมจริง โดยยอมรับการฝึกฝนเล็กๆ น้อยๆ อย่างเฉพาะเจาะจง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin ve gerçekçi. Küçük, sürekli çabaları somut olarak kabul edin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійний і реалістичний. Конкретно визнавайте невеликі досягнення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh thản và thực tế, ghi nhận những tiến bộ nhỏ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平和而实际。具体地认可小的进步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平和且具備現實感。明確地確認小規模的持續"
          }
        }
      }
    },
