        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 측정 이후 시간이 경과했으므로, 변화를 단정하지 않고 범위를 두고 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील मापनापासून जास्त वेळ निघाल्याने, बदलाची निश्चितता नाही, त्यामुळे अंदाजे मूल्य वापरले आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": " kerana tempoh antara pengukuran terakhir, perubahan tidak dapat ditentukan dan mempunyai julat. "
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat er een periode zonder meetresultaten is, wordt de verandering niet definitief vastgesteld en wordt een marge aangehouden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Siden det har gått en stund siden siste måling, er endringen omtrentlig og kan variere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze względu na brak danych z ostatniego pomiaru, nie można jednoznacznie określić zmian. Wartość jest przybliżona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Devido ao tempo decorrido desde a última medição, a variação é estimada com uma margem de erro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Devido ao tempo decorrido desde a última medição, a variação é estimada com uma margem de erro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datorită lipsei de date recente, variația este estimată și poate avea o marjă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из-за отсутствия данных за последнее измерение, изменение оценивается с определенной погрешностью."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvôli prechode času od posledného merania, zmeny nevieme potvrdzovať a poskytujeme rozsah."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker je minilo čas od zadnje meritve, spremembe ne moremo potrditi in zato je vrednost omejena."
