    "domain_catalog.6ee5fb530229": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:224\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\nhu: NLLB fallback used because TranslateGemma mixed writing systems; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "حذرا وعاطفيا. العودة مع توضيح الحدود"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Acurat i empàtic. Torna aclarint els límits"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opatrný a empatický přístup, jasně definujte hranice a postupně se vracíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær forsigtig og empatisk. Find den rette balance, mens du vender tilbage."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsichtig und einfühlsam. Bringen Sie sich auf eine Weise zurück, bei der Ihre Grenzen klar sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσεκτικός και συμπονετικός. Καθορίζει τα όρια, αλλά επιτρέπει την επιστροφή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Careful and empathetic. Clearly define your limits and then return."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Careful and empathetic. Clearly define your limits and then return."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Careful and empathetic. Clearly define your limits and then return."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Careful and empathetic. Clearly define your limits and then return."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidadoso y empático. Regresa gradualmente, definiendo claramente tus límites."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuidadoso y empático. Regresa gradualmente, definiendo claramente tus límites."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varovainen ja empaattinen. Palautuminen selkeiden rajojen puitteissa"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez prudent et empathique. Retrouvez votre forme en clarifiant vos limites."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez prudent et empathique. Retrouvez votre forme en clarifiant vos limites."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાવચેત અને સહાનુભૂતિપૂર્ણ. પોતાની મર્યાદાને સ્પષ્ટ રીતે જાળવી રાખીને પાછા આવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גישה זהירה ואמפתית, תוך הגדרת גבולות ברורים וחזרה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सावधानी और सहानुभूतिपूर्ण। अपनी सीमा को स्पष्ट करते हुए वापस आएं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprezno i empatično, vraćanje uz jasno definiran granicu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Óvatos és együttérző."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhati-hati dan penuh empati. Kembali dengan menetapkan batas yang jelas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attento e empatico: ritornare definendo chiaramente i limiti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "慎重で共感的。限界を明確にしながら戻す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신중하고 공감하며, 한계를 명확히 하면서 복귀합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काळजी आणि समजूतदारपणे, मर्यादा स्पष्ट करून परत या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhati-hati dan memahami. Kembali dengan jelas mengenal pasti had"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorzichtig en empathisch, terwijl we de grenzen duidelijk maken en terugkeren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vær forsiktig og empatisk. Gå tilbake med tydelig definerte grenser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bądź ostrożny i empatyczny, jednocześnie jasno określając granice i pomagając w powolnym osiągnięciu celu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com cuidado e empatia, retorne de forma segura"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com cuidado e empatia, retorne de forma segura"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenție și empatie. Reia activitatea în mod controlat, stabilind limite clare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осторожный и сочувствующий подход, четкое определение границ и постепенное возвращение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Buďte opatrní a empatický. Vráťte sa postupne, zatiaľ čo jasne definujete svoje limity."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bodite previdni in razumeči. Učinkovito vračanje, pri čemer jasno določite meje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var försiktig och empatisk. Återställ med tydligt definierade gränser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கவனமாக, அதே நேரத்தில் ஆதரவாகவும், எல்லையைத் தெளிவாக வரையறுத்து, மீண்டும் செயல்பட ஊக்குவிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జాగ్రత్తగా మరియు సానుభూతితో, పరిమితులను స్పష్టంగా ఉంచుతూ తిరిగి రావడం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระมัดระวังและเข้าใจ เห็นความจำกัด และกลับสู่สภาพเดิมอย่างค่อยเป็นค่อยไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırlarınızı netleştirerek geri dönün"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обережно та з розумінням. Повертайтеся поступово, чітко визначаючи межі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cẩn trọng và đồng cảm, đưa ra quyết định phù hợp với khả năng của bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谨慎而富有同情心。 在明确界限的同时，逐步恢复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "谨慎而富有同情心。 在明确界限的同时，逐步恢复"
          }
        }
      }
    },
    "domain_catalog.6fbb94213999": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:343\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اثنِ ركبتيك قليلًا واسحب وركيك إلى الخلف لتمديد أوتار الركبة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Doble els genolls lleugerament i estira els malucs cap enrere per estirar els isquiotibials."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mírně ohněte kolena a zatáhněte kyčle dozadu, abyste protáhli hamstringy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj let i knæene, træk hofterne tilbage og stræk hamstrings."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Beugen Sie das Knie leicht und ziehen Sie die Hüften nach hinten, um die Oberschenkelrückseite zu dehnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λυγίστε ελαφρά τα γόνατά σας, τραβήξτε τους γοφούς προς τα πίσω και τεντώστε τους μύς του οπίσθιου μηρού."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your knees slightly and pull your hips back while stretching your hamstrings."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your knees slightly and pull your hips back while stretching your hamstrings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your knees slightly and pull your hips back while stretching your hamstrings."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bend your knees slightly and pull your hips back while stretching your hamstrings."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Doblar ligeramente las rodillas y tirar de la cadera hacia atrás para estirar los isquiotibiales."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Doblar ligeramente las rodillas y tirar de la cadera hacia atrás para estirar los isquiotibiales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taivuta polvia kevyesti ja vedä lonkki taaksepäin, jolloin reisilihakset venyvät."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Plier légèrement les genoux et tirer les hanches vers l'arrière pour étirer les ischio-jambiers."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Plier légèrement les genoux et tirer les hanches vers l'arrière pour étirer les ischio-jambiers."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું ઘૂંટણ હળવેથી વાળો, અને તમારા હિપ્સને પાછળની તરફ ખેંચીને તમારી હેમસ્ટ્રિંગ્સને લંબાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כיווץ שרירי העכוז תוך כיפוף קל של הברכיים והיטות מותניים אחורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने घुटनों को थोड़ा मोड़ें और अपने कूल्हों को पीछे की ओर खींचकर अपनी जांघों की मांसपेशियों को फैलाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagano savijte koljena i povucite zglobove prema nazad, napinujući hamstringove."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza meg a térdeit, és húzza vissza a csípőt, miközben a felső lábszárát kinyújtja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meluruskan lutut sedikit dan menarik sendi pinggul ke belakang sambil meregangkan hamstring."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piegare leggermente le ginocchia e tirare indietro le ginocchia per allungare i muscoli posteriori della coscia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "膝を軽く曲げ、股関節を後ろへ引いてハムストリングスを伸ばす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무릎을 약간 구부리고, 엉덩이를 뒤로 당겨 대퇴사두근을 스트레칭한다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गुडघे थोडे वाकवून, जांघच्या सांध्याला मागे ओढा आणि Hamstring स्नायूंना ताणून घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meregangkan lutut sedikit, dan menarik sendi paha ke belakang sambil meregangkan otot hamstring."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Buig je knieën licht en trek je heupen naar achteren om je hamstrings te strekken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy lett i knærne og trekk hoftene bakover for å strekke hamstrings."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatnie zgiń kolana i pociągnij biodra do tyłu, rozciągając uda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre levemente os joelhos e puxe as coxas para trás, alongando os isquiotibiais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobre levemente os joelhos e puxe as coxas para trás, alongando os isquiotibiais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îndoaie ușor genunchii și trage coapsele spre interior, întinzând astfel mușchii ischiului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слегка сгибать колени и тянуть ягодицы назад, чтобы растянуть бицепсы бедер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otočte kolená mierne a zatlačte boky dozadu, aby ste natiahli svaly medzi zadnými a vnútornými stranou stehien."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raztegni kolena, pritisnite kolena nazaj in raztegni hamstring."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Böj lätt på knäet och dra höfterna åt, samtidigt som du sträcker ut hamstrings."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முட்டிகளை லேசாக வளைத்து, இடுப்பை பின்னோக்கி இழுத்து, தொடை எலும்புகளை நீட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోకాళ్లను కొద్దిగా వంచి, తుంటిని వెనక్కి లాగి హమ్ స్ట్రింగ్స్‌ను సాగదీయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งอเข่าเล็กน้อย และดึงสะโพกไปด้านหลัง เพื่อยืดกล้ามเนื้อต้นขาด้านหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayak bileğinizi hafifçe bükün ve kalçalarınızı geriye çekerek hamstring kaslarınızı uzatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко зігнути коліна та відтягнути стегна назад, щоб розтягнути квадрицепси."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gập nhẹ khớp gối, kéo hông ra phía sau và duỗi cơ đùi sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻微弯曲膝盖，拉伸大腿前侧肌肉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微弯曲膝盖，拉动髋关节向后，伸展胀绳。"
          }
        }
      }
    },
