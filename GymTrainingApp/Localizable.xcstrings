        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä nosta käsillä, vaan käytä lantiota liikuttaaksesi kettlebelliä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne soulevez pas avec les bras, mais utilisez l'extension des hanches pour faire tournoyer le kettlebell."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne soulevez pas avec les bras, mais utilisez l'extension des hanches pour faire tournoyer le kettlebell."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાથથી વજન ઉપાડવાને બદલે, હિપ્સને ફેલાવીને કેટલ બેલને હલાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא להרים משקולות ביד, להשתמש בתנועת מפרקי הירך כדי לסובב את הכדור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी बाहों का उपयोग करके वजन न उठाएं, बल्कि अपने कूल्हों को फैलाकर केटलबेल को घुमाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemojte podižati s ruku, koristite kukove za rotiranje utega."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne emeld fel a karokat, hanem használj kettlebell-t a derékbontáshoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan mengangkat dengan lengan, tetapi gunakan gerakan peregangan pinggul untuk memutar kettlebell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevare i pesi con le braccia, evitando di sollecitare eccessivamente le articolazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕で持ち上げず、股関節の伸展でケトルベルを振る。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팔로 들어 올리지 않고, 힙 관절의 스트레칭으로 케틀벨을 움직입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हातांचा वापर न करता, घोट्याच्या हालचालीने केटल बेल फिरवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan mengangkat dengan tangan, gunakan gerakan lutut untuk mengayunkan kettlebell."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je armen niet om het gewicht te tillen, maar gebruik je heupen om kettlebells te bewegen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk armene til å løfte vekten, og bruk kneledd for å svinge kettlebell."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj podnoszenia ciężarów ramionami i używaj stawu biodrowego do obracania kettlebell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não use os braços para levantar, mas sim o movimento do quadril para balançar o kettlebell."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não use os braços para levantar, mas sim o movimento do quadril para balançar o kettlebell."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu folosiți brațele pentru a ridica greutăți, ci utilizați flexia șoldurilor pentru a mișca ganterele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не поднимайте вес руками, а используйте движение тазобедренного сустава для вращения гантели."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepoužívajte ruky na zdvíhanie, pohybujte kettlebellom pomocou pohybu v kolenách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne uporabljajte rok za dvigovanje uteži,ampak se gibajte s fleksijo kolen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd armarna för att lyfta, men använd istället höftböjningen för att vinka med kettlebell."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கைகளால் எடையை எடுக்காமல், உங்கள் இடுப்பு தசைகளை பயன்படுத்தி கேட் செல்-ஐ அசைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చేతులతో బరువును ఎత్తకుండా, కీళ్ల ద్వారా కేటెల్‌బెల్‌ను తిప్పండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แขนยก, ใช้การยืดกล้ามเนื้อสะโพกในการเหวี่ยงเคเทิลเบล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlığı kol yerine, kalça eklemlerini kullanarak kettlebell'i hareket ettir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не піднімайте вагу руками, використовуйте розтяжку стегон для обертання келеблом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không dùng tay để nâng tạ, sử dụng khớp háng để xoay quả bóng đệm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要用手臂抬起，而是通过髋关节的伸展来挥动哑铃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要用手來提起，而是利用髖關節的伸展來擺動壺鈴。"
          }
        }
      }
    },
