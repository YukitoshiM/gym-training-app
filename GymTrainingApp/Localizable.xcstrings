    "release_delta.estimate_disclaimer": {
      "comment": "GymTrainingApp/Features/BodyMetrics/BodyMetricListView.swift\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا نطاق تقديري وليس قياسًا. يتم حفظه فقط عند النقر عليه لمراجعة المحتوى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rang de referència, no és una mesura. Només es guarda si fas clic per veure el contingut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedná se o orientační hodnotu, nikoli o reálné měření. Uložte pouze po přečtení obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En referenceværdi, ikke et målt resultat. Gem kun, hvis du trykker for at se detaljerne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine Schätzung. Wird nur gespeichert, wenn Sie den Inhalt bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφορά ένα εύρος τιμών και δεν είναι μετρήσεις. Αποθηκεύεται μόνο όταν κάνετε κλικ για να δείτε την περιγραφή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference range, not a measurement value. Only saves if you tap to view the content."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference range, not a measurement. Save only when you tap to view the content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference range, not a measurement. Only saves if you tap to view the content."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a reference range, not a measurement. Save only when you tap to view the content."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango de referencia, no son valores medidos. Solo se guardan si tocas para ver el contenido."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango de referencia, no es una medición. Solo se guarda al tocar para confirmar el contenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viitealue, ei mitattu arvo. Tallennetaan vain, kun olet tarkastanut tiedot."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Fourchette de référence, et non une mesure réelle. Seules les informations tapées sont enregistrées."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fourchette indicative, pas une mesure réelle. Seule la sauvegarde est effectuée après avoir cliqué pour consulter le contenu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ માત્ર સંદર્ભ શ્રેણી છે, માપન નથી. જ્યારે તમે આ પર ટેપ કરો છો ત્યારે જ સાચવવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכה בלבד, לא מדובר בנתונים שנמדדו בפועל. שמור רק אם בדקת את המידע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक संदर्भ सीमा है, माप नहीं। केवल तभी सहेजें जब आप इस पर टैप करके सामग्री देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je samo okvir, a ne izmjarena vrijednost. Sprema se samo nakon što dodirnete i pročitate sadržaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Javított tartomány, nem mérés eredménye. Csak akkor mentve, ha megtekinted a tartalmat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah rentang perkiraan, bukan hasil pengukuran. Hanya disimpan jika Anda mengetuk untuk melihat isinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervallo di riferimento, non un valore misurato. Salva solo se hai visualizzato il contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参考範囲であり測定値ではありません。タップして内容を確認した場合だけ保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고 범위이며 측정값이 아닙니다. 내용을 확인한 경우에만 저장됩니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे केवळ अंदाजे मूल्य आहे, प्रत्यक्ष मापन नाही. एकदा तपासा आणि 'सेव्ह' करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah anggaran, bukan pengukuran. Simpan hanya jika anda menyentuh untuk melihat butiran."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een schatting, geen meetresultaat. Alleen als u op 'Bekijken' tikt, wordt deze opgeslagen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er et estimat, ikke en måling. Lagres kun hvis du trykker for å se detaljene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość przybliżona, nie jest to wynik pomiaru. Zapisuje się tylko po potwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma referência, não um valor medido. Salva apenas ao tocar para confirmar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma referência, não um valor medido. Só é guardado se tocar para ver o conteúdo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Valoare estimată, nu o măsurătoare reală. Se salvează doar dacă selectați această opțiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приблизительный диапазон, а не фактическое измерение. Сохраняется только после просмотра информации."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to len orientačná hodnota, nie meranie. Uloží sa iba po potvrdení obsahu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je samo okvirni izračun, ne rezultat meritev. Shranite le, če kliknete in preberete."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat på ett referensområde, inte en mätning. Sparas endast om du trycker för att se innehållet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது ஒரு குறிப்பு வரம்பாகும், அளவீட்டு மதிப்பு அல்ல. இதைத் தட்டினால் மட்டுமே சேமிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది సూచన పరిధి మాత్రమే, కొలత కాదు. దీనిని చూడటానికి నొక్కడం ద్వారా మాత్రమే సేవ్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นเพียงช่วงค่า ไม่ใช่ค่าที่วัดได้ เมื่อคุณแตะเพื่อดูเนื้อหา จะมีการบันทึกเฉพาะเมื่อนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece bir referans aralığıdır, ölçüm değeridir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це орієнтовний діапазон, а не вимірювання. Збережено лише після натискання для перегляду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là phạm vi ước tính, không phải giá trị đo. Chỉ lưu khi bạn nhấn để xem chi tiết."
