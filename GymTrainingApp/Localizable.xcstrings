    "domain_catalog.c4c8f8c07255": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:216\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع ذراعيك خلف ظهرك على مقعد مائل وقم بثني العضلة ذات الرأسين من وضعية التمدد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Col·loca els braços darrere de l'esquena en un banc inclinat i flexiona els bíceps des d'una posició estirada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehněte si na šikmou lavici, položte ruce za sebe a ohněte paže v loktech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg dine arme bag dig på en skrånende bænk og stræk biceps, før du bøjer armene."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einer Bank mit Neigung die Arme nach hinten legen und von der Position aus, in der die Bizepsmuskeln gestreckt sind, abwinkeln."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθετήστε τα χέρια σας στο πλάι, σε μια θέση που τεντώνει τους δικεφάλους."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on an inclined bench with your arms behind you, and bend at the elbow from this position."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on an inclined bench with your arms behind you, and bend at the elbow from this position."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on an inclined bench with your arms behind you, and bend at the elbow from this position."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Lie on an inclined bench with your arms behind you, and bend at the elbow from this position."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar los brazos hacia atrás en un banco inclinado y flexionar desde esa posición, estirando los bíceps."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar los brazos hacia atrás en un banco inclinado y flexionar desde esa posición, estirando los bíceps."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta kädet penkin kulmaan ja venytä toinen käsi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous sur un banc incliné, placez vos bras derrière vous et pliez les biceps."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Asseyez-vous sur un banc incliné, placez vos bras derrière vous et pliez les biceps."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઢોળાવવાળા બેન્ચે તમારા હાથને પાછળ મૂકો અને ડાયાફ્રેમની સ્થિતિમાં વાળો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שכב על ספסל משופע, הניח את הידיים מאחורי הגב והרם אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ढलान वाली बेंच पर, अपने हाथों को पीछे की ओर रखकर, और द्वि-मुस्कल को फैलाकर, धीरे-धीरे नीचे करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjedite na nagibu i položite ruke iza sebe, zatim se savnite u položaju gdje ste istezali bisep."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üljen egy döntős széktoron, és húzza a karokat a bicepsei kiterjesztett helyzetéből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbaring di bangku dengan posisi lengan di belakang, lalu tekuk siku dari posisi tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia le braccia su una panca inclinata, nella posizione in cui si contraggono i bicipiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傾斜ベンチで腕を後ろに置き、二頭筋を伸ばした位置から曲げる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경사벤치를 이용하여 팔을 뒤로 젖히고, 이두근이 늘어난 위치에서 팔을 구부립니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तिरकस बेंचवर हात मागे ठेवून, बाइसेप्स (दोन्ही हातांचे स्नायू) ताणून घ्या आणि हळू हळू खाली आणा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan lengan di belakang bangku dengan kemiringan, dan tekuk dari kedudukan yang meregangkan bisep."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga op een hellend bankje zitten, plaats je armen achter je en buig vanuit deze positie om je biceps te trainen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasser armene bak deg på en benk med skråning, og strekk ut biceps før du bøyer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połóż ręce na ławce i zgiń ramiona w pozycji, w której rozciągasz dwugłowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se no banco inclinado, com os braços atrás do corpo, na posição em que os bíceps estão esticados e flexione os braços."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deite-se no banco inclinado, com os braços atrás do corpo, na posição em que os bíceps estão esticados e flexione os braços."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Așază-ți brațele înapoi pe banca cu pante, din poziția în care mușchii bicepsului sunt întinși și apoi îndoaie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сядьте на скамью под углом, расположите руки за спиной в положении, когда бицепс находится в растяжении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na šikmú lavicu položte ruky za seba a ohnite sa z pozície, kedy ste stiahli dvojité svaly."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedeč na nakloni, položite roke nazaj in se zasukajte v položaju, ko so vaši dvignjeni členki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligg på en lutande bänk med armarna bakom dig, i positionen där biceps är sträckta. Böj sedan armarna från den positionen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாய்வான இருக்கையில், உங்கள் கைகளை பின்னோக்கி வைத்து, பைசெப்ஸை நீட்டி, பின்னர் அதை மடக்குங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వాలు ఉన్న బెంచ్‌పై చేతులను వెనుకకు ఉంచి, బైసెప్స్‌ను సాగదీసిన స్థితి నుండి వంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นั่งบนม้านั่งที่มีความลาดชัน วางแขนไว้ด้านหลัง และงอที่กล้ามเนื้อไบเซป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğimli bankta, iki bacağın da yere değdiğini ve biceps kaslarını uzattığını düşünerek, o pozisyondan bükül."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Покладіть руки на нахилену лавку, у положенні, коли розтягуєте біцепс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tay lên ghế dốc, sau đó gập khuỷu tay để kéo cơ bắp hai đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在倾斜式凳子上，将手臂向后伸展，然后从二头肌伸展的位置弯曲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在傾斜長凳上，將手臂放在後方，從伸展二頭肌的位置彎曲。"
          }
        }
      }
    },
