    "health_meals_body_ai.35a91d364b5f": {
      "comment": "GymTrainingApp/Data/LocalAIClient.swift:909\nPlaceholders: {{value1}}\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}يرجى المحاولة مرة أخرى. التسجيل اليدوي لا يزال متاحا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Si us plau, torna-ho a provar. La gravació manual encara està disponible."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Zkuste to znovu. Ruční záznamy jsou stále k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Prøv igen. Manuel registrering er stadig tilgængelig."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Bitte erneut versuchen. Die manuelle Eingabe ist weiterhin möglich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Παρακαλούμε να προσπαθήσετε ξανά. Μπορείτε ακόμα να καταγράψετε χειροκίνητα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Try again. You can still use manual recording."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Try again. You can still use manual recording."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Try again. You can still use manual recording."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Try again. You can still use manual recording."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Intente de nuevo. Puede seguir utilizando la grabación manual."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Intente de nuevo. Puede seguir utilizando la grabación manual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile {{value1}} kertaa uudelleen. Manuaalinen kirjaus on edelleen käytettävissä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Veuillez réessayer. Vous pouvez toujours enregistrer manuellement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Veuillez réessayer. Vous pouvez toujours enregistrer manuellement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} ફરી પ્રયાસ કરો. મેન્યુઅલ રેકોર્ડિંગનો ઉપયોગ કરવાનું ચાલુ રાખી શકાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}נסה שוב. ניתן להמשיך להשתמש בתיעוד ידני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया {{value1}} बार फिर प्रयास करें। आप अभी भी मैन्युअल रिकॉर्डिंग का उपयोग कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Ponovite pokušaj. Možete i dalje koristiti ručni unos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, {{value1}}-szer újra próbálja. A manuális rögzítés továbbra is használható."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Silakan dicoba lagi. Anda tetap dapat menggunakan pencatatan manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Riprova. Puoi continuare a utilizzare la registrazione manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}再試行してください。手動記録は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} 다시 시도해 주세요. 수동 기록은 계속 이용 가능합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} पुन्हा प्रयत्न करा. मॅन्युअल रेकॉर्डिंग अजूनही उपलब्ध आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Sila cuba semula. Anda boleh terus menggunakan senarai manual."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Probeer het opnieuw. Handmatige registratie blijft mogelijk."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Prøv igjen. Du kan fortsatt bruke manuell registrering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Spróbuj ponownie. Możesz nadal ręcznie wprowadzać dane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Tente novamente. A gravação manual continua disponível."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Tente novamente. A gravação manual continua disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Reîncepeți. Puteți continua să înregistrați manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Повторите попытку. Вы можете продолжать использовать ручной ввод данных."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} skúste to znovu. Ručné zaznamenávanie je stále k dispozícii."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} Poskusite znova. Ročno vnos je še vedno na voljo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}}Försök igen. Du kan fortfarande använda manuell registrering."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} மீண்டும் முயற்சிக்கவும். கைமுறையாக பதிவு செய்வது தொடர்ந்து பயன்படுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "{{value1}} మళ్లీ ప్రయత్నించండి. మాన్యువల్ రికార్డింగ్ కొనసాగించవచ్చు."
          }
