        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील नोंदीनुसार, आवाज ८५ dBA पेक्षा कमी आहे. तसेच, वेळ तपासणे आवश्यक आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai terkini ialah kurang daripada 85 dBA. Sila periksa juga tempoh."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "De waarde is minder dan 85 dBA. Controleer ook de duur van de blootstelling."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien er under 85 dBA. Sjekk også varigheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
