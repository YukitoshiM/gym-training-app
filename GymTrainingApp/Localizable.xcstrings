    "training.active_workout_saved": {
      "comment": "GymTrainingApp/Features/Workout/WorkoutSessionView.swift:153\nar-SA: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nca: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hans: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nzh-Hant: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。\nhr: 機械翻訳。健康・推定表現は公開前に人手確認が必要です。",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا أوقفت، يمكنك حفظ محتوى التمرين الحالي ومواصلة من حيث توقفت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si interrompeu, es guardarà el contingut actual i podeu reprendreu des d'on heu deixat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud přerušíte, uloží se aktuální série a můžete pokračovat později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmer nuværende sæt, så du kan fortsætte senere."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie unterbrechen, werden die aktuellen Sätze gespeichert und können später fortgesetzt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν διακοπεί, μπορείτε να αποθηκεύσετε την τρέχουσα σειρά και να συνεχίσετε αργότερα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Save current workout and resume later."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Save current workout and resume later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save current workout and continue later."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Save current workout and resume later."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si interrumpes, se guardará el contenido actual y podrás reanudar desde donde lo dejaste."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si interrumpes, guarda el contenido actual y continúa más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytäminen tallentaa nykyisen sarjan ja voit jatkaa myöhemmin."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous interrompez, votre entraînement actuel sera sauvegardé pour reprendre plus tard."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas d'interruption, enregistrez votre progression actuelle et reprenez plus tard."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે વર્કઆઉટમાં વિરામ લો, તો તમારી વર્તમાન સેટની માહિતી સાચવવામાં આવશે અને તમે પછીથી ફરીથી શરૂ કરી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם תפסיקו, תוכלו לשמור את התכנית הנוכחית ולהמשיך ממנה מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप रुकते हैं, तो वर्तमान सेट को सहेजें और बाद में फिर से शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako prekidate, spremljujete trenutni set i možete nastaviti kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megszakítod, az aktuális edzés tartalmat megőrzöd, és később folytathatod."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan set saat ini, lalu lanjutkan nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompere salva l'allenamento corrente, per riprenderlo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断すると現在のセット内容を保存し、あとで続きから再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단 시 현재 세트 내용을 저장하고 나중에 다시 시작할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र थांबवल्यास, सध्याचे सेट जतन करा आणि नंतर पुन्हा सुरू करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan set semasa. Anda boleh meneruskan daripada di mana anda berhenti."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je stopt, sla je huidige set op en hervat het later."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre gjeldende treningssett, slik at du kan fortsette senere."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwanie treningu zapisze obecny zestaw i pozwoli na wznowienie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interromper, salve o treino atual e continue depois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromper salva o treino atual, para continuar mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă întrerupi, salvezi setul curent și poți relua de unde ai rămas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните текущий набор упражнений и продолжите позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak prestanete, uložíte aktuálny set a môžete pokračovať neskôr."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeprav prekinete, lahko shranite trenutno serijo in nadaljujete pozneje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara nuvarande set och fortsätt senare."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடைநிறுத்தினால், தற்போதைய பயிற்சி விவரங்களை சேமித்து, பின்னர் தொடர்ச்சியாக மீண்டும் தொடங்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వ్యాయామం మధ్యలో ఆపి, తర్వాత కొనసాగించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากหยุด ใช้งานเซ็ตปัจจุบันได้ และกลับมาทำต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğer antrenmanı kesersen, mevcut set içeriğini kaydedebilir ve daha sonra devam edebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо призупинити, збережіть поточний набір і продовжте пізніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu lại tập hiện tại để tiếp tục sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中断时，可保存当前训练内容，稍后从上次继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停後，可保存當前訓練內容並稍後從該處繼續。"
          }
        }
      }
    },
