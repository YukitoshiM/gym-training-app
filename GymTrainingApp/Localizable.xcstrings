    "health_meals_body_ai.755d793eabaa": {
      "comment": "GymTrainingApp/Features/Health/ConditionDashboardView.swift:582\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "التعرض مرتفع. إذا استمر لفترة طويلة، يرجى استخدامه كمرجع لتقليل حجم ومدة الإقامة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exposició és alta. Si continua durant molt de temps, utilitzeu-lo com a referència per reduir el volum i la durada de l'estada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je vystavení vysoké, použijte to jako vodítko pro omezení hlasitosti a doby trvání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis eksponeringen er høj, kan du bruge lydstyrke og varighed som en guide, hvis det fortsætter over længere tid."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Belastung hoch ist, verwenden Sie die Informationen zur Reduzierung der Dauer und Lautstärke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκθεση είναι υψηλή. Εάν διαρκεί για μεγάλο χρονικό διάστημα, χρησιμοποιήστε το ως οδηγό για τη μείωση του χρόνου και της έντασης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates high exposure. If prolonged, use it to reduce volume and duration."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates high exposure. If prolonged, use it to reduce volume and duration."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates high exposure. If prolonged, use it to reduce volume and duration."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This indicates high exposure. If prolonged, use it to reduce volume and duration."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la exposición es alta, utilice esto como guía para reducir el tiempo y la duración."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la exposición es alta, utilice esto como guía para reducir el tiempo y la duración."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Altistus on korkea. Jos altistus kestää pitkään, käytä ääntä ja oleskeluaikoja ohjeena."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous êtes exposé pendant une longue période, utilisez-le comme guide pour réduire le volume et la durée."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous êtes exposé pendant une longue période, utilisez-le comme guide pour réduire le volume et la durée."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જો તમે લાંબા સમય સુધી આ પ્રવૃત્તિ કરતા હો, તો અવાજ અને સમયની લંબાઈ ઘટાડવા માટે આનો ઉપયોગ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רמת החשיפה גבוהה. אם זה נמשך זמן רב, השתמשו בה כנקודת ייחוס להפחתת עוצמה וזמן פעילות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि यह लंबे समय तक रहता है, तो ध्वनि और रहने की अवधि को कम करने के लिए इसका उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako traje dugo, koristite ovo kao smjernicu za smanjenje glasine i vremena boravka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha hosszú ideig tart, használja a hangszint és az időtartam szabályozására való tájékoztatást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika terpapar terlalu lama, gunakan sebagai panduan untuk mengurangi volume dan durasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'esposizione è elevata, consulta le informazioni sull'attenuazione del volume e sulla durata per periodi prolungati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曝露が高めです。長時間続く場合は音量や滞在時間を抑える参考にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노출량이 높습니다. 장기간 지속되는 경우 소리나 체류 시간을 줄이는 기준으로 활용하십시오."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर जास्त वेळ लागला, तर आवाज आणि वेळेचे व्यवस्थापन करण्यासाठी याचा संदर्भ घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ia berterusan dalam tempoh lama, gunakan sebagai panduan untuk mengurangkan volume dan masa yang dihabiskan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u langere tijd intensief traint, gebruik dan deze informatie om de duur en het volume te beperken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du opplever høy belastning over lengre tid, bruk dette som en guide for å redusere volum og varighet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ćwiczenia trwają długo, użyj tego jako wskazówki, aby ograniczyć czas i poziom intensywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a exposição for alta, utilize como guia para reduzir o tempo e a duração da atividade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a exposição for alta, utilize como guia para reduzir o tempo e a duração da atividade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Expunerea este ridicată. Dacă durează mult, folosiți volumul și durata sesiunii ca ghid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы испытываете повышенную нагрузку, используйте информацию о продолжительности и громкости для контроля."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak trvá dlho, použite to ako referenčný bod pre zníženie hlasitosti a dĺžky trvania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Časovno trajanje je lahko daljše. Upoštevajte to, da zmanjšate glasnost in čas, preživljene v aktivnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om exponeringen är hög, använd ljudnivå och tidsuppehåll som en guide för att minska den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது அதிக அளவில் உள்ளது. நீண்ட நேரம் நீடித்தால், ஒலியின் அளவையும், நேரத்தையும் குறைத்துக்கொள்ளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎక్కువగా బహిర్గతం అవుతున్నారు. ఎక్కువసేపు కొనసాగితే, వాల్యూమ్ మరియు నివాస సమయాన్ని తగ్గించడానికి ఇది సహాయపడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากยาวนาน ควรพิจารณาจากระยะเวลาและปริมาณเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maruz kalma yüksek seviyede olabilir. Uzun süreli aktivitelerde ses seviyesini ve egzersiz süresini kontrol etmenize yardımcı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви відчуваєте підвищений рівень, використовуйте це як орієнтир для зменшення тривалості та гучності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu mức độ tiếp xúc cao, hãy tham khảo việc giảm thời gian và thời lượng để kiểm soát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暴露较高。如果持续较长时间，请参考音量和停留时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暴露程度较高。如果持续较长时间，请参考音量和停留时间的控制。"
          }
        }
      }
    },
