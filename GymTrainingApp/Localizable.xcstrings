    "domain_catalog.e85958c34f0b": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:329\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "اتخذ خطوة، وقم بمحاذاة الركبة وأصابع القدم في ساقك الأمامية، ثم انزل للأسفل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes un pas, alinea el genoll i els dits dels peus de la cama davantera i enfonsa't."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělejte krok dopředu a zvedněte koleno přední nohy a prsty, dokud se nezaměří."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et skridt frem og juster knæet og tåen på forfoden, så de er i samme retning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt machen und das Knie und die Zehen des vorderen Beins ausrichten und absenken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάρτε ένα βήμα, ευθυγραμμίζοντας τους αστραγάλους και τις φτέρνες του μπροστινού ποδιού."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Step forward, aligning the knee and toe of your front leg before lowering."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Step forward, aligning the knee and toe of your front leg before lowering."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Step forward, aligning the knee and toe of your front leg before lowering."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Step forward, aligning the knee and toe of your front leg before lowering."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un paso hacia adelante, alineando la rodilla y el pie delantera y hundiendo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Da un paso hacia adelante, alineando la rodilla y el pie delantera y hundiendo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota yksi askel eteenpäin ja laskeudu, pitäen etujalan polven ja varpaiden suunnan samana."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire un pas en avant, en alignant les genoux et les pointes des pieds du membre avant."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire un pas en avant, en alignant les genoux et les pointes des pieds du membre avant."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એક પગ મૂકો, આગળના પગના ઘૂંટણ અને પંજાને એકસાથે લાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צעד אחד קדימה, והשחיתו את הברך והטבור של הרגל הקדמית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक कदम आगे बढ़ें और अपने सामने के पैर के घुटने और पैर की उंगलियों को संरेखित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaroni korak, uskladiti koljeno prednje noge i prste i spustite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél egy lépést, és igazítsd el a lábadat, majd merülj bele."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil satu langkah maju, sejajarkan lutut dan ujung jari kaki depan, lalu turunkan tubuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare un passo avanti, allineando il ginocchio e la punta del piede anteriore e abbassandosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一歩踏み出し、前脚の膝とつま先の向きを揃えて沈み込む。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 걸음 내딛고, 앞발의 무릎과 발끝을 정렬하며 내려간다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पाऊल पुढे टाका, समोरच्या पायाच्या गुडघ्याला आणि पायाच्या टोकाला जुळवून घ्या."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil satu langkah, sejajarkan lutut dan jari kaki kaki depan, kemudian masuk."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een stap voorwaarts en laat je knie en tenen van de voorste voet naar elkaar toe vallen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ett skritt fremover, og senk deg ved å justere knærne og tærne på forfoten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób krok do przodu, dopasowując kąt kolan i palców u stóp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um passo à frente, alinhando os joelhos e os dedos do pé da perna dianteira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um passo à frente, alinhando os joelhos e os dedos do pé da perna dianteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți un pas înainte și aliniați genunchiul și vârful piciorului din fața, apoi aprofundați."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте шаг вперёд и опуститесь, выровняв колено передней ноги и носок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Urob krok dopredu a zameraj sa na zarovnanie kolien a pätiek prednej nohy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopite, usmerite kolena prednjega noge in stopala proti sebi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ett steg framåt och sänk ner kroppen genom att rikta knät och tår på främre benet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு அடி எடுத்து வைத்து, முன் காலின் முழங்கால் மற்றும் கால் விரல்களை சீரமைத்து இறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక అడుగు వేసి, ముందు కాళ్ళ మోకాలు మరియు వేళ్ల దిశను సమలేఖనం చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก้าวเท้าข้างหนึ่ง แล้วปรับให้เข่าและปลายเท้าของเท้าข้างนั้นชี้ไปในแนวเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir adım atın, ön bacağınızın dizini ve ayak ucuyla yere temas edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть крок вперед і опускайтеся, вирівнюючи коліно передньої ноги та п'яту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước một bước, căn chỉnh đầu gối và ngón chân của chân trước rồi hạ xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迈出一步，调整前脚膝盖和脚尖的方向，然后下沉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向前邁一步，調整前腳膝蓋和腳尖的方向，然後沉入。"
          }
        }
      }
    },
