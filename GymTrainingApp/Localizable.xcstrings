          "stringUnit": {
            "state": "translated",
            "value": "Checked waist circumference by combining front and back views."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked waist circumference by combining front and back views."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "He comprobado la circunferencia de la cintura combinando las vistas frontal y trasera."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "He comprobado la circunferencia de la cintura combinando las vistas frontal y trasera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
