          "stringUnit": {
            "state": "translated",
            "value": "Uchopte tyč blízko těla a provádějte cvik, dokud necítíte nepohodlí v rameni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk stangen op tæt på kroppen, uden at der opstår ubehag i skulderen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die Stange in der Nähe Ihres Körpers hoch und achten Sie darauf, dass keine Beschwerden im Schulterbereich entstehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε τη μπάρα κοντά στο σώμα σας, χωρίς να προκαλείται αίσθηση στο ώμο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the bar up close to your body, keeping it within a range that doesn't cause discomfort in your shoulders."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the bar up close to your body, keeping it within a range that doesn't cause discomfort in your shoulders."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the bar up close to your body, keeping it within a range that doesn't cause discomfort in your shoulders."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the bar up close to your body, keeping it within a range that doesn't cause discomfort in your shoulders."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostenga la barra cerca del cuerpo y levántela, evitando molestias en los hombros."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostenga la barra cerca del cuerpo y levántela, evitando molestias en los hombros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tanko lähellä vartaloa ja nosta se ylös, jättäen olkapäille riittävästi tilaa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez le bar près de votre corps et effectuez l'exercice sans ressentir de douleur au niveau des épaules."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez le bar près de votre corps et effectuez l'exercice sans ressentir de douleur au niveau des épaules."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરીરની નજીક બારને ખેંચો અને એવી રીતે કરો કે જેથી ખભા પર કોઈ દુખાવો ન થાય."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משך את המוט קרוב לגוף, תוך שמירה על טווח תנועה שאינו גורם לאי נוחות בכתפיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर के करीब बार को उठाएं और जहां तक संभव हो, बिना किसी परेशानी के।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podignite uteg blizu tijela i izvodite vježbu u granicama, gdje ne osjećate nelagodu u ramenima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a pántot test közelségében, és emelje fel a hátát, figyelve, hogy ne legyen fájdalom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik bar mendekati tubuh, dan lakukan dalam rentang yang tidak menyebabkan ketidaknyamanan pada bahu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la barra vicino al corpo e solleva, evitando qualsiasi fastidio alle spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーを体の近くで引き上げ、肩に違和感が出ない範囲で行う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바를 몸 가까이에 당겨 올리고, 어깨에 불편함이 없는 범위 내에서 실시합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीराच्या जवळ बार उचलून, ज्यामुळे खांद्यावर ताण येणार नाही अशा पद्धतीने करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik bar sedekat mungkin dengan badan, dan lakukan dalam julat yang tidak menyebabkan rasa sakit pada bahu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Til het gewicht dicht bij je lichaam op, zodat er geen ongemak in je schouders ontstaat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekk stangen nær kroppen, og utfør øvelsen innenfor et område hvor du ikke opplever ubehag i skuldrene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciągnij pręt blisko ciała, zachowując komfort i unikając dyskomfortu w barkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a barra perto do corpo e levante-a, mantendo os ombros confortáveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a barra perto do corpo e levante-a, mantendo os ombros confortáveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trageți bara cât mai aproape de corp, fără a provoca disconfort în umăr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите штангу близко к телу и поднимайте ее, не вызывая дискомфорта в плечах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdvihnite tyč blízko tela a robte to v rozsahu, ktorý nepríčinia nepohodlie v ramene."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podajte bar blizu telesa in izvajajte, da ne bo bolečine v ramenih."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra stången nära kroppen och utför övningen så att det inte känns obekvämt i axlarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடலின் அருகில் பட்டையை இழுத்து, தோலில் அசௌகரியம் ஏற்படாத வகையில் பயிற்சி செய்யுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శరీరం దగ్గర బార్‌ను పైకి లాగండి, భుజాలకు అసౌకర్యం కలగకుండా జాగ్రత్త వహించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงบาร์ขึ้นใกล้กับตัว โดยให้รู้สึกสบาย ไม่มีการเสียดสีกับไหล่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barı vücudunuza yakın bir yerden kaldırın ve omuzlarınızda herhangi bir rahatsızlık hissetmediğiniz bir aralıkta yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте ганець близько до тіла та виконуйте підйом, не відчуваючи дискомфорту в плечах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thanh gần thân và thực hiện bằng cách nâng lên, đảm bảo không gây đau nhức cho vai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将杠杆靠近身体，在不引起肩部不适的范围内进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将杠铃靠近身体，在不引起肩部不适的范围内进行。"
          }
        }
      }
    },
