    "training.8011c7f226da": {
      "comment": "GymTrainingApp/Features/Plans/PlanEditorView.swift:374\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعتان من 3 أحداث لكل منهما. اضبط الوزن إلى مستوى معقول واحفظه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "2 sèries de 3 esdeveniments cadascun. Ajusteu el pes a un nivell raonable i estalvieu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "3 položky, 2 série. Upravte váhu tak, aby byla bezpečně proveditelná a uložte ji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "3 øvelser, 2 sæt hver. Juster vægten, så det er realistisk, og gem den."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Übungen, jeweils 2 Sätze. Passen Sie das Gewicht an, um es zu speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ασκήσεις, 2 σετ. Προσαρμόστε το βάρος ώστε να είναι εφικτό και αποθηκεύστε το."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform 3 exercises in 2 sets each. Adjust the weight to a comfortable level and save it."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform 3 exercises in 2 sets each. Adjust the weight to a comfortable level and save it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform 3 exercises in 2 sets each. Adjust the weight to a comfortable level and save it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Perform 3 exercises in 2 sets each. Adjust the weight to a comfortable level and save it."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ejercicios, 2 series cada uno. Ajusta el peso para que sea factible y guárdalo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ejercicios, 2 series cada uno. Ajusta el peso para que sea factible y guárdalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 eri liikettä 2 sarjaa. Säädä painot niin, että ne ovat sopivia."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "3 exercices, 2 séries chacune. Ajustez le poids pour qu'il soit adapté et enregistrez-le."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "3 exercices, 2 séries chacune. Ajustez le poids pour qu'il soit adapté et enregistrez-le."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "3 વસ્તુઓને 2 સેટમાં. શક્ય હોય તેટલું હળવું વજન પસંદ કરો અને સાચવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "3 סוגים בשני סטים. יש להתאים את המשקל כך שיהיה נוח ולשמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 प्रकारों को 2 सेट में। बिना किसी परेशानी के, उचित वजन के अनुसार सेव करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 vrste, 2 seta. Prilagodite težinu kako bi bilo moguće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "3 feladat 2x. Azonnali igényt kielégítő súlyra állítsuk be, majd rögzítsük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3 jenis dalam 2 set. Sesuaikan beratnya agar sesuai, lalu simpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3 esercizi, 2 serie ciascuno. Regola il peso per evitare sforzi eccessivi e salva i dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3種目を2セットずつ。無理のない重量に調整して保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3가지 운동을 2세트씩 진행합니다. 무리 없는 무게로 조절하여 저장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 प्रकार, प्रत्येकी 2 सेटमध्ये. आपल्या क्षमतेनुसार योग्य वजनानुसार नोंदवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "3 jenis latihan dalam 2 set. Sesuaikan berat yang sesuai dan simpan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "3 verschillende activiteiten, elk 2 sets. Pas de gewichten aan zodat ze veilig zijn en sla ze op."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "3 øvelser, 2 sett hver. Juster vekten slik at det er komfortabelt, og lagre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ćwiczenia po 2 serie. Dostosuj wagę do możliwości i zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3 exercícios em 2 séries. Ajuste o peso para que seja confortável e salve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "3 exercícios em 2 séries. Ajuste o peso para que seja confortável e salve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "3 exerciții, câte 2 seturi. Ajustați greutatea pentru a fi realistă și salvați-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3 вида продуктов по 2 раза. Подберите подходящий вес и сохраните."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "3 druhy aktivít po 2 série. Upravte váhu tak, aby bola bezpečná, a uložte ju."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 različne aktivnosti, po 2 seriji. Nastavite primerno težo in shranite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "3 övningar, 2 set vardera. Justera vikten så att det är bekvämt och spara."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "3 வகைகளை 2 செட்களாக. பாதுகாப்பான எடையை சரிசெய்து சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "3 రకాల ఆహారాలను 2 సెట్లుగా ఉంచండి. సులభంగా ఉండే బరువుకు అనుగుణంగా మార్చుకుని సేవ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "2 เซ็ตสำหรับ 3 อย่าง ปรับน้ำหนักให้เหมาะสมและบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 farklı egzersizi 2 set halinde yapın. Kolayca ulaşabileceğiniz ağırlıklarda ayarlayın ve kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "3 види діяльності по 2 рази. Налаштуйте вагу відповідно до ваших можливостей і збережіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 loại thực phẩm, mỗi loại 2 lần. Điều chỉnh trọng lượng để phù hợp và lưu lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种动作2组，请调整到合适的重量并保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分为3种，每种2组。请调整到合适的重量并保存。"
          }
        }
      }
    },
