    "health_meals_body_ai.c1b1833378f2": {
      "comment": "GymTrainingApp/Features/Reports/AIReportView.swift:517\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى التحقق من المحتويات، وإجراء التصحيحات إذا لزم الأمر، ثم حفظها. لا يتم تحديد الأهداف تلقائيا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si us plau, comproveu el contingut, feu les correccions si cal i després deseu. Els objectius no es determinen automàticament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pečlivě si přečtěte obsah a případně jej opravte před uložením. Cíl se automaticky nezadá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft indholdet og rediger det efter behov, før du gemmer. Målet fastlægges automatisk ikke."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen und gegebenenfalls korrigieren Sie den Inhalt, bevor Sie ihn speichern. Das Ziel wird automatisch nicht festgelegt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε το περιεχόμενο και τροποποιήστε το, εάν χρειάζεται, πριν αποθηκεύσετε. Ο στόχος δεν θα καθοριστεί αυτόματα."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Please review and save only if necessary. The target will not be automatically determined."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please review and save only if necessary. The target will not be automatically determined."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please review and save only if necessary. The target will not be automatically determined."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Please review and save only if necessary. The target will not be automatically determined."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise el contenido y, si es necesario, modifíquelo antes de guardar. El objetivo no se determinará automáticamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise el contenido y, si es necesario, modifíquelo antes de guardar. El objetivo no se determinará automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista sisältö ja muokkaa tarvittaessa ennen tallentamista. Tavoitteet eivät automaattisesti vahvistu."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier le contenu et le modifier si nécessaire avant de sauvegarder. L'objectif ne sera pas automatiquement confirmé."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier le contenu et le modifier si nécessaire avant de sauvegarder. L'objectif ne sera pas automatiquement confirmé."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સામગ્રી તપાસો અને જરૂર મુજબ સુધારો કર્યા પછી સાચવો. લક્ષ્ય આપોઆપ નક્કી થશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את התוכן ובצע תיקונים במידת הצורך לפני שמירה. המטרה לא תתקבע אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया सामग्री की जाँच करें और आवश्यकतानुसार संशोधित करके सहेजें। लक्ष्य स्वचालित रूप से निर्धारित नहीं होते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerite sadržaj i ažurirajte ga ako je potrebno prije spremanja. Cilj se automatski neće definirati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizd a tartalmat, és ha szükséges, szerkessz, majd mentd el. A cél automatikusan nem lesz meghatározva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa dan perbaiki jika perlu sebelum menyimpan. Tujuan tidak akan otomatis ditetapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il contenuto e, se necessario, effettua le modifiche prima di salvare. L'obiettivo non viene automaticamente definito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認し、必要なら修正してから保存してください。目標は自動では確定しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용을 확인하고 필요하면 수정 후 저장하세요. 목표는 자동으로 설정되지 않습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया माहिती तपासा आणि आवश्यक असल्यास त्यात बदल करून सेव्ह करा. लक्ष्य आपोआप निश्चित होणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila semak dan edit jika diperlukan sebelum menyimpan. Matlamat tidak akan ditetapkan secara automatik."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de inhoud en corrigeer indien nodig voordat u opslaat. Het doel wordt automatisch niet vastgesteld."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft innholdet og gjør eventuelle endringer før du lagrer. Målet vil ikke automatisk bli fastslått."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź zawartość i w razie potrzeby zmodyfikuj ją przed zapisaniem. Cel nie zostanie automatycznie zdefiniowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o conteúdo e faça as alterações necessárias antes de salvar. O objetivo não será definido automaticamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o conteúdo e faça as alterações necessárias antes de salvar. O objetivo não será definido automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică conținutul și, dacă este necesar, modifică-l înainte de a salva. Obiectivul nu se stabilește automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, просмотрите и отредактируйте содержимое, если необходимо, прежде чем сохранять. Цель не будет автоматически определена."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte obsah a v prípade potreby ho upravte a potom uložte. Ciele nie sú automaticky potvrdené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosim, preverite in uredite, če je potrebno, ter shranite. Cilj se ne bo samodejno določil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska innehållet och redigera vid behov innan du sparar. Målet fastställs automatiskt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளடக்கத்தை சரிபார்த்து, தேவைப்பட்டால் திருத்தி சேமிக்கவும். இலக்கு தானாகவே தீர்மானிக்கப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కంటెంట్‌ను తనిఖీ చేసి, అవసరమైతే సరిచేసి, ఆపై సేవ్ చేయండి. లక్ష్యాలు స్వయంచాలకంగా నిర్ణయించబడవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบเนื้อหา และแก้ไขตามต้องการก่อนบันทึก เป้าหมายจะไม่ได้รับการกำหนดโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriği kontrol edin ve gerekirse düzeltin, ardından kaydedin. Hedefler otomatik olarak belirlenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте вміст і внесіть необхідні зміни перед збереженням. Мета не визначається автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng xem xét và chỉnh sửa nếu cần rồi lưu. Mục tiêu sẽ không tự động được xác định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认内容并根据需要进行修改后保存。目标不会自动确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认内容，必要时进行修改后再保存。目标不会自动确定。"
          }
        }
      }
    },
