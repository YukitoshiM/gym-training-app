    "health_meals_body_ai.42539e8231ed": {
      "comment": "GymTrainingApp/Features/Meals/MealNutritionSourceViews.swift:60\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير \"-\" إلى أنه لا يتم قياسه ويتم استبعاده من الإجمالي، ويشير \"Tr\" إلى كمية تتبع ويتم تقريبها بـ 0."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" indica que no es mesura i s'exclou del total, i \"Tr\" indica una quantitat de traça i s'aproxima amb 0."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„-“ označuje hodnotu, která nebyla změřena, a je odečtena ze souhrnu. „Tr“ označuje malou hodnotu a je odhadována na 0."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" indgår ikke i den samlede sum, og \"Tr\" estimeres til 0."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "„-“ bedeutet, dass der Wert nicht gemessen wurde und daher vom Gesamtbetrag abgezogen wird. „Tr“ steht für eine geringe Menge und wird mit 0 geschätzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το \"-\" υποδηλώνει ότι δεν έχει μετρηθεί και αφαιρείται από το σύνολο, ενώ το \"Tr\" υποδηλώνει μια μικρή ποσότητα και εκτιμάται ως 0."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" represents unmeasured values, which are excluded from the total. \"Tr\" represents trace amounts and is estimated at 0."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" represents unmeasured values, which are excluded from the total. \"Tr\" represents trace amounts and is estimated at 0."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" represents unmeasured values, which are excluded from the total. \"Tr\" represents trace amounts and is estimated at 0."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" represents unmeasured values, which are excluded from the total. \"Tr\" represents trace amounts and is estimated at 0."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" indica que no se ha medido, por lo que se excluye del total. \"Tr\" representa una cantidad mínima y se estima en 0."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" indica que no se ha medido, por lo que se excluye del total. \"Tr\" representa una cantidad mínima y se estima en 0."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" tarkoittaa, että arvoa ei ole mitattu, ja se jätetään pois kokonaismäärästä. \"Tr\" tarkoittaa pientä määrää, jolloin se lasketaan nollaksi."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "« » indique une valeur non mesurée, qui est exclue du total. « Tr » représente une quantité faible et est estimée à 0."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "« » indique une valeur non mesurée, qui est exclue du total. « Tr » représente une quantité faible et est estimée à 0."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" ને માપવામાં ન આવે અને તેને કુલમાંથી બાદ કરવામાં આવશે, \"Tr\" ને ખૂબ જ ઓછી માત્રા તરીકે 0 થી ગણવામાં આવશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" מציין מדידה לא בוצעה, ולכן מוסר מסך הסכום. \"Tr\" מציין כמות קטנה, ולכן מוערכת ב-0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" को मापा न होने के कारण कुल से घटाया जाएगा, और \"Tr\" को कम मात्रा के रूप में 0 मानकर अनुमान लगाया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" označava vrijednost koja nije izmjerena, a \"Tr\" predstavlja malu količinu i procjenjuje se na 0."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A \"-\" jel azt jelenti, hogy ez az érték még nem mérve, ezért kiválasztjuk a teljes összegezésből. A \"Tr\" pedig nagyon kis mennyiséget jelöl, melyet 0-val becsülünk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" menunjukkan pengukuran yang belum dilakukan, sehingga dikeluarkan dari total. \"Tr\" menunjukkan jumlah kecil dan diperkirakan menjadi 0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" indica che non è stato misurato, quindi viene escluso dal totale. \"Tr\" rappresenta una quantità minima e viene stimata a 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「-」は未測定として合計から除外し、「Tr」は微量として0で概算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\"은 측정되지 않았으므로 총에서 제외하고, \"Tr\"는 미량으로 0으로 추정합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" म्हणजे मापन न केलेले, त्यामुळे एकूण मूल्यामधून वजा केले जाईल. \"Tr\" म्हणजे अगदी कमी प्रमाणात, म्हणून 0 ने अंदाजे गणले जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" dikeluarkan daripada jumlah, dan \"Tr\" dianggarkan sebagai sejumlah kecil dengan nilai 0."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" staat voor ongemeten en wordt uitgesloten van de totale waarde. \"Tr\" staat voor een kleine hoeveelheid en wordt geschat op 0."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" indikerer at verdien ikke er målt, og blir ekskludert fra totalsummen. \"Tr\" representerer en liten mengde, og estimeres til 0."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" oznacza, że wartość nie została zmierzona i jest pomijana w sumie, a \"Tr\" oznacza niewielką ilość, która jest szacowana na 0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" indica que não foi medido, portanto é excluído do total. \"Tr\" representa uma quantidade mínima e é estimada como 0."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" indica que não foi medido, portanto é excluído do total. \"Tr\" representa uma quantidade mínima e é estimada como 0."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„-” indică o valoare ne măsurată, care este exclusă din total. „Tr” reprezintă o cantitate mică și este estimată la 0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" означает, что значение не измерено и исключается из общей суммы. \"Tr\" обозначает незначительное количество и считается равным 0."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„-“ znamená, že nie je možné zmerať, preto sa odstraňuje zo sumy. „Tr“ znamená malé množstvo a je odhadované na 0."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" pomeni, da ni izmerjeno in je odštevano od skupnega števila, \"Tr\" pa predstavlja majhno količino in se ocenjuje na 0."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" indikerar att värdet inte har mätts och tas bort från totalsumman, medan \"Tr\" representerar en liten mängd och uppskattas till 0."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\", என்பது அளவிடப்படாததால், மொத்தத்திலிருந்து விலக்கப்படும். \"Tr\" என்பது சிறிய அளவில் இருப்பதால், 0 ஆக மதிப்பிடப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" అనేది కొలవబడనిదిగా పరిగణించి, మొత్తం నుండి తీసివేయబడుతుంది మరియు \"Tr\" అనేది తక్కువ మొత్తంగా పరిగణించి 0తో అంచనా వేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" หมายถึงยังไม่ได้วัด ดังนั้นจึงตัดออกจากผลรวม และ \"Tr\" หมายถึงปริมาณน้อย จึงประมาณเป็น 0"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" değeri ölçülmediği için toplamdan çıkarılır, \"Tr\" değeri çok düşük olduğu için 0 olarak tahmin edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\"-\" означає, що значення не виміряно, тому воно виключається з загальної суми. \"Tr\" означає незначну кількість і оцінюється як 0."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"–\" biểu thị chưa đo, loại trừ khỏi tổng. \"Tr\" biểu thị lượng rất nhỏ, ước tính bằng 0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“-”表示未测量，从总和中排除，“Tr”表示微量，以0估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「-」表示未測量，從總和中排除，「Tr」表示微量，以0估算。"
          }
        }
      }
    },
