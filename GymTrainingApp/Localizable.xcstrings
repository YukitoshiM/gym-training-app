          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी मुद्रा और शरीर के अंगों के संतुलन पर ध्यान दें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svjesno održavajte postavu i ravnotežu tijela"
