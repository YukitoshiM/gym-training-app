        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobili ste sve tri ciljeve dana. Promjene će biti primijenjene u sljedećem prijedelu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elértem a mai célokat. A következő nap ajánlataiban megjelennek."
