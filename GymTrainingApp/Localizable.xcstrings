    "health_meals_body_ai.834d88de3434": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:151\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "فهو يشير إلى العناصر التي تغيرت في نفس الوقت الذي تغير فيه المرشحون، ولا يحدد بشكل قاطع السبب أو الحالة الطبية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica elements que han canviat al mateix temps que els candidats, i no determina de manera definitiva la causa o la condició mèdica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zobrazuje potenciální položky, které se změnily, ale neposuzuje příčinu nebo zdravotní stav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser potentielle ændringer, men fastslår ikke årsager eller medicinske tilstande."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies zeigt mögliche Veränderungen, ohne Ursachen oder medizinische Zustände zu bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
