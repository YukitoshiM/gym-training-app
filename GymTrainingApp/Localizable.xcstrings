        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit geeft een lijst van items die tegelijkertijd zijn veranderd, maar doet geen uitspraken over de oorzaak of medische toestand."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette viser mulige endringer, men fastslår ikke årsak eller helsetilstand."
