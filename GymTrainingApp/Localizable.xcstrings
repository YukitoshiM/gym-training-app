        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Meregangkan kaki dengan menggunakan sendi lutut sebagai paksi, serta mengencangkan otot quadriceps."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik je kniegewricht als as om je benen uit te strekken en span je quadriceps aan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk kneleddet som et senterpunkt for å strekke bena, og klem quadriceps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozciągnij nogi, wykorzystując kolana jako oś, i napnij mięśnie czworogłowe ud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estique as pernas a partir dos joelhos e contraia os quadríceps."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estique as pernas a partir dos joelhos e contraia os quadríceps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește articulația genunchiului ca punct de sprijin pentru a-ți întinde picioarele și contractează mușchii cvadriceps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вытягивать ноги, используя сустав колена в качестве оси, и сокращать квадрицепс."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite kolená ako oporu a natiahnite nohy, čím budete stláčať svaly medzi zadnými a vnútornými stranou stehien."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raztegni noge, uporabite kolena kot os in stisnite kvadriceps."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sträck ut benen med knäleden som axel och dra in quadriceps."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முட்டை மூட்டின் பகுதியை அச்சாக வைத்து, கால்களை நீட்டி, தொடையின் முன்புறத் தசைகளை சுருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మోకాలు కీలును ఆధారంగా చేసుకుని కాళ్ళను చాపి, పెద్ద చీలమండ కండరాలను బిగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ข้อเข่าเป็นแกนในการยืดขา และเกร็งกล้ามเนื้อต้นขาด้านหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayak bileğinizin etrafında dönerek bacaklarınızı uzatın ve büyük uyluk kaslarını (quadriceps) sıkın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розтягувати ноги, використовуючи суглоб коліна як орієнтир, та скорочувати м'язи литок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duỗi thẳng chân, tập trung vào cơ tứ đầu và co bắp chân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以膝关节为轴心，伸展双腿，收缩股四头肌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以膝关节为轴，伸展腿部，收缩股四头肌。"
          }
        }
      }
    },
