    "training.2592d4be6d03": {
      "comment": "GymTrainingApp/Data/WatchPlanSyncService.swift:266\nGymTrainingApp/Data/WatchPlanSyncService.swift:364\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدي Apple Watch بالقرب مني، لذلك قمت بالحجز لاستلامه في المرة التالية التي أبدأ فيها تشغيله."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No tinc Apple Watch a prop, així que vaig fer una reserva per rebre'l la propera vegada que el comenci."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože Apple Watch není poblíž, jsem jej rezervoval pro příští spuštění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da Apple Watch ikke er i nærheden, har jeg booket den til at ankomme ved næste start."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Da die Apple Watch nicht in der Nähe ist, habe ich sie für den nächsten Start so konfiguriert, dass sie verfügbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεδομένου ότι το Apple Watch δεν είναι κοντά, το έχω προγραμματίσει να ενεργοποιηθεί την επόμενη φορά που θα το χρησιμοποιήσετε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "I have scheduled the next launch so that the Apple Watch will be available when it arrives because the Apple Watch is not nearby."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "I have scheduled the next launch so that the Apple Watch will be available when it arrives because the Apple Watch is not nearby."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I have scheduled the next launch so that the Apple Watch will be available when it arrives because the Apple Watch is not nearby."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "I have scheduled the next launch so that the Apple Watch will be available when it arrives because the Apple Watch is not nearby."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "He reservado la llegada del Apple Watch para la próxima vez, ya que no está cerca."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "He reservado la llegada del Apple Watch para la próxima vez, ya que no está cerca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska Apple Watch ei ole lähellä, se on varattu toimimaan seuraavan käynnistyksen yhteydessä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Apple Watch n'est pas disponible à proximité, donc j'ai programmé son arrivée lors du prochain démarrage."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Apple Watch n'est pas disponible à proximité, donc j'ai programmé son arrivée lors du prochain démarrage."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch નજીકમાં ન હોવાથી, આગલી વખતે શરૂ કરતી વખતે તેને મળવા માટે બુક કરવામાં આવ્યું છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאחר ש-Apple Watch אינו נמצא לידי, הוא מתוכנן להגיע בפעם הבאה שתפעלו אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्योंकि Apple Watch पास में नहीं है, इसलिए अगली बार शुरू करते समय इसे प्राप्त करने के लिए शेड्यूल किया गया है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jer se Apple Watch nije nalazio u blizini, rezervirao sam ga za sljedeći put kada se uključi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mivel az Apple Watch nincs közel, a következő indításkor értesítést küldtem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena Apple Watch tidak berada di dekat, saya telah menjadwalkannya agar tiba saat dinyalakan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiché l'Apple Watch non è nelle vicinanze, ho programmato la notifica per il prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchが近くにないため、次回起動時に届くよう予約しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch가 가까이 있지 않아, 다음 실행 시 도착하도록 예약했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch जवळ नसल्यामुळे, पुढील वेळी सुरू करताना ती उपलब्ध होईल अशा प्रकारे नोंदवली आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch tidak berada di dekatnya, jadi saya telah menjadualkannya untuk tiba pada kali seterusnya"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat Apple Watch niet in de buurt is, heb ik het gepland om hem te ontvangen bij de volgende start."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Siden Apple Watch ikke er i nærheten, har jeg bestilt at den skal være tilgjengelig ved neste oppstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponieważ Apple Watch nie jest w pobliżu, zapisałem go do uruchomienia następnym razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o Apple Watch não está próximo, agendei para que ele chegue na próxima vez que for ligado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o Apple Watch não está próximo, agendei para que ele chegue na próxima vez que for ligado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deoarece Apple Watch nu este disponibil, l-am programat să ajungă la următoarea pornire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поскольку Apple Watch находится далеко, я запланировал его появление при следующем запуске."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretože Apple Watch nie je blízko, som si ho rezervoval pre nasledujúci spustený čas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker Apple Watch ni blizu, sem ga rezerviral za naslednji start, da bo dostopen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eftersom Apple Watch inte är nära, har jag bokat in den så att den når dig vid nästa start."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch அருகில் இல்லாததால், அடுத்த முறை இயங்கும் போது வரும்படி முன்பதிவு செய்துள்ளேன்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch దగ్గర లేనందున, తదుపరిసారి ప్రారంభించేటప్పుడు అందుబాటులో ఉండేలా రిజర్వ్ చేసాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื่องจาก Apple Watch ไม่อยู่ใกล้ จึงได้ทำการจองเพื่อให้สามารถใช้งานได้เมื่อเปิดเครื่องครั้งต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch yakınlarda olmadığından, bir sonraki açılışta ulaşması için planladım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оскільки Apple Watch не знаходиться поруч, я запланив його отримання при наступному запуску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì Apple Watch không ở gần, tôi đã đặt lịch để nhận thông báo khi khởi động lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于Apple Watch离您较远，因此已为您预约下次启动时收到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由于Apple Watch离您较远，因此在下次启动时已为您预约"
          }
        }
      }
    },
