    "domain_catalog.7df261432999": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:83\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ صدرك مرتفعًا واسحب البار نحو عظام الترقوة دون هز كتفيك."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantingueu el pit aixecat i estireu la barra cap a les clavículas sense arronsar les espatlles."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napněte hrudník, přitáhněte činku ke krku bez sklonu ramen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spænd brystmusklerne og træk stangen mod skuldrene uden at bukke ryggen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schultern nicht aus dem Gleichgewicht bringen, sondern die Stange in Richtung Schlüsselbeine ziehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τεντώστε το στήθος σας, χωρίς να σκυλώνετε τους ώμους, και τραβήξτε τη μπάρα κοντά στους αγκώνες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the bar towards your collarbone without hunching your shoulders."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the bar towards your collarbone without hunching your shoulders."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the bar towards your collarbone without hunching your shoulders."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the bar towards your collarbone without hunching your shoulders."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira el pecho y tira la barra hacia las clavículas sin encorvarte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira el pecho y tira la barra hacia las clavículas sin encorvarte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa rintalihakset ja vedä tangon kyynärpäiden kohdalle ilman, että hartiat taittuvat."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Contractez les pectoraux et tirez la barre vers l'avant, près des épaules, sans arrondir le dos."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contractez les pectoraux et tirez la barre vers l'avant, près des épaules, sans arrondir le dos."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છાતીને ફેલાવો, અને ખભાને નીચે ન લાવો, પરંતુ બારને ગળાની નજીક ખેંચો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למתוח את החזה, למשוך את מוט המשקל לכיוון השכמות מבלי להרים את הכתפיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी छाती को फैलाएं, और बिना कंधे झुकाए बार को अपने कलाई के पास लाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napinujte prsnu površinu, povucite čučalo prema ispod ramena bez savijanja ramena."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzzon ki a hasát, és húzza a bár a karcsuk közelébe, anélkül, hogy a vállakat hajlíthatná."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegangkan dada, tarik bar ke arah tulang selangka tanpa membungkuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrapporre i muscoli pettorali, tirando la sbarra verso le clavicole senza incurvare le spalle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸を張り、肩をすくめずにバーを鎖骨付近へ引く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가슴을 넓게 벌리고, 어깨를 둥글게 하지 않고 바를 쇄골 근처로 당깁니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "छातीचा स्नायू मजबूत करा, खांद्यांना खाली न ओढता बारला कोपरांच्या जवळ आणा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegakkan dada, tarik palang ke arah tulang selangka tanpa membengkokkan bahu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Span je borstspieren aan en trek de stang naar je schoudergordel, zonder je schouders op te tillen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Spenn brystmusklene og trekk stangen mot skuldrene uten å senke skuldrene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozciągnij klatkę piersiową i przyciągnij sztangę do linii poniżej łopatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre o peito e puxe a barra em direção aos cotovelos, sem arquear os ombros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre o peito e puxe a barra em direção aos cotovelos, sem arquear os ombros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îndoiți pieptul și trageți bara spre zona claviculelor, fără a vă apleca înainte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распрямите грудь и подтягивайте штангу к области ключиц, не сутулясь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napnejte hrudné svaly a spáť zdvihnite činku k oblasti lakťov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napnite prste,nato pa utež potisnite proti ramenom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spänn bröstmusklerna och dra stången mot skuldrorna utan att böja på armarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மார்பை விரித்து, உங்கள் தோள்களை வளைக்காமல், பாரை உங்கள் தோள்பட்டைக்கு அருகில் இழுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఛాతీని చాపి, భుజాలను వంచకుండా బార్‌ను భుజం దగ్గరకి లాగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยายหน้าอก, ดึงบาร์เข้าใกล้บริเวณซี่โครง โดยไม่ทำให้ไหล่ห่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğsü genişleterek, omuzlarını yukarı doğru çekmeden barı boynuna yakın bir noktaya çek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розправте груди, не сутультесь, тягніть штангу до області ключиць."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhíu vai, kéo thanh tạ về phía xương bả vai mà không gập vai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挺胸，不要耸肩，将杠杆向锁骨附近拉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "挺胸，不要聳肩，並將槓桿拉至鎖骨附近"
          }
        }
      }
    },
