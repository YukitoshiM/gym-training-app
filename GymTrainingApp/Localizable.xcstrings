        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod yang lengkap boleh dilihat dalam sejarah."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooide trainingen kunt u bekijken in het overzicht."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan se fullførte treningsøkter i historikken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe zapisy można sprawdzić w historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode verificar os registros concluídos na seção \"Histórico\"."
          }
