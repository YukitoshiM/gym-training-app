    "health_meals_body_ai.4127c532bfe3": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:841\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورًا بنفس الملابس والمسافة والضوء."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes fotos amb la mateixa roba, distància i llum."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte stejné oblečení, vzdálenost a světelná podmínky a cvičte uvolněně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et billede med samme tøj, afstand og lys, og slap af"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie die gleiche Kleidung, Distanz und Lichtmitternahl, um entspannt zu trainieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε το ίδιο ρούχο, την ίδια απόσταση και τον ίδιο φωτισμό κατά τη λήψη φωτογραφιών."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos while wearing the same clothes, covering the same distance, and in consistent lighting, with relaxed muscles."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos while wearing the same clothes, covering the same distance, and in consistent lighting, with relaxed muscles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos while wearing the same clothes, covering the same distance, and in consistent lighting, with relaxed muscles."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos while wearing the same clothes, covering the same distance, and in consistent lighting, with relaxed muscles."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza la misma ropa, distancia y condiciones de luz para tomar la foto relajado"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza la misma ropa, distancia y condiciones de luz para tomar la foto relajado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota kuva samalla vaatteella, etäisyydellä ja valolla, rentoutuen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez des photos en portant la même tenue, sur la même distance et dans les mêmes conditions d'éclair"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez des photos en portant la même tenue, sur la même distance et dans les mêmes conditions d'éclair"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમાન કપ, અંતર અને પ્રકાશમાં, આરામથી ફોટો લો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "באותה בגד, מרחק ואור, צלם תוך הרפיה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही कपड़े, दूरी और प्रकाश में, आराम से माप लें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografirajte u istoj odjeći, na istoj udaljenosti i pod istim svjetlom, opuste se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonban ugyanazokkal az öltözettel, távolsággal és fényviszonyok között, lazán végezd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan pakaian, jarak, dan pencahayaan yang sama, dan ambil foto dengan rileks"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con lo stesso abbigliamento, distanza e illuminazione, rilassati durante la registrazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ服・距離・光で、力を抜いて撮影"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 옷, 거리, 조명으로, 힘을 빼고 촬영"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समान कप, अंतर आणि प्रकाशात, आरामपूर्वक फोटो घ्या"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan pakaian, jarak, dan cahaya yang sama, ambil gambar dengan santai"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem dezelfde kleding, afstand en licht mee, en maak een foto zonder spanning."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bildet med samme klær, avstand og lys, og slapp av"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tej samej odzieży, dystansu i warunków oświetleniowych, aby swobodnie wykonywać ćwiczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a mesma roupa, distância e iluminação, relaxe e tire a foto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a mesma roupa, distância e iluminação, relaxe e tire a foto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu aceeași îmbrăcăminte, distanță și lumină, relaxează-te în timp ce filmezi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте фото в той же одежде, на том же расстоянии и при одинаковом освещении, расслабившись."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite rovnaké oblečenie, vzdialenosť a osvetlenie a urobte fotografiu s uvoľnením"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabite isto obleko, razdaljo in svetlobo ter se poskusite sprožiti med snemanjem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd samma kläder, distans och ljus, och fokusera på att slappna av"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே உடை, தூரம் மற்றும் ஒளியில், நிதானமாக புகைப்படம் எடுக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒకే దుస్తులు, దూరం మరియు కాంతిలో, రిలాక్స్డ్‌గా ఫోటో తీయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายภาพด้วยเสื้อผ้า, ระยะทาง, และแสงเดียวกัน โดยผ่อนคลาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı kıyafet, mesafe ve ışıkta, rahat bir şekilde çekim yapın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте одні й ті самі одяг, відстань і освітлення, розслабляючись під час зйомки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp ảnh với cùng trang phục, khoảng cách và ánh sáng, thư giãn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "穿着相同服装、距离和光线，放松拍摄"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "穿着相同服装、距离和光线，放松拍摄"
          }
        }
      }
    },
