            "state": "translated",
            "value": "Apple Watch التحضير للاتصال. الرجاء الانتظار لحظة وحاول مرة أخرى"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch S'està preparant per a la connexió. Espereu un moment i torneu-ho a provar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojování k Apple Watch probíhá... Počkejte prosím a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forbereder forbindelsen til Apple Watch. Vent et øjeblik, og prøv igen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bereite die Verbindung zu Ihrem Apple Watch vor. Bitte warten Sie einen Moment und versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ετοιμάζω τη σύνδεση με το Apple Watch. Περιμένετε λίγο και προσπαθήστε ξανά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing to connect to Apple Watch. Please wait a moment and then try sending again."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing to connect to Apple Watch. Please wait a moment and then try sending again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing to connect to Apple Watch. Please wait a moment and then try sending again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing to connect to Apple Watch. Please wait a moment and then try sending again."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy preparando la conexión con Apple Watch. Por favor, espere un momento y luego intente nuevamente."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy preparando la conexión con Apple Watch. Por favor, espere un momento y luego intente nuevamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistetaan Apple Watch -yhteys. Odota hetki ja yritä lähettää uudelleen."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation de la connexion à Apple Watch. Veuillez patienter et réessayer."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation de la connexion à Apple Watch. Veuillez patienter et réessayer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું એપલ વૉચ કનેક્શન માટે તૈયારી કરી રહ્યો છું. થોડીવાર રાહ જુઓ અને ફરીથી પ્રયાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתכוננים לחיבור ל-Apple Watch. אנא המתינו רגע ואז שלחו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं Apple Watch कनेक्शन की तैयारी कर रहा हूँ। थोड़ा इंतजार करें और फिर से प्रयास करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripremam se za povezivanje s Apple Watchom. Molim, čekajte i pokušajte ponovno poslati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Watch-hoz való kapcsolást beállítom. Kérjük, várjon egy pillanatot, majd próbálja újra elküldeni."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menyiapkan koneksi ke Apple Watch. Mohon tunggu sebentar, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto preparando la connessione ad Apple Watch. Attendi un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch接続を準備中です。少し待ってからもう一度送信してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch 연결을 준비 중입니다. 잠시 기다린 후 다시 시도해 주세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲपल वॉच कनेक्शन तयार करत आहे. थोडा वेळ थांबा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menyediakan sambungan ke Apple Watch. Sila tunggu dan cuba lagi."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben bezig met het voorbereiden van de verbinding met Apple Watch. Wacht even en probeer het opnieuw."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forbereder tilkobling til Apple Watch. Vent litt og prøv igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowuję się do połączenia z Apple Watch. Poczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando a conexão com o Apple Watch. Aguarde um momento e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando a conexão com o Apple Watch. Aguarde um momento e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregătirea conexiunii cu Apple Watch. Vă rugăm să așteptați puțin și apoi să încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка к установке соединения с Apple Watch. Пожалуйста, подождите и повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príprava pripojenia k Apple Watch. Počkajte chvíľu a skúste to znovu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poskušam pripraviti za povezavo z Apple Watch. Počakajte trenutek in se poskusite ponovno poveznati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förbereder anslutning till Apple Watch. Vänta en stund och försök igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆப்பிள் வாட்ச் இணைப்பை தயார் செய்து வருகிறோம். சிறிது நேரம் கழித்து மீண்டும் அனுப்பவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple వాచ్ కనెక్షన్‌ను సిద్ధం చేస్తున్నాము. కొంచెం వేచి ఉండి మళ్లీ పంపండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังเตรียมพร้อมสำหรับการเชื่อมต่อ Apple Watch โปรดรอสักครู่แล้วลองส่งอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch bağlantısını hazırlıyoruz. Birkaç saniye bekleyin ve tekrar gönderin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовка до встановлення з'єднання з Apple Watch. Будь ласка, зачекайте та спробуйте відправити ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chuẩn bị kết nối với Apple Watch. Vui lòng chờ và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备Apple Watch连接。稍后请再次发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备Apple Watch连接。稍后再尝试发送"
          }
        }
      }
    },
