          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frontot és hátul is megmértem a derék körüli átmérőt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa lingkar pinggang dengan melihat bagian depan dan belakang secara bersamaan."
