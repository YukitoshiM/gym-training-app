        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పరికరంలోని ఈరోజు సూచనలు ఉచితంగా ఉపయోగించవచ్చు. AI క్రెడిట్‌ను స్వయంచాలకంగా వినియోగించదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อเสนอประจำวันที่อยู่ในอุปกรณ์ใช้งานได้ฟรี AI จะไม่ใช้เครดิตโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazdaki günlük öneriler ücretsizdir. AI kredisi otomatik olarak harcanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденні рекомендації на пристрої безкоштовні. AI не споживає кредит автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý hàng ngày trên thiết bị miễn phí. Cấp AI không tự động tiêu thụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备内的每日建议免费使用。AI不会自动消耗积分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置內今天的建議是免費使用的。AI不會自動消費您的信用。"
          }
        }
      }
    },
