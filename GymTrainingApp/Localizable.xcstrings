    "health_meals_body_ai.dda25c014089": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:187\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "متوسط وزني الأسبوعي الأخير يتحرك في الاتجاه المعاكس لهدفي. بادئ ذي بدء، إنه مرشح لتعديل المدخول الموصى به قليلاً."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El meu pes mitjà setmanal recent s'està movent en la direcció oposada al meu objectiu. En primer lloc, és un candidat per ajustar lleugerament la ingesta recomanada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše průměrná váha za poslední týden se pohybuje opačným směrem než je cílový rozsah. Doporučujeme nejprve upravit doporučenou denní dávku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gennemsnitlige vægtforbrug over den seneste uge bevæger sig i modsatte retning af dit mål. Det kan være en god idé at justere dit kalorieindtag lidt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr durchschnittliches Wochengewicht bewegt sich entgegen dem Ziel. Zuerst sollten Sie die empfohlene Menge leicht anpassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέσο βάρος σας την τελευταία εβδομάδα κινείται προς το αντίθετο από τον στόχο. Αρχικά, προτείνουμε μια μικρή αλλαγή στην ποσότητα των θερμίδων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is moving in the opposite direction of your goal. Consider adjusting your calorie intake first."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is moving in the opposite direction of your goal. Consider adjusting your calorie intake first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is moving in the opposite direction of your goal. Consider adjusting your calorie intake first."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your average weekly weight loss is moving in the opposite direction of your goal. Consider adjusting your calorie intake first."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal está fluctuando en dirección opuesta a tu objetivo. Considera ajustar ligeramente la ingesta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peso promedio semanal está fluctuando en dirección opuesta a tu objetivo. Considera ajustar ligeramente la ingesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisen viikon keskimääräinen paino on liikkeessä vastakkaiseen suuntaan. Ensimmäiseksi kannattaa säätää suositeltavaa annosta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire évolue à l'opposé de votre objectif. Il serait peut-être judicieux d'ajuster légèrement votre apport calorique."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre poids moyen hebdomadaire évolue à l'opposé de votre objectif. Il serait peut-être judicieux d'ajuster légèrement votre apport calorique."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા અઠવાડિયાનો સરેરાશ વજન ધ્યેયની વિરુદ્ધ દિશામાં વધી રહ્યું છે. પ્રથમ, આહારની માત્રામાં થોડો ફેરફાર કરવાની સંભાવના છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשקל הממוצע השבועי האחרון זז בכיוון הפוך מהמטרה. בתחילה, זה יכול להיות מועמד לשינוי קל בהמלצות היומיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले सप्ताह का औसत वजन लक्ष्य के विपरीत दिशा में जा रहा है। पहले, कृपया सेवन की मात्रा को थोड़ा समायोजित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša prosječna težina u posljednjoj tjedni se kreće u suprotnom smjeru od cilja. Prvo razmislite o laglom prilagođavanju preporučene količine hranjivih sastojaka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utóbbi heti átlag súlyod ellentétes irányban mozgott. Első lépésként javaslom, hogy finoman módosítsd a napi bevitel mennyiségét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berat badan rata-rata mingguan Anda bergerak berlawanan dengan target. Pertimbangkan untuk menyesuaikan asupan kalori terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo peso medio settimanale si sta muovendo nella direzione opposta all'obiettivo. Inizialmente, potresti voler regolare leggermente l'apporto calorico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近の週平均体重が目標方向と逆に動いています。まずは摂取目安を少し調整する候補です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 주 평균 체중이 목표 방향과 반대로 움직이고 있습니다. 우선 섭취 권장량을 조금 조절하는 후보입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील आठवड्यातील सरासरी वजन हे ध्येयाच्या विरुद्ध दिशेने जात आहे. त्यामुळे, आहारात थोडा बदल करण्याचा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Purata berat mingguan anda bergerak ke arah sasaran yang berbeza. Mungkin perlu menyesuaikan jumlah pengambilan terlebih dahulu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw gemiddelde gewicht over de afgelopen week beweegt in de verkeerde richting. Probeer eerst uw calorie-inname aan te passen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gjennomsnittlige vekt har gått ned i motsatt retning av målet. Vurder først å justere anbefalt inntak litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Średnia waga w ostatnim tygodniu jest niższa niż założony cel. Proszę najpierw dostosować zalecaną ilość spożycia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal está se movendo na direção oposta à meta. Considere ajustar ligeiramente a ingestão inicialmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu peso médio semanal está se movendo na direção oposta à meta. Considere ajustar ligeiramente a ingestão inicialmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În ultima săptămână, greutatea medie a scăzut în direcție inversă față de obiectiv. În primul rând, puteți ajusta ușor aportul caloric."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш средний вес за последнюю неделю движется в неправильном направлении. В первую очередь, стоит немного скорректировать рекомендуемое количество калорий."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša priemerná hmotnosť za poslednú týždeň sa pohybuje opačne ako cieľ. Najprv zvážte mierne úpravu odporúčanej dávky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša povprečna telesna teža zadnjih tednikov se usmerja v nasprotni smeri cilja. Za začetek poskusite prilagoditi priporočen dnevni odmerek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din genomsnittliga vikttapp under den senaste veckan är i motsatt riktning mot målet. Först bör du justera ditt kaloriintag något."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்திய வார சராசரி எடை இலக்கை நோக்கி இல்லாமல் உள்ளது. முதலில், உட்கொள்ளும் அளவை சற்று சரிசெய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత వారపు సగటు బరువు లక్ష్య దిశకు వ్యతిరేకంగా ఉంది. మొదట, తీసుకోవలసిన మోతాదును కొద్దిగా సర్దుబాటు చేయడం మంచిది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "น้ำหนักเฉลี่ยรายสัปดาห์ของคุณเคลื่อนที่ในทิศทางตรงกันข้ามกับเป้าหมาย ดังนั้นจึงเป็นตัวเลือกในการปรับปริมาณที่แนะนำก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son haftanın ortalama ağırlığı hedefe doğru değil, ters yönde ilerliyor. İlk olarak, alım miktarını ayarlamayı düşünebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Середня вага за останній тиждень рухається у протилежному напрямку від цілі. Спочатку варто скоригувати рекомендоване споживання калорій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trọng lượng trung bình hàng tuần đang đi ngược hướng so với mục tiêu. Lựa chọn đầu tiên là điều chỉnh lượng calo tiêu thụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一周的平均体重与目标方向相反。首先建议稍微调整摄入量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一週的平均體重與目標方向相反。建議首先調整攝取量。"
          }
        }
      }
    },
