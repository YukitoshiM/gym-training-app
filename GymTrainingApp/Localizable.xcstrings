        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Health není povolen, pouze historie aplikací je uložena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sundhedsdata ikke godkendt - kun apphistorik gemt"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesundheitsdaten nicht autorisiert, nur App-Historie gespeichert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αποθήκευση δεν επιτρέπεται, μόνο το ιστορικό της εφαρμογής είναι αποθηκευμένο."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Health permission denied, only app history is saved."
          }
