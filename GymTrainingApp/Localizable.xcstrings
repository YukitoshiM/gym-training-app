    "training.e1b8fd383091": {
      "comment": "GymTrainingApp/Features/Plans/AIPlanCoachView.swift:397\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الوزن وعدد التكرارات والحدث على الشاشة التالية قبل الحفظ."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comproveu el pes, el nombre de repeticions i l'esdeveniment a la pantalla següent abans de desar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte váhu, počet opakování a cvičení před přechodem na další obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem først vægt, antal gentagelser og øvelse på næste skærm."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie das Gewicht, die Anzahl und die Übung im nächsten Bildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αυτή την οθόνη, θα δείτε το βάρος, τον αριθμό επαναλήψεων και τις ασκήσεις πριν αποθηκεύσετε."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the weight, reps, and exercise in the next screen."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the weight, reps, and exercise in the next screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the weight, reps, and exercise in the next screen."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the weight, reps, and exercise in the next screen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el peso, la cantidad y el ejercicio en la siguiente pantalla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el peso, la cantidad y el ejercicio en la siguiente pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna paino, toistot ja harjoitukset ennen seuraavaa näyttöä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier le poids, le nombre de répétitions et l'exercice dans l'écran suivant avant de sauvegarder."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vérifier le poids, le nombre de répétitions et l'exercice dans l'écran suivant avant de sauvegarder."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગામી સ્ક્રીન પર વજન, સંખ્યા અને વર્કઆઉટની ચકાસણી કર્યા પછી સાચવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לשמור את המשקל, מספר החזרות והתרגיל בגישה הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगले स्क्रीन पर वजन, संख्या और व्यायाम की जांच करके सहेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvajte težinu, broj i vježbu prije prelaska na sljedeću ekranu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő oldalon ellenőrizd a súlyt, a számot és az edzést, majd mentsd el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan setelah memeriksa berat, jumlah, dan latihan pada layar berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il peso, il numero di ripetizioni e l'esercizio nel passaggio successivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の画面で重量・回数・種目を確認してから保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 화면에서 무게, 횟수, 운동 종류를 확인한 후 저장합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढच्या स्क्रीनवर वजन, संख्या आणि व्यायाम तपासा आणि नंतर सेव्ह करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan selepas anda menyemak berat, jumlah, dan latihan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla op na het controleren van gewicht, aantal en oefening in de volgende scherm."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre vekten, antall repetisjoner og øvelsen før du går videre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz w następnym ekranie po sprawdzeniu wagi, liczby powtórzeń i ćwiczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o peso, número de repetições e exercício na próxima tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o peso, número de repetições e exercício na próxima tela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvați greutatea, numărul de repetări și exercițiile în ecranul următor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните вес, количество повторений и упражнение перед переходом на следующую страницу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte si váhu, počet opakovaní a cviky na nasledujúcom obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred shranjevanjem preverite teži, število in vaje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara vikten, antalet repetitioner och övningen i nästa skärm."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடுத்த திரையில் எடை, எண்ணிக்கை மற்றும் பயிற்சியை சரிசெய்து சேமிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరి స్క్రీన్‌లో బరువు, సంఖ్య మరియు వ్యాయామాలను ధృవీకరించి, ఆపై సేవ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกน้ำหนัก, จำนวนครั้ง, และท่าออกกำลังกายก่อนไปยังหน้าถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık, tekrar sayısı ve egzersizi sonraki sayfada kontrol ederek kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть вагу, кількість повторень та вправи на наступному екрані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu lại sau khi kiểm tra trọng lượng, số lần và bài tập trong màn hình tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下一页上确认重量、次数和项目，然后保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下一个屏幕上确认重量、次数和项目后再保存。"
          }
        }
      }
    },
