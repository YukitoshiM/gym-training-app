          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क स्थिती आणि सर्व्हर URL तपासून पुन्हा प्रयत्न करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila periksa status rangkaian dan URL pelayan sebelum mencuba semula."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer eerst de netwerkstatus en server-URL voordat u opnieuw probeert."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft nettverkstilstand og server-URL før du prøver igjen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po sprawdzeniu stanu sieci i adresu URL serwera spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o status da rede e o URL do servidor antes de tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o status da rede e o URL do servidor antes de tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați starea rețelei și URL-ul serverului înainte de a încerca din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед повторной попыткой проверьте состояние сети и URL сервера."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred pokusom o opakované spustenie skontrolujte stav siete a URL servera."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite stanje omrežja in URL strežnika ter poskusite znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera nätverksstatus och server-URL innan du försöker igen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நெட்வொர்க் நிலை மற்றும் சர்வர் URL ஐ சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నెట్‌వర్క్ స్థితి మరియు సర్వర్ URLను తనిఖీ చేసి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดตรวจสอบสถานะเครือข่ายและ URL ของเซิร์ฟเวอร์ จากนั้นลองใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ durumunu ve sunucu URL'sini kontrol ettikten sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся у стані мережі та URL сервера, перш ніж повторити спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng kiểm tra trạng thái mạng và URL máy chủ trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在确认网络状态和服务器URL后，再尝试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先確認網路狀態和伺服器 URL，然後再嘗試。"
          }
        }
      }
    },
