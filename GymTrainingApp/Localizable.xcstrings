    "domain_catalog.1c530e00e8cf": {
      "comment": "GymTrainingApp/Domain/UserProfile.swift:328\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "دعونا نفصل بين القيمة العددية والخبرة البدنية وننظم الخطوة التالية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Separem el valor numèric i l'experiència física i organitzem el següent moviment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdělte si čísla a své pocity a připravte se na další krok."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dine tal med din kropsfornemmelse og planlæg dit næste skridt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortieren Sie Ihre nächsten Schritte anhand von Zahlen und Ihrem Körpergefühl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαχωρίστε τις αριθμητικές και αισθητηριακές πληροφορίες και οργανώστε την επόμενη κίνηση σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate numbers from feelings and organize your next move."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate numbers from feelings and organize your next move."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate numbers from feelings and organize your next move."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Separate numbers from feelings and organize your next move."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa las cifras y tus sensaciones para organizar tu próximo movimiento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa las cifras y tus sensaciones para organizar tu próximo movimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestele seuraavat toimet erotellen numeroita ja tuntemuksia"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparer les chiffres et les sensations pour mieux organiser vos prochaines étapes."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparer les chiffres et les sensations pour mieux organiser vos prochaines étapes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંખ્યા અને અનુભૂતિને અલગ કરો અને આગળના પગલાને વ્યવસ્થિત કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרד בין מספרים ותחושה, ונסה להבין מה לעשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संख्या और अपने अनुभव को अलग-अलग रखें, और अगले कदम की योजना बनाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razmotrite broj i osjet, kako biste se dobro pripremili za sljedeći korak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Osszuk el a számokat és az érzékelést, és döntsünk el, mit tegyünk most."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisahkan angka dan sensasi Anda, lalu susun langkah selanjutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Separare i numeri e le sensazioni fisiche per organizzare il prossimo passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値と体感を分けて、次の一手を整理しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자와 감각을 분리하여, 다음 행동을 정리합시다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आकडेवारी आणि शारीरिक अनुभवाचा वापर करून, पुढील कृती निश्चित करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisahkan angka dan sensasi. Mari kita rancang langkah seterusnya."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheid de cijfers en je gevoel om de volgende stap te bepalen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Del opp tall og følelser, og planlegg neste steg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziel się danymi i odczuciami, aby zorganizować następny ruch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe os números e a percepção do seu corpo para planejar o próximo passo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Separe os números e a percepção do seu corpo para planejar o próximo passo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împărțiți numerele și senzațiile, și organizați următorul pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделите числовые и физические ощущения, чтобы лучше спланировать следующий шаг."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozlište čísla a svoje pocity a zorganizujte ďalší krok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razdajte števila in občutke ter se pripravite na naslednji korak."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela upp siffror och känslor för att planera nästa steg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எண்களையும், உங்கள் உடல் உணர்வுகளையும் பிரித்து, அடுத்த கட்டத்தை திட்டமிடுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంఖ్యలను మరియు అనుభూతిని వేరు చేసి, తదుపరి చర్యను ప్లాన్ చేద్దాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกการวัดด้วยตัวเลขและการรับรู้ แล้ววางแผนสำหรับขั้นตอนต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayıları ve fiziksel hisleri ayrı tutarak, bir sonraki adımı belirleyelim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділіть цифри та відчуття, щоб спланувати наступний крок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy phân biệt giữa số liệu và cảm nhận để lên kế hoạch cho bước tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将数值和感觉分开，整理下一步行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將數字和身體感覺分開，整理下一步的計畫。"
