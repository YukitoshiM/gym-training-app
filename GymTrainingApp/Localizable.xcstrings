    "health_meals_body_ai.17bdb87ebc9d": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:263\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\ngu: NLLB fallback used because TranslateGemma mixed writing systems; human review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "واستنادًا إلى بيانات التعب والتعافي، اقترحنا الأيام التي لن يتم فيها زيادة الحمل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de les dades de fatiga i recuperació, vam suggerir dies en què no s'incrementaria la càrrega."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základě dat o únavě a regeneraci navrhujeme dny s nižší zátěží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på dine trætheds- og restitutionstal, foreslår vi en dag med lavere belastning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf Ihren Müdigkeits- und Erholungsdaten schlagen wir einen Tag mit geringerer Belastung vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτείναμε ημέρες με χαμηλότερη ένταση, λαμβάνοντας υπόψη την κόπωση και τα δεδομένα αποκατάστασης."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on fatigue and recovery data, we have suggested days with reduced intensity."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on fatigue and recovery data, we have suggested days with reduced intensity."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on fatigue and recovery data, we have suggested days with reduced intensity."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on fatigue and recovery data, we have suggested days with reduced intensity."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos sugerido días con menor carga, basándonos en tus datos de fatiga y recuperación."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos sugerido días con menor carga, basándonos en tus datos de fatiga y recuperación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdotimme päivää, jolloin rasitusta ei lisätä, ottaen huomioon väsymyksen ja palautumisen tiedot."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous proposons des jours où l'on réduit la charge, en tenant compte de vos données sur la fatigue et la récupération."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous proposons des jours où l'on réduit la charge, en tenant compte de vos données sur la fatigue et la récupération."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અમે થાક અને પુનઃપ્રાપ્તિના આંકડા પર આધાર રાખીને એક દિવસનો પ્રસ્તાવ મૂક્યો છે જે ભારને વધારશે નહીં."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצענו יום בו לא תגדילו את העומס, בהתחשב בעייפות ונתוני ההחלמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थकान और रिकवरी डेटा के आधार पर, हमने ऐसे दिन का सुझाव दिया है जिसमें गतिविधि कम हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na temelju podataka o umoru i oporavku, predlažem dan s manjom aktivnošću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fáradtság és a regenerációs adatok alapján javasoltunk egy olyan napot, amikor nem növeljük a terhelést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah menyarankan hari di mana Anda tidak perlu meningkatkan beban berdasarkan data kelelahan dan pemulihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base ai dati relativi alla fatica e al recupero, ho suggerito giorni in cui non aumentare l'attività fisica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "疲労と回復データを踏まえ、負荷を増やさない日を提案しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피로와 회복 데이터를 바탕으로, 부하를 늘리지 않는 날을 제안했습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "थकवा आणि पुनरुज्जीव डेटा लक्षात घेऊन, जास्त ताण न घेता दिवसाचा सल्ला दिला आहे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami telah mengesyorkan hari di mana anda tidak perlu meningkatkan beban berdasarkan data keletihan dan pemulihan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van uw vermoeidheid en herstelgegevens, stel ik voor om dagen met minder inspanning te plannen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Basert på data om tretthet og restitusjon, har vi foreslått dager med lavere belastning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie danych dotyczących zmęczenia i regeneracji, zaproponowałem dni z mniejszym obciążeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base em seus dados de fadiga e recuperação, sugerimos um dia com menor intensidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base em seus dados de fadiga e recuperação, sugerimos um dia com menor intensidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am propus zile în care nu trebuie să creșteți intensitatea, ținând cont de nivelul de oboseală și recuperare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предлагаем избегать интенсивных тренировок, учитывая данные об усталости и восстановлении."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na základe údajov o únave a regenerácii, navrhujeme dni s nižšou náročnosťou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podlagi podatkov o utrujenosti in regeneraciji predlagam, da ne boste preveč aktivni."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat på dina trötthets- och återhämtningsdata föreslås en dag med lägre belastning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சோர்வு மற்றும் மீட்பு தரவுகளை அடிப்படையாகக் கொண்டு, அதிக சுமை இல்லாத நாட்களை பரிந்துரைத்துள்ளோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అలసట మరియు పునరుద్ధరణ డేటా ఆధారంగా, ఎక్కువ లోడ్ అవసరమయ్యే రోజును సూచిస్తున్నాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราได้แนะนำวันที่ที่คุณไม่ควรออกกำลังกาย เพื่อให้สอดคล้องกับข้อมูลความเหนื่อยและฟื้นตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorgunluk ve iyileşme verilerini dikkate alarak, yükü artırmayan günler önerdim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Враховуючи вашу втому та дані про відновлення, запропоновано день з меншою активністю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã đề xuất những ngày không tăng cường hoạt động dựa trên dữ liệu về mệt và phục hồi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据疲劳和恢复数据，建议不要增加负荷。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據疲勞和恢復數據，我建議您不要增加負荷。"
          }
        }
      }
    },
