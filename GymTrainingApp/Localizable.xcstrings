    "domain_catalog.e6dc11c050a3": {
      "comment": "GymTrainingApp/Domain/Exercise.swift:167\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك الشريط بكلتا يديك وحرك كلا الجانبين في نفس الوقت"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Agafeu la barra amb les dues mans i moveu els dos costats al mateix temps"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte činku oběma rukama a pohybujte jí současně vlevo i vpravo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold stangen med begge hænder og bevæg den samtidigt til venstre og højre."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Stange mit beiden Händen und bewegen Sie gleichzeitig beide Arme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε τη μπάρα με τα δύο χέρια και κινήστε ταυτόχρονα αριστερά και δεξιά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip the bar with both hands and move it simultaneously in opposite directions."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip the bar with both hands and move it simultaneously in opposite directions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip the bar with both hands and move it simultaneously in opposite directions."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Grip the bar with both hands and move it simultaneously in opposite directions."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta las mancuernas con ambas manos y muévelas simultáneamente hacia los lados."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta las mancuernas con ambas manos y muévelas simultáneamente hacia los lados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä tangosta molemilla käsillä ja liikuttaa sitä samanaikaisesti vasemmalle ja oikealle."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir la barre avec les deux mains et bouger simultanément les bras à gauche et à droite."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir la barre avec les deux mains et bouger simultanément les bras à gauche et à droite."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બંને હાથથી બારને પકડી, અને જમણા અને ડાબા હાથને એક સાથે ખસેડો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזיקו את הבר במרכז עם שתי הידיים, והזיזו אותו מצד לצד בו זמנית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों हाथों से बार को पकड़ें और एक साथ दोनों तरफ़ घुमाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite utega obje ruke i pokretajte ih u isto vrijeme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa a käszeivel a rúgást, és mozgasse egyszerre bal és jobb oldalt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memegang bar dengan kedua tangan, lalu menggerakkannya secara bersamaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere la sbarra con entrambe le mani e muovere contemporaneamente i braccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両手でバーを保持し、左右を同時に動かす"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양손으로 바를 잡고, 동시에 좌우로 움직입니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दोन्ही हातांनी बार पकडा आणि दोन्ही बाजू एकाच वेळी हलवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memegang palang dengan kedua-tangan, bergerak ke kiri dan kanan pada masa yang sama"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de stang met beide handen vast en beweeg je armen tegelijkertijd heen en weer."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold stangen med begge hender og beveg armene samtidig til venstre og høyre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj sztangę obiema rękami i poruszaj nią jednocześnie w lewo i prawo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a barra com as duas mãos e mova os braços simultaneamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure a barra com as duas mãos e mova os braços simultaneamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține bara cu ambele mâini și mișcă-o simultan spre stânga și spre dreapta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте штангу обеими руками и одновременно двигайте ее влево и вправо."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte činku oboma rukami a pohybujte sa doprava aj doľava súčasne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite se šibe z obojih rok in gibajte jo v levem in desnem smereh hkrati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll fast i stången med båda händerna och rör samtidigt åt vänster och höger."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இரண்டு கைகளையும் பயன்படுத்தி பாரை பிடித்து, இடது மற்றும் வலது பக்கங்களை ஒரே நேரத்தில் அசைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రెండు చేతులతో బార్‌ను పట్టుకుని, రెండు వైపులను ఒకేసారి కదలించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จับบาร์ด้วยมือทั้งสองข้าง และเคลื่อนที่ไปซ้ายและขวาพร้อมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki elinizle barı tutun ve aynı anda sol ve sağ kollarınızı hareket ettirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте штангу обома руками і одночасно рухайте її вліво та вправо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thanh bằng cả hai tay, di chuyển đồng thời về bên trái và bên phải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双手握住杠，同时左右活动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙手握住槓桿，同時左右移動"
          }
        }
      }
    },
