        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, priorizamos intervalos no treinamento de força e uma atividade mais leve."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Astăzi, prioritizează activități moderate și intervale adecvate între antrenamentele de forță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня мы делаем упор на отдых и разумную активность, избегая перегрузок."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes si urobte prestávku pri tréningu a uprednostnite aktivity, ktoré sú bezpečné."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes se osredotočamo na udobje in ne preobremenjujemo se."
