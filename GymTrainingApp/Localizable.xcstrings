            "state": "translated",
            "value": "Ne force pas à soulever des charges dangereuses."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne force pas à soulever des charges dangereuses."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખતરનાક રીતે વધારે વજન ઉપાડવાનું ફરજિયાત કરશો નહીં"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא מכריחים הרמות מקסימליות מסוכנות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खतरनाक अधिकतम वजन उठाने के लिए मजबूर न करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne prisiljavamo na opasne veće podiže"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem forceláljuk a veszélyes, nagy terhelésű edzéseket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak memaksa mengangkat beban berat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non forzare movimenti pericolamente pesanti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "危険な最大挙上を強制しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험한 최대 무게를 강요하지 않습니다"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "धोकादायक जास्त वजन उचलण्यास भाग पाडत नाही"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak memaksa mengangkat berat maksimum yang berbahaya"
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Forceer geen gevaarlijke maximale heffingen"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå å tvinge deg til å løfte tunge vekter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zmuszamy do wykonywania niebezpiecznych podnoszeń"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não forçamos movimentos excessivos e perigosos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não forçamos movimentos excessivos e perigosos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu forțăm ridicări extreme periculoase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не заставляет выполнять опасные максимальные подъемы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenútime vykonávať nebezpečné maximálne zdvihy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne priporočajte nevarnih maksimalnih dvigov"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvingar inte på farliga maximala lyft"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகபட்ச எடையை தூக்குவதை கட்டாயப்படுத்த வேண்டாம்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రమాదకరమైన గరిష్ట ఎత్తును బలవంతంగా చేయకూడదు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับให้ยกน้ำหนักมากเกินไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehlikeli maksimum kaldırma yapılmasını zorlamayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не примушуємо до небезпечного підйому ваги"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ép thực hiện các cử động nguy hiểm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要强制进行危险的举重"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要强制进行危险的举重"
          }
        }
      }
