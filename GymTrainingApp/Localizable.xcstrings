    "health_meals_body_ai.0f9da1e37f0e": {
      "comment": "GymTrainingApp/Features/Health/SensorTrainingAnalysisView.swift:586\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "ولا يوجد مرشحون لارتفاعات كبيرة أو ركود. في المرة القادمة، دعونا نزيد السجلات التي يمكن مقارنتها عن طريق مطابقة العدد المستهدف من المرات وRPE."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha candidats a pics o estancaments importants. La propera vegada, augmentem els registres que es poden comparar fent coincidir el nombre objectiu de vegades i RPE."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nečekejte prudký nárůst nebo stagnaci. V budoucnu si udržujte záznamy, kde můžete porovnat cílový počet opakování a RPE."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen store pludselige stigninger eller stagnation. Lad os øge antallet af registreringer, hvor vi kan sammenligne mål og RPE (Rate of Perceived Exertion) næste gang."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine großen, plötzlichen Veränderungen oder stagnierenden Phasen. Erstellen Sie weitere Aufzeichnungen, bei denen Sie die Zielanzahl und das RPE (Rate of Perceived Exertion) für den nächsten Vergleich zusammenführen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν μεγάλες αυξήσεις ή πιθανές καθυστερήσεις. Ας προσθέσουμε περισσότερες καταγραφές όπου μπορούμε να συγκρίνουμε τον προκαθορισμένο αριθμό επαναλήψεων και την RPE."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no large increases or stagnation candidates. Let's increase the number of records where we can compare our target number of repetitions and RPE again next time."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no large increases or stagnation candidates. Let's increase the number of records where we can compare our target number of repetitions and RPE again next time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no large increases or stagnation candidates. Let's increase the number of records where we can compare our target number of repetitions and RPE again next time."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no large increases or stagnation candidates. Let's increase the number of records where we can compare our target number of repetitions and RPE again next time."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay aumentos bruscos ni períodos de estancamiento. Aumenta tus registros para poder comparar el número objetivo y la escala RPE en la próxima sesión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay aumentos bruscos ni períodos de estancamiento. Aumenta tus registros para poder comparar el número objetivo y la escala RPE en la próxima sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei merkittäviä suuria muutoksia tai pysähdyksiä. Lisätään tallennuksia, joissa voidaan verrata tavoite toistojen määrää ja RPE:tä myös seuraavalla kerralla."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de pics importants ni de périodes d'arrêt. Augmentez le nombre d'entrées avec des données comparables à votre objectif et à votre niveau d'effort (RPE)."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de pics importants ni de périodes d'arrêt. Augmentez le nombre d'entrées avec des données comparables à votre objectif et à votre niveau d'effort (RPE)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મોટા પ્રમાણમાં વધારો અથવા સ્થિરતા માટે કોઈ વિકલ્પ નથી. આગામી વખતે પણ, લક્ષ્ય સંખ્યા અને RPE (હાર્ટ રેટ એવોલ્યુશન પોર્ટ) ને સરખાવવા માટે સમાન રેકોર્ડ્સ ઉમેરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין שינויים חדים או תקופות של עצירה. בואו נרשמו מספר רשומות נוספות שבהן תוכלו להשוות את מספר המטרות וה-RPE שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़ी वृद्धि या ठहराव की कोई संभावना नहीं है। अगले भी, लक्ष्य बार और RPE के साथ तुलना करने योग्य रिकॉर्ड बनाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema velikih nagle promjena ili stanja stagnacije. U sljedećem izdanju, povećajte broj zapisa koji omogućuju usporedbu ciljnog broja i nivoa naporne aktivnosti (RPE)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs nagy, hirtelen növekedés vagy stagnálás. A következő alkalommal is hozzunk létre rekordokat, amelyekben azonos cél sorok számát és a RPE-t tudjuk összehasonlítani."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada peningkatan atau stagnasi yang signifikan. Mari tambahkan catatan yang memungkinkan Anda membandingkan kembali jumlah target dan RPE di masa mendatang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono aumenti improvvisi o periodi di stallo. Aumentate il numero di registrazioni in cui potete confrontare gli obiettivi e l'RPE (percezione dello sforzo) del prossimo allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな急増や停滞候補はありません。次回も目標回数とRPEをそろえて比較できる記録を増やしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급격한 증가나 정체 가능성은 없습니다. 다음에도 목표 횟수와 RPE를 함께 비교할 수 있도록 기록을 늘려보세요."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोठे वाढ किंवा थांबण्याची शक्यता नाही. पुढील वेळी, आपले लक्ष्य आणि RPE (रेटेड पेक्षा थकवा) जुळवून तुलना करता येईल अशा नोंदी तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada peningkatan atau stagnasi yang besar. Buat catatan tambahan untuk membandingkan jumlah sasaran dan RPE anda pada masa hadapan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen grote sprongen of stagnaties. Zorg ervoor dat je in de toekomst ook records kunt maken waarin je het aantal en de RPE (Rate of Perceived Exertion) vergelijkt met je doelstellingen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingen store økninger eller perioder med stagnasjon. La oss legge til flere treningslogger der vi kan sammenligne mål og RPE (Rate of Perceived Exertion) for neste gang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie spodziewamy się dużego wzrostu ani stagnacji. Zadbajmy o zwiększenie liczby rekordów, w których będziemy mogli porównywać docelową liczbę i RPE (subiektywną ocenę wysiłku)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há grandes aumentos ou períodos de estagnação. Crie mais registros comparando o número de repetições e a escala RPE (percepção da intensidade do esforço) para a próxima vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há grandes aumentos ou períodos de estagnação. Crie mais registros comparando o número de repetições e a escala RPE (percepção da intensidade do esforço) para a próxima vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există creșteri bruște sau perioade de stagnare. Vă recomandăm să creați mai multe înregistrări, comparând numărul de repetări și nivelul de efort (RPE) pentru următoarea sesiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ожидается резкого увеличения или застоя. В следующий раз, сохраняйте записи с целевым количеством и уровнем воспринимаемой нагрузки (RPE) для сравнения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Neočakávajte výrazné nárasty alebo stagnáciu. V budúcnosti si vytvorte viac záznamov, kde budete môcť porovnávať svoje ciele a RPE."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni pričakovani velikih sprememb ali stagnacije. Poskušajte ustvariti več zapisov, kjer lahko primerjate ciljno število in RPE tudi naslednjič."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga stora ökningar eller stagnation, skapa fler inspel med målad antal och RPE för att kunna jämföra nästa gång."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெரிய ஏற்ற இறக்கங்கள் அல்லது ஸ்திரத்தன்மை இல்லை. அடுத்த முறை உங்கள் இலக்கு எண்ணிக்கையையும், RPE அளவையும் ஒப்பிட்டுப் பார்க்கக்கூடிய பதிவுகளை அதிகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పెద్ద పెరుగుదల లేదా నిలిపివేసే అవకాశం లేదు. తదుపరిసారి కూడా లక్ష్య సంఖ్య మరియు RPE లను కలిపి పోల్చడానికి వీలుగా రికార్డులను పెంచుకుందాం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีแนวโน้มของการเพิ่มขึ้นหรือหยุดชะงักอย่างรวดเร็ว ควรบันทึกข้อมูลเป้าหมายจำนวนครั้งและ RPE ให้สอดคล้องกัน เพื่อเปรียบเทียบในอนาคต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük artış veya durma durumu söz konusu değildir. Bir sonraki de, hedef tekrar sayısını ve RPE'yi aynı şekilde karşılaştırabileceğiniz kayıtları artırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає великих стрибків або стагнації. Давайте збільшимо кількість записів, де можна порівнювати цілі та рівень відчуття навантаження (RPE)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có sự tăng đột biến hoặc tình trạng trì trệ lớn. Hãy thêm nhiều bản ghi để so sánh mục tiêu số lần và mức độ gắng sức (RPE) trong lần tập tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有大的突增或停滞，请继续记录目标次数和RPE，以便下次进行比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有大幅增加或停滯的情況，請繼續記錄目標次數和RPE，以便下次進行比較。"
          }
        }
      }
    },
    "health_meals_body_ai.103eefbf9842": {
      "comment": "GymTrainingApp/Features/BodyPhotos/BodyPhotoListView.swift:928\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه قيمة مرجعية ذات موثوقية منخفضة. ولا يتم حفظه في سجلات القياس الفعلية أو الرسوم البيانية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest és un valor de referència amb poca fiabilitat. No es desa en registres o gràfics de mesura reals."
          }
        },
