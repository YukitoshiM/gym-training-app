    "health_meals_body_ai.5abca7b1f34a": {
      "comment": "GymTrainingApp/Data/HealthDataManager.swift:236\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد حصولك على جميع البيانات، يمكنك التحقق من معدل نومك وتعافيك ومقدار التمرين في وقت واحد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cop tingueu totes les dades, podeu comprovar la quantitat de son, recuperació i exercici alhora."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po shromáždění dat můžete zkontrolovat spánek, regeneraci a množství cvičení společně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når data er tilgængelige, kan du se din søvn, restitution og træningsmængde sammen."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald die Daten verfügbar sind, können Sie Schlaf, Erholung und Trainingsmenge zusammen überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις συλλεχθούν τα δεδομένα, μπορείτε να δείτε τις συνολικές πληροφορίες σχετικά με τον ύπνο, την αποκατάσταση και την άσκηση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the data is collected, you can view your sleep, recovery, and exercise in one place."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the data is collected, you can view your sleep, recovery, and exercise in one place."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the data is collected, you can view your sleep, recovery, and exercise in one place."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the data is collected, you can view your sleep, recovery, and exercise in one place."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que se recopile los datos, podrá ver su sueño, recuperación y actividad física de forma conjunta."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que se recopile los datos, podrá ver su sueño, recuperación y actividad física de forma conjunta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun dataa on kerätty, voit tarkistaa unen, palautumisen ja liikunnan yhdessä."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois les données collectées, vous pourrez consulter votre sommeil, votre récupération et votre niveau d'activité."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois les données collectées, vous pourrez consulter votre sommeil, votre récupération et votre niveau d'activité."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે ડેટા ઉપલબ્ધ થશે, ત્યારે તમે ઊંઘ, પુનઃપ્રાપ્તિ અને કસરતની માહિતીને એકસાથે ચકાસી શકો છો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר קבלת הנתונים, תוכלו לבדוק את השינה, ההתאוששות והפעילות הגופנית שלכם ביחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब डेटा उपलब्ध होगा, तो आप नींद, पुनर्प्राप्ति और व्यायाम की मात्रा को एक साथ देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon prikupljanja podataka, možete pregledati ukupnu količinu spavanja, oporavka i aktivnosti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor a megfelelő adatok rendelkezésre állnak, áttekintheti az alvást, a regenerálódást és az edzéseket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah data terkumpul, Anda dapat melihat secara keseluruhan aktivitas tidur, pemulihan, dan olahraga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta raccolti i dati, potrai visualizzare in modo completo le informazioni su sonno, recupero e attività fisica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データがそろうと、睡眠・回復・運動量をまとめて確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 모이면 수면, 회복, 운동량을 종합적으로 확인할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जेव्हा डेटा उपलब्ध होईल, तेव्हा तुम्ही झोप, पुनर्प्राप्ती आणि व्यायामाची माहिती एकत्रितपणे पाहू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah data terkumpul, anda boleh melihat jumlah tidur, pemulihan, dan aktiviti."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra er voldoende gegevens zijn, kunt u uw slaap-, herstel- en trainingsgegevens bekijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når data er tilgjengelig, kan du se en oversikt over søvn, restitusjon og treningsmengde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zebraniu danych, możesz sprawdzić sen, regenerację i aktywność fizyczną razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após coletar os dados, você poderá verificar seu sono, recuperação e nível de atividade física em conjunto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Após coletar os dados, você poderá verificar seu sono, recuperação e nível de atividade física em conjunto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce se colectează date, puteți verifica în mod cuprinzător somnul, recuperarea și activitatea fizică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сбора данных вы сможете просмотреть информацию о сне, восстановлении и физической активности."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zhromaždení dát môžete získať komplexný prehľad o spánku, regenerácii a aktivitách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko bodo zbrani podatki, boste lahko spremljali spanje, regeneracijo in količino treninga."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När datan har samlats kan du se din sömn, återhämtning och träningsmängd tillsammans."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவுகள் சேகரிக்கப்பட்டவுடன், தூக்கம், மீட்சி மற்றும் உடற்பயிற்சி அளவுகளை ஒட்டுமொத்தமாக பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డేటా సేకరించిన తర్వాత, నిద్ర, కోలుకోవడం మరియు వ్యాయామాల మొత్తాన్ని చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีข้อมูลครบ จะสามารถตรวจสอบการนอน, การฟื้นตัว และปริมาณการออกกำลังกายได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veriler toplandığında, uyku, dinlenme ve egzersiz miktarınızı tek bir yerde görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли буде зібрано дані, ви зможете переглянути суму сну, відновлення та фізичної активності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có đủ dữ liệu, bạn có thể xem tổng hợp về giấc ngủ, phục hồi và mức độ vận động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当数据收集完成后，您可以查看睡眠、恢复和运动量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當數據收集完成後，即可一併確認睡眠、恢復和運動量。"
          }
        }
      }
    },
