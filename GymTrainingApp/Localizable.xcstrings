    "core_ui.b5a54050d994": {
      "comment": "GymTrainingApp/Features/Home/OmakaseHomeView.swift:232",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشأ أولًا من السجلات الموجودة على الجهاز، ويعدّله الذكاء الاصطناعي عند الحاجة فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es crea primer a partir dels registres del dispositiu, amb ajustos d'IA només quan cal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve se vytvoří ze záznamů v zařízení a AI je upraví pouze v případě potřeby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprettes først ud fra data på enheden og justeres kun af AI, når det er nødvendigt."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst aus den Daten auf dem Gerät erstellt und nur bei Bedarf durch KI angepasst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργείται πρώτα από τις εγγραφές της συσκευής και προσαρμόζεται από το AI μόνο όταν χρειάζεται."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Built first from on-device records, with AI adjustments only when needed."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Built first from on-device records, with AI adjustments only when needed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Built first from on-device records, with AI adjustments only when needed."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Built first from on-device records, with AI adjustments only when needed."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea primero con los registros del dispositivo y la IA solo lo ajusta cuando es necesario."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea primero con los registros del dispositivo y la IA solo lo ajusta cuando es necesario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luodaan ensin laitteessa olevista tiedoista ja säädetään tekoälyllä vain tarvittaessa."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Créé d'abord à partir des données de l'appareil, avec des ajustements IA uniquement si nécessaire."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Créé d'abord à partir des données de l'appareil, avec des ajustements IA uniquement si nécessaire."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલા ઉપકરણમાં રહેલા રેકોર્ડથી બને છે અને જરૂર હોય ત્યારે જ AI ફેરફાર કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבנה תחילה מהרישומים במכשיר, עם התאמות AI רק כשצריך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले डिवाइस के रिकॉर्ड से बनाया जाता है, AI केवल ज़रूरत होने पर बदलाव करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo se izrađuje iz podataka na uređaju, a AI ga prilagođava samo kada je potrebno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először az eszközön tárolt adatokból készül, és az MI csak szükség esetén módosítja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat terlebih dahulu dari data di perangkat, dengan penyesuaian AI hanya bila diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato prima dai dati sul dispositivo e corretto dall'IA solo quando necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず端末内の記録から作成し、必要な場合だけAIが補正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 기기 내 기록으로 만들고 필요한 경우에만 AI가 조정합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आधी डिव्हाइसवरील नोंदींमधून तयार केले जाते आणि गरज असेल तेव्हाच AI बदल करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibina dahulu daripada data pada peranti, dengan pelarasan AI hanya apabila diperlukan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst opgebouwd uit gegevens op het apparaat, met AI-aanpassingen alleen wanneer nodig."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygges først fra data på enheten, med AI-justeringer bare når det er nødvendig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw tworzone na podstawie danych z urządzenia, z korektami AI tylko w razie potrzeby."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criado primeiro com os registros do dispositivo, com ajustes da IA apenas quando necessário."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criado primeiro com os registos do dispositivo, com ajustes da IA apenas quando necessário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este creat mai întâi din datele de pe dispozitiv, cu ajustări AI doar când este necesar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создаётся по данным на устройстве, а ИИ вносит изменения только при необходимости."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv sa vytvorí zo záznamov v zariadení a AI ho upraví iba v prípade potreby."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej se ustvari iz podatkov v napravi, UI pa ga prilagodi le po potrebi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapas först från data på enheten och justeras av AI endast när det behövs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் சாதனத்திலுள்ள பதிவுகளிலிருந்து உருவாக்கப்படும்; தேவைப்படும் போது மட்டும் AI மாற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొదట పరికరంలోని రికార్డుల నుంచి రూపొందించబడుతుంది; అవసరమైనప్పుడు మాత్రమే AI సర్దుబాటు చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างจากข้อมูลในอุปกรณ์ก่อน และให้ AI ปรับเฉพาะเมื่อจำเป็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce cihazdaki kayıtlardan oluşturulur, AI yalnızca gerektiğinde ayarlama yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку створюється за даними на пристрої, а ШІ вносить зміни лише за потреби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tạo trước tiên từ dữ liệu trên thiết bị, AI chỉ điều chỉnh khi cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先根据设备内记录生成，仅在需要时由AI调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先根據裝置內的記錄建立，僅在需要時由AI調整。"
          }
        }
      }
    },
