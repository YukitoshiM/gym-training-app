    "health_meals_body_ai.6c466f96ae9a": {
      "comment": "GymTrainingApp/Features/BodyMetrics/BodyMetricDetailView.swift:274\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد تسجيل قيمك الأولية، يمكنك رؤية تقدمك وفارق الهدف."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cop hàgiu registrat els vostres valors inicials, podreu veure el vostre progrés i la diferència d'objectius."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po prvním zaznamenání můžete sledovat změny a rozdíl oproti cíli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du registrerer den første værdi, kan du se udviklingen og forskellen i forhold til dit mål."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Aufzeichnen des ersten Wertes können Sie Veränderungen und Differenzen zu Ihren Zielen verfolgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την καταγραφή της πρώτης τιμής, μπορείτε να δείτε την εξέλιξη και τη διαφορά από τον στόχο σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording the initial value allows you to track progress and compare against your goals."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording the initial value allows you to track progress and compare against your goals."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording the initial value allows you to track progress and compare against your goals."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording the initial value allows you to track progress and compare against your goals."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Al registrar el valor inicial, podrá ver la evolución y la diferencia con respecto al objetivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Al registrar el valor inicial, podrá ver la evolución y la diferencia con respecto al objetivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet tallentanut ensimmäiset arvot, voit tarkistaa muutokset ja tavoiteerot."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "En enregistrant la première valeur, vous pouvez suivre l'évolution et la différence par rapport à vos objectifs."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "En enregistrant la première valeur, vous pouvez suivre l'évolution et la différence par rapport à vos objectifs."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રથમ મૂલ્યને રેકોર્ડ કર્યા પછી, તમે ફેરફારો અને તમારા લક્ષ્યો વચ્ચેના તફાવતને જોઈ શકશો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר רישום הערך הראשוני, תוכלו לבדוק את השינויים וההפרשים ביחס למטרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले मूल्य दर्ज करने पर, आप परिवर्तन और लक्ष्य अंतर देख सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada zabilježite početne vrijednosti, možete vidjeti trendove i razliku između cilja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha rögzíti az első értéket, megtekintheti a változásokat és a célállomáshoz való különbséget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah mencatat nilai awal, Anda dapat melihat perubahan dan perbedaan target."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrando il valore iniziale, potrai visualizzare l'andamento e la differenza rispetto agli obiettivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の値を記録すると、推移と目標差分を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기 값을 기록하면 변화와 목표 차이를 확인할 수 있습니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिला डेटा नोंदवल्यानंतर, तुम्ही प्रगती आणि ध्येयातील फरक पाहू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan mencatat nilai awal, anda boleh melihat perbezaan dan matlamat."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Door de eerste waarde op te slaan, kunt u de voortgang en het verschil met uw doel bekijken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du registrerer den første verdien, kan du se endringer og forskjellen mot målet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zarejestrowaniu pierwszych wartości możesz sprawdzić zmiany i różnicę między obecną a docelową wartością."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registrar o primeiro valor, você poderá acompanhar a evolução e a diferença em relação à meta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registrar o primeiro valor, você poderá acompanhar a evolução e a diferença em relação à meta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea valorii inițiale vă permite să vedeți evoluția și diferența față de obiectiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После записи первых значений можно отслеживать изменения и сравнивать с вашей целью."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zaznamenaní prvých hodnôt môžete sledovať ich vývoj a rozdiel oproti cieľu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko zabeležite prvo vrednost, lahko spremljate spremembe in ciljne razlike."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du har registrerat de första värdena kan du se hur de förändras och jämföra med dina mål."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதல் மதிப்பைக் குறித்து, மாற்றங்களையும், இலக்கு வேறுபாட்டையும் பார்க்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొదటి విలువను నమోదు చేసిన తర్వాత, మార్పులను మరియు లక్ష్య వ్యత్యాసాన్ని చూడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อบันทึกค่าเริ่มต้น คุณสามารถตรวจสอบความเปลี่ยนแปลงและเปรียบเทียบกับเป้าหมาย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk değerleri kaydettikten sonra, ilerlemeyi ve hedeflenen farkı görebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після запису першої оцінки ви зможете відстежувати зміни та порівнювати з вашою ціллю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi ghi lại giá trị ban đầu, bạn có thể theo dõi sự thay đổi và chênh lệch so với mục tiêu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录初始值后，您可以查看进展和目标差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "记录初始值后，可以查看进展和目标差异。"
          }
        }
      }
    },
