    "domain_catalog.502e3b30230d": {
      "comment": "GymTrainingApp/Data/PresetExerciseStore.swift:436\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحريك الأسطوانة للأمام دون تقويس ظهرك وإبقاء قلبك مشدودًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Feu girar el corró cap endavant sense arquejar l'esquena i mantenint el nucli ben ajustat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nespínejte záda, udržujte stabilní střed těla a přemístěte válec dopředu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøj ikke ryggen, men rul kroppen fremad med en fast kropskerne."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wirbelsäule nicht überdehnen, sondern den Körperkern stabil halten und den Rollen vorwärts bewegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην λυγίζετε υπερβολικά την πλάτη σας, διατηρήστε τη στήλη σας σταθερή και μετακινήστε το ρολό μπροστά."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, roll the roller forward while maintaining a stable core."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, roll the roller forward while maintaining a stable core."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, roll the roller forward while maintaining a stable core."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Without over-arching your back, roll the roller forward while maintaining a stable core."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodar el rodillo hacia adelante manteniendo la espalda recta y fortaleciendo el core."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodar el rodillo hacia adelante manteniendo la espalda recta y fortaleciendo el core."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä selkä suorana ja pyöräytä vartaloa eteenpäin käyttämällä apuvastetta."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouler le rouleau vers l'avant en maintenant le dos droit et en maintenant une bonne posture."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouler le rouleau vers l'avant en maintenant le dos droit et en maintenant une bonne posture."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા પેટને સીધા રાખીને, શરીરના મધ્ય ભાગને મજબૂત રાખીને રોલરને આગળની તરફ ખસેડો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמור על גב ישר, ושמור על יציבות הגוף תוך הזזת הרולר קדימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पीठ को सीधा रखें और अपने शरीर के कोर को मजबूत रखते हुए रोलर को आगे की ओर घुमाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Držeći leđa izravnima, pomičte roler naprijed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gerincet ne hajlítsa lefelé, hanem tartsa az egyenes testtartást, és emelje a tornát előre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memutar tubuh ke atas sambil menjaga punggung tetap lurus, dan menggerakkan roller ke depan dengan inti tubuh yang kuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrotondare il busto, mantenendo il core stabile, e far scorrere il rullo in avanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰を反らさず、体幹を固めたままローラーを前方へ転がす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리를 굽히지 않고, 코어 근육을 강화한 상태에서 롤러를 앞으로 밀고 나간다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पोट ताणून घेऊ नका, शरीराचा मध्यभाग मजबूत ठेवून रोलरला पुढे सरकवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membungkus tubuh ke atas tanpa menekuk punggung, sambil memindahkan roller ke hadapan."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "Rol je bovenlichaam voorover, terwijl je je rug recht houdt en je lichaam stabiel blijft."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bøy ikke ryggen, men fortsett å bruke magemusklene til å skyve vekten fremover."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymując stabilność tułowia, przesuń rolkę w przód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a coluna reta e role o rolo para frente, utilizando a parte inferior do corpo como suporte."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a coluna reta e role o rolo para frente, utilizando a parte inferior do corpo como suporte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mențineți spatele drept și rotiți corpul înainte, folosind rola ca punct de sprijin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не напрягать поясницу, а использовать корпус как опору для перемещения роллера вперед."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenechávajte sa preťažiť a ohýbate sa do strán, pričom využívate svoje boky ako oporu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne prekomplicirajte z hrbtom, ohranite stabilnost trupa in premaknite roler naprej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyft kroppen uppåt, utan att översträcka ryggen, och använd höfterna som stöd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதுகை அதிகமாக வளைக்காமல், உடலின் மையத்தை வலுவாக வைத்து ரோலரை முன்னோக்கி உருட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెన్నుపూసను ఎక్కువగా వంచకుండా, కాలును ముందుకు నడిపించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โค้งตัวโดยไม่ทำให้เอวแอ่น และใช้ร่างกายเป็นหลักในการเลื่อนโรลเลอร์ไปข้างหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beli bükmeyin, vücut çekirdeğinizi sağlam tutarak tekerleği öne doğru itin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не згинати спину, але переносити навантаження вперед, коли ролик рухається вперед."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ thẳng lưng và lăn phần thân trước trên xe theo hướng tiến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持腰部挺直，保持身体核心稳定，然后向前滚动卷尺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持腰部不動，並在維持核心穩定性的情況下，將滾輪向前推。"
          }
        }
      }
    },
