    "health_meals_body_ai.df3038574b14": {
      "comment": "GymTrainingApp/Data/DailyRecommendationEngine.swift:275\nen-CA: Neutral English draft based on en-AU; regional review required.\nen-GB: Neutral English draft based on en-AU; regional review required.\nen-US: Neutral English draft based on en-AU; regional review required.\nfr-CA: Regional draft based on fr-FR; regional review required.\npt-PT: Regional draft based on pt-BR; regional review required.",
      "extractionState": "manual",
      "localizations": {
        "ar-SA": {
          "stringUnit": {
            "state": "translated",
            "value": "سنقوم بإنشاء قائمة وفقًا للمعدات المتاحة حتى تتمكن من بدء تدريبك الأول دون تردد."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elaborarem un menú segons l'equipament disponible perquè puguis començar el teu primer entrenament sense dubtar-ho."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoříme plán cvičení, který vám umožní začít bez váhání, s ohledem na dostupné vybavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi opretter et program, der passer til de udstyr, du har, så du nemt kan starte din første træning."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich erstelle ein Trainingsprogramm, das auf den verfügbaren Geräten basiert, damit Sie problemlos mit Ihrem ersten Training beginnen können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργούμε ένα πρόγραμμα προσαρμοσμένο στα διαθέσιμα εργαλεία, ώστε να μπορείτε εύκολα να ξεκινήσετε την πρώτη σας προπόνηση."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We will create a menu based on available equipment to help you start your first workout without hesitation."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "We will create a menu based on available equipment to help you start your first workout without hesitation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We will create a menu based on available equipment to help you start your first workout without hesitation."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We will create a menu based on available equipment to help you start your first workout without hesitation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Crearé un menú adaptado a los equipos disponibles para que pueda comenzar su primer entrenamiento sin dudarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Crearé un menú adaptado a los equipos disponibles para que pueda comenzar su primer entrenamiento sin dudarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo treeniohjelma, joka sopii käytettävissä oleviin laitteisiin, jotta voit aloittaa ensimmäisen harjoituksen helposti."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous créons un programme adapté aux équipements disponibles afin que vous puissiez commencer facilement votre premier entraînement."
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous créons un programme adapté aux équipements disponibles afin que vous puissiez commencer facilement votre premier entraînement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઉપલબ્ધ સાધનો અનુસાર, એક એવી યોજના બનાવો જેથી તમે સરળતાથી શરૂઆત કરી શકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבנה תפריט בהתאם לציוד הזמין, כדי שתוכלו להתחיל את האימון הראשון בלי היסוס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध उपकरणों के अनुसार, शुरुआती प्रशिक्षण शुरू करने में मदद करने के लिए एक मेनू बनाया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripremamo plan aktivnosti prilagođen opremi koju koristite, kako biste mogli bez problema započeti s prvim treningom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készítünk egy programot, amely figyelembe veszi a rendelkezésre álló eszközöket, hogy könnyen elindíthassa az első edzést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat menu yang sesuai dengan peralatan yang tersedia agar Anda dapat memulai latihan pertama tanpa ragu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creeremo un menu adatto all'attrezzatura disponibile, in modo che tu possa iniziare subito il primo allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のトレーニングを迷わず始められるよう、利用できる器具に合わせてメニューを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 운동을 시작하는 데 도움이 되도록, 이용 가능한 장비를 고려하여 메뉴를 구성합니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवात करण्यासाठी, उपलब्ध उपकरणांनुसार योग्य मेनू तयार केला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat menu berdasarkan peralatan yang tersedia supaya anda boleh bermula dengan latihan pertama tanpa ragu-ragu."
          }
        },
        "nl-NL": {
          "stringUnit": {
            "state": "translated",
            "value": "We creëren een trainingsplan dat past bij de beschikbare apparatuur, zodat u zonder aarzelen kunt beginnen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi lager et treningsprogram basert på tilgjengelige utstyr, slik at du enkelt kan starte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stworzymy plan treningowy dostosowany do dostępnego sprzętu, abyś mógł bez obaw rozpocząć pierwsze ćwiczenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criaremos um plano de treino adaptado aos equipamentos disponíveis, para que você possa começar sem hesitação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criaremos um plano de treino adaptado aos equipamentos disponíveis, para que você possa começar sem hesitação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom crea un meniu adaptat echipamentului disponibil pentru a vă ajuta să începeți cu ușurință prima sesiune de antrenament."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы составим программу тренировок, учитывая доступное оборудование, чтобы вам было легко начать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoríme si plán na základe dostupného vybavenia, aby ste mohli bez váhaní začať prvý tréning."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustvarimo seznam vaj, ki ustreza opremi, da vam bo olajšala začetek prve vadbe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skapar ett träningsprogram baserat på tillgänglig utrustning så att du enkelt kan börja."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்படுத்தக்கூடிய உபகரணங்களுக்கு ஏற்ப, உடற்பயிற்சி திட்டத்தை உருவாக்கவும். இதன் மூலம், நீங்கள் எளிதாகத் தொடங்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మొదటి వ్యాయామం చేయడానికి మీకు సహాయపడేలా, అందుబాటులో ఉన్న పరికరాలకు అనుగుణంగా మెనూను రూపొందిస్తాను."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างเมนูให้เหมาะสมกับอุปกรณ์ที่ใช้งาน เพื่อให้คุณเริ่มต้นการออกกำลังกายได้ง่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk antrenmanı kolayca başlatabilmeniz için, mevcut ekipmanlara uygun bir program oluşturulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми створимо план тренувань відповідно до доступного обладнання, щоб ви могли легко почати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ tạo danh sách bài tập phù hợp với các thiết bị bạn có, giúp bạn bắt đầu dễ dàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会根据可用的设备创建菜单，以便您毫不犹豫地开始第一次训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根据可用的器材，创建适合的训练计划，以便您轻松开始第一次训练。"
          }
        }
      }
    },
