AI_RUNTIME_ENVIRONMENT=production
AI_AUTH_MODE=token_required
AI_TOKEN_TTL_SECONDS=86400
AI_RATE_LIMIT_PER_MINUTE=30
AI_TOKEN_ISSUE_RATE_LIMIT_PER_MINUTE=8
AI_TOKEN_ISSUE_GLOBAL_LIMIT_PER_MINUTE=120
AI_MAX_CONCURRENT_INFERENCE=2
# Set to 0 during TestFlight to record usage without enforcing daily/period limits.
# Production preflight requires this to be 1 before App Store release.
AI_QUOTA_ENFORCEMENT=1
# Comma-separated enrollment subjects. Keep empty for normal installations.
AI_QUOTA_EXEMPT_SUBJECTS=owner
AI_CREDIT_ENFORCEMENT=1
AI_CREDIT_ACCOUNT_SUBJECT_PREFIXES=apple:
AI_CREDIT_SIGNUP_BONUS=20
AI_APPLE_ACCOUNT_TOKEN_TTL_SECONDS=2592000
APP_STORE_BUNDLE_ID=com.yukitoshim.gymtrainingapp
APP_STORE_APPLE_ID=6799871527
APP_STORE_ROOT_CERTIFICATES_PATH="/absolute/path/to/apple-root-certificates"
AI_CREDIT_COST_CHAT=1
AI_CREDIT_COST_DAILY_RECOMMENDATION=1
AI_CREDIT_COST_PLAN=2
AI_CREDIT_COST_MEAL=3
AI_CREDIT_COST_BODY_PHOTO=4
AI_CREDIT_COST_WEEKLY_REPORT=5
AI_CREDIT_COST_MONTHLY_REPORT=5
AI_CREDIT_DB_PATH="/Users/your-name/Library/Application Support/BodyMode/ai-credits.sqlite3"
USAGE_ANALYTICS_DB_PATH="/Users/your-name/Library/Application Support/BodyMode/usage-analytics.sqlite3"
AI_QUOTA_CHAT_PER_DAY=5
AI_QUOTA_MEAL_PER_DAY=3
AI_QUOTA_BODY_PHOTO_PER_DAY=1
AI_QUOTA_PLAN_PER_DAY=2
AI_QUOTA_DAILY_RECOMMENDATION_PER_DAY=1
AI_QUOTA_WEEKLY_REPORT_PER_7_DAYS=1
AI_QUOTA_MONTHLY_REPORT_PER_31_DAYS=1
# These daily/period quotas are for legacy builds. Credit-enforced Apple accounts
# use their balance instead; short-term rate and concurrency limits still apply.
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
AI_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-bytes
AI_ENROLLMENT_KEYS_FILE="/Users/your-name/Library/Application Support/BodyMode/local_ai_server/enrollment_keys.json"
APPLE_SIGN_IN_AUDIENCE=com.yukitoshim.gymtrainingapp
APPLE_CLIENT_ID=com.yukitoshim.gymtrainingapp
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH="/absolute/path/to/AuthKey_XXXXXXXXXX.p8"
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
AI_APPLE_TOKEN_ENCRYPTION_KEY=
AI_APPLE_TOKEN_DB_PATH="/Users/your-name/Library/Application Support/BodyMode/apple-tokens.sqlite3"
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-0000000000000000/0000000000
AI_REWARDED_AD_DB_PATH="/Users/your-name/Library/Application Support/BodyMode/rewarded-ads.sqlite3"

# Scientific evidence is stored only on the Mac mini. User questions are embedded locally.
EVIDENCE_RAG_ENABLED=1
EVIDENCE_RAG_DB_PATH="/Users/your-name/Library/Application Support/BodyMode/evidence-rag.sqlite3"
EVIDENCE_EMBEDDING_MODEL=bge-m3
EVIDENCE_MONITOR_DB_PATH=
# Local Ollama is 0. Set only when retrieval context has a metered downstream cost.
EVIDENCE_COST_PER_MILLION_CHARACTERS=0
# Optional, but recommended for Crossref's polite pool.
CROSSREF_MAILTO=you@example.com
