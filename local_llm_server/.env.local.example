# Start with compat while existing TestFlight builds still use the shared key.
# Change to token_required after all active builds use session tokens.
AI_AUTH_MODE=compat
AI_TOKEN_TTL_SECONDS=86400
AI_RATE_LIMIT_PER_MINUTE=30
AI_MAX_CONCURRENT_INFERENCE=2
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
AI_TOKEN_SIGNING_SECRET=replace-with-at-least-32-random-bytes
AI_ENROLLMENT_KEYS_FILE=/Users/your-name/Library/Application Support/BodyMode/local_ai_server/enrollment_keys.json
